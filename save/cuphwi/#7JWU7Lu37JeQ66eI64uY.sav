  "player_messages": { "messages": [ { "turn": 577065, "message": "생 마카로니(얼음)을(를) 회수했다.", "count": 1, "type": 5 }, { "turn": 577065, "message": "  - 생 마카로니(얼음)", "count": 1, "type": 4 }, { "turn": 577065, "message": "생 마카로니(얼음)을(를) 회수했다.", "count": 1, "type": 5 }, { "turn": 577065, "message": "  - 생 마카로니(얼음)", "count": 1, "type": 4 }, { "turn": 577065, "message": "생 마카로니(얼음)을(를) 회수했다.", "count": 1, "type": 5 }, { "turn": 577065, "message": "  - 생 마카로니(얼음)", "count": 1, "type": 4 }, { "turn": 577065, "message": "생 마카로니(얼음)을(를) 회수했다.", "count": 1, "type": 5 }, { "turn": 577065, "message": "  - 생 마카로니(얼음)", "count": 1, "type": 4 }, { "turn": 577065, "message": "아무것도 하지 않음.", "count": 1, "type": 5 }, { "turn": 577066, "message": "라먀와(과) 자리를 바꿨다.", "count": 1, "type": 5 }, { "turn": 577066, "message": "라네와(과) 자리를 바꿨다.", "count": 1, "type": 5 }, { "turn": 577066, "message": "이 칸에는 차량 조종장치가 있다.", "count": 1, "type": 5 }, { "turn": 577066, "message": " ^ 키로 운전.", "count": 1, "type": 4 }, { "turn": 577066, "message": "이 칸에는 차량 조종장치가 있다.", "count": 1, "type": 5 }, { "turn": 577066, "message": " ^ 키로 운전.", "count": 1, "type": 4 }, { "turn": 577101, "message": "<color_pink>*잠깐만 기다려줘요*</color>", "count": 1, "type": 5 }, { "turn": 577102, "message": "모아이(가) 말했다. \"기꺼이.\" 소리를 들었다.", "count": 1, "type": 4 }, { "turn": 577102, "message": "모아이(가) 말했다. \"하아... 이게 훨씬 낫네...\" 소리를 들었다.", "count": 1, "type": 4 }, { "turn": 577200, "message": "*즈펍즈펍*", "count": 1, "type": 5 }, { "turn": 577300, "message": "*즈펍즈펍*", "count": 1, "type": 5 }, { "turn": 577400, "message": "『오옥♡』", "count": 1, "type": 5 }, { "turn": 577500, "message": "『으읏♡』", "count": 1, "type": 5 }, { "turn": 577600, "message": "『오옥♡』", "count": 1, "type": 5 }, { "turn": 577700, "message": "『하아하아』", "count": 1, "type": 5 }, { "turn": 577800, "message": "『우후후♪』", "count": 1, "type": 5 }, { "turn": 577900, "message": "『들려버려엇』", "count": 1, "type": 5 }, { "turn": 578000, "message": "『오옥♡』", "count": 1, "type": 5 }, { "turn": 578