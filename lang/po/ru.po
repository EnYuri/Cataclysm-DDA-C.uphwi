msgstr[0] "запасной магазин"
msgstr[1] "запасных магазина"
msgstr[2] "запасных магазинов"
msgstr[3] "запасной магазин"

#: lang/json/gunmod_from_json.py
msgid ""
"A spare magazine you can keep on hand to make reloads faster, but must "
"itself be reloaded before it can be used again."
msgstr ""
"Запасной магазин, который вы можете держать под рукой для быстрой "
"перезарядки, но его требуется перезаряжать отдельно для повторного "
"применения."

#: lang/json/gunmod_from_json.py
msgid "extended magazine"
msgid_plural "extended magazines"
msgstr[0] "увеличенный магазин"
msgstr[1] "увеличенных магазина"
msgstr[2] "увеличенных магазинов"
msgstr[3] "увеличенный магазин"

#: lang/json/gunmod_from_json.py
#, no-python-format
msgid "Increases the ammunition capacity of your firearm by 50%."
msgstr "Увеличивает боезапас вашего оружия на 50%."

#: lang/json/gunmod_from_json.py
