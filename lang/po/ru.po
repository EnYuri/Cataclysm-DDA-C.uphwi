msgid "[%s] find, [f] container, [F] flag, [%s] quit"
msgstr "[%s] поиск, [f] контейнер, [F] флаг, [%s] выход"

#: src/wish.cpp
#, c-format
msgid "%.*s"
msgstr "%.*s"

#: src/wish.cpp
msgid "How many?"
msgstr "Сколько?"

#: src/wish.cpp
#, c-format
msgid "Wish granted. Wish for more or hit [%s] to quit."
msgstr ""
"Желаемое получено. Выберите ещё что-нибудь или нажмите «%s» для выхода."

#: src/wish.cpp
msgid "Select a skill to modify"
msgstr "Выберите навык для изменения"

#: src/wish.cpp
msgid "Modify all skills..."
msgstr "Подправить все навыки…"

#: src/wish.cpp
#, c-format
msgid "@ %d: %s  "
msgstr "@ %d: %s "

#: src/wish.cpp
#, c-format
msgid "Set '%s' to.."
msgstr "Установить «%s» на…"

#: src/wish.cpp
msgid " (current)"
msgstr " (сейчас)"

#: src/wish.cpp
#, c-format
msgid "%s set to %d             "
msgstr "%s установлен в %d "

#: src/wish.cpp
msgid "Alter all skill values"
msgstr "Изменить все значения навыков"

#: src/wish.cpp
msgid "Add 1"
msgstr "Прибавить 1"

#: src/wish.cpp
msgid "Add 3"
msgstr "Прибавить 3"

#: src/wish.cpp
msgid "Set to 0"
msgstr "Установить на 0"

#: src/wish.cpp
msgid "Subtract 1"
msgstr "Вычесть 1"

#: src/wish.cpp
msgid "Subtract 3"
msgstr "Вычесть 3"

#: src/wish.cpp
msgid "(Reset changes)"
msgstr "(отменить изменения)"

#: src/wish.cpp
msgid "Set to 10"
msgstr "Установить на 10"

#: src/wish.cpp
msgid "Set to 5"
msgstr "Установить на 5"

#: src/worldfactory.cpp
msgid "Do you want to abort World Generation?"
msgstr "Хотите прервать генерацию мира?"

#: src/worldfactory.cpp
msgid "world data"
msgstr "данные о мире"

#: src/worldfactory.cpp
msgid " WORLD SELECTION "
msgstr " ВЫБОР МИРА "

#: src/worldfactory.cpp
#, c-format
msgid "Page %lu"
msgstr "Страница %lu"

#: src/worldfactory.cpp
msgid "Pick a world to enter game"
msgstr "Выберите мир, чтобы начать игру"

#: src/worldfactory.cpp
#, c-format
msgid "Can't start in world [%s]. Some of mods require Lua support."
msgstr ""
"Невозможно начать игру в мире [%s]. Некоторые моды требуют поддержки Lua."

#: src/worldfactory.cpp
msgid " ACTIVE WORLD MODS "
msgstr "АКТИВНЫЕ МОДЫ МИРА"

#: src/worldfactory.cpp
msgid "--NO ACTIVE MODS--"
msgstr "--НЕТ АКТИВНЫХ МОДОВ--"

#: src/worldfactory.cpp
msgid "Switch to other list"
msgstr "Перейти к другому списку"

#: src/worldfactory.cpp
msgid "Activate / deactivate mod"
msgstr "Включить / выключить мод"

#: src/worldfactory.cpp
msgid "Mod List"
msgstr "Список модов"

#: src/worldfactory.cpp
msgid "Mod Load Order"
msgstr "Порядок загрузки модов"

#: src/worldfactory.cpp
#, c-format
msgid "... %s = View full description "
msgstr "... %s= Полное описание "

#: src/worldfactory.cpp
msgid "--NO AVAILABLE MODS--"
msgstr "--НЕТ ДОСТУПНЫХ МОДОВ--"

#: src/worldfactory.cpp
msgid "Can't add mod. This mod requires Lua support."
msgstr "Невозможно добавить мод. Этот мод требует поддержки Lua."

#: src/worldfactory.cpp
msgid "Saved list of active mods as default"
msgstr "Текущий список модов сохранён как список по умолчанию."

#: src/worldfactory.cpp
msgid "World Name:"
msgstr "Название мира:"

#: src/worldfactory.cpp
#, c-format
msgid "Press <color_yellow>%s</color> to pick a random name for your world."
msgstr ""
"Нажмите клавишу <color_yellow>«%s»</color>, чтобы выбрать случайное имя для "
"вашего мира."

#: src/worldfactory.cpp
#, c-format
msgid ""
"Press <color_yellow>%s</color> when you are satisfied with the world as it "
"is and are ready to continue, or <color_yellow>%s</color> to go back and "
"review your world."
msgstr ""
"Нажмите клавишу <color_yellow>%s</color>, если вы удовлетворены настройками "
"мира и готовы продолжить, иначе нажмите <color_yellow>%s</color>, чтобы "
"вернуться назад и пересмотреть настройки вашего мира."

#: src/worldfactory.cpp
#, c-format
msgid "Mod '%s' requires Lua support."
msgstr "Мод «%s» требует поддержки Lua."

#: src/worldfactory.cpp
msgid "________NO NAME ENTERED!________"
msgstr "________ИМЯ НЕ ВВЕДЕНО!________"

#: src/worldfactory.cpp
msgid "Are you SURE you're finished? World name will be randomly generated."
msgstr ""
"Вы действительно хотите продолжить? Название мира будет выбрано случайным "
"образом."

#: src/worldfactory.cpp
#, c-format
msgid ""
"%s = Save Load Order as default.  %s = Controls %s/%s = Prev/Next Option. "
"%s/%s = Prev/Next Tab."
msgstr ""
"%s = сохранить порядок загрузки модов. %s = помощь. %s/%s = "
"предыдущая/следующая настройка. %s/%s = предыдущая/следующая вкладка."

#: src/worldfactory.cpp
msgid "World Mods"
msgstr "Моды мира"

#: src/worldfactory.cpp
msgid "World Options"
msgstr "Настройки мира"

#: src/worldfactory.cpp
msgid "Finalize World"
msgstr "Завершить создание мира"

#: src/worldfactory.cpp
#, c-format
msgid "%s is a reserved name!"
msgstr "Имя «%s» зарезервировано!"

#: src/worldfactory.cpp
#, c-format
msgid "A world named %s already exists!"
msgstr "Уже есть мир с именем «%s»!"
