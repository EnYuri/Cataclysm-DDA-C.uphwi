msgstr[2] "«Современная электроника»"
msgstr[3] "«Современная электроника»"

#. ~ Description for Advanced Electronics
#: lang/json/BOOK_from_json.py
msgid "A college textbook on circuit design."
msgstr "Учебник по схемотехнике, предназначенный для колледжа."

#: lang/json/BOOK_from_json.py
