msgid "I thought you were my friend."
msgstr "Я думал, ты был мне другом."

#: src/player.cpp
msgid "How are you today?"
msgstr "Как ты себя чувствуешь сегодня?"

#: src/player.cpp
msgid "Shut up! Don't lie to me."
msgstr "Заткнись! Не ври мне."

#: src/player.cpp
msgid "Please, don't go."
msgstr "Пожалуйста, не уходи."

