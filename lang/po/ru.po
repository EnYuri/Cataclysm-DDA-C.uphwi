msgstr[1] "переточки калибра 6,54 мм"
msgstr[2] "переточек калибра 6,54 мм"
msgstr[3] "переточка калибра 6,54 мм"

#: lang/json/gunmod_from_json.py
msgid ""
"This kit is used to convert 5.45 rifle to the 6.54 caliber.  The conversion "
