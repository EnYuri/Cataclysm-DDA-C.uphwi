msgstr "Сложность игры"

#: src/iuse_software_minesweeper.cpp
msgid "Beginner"
msgstr "Лёгкий"

#: src/iuse_software_minesweeper.cpp
msgid "Intermediate"
msgstr "Средний"

#: src/iuse_software_minesweeper.cpp
msgid "Level width:"
msgstr "Ширина уровня:"

#: src/iuse_software_minesweeper.cpp
msgid "Level height:"
msgstr "Высота уровня:"

#: src/iuse_software_minesweeper.cpp
msgid "Number of bombs:"
msgstr "Число мин:"

#: src/iuse_software_minesweeper.cpp
msgid "<n>ew level"
msgstr "<n> новый уровень"

#: src/iuse_software_minesweeper.cpp
msgid "<f>lag"
msgstr "<f> флаг"

#: src/iuse_software_minesweeper.cpp
msgid "Boom, you're dead! Better luck next time."
msgstr "Бум, вы погибли! Удачи в следующий раз."

