msgstr ""
"Увеличенный 30-зарядный стальной коробчатый магазин для использования с "
"винтовкой FN FAL."

#: lang/json/MAGAZINE_from_json.py
msgid "FN FAL magazine"
msgstr "FN FAL магазин"

#. ~ Description for FN FAL magazine
#: lang/json/MAGAZINE_from_json.py
msgid "A military issue 20-round steel box magazine for the FN FAL rifle."
msgstr "Военный 20-зарядный магазин для использования с винтовкой FN FAL."

#: lang/json/MAGAZINE_from_json.py
msgid "H&K G3 drum magazine"
msgstr "H&K G3 барабанный магазин"

#. ~ Description for H&K G3 drum magazine
#: lang/json/MAGAZINE_from_json.py
