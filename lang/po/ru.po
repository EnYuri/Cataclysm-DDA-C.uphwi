#, c-format
msgid ""
"Disassembling the %s may yield:\n"
"%s\n"
"Really disassemble?"
msgstr ""
"Разобрав %s, вы получите:\n"
"%s\n"
"Действительно разобрать?"

#: src/crafting.cpp
msgid "The item has vanished."
msgstr "Предмет исчез."

#: src/crafting.cpp
