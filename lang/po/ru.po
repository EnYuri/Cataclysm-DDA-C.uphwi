msgstr "мёртвое дерево гикори"

#: lang/json/terrain_from_json.py
msgid "underbrush"
msgstr "кустарник"

#. ~ Description for underbrush
#: lang/json/terrain_from_json.py
msgid ""
"Small plants and shrubs that decorate the forest.  An observant forager "
"could obtain edible plants, acorns, eggs, and mushrooms from it."
msgstr ""
"Небольшие растения и кустарники, украшающие лес. Наблюдательный собиратель "
"может найти в них съедобные растения, жёлуди, яйца и грибы."

#: lang/json/terrain_from_json.py
msgid "brush."
msgstr "шорох."

