msgid_plural "You need a %s with %d charges."
msgstr[0] "Понадобится %s с %d зарядом."
msgstr[1] "Понадобится %s с %d зарядами."
msgstr[2] "Понадобится %s с %d зарядами."
msgstr[3] "Понадобится %s с %d зарядом."

