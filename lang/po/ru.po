msgstr[2] "журналов «Top Gear»"
msgstr[3] "журнал «Top Gear»"

#. ~ Description for Top Gear magazine
#: lang/json/BOOK_from_json.py
msgid "Lots of articles about cars and driving techniques."
msgstr "Набит статьями об автомобилях и вождении."

#: lang/json/BOOK_from_json.py
msgid "The Rules of the Road"
msgid_plural "The Rules of the Road"
msgstr[0] "«Правила дорожного движения»"
msgstr[1] "«Правил дорожного движения»"
