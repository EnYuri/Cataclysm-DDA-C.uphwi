msgid_plural ".357 Magnum casings"
msgstr[0] "гильза .357 Магнум"
msgstr[1] "гильзы .357 Магнум"
msgstr[2] "гильз .357 Магнум"
msgstr[3] "гильзы .357 Магнум"

