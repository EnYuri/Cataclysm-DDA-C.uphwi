msgid_plural "diamond rings"
msgstr[0] "бриллиантовое кольцо"
msgstr[1] "бриллиантовых кольца"
msgstr[2] "бриллиантовых колец"
msgstr[3] "бриллиантовое кольцо"

#. ~ Description for diamond ring
