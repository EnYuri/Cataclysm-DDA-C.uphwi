#, c-format
msgid "Wait, that %1$s needs to die!"
msgstr "Постой, %1$s должен умереть!"

#: src/player.cpp
#, c-format
msgid "Go kill that %1$s!"
msgstr "Пойдём пришьём %1$s!"

