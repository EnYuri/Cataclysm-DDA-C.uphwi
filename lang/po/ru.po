msgstr[2] "пар перчаток для плавания"
msgstr[3] "пара перчаток для плавания"

#. ~ Description for pair of swimming gloves
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of very flexible neoprene-silicone rubber gloves, suitable for "
"underwater use."
msgstr ""
"Эластичные неопрено-силиконовые резиновые перчатки с перепонками, пригодные "
"для использования под водой."

#: lang/json/ARMOR_from_json.py
