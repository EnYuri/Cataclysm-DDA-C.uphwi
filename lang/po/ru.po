msgid_plural "sniper conversions"
msgstr[0] "преобразование в снайперскую винтовку"
msgstr[1] "преобразования в снайперскую винтовку"
msgstr[2] "преобразований в снайперскую винтовку"
msgstr[3] "преобразование в снайперскую винтовку"

#: lang/json/gunmod_from_json.py
