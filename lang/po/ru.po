#: src/player.cpp
#, c-format
msgid "Hey, I need to kill that %1$s!"
msgstr "Эй, мне нужно убить %1$s!"

#: src/player.cpp
#, c-format
msgid "I want to watch that %1$s bleed!"
msgstr "Я хочу видеть, как %1$s истекает кровью!"

