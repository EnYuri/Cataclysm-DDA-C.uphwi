msgid_plural "Marlin 39A"
msgstr[0] "Marlin 39A"
msgstr[1] "Marlin 39A"
msgstr[2] "Marlin 39A"
msgstr[3] "Marlin 39A"

#: lang/json/gun_from_json.py
