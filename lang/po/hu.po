#: lang/json/AMMO_from_json.py
msgid "battery"
msgid_plural "batteries"
msgstr[0] "elem"
msgstr[1] "elem"

#. ~ Description for battery
#: lang/json/AMMO_from_json.py
msgid ""
"A set of universal batteries.  Used to charge almost any electronic device."
msgstr ""
"Általános használatra szánt elemkészlet. Szinte bármilyen elektronikus "
"eszköz feltölthető vele."

#: lang/json/AMMO_from_json.py
msgid "aluminum foil"
msgstr "alufólia"

#. ~ Description for aluminum foil
#: lang/json/AMMO_from_json.py
msgid ""
"A thin foil made of aluminum.  Sometimes called 'tin foil' due to being made"
" of tin in the past."
msgstr "Alumíniumból készített vékony fólia."

#: lang/json/AMMO_from_json.py
msgid "cent"
msgstr "cent"

#. ~ Description for cent
#. ~ Description for placeholder ammunition
#. ~ Description for software
#: lang/json/AMMO_from_json.py lang/json/GENERIC_from_json.py
msgid "IF YOU ARE SEEING THIS IT IS A BUG."
msgstr "HA EZT LÁTOD, PROGRAMHIBÁT LÁTSZ."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "thread"
msgstr "cérna"

#. ~ Description for thread
#: lang/json/AMMO_from_json.py
msgid "A small quantity of thread that could be used to refill a sewing kit."
msgstr "Kis adag cérna, varrókészletet lehet vele felölteni."

#: lang/json/AMMO_from_json.py
msgid "sinew"
msgstr "ín"

#. ~ Description for sinew
#: lang/json/AMMO_from_json.py
msgid "A tough sinew cut from a corpse, usable as thread."
msgstr "Cérnaként használható, hullából kivágott szívós ín."

#: lang/json/AMMO_from_json.py
msgid "plant fiber"
msgstr "növényi rost"

#. ~ Description for plant fiber
#: lang/json/AMMO_from_json.py
msgid "Tough thin fiber, taken from a plant.  Can be used as thread."
msgstr "Növényből származó vékony, de erős szál. Cérnaként használható."

#: lang/json/AMMO_from_json.py
msgid "yarn"
msgstr "fonal"

#. ~ Description for yarn
#: lang/json/AMMO_from_json.py
msgid "Wool yarn, could be used to knit wool clothing."
msgstr "Gyapjú fonal, kötött gyapjú ruha készítéséhez használható."

#: lang/json/AMMO_from_json.py
msgid "soap bar"
msgstr "szappan"

#. ~ Description for soap bar
#: lang/json/AMMO_from_json.py
msgid "A cleansing agent made into bars."
msgstr "Szilárd formába öntött tisztítószer."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "duct tape"
msgstr "szigszalag"

#. ~ Description for duct tape
#: lang/json/AMMO_from_json.py
msgid "A roll of incredibly strong tape.  Its uses are innumerable."
msgstr ""
"Egy tekercs hihetetlenül erős ragasztószalag. Számtalan felhasználási módja "
"létezik."

#: lang/json/AMMO_from_json.py
msgid "rolling paper"
msgstr "cigarettapapír"

#. ~ Description for rolling paper
#: lang/json/AMMO_from_json.py
msgid "These are thin paper strips intended for the rolling of cigarettes."
msgstr "Vékony papírcsíkok cigaretta sodrásához."

#: lang/json/AMMO_from_json.py
msgid "copper wire"
msgstr "rézdrót"

#. ~ Description for copper wire
#: lang/json/AMMO_from_json.py
msgid "Plastic jacketed copper cable of the type used in small electronics."
msgstr ""
"Kisméretű elektronikai berendezésekben használt, műanyag köpenyes rézkábel."

#: lang/json/AMMO_from_json.py
msgid "plutonium cell"
msgstr "plutónium cella"

#. ~ Description for plutonium cell
#: lang/json/AMMO_from_json.py
msgid ""
"A nuclear-powered battery.  Used to charge advanced and rare electronics."
msgstr ""
"Nukleáris töltetű akkumulátor. Modern és ritka elektronikai eszközök "
"feltöltéséhez használható."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "plutonium slurry"
msgstr "plutónium iszap"

#. ~ Description for plutonium slurry
#. ~ Description for watery plutonium slurry
#: lang/json/AMMO_from_json.py
msgid ""
"Highly radioactive slurry.  It is probably best to get far away from this."
msgstr "Erősen radioaktív iszap. Jobb minél távolabb maradni tőle."

#: lang/json/AMMO_from_json.py
msgid "watery plutonium slurry"
msgstr "vizes plutónium iszap"

#: lang/json/AMMO_from_json.py
msgid "pebble"
msgstr "kavics"

#. ~ Description for pebble
#: lang/json/AMMO_from_json.py
msgid "A handful of pebbles, useful as ammunition for slings or slingshots."
msgstr "Egy maréknyi, csúzlival kilőhető kavics."

#: lang/json/AMMO_from_json.py
msgid "marble"
msgstr "üveggolyó"

#. ~ Description for marble
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of glass marbles, useful as ammunition for slings or slingshots."
msgstr "Egy maréknyi, csúzlival kilőhető üveggolyó."

#: lang/json/AMMO_from_json.py
msgid "bearings"
msgstr "csapágy"

#. ~ Description for bearings
#: lang/json/AMMO_from_json.py
msgid "A box of ball bearings, useful as ammunition for slings or slingshots."
msgstr "Egy doboz golyóscsapágy, parittyához vagy csúzlihoz hasznos."

#: lang/json/AMMO_from_json.py
msgid "BB"
msgstr "légpuska lövedék"

#. ~ Description for BB
#: lang/json/AMMO_from_json.py
msgid "A box of small steel balls.  They deal virtually no damage."
msgstr "Doboznyi acéllövedék, szinte semmit sem sebez."

#: lang/json/AMMO_from_json.py
msgid "feather"
msgstr "toll"

#. ~ Description for feather
#: lang/json/AMMO_from_json.py
msgid "Feathers from a bird.  Useful for fletching arrows."
msgstr "Egy madár tollai. Nyilak tollazásához hasznos."

#: lang/json/AMMO_from_json.py
msgid "down feather"
msgstr "pihetoll"

#. ~ Description for down feather
#: lang/json/AMMO_from_json.py
msgid "Fluffy down feathers from a bird.  Useful for making cozy bedclothes."
msgstr "Bolyhos toll egy madárból. Kényelmes ágyneműhöz hasznos."

#: lang/json/AMMO_from_json.py
msgid "fusion pack"
msgstr "fúziós modul"

#. ~ Description for fusion pack
#: lang/json/AMMO_from_json.py
msgid ""
"In the middle of the 21st Century, military powers began to look towards "
"energy based weapons.  The result was the standard fusion pack, capable of "
"delivering bolts of superheated gas at near light speed with no recoil."
msgstr ""
"A 21. század közepétől kezdve a fegyveres erők az energia-alapú fegyverkezés"
" kérdésével is elkezdtek foglalkozni. A kutatások eredményeként született "
"meg a sztenderd fúziós modul, amely bármiféle visszarúgás nélkül "
"fénysebesség közeli torkolati sebességre gyorsított fel túlhevített "
"gázkötegeket."

#: lang/json/AMMO_from_json.py
msgid "66mm HEAT"
msgstr "66mm HEAT"

#. ~ Description for 66mm HEAT
#: lang/json/AMMO_from_json.py
msgid ""
"A 60mm high-explosive anti-tank round.  It could blow through up to two feet"
" of concrete."
msgstr ""
"66 mm-es kumulatív páncéltörő lövedék, több mint fél méteres betont is "
"átvisz."

#: lang/json/AMMO_from_json.py
msgid "120mm HEAT"
msgstr "120mm HEAT"

#. ~ Description for 120mm HEAT
#: lang/json/AMMO_from_json.py
msgid ""
"A 120mm high-explosive anti-tank round.  It could ruin anyone's whole day."
msgstr ""
"120mm-es kumulatív páncéltörő lövedék. Akit eltalál, annak nem lesz egy jó "
"napja."

#: lang/json/AMMO_from_json.py
msgid "hydrogen canister"
msgstr "hidrogén kaniszter"

#. ~ Description for hydrogen canister
#: lang/json/AMMO_from_json.py
msgid ""
"A canister of pressurized hydrogen so heavily compressed it has turned "
"solid.  With proper equipment, it could be heated to plasma."
msgstr ""
"Egy sűrített hidrogént tartalmazó kaniszter. Annyira sűrű, hogy a hidrogén "
"szilárd halmazállapotúvá vált. Megfelelő berendezéssel plazmává lehet "
"hevíteni."

#: lang/json/AMMO_from_json.py
msgid "unused .22 casing"
msgstr "használatlan .22 töltényhüvely"

#. ~ Description for unused .22 casing
#: lang/json/AMMO_from_json.py
msgid "An unfired, like-new .22 round casing, with the primer still intact."
msgstr ""
"Kilövetlen, teljesen új .22-es töltényhüvely, érintetlen csappantyúval."

#: lang/json/AMMO_from_json.py
msgid "gunpowder"
msgstr "lőpor"

#. ~ Description for gunpowder
#: lang/json/AMMO_from_json.py
msgid "Firearm-quality gunpowder."
msgstr "Lőfegyver minőségű lőpor."

#: lang/json/AMMO_from_json.py
msgid "oxidizer powder"
msgstr "oxidálópor"

#. ~ Description for oxidizer powder
#: lang/json/AMMO_from_json.py
msgid "Volatile powdered chemical oxidizer."
msgstr "Lobbanékony oxidáló vegyi anyag."

#: lang/json/AMMO_from_json.py
msgid "lye powder"
msgstr "lúgpor"

#. ~ Description for lye powder
#: lang/json/AMMO_from_json.py
msgid "Powdered caustic soda."
msgstr "Marónátron-por"

#: lang/json/AMMO_from_json.py
msgid "shotgun primer"
msgstr "csappantyú söréthüvelyhez"

#. ~ Description for shotgun primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a shotgun shell."
msgstr "Egy sörétes lövedékhez használható csappantyú"

#: lang/json/AMMO_from_json.py
msgid "small pistol primer"
msgstr "csappantyú kis pisztolyhoz"

#. ~ Description for small pistol primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a small caliber pistol round."
msgstr "Egy alacsony kaliberű pisztolylőszerhez használható csappantyú."

#: lang/json/AMMO_from_json.py
msgid "large pistol primer"
msgstr "csappantyú nagy pisztolyhoz"

#. ~ Description for large pistol primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a large caliber pistol round."
msgstr "Egy magas kaliberű pisztolylőszerhez használható csappantyú."

#: lang/json/AMMO_from_json.py
msgid "small rifle primer"
msgstr "csappantyú kis karabélyhoz"

#. ~ Description for small rifle primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a small caliber rifle round."
msgstr "Egy alacsony kaliberű karabélylőszerhez használható csappantyú."

#: lang/json/AMMO_from_json.py
msgid "large rifle primer"
msgstr "csappantyú nagy karabélyhoz"

#. ~ Description for large rifle primer
#: lang/json/AMMO_from_json.py
msgid "Primer from a large caliber rifle round."
msgstr "Egy magas kaliberű karabélylőszerhez használható csappantyú."

#: lang/json/AMMO_from_json.py
msgid "rubber slug"
msgstr "gumilövedék"

#. ~ Description for rubber slug
#: lang/json/AMMO_from_json.py
msgid ""
"Rubber slugs from a shotgun beanbag round.  You could use them to make new "
"beanbag rounds."
msgstr ""
"Gumilövedék sörétes puska lőszerből. Új babzsák lőszer készítéséhez lehet "
"használni."

#: lang/json/AMMO_from_json.py
msgid "copper"
msgstr "réz"

#. ~ Description for copper
#: lang/json/AMMO_from_json.py
msgid ""
"Copper scraps.  Could be used to craft something, for example makeshift "
"shotgun shells."
msgstr ""
"Hulladék réz. Valaminek az elkészítéséhez lehet használni, például "
"hevenyészett sörétes puska lőszerhez."

#: lang/json/AMMO_from_json.py
msgid "solder"
msgstr "forrasztóón"

#. ~ Description for solder
#: lang/json/AMMO_from_json.py
msgid ""
"A small spool of solder, able to be used in ammunition and electronics."
msgstr ""
"Egy kis tekercs forrasztóón, amit lőszerekhez és elektronikai eszközökhöz "
"lehet használni."

#: lang/json/AMMO_from_json.py
msgid "tin"
msgstr "ón"

#. ~ Description for tin
#: lang/json/AMMO_from_json.py
msgid "Tin and pewter scraps.  Usable in making ammo."
msgstr "Ón és bádog hulladék. Lőszer-készítéshez lehet használni."

#: lang/json/AMMO_from_json.py
msgid "medical tape"
msgstr "orvosi ragasztószalag"

#. ~ Description for medical tape
#: lang/json/AMMO_from_json.py
msgid "A roll of medical tape, similar to duct tape."
msgstr "Egy tekercs orvosi ragasztószalag, hasonlít a szigszalaghoz."

#: lang/json/AMMO_from_json.py
msgid "PG-7VL 93mm rocket"
msgstr "PG-7VL 93mm rakéta"

#. ~ Description for PG-7VL 93mm rocket
#: lang/json/AMMO_from_json.py
msgid "93mm single-stage high-explosive ammunition for the RPG-7."
msgstr "93 mm-es, egylépcsős robbanó muníció az RPG-7-hez."

#: lang/json/AMMO_from_json.py
msgid "M235 66mm TPA rocket"
msgstr "M235 66mm TPA rakéta"

#. ~ Description for M235 66mm TPA rocket
#: lang/json/AMMO_from_json.py
msgid ""
"66mm incendiary rockets used in the M202 FLASH rocket launcher.  Their "
"warheads are filled with a thickened pyrophoric agent, which burns at 2200 "
"degrees Fahrenheit."
msgstr ""
"66 mm-es tűzgyújtó rakéta az M202 FLASH rakétakilövőhöz. A robbanófejeket "
"egy 1000 fokon égő piroforos szerrel töltötték fel.\""

#: lang/json/AMMO_from_json.py
msgid "placeholder ammunition"
msgstr "placeholder ammunition"

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "charcoal"
msgstr "faszén"

#. ~ Description for charcoal
#: lang/json/AMMO_from_json.py
msgid ""
"A flammable carbon-based material produced by slowly burning wood.  Utilized"
" in recipes requiring a pure, hot flame.  Can also be used in filters to "
"remove contaminants out of air and water."
msgstr ""
"Gyúlékony szénalapú anyag, amelyet fa lassú égetésével hoznak létre. Olyan "
"recepteknél használják, ahol egy tiszta és forró lángra van szükség. "
"Használatával továbbá vízből és levegőből lehet a szennyezést kiszűrni."

#: lang/json/AMMO_from_json.py
msgid "coal"
msgstr "szén"

#. ~ Description for coal
#: lang/json/AMMO_from_json.py
msgid ""
"Flammable black chunks of carbon-based material commonly used for cooking "
"and heating."
msgstr ""
"Főzésre és melegítésre használt, gyúlékony fekete szén-alapú anyag darabjai."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "modified mininuke"
msgstr "módosított mininuki"

#. ~ Description for modified mininuke
#: lang/json/AMMO_from_json.py
msgid ""
"A heavily modified handheld nuclear device on a rocket.  Intended to be "
"fired from a specialized launcher, it has been rigged to explode on impact "
"instead of on a timer.  It can fly further than the explosion will reach, "
"probably."
msgstr ""
"Rakétatestre erősített, nagy mértékben módosított kézi nukleáris fegyver. "
"Egy erre a célra készült kilövőből indítható, időzítés helyett becsapódásra "
"robban. Messzebbre repül, mint a robbanás széle. Talán."

#: lang/json/AMMO_from_json.py
msgid "RA21E medical ampoule"
msgstr "RA21E orvosi ampulla"

#. ~ Description for RA21E medical ampoule
#: lang/json/AMMO_from_json.py
msgid ""
"A tiny glass vial filled with advanced fast-healing chemicals which can only"
" be activated by a Rivtech jet injector device.  A label on the side warns "
"against using more than two doses per hour."
msgstr ""
"Csak egy Rivtech tűmentes injekciós rendszerben használható, gyorsgyógyító "
"vegyszerekkel megtöltött apró üvegampulla. Az ampulla oldalán olvasható "
"figyelmeztetés szerint az óránkénti két befecskendezést nem szabad túllépni."

#: lang/json/AMMO_from_json.py
msgid "RA10K stimulant module"
msgstr "RA10K serkentő modul"

#. ~ Description for RA10K stimulant module
#: lang/json/AMMO_from_json.py
msgid ""
"A pressurized multi-chamber glass vial filled with powerful chemical "
"stimulants which can only be activated by a Rivtech stimulant delivery "
"system."
msgstr ""
"Csak egy Rivtech stimuláns rendszerben használható, erős vegyi "
"serkentőszerekkel megtöltött, többkamrás, nyomás alatt álló üvegampulla."

#: lang/json/AMMO_from_json.py
msgid "rebreather filter cartridge"
msgstr "újralégző szűrőbetét"

#. ~ Description for rebreather filter cartridge
#: lang/json/AMMO_from_json.py
msgid "A replacement filter cartridge for a rebreather."
msgstr "Egy újralélegző készülék csere szűrőbetétje."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "filter mask cartridge"
msgstr "szűrőbetét"

#. ~ Description for filter mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Small replacement filter cartridge for air filtration masks."
msgstr "Kisméretű cserebetét a légszűrő maszkokhoz."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "gas mask cartridge"
msgstr "gázmaszk betét"

#. ~ Description for gas mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Medium replacement filter cartridge for air filtration masks."
msgstr "Közepes méretű cserebetét a légszűrő maszkokhoz"

#: lang/json/AMMO_from_json.py
msgid "chemical mask cartridge"
msgstr "vegyvédelmi maszk betét"

#. ~ Description for chemical mask cartridge
#: lang/json/AMMO_from_json.py
msgid "Heavy replacement filter cartridge for air filtration masks."
msgstr "Nagy teherbírású cserebetét a légszűrő maszkokhoz"

#: lang/json/AMMO_from_json.py
msgid "nicotine liquid"
msgstr "folyékony nikotin"

#. ~ Description for nicotine liquid
#: lang/json/AMMO_from_json.py
msgid ""
"A liquid that is made up of propylene glycol, vegetable glycerin, flavorings"
" and nicotine."
msgstr ""
"A folyadék propilén-glikolból, növényi glicerinből, aromákból és nikotinból "
"áll."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "fish bait"
msgstr "hal csali"

#. ~ Description for fish bait
#: lang/json/AMMO_from_json.py
msgid "A bait used in traps to lure fish."
msgstr "Halak csapdába ejtésénél használt csali."

#: lang/json/AMMO_from_json.py
msgid "oxygen"
msgstr "oxigén"

#. ~ Description for oxygen
#: lang/json/AMMO_from_json.py
msgid "A canister of oxygen."
msgstr "Egy oxigéntartály."

#: lang/json/AMMO_from_json.py
msgid "spiked home-made rocket"
msgstr "tüskés házi rakéta"

#. ~ Description for spiked home-made rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand-built rocket, consisting of a spike welded onto a pipe that was "
"filled with improvised rocket fuel.  Horribly inaccurate, as can be expected"
" of this grade of weapon, but packs a fierce punch... if it hits."
msgstr ""
"Házi készítésű rakéta, amely egy kézi készítésű rakéta üzemanyaggal töltött "
"csőből, valamint a csőre hegesztett tüskéből áll. Fegyvernek rendkívül "
"pontatlan, ahogy egy ilyen hevenyészett fegyvertől elvárható, viszont nagyon"
" üt.. ha célba talál."

#: lang/json/AMMO_from_json.py
msgid "explosive home-made rocket"
msgstr "robbanó házi rakéta"

#. ~ Description for explosive home-made rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand-built rocket, consisting of a simple explosive warhead attached onto "
"a pipe, filled with improvised rocket fuel.  Not very powerful, but can be "
"made from scratch."
msgstr ""
"Kézi készítésű rakéta, amely egy kéz készítésű rakéta üzemanyaggal töltött "
"csőből, valamint a csőre illesztett robbanófejből áll. Nem nagyon ütőképes, "
"viszont a semmiből összeszerelhető."

#: lang/json/AMMO_from_json.py
msgid "incendiary home-made rocket"
msgstr "gyújtó házi rakéta"

#. ~ Description for incendiary home-made rocket
#: lang/json/AMMO_from_json.py
msgid ""
"A hand-built rocket, consisting of a container of flammable gel attached "
"onto a pipe, filled with improvised rocket fuel.  Short-range incendiary - "
"handle with care!"
msgstr ""
"Kézi készítésű rakéta, amely egy házi készítésű rakéta üzemanyaggal töltött "
"csőből, valamint a csőre illesztett, éghető zselével megtöltött tárolóból "
"áll. Hatótávolsága rövid, a lángja pedig forró - csak óvatosan!"

#: lang/json/AMMO_from_json.py
msgid "unfinished charcoal"
msgstr "félbemaradt faszén"

#. ~ Description for unfinished charcoal
#: lang/json/AMMO_from_json.py
msgid ""
"The result of an interrupted charcoal making process.  Useless, except as "
"fuel in a charcoal kiln."
msgstr ""
"Egy félbeszakított faszénkészítési folyamat eredménye. Faszén kemence "
"tüzelőanyagon kívül másra használhatatlan."

#: lang/json/AMMO_from_json.py
msgid "sprayable fungicide"
msgstr "permetezhető gombaölő"

#. ~ Description for sprayable fungicide
#: lang/json/AMMO_from_json.py
msgid ""
"Fungicide enhanced with sulfur to create sprayable anti-fungal ammo for the "
"chemical thrower.  Best be used with some kind of mask or mouth protection."
msgstr ""
"Kénnel fokozott hatású gombaölő szer, amely vegyi lángszóróban használható "
"gombaelhárító munícióként hasznosítható. Használatához nem árt valamiféle "
"maszkot, vagy légzést tisztító ruhadarabot felvenni."

#: lang/json/AMMO_from_json.py
msgid "sprayable toxic gas"
msgstr "permetezhető mérgesgáz"

#. ~ Description for sprayable toxic gas
#: lang/json/AMMO_from_json.py
msgid ""
"A hazardous mixture made from household cleaners, improvised for use in a "
"chemical thrower.  Best be used with some kind of mask or mouth protection."
msgstr ""
"Vegyi lángszóróban használható, háztartási tisztítószerekből készített "
"veszélyes anyag. Használatához nem árt valamiféle maszkot, vagy légzést "
"tisztító ruhadarabot felvenni."

#: lang/json/AMMO_from_json.py
msgid "chain link"
msgstr "láncszem"

#. ~ Description for chain link
#: lang/json/AMMO_from_json.py
msgid "Small metal rings, suitable for constructing chainmail."
msgstr "Apró fémkarikák, amelyekből sodronypáncélt lehet készíteni."

#: lang/json/AMMO_from_json.py
msgid "fire-hardened wooden arrow"
msgstr "tűzkeményített fa nyílvessző"

#. ~ Description for fire-hardened wooden arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This simple arrow has a fire-hardened point and fletching.  Stands a below "
"average chance of remaining intact once fired."
msgstr ""
"Ennek az egyszerű nyílvesszőnek a hegyét tűzben keményítették és tollazattal"
" látták el. Az átlagosnál kisebb esélye van arra, hogy kilövés után is "
"egyben marad."

#: lang/json/AMMO_from_json.py
msgid "field point wooden arrow"
msgstr "hengeres sima hegyű fa nyílvessző"

#. ~ Description for field point wooden arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A simple arrow shaft with a crude arrowhead and fletching.  Useful for "
"hunting small woodland creatures, or as a last ditch defense against "
"zombies.  Stands a below average chance of remaining intact once fired."
msgstr ""
"Kezdetleges nyílheggyel és tollazattal ellátott egyszerű nyílvessző. Kisebb "
"erdei vadak elejtéséhez ideális, de végső esetben a zombik ellen is "
"használható. Az átlagosnál kisebb esélye van arra, hogy kilövés után is "
"egyben marad."

#: lang/json/AMMO_from_json.py
msgid "small game arrow"
msgstr "kis vadászónyíl"

#. ~ Description for small game arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A simple arrow shaft that has a wide, blunt head.  Useful for hunting small "
"woodland creatures without splattering them all over the ground, but stands "
"a below average chance of remaining intact once fired."
msgstr ""
"Széles és tompa hegyű egyszerű nyílvessző. Kisebb erdei vadak elejtéséhez "
"ideális, mivel a találat nem trancsírozza szét a zsákmányt. Az átlagosnál "
"kisebb esélye van arra, hogy kilövés után is egyben marad."

#: lang/json/AMMO_from_json.py
msgid "wooden arrow"
msgstr "fa nyíl"

#. ~ Description for wooden arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A basic wooden arrow, it has a metal arrowhead and fletching.  It's "
"lightweight, does some damage, and is so-so on accuracy.  Stands a below "
"average chance of remaining intact once fired."
msgstr ""
"Kezdetleges fa nyílvessző, fém nyílheggyel és tollazattal. Könnyű a súlya, "
"némi sebzést is okoz, a pontossága kettes alá. Kilövés után az átlagosnál "
"kisebb eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "heavy fire-hardened arrow"
msgstr "tűzkeményített fa nehéznyíl"

#. ~ Description for heavy fire-hardened arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This arrow is significantly sturdier than other wooden arrows.  It has a "
"fire-hardened point and fletching.  Stands a good chance of remaining intact"
" once fired."
msgstr ""
"A többi fából készült nyílhoz képest ez a nyíl lényegesen strapabíróbb. A "
"nyílhegyet tűzön keményítették és van tollazata is. Az átlagosnál jobb "
"esélye van arra, hogy kilövés után is egyben marad."

#: lang/json/AMMO_from_json.py
msgid "heavy field point arrow"
msgstr "hengeres sima hegyű fa nehéznyíl"

#. ~ Description for heavy field point arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This arrow is significantly sturdier than other wooden arrows.  It has a "
"crude field point head and fletching.  Stands a good chance of remaining "
"intact once fired."
msgstr ""
"A többi fából készült nyílhoz képest ez a nyíl lényegesen strapabíróbb. A "
"nyílhegyet durván megmunkálták és van tollazata is. Az átlagosnál jobb "
"esélye van arra, hogy kilövés után is egyben marad."

#: lang/json/AMMO_from_json.py
msgid "heavy wooden arrow"
msgstr "nehéz fa nyíl"

#. ~ Description for heavy wooden arrow
#: lang/json/AMMO_from_json.py
msgid ""
"A heavy wooden arrow, it has a metal arrowhead and fletching.  It's much "
"heavier than other wooden arrows, and as a result, it does more damage and "
"flies straighter, resulting in better accuracy over a longer range.  Stands "
"a good chance of remaining intact once fired."
msgstr ""
"Nehéz, fából készült nyíl, fém nyílheggyel és tollazattal. A többi fanyílnál"
" lényegesen nehezebb, ezért több sebzést okoz és a röppályája is stabilabb. "
"Ennek köszönhetően hosszabb távra is viszonylag pontosan lehet vele lőni. "
"Kilövés után jó eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "sharpened metal arrow"
msgstr "kihegyezett fém nyíl"

#. ~ Description for sharpened metal arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This metal shaft has been roughly sharpened so that it has a crude point at "
"the end.  Stands a very good chance of remaining intact once fired."
msgstr ""
"Ennek a fém nyílvesszőnek durván kihegyezték az egyik végét. Kilövés után jó"
" eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "metal broadhead arrow"
msgstr "szélesfejű fém nyíl"

#. ~ Description for metal broadhead arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This metal arrow has fletching and a steel arrowhead.  Stands a very good "
"chance of remaining intact once fired."
msgstr ""
"Ennek a fém nyílvesszőnek tollazata van és egy acél nyílhegye. Kilövés után "
"jó eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "metal bodkin arrow"
msgstr "bodkin fém nyíl"

#. ~ Description for metal bodkin arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This metal arrow has fletching and a steel bodkin arrowhead for armor "
"penetration.  Stands a very good chance of remaining intact once fired."
msgstr ""
"Ennek a fém nyílvesszőnek tollazata van és egy bodkin acél nyílhegye a "
"páncél átütéséhez. Kilövés után nagyon jó eséllyel marad továbbra is egy "
"darabban."

#: lang/json/AMMO_from_json.py
msgid "metal target arrow"
msgstr "gyakorló fém nyíl"

#. ~ Description for metal target arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This metal arrow has extra long fletching and a round, balanced arrowhead "
"for extra accuracy, at the cost of some damage.  Stands a very good chance "
"of remaining intact once fired."
msgstr ""
"Ennek a fém nyílvesszőnek nagyon hosszú tollazata van és egy kerek, "
"kiegyensúlyozott nyílhegye az extra pontossághoz, amitől némileg csökken a "
"sebzése. Kilövés után jó eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "carbon fiber arrow"
msgstr "szénszálas nyílvessző"

#. ~ Description for carbon fiber arrow
#: lang/json/AMMO_from_json.py
msgid ""
"High-tech carbon fiber shafts and 100 grain broadheads.  Very lightweight, "
"fast, and durable.  Stands a great chance of remaining intact once fired."
msgstr ""
"Csúcstechnológiájú szénszálas nyílvessző 100 graines, széles nyílheggyel. "
"Nagyon könnyű és tartós. Kilövés után jó esély van arra, hogy továbbra is "
"egy darabban marad."

#: lang/json/AMMO_from_json.py
msgid "explosive arrow"
msgstr "robbanó nyíl"

#. ~ Description for explosive arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This arrow has a small IED strapped to its tip.  Horribly inaccurate, heavy,"
" and bulky, not only does this contraption require expert hands to pull off "
"a shot, it requires one to loose this with a small measure of confidence "
"that the shooter won't be caught in the blast radius."
msgstr ""
"Ennek a nyílvesszőnek a hegyére egy rögtönzött pokolgépet csavartak. "
"Elképesztően pontatlan, nehéz és ormótlan - kilövéséhez nem csak pontos kezű"
" célzás kell, de némi önbizalom is, hogy az íjászt már nem éri el a "
"robbanás."

#: lang/json/AMMO_from_json.py
msgid "flaming arrow"
msgstr "lángoló nyíl"

#. ~ Description for flaming arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This arrow has a flaming rag wrapped around the shaft near the head.  You "
"should shoot it soon before it burns your bow."
msgstr ""
"A nyílhegy mögé egy lángoló rongyot csavartak. Nem ártana még azelőtt "
"kilőni, hogy porrá égeti az íjadat."

#: lang/json/AMMO_from_json.py
msgid "throwing knife"
msgid_plural "throwing knives"
msgstr[0] "dobókés"
msgstr[1] "dobókés"

#. ~ Description for throwing knife
#: lang/json/AMMO_from_json.py
msgid ""
"A thin and flat knife made for throwing.  Its ineffective cutting edge and "
"odd shape makes it unsuitable for use as a tool."
msgstr ""
"Dobásra készített vékony és lapos kés. A vágóéle nem sokra jó, a furcsa "
"formája miatt szerszámként nem lehet használni."

#: lang/json/AMMO_from_json.py
msgid "throwing axe"
msgstr "dobó balta"

#. ~ Description for throwing axe
#: lang/json/AMMO_from_json.py
msgid ""
"A lightweight hatchet made for throwing.  Its ineffective cutting edge and "
"light weight makes it unsuitable for use as a tool."
msgstr ""
"Dobásra készített könnyűszerkezetű balta. A vágóéle nem sokra jó, az "
"alacsony tömege miatt szerszámként nem lehet használni."

#: lang/json/AMMO_from_json.py
msgid "lawn dart"
msgstr "kerti dobónyíl"

#. ~ Description for lawn dart
#: lang/json/AMMO_from_json.py
msgid "A large plastic dart made for outdoor games."
msgstr "Kerti játéknak készült nagyméretű műanyag dobónyíl."

#: lang/json/AMMO_from_json.py
msgid "wooden fishing spear"
msgstr "fa halászdárda"

#. ~ Description for wooden fishing spear
#: lang/json/AMMO_from_json.py
msgid ""
"An underwater fishing spear made from wood tipped with steel.  It's very "
"light, but doesn't have much range.  Stands a below average chance of "
"remaining intact once fired."
msgstr ""
"Vízalatti halászáshoz készült acélhegyes fadárda. Könnyű, de nem lehet "
"messzire vetni. Kilövés után az átlagosnál rosszabb eséllyel marad továbbra "
"is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "metal fishing spear"
msgstr "fém halászdárda"

#. ~ Description for metal fishing spear
#: lang/json/AMMO_from_json.py
msgid ""
"An underwater fishing spear made from metal.  It's light, but doesn't have "
"much range.  Stands a very good chance of remaining intact once fired."
msgstr ""
"Vízalatti halászáshoz készült fémdárda. Könnyű, de nem lehet messzire vetni."
" Kilövés után nagyon jó eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "carbon fiber fishing spear"
msgstr "szénszálas halászdárda"

#. ~ Description for carbon fiber fishing spear
#: lang/json/AMMO_from_json.py
msgid ""
"An underwater fishing spear made from carbon fiber.  It's very light, but "
"doesn't have much range.  Stands a bad chance of remaining intact once "
"fired."
msgstr ""
"Vízalatti halászáshoz készült szénszálas dárda. Könnyű, de nem lehet "
"messzire vetni. Kilövés után rossz eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "plastic arrow"
msgstr "műanyag nyíl"

#. ~ Description for plastic arrow
#: lang/json/AMMO_from_json.py
msgid ""
"This plastic arrow has a plastic arrowhead and fletching.  Stands a good "
"chance of remaining intact once fired."
msgstr ""
"Ezt az egyszerű műanyag nyílvesszőt tollazattal látták el. Az átlagosnál "
"jobb esélye van arra, hogy kilövés után is egyben marad."

#: lang/json/AMMO_from_json.py
msgid "anesthetic kit"
msgstr "altatóorvosi készlet"

#. ~ Description for anesthetic kit
#: lang/json/AMMO_from_json.py
msgid ""
"A kit for inducing anesthesia for surgery, containing specialized canisters "
"with a variety of powerful hypnotic, analgetic, and stimulative drugs.  It's"
" intended for use in specialized medical equipment, and can't be "
"administered manually."
msgstr ""
"Sebészeti altatáshoz használatos készlet, amely számos hipnózist, altatást "
"és ébresztést indukáló gyógyszert tartalmazó kannából áll. Csak a megfelelő "
"orvosi berendezésben használható, kézzel nem lehet beadni."

#: lang/json/AMMO_from_json.py
msgid "sulfur"
msgid_plural "sulfur"
msgstr[0] "kén"
msgstr[1] "kén"

#. ~ Description for sulfur
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of yellow grains of pure sulfur.  Primarily used to make battery "
"acid, sulfur is sometimes used as fuel for explosives.  Can be burned to "
"produce acidic smoke, that is deadly to bacteria and humans alike, or "
"oxidized to make paper-bleaching agents."
msgstr ""
"Egy maréknyi vegytiszta, sárga kénpor. Elsősorban akkumulátorsav "
"készítésénél használják, néha pedig robbanóanyagokhoz. Égetésénél savas füst"
" jön létre, amely egyaránt végzetes baktériumokra és emberekre, illetve "
"oxidálásával papírfehérítő szert lehet készíteni."

#: lang/json/AMMO_from_json.py
msgid "chunk of sulfur"
msgid_plural "chunks of sulfur"
msgstr[0] "kéndarab"
msgstr[1] "kéndarab"

#. ~ Description for chunk of sulfur
#: lang/json/AMMO_from_json.py
msgid "A large chunk of pure sulfur.  Break it up to use it."
msgstr "Egy nagy darab vegytiszta kén. Használatához törd szét."

#: lang/json/AMMO_from_json.py
msgid "cement"
msgid_plural "cement"
msgstr[0] "cement"
msgstr[1] "cement"

#. ~ Description for cement
#: lang/json/AMMO_from_json.py
msgid ""
"Portland is most likely long gone, but its memory persists in cement.  This "
"ubiquitous binder can be used for all kinds of advanced masonry.  Just add "
"water."
msgstr ""
"Portland már valószínűleg az enyészeté, de emléke a cementben tovább él. Ezt"
" a mindenütt jelen levő kötőanyagot mindenféle kőművesmunkákhoz lehet "
"használni. Csak vizet kell hozzáadni."

#: lang/json/AMMO_from_json.py
msgid "limestone"
msgid_plural "limestone"
msgstr[0] "mészkő"
msgstr[1] "mészkő"

#. ~ Description for limestone
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of small chunks of limestone.  Useful for experiments at science "
"fairs, but pretty useless as ammo.  Maybe something could be crafted from "
"this stuff…"
msgstr ""
"Egy maréknyi mészkő darab. Iskolai kísérletekhez nagyon praktikus, "
"lövedékként már kevésbé. Talán valamihez ezt fel lehet használni..."

#: lang/json/AMMO_from_json.py
msgid "quicklime"
msgid_plural "quicklime"
msgstr[0] "oltatlan mész"
msgstr[1] "oltatlan mész"

#. ~ Description for quicklime
#: lang/json/AMMO_from_json.py
msgid ""
"The product of burning limestone, this white powder is a crucial ingredient "
"in making cement.  That said, it is also extremely caustic and will cause "
"severe burns to any tissue it comes in contact with.  This property could "
"probably be exploited..."
msgstr ""
"Elégetett mészkő terméke. Ez a fehér por kulcsfontosságú a "
"cementkészítésnél. Mindezek mellett elképesztően maró hatású, és súlyos "
"égési sérüléseket okoz bármiféle szövettel kerül kapcsolatba. Ezt a "
"tulajdonságát talán jól lehet hasznosítani..."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
msgid "sand"
msgid_plural "sand"
msgstr[0] "homok"
msgstr[1] "homok"

#. ~ Description for sand
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of New England sand.  If you had a stoked furnace, you could turn "
"it into glass.  Otherwise, it's only good for making cement."
msgstr ""
"Egy maréknyi New England-i homok. Ha lenne megfelelő kemencét, akkor üveget "
"is olvaszthatnál belőle. Egyébként csak a cementkészítéshez jó."

#: lang/json/AMMO_from_json.py
msgid "aluminum powder"
msgid_plural "aluminum powder"
msgstr[0] "alumínium por"
msgstr[1] "alumínium por"

#. ~ Description for aluminum powder
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of finely ground aluminum powder.  This strong reducing agent was "
"used in combination with various oxidants for chemical welding and "
"explosives alike.  Just before the Cataclysm, however, it was the basis of "
"virtually all commercial metallic-hued paints and anti-corrosive coatings."
msgstr ""
"Egy maréknyi finomra őrölt alumínium por. Ezt az erős redukálószert számos "
"oxidálószerrel együtt használták vegyi hegesztésre illetve robbanóanyag "
"készítésre. A kataklizma előtt szinte az összes fémszínű festékben és "
"korrózióvédő bevonatban is használták."

#: lang/json/AMMO_from_json.py
msgid "zinc powder"
msgid_plural "zinc powder"
msgstr[0] "cink por"
msgstr[1] "cink por"

#. ~ Description for zinc powder
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of zinc powder.  While commercially used mostly in cosmetics and "
"for paints, hobbyists used to mix it with sulfur to make basic rocket fuel /"
" smokescreen.  When treated with a strong acid, it will produce hydrogen."
msgstr ""
"Egy maréknyi cink por. Bár a kereskedelemben főleg kozmetikumokban és "
"festékekben használták, amatőr rakétarajongók kénporral keverve egyszerű "
"rakéta-üzemanyagot és rejtőködöt is készítettek belőle. Erős savval reagálva"
" hidrogént szabadít fel."

#: lang/json/AMMO_from_json.py
msgid "sulfuric acid"
msgid_plural "sulfuric acid"
msgstr[0] "kénsav"
msgstr[1] "kénsav"

#. ~ Description for sulfuric acid
#: lang/json/AMMO_from_json.py
msgid ""
"Sulfuric acid: viscous, foul-smelling and extremely corrosive, particularly "
"to organic matter and evil clowns.  Although used to prepare a number of "
"chemicals, it is mostly known as battery acid, due to its widest commercial "
"application."
msgstr ""
"A kénsav egy viszkózus, büdös és rendkívül korrozív anyag, kifejezetten "
"szerves anyagok és gonosz bohócok ellen használható. Bár számos vegyi anyag "
"előállításához használták, leggyakrabban mégis akkumulátorsavként ismert."

#: lang/json/AMMO_from_json.py
msgid "acetone"
msgid_plural "acetone"
msgstr[0] "aceton"
msgstr[1] "aceton"

#. ~ Description for acetone
#: lang/json/AMMO_from_json.py
msgid ""
"Acetone, best known as the primary constituent of most nail polish removers."
"  Flammable and can be easily used for potent home-made explosives, as "
"demonstrated by the terrorist attacks of 2016."
msgstr ""
"Az aceton a körömlakklemosók leggyakrabban használt összetevője. Könnyen "
"gyullad, ezért egyszerűen készíthetők segítségével házi robbanóanyagok, "
"ahogyan ezt a 2016-os terrortámadások is megmutatták."

#: lang/json/AMMO_from_json.py
msgid "nitric acid"
msgid_plural "nitric acid"
msgstr[0] "salétromsav"
msgstr[1] "salétromsav"

#. ~ Description for nitric acid
#: lang/json/AMMO_from_json.py
msgid ""
"Nitric acid, a strong oxidant and extremely corrosive material.  Mainly used"
" in the production of synthetic fertilizers, for etching of circuit boards "
"and in woodworking.  Remains quite useful both for making a vast array of "
"pyrotechnic and explosive agents and as a direct weapon: not many beings "
"enjoy being doused in nitric acid."
msgstr ""
"A salétromsav egy erős oxidálószer és egy rendkívüli módon korrozív anyag. "
"Főleg a műtrágyagyártásnál használták, illetve nyomtatott áramkörök "
"maratásához és fa megmunkáláshoz. Továbbra is nagyon hasznos számos "
"pirotechnikai és robbanóanyag elkészítéséhez, valamint közvetlen bevetésre "
"is. Nem sok mindenki szereti, ha salétromsavval öntik le."

#: lang/json/AMMO_from_json.py
msgid "chromium oxide"
msgid_plural "chromium oxide"
msgstr[0] "króm-oxid"
msgstr[1] "króm-oxid"

#. ~ Description for chromium oxide
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of chromium oxide pellets.  This substance, typically known as the"
" only stable green pigment for paints, is also a mild oxidizer, which can be"
" mixed with aluminum powder to make thermite for welding.  If one had access"
" to a CVD machine and a laboratory worth of reagents, they might be able to "
"produce very durable ceramic layers."
msgstr ""
"Egy marék króm-oxid pellet. Általában az egyetlen stabil pigmentanyag "
"festékeknél, a króm-oxid ezen túl még enyhe oxidálószer, amelyet termites "
"hegesztéshez alumínium porral lehet összekeverni. Egy CVD géppel és egy "
"laboratóriumnyi reagenssel valaki nagyon tartós kerámia páncélréteget is "
"tudna készíteni."

#: lang/json/AMMO_from_json.py
msgid "calcium carbide"
msgid_plural "calcium carbide"
msgstr[0] "kalcium-karbid"
msgstr[1] "kalcium-karbid"

#. ~ Description for calcium carbide
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of calcium carbide chunks, giving off a faint, garlic-like smell."
"  Commercially, calcium carbide was used for on-the-spot manufacture of "
"acetylene and historically to power acetylene lamps.  If mixed with water "
"and sealed, it will explode with little strength, but with relatively loud "
"noise and could maybe be used as a decoy..."
msgstr ""
"Egy maroknyi kalcium-karbid darab, enyhén fokhagyma-szagú. Ipari alkalmazása"
" során a kalcium-karbidot acetilén helyi előállítására használták, illetve "
"régebben acetilénlámpák tüzelőanyagaként. Vízzel összekeverve majd lezárva "
"kisméretű robbanást idéz elő, ami viszont jó nagyot szól, és talán "
"csalétekként is használható..."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "hexamine"
msgid_plural "hexamine"
msgstr[0] "hexamin"
msgstr[1] "hexamin"

#. ~ Description for hexamine
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of waxy hexamine tablets.  This ubiquitous fuel was used to start "
"up almost every garden grill and no 'real' camping trip could do its cooking"
" without it, until the Cataclysm.  Nowadays, it is even more valuable then "
"before, being the key component in the preparation of several military-grade"
" explosives."
msgstr ""
"Egy marék hexamin tabletta. Ezt az igen elerjedt anyagot szinte az összes "
"kerti grill begyújtásához használták, és a kataklizma előtt nem is számított"
" igazi kirándulásnak az, ahol nem ezzel indították be a tábortüzet. Manapság"
" még értékesebb, mivel számos katonai minőségű robbanóanyag elkészítésénél "
"használható."

#: lang/json/AMMO_from_json.py
msgid "hydrogen peroxide (concentrated)"
msgid_plural "hydrogen peroxide (concentrated)"
msgstr[0] "hidrogén-peroxid (koncentrált)"
msgstr[1] "hidrogén-peroxid (koncentrált)"

#. ~ Description for hydrogen peroxide (concentrated)
#: lang/json/AMMO_from_json.py
msgid ""
"Concentrated hydrogen peroxide is a powerful oxidant, violently decomposing "
"in contact with most reducing agents.  Can be used as rocket fuel or to make"
" high explosives.  Causes severe burns to any organic matter and may ignite "
"it on contact."
msgstr ""
"A koncentrált hidrogén-peroxid egy rendkívül erőteljes oxidáns, a legtöbb "
"redukálószerrel vegyítve hevesen lebomlik. Rakéták hajtóanyagaként, vagy "
"nagy erejű robbanóanyagok gyártásánál használható. Bármilyen szerves "
"anyaghoz érintve súlyos égési sérüléseket okoz, és akár érintésre is lángra "
"robbanhat."

#: lang/json/AMMO_from_json.py
msgid "ammonium nitrate"
msgid_plural "ammonium nitrate"
msgstr[0] "ammónium-nitrát"
msgstr[1] "ammónium-nitrát"

#. ~ Description for ammonium nitrate
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of ammonium nitrate.  This white, crystalline powder is commonly "
"used as a component of fertilizers and explosives.  Could also be dissolved "
"in water to sharply lower its temperature, but is there any use for this "
"quality in this new world?"
msgstr ""
"Egy marék ammónium-nitrát. Ezt a fehér, kristályos port gyakran használják "
"műtrágyákban és robbanóanyagoknál. Vízben feloldva gyorsan lecsökkenti annak"
" a hőmérsékletét, de vajon ennek a jellemzőjének mi haszna lehet ebben az új"
" világban?"

#: lang/json/AMMO_from_json.py
msgid "saltpeter"
msgid_plural "saltpeter"
msgstr[0] "salétrom"
msgstr[1] "salétrom"

#. ~ Description for saltpeter
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of saltpeter.  Sometimes used as a fertilizer, this ubiquitous "
"nitrate is the principal constituent of black gunpowder and simple rocket "
"propellants, such as rocket candy."
msgstr ""
"Egy maréknyi salétrom. Néha műtrágyaként használják, ez a mindenütt "
"jelenlévő nitrát a fekete lőpor, az egyszerű rakéta-hajtóanyagok és a "
"robbanócukor egyik alapvető alkotóeleme."

#: lang/json/AMMO_from_json.py
msgid "niter"
msgid_plural "niter"
msgstr[0] "salétromsó"
msgstr[1] "salétromsó"

#. ~ Description for niter
#: lang/json/AMMO_from_json.py
msgid ""
"A large crystal of niter, the mineral form of potassium nitrate.  It can be "
"processed into saltpeter."
msgstr ""
"Nagyméretű salétromkristály, a kálium-nitrát ásványi formája. Salétrommá "
"alakítható."

#: lang/json/AMMO_from_json.py
msgid "aluminum sulfate"
msgid_plural "aluminum sulfate"
msgstr[0] "alumínium-szulfát"
msgstr[1] "alumínium-szulfát"

#. ~ Description for aluminum sulfate
#: lang/json/AMMO_from_json.py
msgid ""
"Several crystals of aluminum sulfate.  Historically, an agent for purifying "
"water and as molluscicide, due to the fact that it degenerates their slime."
"  Just before the Cataclysm, its main uses were for adjusting the acidity of"
" the soil and as an additive to baking powder.  If mixed with a strong acid,"
" it could be used to saturate the soil with aluminum, causing all but the "
"most resistant of plants to wither and die."
msgstr ""
"Több darab alumínium-szulfát kristály. Régebben víztisztításra és csigák "
"elleni szerként használták, mivel lebontja a nyálkájukat. A kataklizma előtt"
" főleg a talaj savasságának megváltoztatására használták, valamint sütőport "
"adalékként is. Erős savval vegyítve a talajt alumíniummal telíti, amelynek "
"következtében a legellenállóbb növények kivételével minden kihal."

#: lang/json/AMMO_from_json.py
msgid "acetic acid"
msgid_plural "acetic acid"
msgstr[0] "ecetsav"
msgstr[1] "ecetsav"

#. ~ Description for acetic acid
#: lang/json/AMMO_from_json.py
msgid ""
"Concentrated acetic acid, typically used as a chemical reagent and "
"antifungal agent.  Despite its horrid smell, it was used to prepare several "
"types of perfumes, but would making perfume not be too ...fancy for "
"postapocalyptic New England?"
msgstr ""
"A koncentrált ecetsavat főleg vegyi reagensként illetve gombaellenes "
"szerként használták. A rettenetes szaga ellenére számos parfüm "
"elkészítésénél is felhasználták, de a parfümgyártás nem egy kicsit túl... "
"csicsás tevékenység ebben az apokalipszis utáni világban?"

#: lang/json/AMMO_from_json.py
msgid "formaldehyde"
msgid_plural "formaldehyde"
msgstr[0] "formaldehid"
msgstr[1] "formaldehid"

#. ~ Description for formaldehyde
#: lang/json/AMMO_from_json.py
msgid ""
"Formaldehyde, here dissolved in water, was widely used before the Cataclysm "
"as a precursor to production of many chemicals and materials and as an "
"embalming agent.  Easily identifiable by its pungent odor.  Terribly toxic, "
"carcinogenic, and volatile."
msgstr ""
"Az itt vízben oldott formaldehided a Kataklizma előtt széles körben "
"használták számos vegyi anyag gyártásánál, valamint holttestek "
"tartósításánál. Erős szagáról könnyen felismerhető. Rendkívül mérgező, rákot"
" okoz, és illékony."

#: lang/json/AMMO_from_json.py
msgid "thermite"
msgid_plural "thermite"
msgstr[0] "termit"
msgstr[1] "termit"

#. ~ Description for thermite
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of silvery-greenish powder, produced by mixing aluminum and "
"chromium oxide.  This mixture, burning at a constant pace and at extremely "
"high temperature, was once used for on-the-spot welding.  Can be used as an "
"incendiary material in a pinch."
msgstr ""
"Egy maréknyi zöldes-ezüstös por, alumínium és króm-oxid keveréke. Régebben "
"vegyi hegesztésre használták ezt a rendkívül magas hőmérsékleten égő "
"keveréket. Szükség esetén gyújtóanyagként is használható."

#: lang/json/AMMO_from_json.py
msgid "ANFO"
msgid_plural "ANFO"
msgstr[0] "ANFO"
msgstr[1] "ANFO"

#. ~ Description for ANFO
#: lang/json/AMMO_from_json.py
msgid ""
"Several brownish pellets that were made by absorbing organic fuel on "
"ammonium nitrate.  This ammonium nitrate-fuel oil or ANFO, as it is called, "
"mixture is a common industrial explosive due to its stability and low price."
"  Burns fast, but needs an explosive primer to detonate..."
msgstr ""
"Számos barnás színű pellet, amely szerves üzemanyag ammónium-nitráttal való "
"felitatásával készült. Az ammónium-nitrát - fuel oil (tüzelőolaj) "
"keverékének angol kezdőbetűiből ANFO-nak nevezett szer régebben gyakran "
"használt ipari robbanóanyag volt alacsony ára és magas stabilitása miatt. "
"Gyorsan ég, de a detonációhoz robbantó gyutacs kell."

#: lang/json/AMMO_from_json.py
msgid "black gunpowder"
msgid_plural "black gunpowder"
msgstr[0] "fekete lőpor"
msgstr[1] "fekete lőpor"

#. ~ Description for black gunpowder
#: lang/json/AMMO_from_json.py
msgid ""
"A handful of black gunpowder, made by mixing charcoal and sulfur with "
"saltpeter.  Pretty useless for making modern cartridges, as the soot "
"produced when it burns will quickly clog any firearm, but it could be used "
"to make some vicious bombs."
msgstr ""
"Egy maréknyi fekete lőpor, amely faszén, kén és salétrom összekeverésével "
"készült. Modern lőszerek megtöltéséhez használhatatlan, mivel az elégésénél "
"keletkező korom gyorsan eltömítené a fegyvert, ugyanakkor nagyon gonosz "
"bombákat lehet vele készíteni."

#: lang/json/AMMO_from_json.py
msgid "RDX"
msgid_plural "RDX"
msgstr[0] "RDX"
msgstr[1] "RDX"

#. ~ Description for RDX
#: lang/json/AMMO_from_json.py
msgid ""
"Several off-white crystals of RDX or hexogen--a military-grade, shelf-stable"
" high explosive.  Can be cast into shaped charges or mixed with scrap to "
"pepper the blast area with high-velocity shrapnel."
msgstr ""
"Számos piszkosfehér RDX kristály. A hexogénként is ismert szer egy stabil, "
"katonai szintű robbanóanyag. Számos alakba önthető, például kumulatív "
"töltetté, illetve fémhulladékkal elkeverve nagy sebességű repeszbombává."

#: lang/json/AMMO_from_json.py
msgid "HMTD"
msgid_plural "HMTD"
msgstr[0] "HMTD"
msgstr[1] "HMTD"

#. ~ Description for HMTD
#: lang/json/AMMO_from_json.py
msgid ""
"Hexamine peroxide: this fine, yellowish powder is a powerful primary "
"explosive, used to initiate detonation of more stable explosives, such as "
"RDX.  Relatively stable, but best not store it for too long..."
msgstr ""
"A hexamin peroxid egy finomszemcsés, sárgás por, egyben erőteljes primer "
"robbanóanyag, amelyet a stabilabb robbanóanyagok, például az RDX "
"begyújtásához használnak. Viszonylag stabil, de azért nem kellene túl sokáig"
" tárolni"

#: lang/json/AMMO_from_json.py
msgid "rocket fuel"
msgid_plural "rocket fuel"
msgstr[0] "rakéta üzemanyag"
msgstr[1] "rakéta üzemanyag"

#. ~ Description for rocket fuel
#: lang/json/AMMO_from_json.py
msgid ""
"A chunk of a zinc powder and sulfur mixture, bound together by superglue, "
"that can be used as an impromptu rocket fuel."
msgstr ""
"Egy darab, cinkpor és kén keverékéből álló, pillanatragasztóval "
"összeragasztott anyag, amelyet rögtönzött rakéta üzemanyagként lehet "
"használni."

#: lang/json/AMMO_from_json.py
msgid "detergent"
msgstr "mosószer"

#. ~ Description for detergent
#: lang/json/AMMO_from_json.py
msgid "A popular pre-cataclysm washing powder."
msgstr "Népszerű márkájú, kataklizma előtti mosópor."

#: lang/json/AMMO_from_json.py
msgid "nanomaterial canisters"
msgid_plural "nanomaterial canisters"
msgstr[0] "nanoanyag tok"
msgstr[1] "nanoanyag tok"

#. ~ Description for nanomaterial canisters
#: lang/json/AMMO_from_json.py
msgid ""
"Steel canisters containing carbon, iron, titanium, copper and other elements"
" in specifically engineered atomic scale configurations.  A nanofabricator "
"can assemble them into usable items."
msgstr ""
"Szenet, vasat, titánt, rezet és egyéb elemeket tartalmazó acéltok, amelyet "
"kifejezetten atomi méretű konfigurációkhoz terveztek. Egy nanofabrikátor "
"hasznos tárgyakat készíthet belőle."

#: lang/json/AMMO_from_json.py
msgid "wood ash"
msgid_plural "wood ashes"
msgstr[0] "fahamu"
msgstr[1] "fahamu"

#. ~ Description for wood ash
#: lang/json/AMMO_from_json.py
msgid ""
"This is almost weightless residue left after the burning of some substance."
msgstr "Ez a szinte súlytalan maradvány valaminek az elégetéséből származik."

#: lang/json/AMMO_from_json.py
msgid "wooden crossbow bolt"
msgstr "fa számszeríj lövedék"

#. ~ Description for wooden crossbow bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A sharpened bolt carved from wood.  It's very light, but doesn't do much "
"damage and isn't particularly accurate.  Stands a below average chance of "
"remaining intact once fired."
msgstr ""
"Fafaragású lövedék számszeríjakhoz. Nagyon kicsi a tömege, de nem is okoz "
"sok sebzést, és nem is a pontosságáról híres. Kilövés után az átlagosnál "
"kisebb eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "metal crossbow bolt"
msgstr "fém számszeríj lövedék"

#. ~ Description for metal crossbow bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A sharpened bolt made from metal of some kind.  It's heavy and unwieldy, "
"providing moderate damage and accuracy.  Stands a very good chance of "
"remaining intact once fired."
msgstr ""
"Valamilyen fémből készült, egyik végén kihegyezett számszeríj lövedék. Nehéz"
" és ormótlan, közepes sebzéssel és pontossággal. Kilövés után nagyon jó "
"eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "steel broadhead bolt"
msgstr "acél szélesfejű lövedék"

#. ~ Description for steel broadhead bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A sharp bolt made from steel.  Deadly in skilled hands.  Stands an excellent"
" chance of remaining intact once fired."
msgstr ""
"Acélból készült hegyes számszeríj lövedék, a megfelelő kezekben halálos. "
"Kilövés után kiváló eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "steel bodkin bolt"
msgstr "acél bodkin lövedék"

#. ~ Description for steel bodkin bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A sharp bolt made from steel with an armor piercing bodkin tip.  Deadly in "
"skilled hands.  Stands an excellent chance of remaining intact once fired."
msgstr ""
"Acélból készült, bodkin páncélátütő, hegyes számszeríj lövedék - a megfelelő"
" kezekben halálos. Kilövés után kiváló eséllyel marad továbbra is egy "
"darabban."

#: lang/json/AMMO_from_json.py
msgid "steel target bolt"
msgstr "acél gyakorló lövedék"

#. ~ Description for steel target bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A sharp bolt made from steel with extra long fletching and a round, balanced"
" tip for extra accuracy, at the cost of some damage.  Deadly in skilled "
"hands.  Stands an excellent chance of remaining intact once fired."
msgstr ""
"Ennek az acél nyílvesszőnek nagyon hosszú tollazata van és egy kerek, "
"kiegyensúlyozott csúcsa az extra pontossághoz, amitől némileg csökken a "
"sebzése. Kilövés után kiváló eséllyel marad továbbra is egy darabban."

#: lang/json/AMMO_from_json.py
msgid "explosive crossbow bolt"
msgstr "robbanó számszeríj lövedék"

#. ~ Description for explosive crossbow bolt
#: lang/json/AMMO_from_json.py
msgid ""
"A lightweight, sharpened bolt made from some kind of metal.  It is fairly "
"unwieldy and only provides moderate accuracy, due to being filled with "
"explosives and fitted with an impact trigger."
msgstr ""
"Valamilyen fémből készült, egyik végén kihegyezett számszeríj lövedék. Nehéz"
" és ormótlan, közepes pontossággal, mivel a robbanófeje robbanóanyagokkal és"
" ütőgyutaccsal töltött."

#: lang/json/AMMO_from_json.py
msgid "ethanol"
msgid_plural "ethanol"
msgstr[0] "etanol"
msgstr[1] "etanol"

#. ~ Description for ethanol
#: lang/json/AMMO_from_json.py
msgid ""
"Extremely pure alcohol suitable for use as a component in chemical "
"reactions.  You could also water it down and drink it, or use it as fuel in "
"alcohol-burning stoves."
msgstr ""
"Rendkívül tiszta alkohol, amelyet számos vegyi reakciónál lehet használni. "
"Vízzel felhígítva iható, illetve alkoholos tűzhelyekben elégethető."

#: lang/json/AMMO_from_json.py
msgid "denatured alcohol"
msgstr "denaturált szesz"

#. ~ Description for denatured alcohol
#: lang/json/AMMO_from_json.py
msgid ""
"A high-strength ethanol solution mixed with methanol to make it toxic to "
"drink, so as to avoid pre-apocalyptic regulations on ethanol.  Intended for "
"use in alcohol-burning stoves and as a solvent."
msgstr ""
"A magas tisztaságú etanol oldatba metanolt kevertek, hogy ezáltal "
"ihatatlanná váljék, és így ne kelljen az apokalipszis előtt időkben az iható"
" alkoholfélék adóit kifizetni. Oldószerként illetve alkoholos tűzhelyek "
"tüzelőanyagaként használható."

#: lang/json/AMMO_from_json.py
msgid "methanol"
msgstr "metanol"

#. ~ Description for methanol
#: lang/json/AMMO_from_json.py
msgid ""
"High purity methanol suitable for use in chemical reactions.  Could be used "
"in alcohol-burning stoves.  Very toxic."
msgstr ""
"Vegyi reakcióknál használható, nagy tisztaságú metanol. Alkoholos tűzhelyben"
" is elégethető. Rendkívül mérgező."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "diesel"
msgid_plural "diesel"
msgstr[0] "dízel"
msgstr[1] "dízel"

#. ~ Description for diesel
#: lang/json/AMMO_from_json.py
msgid ""
"Petroleum-based fuel made from a byproduct of the gasoline making process."
msgstr ""
"Kőolaj-származék, a benzin desztillálási folyamatának egyik mellékterméke."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "gasoline"
msgid_plural "gasoline"
msgstr[0] "benzin"
msgstr[1] "benzin"

#. ~ Description for gasoline
#: lang/json/AMMO_from_json.py
msgid ""
"Gasoline is a highly flammable liquid.  When under pressure, it has the "
"potential for violent explosion."
msgstr ""
"A benzin egy rendkívül gyúlékony folyadék. Nyomás alá helyezve "
"robbanásveszélyes."

#: lang/json/AMMO_from_json.py lang/json/ammunition_type_from_json.py
msgid "lamp oil"
msgid_plural "lamp oil"
msgstr[0] "lámpaolaj"
msgstr[1] "lámpaolaj"

#. ~ Description for lamp oil
#: lang/json/AMMO_from_json.py
msgid "A thin and clean-burning oil made for use in oil lamps."
msgstr "Híg és füstmentesen égő olaj lámpákhoz"

#: lang/json/AMMO_from_json.py
msgid "napalm"
msgid_plural "napalm"
msgstr[0] "napalm"
msgstr[1] "napalm"

#. ~ Description for napalm
#: lang/json/AMMO_from_json.py
msgid ""
"This is gasoline mixed with some other components to make it stick to the "
"surface and increase burning temperature, meant to be used with a "
"flamethrower."
msgstr ""
"Ehhez a benzinhez egyéb anyagokat kevertek, így a folyadék a cél felszínére "
"tapad, növeli az égési hőmérsékletet. Javasolt lángszóróban való "
"felhasználása."

#: lang/json/AMMO_from_json.py
msgid "red paint"
msgid_plural "red paint"
msgstr[0] "vörös festék"
msgstr[1] "vörös festék"

#. ~ Description for red paint
#: lang/json/AMMO_from_json.py
msgid "A can of red paint."
msgstr "Egy kanna vörös festék."

#: lang/json/AMMO_from_json.py
msgid "blue paint"
msgid_plural "blue paint"
msgstr[0] "kék festék"
msgstr[1] "kék festék"

#. ~ Description for blue paint
#: lang/json/AMMO_from_json.py
msgid "A can of blue paint."
msgstr "Egy kanna kék festék."

#: lang/json/AMMO_from_json.py
msgid "white paint"
msgid_plural "white paint"
msgstr[0] "fehér festék"
msgstr[1] "fehér festék"

#. ~ Description for white paint
#: lang/json/AMMO_from_json.py
msgid "A can of white paint."
msgstr "Egy kanna fehér festék."

#: lang/json/AMMO_from_json.py
msgid "green paint"
msgid_plural "green paint"
msgstr[0] "zöld festék"
msgstr[1] "zöld festék"

#. ~ Description for green paint
#: lang/json/AMMO_from_json.py
msgid "A can of green paint."
msgstr "Egy kanna zöld festék."

#: lang/json/AMMO_from_json.py
msgid "purple paint"
msgid_plural "purple paint"
msgstr[0] "lila festék"
msgstr[1] "lila festék"

#. ~ Description for purple paint
#: lang/json/AMMO_from_json.py
msgid "A can of purple paint."
msgstr "Egy kanna lila festék."

#: lang/json/AMMO_from_json.py
msgid "yellow paint"
msgid_plural "yellow paint"
msgstr[0] "sárga festék"
msgstr[1] "sárga festék"

#. ~ Description for yellow paint
#: lang/json/AMMO_from_json.py
msgid "A can of yellow paint."
msgstr "Egy kanna sárga festék."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
msgid "red carpet"
msgstr "vörös szőnyeg"

#. ~ Description for red carpet
#: lang/json/AMMO_from_json.py
msgid "A roll of red carpet."
msgstr "Egy feltekert vörös szőnyeg."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
msgid "green carpet"
msgstr "zöld szőnyeg"

#. ~ Description for green carpet
#: lang/json/AMMO_from_json.py
msgid "A roll of green carpet."
msgstr "Egy feltekert zöld szőnyeg."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
msgid "yellow carpet"
msgstr "sárga szőnyeg"

#. ~ Description for yellow carpet
#: lang/json/AMMO_from_json.py
msgid "A roll of yellow carpet."
msgstr "Egy feltekert sárga szőnyeg."

#: lang/json/AMMO_from_json.py lang/json/terrain_from_json.py
msgid "purple carpet"
msgstr "lila szőnyeg"

#. ~ Description for purple carpet
#: lang/json/AMMO_from_json.py
msgid "A roll of purple carpet."
msgstr "Egy feltekert lila szőnyeg."

#: lang/json/AMMO_from_json.py
msgid "shrapnel"
msgstr "repesz"

#. ~ Description for shrapnel
#: lang/json/AMMO_from_json.py
msgid "A twisted shard of jagged metal."
msgstr "Recés szélű görbe fémdarab."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss slug"
msgstr "mordály dumdum"

#. ~ Description for blunderbuss slug
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of a large hunk of metal.  Better for distance."
msgstr "Nagy darab fémből elkészített mordály lövedék. Távolra jobb."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss shot"
msgstr "mordály sörét"

#. ~ Description for blunderbuss shot
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of a marbles, pebbles, bearings, basically "
"whatever is at hand.  The homemade pellet spread and number makes up for the"
" shoddy quality."
msgstr ""
"Előre elkészített sörétes mordály lövedék. Üveggolyókból, kavicsokból, "
"csapágyakból és hasonló, éppen kéznél levő anyagokból készült. A házi "
"készítésű lövedéknél a sörétszám és -mennyiség ellensúlyozza a silány "
"minőséget."

#: lang/json/AMMO_from_json.py
msgid "blunderbuss flechette"
msgstr "mordály nyilacskák"

#. ~ Description for blunderbuss flechette
#: lang/json/AMMO_from_json.py
msgid ""
"A prepared blunderbuss shot of homemade flechette made out of nails or "
"glass.  Shreds armor."
msgstr ""
"Előre elkészített mordály lövedék házi gyártású, szögekből és üvegből álló "
"nyilacskákkal. A páncélt cafatokra tépi."

#: lang/json/AMMO_from_json.py
msgid "bootleg fusion pack"
msgstr "koppintott fúziós modul"

#. ~ Description for bootleg fusion pack
#: lang/json/AMMO_from_json.py
msgid ""
"In the middle of the 21st Century, military powers began to look towards "
"energy based weapons.  The result was the standard fusion pack, capable of "
"delivering bolts of superheated gas at near light speed with no recoil.  "
"This one has been hand-crafted from spare parts."
msgstr ""
"A 21. század közepétől kezdve a fegyveres erők az energia-alapú fegyverkezés"
" kérdésével is elkezdtek foglalkozni. A kutatások eredményeként született "
"meg a sztenderd fúziós modul, amely bármiféle visszarúgás nélkül "
"fénysebesség közeli torkolati sebességre gyorsított fel túlhevített "
"gázkötegeket. Ezt a modult alkatrészekből szerelték össze kézzel."

#: lang/json/AMMO_from_json.py
msgid "H&K 12mm"
msgstr "H&K 12 mm"

#. ~ Description for H&K 12mm
#: lang/json/AMMO_from_json.py
msgid ""
"The Heckler & Koch 12mm projectiles are used in H&K railguns.  It's made of "
"a ferromagnetic metal, probably cobalt."
msgstr ""
"A Heckler & Kock 12 mm-es lövedékeit a H&K railgunjai használják. Alapanyaga"
" egy ferromágneses fém, feltehetőleg kobalt."

#: lang/json/AMMO_from_json.py
msgid "20x66mm beanbag"
msgstr "20x66mm babzsák"

#. ~ Description for 20x66mm beanbag
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, sublethal beanbag type.  Proprietary "
"ammunition for Rivtech shotguns.  Being caseless rounds, these cannot be "
"disassembled or reloaded."
msgstr ""
"20x66 mm hüvely nélküli, sörétes puskához készült, nem halálos babzsák "
"lőszer. A Rivtech sörétes puskái számára szabadalmaztatott töltény. Mivel "
"hüvely nélküli lőszerről van szó, ezeket sem szétszerelni, sem újratölteni "
"nem lehet."

#: lang/json/AMMO_from_json.py
msgid "handmade 20x66mm flechette"
msgstr "kézi öntésű 20x66mm nyilacska"

#. ~ Description for handmade 20x66mm flechette
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless flechette rounds."
"  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"A Rivtech 20x66 mm-es hüvely nélküli páncéltörő nyilacskás lőszerének kézi "
"gyártású kalózmásolata. Mivel hüvely nélküli lőszerről van szó, ezeket sem "
"szétszerelni, sem újratölteni nem lehet."

#: lang/json/AMMO_from_json.py
msgid "handmade 20x66mm buckshot"
msgstr "kézi öntésű 20x66mm sörét"

#. ~ Description for handmade 20x66mm buckshot
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless buckshot rounds."
"  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"A Rivtech 20x66 mm-es hüvely nélküli lőszerének kézi gyártású kalózmásolata."
" Mivel hüvely nélküli lőszerről van szó, ezeket sem szétszerelni, sem "
"újratölteni nem lehet."

#: lang/json/AMMO_from_json.py
msgid "handmade 20x66mm slug"
msgstr "kézi öntésű 20x66mm dumdum"

#. ~ Description for handmade 20x66mm slug
#: lang/json/AMMO_from_json.py
msgid ""
"Handcrafted bootleg duplicates of Rivtech 20x66mm caseless solid projectile "
"rounds.  Being caseless rounds, these cannot be disassembled or reloaded."
msgstr ""
"A Rivtech 20x66 mm-es hüvely nélküli dumdum lőszerének kézi gyártású "
"kalózmásolata. Mivel hüvely nélküli lőszerről van szó, ezeket sem "
"szétszerelni, sem újratölteni nem lehet."

#: lang/json/AMMO_from_json.py
msgid "20x66mm explosive"
msgstr "20x66mm robbanó"

#. ~ Description for 20x66mm explosive
#: lang/json/AMMO_from_json.py
msgid ""
"20x66mm caseless shotgun rounds, explosive projectile type.  Proprietary "
