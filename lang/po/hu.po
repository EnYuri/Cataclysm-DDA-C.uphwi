"remélhetőleg egy csomó jó képet tudsz majd készíteni."

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Gym Teacher"
msgstr "Tornatanár"

#. ~ Profession (male Gym Teacher) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"After a career of teaching kids the art of sports they mostly hate, the "
"zombies around you refuse to do laps, even at the blow of your whistle."
msgstr ""
"Egész életedben olyan sportra tanítottad a gyerekeket, amit utáltak. A "
"zombik nem akarnak körbeszaladni a pályát, bármennyire is fújod a sípot."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Gym Teacher"
msgstr "Tornatanár"

#. ~ Profession (female Gym Teacher) description
#: lang/json/professions_from_json.py
