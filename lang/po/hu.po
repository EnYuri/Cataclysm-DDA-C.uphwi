msgctxt "scenario_female"
msgid "Missed"
msgstr "Lemaradt"

#. ~ Description for scenario 'Missed' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"Whether due to stubbornness, ignorance, or just plain bad luck, you missed "
"the evacuation, and are stuck in a city full of the risen dead."
msgstr ""
"Makacsságból, tudatlanságból vagy egyszerűen rossz szerencséből, de "
"lemaradtál az evakuálásról, és most egy feltámadt halottakkal teli városban "
"vagy."

#. ~ Description for scenario 'Missed' for a female character.
#: lang/json/scenario_from_json.py
