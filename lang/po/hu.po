msgstr "Héjatlan, sós földimogyoró."

#: lang/json/COMESTIBLE_from_json.py
msgid "beech nuts"
msgid_plural "beech nuts"
msgstr[0] "bükkmakk"
msgstr[1] "bükkmakk"

#. ~ Description for beech nuts
#: lang/json/COMESTIBLE_from_json.py
msgid "Hard pointy nuts from a beech tree."
msgstr "Keménycsúcsos makk, a bükkfa termése."

#: lang/json/COMESTIBLE_from_json.py
