msgid_plural "national weather transcripts"
msgstr[0] "országos meteorológiai adatok"
msgstr[1] "országos meteorológiai adatok"

#. ~ Description for national weather transcripts
#: lang/json/BOOK_from_json.py
msgid "Old weather records are about as interesting as a rock."
msgstr ""
"A régi meteorológiai adatokat annyira fájdalmas olvasni, mintha követ "
