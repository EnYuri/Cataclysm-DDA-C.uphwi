#: lang/json/TOOL_from_json.py
msgid "inactive tear gas hack"
msgid_plural "inactive tear gas hacks"
msgstr[0] "inaktív könnygáz hack"
msgstr[1] "inaktív könnygáz hack"

#. ~ Use action friendly_msg for inactive tear gas hack.
#: lang/json/TOOL_from_json.py
msgid "The tear gas hack flies from your hand and surveys the area!"
msgstr "A könnygáz hack kirepül a kezedből és felméri a területet!"

