#. ~ Description for seat
#: lang/json/vehicle_part_from_json.py
msgid "A place to sit, or sleep if you're desperate."
msgstr "Ide lehet beülni, illetve ha nagyon nincs más, aludni."

#: lang/json/vehicle_part_from_json.py
msgid "reclining seat"
msgstr "dönthető ülés"

#. ~ Description for reclining seat
#: lang/json/vehicle_part_from_json.py
msgid ""
"A place to sit, and the backrest reclines to make it an uncomfortable bed."
msgstr ""
"Ide lehet beülni. A hátra hajtható háttámlának köszönhetően kényelmetlen "
"ágyként is használható."

#: lang/json/vehicle_part_from_json.py
msgid "tracking device"
msgstr "nyomkövető eszköz"

#. ~ Description for tracking device
#: lang/json/vehicle_part_from_json.py
msgid "A small transmitter that lets you locate the vehicle on the map."
msgstr "Egy apró jeladó, segítségével a járművet megtalálhatod a térképen."

#. ~ Description for saddle
#: lang/json/vehicle_part_from_json.py
msgid "A padded wedge that you straddle, like a bicycle or motorcycle."
msgstr ""
"Kipárnázott ülés, amelyre lábad közé véve ülhetsz fel, mint egy biciklire "
"vagy motorra."

#: lang/json/vehicle_part_from_json.py
msgid "foldable seat"
msgstr "összecsukható ülés"

#. ~ Description for foldable seat
#: lang/json/vehicle_part_from_json.py
msgid "A crude seat, too uncomfortable to sleep in."
msgstr "Durva ülés, túl kényelmetlen ahhoz, hogy benne aludhass."

#. ~ Description for bed
#: lang/json/vehicle_part_from_json.py
msgid "A small but comfortable bed."
msgstr "Kisméretű, de kényelmes ágy."

