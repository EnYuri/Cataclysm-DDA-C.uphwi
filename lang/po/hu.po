msgid "A token, representing fertilization of a plant."
msgstr "A növény trágyázását jelölő token."

#: lang/json/GENERIC_from_json.py
msgid "steel chain"
msgid_plural "steel chains"
msgstr[0] "acéllánc"
msgstr[1] "acéllánc"

#. ~ Description for steel chain
#: lang/json/GENERIC_from_json.py
msgid ""
"A heavy steel chain.  Useful as a weapon, or for crafting.  It has a chance "
"to wrap around your target, allowing for a bonus unarmed attack."
msgstr ""
"Nehéz acéllánc. Fegyvernek és kézműves projektek hozzávalójának is hasznos. "
"Fegyverként használva esély van arra, hogy a találatkor az ellenség köré "
"tekeredjen, és így egy bónusz puszta kezes támadást is kaphatsz."

#: lang/json/GENERIC_from_json.py
msgid "chunk of chitin"
msgid_plural "chunks of chitin"
msgstr[0] "kitindarab"
msgstr[1] "kitindarab"

#. ~ Description for chunk of chitin
#: lang/json/GENERIC_from_json.py
msgid "A piece of an insect's exoskeleton.  It is light and very durable."
msgstr "Darab egy rovar kitinvázából, könnyű és nagyon tartós."

#: lang/json/GENERIC_from_json.py
msgid "chunk of biosilicified chitin"
msgid_plural "chunks of biosilicified chitin"
msgstr[0] "bioszilíciumosodott kitindarab"
msgstr[1] "bioszilíciumosodott kitindarab"

#. ~ Description for chunk of biosilicified chitin
#: lang/json/GENERIC_from_json.py
msgid ""
"A lump of exoskeleton that has undergone biosilicification.  It is acid-"
"resistant and remarkably sturdy."
msgstr "Ez a darab rovarváz bioszilíciumosodott. Saválló és nagyon tartós."

#: lang/json/GENERIC_from_json.py
msgid "bundle of rags"
msgid_plural "bundles of rags"
msgstr[0] "rongyköteg"
msgstr[1] "rongyköteg"

#. ~ Description for bundle of rags
#: lang/json/GENERIC_from_json.py
msgid ""
"Cotton rags, bundled tightly together for storage.  Disassemble to unpack."
msgstr ""
"Szorosan összekötözött textil rongyok. Szétcsomagolásához szét kell szedni."

#: lang/json/GENERIC_from_json.py
msgid "bundle of leather"
msgid_plural "bundles of leather"
msgstr[0] "bőrköteg"
msgstr[1] "bőrköteg"

#. ~ Description for bundle of leather
#: lang/json/GENERIC_from_json.py
msgid ""
"Leather patches, bundled tightly together for storage.  Disassemble to "
"unpack."
msgstr ""
"Szorosan összekötözött bőrdarabok. Szétcsomagolásához szét kell szedni."

#: lang/json/GENERIC_from_json.py
msgid "bundle of felt"
msgid_plural "bundles of felt"
msgstr[0] "nemezköteg"
msgstr[1] "nemezköteg"

#. ~ Description for bundle of felt
#: lang/json/GENERIC_from_json.py
msgid ""
"Felt patches, bundled tightly together for storage.  Disassemble to unpack."
msgstr ""
"Szorosan összekötözött nemezdarabok. Szétcsomagolásához szét kell szedni."

#: lang/json/GENERIC_from_json.py
msgid "biollante bud"
msgid_plural "biollante buds"
msgstr[0] "biollante bimbó"
msgstr[1] "biollante bimbó"

#. ~ Description for biollante bud
#: lang/json/GENERIC_from_json.py
msgid ""
"An unopened biollante flower, brilliant purple in color.  It may still have "
"its sap-producing organ intact."
msgstr ""
"Egy még zárt biollante virág, rikítóan lila színű. A gyantatermő szerve "
"talán még egyben van."

#: lang/json/GENERIC_from_json.py
msgid "empty canister"
msgid_plural "empty canisters"
msgstr[0] "üres gránáttok"
msgstr[1] "üres gránáttok"

#. ~ Description for empty canister
#: lang/json/GENERIC_from_json.py
msgid ""
"An empty canister, which may have once held tear gas or other substances."
msgstr ""
"Üres gránáttok, amely egykor könnygázt vagy más anyagokat tartalmazott."

#: lang/json/GENERIC_from_json.py
msgid "petrified eye"
msgid_plural "petrified eyes"
msgstr[0] "megkövült szem"
msgstr[1] "megkövült szem"

#. ~ Description for petrified eye
#: lang/json/GENERIC_from_json.py
msgid ""
"A fist-sized eyeball with a cross-shaped pupil.  It seems to be made of "
"stone, but doesn't look like it was carved."
msgstr ""
"Ökölnyi nagyságú szemgolyó kereszt alakú pupillával. Úgy néz ki, mintha "
"kőből lenne, de nem látszik faragványnak."

#: lang/json/GENERIC_from_json.py
msgid "spiral stone"
msgid_plural "spiral stones"
msgstr[0] "spirális kő"
msgstr[1] "spirális kő"

#. ~ Description for spiral stone
#: lang/json/GENERIC_from_json.py
msgid ""
"A rock the size of your fist.  It is covered with intricate spirals; it is "
"impossible to tell whether they are carved, naturally formed, or some kind "
"of fossil."
msgstr ""
"Ökölnyi nagyságú kődarab, rajta bonyolult spirálok. Lehetetlen megmondani, "
"hogy faragták, természetesen ilyen, vagy valamiféle őskövület."

#: lang/json/GENERIC_from_json.py
msgid "USB drive"
msgid_plural "USB drives"
msgstr[0] "USB-meghajtó"
msgstr[1] "USB-meghajtó"

#. ~ Description for USB drive
#: lang/json/GENERIC_from_json.py
msgid "A USB thumb drive.  Useful for holding software."
msgstr "Egy USB-meghajtó, szoftverek tárolására alkalmas."

#: lang/json/GENERIC_from_json.py
msgid "golf tee"
msgid_plural "golf tees"
msgstr[0] "golf tee"
msgstr[1] "golf tee"

#. ~ Description for golf tee
#: lang/json/GENERIC_from_json.py
msgid ""
"A pin shaped piece of wood meant for holding a golf ball slightly off the "
"ground."
msgstr "Tüske alakú fadarab, amelyre a golflabdát helyezik."

#: lang/json/GENERIC_from_json.py
msgid "golf ball"
msgid_plural "golf balls"
msgstr[0] "golflabda"
msgstr[1] "golflabda"

#. ~ Description for golf ball
#: lang/json/GENERIC_from_json.py
msgid "A small ball with round indentations on it."
msgstr "Apró bemélyedésekkel ellátott kisméretű labda."

#. ~ Description for pool ball
#: lang/json/GENERIC_from_json.py
msgid "A colorful, hard ball.  Essentially a rock."
msgstr "Színes kemény műgyanta golyó - gyakorlatilag egy eldobható kő."

#: lang/json/GENERIC_from_json.py
msgid "bowling ball"
msgid_plural "bowling balls"
msgstr[0] "tekegolyó"
msgstr[1] "tekegolyó"

#. ~ Description for bowling ball
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, heavy ball.  Before the apocalypse, its main purpose was to be "
"rolled along waxed floors."
msgstr ""
"Nagyméretű, nehéz golyó. Az apokalipszis előtt arra használták, hogy "
"viasszal kisuvickolt fapallókon gurították végig."

#: lang/json/GENERIC_from_json.py
msgid "candlestick"
msgid_plural "candlesticks"
msgstr[0] "gyertyatartó"
msgstr[1] "gyertyatartó"

#. ~ Description for candlestick
#: lang/json/GENERIC_from_json.py
msgid "A gold candlestick."
msgstr "Arany gyertyatartó."

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
#: lang/json/vehicle_part_from_json.py
msgid "blade"
msgid_plural "blades"
msgstr[0] "penge"
msgstr[1] "penge"

#. ~ Description for blade
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, relatively sharp blade.  Could be used to make bladed weaponry, or "
"attached to a car."
msgstr ""
"Nagyméretű, viszonylag éles penge. Pengés fegyver gyártásához lehet "
"használni, vagy autóra is lehet szerelni."

#: lang/json/GENERIC_from_json.py
msgid "circular sawblade"
msgid_plural "circular sawblades"
msgstr[0] "körfűrészlap"
msgstr[1] "körfűrészlap"

#. ~ Description for circular sawblade
#: lang/json/GENERIC_from_json.py
msgid ""
"An 8\" circular sawblade.  You could make a saw with it, or throw it.  "
"Wielding it without sturdy gloves is a bad idea."
msgstr ""
"20 centis fűrészlap körfűrészhez. Lehet belőle körfűrészt gyártani vagy el "
"is lehet dobni. Vastag védőkesztyű nélkül rossz ötlet vele hadonászni."

#: lang/json/GENERIC_from_json.py
msgid "tree spile"
msgid_plural "tree spiles"
msgstr[0] "fatörzs csapoló"
msgstr[1] "fatörzs csapoló"

#. ~ Description for tree spile
#: lang/json/GENERIC_from_json.py
msgid ""
"A hollow metal cylinder which is inserted in a tree crust in order to slowly"
" harvest its sap.  Can be used on a maple tree in between late winter and "
"early spring to harvest maple sap."
msgstr ""
"Fatörzsbe verhető üreges fémhenger, amellyel lassan lecsapolható annak "
"nedve. Juharfa nedvének betakarításához lehet késő tél és kora tavasz között"
" használni."

#: lang/json/GENERIC_from_json.py
msgid "wire"
msgid_plural "wires"
msgstr[0] "drót"
msgstr[1] "drót"

#. ~ Description for wire
#: lang/json/GENERIC_from_json.py
msgid ""
"A length of thin, relatively stiff, steel wire.  Like the sort you find in "
"wire fences."
msgstr ""
"Egy kisebb tekercs vékony, merev acélhuzal. Pont olyan, amiből drótkerítést "
"készítenek."

#: lang/json/GENERIC_from_json.py
msgid "barbed wire"
msgid_plural "barbed wires"
msgstr[0] "szögesdrót"
msgstr[1] "szögesdrót"

#. ~ Description for barbed wire
#: lang/json/GENERIC_from_json.py
msgid "A length of stiff wire, covered in sharp barbs."
msgstr "Éles tüskékkel ellátott merev huzaltekercs."

#: lang/json/GENERIC_from_json.py
msgid "rebar"
msgid_plural "rebars"
msgstr[0] "betonvas"
msgstr[1] "betonvas"

#. ~ Description for rebar
#: lang/json/GENERIC_from_json.py
msgid ""
"A length of rebar, makes a nice melee weapon, and could be handy in "
"constructing tougher walls and such."
msgstr ""
"Egy darab betonvas. Jó közelharc fegyvernek, továbbá tartósabb falak és "
"egyéb megerősített építmények építéséhez."

#: lang/json/GENERIC_from_json.py lang/json/terrain_from_json.py
msgid "concrete"
msgid_plural "concrete"
msgstr[0] "beton"
msgstr[1] "beton"

#. ~ Description for concrete
#: lang/json/GENERIC_from_json.py
msgid "Some concrete, ready to be used in a construction project."
msgstr ""
"Valamennyi beton, csak arra vár, hogy valamilyen építkezésnél felhasználd."

#: lang/json/GENERIC_from_json.py
msgid "log"
msgid_plural "logs"
msgstr[0] "fagerenda"
msgstr[1] "fagerenda"

#. ~ Description for log
#: lang/json/GENERIC_from_json.py
msgid ""
"A large log, cut from a tree.  (a)ctivate a wood axe or wood saw to cut it "
"into planks."
msgstr ""
"Nagy méretű, fából vágott gerenda. Deszkákba vágásához (a)ktiválj rajta egy "
"favágó szekercét vagy fafűrészt."

#: lang/json/GENERIC_from_json.py
msgid "splintered wood"
msgid_plural "splintered woods"
msgstr[0] "faszilánk"
msgstr[1] "faszilánk"

#. ~ Description for splintered wood
#: lang/json/GENERIC_from_json.py
msgid "A splintered piece of wood, could be used as a skewer or for kindling."
msgstr ""
"Szilánkokra aprított fadarab, nyársként vagy gyújtósként lehetne használni."

#: lang/json/GENERIC_from_json.py
msgid "bone skewer"
msgid_plural "bone skewers"
msgstr[0] "csont nyárs"
msgstr[1] "csont nyárs"

#. ~ Description for bone skewer
#: lang/json/GENERIC_from_json.py
msgid ""
"A thin skewer carved from bone.  Sadly, it won't make squirrel on a stick "
"taste better."
msgstr ""
"Csontból faragott vékony nyárs. Sajnos ettől még nem lesz jobb íze a nyársa "
"húzott mókusnak."

#: lang/json/GENERIC_from_json.py
msgid "burnt out torch"
msgid_plural "burnt out torches"
msgstr[0] "kiégett fáklya"
msgstr[1] "kiégett fáklya"

#. ~ Description for burnt out torch
#: lang/json/GENERIC_from_json.py
msgid ""
"A torch that has consumed all its fuel; it can be recrafted into another "
"torch."
msgstr ""
"Ebből a fáklyából az összes éghető anyag kifogyott. Lehet belőle másik "
"fáklyát készíteni."

#: lang/json/GENERIC_from_json.py
msgid "dead flare"
msgid_plural "dead flares"
msgstr[0] "kiégett jelzőfáklya"
msgstr[1] "kiégett jelzőfáklya"

#. ~ Description for dead flare
#: lang/json/GENERIC_from_json.py
msgid "This is a spent magnesium flare.  It is essentially trash."
msgstr ""
"Ez a magnézium jelzőfáklya kifogyott, most már gyakorlatilag csak szemét."

#: lang/json/GENERIC_from_json.py
msgid "spring"
msgid_plural "springs"
msgstr[0] "rugó"
msgstr[1] "rugó"

#. ~ Description for spring
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, heavy-duty spring.  Expands with significant force when compressed."
msgstr ""
"Nagy méretű, megerősített rugó. Összenyomásra jelentős erővel rúg vissza."

#: lang/json/GENERIC_from_json.py
msgid "leaf spring"
msgid_plural "leaf springs"
msgstr[0] "laprugó"
msgstr[1] "laprugó"

#. ~ Description for leaf spring
#: lang/json/GENERIC_from_json.py
msgid ""
"A large, heavy-duty leaf spring.  Probably from some car or truck, and looks"
" an awful lot like a bow.  You can barely bend it..."
msgstr ""
"Nagyméretű, nagy teherbírású laprugó, valószínűleg gépkocsiból vagy "
"teherautóból származik. Annyira hajlott, mint egy íj. Alig tudod "
"elgörbíteni."

#: lang/json/GENERIC_from_json.py
msgid "lawnmower"
msgid_plural "lawnmowers"
msgstr[0] "fűnyíró"
msgstr[1] "fűnyíró"

#. ~ Description for lawnmower
#: lang/json/GENERIC_from_json.py
msgid ""
"A motorized pushmower that seems to be broken.  You could take it apart if "
"you had a wrench."
msgstr ""
"Elromlott motoros fűnyíró. Szét tudnád szedni, ha lenne franciakulcsod."

#: lang/json/GENERIC_from_json.py
msgid "damaged tent"
msgid_plural "damaged tents"
msgstr[0] "sérült sátor"
msgstr[1] "sérült sátor"

#. ~ Description for damaged tent
#: lang/json/GENERIC_from_json.py
msgid ""
"A small tent, just big enough to fit a person comfortably.  This tent is "
"broken and cannot be deployed."
msgstr ""
"Kisméretű sátor, éppen akkora, hogy egy személy kényelmesen elférjen benne. "
"Ez a sátor megsérült és nem lehet felállítani."

#: lang/json/GENERIC_from_json.py
msgid "large damaged tent"
msgid_plural "large damaged tents"
msgstr[0] "nagy sérült sátor"
msgstr[1] "nagy sérült sátor"

#. ~ Description for large damaged tent
#: lang/json/GENERIC_from_json.py
msgid ""
"A family sized tent, very bulky but with plenty of space.  This tent is "
"broken and can not be deployed."
msgstr ""
"Családi méretű sátor, rengeted hellyel. Ez a sátor megsérült és nem lehet "
"felállítani."

#: lang/json/GENERIC_from_json.py
msgid "heating element"
msgid_plural "heating elements"
msgstr[0] "melegítőszál"
msgstr[1] "melegítőszál"

#. ~ Description for heating element
#: lang/json/GENERIC_from_json.py
msgid "A heating element, like the ones used in hotplates or kettles."
msgstr "Főzőlapokban és vízmelegítőkben használt melegítőszál."

#: lang/json/GENERIC_from_json.py
msgid "television"
msgid_plural "televisions"
msgstr[0] "televízió"
msgstr[1] "televízió"

#. ~ Description for television
#: lang/json/GENERIC_from_json.py
msgid "A large cathode ray tube television, full of delicious electronics."
msgstr ""
"Nagyméretű katódsugárcsöves televízó készülék, telis-tele finomnál finomabb "
"elektronikával."

#: lang/json/GENERIC_from_json.py
msgid "pilot light"
msgid_plural "pilot lights"
msgstr[0] "őrláng"
msgstr[1] "őrláng"

#. ~ Description for pilot light
#: lang/json/GENERIC_from_json.py
msgid ""
"A pilot light from a gas-burning device, this particular one is a simple "
"piezoelectric igniter."
msgstr ""
"Gázkészülékből származó őrláng, ennek egy egyszerű piezo-elektromos gyújtója"
" van."

#: lang/json/GENERIC_from_json.py
msgid "toaster"
msgid_plural "toasters"
msgstr[0] "kenyérpirító"
msgstr[1] "kenyérpirító"

#. ~ Description for toaster
#: lang/json/GENERIC_from_json.py
msgid "A small two slice toaster, not much use as anything but spare parts"
msgstr ""
"Apró, kétszeletes kenyérpirító. Alkatrészeken kívül nem sok minden másra jó."

#: lang/json/GENERIC_from_json.py
msgid "microwave"
msgid_plural "microwaves"
msgstr[0] "mikrohullámú sütő"
msgstr[1] "mikrohullámú sütő"

#. ~ Description for microwave
#: lang/json/GENERIC_from_json.py
msgid ""
"A home microwave, has probably seen its share of baked beans.  Good for "
"scrap parts."
msgstr ""
"Otthoni mikrohullámú sütő, jó sok főtt babot láthatott közelről. "
"Alkatrésznek jó."

#: lang/json/GENERIC_from_json.py
msgid "laptop computer"
msgid_plural "laptop computers"
msgstr[0] "laptop"
msgstr[1] "laptop"

#. ~ Description for laptop computer
#: lang/json/GENERIC_from_json.py
msgid "A broken laptop, basically a paperweight now."
msgstr "Elromlott laptop, most már csak papírnehezék."

#: lang/json/GENERIC_from_json.py
msgid "broken eyebot"
msgid_plural "broken eyebots"
msgstr[0] "elromlott szembot"
msgstr[1] "elromlott szembot"

#. ~ Description for broken eyebot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken eyebot.  Much less threatening now that it won't be calling for "
"backup.  Could be gutted for parts."
msgstr ""
"Egy elromlott szembot. Most már sokkal kevésbé fenyegető, hogy nem tud "
"erősítést hívni. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken skitterbot"
msgid_plural "broken skitterbots"
msgstr[0] "elromlott skitterbot"
msgstr[1] "elromlott skitterbot"

#. ~ Description for broken skitterbot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken skitterbot.  Much less threatening now that it lies limp on solid "
"ground.  Could be gutted for parts."
msgstr ""
"Egy elromlott skitterbot. Most már a szilárd talajon fekve sokkal kevésbé "
"fenyegető. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken police bot"
msgid_plural "broken police bots"
msgstr[0] "elromlott rendőrbot"
msgstr[1] "elromlott rendőrbot"

#. ~ Description for broken police bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken police bot.  Much less threatening now that it's quiet and still.  "
"Could be gutted for parts."
msgstr ""
"Egy elromlott rendőrbot. Most már sokkal kevésbé fenyegető, hogy "
"mozdulatlanul a földön hever. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken riot control bot"
msgid_plural "broken riot control bots"
msgstr[0] "elromlott tömegoszlató bot"
msgstr[1] "elromlott tömegoszlató bot"

#. ~ Description for broken riot control bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken riot control bot.  Much less threatening now that it's out of gas."
"  Could be gutted for parts."
msgstr ""
"Egy elromlott tömegoszlató bot. Most már sokkal kevésbé fenyegető, hogy "
"nincs benne több gáz. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken miner bot"
msgid_plural "broken miner bots"
msgstr[0] "elromlott bányászbot"
msgstr[1] "elromlott bányászbot"

#. ~ Description for broken miner bot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken miner bot.  Much less threatening now that it's no longer capable "
"of drilling anything.  Could be gutted for parts."
msgstr ""
"Egy elromlott rendőrbot. Most már sokkal kevésbé fenyegető, hogy nem tud "
"bármit átfúrni. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken tribot"
msgid_plural "broken tribots"
msgstr[0] "elromlott tribot"
msgstr[1] "elromlott tribot"

#. ~ Description for broken tribot
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken tribot.  Now that its legs lie broken and immobile, the world seems"
" a little less threatening.  Could be gutted for parts."
msgstr ""
"Egy elromlott tribot. Most már sokkal kevésbé fenyegető, hogy a lábat "
"kitörték és nem mozdul többé. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken tank drone"
msgid_plural "broken tank drones"
msgstr[0] "elromlott tank drón"
msgstr[1] "elromlott tank drón"

#. ~ Description for broken tank drone
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken tank drone.  Still looks intimidating despite being permanently "
"inoperative, possibly due to the sheer size and mass.  Could be gutted for "
"parts."
msgstr ""
"Egy elromlott tank drón. Még mindig eléggé ijesztően néz ki, annak ellenére,"
" hogy örökké működésképtelenné vált, talán a hatalmas mérete és tömege "
"miatt. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken manhack"
msgid_plural "broken manhacks"
msgstr[0] "elromlott manhack"
msgstr[1] "elromlott manhack"

#. ~ Description for broken manhack
#. ~ Description for broken hack
#. ~ Description for broken manhack
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken manhack.  Much less threatening now that it lies limp on solid "
"ground.  Could be gutted for parts."
msgstr ""
"Egy elromlott manhack. Most már a szilárd talajon fekve sokkal kevésbé "
"fenyegető. Ki lehetne belezni alkatrészekért."

#: lang/json/GENERIC_from_json.py
msgid "broken grenade hack"
msgid_plural "broken grenade hacks"
msgstr[0] "elromlott gránátos hack"
msgstr[1] "elromlott gránátos hack"

#. ~ Description for broken grenade hack
#: lang/json/GENERIC_from_json.py
msgid ""
"A broken grenade hack.  Much less threatening now that it lies quiet on "
"solid ground.  Could be gutted for parts."
msgstr ""
