#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Miner"
msgstr "Bányász"

#. ~ Profession (male Miner) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You're a miner, not a minor!  Your canteen is dry, your jackhammer is out of"
" gas, and you're on your last pair of batteries for your mining helmet..."
msgstr ""
"A kulacsod száraz, a légkalapácsodból kifogyott a benzin, és a "
"bányászsisakod lámpája az utolsó garnitúra elemet fogyasztja. Bányásznak "
"halni szép halál..."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Miner"
msgstr "Bányász"

#. ~ Profession (female Miner) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_female"
msgid ""
"You're a miner, not a minor!  Your canteen is dry, your jackhammer is out of"
" gas, and you're on your last pair of batteries for your mining helmet..."
msgstr ""
"A kulacsod száraz, a légkalapácsodból kifogyott a benzin, és a "
"bányászsisakod lámpája az utolsó garnitúra elemet fogyasztja. Bányásznak "
"halni szép halál..."

#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Traceur"
msgstr "Traceur"

#. ~ Profession (Traceur) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You've practiced parkour for many years, and made the world your playground."
"  It wouldn't be a lie to say that running is your life.  Which is good, "
"because now that the end has come, you're running for your life."
msgstr ""
"Több éve gyakorlod a parkour mozgáskultúráját, és játszótered az egész "
"világ. Nem mellébeszélés, hogy a futás az életed. Ami most jól is jön, mert "
"a világvégével az életedért futsz."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Traceuse"
msgstr "Traceuse"

#. ~ Profession (Traceuse) description
#: lang/json/professions_from_json.py
