msgstr "\"A faj tagjai valamiféle neurokongnitív kapcsolattal rendelkeznek.\""

#: lang/json/speech_from_json.py
msgid ""
"\"This one's repeating phrases that the previous specimen was exposed to.\""
msgstr ""
"\"Ez olyan mondatokat ismételget, amelyeket egy korábbi példány hallott "
