#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Firefighter"
msgstr "Tűzoltó"

#. ~ Profession (male Firefighter) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"As a first responder you were direct witness to the gut-wrenching horrors of"
" the apocalypse.  Separated from most of your equipment and your unit while "
"on call, you were forced to fight your way to safety with little more than "
"your trusty iron and bunker gear to protect you."
msgstr ""
"Elsőként kivonuló mentőegységként saját szemeddel láttad az apokalipszis "
"zsigerbe markoló kifejlődését. Elszakadtál a tűzoltóautótól és az egységed "
"többi tagjától, a pajszeroddal és a tűzvédelmi felszereléseddel küzdöd "
"magadat biztonságos helyre."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Firefighter"
msgstr "Tűzoltó"

#. ~ Profession (female Firefighter) description
#: lang/json/professions_from_json.py
