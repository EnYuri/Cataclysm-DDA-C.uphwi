msgid_plural "towels"
msgstr[0] "törülköző"
msgstr[1] "törülköző"

#. ~ Description for towel
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a fluffy and large towel.  It could be used to dry yourself.  Any "
"person that can travel the length and breadth of the apocalypse, rough it, "
"slum it, struggle against terrible odds, win through and still know where "
"their towel is, is clearly a force to be reckoned with."
msgstr ""
"Ez egy nagyméretű bolyhos törölköző. Megszáríthatod magadat vele. Azzal, aki"
" keresztül-kasul átjárja az apokalipszist, kemény helyeken csövezik, kemény "
"kajákat eszik, szembeszáll a szörnyű esélyekkel, győzedelmeskedik, és még "
"ezután is tudja hogy hol van a törülközője, azzal nem érdemes ujjat húzni."

#. ~ Description for towel
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a large, sopping wet towel.  If you wait a little bit, it should dry"
" out.  Don't panic."
msgstr ""
"Ez egy nagyméretű, lucskos törölköző. Ha vársz egy kicsit, megszárad. Ne ess"
" pánikba."

#: lang/json/TOOL_ARMOR_from_json.py
msgid "soiled towel"
msgid_plural "soiled towels"
msgstr[0] "szennyezett törölköző"
msgstr[1] "szennyezett törölköző"

#. ~ Description for soiled towel
#: lang/json/TOOL_ARMOR_from_json.py
msgid ""
"This is a large towel, covered in a thick, gooey liquid.  You'll need to "
"wash it in some water to make it usable again.  Don't panic."
msgstr ""
"Ez egy nagyméretű, ragacsos folyadékkal beszennyezett törülköző. Vízben kell"
" kimosni ahhoz, hogy újra használható legyen. Ne ess pánikba."

