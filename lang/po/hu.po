#: src/addiction.cpp
msgid ""
"Perception - 1;   Intelligence - 1;\n"
"Anxiety, nausea, hallucinations, and general malaise."
msgstr ""
"Érzékelés -1; Intelligencia -1;\n"
"Szorongás, hányinger, hallucináció és általános rossz közérzet."

