#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Paperboy"
msgstr "Újságkihordó"

#. ~ Profession (Paperboy) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You were delivering the morning paper along your usual route when the "
"Cataclysm struck.  The undead hordes don't seem to value the latest news, "
"but at least your trusty bicycle is still in working order."
msgstr ""
"A szokásos útvonalon vitted ki a reggeli újságot, amikor bekövetkezett a "
"Kataklizma. Az élőhalott hordákat annyira nem érdeklik a friss hírek, de "
"legalább a biciklid még működik."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Papergirl"
msgstr "Újságkihordó"

#. ~ Profession (Papergirl) description
