#. ~ Mutation class: Wolf iv_message
#: lang/json/mutation_category_from_json.py
msgid "As the mutagen hits you, your ears twitch and you stifle a yipe."
msgstr ""
"A füled megrándul és elfojtasz egy csaholást, amikor a mutagén szétterül "
"benned."

#. ~ Mutation class: Wolf Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Wolfed out."
msgstr "Farkaséletet élt."

#. ~ Mutation class: Wolf Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Wolfed out."
msgstr "Farkaséletet élt."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py
msgid "Cattle"
msgstr "Szarvasmarha"

#. ~ Mutation class: Cattle mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "Your mind and body slow down.  You feel peaceful."
msgstr "Az elméd és a tested lelassul. Békében érzed magad."

#. ~ Mutation class: Cattle iv_message
#: lang/json/mutation_category_from_json.py
msgid "You wonder if this is what rBGH feels like..."
msgstr "Azon gondolkodsz, hogy vajon az rBGH is ilyen érzés-e."

#. ~ Mutation class: Cattle Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Stopped worrying and learned to love the cowbell."
msgstr "Nem aggódott többet, és megszerette a kolompot."

#. ~ Mutation class: Cattle Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Stopped worrying and learned to love the cowbell."
msgstr "Nem aggódott többet, és megszerette a kolompot."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Cephalopod"
msgstr "Lábasfejű"

#. ~ Mutation class: Cephalopod mutagen_message
#: lang/json/mutation_category_from_json.py
msgid ""
"Your mind is overcome by images of eldritch horrors... and then they pass."
msgstr ""
"Az elmédet egy pillanatra elborítják az ősi szörnyűségek látványa... majd "
"elhalványulnak."

#. ~ Mutation class: Cephalopod iv_message
#: lang/json/mutation_category_from_json.py
msgid ""
"You watch the mutagen flow through a maze of little twisty passages.  All "
"the same."
msgstr ""
"Figyelemmel kíséred, ahogyan a mutagén szétterjed az apró véredények "
"labirintusában."

#. ~ Mutation class: Cephalopod Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Began living the dreams."
msgstr "Elkezdte megélni az álmait."

#. ~ Mutation class: Cephalopod Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Began living the dreams."
msgstr "Elkezdte megélni az álmait."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Bird"
msgstr "Madár"

#. ~ Mutation class: Bird mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "Your body lightens and you long for the sky."
msgstr "A tested könnyebbé válik, és az ég után sóvárogsz."

#. ~ Mutation class: Bird iv_message
#: lang/json/mutation_category_from_json.py
msgid "Your arms spasm in an oddly wavelike motion."
msgstr "A karjaid furcsán hullámozva rándulnak görcsbe."

#. ~ Mutation class: Bird Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Broke free of humanity."
msgstr "Elszabadult az emberségétől."

#. ~ Mutation class: Bird Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Broke free of humanity."
msgstr "Elszabadult az emberségétől."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Lizard"
msgstr "Gyík"

#. ~ Mutation class: Lizard mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "For a heartbeat, your blood cools down."
msgstr "Egy szívverésnyi időre a véred lehül."

#. ~ Mutation class: Lizard iv_message
#: lang/json/mutation_category_from_json.py
msgid "Your blood cools down.  The feeling is... different."
msgstr "A véred lehűl. Az érzés... másféle."

#. ~ Mutation class: Lizard Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Shed the ugly human skin."
msgstr "Levetette az a ronda emberi bőrét."

#. ~ Mutation class: Lizard Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Shed the ugly human skin."
msgstr "Levetette az a ronda emberi bőrét."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Troglobite"
msgstr "Troglobita"

#. ~ Mutation class: Troglobite mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "You yearn for a cool, dark place to hide."
msgstr "Egy hűvös, sötét búvóhely után vágyakozol."

#. ~ Mutation class: Troglobite iv_message
#: lang/json/mutation_category_from_json.py
msgid "As you press the plunger, it all goes so bright..."
msgstr "Ahogyan benyomod a fecskendő rúdját minden olyan fényessé válik..."

#. ~ Mutation class: Troglobite Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Adapted to underground living."
msgstr "Alkalmazkodott a földalatti élethez."

#. ~ Mutation class: Troglobite Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Adapted to underground living."
msgstr "Alkalmazkodott a földalatti élethez."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py
msgid "Alpha"
msgstr "Alfa"

#. ~ Mutation class: Alpha mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "You feel... better.  Somehow."
msgstr "Jobban érzed magad... valahogy."

#. ~ Mutation class: Alpha iv_message
#: lang/json/mutation_category_from_json.py
msgid "You took that shot like a champ!"
msgstr "Úgy fogadtad a löketet, mint egy bajnok!"

#. ~ Mutation class: Alpha Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Started representing."
msgstr "Elkezdte a képviseletet."

#. ~ Mutation class: Alpha Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Started representing."
msgstr "Elkezdte a képviseletet."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py
msgid "Medical"
msgstr "Orvosi"

#. ~ Mutation class: Medical mutagen_message
#: lang/json/mutation_category_from_json.py
msgid ""
"You can feel the blood rushing through your veins and a strange, medicated "
"feeling washes over your senses."
msgstr ""
"Érzed, ahogyan a vér lüktet az ereidben, és egy furcsa, gyógyszerízű érzés "
"terjed szét benned."

#. ~ Mutation class: Medical iv_message
#: lang/json/mutation_category_from_json.py
msgid ""
"You can feel the blood in your medication stream.  It's a strange feeling."
msgstr "Érzed a vért az orvosságáramodban. Nagyon fura érzés."

#. ~ Mutation class: Medical junkie_message
#: lang/json/mutation_category_from_json.py
msgid "Ahh, there it is.  You can feel the mutagen again."
msgstr "Ahhh, íme itt van megint. Ismét érzed a mutagént."

#. ~ Mutation class: Medical Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Resumed clinical trials."
msgstr "Tovább folytatta a klinikai kísérleteket."

#. ~ Mutation class: Medical Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Resumed clinical trials."
msgstr "Tovább folytatta a klinikai kísérleteket."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py
msgid "Chimera"
msgstr "Kiméra"

#. ~ Mutation class: Chimera mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "You need to roar, bask, bite, and flap.  NOW."
msgstr ""
"Úgy érzed hogy muszáj üvöltened, sütkéreznek, harapnod és csapkodnod. DE "
"MOST AZONNAL."

#. ~ Mutation class: Chimera iv_message
#: lang/json/mutation_category_from_json.py
msgid "everyanimalthateverlived.bursting.from.YOU!"
msgstr "mindenvalahaéltállat.tör.előre.BELŐLED!"

#. ~ Mutation class: Chimera iv_sleep_message
#: lang/json/mutation_category_from_json.py
msgid "With a final *pop*, you go out like a light."
msgstr "Egy utolsó pukkanással úgy sötétedsz el, mint a fény."

#. ~ Mutation class: Chimera iv_sound_message
#: lang/json/mutation_category_from_json.py
msgid "yourself roar in agony!"
msgstr "fájdalomtól zihálsz!"

#. ~ Mutation class: Chimera Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "United disunity."
msgstr "Egyesült megbontottság."

#. ~ Mutation class: Chimera Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "United disunity."
msgstr "Egyesült megbontottság."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Fey"
msgstr "Elf"

#. ~ Mutation class: Fey mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "Nature is becoming one with you..."
msgstr "A természet eggyé válik veled..."

#. ~ Mutation class: Fey iv_message
#: lang/json/mutation_category_from_json.py
msgid "Everything goes green for a second."
msgstr "Egy pillanatra minden zölddé válik."

#. ~ Mutation class: Fey iv_sleep_message
#: lang/json/mutation_category_from_json.py
msgid "It's painfully beautiful..."
msgstr "Fájdalmasan gyönyörű..."

#. ~ Mutation class: Fey Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Accepted a more natural way of life."
msgstr "Elfogadta a természetesebb élet útját."

#. ~ Mutation class: Fey Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Accepted a more natural way of life."
msgstr "Elfogadta a természetesebb élet útját."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py lang/json/mutation_from_json.py
msgid "Raptor"
msgstr "Raptor"

#. ~ Mutation class: Raptor mutagen_message
#: lang/json/mutation_category_from_json.py
msgid "Mmm... sweet, bloody flavor... tastes like victory."
msgstr "Mmmm... Édes, véres íze... a győzelem íze."

#. ~ Mutation class: Raptor iv_message
#: lang/json/mutation_category_from_json.py
msgid ""
"You distinctly smell the mutagen mixing with your blood... and then it "
"passes."
msgstr ""
"Kifejezetten érzed az orrodban a mutagén és a véred keveredését... majd az "
"érzés elmúlik."

#. ~ Mutation class: Raptor Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Hatched."
msgstr "Kikelt a tojásból."

#. ~ Mutation class: Raptor Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Hatched."
msgstr "Kikelt a tojásból."

#. ~ Mutation class name
#: lang/json/mutation_category_from_json.py
msgid "Mouse"
msgstr "Egér"

#. ~ Mutation class: Mouse mutagen_message
#: lang/json/mutation_category_from_json.py
msgid ""
"You feel a desire to curl up in a nice, warm pile of... shredded paper."
msgstr ""
"Késztetést érzel arra, hogy egy kényelmes, meleg... tépett papírkupacon "
"kuporodj össze."

#. ~ Mutation class: Mouse iv_message
#: lang/json/mutation_category_from_json.py
msgid "You feel... small.  But comfortable."
msgstr "Kicsinek érzed magadat. De kényelmes."

#. ~ Mutation class: Mouse Male memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_male"
msgid "Found the cheese."
msgstr "Megtalálta a sajtot."

#. ~ Mutation class: Mouse Female memorial messsage
#: lang/json/mutation_category_from_json.py
msgctxt "memorial_female"
msgid "Found the cheese."
msgstr "Megtalálta a sajtot."

#: lang/json/mutation_from_json.py
msgid "Fleet-Footed"
msgstr "Gyorslábú"

#. ~ Description for Fleet-Footed
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can move more quickly than most, resulting in a 15% speed bonus on sure "
"footing."
msgstr ""
"A többieknél gyorsabban tudsz haladni, ezért biztos talajon 15% bónuszt "
"kapsz a sebességedhez."

#: lang/json/mutation_from_json.py
msgid "Good Hearing"
msgstr "Jó hallású"

#. ~ Description for Good Hearing
#: lang/json/mutation_from_json.py
msgid ""
"Your hearing is better than average, and you can hear distant sounds more "
"easily."
msgstr ""
"Hallásod átlagnál feletti, ezért a távolabbi hangokat könnyebben hallod meg."

#: lang/json/mutation_from_json.py
msgid "Outdoorsman"
msgstr "Kiránduló"

#. ~ Description for Outdoorsman
#: lang/json/mutation_from_json.py
msgid ""
"You are accustomed to being exposed to the elements.  This decreases morale "
"penalties for being wet."
msgstr ""
"Megszoktad az időjárás viszontagságait, ezért kevesebbel csökken a "
"hangulatod, amikor átáztál."

#: lang/json/mutation_from_json.py
msgid "Parkour Expert"
msgstr "Parkour szakértő"

#. ~ Description for Parkour Expert
#: lang/json/mutation_from_json.py
msgid ""
"You're skilled at clearing obstacles; terrain like railings or counters are "
"as easy for you to move on as solid ground."
msgstr ""
"Ügyesen veszed az akadályokat, ezért a korláthoz meg pulthoz hasonló talajon"
" ugyanolyan könnyen mozogsz, mint a szilárd talajon."

#: lang/json/mutation_from_json.py
msgid "Indefatigable"
msgstr "Fáradhatatlan"

#. ~ Description for Indefatigable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Whether due to exercise and good diet, or due to a natural propensity to "
"physical endurance, you tire due to physical exertion much less readily than"
" others.  Your maximum stamina is 25% higher than usual."
msgstr ""
"Mozgáshiánytól, jó táplálkozástól, vagy egyszerűen csak a természetes "
"teherbírástól sokkal később fáradsz ki fizikai igénybevételtől, mint a "
"többiek. A maximális kitartásod 25%-kal magasabb."

#: lang/json/mutation_from_json.py
msgid "Hyperactive"
msgstr "Hiperaktív"

#. ~ Description for Hyperactive
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body's efficiency is like that of a tiny furnace, increasing your "
"maximum stamina by 40%."
msgstr ""
"A tested hatékonysága egy kis kazáné, a maximum kitartásod 40%-kal nő."

#: lang/json/mutation_from_json.py
msgid "Quick"
msgstr "Gyors"

#. ~ Description for Quick
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You're just generally quick!  You get a 10% bonus to action points."
msgstr "Mindenben gyorsabb vagy! 10% bónuszt kapsz az akciópontjaidhoz."

#. ~ Description for Optimist
#: lang/json/mutation_from_json.py
msgid ""
"Nothing gets you down!  You savor the joys of life, ignore its hardships, "
"and are generally happier than most people."
msgstr ""
"Semmi sem veszi el a kedved! Élvezed az életet, teszel a megpróbáltatásokra "
"és általában véve boldogabb vagy, mint a legtöbb ember."

#: lang/json/mutation_from_json.py
msgid "Fast Healer"
msgstr "Gyorsan gyógyuló"

#. ~ Description for Fast Healer
#: lang/json/mutation_from_json.py
msgid ""
"You heal faster when sleeping and will even recover a small amount of HP "
"when not sleeping."
msgstr ""
"Alvás közben sokkal gyorsabban gyógyulsz, és még akkor is visszanyersz egy "
"kis életpontot, amikor nem is alszol."

#: lang/json/mutation_from_json.py
msgid "Light Eater"
msgstr "Apró étvágyú"

#. ~ Description for Light Eater
#: lang/json/mutation_from_json.py
msgid ""
"Your metabolism is a little slower, and you require less food than most."
msgstr ""
"Az anyagcseréd kicsit lassabb, ezért a többieknél kevesebb étel is elég."

#: lang/json/mutation_from_json.py
msgid "Accomplished Sleeper"
msgstr "Sikeres alvó"

#. ~ Description for Accomplished Sleeper
#: lang/json/mutation_from_json.py
msgid ""
"You have always been able to fall asleep easily, even when sleeping in less "
"than ideal circumstances."
msgstr ""
"Mindig sokkal könnyebben tudtál elaludni, még ott is, ahol az alvásra "
"kevésbé ideálisak a körülmények."

#: lang/json/mutation_from_json.py
msgid "Practiced Sleeper"
msgstr "Gyakorlott alvó"

#. ~ Description for Practiced Sleeper
#: lang/json/mutation_from_json.py
msgid ""
"Your body's demanding energy needs mean you can fall asleep just about "
"anywhere."
msgstr "A tested energiaigénye miatt gyakorlatilag bárhol el tudsz aludni."

#: lang/json/mutation_from_json.py
msgid "Pain Resistant"
msgstr "Fájdalomtűrő"

#. ~ Description for Pain Resistant
#: lang/json/mutation_from_json.py
msgid "You have a high tolerance for pain."
msgstr "Jobban viseled a fájdalmat."

#: lang/json/mutation_from_json.py
msgid "Night Vision"
msgstr "Éjjellátó"

#. ~ Description for Night Vision
#: lang/json/mutation_from_json.py
msgid ""
"You possess natural night vision, and can see further in the dark than most."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"Természetesen jó az éjjellátó képességed. Az éjjellátó területeket "
"aktiválással tudod ki- és bekapcsolni."

#: lang/json/mutation_from_json.py
msgid "Poison Resistant"
msgstr "Méregtűrő"

#. ~ Description for Poison Resistant
#: lang/json/mutation_from_json.py
msgid ""
"Your system is rather tolerant of poisons and toxins, and most will affect "
"you less."
msgstr ""
"A tested jobban viseli a mérgek és egyéb toxinok jelenlétét, ezek ezért "
"kevesebb hatással is lesznek rád."

#: lang/json/mutation_from_json.py
msgid "Fast Reader"
msgstr "Gyors olvasó"

#. ~ Description for Fast Reader
#: lang/json/mutation_from_json.py
msgid ""
"You're a quick reader, and can get through books a lot faster than most."
msgstr "Gyorsan olvasol, a többieknél hamarabb végzel a könyvekkel."

#: lang/json/mutation_from_json.py
msgid "Tough Feet"
msgstr "Keménytalpú"

#. ~ Description for Tough Feet
#: lang/json/mutation_from_json.py
msgid ""
"The bottoms of your feet are tough and you are accustomed to going barefoot."
"  You receive no movement penalty for not wearing shoes."
msgstr ""
"A talpad jó vastag, megszoktad a mezítláb járást. Nem kapsz mozgási "
"büntetést, ha nincs rajtad cipő."

#: lang/json/mutation_from_json.py
msgid "Tough"
msgstr "Kemény"

#. ~ Description for Tough
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"It takes a lot to bring you down!  You get a 20% bonus to all hit points."
msgstr ""
"Sok kell ahhoz, hogy kicsináljanak! 20% bónuszt kapsz minden találati "
"ponthoz."

#: lang/json/mutation_from_json.py
msgid "Durable"
msgstr "Tartós"

#. ~ Description for Durable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can shrug off almost anything!  You get a 30% bonus to all hit points."
msgstr "Szinte bármit lerázol! 30% bónuszt kapsz minden találati ponthoz."

#: lang/json/mutation_from_json.py
msgid "Unbreakable"
msgstr "Törhetetlen"

#. ~ Description for Unbreakable
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Nothing can break you!  You get a 40% bonus to all hit points."
msgstr "Semmi se fog ki rajtad! 40% bónuszt kapsz minden találati ponthoz."

#: lang/json/mutation_from_json.py
msgid "Thick-Skinned"
msgstr "Keménybőrű"

#. ~ Description for Thick-Skinned
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is tough.  Cutting damage is slightly reduced for you.  Slightly "
"decreases wet penalties."
msgstr ""
"Kemény a bőröd. Némileg csökkenti a vágott sebesüléseket és a víz okozta "
"büntetéseket."

#: lang/json/mutation_from_json.py
msgid "Packmule"
msgstr "Málhás szamár"

#. ~ Description for Packmule
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can manage to find space for anything!  You can carry 40% more volume."
msgstr ""
"Szinte bárminek találsz helyet! 40%-kal több térfogatot tudsz magaddal "
"vinni."

#: lang/json/mutation_from_json.py
msgid "Strong Back"
msgstr "Erőshátú"

#. ~ Description for Strong Back
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are capable of carrying far more than someone with similar strength "
"could.  Your maximum weight carried is increased by 35%."
msgstr ""
"Sokkal többet tudsz magaddal vinni, mint valaki más, aki ugyanannyira erős. "
"A 35%-kal több súlyt tudsz hordozni."

#: lang/json/mutation_from_json.py
msgid "Fast Learner"
msgstr "Gyorsan tanuló"

#. ~ Description for Fast Learner
#: lang/json/mutation_from_json.py
msgid ""
"You have a flexible mind, allowing you to learn skills much faster than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Képlékeny az agyad, a többieknél sokkal gyorsabban sajátítod el a "
"készségeket. Ez csak a világban szerzett tapasztalatra vonatkozik, a "
"máshonnan, például könyvekből szerzett tapasztalati pontokra nem."

#: lang/json/mutation_from_json.py
msgid "Strong Stomach"
msgstr "Erős gyomrú"

#. ~ Description for Strong Stomach
#: lang/json/mutation_from_json.py
msgid ""
"You are less likely to throw up from food poisoning, alcohol, etc.  If you "
"throw up nevertheless, you won't suffer a residual nausea."
msgstr ""
"Kevesebb eséllyel hánysz az ételmérgezéstől, az alkoholtól és hasonlóktól. "
"Még ha hánysz is, utána nem lesz egy kis ideig se hányingered."

#: lang/json/mutation_from_json.py
msgid "Good Memory"
msgstr "Jó memóriájú"

#. ~ Description for Good Memory
#: lang/json/mutation_from_json.py
msgid ""
"You have an exceptional memory, and find it easy to remember things.  Your "
"skills will erode slightly slower than usual, and you can remember more "
"terrain."
msgstr ""
"Kivételesen jó az emlékezeted, könnyen felidézel bármit. A készségeid a "
"szokásosnál kisebb mértékben kopnak el, és még több tereptárgyra emlékszel."

#: lang/json/mutation_from_json.py
msgid "Deft"
msgstr "Fürge"

#. ~ Description for Deft
#: lang/json/mutation_from_json.py
msgid ""
"While you're not any better at melee combat, you are better at recovering "
"from a miss, and will be able to attempt another strike faster."
msgstr ""
"Bár nem vagy jobb közelharcos, egy félrement ütésből sokkal gyorsabban "
"szeded össze magad, és gyorsabban próbálhatsz még egy újabb ütést bevinni."

#: lang/json/mutation_from_json.py
msgid "Drunken Master"
msgstr "Részeges mester"

#. ~ Description for Drunken Master
#: lang/json/mutation_from_json.py
msgid ""
"The ancient arts of drunken brawling come naturally to you!  While under the"
" influence of alcohol, your melee skill will rise considerably, especially "
"unarmed combat."
msgstr ""
"A részeges bunyózás őskori mesterségét természetedből fakadóan jobban űzöd. "
"Alkoholos befolyásoltság esetében a közelharci készséged lényegesen magasabb"
" lesz, különösen puszta kézzel vívott harcnál."

#: lang/json/mutation_from_json.py
msgid "Spiritual"
msgstr "Spirituális"

#. ~ Description for Spiritual
#: lang/json/mutation_from_json.py
msgid ""
"You've always felt that there is more to the world than we can see.  Whether"
" driven by religious beliefs or philosophical interest, you find great "
"inspiration in studying holy texts and experiencing mystical things."
msgstr ""
"Mindig is úgy érezted, hogy több van a világon, mint amennyi látszik. Akár "
"hitvallás, akár filozófiai érdeklődés hajt, sok ihletet merítesz a szent "
"írások tanulmányozásából és a misztikus dolgok megtapasztalásából."

#: lang/json/mutation_from_json.py
msgid "Substance Tolerance"
msgstr "Anyagbíró"

#. ~ Description for Substance Tolerance
#: lang/json/mutation_from_json.py
msgid ""
"You can handle intoxicants well.  Their effects clear up more quickly for "
"you."
msgstr ""
"Sokkal jobban detoxikálódsz, mind mindenki más, az anyagok hatása nálad "
"sokkal hamarabb elmúlik."

#: lang/json/mutation_from_json.py
msgid "Gourmand"
msgstr "Ínyenc"

#. ~ Description for Gourmand
#: lang/json/mutation_from_json.py
msgid ""
"You eat faster, and can eat and drink more, than anyone else!  You also "
"enjoy food more; delicious food is better for your morale, and you don't "
"mind unsavory meals as much.  Activate to skip prompt for overeating."
msgstr ""
"Gyorsabban eszel, a többieknél többet tudsz enni és inni. Az ételt is jobban"
" élvezed. Az ízletes ételek még jobban növelik a hangulatodat és az undorító"
" ételeket sem bánod mind."

#: lang/json/mutation_from_json.py
msgid "Bookworm"
msgstr "Könyvmoly"

#. ~ Description for Bookworm
#: lang/json/mutation_from_json.py
msgid ""
"There's nothing quite like the smell of a good book!  Books are more fun (or"
" less boring) for you!"
msgstr ""
"Semmi mást nem szeretsz annyira, mint egy jó könyv illatát! Számodra a "
"könyvek még szórakoztatóbbak (vagy kevésbé unalmasak)."

#: lang/json/mutation_from_json.py
msgid "Addiction Resistant"
msgstr "Függőségálló"

#. ~ Description for Addiction Resistant
#: lang/json/mutation_from_json.py
msgid ""
"Whether due to a lifetime of exposure or through simple willpower, it's "
"harder for you to become addicted to substances, and easier to rid yourself "
"of these addictions."
msgstr "Nehezebben szoksz rá anyagokra, és könnyebben is szoksz le róluk."

#: lang/json/mutation_from_json.py
msgid "Animal Empathy"
msgstr "Állatszeretet"

#. ~ Description for Animal Empathy
#: lang/json/mutation_from_json.py
msgid ""
"Peaceful animals will not run away from you, and even aggressive animals are"
" less likely to attack.  This only applies to natural animals such as "
"woodland creatures."
msgstr ""
"A békés állatok nem menekülnek előled, és még az agresszív állatok is kisebb"
" eséllyel támadnak rád. Ez csak a természetes állatokra, például az erdei "
"állatokra vonatkozik."

#: lang/json/mutation_from_json.py
msgid "Terrifying"
msgstr "Ijesztő"

#. ~ Description for Terrifying
#: lang/json/mutation_from_json.py
msgid ""
"There's something about you that creatures find frightening, and they are "
"more likely to try to flee."
msgstr ""
"Van benned valami, ami megijeszti a többi lényt, és nagyobb valószínűséggel "
"fognak menekülni próbálni."

#: lang/json/mutation_from_json.py
msgid "Disease Resistant"
msgstr "Betegség-ellenálló"

#. ~ Description for Disease Resistant
#: lang/json/mutation_from_json.py
msgid ""
"It's very unlikely that you will catch ambient diseases like a cold or the "
"flu."
msgstr ""
"Nagyon kicsi az esélye annak, hogy valamilyen környezeti betegség döntsön le"
" a lábadról, mint amilyen az influenza vagy a megfázás."

#: lang/json/mutation_from_json.py
msgid "High Adrenaline"
msgstr "Magas adrenalin"

#. ~ Description for High Adrenaline
#: lang/json/mutation_from_json.py
msgid ""
"If you are in a very dangerous situation, you may experience a temporary "
"rush which increases your speed and strength significantly."
msgstr ""
"Veszélyes helyzetbe kerülve átmenetileg elönt az adrenalin, jelentősen "
"növelve a sebességedet és az erődet."

#: lang/json/mutation_from_json.py
msgid "Less Sleep"
msgstr "Kevesebb alvás"

#. ~ Description for Less Sleep
#: lang/json/mutation_from_json.py
msgid "You need less sleep than the average person."
msgstr "Az átlagosnál kevesebb alvással is beéred."

#: lang/json/mutation_from_json.py
msgid "Self-Aware"
msgstr "Önismeret"

#. ~ Description for Self-Aware
#: lang/json/mutation_from_json.py
msgid ""
"You get to see your exact amount of HP remaining and health, instead of only"
" having a vague idea of whether you're in good condition or not."
msgstr ""
"Pontosan látod, hogy testrészeidnek mennyi életerő pontja van és milyen az "
"egészséged, ahelyett, hogy csak úgy nagyjából éreznéd, hogy azok jó "
"állapotban vannak-e, vagy sem."

#: lang/json/mutation_from_json.py
msgid "Inconspicuous"
msgstr "Jelentéktelen"

#. ~ Description for Inconspicuous
#: lang/json/mutation_from_json.py
msgid ""
"While sleeping or staying still, it is less likely that monsters will wander"
" close to you."
msgstr ""
"Alvás közben illetve álló helyzetben kisebb eséllyel közelítenek meg a "
"szörnyek."

#: lang/json/mutation_from_json.py
msgid "Masochist"
msgstr "Mazochista"

#. ~ Description for Masochist
#: lang/json/mutation_from_json.py
msgid ""
"Although you still suffer the negative effects of pain, it also brings a "
"unique pleasure to you."
msgstr ""
"Bár a fájdalom negatív hatásai továbbra is érvényesülnek, a fájdalom "
"egyedülálló élményt is nyújt."

#: lang/json/mutation_from_json.py
msgid "Stimulant Psychosis"
msgstr "Ajzószeres pszichózis"

#. ~ Description for Stimulant Psychosis
#: lang/json/mutation_from_json.py
msgid ""
"You have a unique history with stimulants (like coffee or amphetamines). You"
" can tolerate a lot more of them without overdosing, but if you indulge too "
"much, you start seeing things..."
msgstr ""
"Egyedüli és régi történeted van az ajzószerekkel (például a kávéval vagy az "
"amfetaminokkal). Sokkal többet vehetsz be túladagolás nélkül, de ha túl "
"sokat tolsz, akkor elkezdesz dolgokat látni..."

#. ~ Description for Stylish
#: lang/json/mutation_from_json.py
msgid ""
"Practicality is far less important than style.  Your morale is improved by "
"wearing fashionable and attractive clothing."
msgstr ""
"A divat sokkal fontosabb számodra, mint a gyakorlatiasság. A hangulatod "
"emelkedik, ha divatos vagy mutatós ruha van rajtad."

#: lang/json/mutation_from_json.py
msgid "Light Step"
msgstr "Könnyű léptek"

#. ~ Description for Light Step
#: lang/json/mutation_from_json.py
msgid ""
"You make less noise while walking.  You're also less likely to set off "
"traps."
msgstr ""
"Járás közben kevesebb zajt csapsz, és kisebb eséllyel indítasz be csapdát."

#: lang/json/mutation_from_json.py
msgid "Robust Genetics"
msgstr "Robusztus gének"

#. ~ Description for Robust Genetics
#: lang/json/mutation_from_json.py
msgid ""
"You have a very strong genetic base.  If you mutate, the odds that the "
"mutation will be beneficial are greatly increased."
msgstr ""
"Nagyon erős genetikai berendezkedésednek köszönhetően mutáció esetén sokkal "
"nagyobb eséllyel kapsz pozitív hatású mutációt."

#: lang/json/mutation_from_json.py
msgid "Scout"
msgstr "Felderítő"

#. ~ Description for Scout
#: lang/json/mutation_from_json.py
msgid ""
"You're an excellent navigator and your ability to spot distant landmarks is "
"unmatched.  Your sight radius on the overmap extends beyond the normal "
"range."
msgstr ""
"Kiváló navigátor vagy, és páratlanul messziről ismered fel feltűnő "
"tereptárgyakat. A térképen ezért a szokásosnál messzebb található "
"tereptárgyak is láthatóvá válnak számodra."

#: lang/json/mutation_from_json.py
msgid "Topographagnosia"
msgstr "Topográfagnóznia"

#. ~ Description for Topographagnosia
#: lang/json/mutation_from_json.py
msgid ""
"Focal brain damage has rendered you incapable of recognizing landmarks and "
"orienting yourself in your surroundings, severely crippling your sight "
"radius on the overmap."
msgstr ""
"Egy furcsa agysérülés miatt képtelen vagy felismerni a tereptárgyakat, és "
"orientálódni a környezetedben, így a nagytérképen sokkal kevésbé látsz "
"messzire."

#: lang/json/mutation_from_json.py
msgid "Cannibal"
msgstr "Kannibál"

#. ~ Description for Cannibal
#: lang/json/mutation_from_json.py
msgid ""
"For your whole life you've been forbidden from indulging in your peculiar "
"tastes.  Now the world's ended, and you'll be damned if anyone is going to "
"tell you that you can't eat people."
msgstr ""
"Egész életed során tiltott volt számodra az emberi hús gyümölcse. Most, hogy"
" már a világnak is vége, már nincs, aki megmondja neked, hogy mit szabad "
"enned és kit nem."

#: lang/json/mutation_from_json.py
msgid "Psychopath"
msgstr "Pszichopata"

#. ~ Description for Psychopath
#: lang/json/mutation_from_json.py
msgid ""
"You don't experience guilt like others do.  Even when you know your actions "
"are wrong, you just don't care."
msgstr ""
"Nincs olyan bűntudatod, mint a többieknek. Még ha tudod is, hogy rosszat "
"teszel, egyszerűen nem érdekel."

#: lang/json/mutation_from_json.py
msgid "Martial Arts Training"
msgstr "Harcművészeti képzés"

#. ~ Description for Martial Arts Training
#: lang/json/mutation_from_json.py
msgid ""
"You have received some martial arts training at a local dojo.  You start "
"with your choice of Karate, Judo, Aikido, Tai Chi, or Taekwondo."
msgstr ""
"Némi harcművészeti képzésben részesültél a helyi dódzsóban. Kiválaszthatod, "
"hogy az alábbi harcmodorok közül melyikkel kezdesz: karate, dzsúdó, aikido, "
"tajcsi vagy taekwondo."

#: lang/json/mutation_from_json.py
msgid "Self-Defense Classes"
msgstr "Önvédelmi edzés"

#. ~ Description for Self-Defense Classes
#: lang/json/mutation_from_json.py
msgid ""
"You have taken some self-defense classes at a nearby gym.  You start with "
"your choice of Capoeira, Krav Maga, Muay Thai, Ninjutsu, or Zui Quan."
msgstr ""
"Egy pár önvédelmi edzésen vettél rész a közeli edzőteremben. Kiválaszthatod,"
" hogy az alábbi harcmodorok közül melyikkel kezdesz: capoeira, krav maga, "
"muay thai, nindzsicu vagy cuj csün."

#: lang/json/mutation_from_json.py
msgid "Shaolin Adept"
msgstr "Shaolin jelölt"

#. ~ Description for Shaolin Adept
#: lang/json/mutation_from_json.py
msgid ""
"You have studied the arts of the Shaolin monks.  You start with one of the "
"five animal fighting styles: Tiger, Crane, Leopard, Snake, or Dragon."
msgstr ""
"Shaolin szerzetesek mellett tanultál ősi harcművészetet. Kiválaszthatod, "
"hogy az alábbi állati harci stílusok közül melyikkel kezdesz: tigris, daru, "
"leopárd, kígyó vagy sárkány."

#: lang/json/mutation_from_json.py
msgid "Venom Mob Protege"
msgstr "Mérges maffia védence"

#. ~ Description for Venom Mob Protege
#: lang/json/mutation_from_json.py
msgid ""
"You are a pupil of the Venom Clan.  You start with one of the five deadly "
"venoms: Centipede, Viper, Scorpion, Lizard, or Toad."
msgstr ""
"A Mérges klán tanoncaként kiválaszthatod, hogy az alábbi halálos mérgek "
"közül melyikkel kezdesz: százlábú, vipera, skorpió, gyík vagy varangy."

#: lang/json/mutation_from_json.py
msgid "Melee Weapon Training"
msgstr "Közelharci fegyver képzés"

#. ~ Description for Melee Weapon Training
#: lang/json/mutation_from_json.py
msgid ""
"You have practiced fighting with weapons.  You start with your choice of "
"Eskrima, Fencing, Pentjak Silat, Niten Ichi-Ryu, or Sōjutsu."
msgstr ""
"Gyakrolatod van a fegyverforgatásban. A játékot az eskrima, a vívás, a "
"pentjak silat, a szódzsucu vagy a ni ten icsi-rjú ismeretével kezded."

#: lang/json/mutation_from_json.py
msgid "Weak Scent"
msgstr "Enyhe szagú"

#. ~ Description for Weak Scent
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is quite weak.  Animals that track your scent will do so with "
"more difficulty."
msgstr ""
"Alig érezhető a szagod, ezért a levadászásodhoz szaglásukra támaszkodó "
"állatok nehezebben tudnak követni."

#: lang/json/mutation_from_json.py
msgid "Skilled Liar"
msgstr "Gyakorlott hazudozó"

#. ~ Description for Skilled Liar
#: lang/json/mutation_from_json.py
msgid ""
"You have no qualms about bending the truth, and have practically no tells.  "
"Telling lies and otherwise bluffing will be much easier for you."
msgstr ""
"Semmi bajod sincsen azzal, hogy a valóság tükrén néha-néha görbítesz egyet, "
"pókerarcodon nem látszik, hogy mikor blöffölsz. Sokkal egyszerűbben tudsz "
"hazudni vagy blöffölni."

#: lang/json/mutation_from_json.py
msgid "Pretty"
msgstr "Szép"

#. ~ Description for Pretty
#: lang/json/mutation_from_json.py
msgid ""
"You are a sight to behold.  NPCs who care about such things will react more "
"kindly to you."
msgstr ""
"Jó rád nézni. Sokkal kedvezőbben reagálnak rád azok az NPC-k, akiknek fontos"
" a kinézeted."

#: lang/json/mutation_from_json.py
msgid "Bad Knees"
msgstr "Rossz térd"

#. ~ Description for Bad Knees
#: lang/json/mutation_from_json.py
msgid ""
"Whether due to injury or age, your knees aren't particularly strong or "
"flexible.  Moving over rough terrain will slow you down more than normal."
msgstr ""
"Nem tudni, hogy sérülés vagy az idő vasfoga miatt, de a térded gyenge és nem"
" túl hajlékony. Egyenetlen talajon a szokásosnál lassabban tudsz csak "
"haladni."

#: lang/json/mutation_from_json.py
msgid "Languorous"
msgstr "Bágyatag"

#. ~ Description for Languorous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Whether due to lack of exercise and poor diet, or due to a natural "
"disinclination to physical endurance, you tire due to physical exertion much"
" more readily than others.  Your maximum stamina is 25% lower than usual."
msgstr ""
"Mozgáshiánytól, rossz táplálkozástól, vagy egyszerűen csak a teherbírás "
"természetes hiánya miatt sokkal hamarabb fáradsz ki fizikai igénybevételtől,"
" mint a többiek. A maximális kitartásod 25%-kal alacsonyabb."

#: lang/json/mutation_from_json.py
msgid "Near-Sighted"
msgstr "Rövidlátó"

#. ~ Description for Near-Sighted
#: lang/json/mutation_from_json.py
msgid ""
"Without glasses, your seeing radius is severely reduced!  However, you are "
"guaranteed to start with a pair of glasses."
msgstr ""
"Szemüveg nélkül csak nagyon közelre látsz. A játékot biztosan szemüveggel "
"kezded."

#: lang/json/mutation_from_json.py
msgid "Slow Healer"
msgstr "Lassan gyógyuló"

#. ~ Description for Slow Healer
#: lang/json/mutation_from_json.py
msgid "You heal a little slower than most; sleeping will heal less HP."
msgstr ""
"A többieknél egy kicsit lassabban gyógyulsz. Az alvás is kevesebb HP-t "
"gyógyít."

#: lang/json/mutation_from_json.py
msgid "Poor Healer"
msgstr "Rosszul gyógyul"

#. ~ Description for Poor Healer
#: lang/json/mutation_from_json.py
msgid ""
"Your health recovery through sleeping is severely impaired and causes you to"
" recover only a third of usual HP."
msgstr ""
"Alvás közben sokkal lassabban gyógyulsz, és a szokásos életpontok csupán "
"harmadát nyered vissza."

#: lang/json/mutation_from_json.py
msgid "Imperceptive Healer"
msgstr "Észlelhetetlenül gyógyul"

#. ~ Description for Imperceptive Healer
#: lang/json/mutation_from_json.py
msgid ""
"You recover barely any health through sleeping - it will heal only one tenth"
" of usual HP."
msgstr ""
"Alvás közben szinte semennyi életpontot nem nyersz vissza - a szokásos "
"mennyiség csupán tizedét."

#: lang/json/mutation_from_json.py
msgid "Far-Sighted"
msgstr "Távollátó"

#. ~ Description for Far-Sighted
#: lang/json/mutation_from_json.py
msgid ""
"Without reading glasses, you are unable to read anything, and take penalties"
" on melee accuracy and electronics/tailoring crafting.  However, you are "
"guaranteed to start with a pair of reading glasses."
msgstr ""
"Olvasószemüveg nélkül semmit sem tudsz elolvasni, és hátrányt szenvedsz a "
"közelharci pontosságban, illetve az elektronikai és egyéb kézműves tárgyak "
"összeszerelésénél. A játékot viszont garantáltan egy olvasószemüveggel "
"kezded."

#: lang/json/mutation_from_json.py
msgid "Heavy Sleeper"
msgstr "Mélyalvó"

#. ~ Description for Heavy Sleeper
#: lang/json/mutation_from_json.py
msgid "You're quite the heavy sleeper.  Noises are unlikely to wake you up."
msgstr ""
"Nagyon mélyen alszol, a különféle neszek és zajok kisebb eséllyel "
"ébresztenek fel."

#: lang/json/mutation_from_json.py
msgid "Sleepy"
msgstr "Álmos"

#. ~ Description for Sleepy
#: lang/json/mutation_from_json.py
msgid "You need sleep more often, but still spend most of your time awake."
msgstr "Gyakrabban kell aludnod, de még így is időd nagy részét ébren töltöd."

#: lang/json/mutation_from_json.py
msgid "Asthmatic"
msgstr "Asztmás"

#. ~ Description for Asthmatic
#: lang/json/mutation_from_json.py
msgid ""
"You will occasionally need to use an inhaler, or else suffer severe physical"
" limitations.  However, you are guaranteed to start with an inhaler."
msgstr ""
"Néha inhalálóra van szükséged, vagy komoly testi hátrányt szenvedsz. A "
"játékot viszont garantáltan egy inhalálóval kezded."

#: lang/json/mutation_from_json.py
msgid "Bad Back"
msgstr "Rossz hát"

#. ~ Description for Bad Back
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You simply cannot carry as much as people with a similar strength could.  "
"Your maximum weight carried is reduced by 35%."
msgstr ""
"Sokkal kevesebbet tudsz magaddal vinni, mint valaki más, aki ugyanannyira "
"erős. A 35%-kal kevesebb súlyt tudsz hordozni."

#: lang/json/mutation_from_json.py
msgid "Bad Temper"
msgstr "Rossz természetű"

#. ~ Description for Bad Temper
#: lang/json/mutation_from_json.py
msgid ""
"Things just keep getting you down.  You tend to be unhappy, and it takes "
"some doing to cheer you up."
msgstr ""
"A világ alakulása vagy rossz, vagy még rosszabb. Nagyrészt boldogtalan vagy,"
" és több minden kell a felvidításodhoz."

#: lang/json/mutation_from_json.py
msgid "Disorganized"
msgstr "Rendezetlen"

#. ~ Description for Disorganized
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are terrible at organizing and storing your possessions.  You can carry "
"40% less volume."
msgstr ""
"Nem nagyon értesz a dolgaid rendbe rakásához és rendszerezéséhez, ezért "
"40%-kal kevesebb térfogatot tudsz csak magaddal vinni."

#: lang/json/mutation_from_json.py
msgid "Illiterate"
msgstr "Analfabéta"

#. ~ Description for Illiterate
#: lang/json/mutation_from_json.py
msgid "You never learned to read!  Books and computers are off-limits to you."
msgstr ""
"Soha sem tanultál meg olvasni, ezért se könyveket, se számítógépeket nem "
"tudsz használni."

#: lang/json/mutation_from_json.py
msgid "Poor Hearing"
msgstr "Rosszul hall"

#. ~ Description for Poor Hearing
#: lang/json/mutation_from_json.py
msgid "Your hearing is poor, and you may not hear quiet or far-off noises."
msgstr ""
"Rossz a hallásod, ezért csendes neszeket vagy távoli zajokat nem mindig "
"hallasz meg."

#: lang/json/mutation_from_json.py
msgid "Slow Learner"
msgstr "Lassan tanul"

#. ~ Description for Slow Learner
#: lang/json/mutation_from_json.py
msgid ""
"You are slow to grasp new ideas and thus learn things more slowly than "
"others.  Note that this only applies to real-world experience, not to skill "
"gain from other sources like books."
msgstr ""
"Meglágyult az agyad, a többieknél sokkal lassabban sajátítod el a "
"készségeket. Ez csak a világban szerzett tapasztalatra vonatkozik, a "
"máshonnan, például könyvekből szerzett tapasztalati pontokra nem."

#: lang/json/mutation_from_json.py
msgid "Insomniac"
msgstr "Álmatlan"

#. ~ Description for Insomniac
#: lang/json/mutation_from_json.py
msgid ""
"You have a hard time falling asleep, even under the best circumstances!"
msgstr "Nehezen tudsz elaludni, még a legjobb körülmények között is."

#: lang/json/mutation_from_json.py
msgid "Meat Intolerance"
msgstr "Hús-intolerancia"

#. ~ Description for Meat Intolerance
#: lang/json/mutation_from_json.py
msgid ""
"You have problems with eating meat.  It's possible for you to eat it, but "
"you will suffer morale penalties due to nausea."
msgstr ""
"Gondot okoz neked, ha húst kell enned. Meg tudod ugyan enni, de hányinger "
"miatt romlik a hangulatod."

#: lang/json/mutation_from_json.py
msgid "Thin-Skinned"
msgstr "Vékonybőrű"

#. ~ Description for Thin-Skinned
#: lang/json/mutation_from_json.py
msgid "Your skin is fragile.  Cutting damage is slightly increased for you."
msgstr ""
"Bőröd vékony és sérülékeny, a vágó sebzések nagyobb sebesülést okoznak."

#: lang/json/mutation_from_json.py
msgid "Hates Vegetables"
msgstr "Utálja a zöldségeket"

#. ~ Description for Hates Vegetables
#: lang/json/mutation_from_json.py
msgid ""
"You, like many children, hated eating your vegetables; however, you didn't "
"outgrow it.  It's possible for you to eat them, but you will suffer morale "
"penalties due to nausea."
msgstr ""
"Gyerekként a többiekhez hasonlóan te is utáltad a zöldségeket, de felnőtt "
"korodra sem nőttél ebből ki. Meg tudod ugyan enni, de hányinger miatt romlik"
" a hangulatod."

#: lang/json/mutation_from_json.py
msgid "Hates Books"
msgstr "Utálja a könyveket"

#. ~ Description for Hates Books
#: lang/json/mutation_from_json.py
msgid ""
"Reading is for nerds!  Boring books are more boring, and you can't have fun "
"by reading books."
msgstr ""
"Olvasni csak a kockák szoktak! Az unalmas könyvek még unalmasabbak, és "
"szórakozásból nem is lehet könyvet olvasni."

#: lang/json/mutation_from_json.py
msgid "Hates Fruit"
msgstr "Utálja a gyümölcsöt"

#. ~ Description for Hates Fruit
#: lang/json/mutation_from_json.py
msgid ""
"You despise eating fruits.  It's possible for you to eat them, but you will "
"suffer morale penalties due to nausea."
msgstr ""
"Gyűlölöd a gyümölcsöket. Meg tudod ugyan enni, de hányinger miatt romlik a "
"hangulatod."

#. ~ Description for Lactose Intolerance
#: lang/json/mutation_from_json.py
msgid ""
"You, like 75 percent of the world, cannot tolerate milk or milk-based "
"products.  It's possible for you to eat them, but you will suffer morale "
"penalties due to nausea."
msgstr ""
"A világ lakosságának 75%-ához hasonlóan te sem bírod a tejet illetve a "
"tejtermékeket. Meg tudod ugyan enni, de hányinger miatt romlik a hangulatod."

#: lang/json/mutation_from_json.py
msgid "Junkfood Intolerance"
msgstr "Junk food-intolerancia"

#. ~ Description for Junkfood Intolerance
#: lang/json/mutation_from_json.py
msgid ""
"Something in those heavily processed foods doesn't agree with you.  It's "
"possible for you to eat them, but you will suffer morale penalties due to "
"nausea."
msgstr ""
"Az ipari gyártású, tartósítószerekkel megspékelt ételek nem igazán jönnek "
"be. Meg tudod ugyan enni, de hányinger miatt romlik a hangulatod."

#: lang/json/mutation_from_json.py
msgid "Grain Intolerance"
msgstr "Mag-intolerancia"

#. ~ Description for Grain Intolerance
#: lang/json/mutation_from_json.py
msgid ""
"You have a rare allergy that prevents you from eating most types of grains "
"such as wheat or oats.  It's possible for you to eat them, but you will "
"suffer morale penalties due to nausea."
msgstr ""
"Ritka allergiád miatt nem ajánlott magfélékből, például búzából vagy zabból "
"készült ételeket fogyasztanod. Meg tudod ugyan enni, de hányinger miatt "
"romlik a hangulatod."

#: lang/json/mutation_from_json.py
msgid "Sweet Tooth"
msgstr "Édesszájú"

#. ~ Description for Sweet Tooth
#: lang/json/mutation_from_json.py
msgid ""
"You have a soft spot for processed foods, and gain a morale bonus from "
"eating them."
msgstr ""
"Kifejezetten kedveled a feldolgozott élelmiszereket, és elfogyasztásukkal "
"hangulati bónuszt kapsz."

#: lang/json/mutation_from_json.py
msgid "Sugar-Loving"
msgstr "Cukorimádó"

#. ~ Description for Sugar-Loving
#: lang/json/mutation_from_json.py
msgid ""
"You *adore* the taste of junk food, and find it preferable to everything "
"else!"
msgstr ""
"*Imádod* a junk food ízét, és minden mással szemben ezt ennéd leginkább!"

#: lang/json/mutation_from_json.py
msgid "Glass Jaw"
msgstr "Üvegállú"

#. ~ Description for Glass Jaw
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your head can't take much abuse.  Its maximum HP is 20% lower than usual."
msgstr ""
"A fejed nem olyan acélos, mint a többieké - a fej HP-ja 20%-kal alacsonyabb."

#: lang/json/mutation_from_json.py
msgid "Forgetful"
msgstr "Feledékeny"

#. ~ Description for Forgetful
#: lang/json/mutation_from_json.py
msgid ""
"You have a hard time remembering things.  Your skills will erode slightly "
"faster than usual, and you can remember less terrain."
msgstr ""
"Nehezen idézel fel régebbi dolgokat. A készségeid a szokásosnál egy kicsit "
"gyorsabban kopnak el, és kevesebb tereptárgyra emlékszel."

#: lang/json/mutation_from_json.py
msgid "Lightweight"
msgstr "Szédülős"

#. ~ Description for Lightweight
#: lang/json/mutation_from_json.py
msgid ""
"Alcohol and drugs go straight to your head.  You suffer the negative effects"
" of these for longer."
msgstr ""
"Az alkohol és a kábítószer egyenesen a fejedbe száll, a negatív hatásaik "
"nálad tovább tartanak."

#: lang/json/mutation_from_json.py
msgid "Addictive Personality"
msgstr "Szenvedélybeteg természet"

#. ~ Description for Addictive Personality
#: lang/json/mutation_from_json.py
msgid ""
"It's easier for you to become addicted to substances, and harder to rid "
"yourself of these addictions."
msgstr ""
"Könnyebben szoksz rá az anyagra, és az elvonókúra is nehezebben is megy."

#: lang/json/mutation_from_json.py
msgid "Trigger Happy"
msgstr "Imád lövöldözni"

#. ~ Description for Trigger Happy
#: lang/json/mutation_from_json.py
msgid ""
"On rare occasion, you will go full-auto when you intended to fire a single "
"shot.  This has no effect when firing semi-automatic firearms."
msgstr ""
"Ritka alkalmanként egyetlen lövés helyett az egész tárat kilövöd. "
"Félautomata fegyverek esetén ennek nincs hatása."

#: lang/json/mutation_from_json.py
msgid "Strong Scent"
msgstr "Erős szagú"

#. ~ Description for Strong Scent
#: lang/json/mutation_from_json.py
msgid ""
"Your scent is particularly strong.  It's not offensive to humans, but "
"animals that track your scent will do so more easily."
msgstr ""
"Kifejezetten erős a szagod. Az embereket nem zavarja, de a levadászásodhoz a"
" szaglásukra támaszkodó állatok könnyebben tudnak követni."

#: lang/json/mutation_from_json.py
msgid "Chemical Imbalance"
msgstr "Felborult agykémia"

#. ~ Description for Chemical Imbalance
#: lang/json/mutation_from_json.py
msgid ""
"You suffer from a minor chemical imbalance, whether mental or physical.  "
"Minor changes to your internal chemistry will manifest themselves on "
"occasion, such as hunger, sleepiness, narcotic effects, etc."
msgstr ""
"Kisebb mértékben felborult a tested belső vegyi egyensúlya, ezért időről "
"időre ennek furcsa hatásaival szembesülsz: éhes leszel, nem tudsz aludni, "
"más hatással lesznek rád a drogok, stb."

#: lang/json/mutation_from_json.py
msgid "Animal Discord"
msgstr "Állatviszály"

#. ~ Description for Animal Discord
#: lang/json/mutation_from_json.py
msgid ""
"Most animals don't like you, and aggressive animals are more likely to "
"attack you.  This only applies to natural animals such as woodland "
"creatures."
msgstr ""
"A legtöbb állat nem szeret, az agresszív állatok is nagyobb eséllyel "
"támadnak rád. Ez csak a természetes állatokra, például az erdei állatokra "
"vonatkozik."

#: lang/json/mutation_from_json.py
msgid "Prey Animal"
msgstr "Zsákmányállat"

#. ~ Description for Prey Animal
#: lang/json/mutation_from_json.py
msgid ""
"Natural animals like dogs and wolves see you as prey, and are liable to "
"attack you on sight."
msgstr ""
"A természetes állatok, például a kutyák vagy a farkasok számára zsákmánynak "
"számítasz, ezért sokkal nagyobb eséllyel támadnak rád azonnal."

#: lang/json/mutation_from_json.py
msgid "Slow Reader"
msgstr "Lassú olvasó"

#. ~ Description for Slow Reader
#: lang/json/mutation_from_json.py
msgid ""
"You're a slow reader, and it takes you longer to get through books than "
"most."
msgstr ""
"Lassan tudsz csak olvasni, ezért a többieknél tovább tart egy könyvet "
"kiolvasni."

#: lang/json/mutation_from_json.py
msgid "Schizophrenic"
msgstr "Skizofrén"

#. ~ Description for Schizophrenic
#: lang/json/mutation_from_json.py
msgid ""
"You will periodically suffer from delusions, ranging from minor effects to "
"full visual hallucinations.  Some of these effects may be controlled through"
" the use of Thorazine."
msgstr ""
"Rendszeresen szenvedsz érzéki csalódásoktól, amelyek a kisebb hatástól "
"egészen a teljes vizuális hallucinációig terjednek. A hatások egy részét "
"Thorazine szedésével kordában lehet tartani."

#: lang/json/mutation_from_json.py
msgid "Narcoleptic"
msgstr "Álomkóros"

#. ~ Description for Narcoleptic
#: lang/json/mutation_from_json.py
msgid "You randomly fall asleep without any reason."
msgstr "Néha ok nélkül elalszol."

#: lang/json/mutation_from_json.py
msgid "Clumsy"
msgstr "Ügyetlen"

#. ~ Description for Clumsy
#: lang/json/mutation_from_json.py
msgid ""
"You make more noise while walking.  You're also more likely to set off "
"traps."
msgstr ""
"Járás közben több zajt csapsz, és nagyobb eséllyel indítasz be csapdát."

#: lang/json/mutation_from_json.py
msgid "Jittery"
msgstr "Cidris"

#. ~ Description for Jittery
#: lang/json/mutation_from_json.py
msgid ""
"During moments of great stress or under the effects of stimulants, you may "
"find your hands shaking uncontrollably, severely reducing your Dexterity."
msgstr ""
"Stimulánsok hatása alatt illetve stresszhelyzetben a kezed néha "
"megállíthatatlanul remeg, ezzel jelentősen csökkenti az ügyességed."

#. ~ Description for Hoarder
#: lang/json/mutation_from_json.py
msgid ""
"You don't feel right unless you're carrying as much as you can.  You suffer "
"morale penalties for carrying less than maximum volume (weight is ignored)."
"  Xanax can help control this anxiety."
msgstr ""
"Nem érzed magad jól, ha nem tömted tele az összes zsebedet. Csökken a "
"hangulatod, ha a maximális térfogatnál kevesebb tárgya van nálad (a súly nem"
" számít). A Xanax segít ennek a szorongásnak a leküzdéseben."

#: lang/json/mutation_from_json.py
msgid "Savant"
msgstr "Savant-szindrómás"

#. ~ Description for Savant
#: lang/json/mutation_from_json.py
msgid ""
"You tend to specialize in one skill and be poor at all others.  You advance "
"at half speed in all skills except your best one.  Note that combining this "
"with Fast Learner will come out to a slower rate of learning for all skills."
msgstr ""
"Egyetlen egy készségre specializálódsz, az összes többiben nem vagy jó. A "
"legjobb készséged kivételével minden más fele olyan gyorsan fejlődik. Ha ezt"
" a Gyorsan tanulóval párosítod, akkor az összes készséged lassabban fog "
"fejlődni."

#: lang/json/mutation_from_json.py
msgid "Pacifist"
msgstr "Pacifista"

#. ~ Description for Pacifist
#: lang/json/mutation_from_json.py
msgid ""
"You don't like thinking about violence.  Your combat skills advance much "
"slower than usual, and you feel more guilt about killing."
msgstr ""
"Nem szívesen gondolsz az erőszakra. A harci készségeid a szokásosnál "
"lassabban fejlődnek, és a gyilkosságok miatt több lesz a lelkiismeret-"
"furdalásod."

#: lang/json/mutation_from_json.py
msgid "Mood Swings"
msgstr "Hangulatingadozások"

#. ~ Description for Mood Swings
#: lang/json/mutation_from_json.py
msgid "Your morale will shift up and down at random, often dramatically."
msgstr ""
"A hangulatod véletlenszerűen kilenghet mindkét irányban, gyakran jelentõs "
"mértékkel."

#: lang/json/mutation_from_json.py
msgid "Slow Footed"
msgstr "Lassú lábú"

#. ~ Description for Slow Footed
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can't move as fast as most, resulting in a 15% speed penalty on flat "
"ground."
msgstr ""
"A többieknél lassabban tudsz csak haladni, ezért biztos talajon 15% hátrányt"
" kapsz a sebességedhez."

#: lang/json/mutation_from_json.py
msgid "Weak Stomach"
msgstr "Gyenge gyomrú"

#. ~ Description for Weak Stomach
#: lang/json/mutation_from_json.py
msgid "You are more likely to throw up from food poisoning, alcohol, etc."
msgstr "Sokkal nagyobb eséllyel hánysz gyomorrontásról, alkoholtól, stb."

#: lang/json/mutation_from_json.py
msgid "Wool Allergy"
msgstr "Gyapjúallergia"

#. ~ Description for Wool Allergy
#: lang/json/mutation_from_json.py
msgid ""
"You are badly allergic to wool, and cannot wear any clothing made of the "
"substance."
msgstr ""
"Nagyon allergiás vagy a gyapjúra, és semmiféle gyapjúból készült ruhadarabot"
" sem tudsz felvenni."

#: lang/json/mutation_from_json.py
msgid "Truth Teller"
msgstr "Igazmondó"

#. ~ Description for Truth Teller
#: lang/json/mutation_from_json.py
msgid ""
"When you try to tell a lie, you blush, stammer, and get all shifty-eyed.  "
"Telling lies and otherwise bluffing will be much more difficult for you."
msgstr ""
"Hazudozáskor elpirulsz, dadogsz és sandán lesel. Sokkal nehezebben tudsz "
"sikerrel hazudni vagy blöffölni."

#: lang/json/mutation_from_json.py
msgid "Ugly"
msgstr "Ronda"

#. ~ Description for Ugly
#: lang/json/mutation_from_json.py
msgid ""
"You're not much to look at.  NPCs who care about such things will react "
"poorly to you."
msgstr ""
"Rossz rád nézni. Sokkal kevésbé kedvezően reagálnak rád azok az NPC-k, "
"akiknek fontos a kinézeted."

#: lang/json/mutation_from_json.py
msgid "Albino"
msgstr "Albínó"

#. ~ Description for Albino
#: lang/json/mutation_from_json.py
msgid ""
"You lack skin pigmentation due to a genetic problem.  You sunburn extremely "
"easily, and typically use an umbrella and sunglasses when going out in the "
"sun."
msgstr ""
"Genetikai hiba hiányzik a bőröd pigmentációja. A napon nagyon könnyen "
"leégsz, ezért napsütésben esernyővel és napszemüveggel szoktál közlekedni."

#: lang/json/mutation_from_json.py
msgid "Flimsy"
msgstr "Gyatra"

#. ~ Description for Flimsy
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body can't take much abuse.  Its maximum HP is 25% lower than usual and"
" you heal slightly slower.  Stacks with Glass Jaw."
msgstr ""
"A tested nem nagyon képes ellenállni a durvaságnak. A HP-d a szokásosnál "
"25%-kal alacsonyabb, és lassabban is gyógyulsz. Az Üvegállú hatásával "
"összeadódik."

#: lang/json/mutation_from_json.py
msgid "Frail"
msgstr "Esendő"

#. ~ Description for Frail
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body breaks very easily.  Its maximum HP is 50% lower than usual and "
"you heal slower.  Stacks with Glass Jaw."
msgstr ""
"A testrészeid nagyon könnyen eltörhetők. A tested HP-ja a szokásosnál "
"50%-kal alacsonyabb, és lassabban is gyógyulsz. Az Üvegállú hatásával "
"összeadódik."

#: lang/json/mutation_from_json.py
msgid "Fragile"
msgstr "Törékeny"

#. ~ Description for Fragile
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body is extremely fragile.  Its maximum HP is 75% lower than usual and "
"you heal much slower.  Stacks with Glass Jaw."
msgstr ""
"A testrészeid kiemelkedően könnyen eltörhetők. A tested HP-ja a szokásosnál "
"75%-kal alacsonyabb, és lassabban is gyógyulsz. Az Üvegállú hatásával "
"összeadódik."

#: lang/json/mutation_from_json.py
msgid "Genetic Downward Spiral"
msgstr "Genetikus zuhanórepülés"

#. ~ Description for Genetic Downward Spiral
#: lang/json/mutation_from_json.py
msgid ""
"The events of the Cataclysm have damaged your DNA beyond repair.  You mutate"
" frequently, and all mutations you receive (from any source) are negative."
msgstr ""
"A kataklizma eseményei visszafordíthatatlan mértékben roncsolták a DNS-edet."
" Gyakran mutálsz, és az összes szerzett mutáció negatív, függetlenül attól, "
"hogy a mutációt mi okozza."

#: lang/json/mutation_from_json.py
msgid "Rough Skin"
msgstr "Durva bőr"

#. ~ Description for Rough Skin
#: lang/json/mutation_from_json.py
msgid "Your skin is slightly rough.  This has no gameplay effect."
msgstr "A bőröd felszíne tapintásra durva és érdes. Más hatása amúgy nincs."

#: lang/json/mutation_from_json.py
msgid "High Night Vision"
msgstr "Jó éjjellátó"

#. ~ Description for High Night Vision
#: lang/json/mutation_from_json.py
msgid ""
"You can see incredibly well in the dark!  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"Nagyon jól látsz a sötétben! Aktiváld az éjjellátás ki- vagy "
"bekapcsolásához."

#: lang/json/mutation_from_json.py
msgid "Full Night Vision"
msgstr "Teljesen éjjellátó"

#. ~ Description for Full Night Vision
#: lang/json/mutation_from_json.py
msgid ""
"You can see in pitch blackness as if you were wearing night-vision goggles."
"  Activate to toggle NV-visible areas on or off."
msgstr ""
"Annyira tisztán látsz a teljes sötétségben, mintha éjjellátó szemüveg lenne "
"rajtad. Aktiváld az éjjellátás ki- vagy bekapcsolásához."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Eyes"
msgstr "Lábasfejű szemek"

#. ~ Description for Cephalopod Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes still bulge, yet your pupils look different somehow.  Water "
"doesn't seem to cause any trouble at all, though."
msgstr ""
"A szemed még mindig kidülled, de a pupillád valahogy máshogy néz ki. A "
"vízben tisztán látsz."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Vision"
msgstr "Lábasfejű látás"

#. ~ Description for Cephalopod Vision
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has caught up with your eyes.  You can see much better in the "
"dark, but sunlight seems much brighter now.  Activate to toggle NV-visible "
"areas on or off."
msgstr ""
"Az agyad utolérted a szemedet. Most már sokkal jobban látsz a sötétben, de a"
" napfény is sokkal fényesebb. Aktiváld az éjjellátás ki- vagy "
"bekapcsolásához."

#: lang/json/mutation_from_json.py
msgid "Fey Eyes"
msgstr "Elfszemű"

#. ~ Description for Fey Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have turned...green.  It's tough to tell the exact shade as it "
"seems to shift.  The effect is ...pleasant."
msgstr ""
"A szemed színe bezöldült. Nehéz pontosan megmondani, hogy mennyire zöld, "
"mert az árnyalata állandóan változik. Összességében kellemes hatást kelt."

#: lang/json/mutation_from_json.py
msgid "Fey Vision"
msgstr "Elf látás"

#. ~ Description for Fey Vision
#: lang/json/mutation_from_json.py
msgid ""
"The shadows don't seem as dark now.  Activate to toggle NV-visible areas on "
"or off."
msgstr ""
"Az árnyékban már nincs olyan sötét. Aktiváld az éjjellátás ki- vagy "
"bekapcsolásához."

#: lang/json/mutation_from_json.py
msgid "Fey Nightsight"
msgstr "Elf éjjellátás"

#. ~ Description for Fey Nightsight
#: lang/json/mutation_from_json.py
msgid ""
"You have great low-light vision now, though that doesn't allow you to "
"perform fine tasks such as crafting and reading in darkness.  Activate to "
"toggle NV-visible areas on or off."
msgstr ""
"Nagyon jól látsz már a sötétben, bár apró részleteket még mindig nem tudsz "
"kivenni ahhoz, hogy a sötétben készíts tárgyakat vagy olvass. Aktiváld az "
"éjjellátás ki- vagy bekapcsolásához."

#: lang/json/mutation_from_json.py
msgid "Feline Eyes"
msgstr "Macskaszemű"

#. ~ Description for Feline Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have mutated, now having a slitted pupil and glittering in light, "
"much like those of cats.  This is visually striking, but it isn't helping "
"you see at night."
msgstr ""
"A szemgolyóid mutálódtak, most már a macskához hasonlóan függőleges vágású "
"írisszel és fényvisszaverő réteggel rendelkeznek. Ránézésre szembetűnő a "
"változás, de ettől még nem látsz jobban éjszaka."

#: lang/json/mutation_from_json.py
msgid "Feline Vision"
msgstr "Macska látás"

#. ~ Description for Feline Vision
#: lang/json/mutation_from_json.py
msgid ""
"Your optic nerves and brain caught up with your eyes.  Now you can see "
"pretty well at night.  Activate to toggle NV-visible areas on or off."
msgstr ""
"A látóidegeid és az agyad végre felvették a lépést a szemeddel. Most már "
"egész jól látsz éjszaka. Aktiváld az éjjellátás ki- vagy bekapcsolásához."

#: lang/json/mutation_from_json.py
msgid "Ursine Vision"
msgstr "Medvelátás"

#. ~ Description for Ursine Vision
#: lang/json/mutation_from_json.py
msgid ""
"Your visual processing has shifted: though you can see better in the dark, "
"you're nearsighted in the light.  Maybe glasses would help.  Activate to "
"toggle NV-visible areas on or off."
msgstr ""
"A vizuális jelfeldolgozásod elcsúszott - bár jobban látsz a sötétben, "
"fényben rövidlátó vagy. Talán egy szemüveg segítene. Aktiváld az éjjellátás "
"ki- vagy bekapcsolásához."

#: lang/json/mutation_from_json.py
msgid "Avian Eyes"
msgstr "Madárszemek"

#. ~ Description for Avian Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your vision has become particularly acute: you suspect you could pick out "
"zombies much farther away.  Perception +4."
msgstr ""
"A látásod kifejezetten éles - most már sokkal messzebbről észreveszed a "
"zombikat. Érzékelés +4."

#. ~ Description for Infrared Vision
#: lang/json/mutation_from_json.py
msgid "Your eyes have mutated to pick up radiation in the infrared spectrum."
msgstr ""
"A szemgolyóid mutálódtak, és már az infravörös tartomány sugárzását is "
"képesek észlelni."

#: lang/json/mutation_from_json.py
msgid "Reptilian Eyes"
msgstr "Hüllőszemű"

#. ~ Description for Reptilian Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes have mutated, with a brilliant iris and slitted pupil similar to "
"that of a lizard.  This is visually striking, but doesn't seem to affect "
"your vision."
msgstr ""
"A szemgolyóid mutálódtak, most már egy gyíkhoz hasonlóan hasonlóan csillogó "
"írisszel és függőleges vágású pupillával rendelkeznek. Ránézésre szembetűnő "
"a változás, de ettől még nem látsz jobban éjszaka."

#: lang/json/mutation_from_json.py
msgid "Reptilian IR"
msgstr "Hüllő infravörös látás"

#. ~ Description for Reptilian IR
#: lang/json/mutation_from_json.py
msgid ""
"Your optic nerves and brain have mutated to catch up with your eyes, "
"allowing you to see in the infrared spectrum."
msgstr ""
"A látóidegeid és az agyad végre felvették a lépést a szemeddel, most már az "
"infravörös tartományban is látsz."

#: lang/json/mutation_from_json.py
msgid "Very Fast Healer"
msgstr "Nagyon gyorsan gyógyuló"

#. ~ Description for Very Fast Healer
#: lang/json/mutation_from_json.py
msgid ""
"Your flesh regenerates slowly, and you will regain HP even when not "
"sleeping."
msgstr ""
"A húsod lassan magától begyógyul, és még alvás nélkül is regenerálod a HP-"
"det."

#: lang/json/mutation_from_json.py
msgid "Regeneration"
msgstr "Regenerálás"

#. ~ Description for Regeneration
#: lang/json/mutation_from_json.py
msgid "Your flesh regenerates from wounds incredibly quickly."
msgstr "A húsod elképesztően gyorsan áll helyre a sebesülésekből."

#: lang/json/mutation_from_json.py
msgid "Reptilian Healing"
msgstr "Hüllők gyógyulása"

#. ~ Description for Reptilian Healing
#: lang/json/mutation_from_json.py
msgid "Your broken limbs mend themselves without significant difficulty."
msgstr ""
"A törött végtagjaid mindenféle nehézség nélkül, önmaguktól begyógyulnak."

#: lang/json/mutation_from_json.py
msgid "Very Little Sleep"
msgstr "Nagyon kevés alvás"

#. ~ Description for Very Little Sleep
#: lang/json/mutation_from_json.py
msgid "You don't sleep often.  But when you do, you need very little of it."
msgstr ""
"Nem alszol túl gyakran, és amikor mégis, akkor sincs szükséged sok alvásra."

#: lang/json/mutation_from_json.py
msgid "Tireless"
msgstr "Fáradhatatlan"

#. ~ Description for Tireless
#: lang/json/mutation_from_json.py
msgid "You defend the realm all night and all day."
msgstr "Éjjel és nappal védelmezed a birodalmat."

#: lang/json/mutation_from_json.py
msgid "Fangs"
msgstr "Agyarak"

#. ~ Description for Fangs
#: lang/json/mutation_from_json.py
msgid ""
"Your teeth have grown into two-inch-long fangs, allowing you to make an "
"extra attack when conditions favor it."
msgstr ""
"A fogaid ötcentis agyarakká nőtték ki magukat, amelyekkel a megfelelő "
"körülmények között plusz egy támadást tudsz bevinni."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You sink your fangs into %s"
msgstr "Az agyaraidat belemélyeszted %s testébe."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s sinks their fangs into %2$s"
msgstr "%1$s belemélyeszti az agyarait %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Incisors"
msgstr "Metszőfogak"

#. ~ Description for Incisors
#: lang/json/mutation_from_json.py
msgid "Your big teeth have grown in.  Folks had best show some more respect."
msgstr ""
"Nagyra nőttek a metszőfogaid. A többieknek ajánlott, hogy nagyobb "
"tisztelettel szóljanak hozzád."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite into %s with your ratlike incisors"
msgstr "A patkányszerű metszőfogaiddal beleharapsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites %2$s with their ratlike incisors"
msgstr "%1$s a patkányszerű metszőfogaival beleharap %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Nictitating Membrane"
msgstr "Harmadik szemhéj"

#. ~ Description for Nictitating Membrane
#: lang/json/mutation_from_json.py
msgid ""
"You have a set of clear lenses which lower over your eyes while underwater, "
"allowing you to see as though you were wearing goggles.  Slightly decreases "
"wet penalties."
msgstr ""
"A harmadik szemhéj víz alá merüléskor húzódik a szemed elé, így annyira "
"tisztán látsz, mintha úszószemüveged lenne. Némileg csökkenti az ázottság "
"miatti hátrányt."

#: lang/json/mutation_from_json.py
msgid "Gills"
msgstr "Kopoltyús"

#. ~ Description for Gills
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a set of gills in your neck, allowing you to breathe "
"underwater.  Slightly increases wet benefits."
msgstr ""
"A nyakadba kopoltyú nőtt, így már a víz alatt is tudsz lélegezni. Némileg "
"növeli az ázottsággal járó előnyöket."

#: lang/json/mutation_from_json.py
msgid "Cephalopod Gills"
msgstr "Lábasfejűek kopoltyúja"

#. ~ Description for Cephalopod Gills
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a set of gills, running from your neck up behind your ears.  "
"They allow you to breathe underwater and slightly increase wet benefits."
msgstr ""
"A nyakadba a füledig tartó kopoltyú nőtt, így már a víz alatt is tudsz "
"lélegezni. Némileg növeli az ázottsággal járó előnyöket."

#: lang/json/mutation_from_json.py
msgid "Mycus Flesh"
msgstr "Mycus hús"

#. ~ Description for Mycus Flesh
#: lang/json/mutation_from_json.py
msgid ""
"We have begun adapting local physiology to Mycus physical structure, greatly"
" reducing wet effects."
msgstr ""
"A helyi fiziológiánkat elkezdtük hozzáigazítani a Mycus struktúrájához. "
"Jelentősen csökkenti a nedvesség hatásait."

#: lang/json/mutation_from_json.py
msgid "Mycus Fireproofing"
msgstr "Mycus tűzálló"

#. ~ Description for Mycus Fireproofing
#: lang/json/mutation_from_json.py
msgid ""
"We have spliced the dense, amphibole fibers from Mycus core towers with the "
"resilient, adaptive flesh of local physiology.  This reduces our speed by a "
"moderate amount, but provides powerful armor across our body, nullifies wet "
"effects, and provides complete protection from fire."
msgstr ""
"A mycus magtornyaiból származó sűrű amfibol rostokat alkalmaztattuk a helyi "
"fiziológia húsához. Ezzel némileg csökken a sebességünk de a testünket "
"befedő hatékony páncél semlegesíti az ázottság hatásait, továbbá teljes "
"védelmet nyújt a tűz ellen."

#: lang/json/mutation_from_json.py
msgid "Mycogenesis"
msgstr "Mycogenezis"

#. ~ Description for Mycogenesis
#: lang/json/mutation_from_json.py
msgid ""
"Local physiology has been fully incorporated with that of Mycus silicate "
"fibers.  In addition to benefits conferred by previous developments, we may "
"join with Mycus fibers beneath us - sleeping on top of fungal areas places "
"us into a dormant state, which spreads spores around us as we sleep and "
"revitalizes our body much more quickly than regular sleep."
msgstr ""
"A helyi fiziológiát teljes mértékben egyesítettük a mycos szilika "
"rostjaival. A korábbi fejlődések előnyein túl az alattunk található mycos "
"rostjaihoz is képesek vagyunk csatlakozni. Gombás területeken történő "
"alváskor szunnyadó állapotba kerülünk, ilyenkor spórákat terjesztünk magunk "
"körül, és ez a hagyományos alvásnál sokkal gyorsabb mértékben revitalizálja "
"a testünket."

#: lang/json/mutation_from_json.py
msgid "Scales"
msgstr "Pikkelyes"

#. ~ Description for Scales
#: lang/json/mutation_from_json.py
msgid ""
"A set of flexible green scales has grown to cover your body, acting as "
"natural armor.  Somewhat reduces wet effects."
msgstr ""
"Zöldszínű pikkelyek nőttek a bőrödre, afféle természetes páncélként. "
"Valamennyire csökkenti az ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Thick Scales"
msgstr "Vastagon pikkelyes"

#. ~ Description for Thick Scales
#: lang/json/mutation_from_json.py
msgid ""
"A set of heavy green scales has grown to cover your body, acting as natural "
"armor.  While difficult to penetrate, it also limits your flexibility, "
"resulting in a -2 penalty to Dexterity.  Greatly reduces wet effects."
msgstr ""
"Vastag, zöldszínű pikkelyek nőttek a bőrödre, afféle természetes páncélként."
" Bár a pikkelypáncélt nehéz áttörni, vastagsága miatt kevésbé vagy "
"hajlékony, ezért -2 hátrányt kap az ügyességed. Nagyon jól csökkenti az "
"ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Sleek Scales"
msgstr "Csúszós pikkelyes"

#. ~ Description for Sleek Scales
#: lang/json/mutation_from_json.py
msgid ""
"A set of very flexible and slick scales has grown to cover your body.  These"
" act as weak natural armor, improve your ability to swim, and make you "
"difficult to grab.  Mostly reduces wet effects."
msgstr ""
"Nagyon rugalmas és csúszós pikkelyek nőttek a bőrödre. Afféle gyenge "
"természetes páncélként hat, javítja az úszási képességeidet és nehezebben "
"lehet megragadni. Főleg az ázottság hatásait csökkenti."

#: lang/json/mutation_from_json.py
msgid "Light Bones"
msgstr "Könnyű csontok"

#. ~ Description for Light Bones
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your bones are very light.  This enables you to move and attack 10% faster, "
"but also reduces your carrying weight by 20% and makes bashing attacks hurt "
"a little more."
msgstr ""
"Nagyon könnyűvé váltak a csontjaid, ezért 10%-kal gyorsabban tudsz haladni "
"és támadni, viszont 20%-kal kevesebb súlyt tudsz magaddal vinni, és a zúzó "
"támadások jobban fájnak."

#: lang/json/mutation_from_json.py
msgid "Feathers"
msgstr "Tollas"

#. ~ Description for Feathers
#: lang/json/mutation_from_json.py
msgid ""
"Iridescent feathers have grown to cover your entire body, providing a "
"marginal protection against attacks and minor protection from cold.  They "
"also provide a natural waterproofing."
msgstr ""
"Az egész testedre irizáló tollak nőttek, amelyek valamennyire megvédenek a "
"támadások ellen és egy kis mértékben a hideg ellen is. Ezen túl természetes "
"vízálló burkolatként is funkcionálnak."

#: lang/json/mutation_from_json.py
msgid "Down"
msgstr "Pihés"

#. ~ Description for Down
#: lang/json/mutation_from_json.py
msgid ""
"You shan't need to migrate south with your layer of down.  It's even better "
"with no apes around to kill you for it!"
msgstr ""
"Nem is kell dél felé vonulnod a piheréteged miatt. Akkor még jobb, ha "
"nincsenek itt olyan majmok, akik megnyúznának érte!"

#: lang/json/mutation_from_json.py
msgid "Lightly Furred"
msgstr "Finoman szőrös"

#. ~ Description for Lightly Furred
#: lang/json/mutation_from_json.py
msgid ""
"Light fur has grown to cover your entire body, providing slight protection "
"from cold."
msgstr ""
"Ritka szőrzet fedi az egész testedet, némi védelmet nyújtva a hideg ellen."

#: lang/json/mutation_from_json.py
msgid "Furry"
msgstr "Bundás"

#. ~ Description for Furry
#: lang/json/mutation_from_json.py
msgid ""
"Thick black fur has grown to cover your entire body, providing a marginal "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Vastag fekete szőrme fedi be az egész testedet, némi védelmet nyújtva a "
"támadások, és jelentős védelmet nyújtva a hideg ellen."

#: lang/json/mutation_from_json.py
msgid "Shaggy Fur"
msgstr "Bozontos szőr"

#. ~ Description for Shaggy Fur
#: lang/json/mutation_from_json.py
msgid ""
"Your fur has grown out and thickened, providing noticeable protection from "
"attacks as well as considerable insulation."
msgstr ""
"A szőröd hosszabbra nőtt és megvastagodott, így jelentős védelmet nyújt a "
"támadások ellen, valamint erősen szigetel."

#: lang/json/mutation_from_json.py
msgid "Gray Fur"
msgstr "Szürke bundás"

#. ~ Description for Gray Fur
#: lang/json/mutation_from_json.py
msgid ""
"Dense gray fur has grown to cover your entire body, providing a marginal "
"protection against attacks, and considerable protection from cold."
msgstr ""
"Sűrű szürke bunda fedi be az egész testedet, némi védelmet nyújtva a "
"támadások és jelentős védelmet nyújtva a hideg ellen."

#: lang/json/mutation_from_json.py
msgid "Sleek Fur"
msgstr "Sima bundás"

#. ~ Description for Sleek Fur
#: lang/json/mutation_from_json.py
msgid "You've grown sleek brown fur, providing some protection from cold."
msgstr ""
"Sima barna bundát növesztettél magadra, amely némi védelmet nyújt a hideg "
"ellen."

#: lang/json/mutation_from_json.py
msgid "Lynx Fur"
msgstr "Hiúzbundás"

#. ~ Description for Lynx Fur
#: lang/json/mutation_from_json.py
msgid ""
"Your fur has grown out significantly around your cheeks and neck.  It "
"provides minor protection against attacks."
msgstr ""
"A bundád jelentősen megvastagodott a nyakad és az arcod tájékán, némi "
"védelmet nyújtva a támadások ellen."

#: lang/json/mutation_from_json.py
msgid "Chitinous Skin"
msgstr "Kitines bőr"

#. ~ Description for Chitinous Skin
#: lang/json/mutation_from_json.py
msgid ""
"Your epidermis has turned into a thin, flexible layer of chitin.  It "
"provides minor protection from cutting wounds.  Slightly reduces wet "
"effects."
msgstr ""
"A felhámod egy vékony, hajlékony kitinréteggé változott át. Némi védelmet "
"nyújt a vágási sebek ellen és valamennyire csökkenti az ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Chitinous Armor"
msgstr "Kitinpáncél"

#. ~ Description for Chitinous Armor
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a chitin exoskeleton, much like that of an insect.  It provides"
" considerable physical protection, but reduces your Dexterity by 1.  "
"Somewhat reduces wet effects."
msgstr ""
"Rovarhoz hasonló kitinvázat növesztettél. Jelentős fizikai védelmet "
"biztosít, de az ügyességet 1-el csökkenti. Valamennyire csökkenti az "
"ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Chitinous Plate"
msgstr "Kitinlemezes"

#. ~ Description for Chitinous Plate
#: lang/json/mutation_from_json.py
msgid ""
"You've grown a chitin exoskeleton made of thick, stiff plates.  It provides "
"excellent physical protection, but reduces your Dexterity by 1 and encumbers"
" all body parts but your eyes and mouth.  Greatly reduces wet effects."
msgstr ""
"Vastag, rideg kitinlemezes vázat növesztettél. Kiváló fizikai védelmet "
"biztosít, de az ügyességedet 1-el csökkenti, valamint a szemek és a száj "
"kivételével az összes testrészed ormótlanságát növeli. Nagyon jól csökkenti "
"az ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Hairy Chitin"
msgstr "Szőrös kitin"

#. ~ Description for Hairy Chitin
#: lang/json/mutation_from_json.py
msgid ""
"You've developed some sort of hair growing out of your chitin.  It's a bit "
"warmer than not having hair."
msgstr ""
"Valamiféle szőr nőtt ki a kitinedből. Egy kicsit melegebb, mintha nem lennél"
" szőrös."

#: lang/json/mutation_from_json.py
msgid "Furred Chitin"
msgstr "Prémes kitin"

#. ~ Description for Furred Chitin
#: lang/json/mutation_from_json.py
msgid ""
"Your chitin hair has thickened and spread across your body.  It provides "
"minor warmth and helps you sense nearby vibrations."
msgstr ""
"A kitinből kinövő szőr megvastagodott és már az egész tested befedi. Egy "
"kicsit melegít, és segít megérezni a közeli rezgéseket."

#: lang/json/mutation_from_json.py
msgid "Furred Plate"
msgstr "Prémes páncélzat"

#. ~ Description for Furred Plate
#: lang/json/mutation_from_json.py
msgid ""
"Your exoskeleton has hardened considerably--restricting movement, granted--"
"and boasts a fine coat of hairs that put feline whiskers to shame."
msgstr ""
"A külső vázad jelentősen megszilárdult, bár ezzel gátol a mozgásban, és "
"olyan szép prém borítja, hogy azt egy macska is megirigyelhetné."

#: lang/json/mutation_from_json.py
msgid "Urticating Hairs"
msgstr "Csalános szőr"

#. ~ Description for Urticating Hairs
#: lang/json/mutation_from_json.py
msgid ""
"Significant amounts of your hairs have loosened.  If some creature tries to "
"attack you, your assailant is quite likely to get fine, bristly chitin in an"
" irritating spot; it doesn't carry your venom but it will be distracting."
msgstr ""
"A szőröd nagy része meglazult. Ha egy lény megtámad, akkor abba egy csomó "
"finoman irritáló szőrszál fúródik. A szőrszálak nem mérgezőek, de zavarók."

#: lang/json/mutation_from_json.py
msgid "Spines"
msgstr "Tövises"

#. ~ Description for Spines
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is covered with fine spines.  Whenever an unarmed opponent strikes"
" a part of your body that is not covered by clothing, they will receive "
"moderate damage."
msgstr ""
"A bőrödből apró tövisek nőttek ki. Amikor kézitusában egy ellenfél egy olyan"
" testrészedet találja el, amelyet nem fed be ruha, akkor közepes szintű "
"sebzést kap."

#: lang/json/mutation_from_json.py
msgid "Quills"
msgstr "Sültüskés"

#. ~ Description for Quills
#: lang/json/mutation_from_json.py
msgid ""
"Your body is covered with large quills.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive significant damage."
msgstr ""
"A bőrödből nagyméretű tüskék nőttek ki. Amikor kézitusában egy ellenfél egy "
"olyan testrészedet találja el, amelyet nem fed be ruha, akkor magas szintű "
"sebzést kap."

#: lang/json/mutation_from_json.py
msgid "Phelloderm"
msgstr "Parafaréteg"

#. ~ Description for Phelloderm
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is light green and has a slightly woody quality to it.  This "
"provides a weak armor, and helps you retain moisture, resulting in less "
"thirst.  Greatly decreases wet penalties."
msgstr ""
"A bőröd halványzöld és némileg fahatású. Ez egyben gyenge páncélként is "
"funkcionál, segít a nedvesség megőrzésében, így ritkábban leszel szomjas. "
"Nagyon jól csökkenti az ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Bark"
msgstr "Kéreg"

#. ~ Description for Bark
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is coated in a light bark, like that of a tree.  This provides "
"resistance to cutting damage and minor protection from fire.  Greatly "
"reduces wet effects."
msgstr ""
"A bőrödet egy vékony kéreg fedi be, mint egy fát. Ennek köszönhetően "
"ellenállóbbá váltál a vágó sérülésekkel szemben, valamint kis mértékben a "
"tűztől is megvéd. Nagyon jól csökkenti az ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Thorns"
msgstr "Tüskés"

#. ~ Description for Thorns
#: lang/json/mutation_from_json.py
msgid ""
"Your skin is covered in small, woody thorns.  Whenever an unarmed opponent "
"strikes a part of your body that is not covered by clothing, they will "
"receive minor damage.  Your punches may also deal extra damage."
msgstr ""
"A bőrödből apró, fásszárú tövisek nőttek ki. Amikor kézitusában egy ellenfél"
" egy olyan testrészedet találja el, amelyet nem fed be ruha, akkor alacsony "
"szintű sebzést kap. Az ütéseid további sebzést okoznak."

#: lang/json/mutation_from_json.py
msgid "Leaves"
msgstr "Leveles"

#. ~ Description for Leaves
#: lang/json/mutation_from_json.py
msgid ""
"All the hair on your body has turned to long, grass-like leaves.  Apart from"
" being physically striking, these provide you with a minor amount of "
"nutrition while in sunlight.  Slightly reduces wet effects."
msgstr ""
"A testeden található apró szőrök hosszú, fűszerű levelekké változtak át. "
"Azon kívül, hogy mennyire másként nézel így ki, a levelek napfényben kis "
"mértékben táplálékkal látnak el. Némileg csökkenti az ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Flowering"
msgstr "Virágzik"

#. ~ Description for Flowering
#: lang/json/mutation_from_json.py
msgid ""
"You've started blooming where your scalp used to be.  Your blossoms have a "
"pleasant aroma, are visually striking, and are quite sensitive."
msgstr ""
"A skalpod helyén elkezdtél virágozni. A szirmokkal borított fejednek nagyon "
"jó az illata, szép és dekoratív, viszont emiatt nagyon érzékeny is."

#: lang/json/mutation_from_json.py
msgid "Mycus Spores"
msgstr "Mycus spóra"

#. ~ Description for Mycus Spores
#: lang/json/mutation_from_json.py
msgid "We have developed local spore sacs.  The Mycus must grow."
msgstr "Spórát tartalmazó hólyagjaid nőttek. A Mycusnak erősödnie kell."

#: lang/json/mutation_from_json.py
msgid "Mycus Sporogenesis"
msgstr "Mycus spóraképzés"

#. ~ Description for Mycus Sporogenesis
#: lang/json/mutation_from_json.py
msgid ""
"Local organisms seem to regard open spore-dispersal as a danger, and attack "
"the Mycus.  Accordingly our local spore sacs remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"A helyi élőlények az állandó spóra eregetést veszélyesnek tartják, és "
"megtámadják a mycust. A spórahólyagjaink ezért nyugalomban maradnak, amíg "
"csíráztatás nem biztonságos. A gyors spóraképzés megterhelő a helyi tápanyag"
" tartalékok számára, ugyanakkor gyors és hatékony növekedést biztosít."

#: lang/json/mutation_from_json.py
msgid "Mycus Blossoms"
msgstr "Mycus virágzás"

#. ~ Description for Mycus Blossoms
#: lang/json/mutation_from_json.py
msgid "We have developed local blossoms.  The Mycus must grow."
msgstr "Spórát tartalmazó virágjaid nőttek. A Mycusnak erősödnie kell."

#: lang/json/mutation_from_json.py
msgid "Mycus Bloom"
msgstr "Mycus rajzás"

#. ~ Description for Mycus Bloom
#: lang/json/mutation_from_json.py
msgid ""
"Local organisms seem to regard open spore-dispersal as a danger, and attack "
"the Mycus.  Accordingly our local blossoms remain quiescent, until local "
"guidance determines that it is safe to germinate.  Rapid development taxes "
"local nutrient reserves but ensures swift and effective growth."
msgstr ""
"A helyi élőlények az állandó spóra eregetést veszélyesnek tartják, és "
"megtámadják a mycust. A spóravirágok ezért nyugalomban maradnak, amíg "
"csíráztatás nem biztonságos. A gyors spóraképzés megterhelő a helyi tápanyag"
" tartalékok számára, ugyanakkor gyors és hatékony növekedést biztosít."

#: lang/json/mutation_from_json.py
msgid "Mycus Provenance"
msgstr "Mycus származás"

#. ~ Description for Mycus Provenance
#: lang/json/mutation_from_json.py
msgid ""
"Local spore sacs and blossoms have merged into a single, symbiotic form.  "
"Acting as one, they germinate together to cement rapid growth across a large"
" area according to local guidance.  The Mycus must grow."
msgstr ""
"A helyi spórahólyagjaink és virágzásunk egyetlen egy, szimbiózisban élő "
"formává egyesültek. Egyként cselekedve együtt csíráznak, és a helyi "
"irányítás alapján gyorsan növekednek nagy területre. A mycusnak növekednie "
"kell."

#: lang/json/mutation_from_json.py
msgid "Long Fingernails"
msgstr "Hosszú körmök"

#. ~ Description for Long Fingernails
#: lang/json/mutation_from_json.py
msgid ""
"Your fingernails are long and sharp.  If you aren't wearing gloves, your "
"unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"A körmeid hosszúak és élesek. Ha nincs rajtad kesztyű, akkor a puszta kézzel"
" bevitt támadások kis mértékben további vágó sebzést is okoznak."

#: lang/json/mutation_from_json.py
msgid "Claws"
msgstr "Karmok"

#. ~ Description for Claws
#: lang/json/mutation_from_json.py
msgid ""
"You have claws on the ends of your fingers.  If you aren't wearing gloves, "
"your unarmed attacks deal a minor amount of cutting damage."
msgstr ""
"Az ujjaid végére karmok nőttek. Ha nincs rajtad kesztyű, akkor a puszta "
"kézzel bevitt támadások kis mértékben további vágó sebzést is okoznak."

#: lang/json/mutation_from_json.py
msgid "Rat Claws"
msgstr "Patkánykarmok"

#. ~ Description for Rat Claws
#: lang/json/mutation_from_json.py
msgid "Your claws have grown tougher and slightly gnarled."
msgstr "A karmaid megkeményedtek és egy kicsit bütykössé váltak."

#: lang/json/mutation_from_json.py
msgid "Stainless Claws"
msgstr "Rozsdamentes karmok"

#. ~ Description for Stainless Claws
#: lang/json/mutation_from_json.py
msgid ""
"Your paws are bone, muscle, and claw with a thin layer of skin and fur.  "
"They might as well be made of stainless steel."
msgstr ""
"A mancsaid csontból, izomból és karomból állnak, amelyet vékony réteg bőr és"
" szőrzet borít. Akár rozsdamentes acélból is készülhettek volna."

#: lang/json/mutation_from_json.py
msgid "Retractable Claws"
msgstr "Visszahúzható karmok"

#. ~ Description for Retractable Claws
#: lang/json/mutation_from_json.py
msgid ""
"You have claws on the ends of your fingers, and can extend or retract them "
"as desired.  Gloves will still get in the way, though."
msgstr ""
"Az ujjaid végére karmok nőttek, amelyeket igény szerint be tudsz húzni. A "
"kesztyű viszont útban lesz."

#: lang/json/mutation_from_json.py
msgid "Tentacle Rakes"
msgstr "Gereblyés csápok"

#. ~ Description for Tentacle Rakes
#: lang/json/mutation_from_json.py
msgid ""
"Your upper tentacles have grown large, hook-barbed rakes on the ends.  "
"They're quite vicious, but really aren't suited for fine manipulation."
msgstr ""
"A felsőbb csápjaidra nagyméretű, kampós-horgas fésűk nőttek. Rettenetesen "
"vérszomjasan nézel így ki, viszont a fésűk nem igazán alkalmasak a finom "
"kézimunkára."

#: lang/json/mutation_from_json.py
msgid "Large Talons"
msgstr "Nagy karom"

#. ~ Description for Large Talons
#: lang/json/mutation_from_json.py
msgid ""
"Your index fingers have grown into huge talons.  After a bit of practice, "
"you find that this does not affect your dexterity, but allows for a deadly "
"unarmed attack.  They also prevent wearing gloves."
msgstr ""
"A mutatóujjaidra hatalmas karmok nőttek. Némi gyakorlás után felfedezted, "
"hogy a karmok nem befolyásolják az ügyességedet, viszont halálos kézi "
"csapásokat tesznek lehetővé. Sajnos a karmok miatt nem tudsz kesztyűt "
"hordani."

#: lang/json/mutation_from_json.py
msgid "Radiogenic"
msgstr "Radiogén"

#. ~ Description for Radiogenic
#: lang/json/mutation_from_json.py
msgid ""
"Your system has adapted to radiation.  While irradiated, you will actually "
"heal slowly, converting the radiation into hit points."
msgstr ""
"A tested alkalmazkodott a sugárzáshoz. Amikor sugárzol, akkor lassan "
"gyógyulni kezdesz, és a sugárzási pontokat HP-vé alakítod át."

#: lang/json/mutation_from_json.py
msgid "Marloss Carrier"
msgstr "Marloss hordozó"

#. ~ Description for Marloss Carrier
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss berry, you can't get its scent out of your "
"nose, and you have a strong desire to try some seeds and...sap?"
msgstr ""
"Mióta megetted azt a Marloss bogyót, nem tudod kiűzni az illatát az "
"orrodból, és nagyon, nagyon szeretnél megint enni a magvakból és a... "
"nedvből?"

#: lang/json/mutation_from_json.py
msgid "Marloss Vessel"
msgstr "Marloss tartó"

#. ~ Description for Marloss Vessel
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss seed, you can't get its taste off of your "
"tongue, and you have a strong desire to try some berries and...sap?"
msgstr ""
"Mióta megetted azt a Marloss magvat, nem tudod elűzni az ízét az nyelvedről,"
" és nagyon, nagyon szeretnél megint enni a bogyókból és a... nedvből?"

#: lang/json/mutation_from_json.py
msgid "Marloss Vector"
msgstr "Marloss vektor"

#. ~ Description for Marloss Vector
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you ate that Marloss jelly, you can't stop thinking of it, and "
"you have a strong desire to eat some seeds and berries."
msgstr ""
"ióta megetted azt a Marloss zselét, nem tudsz másra gondolni, és nagyon, "
"nagyon szeretnél enni a magvakból és a bogyóból."

#: lang/json/mutation_from_json.py
msgid "Marloss Rejection"
msgstr "Marloss kilökés"

#. ~ Description for Marloss Rejection
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you had that life-threatening reaction to that Marloss junk, you "
"can't bear the thought of ever eating it again!"
msgstr ""
"Mióta olyan életveszélyesen reagált a tested arra a Marloss szemétre, azóta "
"nem bírod annak a gondolatát sem elviselni, hogy megint egyél belőle."

#: lang/json/mutation_from_json.py
msgid "Mutagenic Aversion"
msgstr "Mutagén viszolygás"

#. ~ Description for Mutagenic Aversion
#: lang/json/mutation_from_json.py
msgid ""
"Ever since you had that life-threatening reaction to those mutagen and "
"purifier things, you can't bear the thought of ever using them again!"
msgstr ""
"Mióta olyan életveszélyesen reagált a tested azokra a mutagénekre és "
"tisztítószérumokra, azóta nem bírod annak a gondolatát sem elviselni, hogy "
"megint egyél belőlük."

#: lang/json/mutation_from_json.py
msgid "Insect Pheromones"
msgstr "Rovar feromon"

#. ~ Description for Insect Pheromones
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces low-level pheromones, identifying you as a friend to many"
" species of insects.  Insects will attack you much less."
msgstr ""
"A tested alacsony szintű feromont termel, amely számos rovarféle számara "
"barátként azonosít. A rovarok sokkal kevesebbszer fognak megtámadni."

#: lang/json/mutation_from_json.py
msgid "Mammal Pheromones"
msgstr "Emlős feromon"

#. ~ Description for Mammal Pheromones
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces low-level pheromones which put mammals at ease.  They "
"will be less likely to attack or flee from you."
msgstr ""
"A tested alacsony szintű feromont termel, amely megnyugtatja az emlősöket. "
"Sokkal kevésbé fognak megtámadni vagy elmenekülni előled."

#: lang/json/mutation_from_json.py
msgid "Disease Immune"
msgstr "Betegségre immunis"

#. ~ Description for Disease Immune
#: lang/json/mutation_from_json.py
msgid ""
"Your body is simply immune to diseases.  You will never catch an ambient "
"disease."
msgstr ""
"A tested egyszerűen immunis a betegségekre. Soha nem fogsz környezeti "
"betegséget elkapni."

#: lang/json/mutation_from_json.py
msgid "Infection Resistant"
msgstr "Fertőzés ellenálló"

#. ~ Description for Infection Resistant
#: lang/json/mutation_from_json.py
msgid ""
"Your immune system is particularly good at resisting infections.  You have "
"an increased chance for bad wounds and infections to heal on their own, and "
"only suffer reduced penalties from them."
msgstr ""
"Az immunrendszered kifejezetten jól áll ellen a fertőzéseknek. Nagyobb "
"eséllyel gyógyulnak be maguktól a súlyos sérülések és fertőzések, és "
"kevesebb hátránnyal is járnak."

#: lang/json/mutation_from_json.py
msgid "Infection Immune"
msgstr "Fertőzésre immunis"

#. ~ Description for Infection Immune
#: lang/json/mutation_from_json.py
msgid ""
"Your bloodstream has developed antibiotic properties.  Your wounds will "
"never become infected."
msgstr ""
"A vérkeringésed antibiotikumos hatást fejlesztett ki. A sebesüléseid soha "
"nem fognak elfertőződni."

#: lang/json/mutation_from_json.py
msgid "Mycus Identity"
msgstr "Mycus identitás"

#. ~ Description for Mycus Identity
#: lang/json/mutation_from_json.py
msgid ""
"We have synchronized our local physiology with that of the Mycus.  Any "
"spores we may encounter will not attempt to germinate inside the local "
"system, and we may traverse Mycus biospheres easily, as native bioforms "
"shift shape to accommodate us."
msgstr ""
"A helyi fiziológiát összhangba hoztuk a mycusszal. Bármilyen spórával is "
"találkozunk, azok nem próbálkoznak meg szaporodni a helyi rendszerben. "
"Könnyen haladhatunk át a mycus bioszféráin, a bennszülött bioformák hozzánk "
"alkalmazkodva alakot változtatnak."

#: lang/json/mutation_from_json.py
msgid "Parasite Immune"
msgstr "Parazitákra immunis"

#. ~ Description for Parasite Immune
#: lang/json/mutation_from_json.py
msgid ""
"Your body is unusually inhospitable to parasitic lifeforms.  You will never "
"become infested with internal parasites."
msgstr ""
"A tested szokatlanul barátságtalan közeg a parazita életformák számára. Soha"
" nem lesz benned belső parazita."

#: lang/json/mutation_from_json.py
msgid "Venomous"
msgstr "Mérgező"

#. ~ Description for Venomous
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces a potent venom.  Cutting or stabbing attacks from "
"mutations have a chance to poison your target."
msgstr ""
"Tested erős mérget termel. Mutációkból származó vágó vagy szúró támadások a "
"sebzés mellett meg is tudják mérgezni az ellenfeled."

#: lang/json/mutation_from_json.py
msgid "Strongly Venomous"
msgstr "Erősen mérgező"

#. ~ Description for Strongly Venomous
#: lang/json/mutation_from_json.py
msgid ""
"Your venom has become particularly strong.  You're confident that your bites"
" or other cutting/stabbing natural attacks will take your target down "
"quickly."
msgstr ""
"A tested által termelt méreg még erősebbé vált. Biztos vagy abban, hogy a "
"harapásod, illetve a vágó és szúró természetes támadásaid gyorsan végeznek "
"az ellenfeleddel."

#: lang/json/mutation_from_json.py
msgid "Slime Hands"
msgstr "Nyálkás kéz"

#. ~ Description for Slime Hands
#: lang/json/mutation_from_json.py
msgid ""
"The skin on your hands is a mucous membrane and produces a thick, acrid "
"slime.  Attacks using your hand will cause minor acid damage.  Slightly "
"increases wet benefits."
msgstr ""
"A kezed bőre nyálkahártyává változott, amely egy nyúlós, savas nyálkát "
"termel. Puszta kézzel bevitt támadásaid kismértékben savas sebzést is "
"okoznak. Némileg javítja az ázottság hatásait."

#: lang/json/mutation_from_json.py
msgid "Stretchy Limbs"
msgstr "Nyúlós végtagok"

#. ~ Description for Stretchy Limbs
#: lang/json/mutation_from_json.py
msgid "Your limbs seem to have a little more 'give' to them.  +1 Dexterity."
msgstr "A végtagjaid mintha még messzebbre nyúlnának. +1 ügyesség."

#: lang/json/mutation_from_json.py
msgid "Rubbery Limbs"
msgstr "Gumiszerű végtagok"

#. ~ Description for Rubbery Limbs
#: lang/json/mutation_from_json.py
msgid ""
"Your limbs are significantly more flexible than any pathetic human arm or "
"leg.  +3 Dexterity, -2 Strength."
msgstr ""
"A végtagjaid lényegesen rugalmasabbak bármilyen szánalmas emberi karnál vagy"
" lábnál. +3 ügyesség, -2 erő."

#: lang/json/mutation_from_json.py
msgid "Pseudolimbs"
msgstr "Lábszerű nyúlványok"

#. ~ Description for Pseudolimbs
#: lang/json/mutation_from_json.py
msgid ""
"Your pseudopod-like limbs can fit into anything!  +4 Dexterity, -4 Strength."
msgstr "A lábszerű nyúlványaid szinte bárhova beférnek! +4 ügyesség, -4 erő."

#: lang/json/mutation_from_json.py
msgid "Compound Eyes"
msgstr "Összetett szem"

#. ~ Description for Compound Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes are compound, like those of an insect.  This increases your "
"Perception by 2 so long as you aren't wearing eyewear."
msgstr ""
"Rovarhoz hasonló, összetett szemed van. Érzékelésed 2-vel nő, ha nincs a "
"szemed előtt semmiféle szemüveg."

#: lang/json/mutation_from_json.py
msgid "Padded Feet"
msgstr "Párnázott láb"

#. ~ Description for Padded Feet
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"The bottoms of your feet are strongly padded.  You receive no movement "
"penalty for not wearing shoes, and even receive a 10% bonus when moving "
"barefoot."
msgstr ""
"A talpad erősen párnázott. Semmiféle mozgási hátrányt sem szenvedsz, ha "
"nincs rajtad cipő, és még egy 10%-os bónuszt is kapsz, ha mezítláb haladsz. "
"Némileg csökkenti az ázottság negatív hatásait."

#: lang/json/mutation_from_json.py
msgid "Toe Talons"
msgstr "Lábujj karom"

#. ~ Description for Toe Talons
#: lang/json/mutation_from_json.py
msgid ""
"You have grown large, curved, and wickedly sharp talons in place of your big"
" toes.  Fortunately, they don't get in the way of your movement.  "
"Unfortunately, they do prevent wearing footgear."
msgstr ""
"A nagylábujjaid helyére hosszú, görbe és nagyon éles karmokat növesztettél. "
"Szerencsére a mozgásban nem zavar. Sajnos azonban cipőt sem tudsz ezért "
"hordani, ami viszont már zavaróbb."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You slash %s with a talon"
msgstr "Karmoddal belevágsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s slashes %2$s with a talon"
msgstr "%1$s karmával belevág %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Hooves"
msgstr "Patás"

#. ~ Description for Hooves
#: lang/json/mutation_from_json.py
msgid ""
"Your feet have fused into hooves.  This allows kicking attacks to do much "
"more damage, provides natural armor, and removes the need to wear shoes; "
"however, you cannot wear shoes of any kind.  Reduces wet effects."
msgstr ""
"A lábfejed patává alakult át. A rúgási támadásaid sokkal több sérülést "
"okoznak, a paták természetes páncélként megvédenek, és nem is muszáj cipőt "
"hordanod. Igaz, nem is lehet cipőd hordanod. Csökkenti az ázottság negatív "
"hatásait."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You kick %s with your hooves"
msgstr "A patáddal belerúgsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s kicks %2$s with their hooves"
msgstr "%1$s patájával belerúg %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Alcohol Metabolism"
msgstr "Alkohol metabolizmus"

#. ~ Description for Alcohol Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"So it's fermented?  Whatever, it's still good drinking.  You've developed "
"the ability to metabolize alcohol as a food source."
msgstr ""
"Ja, hogy erjesztéssel készül? Mindegy, biztos jó pia. Kifejlesztetted azt a "
"képességet, hogy az alkoholt ételforrásként hasznosítsd."

#: lang/json/mutation_from_json.py
msgid "Subterranean Fortitude"
msgstr "Földalatti erő"

#. ~ Description for Subterranean Fortitude
#: lang/json/mutation_from_json.py
msgid "The aches and pains of living underground don't bother you as much."
msgstr "A földalatti lét fájdalmai és macerái nem is zavarnak már annyira."

#: lang/json/mutation_from_json.py
msgid "Subterranean Build"
msgstr "Földalatti testfelépítés"

#. ~ Description for Subterranean Build
#: lang/json/mutation_from_json.py
msgid ""
"Your frame has adapted for life in confined spaces.  You seem a little "
"shorter and bulkier, trading muscle mass for mobility.  (+2 Strength, -2 "
"Dexterity)"
msgstr ""
"A tested alkalmazkodott a szűk körülményekhez. Alacsonyabb és zömökebb "
"lettél, izomtömegedet mozgásra cserélted (+2 erő, -2 ügyesség)"

#: lang/json/mutation_from_json.py
msgid "Saprovore"
msgstr "Szaprotróf"

#. ~ Description for Saprovore
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive system is specialized to allow you to consume decaying "
"material.  You can eat rotten food, albeit for less nutrition than usual."
msgstr ""
"Az emésztőrendszered felkészült rothadó táplálék befogadására. Megeheted a "
"rohadt ételt, bár a szokásosnál kevésbé lesz tápláló."

#: lang/json/mutation_from_json.py
msgid "Saprophage"
msgstr "Szaprofág"

#. ~ Description for Saprophage
#: lang/json/mutation_from_json.py
msgid ""
"You prefer to sustain yourself using your roots and direct nutrient "
"extraction/synthesis.  You can still consume 'food', though, if you have to:"
" you merely prefer it aged a little."
msgstr ""
"A gyökereid illetve közvetlen tápanyag kitermelés és szintézis által "
"szeretsz leginkább táplálkozni. Még mindig képes vagy ételfogyasztásra, ha "
"nagyon muszáj - de jobban szereted, ha az egy kicsit túlérett."

#: lang/json/mutation_from_json.py
msgid "Gizzard"
msgstr "Zúza"

#. ~ Description for Gizzard
#: lang/json/mutation_from_json.py
msgid ""
"You seem to get full faster now, and food goes through you more rapidly as "
"well."
msgstr "Gyorsabban laksz jól, és az étel is gyorsabban fut át rajtad"

#: lang/json/mutation_from_json.py
msgid "Mycus Feeder"
msgstr "Mycus táplálék"

#. ~ Description for Mycus Feeder
#: lang/json/mutation_from_json.py
msgid ""
"We have streamlined our nutritional requirements.  We rely on the Mycus for "
"sustenance, as it relies on us.  We may locate sources of sustenance within "
"the close proximity of Mycus core towers, and in forested areas that the "
"Mycus has grown into."
msgstr ""
"Áramvonalasítottuk a táplálkozási igényeinket. Most már a mycus tart el "
"minket, ahogy a mi is őt. A mycus magtornyok közelében, valamint a mycus "
"által benőtt erdős területeken létfenntartási szükségleteinket kielégítő "
"forrásokra lelhetünk."

#: lang/json/mutation_from_json.py
msgid "Ruminant"
msgstr "Kérődző"

#. ~ Description for Ruminant
#: lang/json/mutation_from_json.py
msgid ""
"Your digestive system is capable of digesting cellulose and other rough "
"plant material.  You can eat underbrush and shrubs by activating this, "
"standing over your target, and pressing E."
msgstr ""
"Az emésztőrendszered felkészült a cellulóz és egyéb növényi anyag "
"befogadására. Aktiválása után megeheted a bokrokat és a cserjéket - elég "
"föléjük állni és megnyomni az Shift-E gombot."

#: lang/json/mutation_from_json.py
msgid "Grazer"
msgstr "Legelő"

#. ~ Description for Grazer
#: lang/json/mutation_from_json.py
msgid ""
"You're accustomed to eating plants directly, and can get nutrition from "
"grass as well as underbrush and shrubs.  Eat either one by activating this, "
"standing over your target, and pressing E."
msgstr ""
"Megszoktad, hogy közvetlenül lelegeled a növényeket, és a bokrokon és a "
"cserjéken túl már fűvel is tudsz táplálkozni. Aktiválása után elég föléjük "
"állni és megnyomni az Shift-E gombot."

#: lang/json/mutation_from_json.py
msgid "Intestinal Fortitude"
msgstr "Erősebb belek"

#. ~ Description for Intestinal Fortitude
#: lang/json/mutation_from_json.py
msgid ""
"Your guts have developed the ability to handle poisonous food.  Mostly."
msgstr ""
"Az emésztésed kifejlesztette a mérgező ételek befogadását. Úgy nagyjából."

#: lang/json/mutation_from_json.py
msgid "Eater Of The Dead"
msgstr "Hullaevő"

#. ~ Description for Eater Of The Dead
#: lang/json/mutation_from_json.py
msgid ""
"Eating rotting, long-dead flesh is good for the struggle, and safe--if still"
" completely unappealing--for you."
msgstr ""
"A túlélés szempontjából hasznos, és most már biztonságos is, rothadó, régóta"
" halott húst enni, még ha továbbra is teljesen undorító a dolog."

#: lang/json/mutation_from_json.py
msgid "Burrowing"
msgstr "Ásószervek"

#. ~ Description for Burrowing
#: lang/json/mutation_from_json.py
msgid ""
"Between your claws and teeth, you can tunnel through just about anything."
msgstr ""
"A fogaid és a karmaid segítségével szinten bármin át tudod magadat ásni."

#: lang/json/mutation_from_json.py
msgid "Saber Teeth"
msgstr "Kardfogú"

#. ~ Description for Saber Teeth
#: lang/json/mutation_from_json.py
msgid ""
"Your fangs have grown extremely large and incredibly sharp.  They make it "
"impossible to wear mouthgear and difficult to eat...  but leave nasty wounds"
" when you bite."
msgstr ""
"Az agyaraid elképesztően hosszúra és élesre nőttek. Sajnos ezért a szád elé "
"már semmit sem tehetsz fel, és még enni is nehéz... viszont nagyon csúnyát "
"tudsz harapni."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your saber teeth"
msgstr "A kardfogaddal kitépsz %s testéből egy darabot"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their saber teeth"
msgstr "%1$s a kardfogával kitép %2$s testéből egy darabot"

#: lang/json/mutation_from_json.py
msgid "Hyper-Metabolism"
msgstr "Hiper-metabolizmus"

#. ~ Description for Hyper-Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You metabolize nutrients so rapidly that you can convert food directly into "
"useful tissue.  Excess nutrition will convert to HP, rather than being "
"wasted.  Activate to skip prompt for overeating."
msgstr ""
"Annyira gyorsan vagy már képes metabolizálni a tápanyagot, hogy azt a tested"
" közvetlenül hasznos szövetté képes átalakítani. A jóllakottságon felüli "
"tápanyag nem vész el, hanem HP-vá alakul át."

#: lang/json/mutation_from_json.py
msgid "Horns"
msgstr "Szarvas"

#. ~ Description for Horns
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of small horns on your head.  They allow you to make a weak "
"piercing headbutt attack."
msgstr ""
"Egy pár apró szarv nőtt ki a homlokodból. Ha lefejelsz valakit, akkor gyenge"
" szúró sebzést okozhatsz."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You headbutt %s with your horns"
msgstr "A szarvaiddal lefejeled %s testét"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s headbutts %2$s with their horns"
msgstr "%1$s a szarvaival lefejeli %2$s testét"

#: lang/json/mutation_from_json.py
msgid "Curled Horns"
msgstr "Göndörödött szarvú"

#. ~ Description for Curled Horns
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large curled horns, like those of a ram.  They allow you "
"to make a strong bashing headbutt attack, but prevent wearing any headwear."
msgstr ""
"Koshoz hasonló görbe szarvad nőtt. Erős zúzó sebzést okozol, ha lefejelsz "
"valakit, viszont semmit sem tudsz felvenni a fejedre."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You headbutt %s with your curled horns"
msgstr "A göndör szarvaiddal lefejeled %s testét"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s headbutts %2$s with their curled horns"
msgstr "%1$s a göndör szarvaival lefejeli %2$s testét"

#: lang/json/mutation_from_json.py
msgid "Pointed Horns"
msgstr "Hegyes szarvú"

#. ~ Description for Pointed Horns
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of long, pointed horns, like those of an antelope.  They "
"allow you to make a strong piercing headbutt attack, but prevent wearing "
"headwear that is not made of fabric."
msgstr ""
"Antilophoz hasonló hosszú, hegyes szarvad nőtt. Erős szúró sebzést okozol, "
"ha lefejelsz valakit, viszont semmit sem tudsz felvenni a fejedre, ami nem "
"textilből készült."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You stab %s with your pointed horns"
msgstr "A hegyes szarvaddal beledöfsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s stabs %2$s with their pointed horns"
msgstr "%1$s a hegyes szarvával beledöf %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Antlers"
msgstr "Agancsos"

#. ~ Description for Antlers
#: lang/json/mutation_from_json.py
msgid ""
"You have a huge rack of antlers, like those of a moose.  They allow you to "
"make a weak headbutt attack, but prevent wearing headwear that is not made "
"of fabric."
msgstr ""
"Jávorszarvashoz hasonló hatalmas szarvad nőtt. Gyenge sebzést okozol, ha "
"lefejelsz valakit, viszont semmit sem tudsz felvenni a fejedre, ami nem "
"textilből készült."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You butt %s with your antlers"
msgstr "Az agancsaiddal belefejelsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s butts %2$s with their antlers"
msgstr "%1$s az agancsaival belefejel %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Antennae"
msgstr "Csápok"

#. ~ Description for Antennae
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of antennae.  They allow you to detect the presence of "
"monsters up to a few tiles away, even if you can't see or hear them, but "
"prevent wearing headwear that is not made of fabric."
msgstr ""
"Egy pár csápot növesztettél, segítségükkel érzékelheted a pár lépésre "
"található szörnyeket még akkor is, ha amúgy nem is látod, és nem is hallod "
"őket. Viszont semmit sem tudsz felvenni a fejedre, ami nem textilből "
"készült."

#: lang/json/mutation_from_json.py
msgid "Road-Runner"
msgstr "Kengyelfutó"

#. ~ Description for Road-Runner
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your legs are extremely limber and fast-moving.  You move 30% faster on flat"
" surfaces."
msgstr ""
"Lábaid rendkívül hajlékonyak és gyorsan mozognak. Lapos felületeken 30%-kal "
"gyorsabban tudsz haladni."

#: lang/json/mutation_from_json.py
msgid "Stubby Tail"
msgstr "Rövid farok"

#. ~ Description for Stubby Tail
#: lang/json/mutation_from_json.py
msgid "You have a short, stubby tail, like a rabbit's.  It serves no purpose."
msgstr ""
"Hátul kinőtt egy rövid, zömök farkad, mint egy nyuszinak. Amúgy semmire se "
"jó."

#: lang/json/mutation_from_json.py
msgid "Tail Fin"
msgstr "Farokuszony"

#. ~ Description for Tail Fin
#: lang/json/mutation_from_json.py
msgid ""
"You have a fin-like tail.  It allows you to swim more quickly, but prevents "
"wearing non-fabric pants.  Slightly increases wet benefits."
msgstr ""
"Farokuszony-jellegű farkad nőtt, ezért gyorsabban tudsz úszni, viszont nem "
"tudsz textilen kívül más anyagból készült nadrágot hordani. Némileg növeli "
"az ázottság pozitív hatásait."

#: lang/json/mutation_from_json.py
msgid "Long Tail"
msgstr "Hosszú farok"

#. ~ Description for Long Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, graceful tail, like that of a big cat.  It improves your "
"balance, making your ability to dodge higher, but prevents wearing non-"
"fabric pants."
msgstr ""
"Hosszú, kecses farkad nőtt, mint egy macskának. Segít az egyensúlyod "
"megtartásában, ezért jobban tudsz kitérni a csapások elől, viszont nem tudsz"
" textilen kívül más anyagból készült nadrágot hordani."

#: lang/json/mutation_from_json.py
msgid "Cattle Tail"
msgstr "Szarvasmarha farok"

#. ~ Description for Cattle Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail with a tuft on the end.  You find yourself "
"instinctively swatting away flies with it, though it's not as effective at "
"balancing you as you'd like.  Prevents wearing non-fabric pants."
msgstr ""
"Hosszú, végén pamacsos farkad nőtt. Reflexként hajtod el magadról vele a "
"legyeket, bár egyensúlyozásra messze nem annyira hatékony, mint az "
"szeretnéd. Nem tudsz textilen kívül más anyagból készült nadrágot hordani."

#: lang/json/mutation_from_json.py
msgid "Rodent Tail"
msgstr "Rágcsáló farok"

#. ~ Description for Rodent Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long but hairless tail.  It's a pretty effective balancing aid, "
"but does look, uh, ratty.  Prevents wearing non-fabric pants."
msgstr ""
"Hosszú, csupasz farkad nőtt. Egyensúlyozásra teljesen megfelelő, de egy "
"kicsit olyan... patkányos. Nem tudsz textilen kívül más anyagból készült "
"nadrágot hordani."

#: lang/json/mutation_from_json.py
msgid "Thick Tail"
msgstr "Vastag farok"

#. ~ Description for Thick Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, thick, lizardlike tail.  It helps you balance a bit but "
"also makes a serviceable whip.  Prevents wearing non-fabric pants."
msgstr ""
"Hosszú, vastag, gyíkszerű farkad nőtt. Segít az egyensúlyod megtartásában, "
"és ostorként is egész jól hasznosítható. Nem tudsz textilen kívül más "
"anyagból készült nadrágot hordani."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You whap %s with your tail"
msgstr "A farkaddal belecsapsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s whaps %2$s with their tail"
msgstr "%1$s a farkával belecsap %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Raptor Tail"
msgstr "Raptor farok"

#. ~ Description for Raptor Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long and semi-stiff lizardlike tail.  You can't effectively lash "
"it in combat, but it significantly improves your balance.  Prevents wearing "
"non-fabric pants."
msgstr ""
"Hosszú, félig merev gyíkszerű farkad nőtt. Harc közben nem tudsz vele "
"hatékonyan ütni, de jelentősen javítja az egyensúlyodat. Nem tudsz textilen "
"kívül más anyagból készült nadrágot hordani."

#: lang/json/mutation_from_json.py
msgid "Fluffy Tail"
msgstr "Bundás farok"

#. ~ Description for Fluffy Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long, fluffy-furred tail.  It greatly improves your balance, "
"making your ability to dodge much higher.  Prevents wearing non-fabric "
"pants."
msgstr ""
"Hosszú, bundás farkad nőtt. Nagymértékben javítja az egyensúlyodat, sokkal "
"jobban ki tudsz térni az ütések elől. Amikor azonban boldog vagy, akkor "
"csóválod. Nem tudsz textilen kívül más anyagból készült nadrágot hordani."

#: lang/json/mutation_from_json.py
msgid "Spiked Tail"
msgstr "Tüskés farok"

#. ~ Description for Spiked Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail that ends in a vicious stinger, like that of a "
"scorpion.  It does not improve your balance at all, but allows for a "
"powerful piercing attack.  Prevents wearing non-fabric pants."
msgstr ""
"Hosszú, csúf fullánkban végződő farkad nőtt, mint egy skorpiónak. Nem "
"javítja az egyensúlyodat, de erős szúró támadásra képes. Nem tudsz textilen "
"kívül más anyagból készült nadrágot hordani."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You sting %s with your tail"
msgstr "A farkaddal beleszúrsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s stings %2$s with their tail"
msgstr "%1$s farkával beleszúr %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Club Tail"
msgstr "Buzogányos farok"

#. ~ Description for Club Tail
#: lang/json/mutation_from_json.py
msgid ""
"You have a long tail that ends in a heavy, bony club.  It does not improve "
"your balance at all, but allows for a powerful bashing attack.  Prevents "
"wearing non-fabric pants."
msgstr ""
"Hosszú, nehéz, csontos buzogányban végződő farkad nőtt. Nem javítja az "
"egyensúlyodat, de erős zúzó támadásra képes. Nem tudsz textilen kívül más "
"anyagból készült nadrágot hordani."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You club %s with your tail"
msgstr "A farkaddal belezúzol %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s clubs %2$s with their tail"
msgstr "%1$s a farkával belezúz %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Hibernation"
msgstr "Hibernálás"

#. ~ Description for Hibernation
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the ability to stockpile calories and then sleep for "
"extended periods of time."
msgstr ""
"Kifejlesztetted azt a képességet, hogy kalóriát halmozz fel magadban, majd "
"hosszú ideig tudjál aludni."

#: lang/json/mutation_from_json.py
msgid "Resilient"
msgstr "Ellenálló"

#. ~ Description for Resilient
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can survive injuries that would incapacitate humans: you get a 20% bonus"
" to all hit points.  Stacks with Tough, etc."
msgstr ""
"Olyan sérüléseket is képes vagy túlélni, amelyek egy embert ártalmatlanná "
"tennének - minden HP-d 20% bónuszt kap. Halmozódik a Kemény és a hasonló "
"képességekkel."

#: lang/json/mutation_from_json.py
msgid "Solidly Built"
msgstr "Szilárd felépítésű"

#. ~ Description for Solidly Built
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Not much scares you.  You get a 30% bonus to all hit points.  Stacks with "
"Tough, etc."
msgstr ""
"Semmitől sem félsz. Minden HP-d 30% bónuszt kap. Halmozódik a Kemény és a "
"hasonló képességekkel."

#: lang/json/mutation_from_json.py
msgid "TAAANK"
msgstr "TAAANK"

#. ~ Description for TAAANK
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You can simply take the punishment from lesser beings and keep going.  You "
"get a 40% bonus to all hit points.  Stacks with Tough, etc."
msgstr ""
"Lerázod magadról azokat a sérüléseket, amelyek egy erre kevésbe alkalmatlant"
" kicsinálnának. Minden HP-d 40% bónuszt kap. Halmozódik a Kemény és a "
"hasonló képességekkel."

#: lang/json/mutation_from_json.py
msgid "Pain Recovery"
msgstr "Fájdalommúlás"

#. ~ Description for Pain Recovery
#: lang/json/mutation_from_json.py
msgid "You recover from pain slightly faster than normal."
msgstr "A szokásosnál némileg gyorsabban múlik el a fájdalmad."

#: lang/json/mutation_from_json.py
msgid "Quick Pain Recovery"
msgstr "Gyors fájdalommúlás"

#. ~ Description for Quick Pain Recovery
#: lang/json/mutation_from_json.py
msgid "You recover from pain faster than normal."
msgstr "A szokásosnál gyorsabban múlik el a fájdalmad."

#: lang/json/mutation_from_json.py
msgid "Very Quick Pain Recovery"
msgstr "Nagyon gyors fájdalommúlás"

#. ~ Description for Very Quick Pain Recovery
#: lang/json/mutation_from_json.py
msgid "You recover from pain much faster than normal."
msgstr "A szokásosnál sokkal gyorsabban múlik el a fájdalmad."

#: lang/json/mutation_from_json.py
msgid "Pain Junkie"
msgstr "Fájdalom junkie"

#. ~ Description for Pain Junkie
#: lang/json/mutation_from_json.py
msgid ""
"You've developed a serious appetite for pain, and take pride in your scars."
msgstr "Rákaptál a fájdalom ízére, és büszkén mutogatod a hegeidet."

#: lang/json/mutation_from_json.py
msgid "Cenobite"
msgstr "Cenobita"

#. ~ Description for Cenobite
#: lang/json/mutation_from_json.py
msgid "You positively adore pain, in all its varied forms."
msgstr "Egyszerűen imádod a fájdalmat, és annak minden formáját."

#: lang/json/mutation_from_json.py
msgid "Deadened"
msgstr "Eltompult"

#. ~ Description for Deadened
#: lang/json/mutation_from_json.py
msgid ""
"Nothing hurts any more.  Those bites tickle and the wounds itch a bit, but "
"that's it."
msgstr "Már semmi sem fáj. A harapás csikiz, a sebek viszketnek, de ennyi."

#: lang/json/mutation_from_json.py
msgid "Pain Sensitive"
msgstr "Fájdalomra érzékeny"

#. ~ Description for Pain Sensitive
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"For some reason things always seem to hurt you more.  Pain dealt to you is "
"increased by 25%."
msgstr "Valamiért minden jobban fáj. A téged ért fájdalom 25%-kal nő."

#: lang/json/mutation_from_json.py
msgid "Hyperalgesia"
msgstr "Hiperalgézia"

#. ~ Description for Hyperalgesia
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your body experiences pain out of proportion to the physical causes.  Pain "
"dealt to you is increased by 50%."
msgstr ""
"A tested a forrásától elvárható mértékkel szemben sokkal nagyobb fájdalmat "
"érzékel. A téged ért fájdalom 50%-kal nő."

#: lang/json/mutation_from_json.py
msgid "Extreme Hyperalgesia"
msgstr "Extrém hiperalgézia"

#. ~ Description for Extreme Hyperalgesia
#: lang/json/mutation_from_json.py
msgid ""
"Your body reacts cripplingly to any source of pain.  Pain dealt to you is "
"doubled."
msgstr ""
"Tested bénítóan reagál minden fájdalomra. A téged ért fájdalom duplán "
"számít."

#: lang/json/mutation_from_json.py
msgid "Culler"
msgstr "Selejtező"

#. ~ Description for Culler
#: lang/json/mutation_from_json.py
msgid ""
"You've had a revelation: by killing the weaker creatures, who would only die"
" anyway, you preserve resources for those better able to survive.  You are "
"less bothered by the deaths of others: their own weakness invited these "
"fates upon them."
msgstr ""
"Megvilágosodtál: ha megölöd a gyengébb lényeket, akik amúgy is csak "
"meghaltak volna, akkor azzal megőrzöd az erőforrásokat azok számára, akik "
"jobban képesek a túlélésre. Mások halála kevésbé zavar, hiszen az a sors "
"gyengeségüknél fogva nekik volt szánva."

#: lang/json/mutation_from_json.py lang/json/npc_class_from_json.py
#: lang/json/npc_from_json.py
msgid "Hunter"
msgstr "Vadász"

#. ~ Description for Hunter
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has a lot more in common with a predatory animal than a human, "
"making it easier to control misplaced reactions to the death of your prey.  "
"Additionally, combat skills, which you use to hunt, are easier to learn and "
"maintain."
msgstr ""
"Az agyad jobban hasonlít egy ragadozó állatéra, mint egy emberére, és így a "
"zsákmány halálával kapcsolatos érzelmeidet jobban tudod irányításod alatt "
"tartani. Ezen túl a vadászatnál használt harci készségeidet könnyebb "
"megszerezni és megtartani."

#: lang/json/mutation_from_json.py
msgid "Predator"
msgstr "Ragadozó"

#. ~ Description for Predator
#: lang/json/mutation_from_json.py
msgid ""
"You consider yourself something other than human and no longer empathize "
"with them.  Combat skills are easy to learn and maintain, but your critical "
"thinking, so characteristic to these creatures, suffers."
msgstr ""
"Már nem tartod magadat embernek, és ezért nem is érzel velük együtt. A harci"
" készségeidet könnyebb megszerezni és megtartani, de az emberi lényekre "
"jellemző kritikus gondolkodás elsorvad."

#: lang/json/mutation_from_json.py
msgid "Apex Predator"
msgstr "Csúcsragadozó"

#. ~ Description for Apex Predator
#: lang/json/mutation_from_json.py
msgid ""
"Your mind and brain have adapted to your new place in the world: as one on "
"top of the food chain.  You can effortlessly master and maintain combat "
"skills, but your critical thinking has atrophied further."
msgstr ""
"Elméd és agyad teljesen alkalmazkodott a világban betöltött új helyedhez, a "
"tápláléklánc csúcsához. Erőfeszítés nélkül tudod a harci készségeidet "
"megszerezni és megtartani, de a kritikus gondolkodás még jobban elsorvadt."

#: lang/json/mutation_from_json.py
msgid "Sapiovore"
msgstr "Sapiensevő"

#. ~ Description for Sapiovore
#: lang/json/mutation_from_json.py
msgid "The hairless apes make as good eating as any other meat."
msgstr ""
"A csupasz majmot legalább annyira jó megenni, mint bármilyen más húst."

#: lang/json/mutation_from_json.py
msgid "Mycus Defender"
msgstr "Mycus védelmező"

#. ~ Description for Mycus Defender
#: lang/json/mutation_from_json.py
msgid ""
"From time to time the Mycus requires protection from non-Mycus that, for "
"whatever reason, wish it ill.  We have adapted to better carry out this task"
" - our fibers will grow strong and resilient when such threats present "
"themselves to us."
msgstr ""
"Időről időre a mycus védelmet igényel egy olyan nem-mycus ellen, amely "
"valamilyen oknál fogva le szeretné betegíteni. Átalakultunk, hogy jobban "
"tudjuk ezt a feladatot teljesíteni. Rostjain erősre és ellenállóvá "
"erősödnek, amikor egy ilyen fenyegetéssel kerülünk szembe."

#: lang/json/mutation_from_json.py
msgid "Bird Wings"
msgstr "Madárszárnyú"

#. ~ Description for Bird Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, feathered wings.  Your body is too heavy to be "
"able to fly, but you can use them to slow your descent during a fall, and "
"will not take falling damage under any circumstances."
msgstr ""
"Egy pár nagy, tollas szárnyat növesztettél. A tested túl nehéz a repüléshez,"
" de legalább a zuhanás sebességét csökkenti, így bármilyen magasról esel le,"
" nem fogsz megsérülni."

#: lang/json/mutation_from_json.py
msgid "Insect Wings"
msgstr "Bogárszárnyú"

#. ~ Description for Insect Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, translucent wings.  They are too small to lift "
"you, but are powerful enough to greatly speed your movement, with some "
"effort and noise."
msgstr ""
"Egy pár nagyméretű, áttetsző szárnyat növesztettél. Levegőbe emelésedhez "
"azonban túl kicsik, de ahhoz elég erősek, hogy némi erőfeszítés és zaj által"
" gyorsítsák a mozgásodat."

#: lang/json/mutation_from_json.py
msgid "Mouth Tentacles"
msgstr "Szájcsápok"

#. ~ Description for Mouth Tentacles
#: lang/json/mutation_from_json.py
msgid ""
"A set of tentacles surrounds your mouth.  They allow you to eat twice as "
"fast.  Slightly decreases wet penalties."
msgstr ""
"Szájadat egy pár csáp veszi körül, ezért kétszer gyorsabban tudsz enni. "
"Némileg csökkenti az ázottsággal járó hátrányokat."

#: lang/json/mutation_from_json.py
msgid "Mandibles"
msgstr "Csáprágó"

#. ~ Description for Mandibles
#: lang/json/mutation_from_json.py
msgid ""
"A set of insect-like mandibles have grown around your mouth.  They allow you"
" to eat faster and provide a slicing unarmed attack, but prevent wearing "
"mouthwear.  Slightly reduces wet effects."
msgstr ""
"A szád körül rovarszerű csáprágók nőttek ki. Gyorsabban tudsz enni, és "
"puszta kezes támadásnál vágó sebzést okoznak, viszont semmit sem tehetsz a "
"szád elé. Némileg csökkenti az ázottság negatív hatásait."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite %s with your fangs"
msgstr "A méregfogaiddal beleharapsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites %2$s with their fangs"
msgstr "%1$s a méregfogaival beleharap %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Folding Fangs"
msgstr "Behajtható méregfogak"

#. ~ Description for Folding Fangs
#: lang/json/mutation_from_json.py
msgid ""
"Your mandibles have developed extensible fangs, allowing you to bite quickly"
" or ensure your venom goes home, as desired."
msgstr ""
"A csáprágóidból behajtható méregfogak alakultak ki, így gyorsan tudsz "
"harapni, illetve a másikat megmérgezni."

#: lang/json/mutation_from_json.py
msgid "Canine Ears"
msgstr "Kutyafülű"

#. ~ Description for Canine Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have extended into long, pointed ones, like those of a canine.  "
"They enhance your hearing, allowing you to hear at greater distances."
msgstr ""
"Füleid hosszú, hegyes, kutyaféle formává nőtték ki magukat. Hallásod még "
"jobb lett, messzebbről hallasz hangokat."

#: lang/json/mutation_from_json.py
msgid "Lupine Ears"
msgstr "Farkasfülű"

#. ~ Description for Lupine Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your hearing has evolved further and is now on par with wolves.  You can "
"hear things significantly farther away."
msgstr ""
"A hallásod újabb evolúciós lépcsőfokot ért el, és most már a farkasokéval "
"van egy szinten. Lényegesen távolabbi hangokat is meghallasz."

#: lang/json/mutation_from_json.py
msgid "Feline Ears"
msgstr "Macskafülű"

#. ~ Description for Feline Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have extended into long, pointed, velvety ones, like those of a "
"feline.  You find it easier to tune in on sounds from afar."
msgstr ""
"Füleid hosszú, hegyes, puha formává nőtték ki magukat, mint egy macskáé. "
"Hallásod még jobb lett, messzebbről hallasz hangokat."

#: lang/json/mutation_from_json.py
msgid "Ursine Ears"
msgstr "Medvefülű"

#. ~ Description for Ursine Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears have grown longer and rounder, much like those of a bear.  You can"
" hear things a little farther away."
msgstr ""
"Füleid nagyobb, kerekebb, medveféle formává nőtték ki magukat. Hallásod még "
"jobb lett, egy kicsit távolabbról hallasz hangokat."

#: lang/json/mutation_from_json.py
msgid "Pointed Ears"
msgstr "Hegyes fülű"

#. ~ Description for Pointed Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your upper earlobes have grown noticeably higher.  Fortunately, they don't "
"get in the way of your headgear, much.  Unfortunately, they also don't seem "
"to help your hearing any."
msgstr ""
"A felső fülcimpád határozottan hosszabbra nőtt. Szerencsére nem került még a"
" fejfedőd útjába. Sajnos ettől még nem hallasz jobban."

#: lang/json/mutation_from_json.py
msgid "Rodent Ears"
msgstr "Rágcsáló fülek"

#. ~ Description for Rodent Ears
#: lang/json/mutation_from_json.py
msgid ""
"Your ears are huge, round, and gray!  They're rather fascinating, and help "
"you hear from a much greater distance."
msgstr ""
"A füleid hatalmasra nőttek, kerekek és szürkék! Nagyon érdekes látvány, és "
"sokkal messzebbre hallasz velük."

#: lang/json/mutation_from_json.py
msgid "Web Walker"
msgstr "Hálójáró"

#. ~ Description for Web Walker
#: lang/json/mutation_from_json.py
msgid ""
"Your body excretes very fine amounts of a chemical which prevents you from "
"sticking to webs.  Walking through webs does not affect you at all."
msgstr ""
"A tested egy furcsa vegyi anyagot választ ki, amelynek köszönhetően nem "
"ragadsz bele a pókhálókba, gond nélkül át tudsz rajtuk sétálni."

#: lang/json/mutation_from_json.py
msgid "Web Spinner"
msgstr "Hálógyártó"

#. ~ Description for Web Spinner
#: lang/json/mutation_from_json.py
msgid ""
"Your body produces and anchors webbing.  Too bad you can't seem to control "
"the process.  There is a chance that you will leave webs in your wake."
msgstr ""
"A tested pókháló készítésére és rögzítésére alkalmas vegyi anyagot választ "
"ki. Sajnos maga az eljárás teljesen tudatalatti, számodra irányíthatatlan. "
"Néha ezért pókhálót hagysz magad mögött."

#: lang/json/mutation_from_json.py
msgid "Web Weaver"
msgstr "Hálószövő"

#. ~ Description for Web Weaver
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the necessary anatomy and techniques to control your web-"
"generation.  Activate this to start or stop weaving webs."
msgstr ""
"Tested kifejlesztette a pókhálók tudatosan vezérelt szövéséhez szükséges "
"testrészeket és technikákat. Háló szövéséhez vagy megerősítéséhez aktiválnod"
" kell."

#: lang/json/mutation_from_json.py
msgid "Web Diver"
msgstr "Hálómászó"

#. ~ Description for Web Diver
#: lang/json/mutation_from_json.py
msgid ""
"Your webbing is easily strong enough to support your weight.  You'll use it "
"to descend down any sheer drops you may encounter."
msgstr ""
"A hálód elég erőssé vált ahhoz, hogy az egész testsúlyodat megtartsa. "
"Segítségével bármilyen meredekségen lemászhatsz."

#: lang/json/mutation_from_json.py
msgid "Rope Webs"
msgstr "Hálókötél"

#. ~ Description for Rope Webs
#: lang/json/mutation_from_json.py
msgid ""
"With spinnerets like THESE, who needs rope?!  Activate to produce rope."
msgstr ""
"Ilyen hálókészítő mirigyekkel kinek van szüksége kötélre? Aktiválásával "
"kötelet állítasz elő."

#: lang/json/mutation_from_json.py
msgid "You spin a rope from your silk."
msgstr "A selymedbõl kötelet fonsz."

#: lang/json/mutation_from_json.py
msgid "Whiskers"
msgstr "Bajszos"

#. ~ Description for Whiskers
#: lang/json/mutation_from_json.py
msgid ""
"You have a handsome set of feline whiskers around your mouth.  These make "
"you more aware of vibrations in the air, and improve your ability to dodge "
"very slightly."
msgstr ""
"A szád körül csinos, macskaféle bajuszkák nőttek ki. Ezek a legkisebb "
"légmozgást is érzékelik, ezért nagyon kis mértékben növelik a kitérési "
"képességedet."

#: lang/json/mutation_from_json.py
msgid "Wiry Whiskers"
msgstr "Drótbajusz"

#. ~ Description for Wiry Whiskers
#: lang/json/mutation_from_json.py
msgid ""
"You have a set of prominent rodent-like whiskers around your mouth.  These "
"make you more aware of vibrations in the air, and improve your ability to "
"dodge slightly."
msgstr ""
"A szád körül szembetűnő, rágcsálóféle bajuszkák nőttek ki. Ezek a legkisebb "
"légmozgást is érzékelik, ezért nagyon kis mértékben növelik a kitérési "
"képességedet."

#: lang/json/mutation_from_json.py
msgid "Fat Deposits"
msgstr "Zsírlerakódás"

#. ~ Description for Fat Deposits
#: lang/json/mutation_from_json.py
msgid ""
"You've put on some additional weight around your body.  It slows you down a "
"little, but helps your swimming and warmth."
msgstr ""
"Némi extra súlyt szereztél be, és ez lerakódott a testeden. Egy kicsit "
"lelassít, de segít az úszással és a tested melegen tartásával."

#: lang/json/mutation_from_json.py
msgid "Inconveniently Large"
msgstr "Kényelmetlenül nagy"

#. ~ Description for Inconveniently Large
#: lang/json/mutation_from_json.py
msgid ""
"You have grown noticeably taller and broader.  Much of it is useful muscle "
"mass (Strength +2), but you find it throws off your balance and you get in "
"your own way (+10 torso and arm encumbrance)."
msgstr ""
"Feltűnően magasabbra és szélesebbre nőttél. A plusz testtömeg nagy része "
"izom (+2 erő), de a rengeteg hús miatt nehezebben tudsz mozogni (+10 törzs "
"és kar ormótlanság)."

#: lang/json/mutation_from_json.py
msgid "Large"
msgstr "Nagy"

#. ~ Description for Large
#: lang/json/mutation_from_json.py
msgid "You carry your rugged body with the dignity you deserve.  Strength +2."
msgstr "Kigyúrt testedet az azt megillető méltósággal hordozod. +2 erő."

#: lang/json/mutation_from_json.py
msgid "Freakishly Huge"
msgstr "Torzultan hatalmas"

#. ~ Description for Freakishly Huge
#: lang/json/mutation_from_json.py
msgid ""
"You have grown even more massive, to the point where you cannot usefully fit"
" into human-sized clothing or vehicles.  Much of it is powerful muscle mass "
"(Strength +4), but it's a real pain to haul around."
msgstr ""
"Egyre nagyobbra nősz, méghozzá akkorára, hogy emberi méretű ruhába és "
"járművekbe már be sem férsz. A hatalmas tested nagy része izom (+4 erő), de "
"rém macerás ez az egész."

#: lang/json/mutation_from_json.py
msgid "Huge"
msgstr "Hatalmas"

#. ~ Description for Huge
#: lang/json/mutation_from_json.py
msgid ""
"Your cardiovascular system has caught up with your muscular physique, so who"
" needs pathetic human cars?  Strength +4."
msgstr ""
"A kardiovaszkuláris rendszered utolérte az izmos tested növekedését, úgyhogy"
" minek is kell már kocsi? +4 erő."

#: lang/json/mutation_from_json.py
msgid "Strong"
msgstr "Erős"

#. ~ Description for Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are a little stronger.  Strength + 1"
msgstr "Az izmaid egy kicsit erősebbek. +1 erő."

#: lang/json/mutation_from_json.py
msgid "Very Strong"
msgstr "Nagyon erős"

#. ~ Description for Very Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are stronger.  Strength + 2"
msgstr "Az izmaid erősebbek. +2 erő."

#: lang/json/mutation_from_json.py
msgid "Extremely Strong"
msgstr "Rendkívül erős"

#. ~ Description for Extremely Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are much stronger.  Strength + 4"
msgstr "Az izmaid sokkal erősebbek. +4 erő."

#: lang/json/mutation_from_json.py
msgid "Insanely Strong"
msgstr "Elképesztően erős"

#. ~ Description for Insanely Strong
#: lang/json/mutation_from_json.py
msgid "Your muscles are noticeably bulging.  Strength + 7"
msgstr "Az izmaid láthatóan erőtől duzzadnak. +7 erő."

#: lang/json/mutation_from_json.py
msgid "Prime Strength"
msgstr "Prímán erős"

#. ~ Description for Prime Strength
#: lang/json/mutation_from_json.py
msgid "Your muscles are perfectly developed."
msgstr "Az izmaid a tökéletességig ki lettek dolgozva."

#: lang/json/mutation_from_json.py
msgid "Dextrous"
msgstr "Ügyes"

#. ~ Description for Dextrous
#: lang/json/mutation_from_json.py
msgid "You are a little nimbler.  Dexterity + 1"
msgstr "Egy kicsit fürgébb vagy. +1 ügyesség."

#: lang/json/mutation_from_json.py
msgid "Very Dextrous"
msgstr "Nagyon ügyes"

#. ~ Description for Very Dextrous
#: lang/json/mutation_from_json.py
msgid "You are nimbler.  Dexterity + 2"
msgstr "Fürgébb vagy. +2 ügyesség."

#: lang/json/mutation_from_json.py
msgid "Extremely Dextrous"
msgstr "Rendkívül ügyes"

#. ~ Description for Extremely Dextrous
#: lang/json/mutation_from_json.py
msgid "You are nimble and quick.  Dexterity + 4"
msgstr "Fürgébb és gyorsabb vagy. +4 ügyesség."

#: lang/json/mutation_from_json.py
msgid "Insanely Dextrous"
msgstr "Elképesztően ügyes"

#. ~ Description for Insanely Dextrous
#: lang/json/mutation_from_json.py
msgid "You are much nimbler than before.  Dexterity + 7"
msgstr "Sokkal fürgébb vagy, mint korábban. +7 ügyesség."

#: lang/json/mutation_from_json.py
msgid "Prime Dexterity"
msgstr "Prímán ügyes"

#. ~ Description for Prime Dexterity
#: lang/json/mutation_from_json.py
msgid "You're perfectly coordinated."
msgstr "Tökéletesen összehangolt a mozgásod."

#: lang/json/mutation_from_json.py
msgid "Smart"
msgstr "Okos"

#. ~ Description for Smart
#: lang/json/mutation_from_json.py
msgid "You are a little smarter.  Intelligence + 1"
msgstr "Egy kicsit okosabb vagy. +1 intelligencia."

#: lang/json/mutation_from_json.py
msgid "Very Smart"
msgstr "Nagyon okos"

#. ~ Description for Very Smart
#: lang/json/mutation_from_json.py
msgid "You are smarter.  Intelligence + 2"
msgstr "Okosabb vagy. +2 intelligencia."

#: lang/json/mutation_from_json.py
msgid "Extremely Smart"
msgstr "Rendkívül okos"

#. ~ Description for Extremely Smart
#: lang/json/mutation_from_json.py
msgid ""
"You are much smarter, and your skull bulges slightly.  Intelligence + 4"
msgstr ""
"Sokkal okosabb vagy, a koponyád egy kicsit kidudorodik. +4 intelligencia."

#: lang/json/mutation_from_json.py
msgid "Insanely Smart"
msgstr "Elképesztően okos"

#. ~ Description for Insanely Smart
#: lang/json/mutation_from_json.py
msgid ""
"Your skull bulges noticeably due to your impressive brain.  Intelligence + 7"
msgstr ""
"A koponyád láthatóan kidudorodik a lenyűgöző agyadtól. +7 intelligencia."

#: lang/json/mutation_from_json.py
msgid "Prime Intelligence"
msgstr "Prímán okos"

#. ~ Description for Prime Intelligence
#: lang/json/mutation_from_json.py
msgid ""
"You understand almost everything about which you think, with minimal effort."
msgstr ""
"Minimális erőfeszítés árán szinte mindent megértesz, ami csak az eszedbe "
"jut."

#: lang/json/mutation_from_json.py
msgid "Distributed Neurology"
msgstr "Elosztott idegrendszer"

#. ~ Description for Distributed Neurology
#: lang/json/mutation_from_json.py
msgid ""
"Your brain has evolved beyond human imagination.  You'll show them the REAL "
"meaning of 'gray goo'!"
msgstr ""
"Az agyad túlfejlődött az emberi képzeleten is. Na majd te megmutatod nekik, "
"hogy mi is az az igazi szürke ragacs!"

#: lang/json/mutation_from_json.py
msgid "Perceptive"
msgstr "Figyelmes"

#. ~ Description for Perceptive
#: lang/json/mutation_from_json.py
msgid "Your senses are a little keener.  Perception + 1"
msgstr "Az érzékszerveid egy kicsit kifinomultabbak. +1 érzékelés."

#: lang/json/mutation_from_json.py
msgid "Very Perceptive"
msgstr "Nagyon figyelmes"

#. ~ Description for Very Perceptive
#: lang/json/mutation_from_json.py
msgid "Your senses are keener.  Perception + 2"
msgstr "Az érzékszerveid kifinomultabbak. +2 érzékelés."

#: lang/json/mutation_from_json.py
msgid "Extremely Perceptive"
msgstr "Rendkívül figyelmes"

#. ~ Description for Extremely Perceptive
#: lang/json/mutation_from_json.py
msgid "Your senses are much keener.  Perception + 4"
msgstr "Az érzékszerveid sokkal kifinomultabbak. +4 érzékelés."

#: lang/json/mutation_from_json.py
msgid "Insanely Perceptive"
msgstr "Elképesztően figyelmes"

#. ~ Description for Insanely Perceptive
#: lang/json/mutation_from_json.py
msgid "You can sense things you never imagined.  Perception + 7"
msgstr ""
"Olyan dolgokat is észreveszel, amiről még álmodni sem tudtál. +7 érzékelés."

#: lang/json/mutation_from_json.py
msgid "Prime Perception"
msgstr "Prímán figyelmes"

#. ~ Description for Prime Perception
#: lang/json/mutation_from_json.py
msgid "Your senses are keenly honed."
msgstr "Érzékszerveid a végletekig kifinomultak."

#: lang/json/mutation_from_json.py
msgid "Sensory Disintegration"
msgstr "Érzékszervi szétesés"

#. ~ Description for Sensory Disintegration
#: lang/json/mutation_from_json.py
msgid ""
"Your sense organs are all over the place: eyes extending and retracting, "
"'ears' of various shapes migrating about, and taste & smell are "
"uncontrollable.  The world is a horrible mixup.  Ugh!"
msgstr ""
"Az érzékszerveid összezavarodtak: a szemed kiguvad és visszahúzódik, "
"különféle számú és formájú fülek vándorolnak a testeden, az ízlelésed és a "
"szaglásod teljesen irányíthatatlan. Az egész világ furcsa és kavarodott."

#: lang/json/mutation_from_json.py
msgid "Distributed Senses"
msgstr "Elosztott érzékszervek"

#. ~ Description for Distributed Senses
#: lang/json/mutation_from_json.py
msgid ""
"You can now extend and reabsorb sensory organs at will, and can therefore "
"ignore most shocks that would overwhelm lesser beings."
msgstr ""
"Az akaratod szerint tudod az érzékszerveidet kibocsátani és visszahúzni, így"
" azokat az ütéseket és sokkhatásokat is figyelmen kívül tudod hagyni, "
"amelyek leterítenék a gyengébb lényeket."

#: lang/json/mutation_from_json.py
msgid "Little"
msgstr "Kicsi"

#. ~ Description for Little
#: lang/json/mutation_from_json.py
msgid ""
"You've noticeably shrunk in size.  You're able to move with increased "
"litheness, but your smaller stature prevents you from carrying as much."
msgstr ""
"Láthatóan összementél. Még rugalmasabban tudsz mozogni, de a kisebb méreted "
"miatt nem tudsz már annyit szállítani."

#: lang/json/mutation_from_json.py
msgid "Tiny"
msgstr "Apró"

#. ~ Description for Tiny
#: lang/json/mutation_from_json.py
msgid ""
"You're only half as tall as you used to be!  The weight of things you once "
"found easy to carry is now unbearable, clothes are now twice as encumbering "
"for you unless you refit them (since you're half their size), and your hit "
"points are heavily reduced.  However, your movement is silent, and your "
"dodge skill is a little higher."
msgstr ""
"Már csak fele akkor vagy, mint régen! Az egykoron szállított tárgyak súlya "
"most már elviselhetetlen. A ruháid kétszer annyi ormótlanságot okozna, "
"kivéve ha rád illenek (mivel kétszer akkorák, mint a méreted), és jelentősen"
" kevesebb életponttal rendelkezel. A mozgásod viszont teljesen csendes, és a"
" kitérési készséged is nőtt valamennyit."

#: lang/json/mutation_from_json.py
msgid "Unassuming"
msgstr "Szerény"

#. ~ Description for Unassuming
#: lang/json/mutation_from_json.py
msgid ""
"You've mastered your tiny form!  Item encumbrance and carry weight penalties"
" are reduced, and you've learned to use your increased nimbleness to offset "
"your reduced capacity to absorb damage."
msgstr ""
"Mesteri szinten űzöd az apró méreted adta előnyöket! A tárgyak ormótlansága "
"és a szállítási súly hátrányai lecsökkentek, és megtanultad az apró méreted "
"adta fürgeségeddel a téged ért sebzés egy részét sérülés nélkül elnyelni."

#: lang/json/mutation_from_json.py
msgid "Crafty"
msgstr "Ravasz"

#. ~ Description for Crafty
#: lang/json/mutation_from_json.py
msgid ""
"By making the most of your small stature, you can avoid the notice of all "
"but the most perceptive creatures, and your speed is greatly increased."
msgstr ""
"A kisméretű tested adottságait kihasználva a legfigyelmesebb lények "
"kivételével minden más figyelmét elkerülöd, és a sebességed is nagy "
"mértékben nőtt."

#: lang/json/mutation_from_json.py
msgid "Metallassomaiphile"
msgstr "Metallasszomaifil"

#. ~ Description for Metallassomaiphile
#: lang/json/mutation_from_json.py
msgid ""
"Just thinking of mutagen (such a lovely word!  'Mutagen'.  Perfect!) makes "
"you thirsty.  And you so love your new parts.  You simply must have more "
"mutagen!"
msgstr ""
"Már a mutagén gondolatára is megszomjazol. Mutagén! Micsoda gyönyörű szó! És"
" ezek az szépséges új testrészek... muszáj még több mutagént inni!"

#: lang/json/mutation_from_json.py
msgid "Head Bumps"
msgstr "Dudoros fej"

#. ~ Description for Head Bumps
#: lang/json/mutation_from_json.py
msgid "You have a pair of bumps on your skull."
msgstr "Koponyádon egy pár dudor jelent meg."

#: lang/json/mutation_from_json.py
msgid "Slit Nostrils"
msgstr "Hasított orrluk"

#. ~ Description for Slit Nostrils
#: lang/json/mutation_from_json.py
msgid ""
"You have a flattened nose and thin slits for nostrils, giving you a lizard-"
"like appearance.  This makes breathing slightly difficult and increases "
"mouth encumbrance by 10."
msgstr ""
"Orrod lelapult, orrlukaid vékony nyílásokká torzultak, amitől gyíkféle "
"megjelenésed lett. Így viszont nehezebben kapsz levegőt és a szád "
"ormótlansága 10-el nő."

#: lang/json/mutation_from_json.py
msgid "Forked Tongue"
msgstr "Villás nyelv"

#. ~ Description for Forked Tongue
#: lang/json/mutation_from_json.py
msgid "Your tongue is forked, like that of a reptile.  This has no effect."
msgstr "A nyelved kétágúvá változott, mint egy hüllőé. Más hatása nincs."

#: lang/json/mutation_from_json.py
msgid "Bulging Eyes"
msgstr "Kidülledt szem"

#. ~ Description for Bulging Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Your eyes bulge out several inches from your skull.  This does not affect "
"your vision in any way."
msgstr ""
"A szemed több centire kidülled a koponyádból. A látásodra nincsen semmiféle "
"hatással."

#: lang/json/mutation_from_json.py
msgid "Mouth Flaps"
msgstr "Szájlebeny"

#. ~ Description for Mouth Flaps
#: lang/json/mutation_from_json.py
msgid ""
"Skin tabs and odd flaps of skin surround your mouth.  They don't affect your"
" eating, but are unpleasant to look at."
msgstr ""
"Mindenféle bőrlebenyek veszik körül a szádat. Az étkezésre nincsenek "
"hatással, de kétségtelenül undorító látványt nyújtanak."

#: lang/json/mutation_from_json.py
msgid "Wing Stubs"
msgstr "Szárnycsonk"

#. ~ Description for Wing Stubs
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of stubby little wings projecting from your shoulderblades."
"  They can be wiggled at will, but are useless."
msgstr ""
"A lapockacsontjaidból apró szárnyak csonkja mered ki. Kedved szerint "
"csapkodhatsz velük, de semmire se jók."

#: lang/json/mutation_from_json.py
msgid "Bat Wings"
msgstr "Denevérszárny"

#. ~ Description for Bat Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a pair of large, leathery wings.  You can move them a little, but "
"they are useless, and in fact put you off balance, reducing your ability to "
"dodge slightly."
msgstr ""
"Egy pár nagy, bőrszárnyad nőtt. Egy kicsit mozgatni is tudod őket, de csak "
"arra jók, hogy kibillentsenek az egyensúlyodból, ezzel némileg csökkentve a "
"kitérés képességedet."

#: lang/json/mutation_from_json.py
msgid "Butterfly Wings"
msgstr "Pillangó szárnyak"

#. ~ Description for Butterfly Wings
#: lang/json/mutation_from_json.py
msgid ""
"You have a very large and very beautiful pair of brightly-colored wings.  "
"They can't lift you, and they make balancing tricky, but they certainly "
"catch air and attention!"
msgstr ""
"Nagyon nagyméretű és gyönyörűen színezett szárnyaid nőttek. Bár a földről "
"nem tudnak elemelni, és miattuk nehéz egyensúlyban maradnod, a figyelmet "
"biztosan magukra vonják!"

#: lang/json/mutation_from_json.py
msgid "Pale Skin"
msgstr "Sápadt bőr"

#. ~ Description for Pale Skin
#: lang/json/mutation_from_json.py
msgid "Your skin is rather pale."
msgstr "A bőröd meglehetősen sápadt színű."

#: lang/json/mutation_from_json.py
msgid "Spots"
msgstr "Foltos"

#. ~ Description for Spots
#: lang/json/mutation_from_json.py
msgid "Your skin is covered in a pattern of red spots."
msgstr "A bőrödet vörös foltok borítják."

#: lang/json/mutation_from_json.py
msgid "Smelly"
msgstr "Büdös"

#. ~ Description for Smelly
#: lang/json/mutation_from_json.py
msgid ""
"You smell awful.  Monsters that track scent will find you very easily, and "
"humans will react poorly."
msgstr ""
"Rettenetes a szagod. Az embereket nagyon zavarja, a levadászásodhoz "
"szaglásukra támaszkodó állatok sokkal könnyebben tudnak követni."

#: lang/json/mutation_from_json.py
msgid "Deformed"
msgstr "Torzult"

#. ~ Description for Deformed
#: lang/json/mutation_from_json.py
msgid ""
"You're slightly deformed.  Some people will react badly to your appearance."
msgstr ""
"Kis mértékben torzult a tested. Néhány ember rosszul fog reagálni a "
"megjelenésedre."

#: lang/json/mutation_from_json.py
msgid "Badly Deformed"
msgstr "Csúnyán eltorzult"

#. ~ Description for Badly Deformed
#: lang/json/mutation_from_json.py
msgid ""
"You're hideously deformed.  Some people will have a strong negative reaction"
" to your appearance."
msgstr ""
"A tested nagyon csúnyán eltorzult. Néhány ember rendkívül rosszul fog "
"reagálni a megjelenésedre."

#: lang/json/mutation_from_json.py
msgid "Grotesque"
msgstr "Groteszk"

#. ~ Description for Grotesque
#: lang/json/mutation_from_json.py
msgid ""
"Your visage is disgusting and liable to induce vomiting.  People will not "
"want to interact with you unless they have a very good reason to."
msgstr ""
"Az arcod látványa undorító és hányingert kelt. Senki se akar veled beszélni,"
" kivéve, ha nagyon jó okuk van rá."

#: lang/json/mutation_from_json.py
msgid "Beautiful"
msgstr "Szép"

#. ~ Description for Beautiful
#: lang/json/mutation_from_json.py
msgid ""
"You're a real head-turner.  Some people will react well to your appearance, "
"and most people have an easier time trusting you."
msgstr ""
"Utánad néznek az utcán. Néhány ember jól fog reagálni a megjelenésedre, és a"
" legtöbb ember sokkal könnyebben bízik meg benned."

#: lang/json/mutation_from_json.py
msgid "Very Beautiful"
msgstr "Gyönyörű"

#. ~ Description for Very Beautiful
#: lang/json/mutation_from_json.py
msgid ""
"You are a vision of beauty.  Some people will react very well to your looks,"
" and most people will trust you immediately."
msgstr ""
"Szépséges vagy. Néhány ember nagyon jól fog reagálni a megjelenésedre, és a "
"legtöbb ember azonnal megbízik benned."

#: lang/json/mutation_from_json.py
msgid "Glorious"
msgstr "Dicsőséges"

#. ~ Description for Glorious
#: lang/json/mutation_from_json.py
msgid ""
"You are incredibly beautiful.  People cannot help themselves due to your "
"charms, and will do whatever they can to please you."
msgstr ""
"Hihetetlenül gyönyörű vagy. Az emberek nem nagyon tudnak ellenállni a "
"vonzásodnak, és bármit megtesznek, hogy kedvedben járjanak."

#: lang/json/mutation_from_json.py
msgid "Snout"
msgstr "Pofa"

#. ~ Description for Snout
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaw have begun...changing.  Masks and such fit OK, but you're "
"noticeably mutated."
msgstr ""
"Az arcod és az állkapcsod... megváltozott. Maszkot még fel tudsz venni, de "
"láthatóan mutáns vagy."

#: lang/json/mutation_from_json.py
msgid "Bovine Snout"
msgstr "Marhaorr"

#. ~ Description for Bovine Snout
#: lang/json/mutation_from_json.py
msgid ""
"Your face resembles that of a bull, with a significant snout.  It looks "
"fearsome but prevents wearing mouthgear."
msgstr ""
"Az arcod egy bikáéra emlékeztet, közepén hatalmas orral. Megjelenésed "
"félelmetes, de a nagy orrod miatt semmit sem viselhetsz a szádon."

#: lang/json/mutation_from_json.py
msgid "Lupine Muzzle"
msgstr "Farkasorr"

#. ~ Description for Lupine Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your jaw and nose have extended into a wolfish muzzle.  It lends itself to "
"biting in combat and looks impressive, but prevents wearing mouthgear."
msgstr ""
"Az arcod és az állkapcsod farkasra emlékeztető szájjá torzult. Ezzel a "
"pofával jól lehet harc közben harapni, és félelmetesen néz ki, de semmit sem"
" viselhetsz a szádon."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You nip at %s"
msgstr "Belecsípsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s nips and harries %2$s"
msgstr "%1$s belecsíp %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Ursine Muzzle"
msgstr "Medveorr"

#. ~ Description for Ursine Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your jaw and nose have extended into a bearish muzzle.  You could bite with "
"it, and it looks impressive, but it prevents wearing mouthgear."
msgstr ""
"Az arcod és az állkapcsod medvére emlékeztető szájjá torzult. Ezzel a "
"pofával jól lehet harc közben harapni, és félelmetesen néz ki, de semmit sem"
" viselhetsz a szádon."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite %s"
msgstr "Beleharapsz %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites %2$s"
msgstr "%1$s beleharap %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Rodent Muzzle"
msgstr "Rágcsáló orr"

#. ~ Description for Rodent Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaw have extended, giving you an alert and attentive "
"appearance."
msgstr ""
"Az arcod és az állkapcsod megnyúlt, éber és figyelmes megjelenést "
"kölcsönözve."

#: lang/json/mutation_from_json.py
msgid "Reptilian Muzzle"
msgstr "Hüllőorr"

#. ~ Description for Reptilian Muzzle
#: lang/json/mutation_from_json.py
msgid ""
"Your face and jaws are a shorter version of those found on alligators.  They"
" look NASTY--as do the bite wounds they can inflict--but prevent wearing "
"mouthgear."
msgstr ""
"Az arcod és az állkapcsod erősen emlékeztet egy aligátor fejére. Széles szád"
" fogsora félelmetesen néz ki, jó nagyot is lehet vele harapni, de semmit sem"
" viselhetsz rajta."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You bite a chunk out of %s"
msgstr "Kiharapsz egy darabot %s testéből."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s bites a chunk out of %2$s"
msgstr "%1$s kiharap egy darabot %2$s testéből"

#: lang/json/mutation_from_json.py
msgid "Proboscis"
msgstr "Szívószerv"

#. ~ Description for Proboscis
#: lang/json/mutation_from_json.py
msgid ""
"You've gotten rid of that terribly imprecise mouth and now imbibe your food "
"like a proper person.  Chewing was tiresome anyway."
msgstr ""
"Végre megszabadultál attól a rendkívül pontatlan szájtól, és most már úgy "
"szürcsölöd fel az ételt, mint ahogy azt kell. Rágni meg amúgy is macerás "
"volt."

#: lang/json/mutation_from_json.py
msgid "Hollow Bones"
msgstr "Üreges csontok"

#. ~ Description for Hollow Bones
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You have Avian Bone Syndrome--your bones are nearly hollow.  Your body is "
"very light as a result, enabling you to move and attack 20% faster, but also"
" frail; you can carry 40% less, and bashing attacks injure you more."
msgstr ""
"Madárcsont szindrómába szenvedsz - a csontjaid szinte teljesen üregesek. A "
"tested ennek köszönhetően nagyon könnyed, 20%-kal gyorsabban tudsz mozogni "
"és támadni, de ugyanakkor törékennyé is váltál. 40%-kal kevesebb dolgot "
"tudsz magaddal vinni, a zúzó támadások erősebben sebeznek."

#. ~ Description for Nausea
#: lang/json/mutation_from_json.py
msgid ""
"You feel nauseous almost constantly, and are more liable to throw up from "
"food poisoning, alcohol, etc.  You can, if desired, think yourself into "
"vomiting, too."
msgstr ""
"Szinte állandóan hányingered van, és sokkal nagyobb eséllyel hánysz "
"gyomorrontásról, alkoholtól, stb. Ha szeretnéd, akár egy gondolattól is "
"hányhatsz."

#: lang/json/mutation_from_json.py
msgid "Vomitous"
msgstr "Hányós"

#. ~ Description for Vomitous
#: lang/json/mutation_from_json.py
msgid ""
"You have a major digestive disorder.  Though it causes you to vomit "
"frequently, you have found that you can trigger your vomit reflex on demand,"
" too."
msgstr ""
"Komoly emésztési zavaraid vannak. Bár emiatt gyakran kell hánynod, "
"felfedezted, hogy a hányási reflexedet már a puszta gondolattól is ki tudod "
"váltani."

#: lang/json/mutation_from_json.py
msgid "Fast Metabolism"
msgstr "Gyors anyagcsere"

#. ~ Description for Fast Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You require more food than most people, but recover stamina slightly faster."
msgstr "Az átlagembernél több ételre van szükséged."

#: lang/json/mutation_from_json.py
msgid "Rapid Metabolism"
msgstr "Sebes anyagcsere"

#. ~ Description for Rapid Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You require more resources than most, but heal more rapidly as well.  "
"Provides weak regeneration even when not asleep."
msgstr ""
"Több ételre és italra van szükséged, mint átlagnak, de a sebeid is "
"gyorsabban gyógyulnak. Még akkor is gyógyulsz egy kicsit, amikor nem alszol."

#: lang/json/mutation_from_json.py
msgid "Very Fast Metabolism"
msgstr "Nagyon gyors anyagcsere"

#. ~ Description for Very Fast Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You need about twice as much food as the average human to maintain your "
"expanded cardiovascular and respiratory systems.  On a plus side, it doesn't"
" take you much time to recover from any strenuous activity."
msgstr ""
"Kétszer annyit kell enned, mint az átlagembernek ahhoz, hogy szinten "
"tarthasd a keringési és a légzési rendszereidet. Ugyanakkor a megterhelõ "
"munka után hamarabb visszanyered a lendületedet."

#: lang/json/mutation_from_json.py
msgid "Extreme Metabolism"
msgstr "Extrém anyagcsere"

#. ~ Description for Extreme Metabolism
#: lang/json/mutation_from_json.py
msgid ""
"You consume three times as much food as the average human to maintain your "
"truly superhuman endurance."
msgstr ""
"Úgy égetsz kalóriát, mint a benzinnel meglocsolt tábortűz. Háromszor annyit "
"eszel, mint az átlagember."

#: lang/json/mutation_from_json.py
msgid "High Thirst"
msgstr "Szomjas"

#. ~ Description for High Thirst
#: lang/json/mutation_from_json.py
msgid "Your body dries out easily; you need to drink more water."
msgstr "A tested könnyen kiszárad, több vizet kell innod."

#: lang/json/mutation_from_json.py
msgid "Very Thirsty"
msgstr "Nagyon szomjas"

#. ~ Description for Very Thirsty
#: lang/json/mutation_from_json.py
msgid ""
"Ugh, out of water already?  You need about twice the fluids of an average "
"human."
msgstr ""
"Máris elfogyott a víz? Kétszer annyi folyadékra van szükséged, mint "
"másoknak."

#: lang/json/mutation_from_json.py
msgid "Extremely Thirsty"
msgstr "Szélsőségesen szomjas"

#. ~ Description for Extremely Thirsty
#: lang/json/mutation_from_json.py
msgid ""
"You dry out seriously quickly, requiring three times as much liquid to stay "
"hydrated."
msgstr ""
"Nagyon gyorsan kiszáradsz, ezért háromszor annyi folyadékra van szükséged, "
"mint másoknak."

#: lang/json/mutation_from_json.py
msgid "Metabolic Rehydration"
msgstr "Metabolikus rehidratálás"

#. ~ Description for Metabolic Rehydration
#: lang/json/mutation_from_json.py
msgid ""
"Your body gets everything it needs from the food that you eat!  You no "
"longer gain hydration from fluids - instead, your thirst will be equal to, "
"and change with, your hunger."
msgstr ""
"A tested mindent megkap az elfogyasztott ételből! Mostantól az italok nem "
"csökkentik a szomjúságodat - ehelyett a szomjúságod egyenlő az éhségeddel, "
"és az éhséggel együtt változik."

#: lang/json/mutation_from_json.py
msgid "Very Heavy Sleeper"
msgstr "Nagyon mélyen alvó"

#. ~ Description for Very Heavy Sleeper
#: lang/json/mutation_from_json.py
msgid "You could probably sleep through a firefight."
msgstr "Melletted ágyút is el lehetne sütni."

#: lang/json/mutation_from_json.py
msgid "Very Sleepy"
msgstr "Nagyon álmos"

#. ~ Description for Very Sleepy
#: lang/json/mutation_from_json.py
msgid ""
"You find yourself needing to sleep quite often.  You'll spend about half of "
"your time in or around bed."
msgstr "Gyakran van szükséged alvásra. Időd nagyjából felét az ágyban töltöd."

#: lang/json/mutation_from_json.py
msgid "Weakening"
msgstr "Gyengülő"

#. ~ Description for Weakening
#: lang/json/mutation_from_json.py
msgid ""
"You feel as though you are slowly weakening and your body heals slower."
msgstr ""
"Úgy érzed, hogy egyre csak gyengülsz, és a tested is lassabban gyógyul."

#: lang/json/mutation_from_json.py
msgid "Deterioration"
msgstr "Romló állapot"

#. ~ Description for Deterioration
#: lang/json/mutation_from_json.py
msgid "Your body is very slowly wasting away."
msgstr "A tested állapota nagyon lassan, de egyre csak romlik."

#: lang/json/mutation_from_json.py
msgid "Disintegration"
msgstr "Bomlás"

#. ~ Description for Disintegration
#: lang/json/mutation_from_json.py
msgid "Your body is slowly wasting away!"
msgstr "A tested állapota lassan, egyenletesen romlik."

#: lang/json/mutation_from_json.py
msgid "Solar Sensitivity"
msgstr "Napfényérzékeny"

#. ~ Description for Solar Sensitivity
#: lang/json/mutation_from_json.py
msgid ""
"Your skin simply cannot handle ultraviolet radiation, such as sunlight.  It "
"will seriously burn you."
msgstr ""
"A bőröd nem viseli el az ultraibolya sugárzást, ami többek között a "
"napfényben is van. Komolyan megéghetsz tőle."

#: lang/json/mutation_from_json.py
msgid "Sores"
msgstr "Fekélyes"

#. ~ Description for Sores
#: lang/json/mutation_from_json.py
msgid ""
"Your extremities are covered in painful sores.  The pain is worse when they "
"are covered in clothing."
msgstr ""
"A végtagjaidat fájdalmas fekélyek borítják. Ott fáj a legjobban, ahol "
"ruhával érintkezik."

#: lang/json/mutation_from_json.py
msgid "Light Sensitive"
msgstr "Fényérzékeny"

#. ~ Description for Light Sensitive
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you uncomfortable.  If you are outdoors and the weather is "
"Sunny, you suffer -1 to all stats."
msgstr ""
"A napfénytől kellemetlenül érzed magad. Ha a szabadban vagy, és az időjárás "
"napos, akkor -1-et kapsz az összes értékedre."

#: lang/json/mutation_from_json.py
msgid "Very Light Sensitive"
msgstr "Rendkívül fényérzékeny"

#. ~ Description for Very Light Sensitive
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you very uncomfortable.  If you are outdoors during the day, "
"you suffer -1 to all stats; -2 if the weather is Sunny."
msgstr ""
"A napfénytől nagyon kellemetlenül érzed magad. Ha nappal a szabadban vagy, "
"akkor -1-et kapsz az összes értékedre, ha az időjárás napos, akkor -2-t."

#. ~ Description for Troglobite
#: lang/json/mutation_from_json.py
msgid ""
"Sunlight makes you extremely uncomfortable, resulting in large penalties to "
"all stats."
msgstr ""
"A napfénytől végtelenül kellemetlenül érzed magad, minden értéked nagyon "
"lecsökken."

#: lang/json/mutation_from_json.py
msgid "Webbed Hands"
msgstr "Úszóhártyás"

#. ~ Description for Webbed Hands
#: lang/json/mutation_from_json.py
msgid ""
"Your hands and feet are heavily webbed, reducing your Dexterity by 1 and "
"causing problems with gloves.  However, you can swim much faster.  Slightly "
"decreases wet penalties."
msgstr ""
"Kezedre és lábadra úszóhártyák nőttek, emiatt az ügyességed 1-el csökken és "
"a kesztyűhordás nehézségekkel jár. Viszont legalább sokkal gyorsabban tudsz "
"úszni és valamennyivel csökken az ázottság negatív hatása."

#: lang/json/mutation_from_json.py
msgid "Paws"
msgstr "Mancsok"

#. ~ Description for Paws
#: lang/json/mutation_from_json.py
msgid ""
"Your hands have fused into quasi-paws.  Fine manipulation is a challenge: "
"permanent hand encumbrance of 10, difficulty with delicate craftwork, and "
"your gloves don't fit.  But they handle water better."
msgstr ""
"A kezeid kvázi mancsokká alakultak át. A finom motoros tevékenység rendkívül"
" nehéz, a kezedre 10 ormótlanság kerül, nehezen tudsz apró dolgokat "
"összeszerelni és a kesztyűdet sem tudod felvenni. De legalább a mancsaid "
"vízállók."

#: lang/json/mutation_from_json.py
msgid "Broad Paws"
msgstr "Széles mancsok"

#. ~ Description for Broad Paws
#: lang/json/mutation_from_json.py
msgid ""
"Your paws are much larger now.  Manual dexterity is difficult: permanent "
"hand encumbrance of 20, serious problems crafting, and no gloves.  But you "
"can swim more effectively."
msgstr ""
"A mancsaid sokkal szélesebbek. A kézügyességed nagyon leromlott, a kezed "
"ormótlansága 20-vel nő, nehezen tudsz bármit is elkészíteni, és nem "
"hordhatsz kesztyűt. Viszont legalább jobban tudsz úszni."

#: lang/json/mutation_from_json.py
msgid "Beak"
msgstr "Csőr"

#. ~ Description for Beak
#: lang/json/mutation_from_json.py
msgid ""
"You have a beak for a mouth.  You can occasionally use it to peck at your "
"enemies, but it is impossible for you to wear mouth gear.  Slightly reduces "
"wet effects."
msgstr ""
"A szád egy csőrré alakult át. Néha belecsípsz az ellenségbe, de semmit sem "
"viselhetsz a szádon. Némileg csökkenti az ázottság negatív hatásait."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You peck %s"
msgstr "Belecsipdesel %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s pecks %2$s"
msgstr "%1$s belecsipdes %2$s testébe"

#: lang/json/mutation_from_json.py
msgid "Woodpecker Beak"
msgstr "Harkály csőr"

#. ~ Description for Woodpecker Beak
#: lang/json/mutation_from_json.py
msgid ""
"Pecking at prey is part of your daily routine now.  Slightly reduces wet "
"effects."
msgstr ""
"Az ellenség csőrrel csipkedése a napi rutinod részévé vált. Némileg "
"csökkenti az ázottság hatásait."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You jackhammer into %s with your beak"
msgstr "A csőröddel beleütvefúrózol %s testébe"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s jackhammer into %2$s with their beak"
msgstr "%1$s a csőrével beleütvefúrózik %s testébe"

#: lang/json/mutation_from_json.py
msgid "Hummingbird Beak"
msgstr "Kolibri csőr"

#. ~ Description for Hummingbird Beak
#: lang/json/mutation_from_json.py
msgid ""
"Though your beak's not suitable for pecking, those flowers out there are a "
"good source of energy.  Examine them to feed."
msgstr ""
"Bár a csőröd nem alkalmas a csipkedésre, az a sok virág ott jó "
"energiaforrás. A nektár szürcsöléséhez vizsgáld meg a virágot."

#: lang/json/mutation_from_json.py
msgid "Genetically Unstable"
msgstr "Genetikailag instabil"

#. ~ Description for Genetically Unstable
#: lang/json/mutation_from_json.py
msgid ""
"Your DNA has been damaged in a way that causes you to continually develop "
"more mutations."
msgstr ""
"A DNS-ed olyan mértékben károsodott, hogy folyamatosan mutációk jelennek meg"
" rajtad."

#: lang/json/mutation_from_json.py
msgid "Genetic Chaos"
msgstr "Genetikai káosz"

#. ~ Description for Genetic Chaos
#: lang/json/mutation_from_json.py
msgid ""
"Your body alters itself rapidly, and without your intervention or conscious "
"control."
msgstr ""
"Kívánatos vagy tudatos beavatkozásod nélkül is a tested gyorsan változik."

#: lang/json/mutation_from_json.py
msgid "Minor Radioactivity"
msgstr "Enyhén radioaktív"

#. ~ Description for Minor Radioactivity
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit low levels of "
"radiation, which slowly contaminates the world around you."
msgstr ""
"A tested radioaktívvá vált! Folyamatosan alacsony szintű sugárzást bocsátasz"
" ki, ezért krónikusan sugárfertőzötté válsz és lassan besugárzod a "
"körülötted található világot."

#: lang/json/mutation_from_json.py
msgid "Radioactivity"
msgstr "Radioaktív"

#. ~ Description for Radioactivity
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit moderate levels of "
"radiation, which contaminates the world around you."
msgstr ""
"A tested radioaktívvá vált! Folyamatosan közepes szintű sugárzást bocsátasz "
"ki, ezért krónikusan sugárfertőzötté válsz és besugárzod a körülötted "
"található világot."

#: lang/json/mutation_from_json.py
msgid "Severe Radioactivity"
msgstr "Erősen radioaktív"

#. ~ Description for Severe Radioactivity
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become radioactive!  You continuously emit heavy levels of "
"radiation, making your surroundings unlivable."
msgstr ""
"A tested radioaktívvá vált! Folyamatosan magas szintű sugárzást bocsátasz "
"ki, ezért krónikusan sugárfertőzötté válsz és lakhatatlanságig besugárzod a "
"körülötted található világot."

#: lang/json/mutation_from_json.py
msgid "Slimy"
msgstr "Nyálkás"

#. ~ Description for Slimy
#: lang/json/mutation_from_json.py
msgid ""
"Your body is coated with a fine slime.  Protects from long term effects of "
"acid, though not short term ones.  Greatly increases wet benefits."
msgstr ""
"A testedet egy finom nyálka veszi körül, ami megvéd a savak hosszú távú "
"hatásaitól, bár a rövid távúaktól nem. Jelentősen növeli az ázottság "
"előnyeit."

#: lang/json/mutation_from_json.py
msgid "Viscous"
msgstr "Nyúlós"

#. ~ Description for Viscous
#: lang/json/mutation_from_json.py
msgid ""
"Your body's slime output has become sticky and gel-like.  Protects from acid"
" somewhat.  Greatly increases wet benefits."
msgstr ""
"A tested nyálka kibocsátása ragacsossá és zselé-szerűvé vált. Valamennyire "
"megvéd a savtól. Nagyban növeli az ázottság előnyeit."

#: lang/json/mutation_from_json.py
msgid "Amorphous Body"
msgstr "Amorf test"

#. ~ Description for Amorphous Body
#: lang/json/mutation_from_json.py
msgid ""
"Your flesh is a pleasing gel-like consistency.  Your bodily functions seem "
"to be moving around, and your leg-equivalents flow comfortably."
msgstr ""
"A tested kellemesen zselés állapotú. A szervrendszereid ide-oda vándorolnak,"
" és a lábnak megfelelő végtagjaid is kényelmesen áramlanak."

#: lang/json/mutation_from_json.py
msgid "Omnicellular"
msgstr "Omnicelluláris"

#. ~ Description for Omnicellular
#: lang/json/mutation_from_json.py
msgid ""
"Your body is more or less one consistent whole: a single, giant, omni-cell "
"that alters itself as needed."
msgstr ""
"A tested nagyjából egy egységes egész, egy egyetlen darab hatalmas sejt, ami"
" szükség szerint változtat önmagán."

#: lang/json/mutation_from_json.py
msgid "Herbivore"
msgstr "Növényevő"

#. ~ Description for Herbivore
#: lang/json/mutation_from_json.py
msgid ""
"Your body's ability to digest meat is severely hampered.  Eating meat has a "
"good chance of making you vomit it back up; even if you manage to keep it "
"down, its nutritional value is greatly reduced."
msgstr ""
"A tested húsemésztő képessége jelentősen leromlott. Ha húst eszel, akkor "
"nagy eséllyel azonnal ki fogod hányni. Ha esetleg sikerül lenn tartani, "
"akkor sem lesz túl tápláló."

#: lang/json/mutation_from_json.py
msgid "Carnivore"
msgstr "Húsevő"

#. ~ Description for Carnivore
#: lang/json/mutation_from_json.py
msgid ""
"Your body's ability to digest fruits, vegetables and grains is severely "
"hampered.  You cannot eat anything besides meat."
msgstr ""
"A tested gyümölcs-, zöldség- és magemésztő képessége jelentősen leromlott. "
"Csak húst tudsz enni."

#: lang/json/mutation_from_json.py
msgid "Ponderous"
msgstr "Nehézkes"

#. ~ Description for Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are generally slow to move.  You move 10% slower."
msgstr ""
"Az izmaid általában lassan mozgatnak. 10%-kal lassabban tudsz mozogni."

#: lang/json/mutation_from_json.py
msgid "Very Ponderous"
msgstr "Nagyon nehézkes"

#. ~ Description for Very Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are quite slow to move.  You move 20% slower."
msgstr "Az izmaid elég lassan mozgatnak. 20%-kal lassabban tudsz mozogni."

#: lang/json/mutation_from_json.py
msgid "Extremely Ponderous"
msgstr "Rendkívül nehézkes"

#. ~ Description for Extremely Ponderous
#: lang/json/mutation_from_json.py
#, no-python-format
msgid "Your muscles are very slow to move.  You move 30% slower."
msgstr "Az izmaid nagyon lassan mozgatnak. 30%-kal lassabban tudsz mozogni."

#: lang/json/mutation_from_json.py
msgid "Sunlight Dependent"
msgstr "Napfényfüggő"

#. ~ Description for Sunlight Dependent
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You feel very sluggish when not in direct sunlight.  You suffer a 5% drop in"
" speed when in shade, and a 10% drop in speed when in the dark."
msgstr ""
"Nagyon lomhának érzed magad, amikor nem vagy közvetlen napfényen. Árnyékban "
"5%-kal, sötétben 10%-kal vagy lassabb."

#: lang/json/mutation_from_json.py
msgid "Vines"
msgstr "Indás"

#. ~ Description for Vines
#: lang/json/mutation_from_json.py
msgid ""
"You have developed several vines sprouting from your shoulder area.  They're"
" bulky and get in the way."
msgstr ""
"Válladból számos inda serken. Az indák vaskosak és állandóan útban vannak."

#: lang/json/mutation_from_json.py
msgid "Vine Limbs"
msgstr "Inda végtagok"

#. ~ Description for Vine Limbs
#: lang/json/mutation_from_json.py
msgid ""
"You've developed the ability to control your vines; they make good lashes.  "
"You can even rappel down sheer drops using them, but disconnecting HURTS."
msgstr ""
"Sikerrel kifejlesztetted az indák irányításának képességét. Egészen jól "
"lehet velük kötözni. Még magasról is le tudsz rajtuk csúszni, de nagyon fáj "
"leszedni őket."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You lash %s with a vine"
msgstr "Az indáiddal ostorcsapást mérsz %s testére"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s lashes %2$s with their vines"
msgstr "%1$s az indáival ostorcsapást mér %2$s testére"

#: lang/json/mutation_from_json.py
msgid "Vine Sprouter"
msgstr "Indanövesztő"

#. ~ Description for Vine Sprouter
#: lang/json/mutation_from_json.py
msgid ""
"You have full control of your vines, and can grow new ones and detach old "
"ones more or less at will."
msgstr ""
"Teljes mértékben irányításod alá vontad az indáidat. Bármikor növeszthetsz "
"magadnak újat, illetve leszedheted a régieket."

#: lang/json/mutation_from_json.py
msgid "You detach a vine from your body."
msgstr "Lecsatolsz egy indát a testedrõl."

#: lang/json/mutation_from_json.py
msgid "Toe Roots"
msgstr "Lábujj gyökerek"

#. ~ Description for Toe Roots
#: lang/json/mutation_from_json.py
msgid ""
"Your toes have grown wriggly, and you can't imagine why you wear that stuff "
"on your feet.  Take it off.  It's in the way."
msgstr ""
"A lábujjaid vonaglanak, és el sem tudod képzelni, hogy miért viselsz "
"egyáltalán bármit is a lábadon. Vedd csak le. Így lesz jó."

#: lang/json/mutation_from_json.py
msgid "Roots"
msgstr "Gyökerek"

#. ~ Description for Roots
#: lang/json/mutation_from_json.py
msgid ""
"It's about time you started developing a root system.  When reading, "
"fishing, waiting, or otherwise being stationary for a while on diggable "
"terrain, you'll extract nutrients and water from the soil."
msgstr ""
"Itt az ideje, hogy kifejlessz egy gyökérzetet. Amikor olvasol, pecázol, "
"vársz vagy egyéb okokból állsz mozdulatlanul felásható talajon, akkor a "
"talajból tápanyagot és vizet veszel fel."

#: lang/json/mutation_from_json.py
msgid "Rooter"
msgstr "Gyökeres"

#. ~ Description for Rooter
#: lang/json/mutation_from_json.py
msgid ""
"You find it difficult not to sink roots when able.  You extract nutrients "
"and water whenever on diggable terrain, but move more slowly."
msgstr ""
"Nehezedre esik, hogy ne mélyíts bele a földbe gyökereket, amikor csak tudsz."
" Amikor felásható talajon vagy, akkor tápanyagot és vizet veszel fel, "
"viszont lassabban haladsz."

#: lang/json/mutation_from_json.py
msgid "Chloromorphosis"
msgstr "Kloromorfózis"

#. ~ Description for Chloromorphosis
#: lang/json/mutation_from_json.py
msgid ""
"Every inch of your skin is packed with chlorophyll and you have strong "
"roots.  Sleeping on diggable soil will satisfy any hunger or thirst you "
"might have."
msgstr ""
"A bőröd minden egyes négyzet-centiméterén klorofill található, és erős "
"gyökerekkel rendelkezel. Amikor felásható talajon alszol, akkor minden "
"éhséged és szomjúságod elmúlik."

#: lang/json/mutation_from_json.py
msgid "Heat Dependent"
msgstr "Hőfüggő"

#. ~ Description for Heat Dependent
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is dependent on ambient temperatures.  You lose 1% of "
"your speed for every 5 (2.8) degrees below 65 F (18.3 C).  This sluggishness"
" helps you conserve energy, however."
msgstr ""
"Az izomzatod a környezeti hőmérséklettől függ. 18,3 C fok alatt minden 2,8 C"
" fok csökkenésnél 1%-kal lassabb leszel."

#: lang/json/mutation_from_json.py
msgid "Very Heat Dependent"
msgstr "Erősen hőfüggő"

#. ~ Description for Very Heat Dependent
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your muscle response is highly dependent on ambient temperatures.  You lose "
"1% of your speed for every 3 (1.7) degrees below 65 F (18.3 C), but your "
"slow metabolism requires much less food."
msgstr ""
"Az izomzatod a környezeti hőmérséklettől függ. 18,3 C fok alatt minden 1,7 C"
" fok csökkenésnél 1%-kal lassabb leszel."

#: lang/json/mutation_from_json.py
msgid "Cold Blooded"
msgstr "Hidegvérű"

#. ~ Description for Cold Blooded
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"You are cold-blooded and rely on heat to keep moving.  Your lose 1% of your "
"speed for every 2 (1.1) degrees below 65 F (18.3 C), but only need to eat "
"about half as much as before."
msgstr ""
"Hidegvérű vagy, a mozgáshoz hőre van szükséged. 18,3 C fok alatt minden 1,1 "
"C fok csökkenésnél 1%-kal lassabb leszel."

#: lang/json/mutation_from_json.py
msgid "Ectothermic"
msgstr "Ektoterm"

#. ~ Description for Ectothermic
#: lang/json/mutation_from_json.py
msgid ""
"Your body has become permanently cold-blooded.  Your speed lowers--or raises"
"--for every 2 (1.1) degrees below or above 65 F (18.3 C).  You only need to "
"eat half as much as an average human."
msgstr ""
"A tested visszafordíthatatlanul hidegvérűvé vált. A sebességed 18,3 C fok "
"alatt 1,1 fokonként 1%-kal csökken, felette ugyanennyivel nő."

#: lang/json/mutation_from_json.py
msgid "Growling Voice"
msgstr "Dörmögő hang"

#. ~ Description for Growling Voice
#: lang/json/mutation_from_json.py
msgid ""
"You have a growling, rough voice.  Persuading NPCs will be more difficult, "
"but threatening them will be easier."
msgstr ""
"Reszelősen dörmögő, durva hangod van. Nehezebb lesz az NPC-ket meggyőzni, de"
" könnyebb lesz őket megfenyegetni."

#: lang/json/mutation_from_json.py
msgid "Snarling Voice"
msgstr "Acsarkodó hang"

#. ~ Description for Snarling Voice
#: lang/json/mutation_from_json.py
msgid ""
"You have a threatening snarl in your voice.  Persuading NPCs will be near "
"impossible, but threatening them will be much easier."
msgstr ""
"Fenyegetően acsarkodó hangod van. Az NPC-ket szinte lehetetlen lesz "
"meggyőzni, de sokkal könnyebb lesz őket megfenyegetni."

#: lang/json/mutation_from_json.py
msgid "Hissing Voice"
msgstr "Sziszegő hang"

#. ~ Description for Hissing Voice
#: lang/json/mutation_from_json.py
msgid ""
"You hiss when speaking.  Persuading NPCs will be more difficult, but "
"threatening them will be easier."
msgstr ""
"Beszéd köszben sziszegő a hangod. Szokkal neheszebb lesz az NPC-ket "
"meggyőzni, de szokkal könnyebb lesssz őket megfenyegetni. A Drágaszágot "
"pedig nem adjuk, gonosz hobbitockának főleg nem."

#: lang/json/mutation_from_json.py
msgid "Shouter"
msgstr "Kiabálós"

#. ~ Description for Shouter
#: lang/json/mutation_from_json.py
msgid "You occasionally shout uncontrollably."
msgstr "Néha önkéntelenül kiabálsz egyet."

#: lang/json/mutation_from_json.py
msgid "Screamer"
msgstr "Visítós"

#. ~ Description for Screamer
#: lang/json/mutation_from_json.py
msgid "You sometimes scream uncontrollably."
msgstr "Időnként önkéntelenül visítasz egyet."

#: lang/json/mutation_from_json.py
msgid "Howler"
msgstr "Üvöltős"

#. ~ Description for Howler
#: lang/json/mutation_from_json.py
msgid "You frequently let out a piercing howl."
msgstr "Gyakran egy velőtrázót üvöltesz."

#: lang/json/mutation_from_json.py
msgid "Feathered Arms"
msgstr "Tollas karok"

#. ~ Description for Feathered Arms
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have grown vibrantly colored feathers.  They effectively "
"waterproof your arms and take the edge off hits, but really get in the way."
"  They're simply too small to help you in the air."
msgstr ""
"A karjaidból élénk színű tollak nőttek ki. Ezzel gyakorlatilag vízhatlanná "
"váltak a karjaid és a tollak az ütéseket is valamennyire felfogjad, de "
"nagyon útban vannak. Ahhoz meg túl kicsik, hogy a levegőbe emeljenek."

#: lang/json/mutation_from_json.py
msgid "Insect Limbs"
msgstr "Rovar végtagok"

#. ~ Description for Insect Limbs
#: lang/json/mutation_from_json.py
msgid ""
"You've *finally* sprouted a pair of arms from your midsection.  They flail "
"more-or-less uncontrollably, making you feel rather larval."
msgstr ""
"Végre a törzsed közepéből is növesztettél karokat! Kicsit irányíthatatlanul "
"ide-oda hadonásznak, és ettől inkább lárvának érzed magad."

#: lang/json/mutation_from_json.py
msgid "Insect Arms"
msgstr "Rovar karok"

#. ~ Description for Insect Arms
#: lang/json/mutation_from_json.py
msgid ""
"It's good having all your arms.  Though they're too thin to block or punch, "
"you can fold them inside human-shaped gear if need be."
msgstr ""
"De jó, hogy végre megvan mind a hat karod. Bár túl vékonyak ahhoz, hogy "
"védekezni vagy ütni lehessen velük, szükség esetén legalább emberi alakú "
"ruhákba is be tudod őket hajtogatni."

#: lang/json/mutation_from_json.py
msgid "Arachnid Limbs"
msgstr "Pók végtagok"

#. ~ Description for Arachnid Limbs
#: lang/json/mutation_from_json.py
msgid ""
"There's the last two limbs you were expecting.  Unfortunately you still "
"can't coordinate them, so you're getting in your own way.  A lot."
msgstr ""
"Íme az az utolsó két pár végtag, amire annyira vártál. Sajnos még a "
"mozgáskoordinációd nem az igazi, úgyhogy gyakran esel át a saját "
"testrészeiden. Nagyon gyakran."

#: lang/json/mutation_from_json.py
msgid "Arachnid Arms"
msgstr "Pók karok"

#. ~ Description for Arachnid Arms
#: lang/json/mutation_from_json.py
msgid ""
"You have four handsome limbs, and then those mutant 'hand' and 'foot' "
"things.  They probably aren't worth concealing."
msgstr ""
"Van neked négy szép végtagod, meg rajtuk kívül az a mutáns kéz meg láb izé. "
"Nem érdemes elrejteni."

#: lang/json/mutation_from_json.py
msgid "Tentacle Arms"
msgstr "Csápkarok"

#. ~ Description for Tentacle Arms
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into tentacles, resulting in a bonus of 1 to "
"Dexterity, permanent hand encumbrance of 30, and inability to wear gloves.  "
"Somewhat decreases wet penalties."
msgstr ""
"A karjaid polipra emlékeztető csápkarokká változtak át, +1 ügyesség, 30 kéz "
"ormótlanság, és kesztyűt sem tudsz felvenni. Valamennyire csökkenti az "
"ázottság negatív hatásait."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You slap %s with your tentacle"
msgstr "A csápjaiddal rácsapsz %s testére"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s slaps %2$s with their tentacle"
msgstr "%1$s a csápjaival rácsap %2$s testére"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You rake %s with your tentacle"
msgstr "A csápoddal végigsepersz %s testén"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s rakes %2$s with their tentacle"
msgstr "%1$s a csápjával végigseper %2$s testén"

#: lang/json/mutation_from_json.py
msgid "4 Tentacles"
msgstr "4 csáp"

#. ~ Description for 4 Tentacles
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into four tentacles, resulting in a bonus of 1 to"
" Dexterity, permanent hand encumbrance of 30, and inability to wear gloves."
"  You can make up to 3 extra attacks with them.  Somewhat decreases wet "
"penalties."
msgstr ""
"A karjaid 4 darab, polipra emlékeztető csáppá változtak át, +1 ügyesség, 30 "
"kéz ormótlanság, és kesztyűt sem tudsz felvenni. Az új karokkal három "
"további ütést mérhetsz az ellenfélre. Valamennyire csökkenti az ázottság "
"negatív hatásait."

#: lang/json/mutation_from_json.py
msgid "8 Tentacles"
msgstr "8 csáp"

#. ~ Description for 8 Tentacles
#: lang/json/mutation_from_json.py
msgid ""
"Your arms have transformed into eight tentacles, resulting in a bonus of 1 "
"to Dexterity, permanent hand encumbrance of 30, and inability to wear "
"gloves.  You can make up to 7 extra attacks with them.  Somewhat decreases "
"wet penalties."
msgstr ""
"A karjaid 8 darab, polipra emlékeztető csáppá változtak át, +1 ügyesség, 30 "
"kéz ormótlanság, és kesztyűt sem tudsz felvenni. Az új karokkal hét további "
"ütést mérhetsz az ellenfélre. Valamennyire csökkenti az ázottság negatív "
"hatásait."

#: lang/json/mutation_from_json.py
msgid "Shell"
msgstr "Kagyló"

#. ~ Description for Shell
#: lang/json/mutation_from_json.py
msgid ""
"You have grown a thick shell over your torso, providing excellent armor.  "
"You find you can use the empty space as 16 storage space, but cannot wear "
"anything on your torso.  Somewhat reduces wet effects."
msgstr ""
"A törzsed köré egy vastag kagylót növesztettél, amely kiváló páncélnak "
"bizonyul. A kagyló mögött 16 egységnyi tárolóhely található, viszont a "
"törzseden semmit sem tudsz viselni. Valamennyire csökkenti az ázottság "
"negatív hatásait."

#: lang/json/mutation_from_json.py
msgid "Roomy Shell"
msgstr "Tágas kagyló"

#. ~ Description for Roomy Shell
#: lang/json/mutation_from_json.py
msgid ""
"Your protective shell has grown large enough to accommodate--if need be--"
"your whole body.  Activate to pull your head and limbs into your shell, "
"trading mobility and vision for warmth and shelter."
msgstr ""
"A védőkagylód akkorára nőtt, hogy szükség esetén az egész tested elfér "
"benne. Aktiválásával behúzod a kagylóba a fejedet és a végtagjaidat, a "
"látásodat és a mozgási képességedet ezzel melegségre és óvóhelyre cserélve."

#: lang/json/mutation_from_json.py
msgid "Leg Tentacles"
msgstr "Csáplábak"

#. ~ Description for Leg Tentacles
#: lang/json/mutation_from_json.py
#, no-python-format
msgid ""
"Your legs have transformed into six tentacles.  This decreases your speed on"
" land by 20%, makes your movement silent, increases your swimming speed, and"
" reduces wet penalties."
msgstr ""
"A lábaid 6 darab, polipra emlékeztető csáppá változtak át. A szárazföldi "
"mozgásod sebessége 20%-kal csökken, a mozgás maga teljesen csendes, az "
"úszási sebességed megnőtt és valamennyire csökkenti az ázottság negatív "
"hatásait."

#: lang/json/mutation_from_json.py
msgid "Tentacle Bracing"
msgstr "Csáprögzítés"

#. ~ Description for Tentacle Bracing
#: lang/json/mutation_from_json.py
msgid ""
"Your lower-tentacles have developed suckers.  They make land movement "
"marginally more tiring, but do a good job of keeping you set in place."
msgstr ""
"Az alsó testrészed csápjaira szívókorongok nőttek. A szárazföldi mozgás egy "
"apró mértékben jobban fáraszt, viszont nem csúszol le sehonnan se."

#. ~ Description for Lizard
#: lang/json/mutation_from_json.py
msgid ""
"You sometimes look back on your days before your tail came in.  But you're "
"better now."
msgstr ""
"Néha visszatekintesz azokra a napokra, amikor még nem nőtt ki a farkad. De "
"most már jobban vagy."

#. ~ Description for Bird
#: lang/json/mutation_from_json.py
msgid ""
"You're sure you'll fly someday.  In the meantime, there are still nests to "
"build."
msgstr ""
"Egy nap biztosan szárnya fogsz kapni. Addig is még rengeteg fészket kell "
"építeni."

#: lang/json/mutation_from_json.py
msgid "Aquatic"
msgstr "Vízi"

#. ~ Description for Aquatic
#: lang/json/mutation_from_json.py
msgid ""
"Ninety percent of the planet, and it's yours to explore.  And colonize.  And"
" enjoy.  What was that about a surface?"
msgstr ""
"A föld felszínének kilencven százalékát víz borítja, és felfedezése mind a "
"tiéd. Meg a benépesítése. Meg az élvezete. Kinek kell itt szárazföld?"

#. ~ Description for Beast
#: lang/json/mutation_from_json.py
msgid ""
"It's about time you grew out.  Now that you've matured, it is time to make "
"something of yourself."
msgstr ""
"Itt az ideje, hogy felnőj. Most, hogy éretté váltál, itt az ideje, hogy "
"valamihez kezdjél is magaddal."

#. ~ Description for Feline
#: lang/json/mutation_from_json.py
msgid ""
"Stalking prey, eating well, and lying in the sun.  Mmm, all you could ever "
"desire."
msgstr ""
"Prédát becserkészni, jót enni és a napon sütkérezni. Kinek kell ennél több?"

#. ~ Description for Wolf
#: lang/json/mutation_from_json.py
msgid "You're the perfect candidate to lead a pack."
msgstr "Te vagy a tökéletes példány a falka vezetéséhez."

#. ~ Description for Bear
#: lang/json/mutation_from_json.py
msgid "So the humans died, what's the worry?  Now they won't ruin the woods."
msgstr ""
"Szóval kihaltak az emberek, és akkor mi van? Legalább nem teszik tönkre az "
"erdőt."

#: lang/json/mutation_from_json.py
msgid "Bovine"
msgstr "Szarvasmarha"

#. ~ Description for Bovine
#: lang/json/mutation_from_json.py
msgid ""
"Civilization collapsed?  Great!  You and your kin will never have to worry "
"about a slaughterhouse again."
msgstr ""
"Összeomlott a civilizáció? Nagyszerű! Neked és a fajtádnak soha nem kell "
"többet tartania a vágóhídtól."

#. ~ Description for Insect
#: lang/json/mutation_from_json.py
msgid ""
"It would be good to be a Queen, having workers constantly servicing your "
"every need...but how would you keep them in line?"
msgstr ""
"De jó lenne királynőnek lenni, a dolgozók minden igényt kiszolgálnának... de"
" hogyan tartom őket kordában?"

#. ~ Description for Plant
#: lang/json/mutation_from_json.py
msgid ""
"Well, you still have those other walking flowers-and the mushrooms too-to "
"deal with.  But you'll manage."
msgstr ""
"Hát, ott van még az a sétáló virág, meg a gombák. De majd megoldod azt is."

#: lang/json/mutation_from_json.py
msgid "Aqueous"
msgstr "Vízlakó"

#. ~ Description for Aqueous
#: lang/json/mutation_from_json.py
msgid ""
"What was that old advertisement, 'paint the planet'? That might be a good "
"long-term goal, but for now..."
msgstr ""
"Mi volt az a régi reklám, fesd be a világot? Hosszútávú célnak megtesz, de "
"most..."

#: lang/json/mutation_from_json.py
msgid "Subterranean"
msgstr "Földalatti"

#. ~ Description for Subterranean
#: lang/json/mutation_from_json.py
msgid ""
"Not much point to rebuilding up in that horribly bright roofless wasteland."
"  Now that you've become accustomed to your new digs, there's the beginnings"
" of a great empire right here, underground."
msgstr ""
"Semmi értelme újjáépíteni azt a rettenetesen fényes, tető nélküli "
"pusztaságot. Most, hogy megszoktad az új lakóhelyedet, itt, a föld alatt "
"kezdheted el az új birodalom építését."

#. ~ Description for Cephalopod
#: lang/json/mutation_from_json.py
msgid ""
"Strange aeons, true, but Death seems to be slacking and you are doing just "
"fine."
msgstr ""
"Furcsa idők járnak, az biztos. A halál lazsál, te pedig köszönöd, jól vagy."

#: lang/json/mutation_from_json.py
msgid "Arachnid"
msgstr "Pókféle"

#. ~ Description for Arachnid
#: lang/json/mutation_from_json.py
msgid "Well, maybe you'll just have to make your own world wide web."
msgstr "Hát, lehet hogy egymagadnak kell felépítened a világhálót."

#: lang/json/mutation_from_json.py
msgid "Survivor"
msgstr "Túlélő"

#. ~ Description for Survivor
#: lang/json/mutation_from_json.py
msgid ""
"Hey.  Civilization fell.  You're still around.  'Rat' just isn't respectful."
msgstr "Heh, szóval a civilizáció szétesett. De te nem."

#: lang/json/mutation_from_json.py
msgid "Prototype"
msgstr "Prototípus"

#. ~ Description for Prototype
#: lang/json/mutation_from_json.py
msgid "After all those experiments, what's a few more, hmm?"
msgstr "Azután a számtalan kísérlet után ugyan mit számít még néhány, hmmm?"

#: lang/json/mutation_from_json.py
msgid "Prime"
msgstr "Príma"

#. ~ Description for Prime
#: lang/json/mutation_from_json.py
msgid "You're the perfect candidate to tidy this mess."
msgstr "Te vagy a tökéletes példány a káosz rendbetételéhez."

#. ~ Description for Fey
#: lang/json/mutation_from_json.py
msgid ""
"You are the tree under which humankind will shelter during these dark times."
msgstr ""
"Te vagy az a fa, amely alatt az emberiség menedéket lel a mostani sötét idők"
" során."

#: lang/json/mutation_from_json.py
msgid "Chaos"
msgstr "Káosz"

#. ~ Description for Chaos
#: lang/json/mutation_from_json.py
msgid ""
"You can't tell what you are anymore.  Everything and yet nothing, like you "
"weren't meant to exist.  But you do, and you're a force, no matter what "
"happens."
msgstr ""
"Már azt sem tudod, ki vagy te. Egyszerre minden és semmi, mintha nem is "
"lettél volna hivatott létezni. De létezel, és te vagy az erő, bármi is "
"történjen."

#. ~ Description for Raptor
#: lang/json/mutation_from_json.py
msgid ""
"The chance to undo not one but TWO extinction events.  You're confident "
"you'll do fine."
msgstr ""
"Itt a lehetőség, hogy nem egy, hanem KETTŐ kihalási eseményt fordíts vissza."
" Biztos vagy benne, hogy menni fog."

#: lang/json/mutation_from_json.py
msgid "Diminutive"
msgstr "Parányi"

#. ~ Description for Diminutive
#: lang/json/mutation_from_json.py
msgid ""
"So much food, everywhere!  And nobody's even guarding it anymore!  These are"
" good times."
msgstr ""
"Mennyi étel van mindenhol! És már senki sem őrzi! Jó idők jöttek el, az "
"biztos."

#: lang/json/mutation_from_json.py
msgid "Marloss Gateway"
msgstr "Marloss átjáró"

#. ~ Description for Marloss Gateway
#: lang/json/mutation_from_json.py
msgid ""
"You get the feeling that you're on the cusp of becoming something greater "
"than yourself."
msgstr ""
"Úgy érzed, hogy a küszöbén állsz annak, hogy magadnál valami nagyobb dologgá"
" válj!"

#: lang/json/mutation_from_json.py
msgid "Mycus"
msgstr "Mycus"

#. ~ Description for Mycus
#: lang/json/mutation_from_json.py src/iuse.cpp
msgid "We are the Mycus."
msgstr "Mi vagyunk a mycus."

#: lang/json/mutation_from_json.py
msgid "Acidproof"
msgstr "Saválló"

#. ~ Description for Acidproof
#: lang/json/mutation_from_json.py
msgid "Your mutated flesh is immune to the damaging effects of acid."
msgstr "A mutáns húsod ellenáll a savak káros hatásainak."

#: lang/json/mutation_from_json.py
msgid "Acid Blood"
msgstr "Savas vér"

#. ~ Description for Acid Blood
#: lang/json/mutation_from_json.py
msgid ""
"Your body has developed a wonderful defense mechanism.  Instead of normal "
"blood, you bleed a strong molecular acid which will damage any creature "
"foolish enough to harm you."
msgstr ""
"A tested egy csodálatos védelmi mechanizmust fejlesztett ki. A szokványos "
"véred helyett egy rendkívül erős molekuláris sav folyik ki belőled, ami "
"megsebesít minden olyan lényt, aki elég bolond volt ahhoz, hogy megtámadjon."

#: lang/json/mutation_from_json.py
msgid "Pyromaniac"
msgstr "Piromán"

#. ~ Description for Pyromaniac
#: lang/json/mutation_from_json.py
msgid ""
"You have an unhealthy obsession with fire, and you get anxious if you don't "
"light them every now and then or stand near them often.  However, you gain a"
" mood bonus from doing so."
msgstr ""
"Egészségtelen mértékben érdekel a tűz, és szorongás fog el, ha nem gyújtasz "
"néha tüzed, vagy állsz a tűz mellett. Ilyenkor viszont hangulati bónuszt "
"kapsz."

#: lang/json/mutation_from_json.py
msgid "Amphibious"
msgstr "Kétéltű"

#. ~ Description for Amphibious
#: lang/json/mutation_from_json.py
msgid ""
"You're as comfortable in water as on land, and your body has adapted around "
"that fact.  Your base swimming speed is greatly increased, and weight will "
"hinder you much less while swimming."
msgstr ""
"Ugyanannyira érzed magadat kényelemben vízben, mint a szárazföldön, és a "
"testet is ezt az átalakulást mutatja. Az alap úszási sebességed jelentősen "
"nőtt, és a súly is kevésbé fog gátolni az úszásban."

#: lang/json/mutation_from_json.py
msgid "Lidless Eyes"
msgstr "Szemhélymentes"

#. ~ Description for Lidless Eyes
#: lang/json/mutation_from_json.py
msgid ""
"Like a true fish, your eyes lack eyelids, and are are instead covered by a "
"translucent, protective membrane that blocks irritants and water, and "
"provides minor armor.  It also allows you to sleep with your eyes open!  "
"Activate to cause the approach of hostile creatures to wake you up."
msgstr ""
"A szemeiden nincsenek szemhéjak, ahogyan az igazi halaknak since. Ehelyett "
"egy áttetsző védelmi membrán fedi, amely távolt tartja az ingerlő hatású "
"anyagokat és a vizet, valamint némi páncélzatot is nyújt. Még nyitott "
"szemmel is lehet így aludni! Aktiválásánál az ellenséges lények közeledése "
"felébreszt."

#: lang/json/mutation_from_json.py
msgid "Aqueous Repose"
msgstr "Vízlakó pihenés"

#. ~ Description for Aqueous Repose
#: lang/json/mutation_from_json.py
msgid ""
"Falling asleep underwater is easy for you, and you spend less time asleep "
"when you rest there.  You can also eat underwater, though you can't drink."
msgstr ""
"A víz alatt könnyen tudsz elaludni, és a vízalatti pihenésnél kevesebb ideig"
" alszol. Víz alatt tudsz enni is, bár inni nem."

#: lang/json/mutation_from_json.py
msgid "Toxic Flesh"
msgstr "Mérgező hús"

#. ~ Description for Toxic Flesh
#: lang/json/mutation_from_json.py
msgid ""
"Your flesh is highly poisonous, and creatures that bite you will receive a "
"nasty surprise."
msgstr ""
"A húsod rendkívül mérgező, és azok a lények, akik beléd harapnak, "
"kellemetlen meglepetésben részesülnek."

#: lang/json/mutation_from_json.py
msgid "Freshwater Osmosis"
msgstr "Édesvízi ozmózis"

#. ~ Description for Freshwater Osmosis
#: lang/json/mutation_from_json.py
msgid ""
"Your gills and skin are highly permeable to moisture, and you can hydrate "
"your body through osmosis.  While submerged in fresh water, any thirst you "
"might have will be slaked."
msgstr ""
"Kopoltyúd és bőröd nagy mértékben átereszti a nedvességet, így ozmózissal is"
" képes vagy a tested hidratálására. Édesvízbe merülve elmúlik az összes "
"szomjúságod."

#: lang/json/mutation_from_json.py
msgid "Electroreceptors"
msgstr "Elektroreceptorok"

#. ~ Description for Electroreceptors
#: lang/json/mutation_from_json.py
msgid ""
"A network of jelly-filled electroreceptors, like that of a shark, have grown"
" throughout your face and nose.  They are very sensitive to magnetic fields,"
" allowing you to see robots and creatures charged with electricity through "
"walls, but being shocked will seriously mess you up."
msgstr ""
"A cápákhoz hasonló zselés elektroreceptorok hálózata nőtt az arcodra és az "
"orrodra. Ezek nagyon érzékenyek a mágneses mező változására, ezért robotokat"
" és elektromossággal feltöltött lényeket a falakon át is látni fogsz, "
"viszont egy téged ért elektromos kisülés nagyon rosszul fog esni."

#: lang/json/mutation_from_json.py
msgid "Shark Teeth"
msgstr "Cápafogú"

#. ~ Description for Shark Teeth
#: lang/json/mutation_from_json.py
msgid ""
"Your teeth have grown incredibly sharp and are formed of very dense calcium "
"material.  In addition to making you eat much faster, you can use them as a "
"lethal natural weapon, as long as your anatomy favors it.  They also grow "
"very fast, and you harmlessly shed them more or less at random."
msgstr ""
"Elképesztően hegyesre nőttek a fogaid, és rendkívül sűrű kalciumos anyagból "
"alakultak ki. Amellett, hogy így sokkal gyorsabban tudsz enni, természetes "
"fegyverként is használhatod, amennyiben a tested felépítése ezt lehetővé "
"teszi. A fogaid továbbá nagyon gyorsan nőnek, és időről időre "
"fájdalommentesen kihullanak."

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "You tear into %s with your teeth"
msgstr "A fogaddal kitépsz %s testéből egy darabot"

#: lang/json/mutation_from_json.py
#, no-python-format
msgid "%1$s tears into %2$s with their teeth"
msgstr "%1$s a fogával kitép %2$s testéből egy darabot"

#: lang/json/mutation_from_json.py
msgid "Police Officer"
msgstr "Rendőrtiszt"

#. ~ Description for Police Officer
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn law enforcement officer, with jurisdiction throughout "
"the New England region thanks to interstate agreements.  Whether that means "
"anything now is another question."
msgstr ""
"A törvény betartatására felesküdött rendőrtiszt vagy, aki az államközi "
"megállapodásoknak köszönhetően az egész New England-i régióban joghatósággal"
" bír. Hogy ez manapság jelent-e valamit, az egy jó kérdés."

#: lang/json/mutation_from_json.py
msgid "SWAT Officer"
msgstr "SWAT rendőrtiszt"

#. ~ Description for SWAT Officer
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn law enforcer, with jurisdiction throughout the New "
"England region thanks to interstate agreements.  Whether that means anything"
" now is another question."
msgstr ""
"A törvény betartatására felesküdött rendőrtiszt vagy, aki az államközi "
"megállapodásoknak köszönhetően az egész New England-i régióban joghatósággal"
" bír. Hogy ez manapság jelent-e valamit, az egy jó kérdés."

#: lang/json/mutation_from_json.py
msgid "Bionic Officer"
msgstr "Bionikus rendőrtiszt"

#. ~ Description for Bionic Officer
#: lang/json/mutation_from_json.py
msgid ""
"You are a cybernetically-resurrected law enforcer, with jurisdiction "
"throughout the New England region thanks to interstate agreements.  Whether "
"you can do for the law what the law did for you is another question."
msgstr ""
"Egy kibernetikusan feltámasztott rendőrtiszt vagy, aki az államközi "
"megállapodásoknak köszönhetően az egész New England-i régióban joghatósággal"
" bír. Hogy ez manapság jelent-e valamit, az egy jó kérdés."

#: lang/json/mutation_from_json.py
msgid "Churl"
msgstr "Paraszt"

#. ~ Description for Churl
#: lang/json/mutation_from_json.py
msgid ""
"Thou art a lewede man, a lowly cowherd, though where thi catel been thou "
"hast not ynn certain."
msgstr ""
"Engedé ürdüng intetüinek ës ëvék az tilvot gyimilcstűl. Ës az gyimilcsben "
"hálálut evék."

#: lang/json/mutation_from_json.py
msgid "Police Detective"
msgstr "Rendőrségi nyomozó"

#. ~ Description for Police Detective
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn law enforcement investigator, with jurisdiction "
"throughout the New England region thanks to interstate agreements.  Whether "
"your shield means anything now is another question."
msgstr ""
"A törvény betartatására felesküdött nyomozó vagy, aki az államközi "
"megállapodásoknak köszönhetően az egész New England-i régióban joghatósággal"
" bír. Hogy ez manapság jelent-e valamit, az egy jó kérdés."

#: lang/json/mutation_from_json.py
msgid "US Marshal"
msgstr "US Marshal"

#. ~ Description for US Marshal
#: lang/json/mutation_from_json.py
msgid ""
"You are a duly sworn Federal marshal, with nationwide jurisdiction and the "
"authority of the United States of America."
msgstr ""
"A törvény betartatására felesküdött szövetségi marsall vagy, országos "
"hatáskörrel és az Amerikai Egyesült Államok joghatóságával."

#: lang/json/mutation_from_json.py
msgid "MD"
msgstr "Orvos"

#. ~ Description for MD
#: lang/json/mutation_from_json.py
msgid ""
"You were just through with the administrative formalities for your residency"
" when the Cataclysm struck.  \"Your\" hospital was overrun and evacuated, "
"but there's always work for a good doctor."
msgstr ""
"Éppen végeztél a rezidensi adminisztrációs formaságokkal, amikor beütött a "
"kataklizma. A te kórházadat lerohanták és kiürítették, de egy jó orvosnak "
"minden akad munkája."

#: lang/json/mutation_from_json.py
msgid "Skater"
msgstr "Görkoris"

#. ~ Description for Skater
#: lang/json/mutation_from_json.py
msgid ""
"You spent a lot of time actively maneuvering on skates before the Cataclysm,"
" and are better at staying on your feet when checked or blocked."
msgstr ""
"A kataklizma előtt sok időt töltöttél a görkorcsolyádon, és nagyobb eséllyel"
" maradsz talpon, ha neked ütköznek vagy blokkolnak."

#: lang/json/mutation_from_json.py
msgid "Martial Artist"
msgstr "Harcművész"

#. ~ Description for Martial Artist
#: lang/json/mutation_from_json.py
msgid ""
"You were shaping up to be a pretty decent student of the martial arts before"
" the Cataclysm struck.  Time to see just how good you really are."
msgstr ""
"Egész ügyes harcművészeti tanonc vált belőled, mire a Kataklizma beütött. "
"Most majd kiderül, tényleg mennyire vagy jó."

#: lang/json/mutation_from_json.py
msgid "Black Belt"
msgstr "Fekete öv"

#. ~ Description for Black Belt
#: lang/json/mutation_from_json.py
msgid ""
"You were competitive at national levels, and had considered teaching your "
"art.  Defending against the entire town may still be a challenge, though."
msgstr ""
"Országos szinten versenyeztél, és már gondolkodtál azon, hogy oktatnál is. "
"Ennek ellenére azért nem egyszerű dolog az egész várossal szembe szállni."

#: lang/json/mutation_from_json.py
msgid "Pugilist"
msgstr "Ökölvívó"

#. ~ Description for Pugilist
#: lang/json/mutation_from_json.py
msgid ""
"You are experienced in the Sweet Science of boxing.  You could've had a shot"
" at a local boxing tournament, if the Cataclysm hadn't screwed that up."
msgstr ""
"Nagy tapasztalatod van a bokszolás tudományában. A helyi bokszversenyen is "
"jó esélyekkel indulhattál volna, ha nem szól közbe a Kataklizma."

#: lang/json/mutation_from_json.py
msgid "Autodoc Specialist"
msgstr "Robotdoki specialista"

#. ~ Description for Autodoc Specialist
#: lang/json/mutation_from_json.py
msgid ""
"You're trained in proper operation of the Autodoc, an advanced machine used "
"for surgical procedures.  Operations involving it will be moderately more "
"likely to succeed."
msgstr ""
"Képzésben részesültél a robotdoki megfelelő használatáról, melynek "
"segítségével magas szintű műtéti beavatkozásokat lehet elvégezni. A "
"robotdoki műtétek egy kicsivel jobb eséllyel lesznek sikeresek."

#: lang/json/mutation_from_json.py
msgid "Dungeon Master"
msgstr "Mesélő"

#. ~ Description for Dungeon Master
#: lang/json/mutation_from_json.py
msgid ""
"Weeks spent picking through manuals and researching topics you aren't versed"
" in has taught you to find what you need to know more quickly.  You read "
"slightly faster, and suffer no reading time penalty for books too complex "
"for you to easily understand."
msgstr ""
"Mivel heteken át olvastál kézikönyveket, és kutattál számodra ismeretlen "
"szakterületeken, sokkal gyorsabban megtalálod azt, amit tudni szeretnél. Egy"
" kicsit gyorsabban olvasol, és nem ér időbeli hátrány, ha számodra túl "
"összetett könyvet olvasol."

#: lang/json/mutation_from_json.py
