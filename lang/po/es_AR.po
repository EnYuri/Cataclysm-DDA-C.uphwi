"A military-style water canteen with a 1.5 liter capacity.  Commonly worn at "
"the hip."
msgstr ""
"Una cantimplora de tipo militar con una capacidad de 1.5 litros. Comúnmente "
"se lleva colgada en la cadera."

#: lang/json/CONTAINER_from_json.py
msgid "thermos"
msgid_plural "thermoses"
