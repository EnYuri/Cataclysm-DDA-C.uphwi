msgid "Mansion Holdout"
msgstr "Resistencia en Mansión"

#. ~ Description for scenario 'Mansion Holdout' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"While the world ended, you felt relatively safe inside the mansion you have "
"serviced for years. Now the dead have come knocking at your doorstep, it "
"might be time to leave"
msgstr ""
"Mientras el mundo se terminaba, te sentías relativamente a salvo adentro de "
"la mansión donde trabajaste por varios años. Ahora que los muertos están "
"golpeando a la puerta, tal vez sea el momento de irse."

#. ~ Description for scenario 'Mansion Holdout' for a female character.
#: lang/json/scenario_from_json.py
