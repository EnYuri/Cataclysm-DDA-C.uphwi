msgid "PB&H sandwich"
msgid_plural "PB&H sandwiches"
msgstr[0] "sánguche PB&H"
msgstr[1] "sánguches PB&H"

#. ~ Description for PB&H sandwich
#: lang/json/COMESTIBLE_from_json.py
