#: lang/json/MAGAZINE_from_json.py
msgid "A 50 round box magazine for use with Rivtech 8x40mm caseless firearms."
msgstr ""
"Es un cargador de caja de 50 balas para usar en las armas Rivtech de calibre"
" 8x40mm sin casquillo."

#: lang/json/MAGAZINE_from_json.py
msgid "Calico magazine"
msgstr "cargador Calico"

#. ~ Description for Calico magazine
#: lang/json/MAGAZINE_from_json.py
msgid ""
"A surprisingly compact 50-round helical magazine for use with the Calico "
"M960 SMG."
msgstr ""
"Es un cargador helicoidal sorpresivamente compacto de 50 balas, para usar en"
" el subfusil Calico M960."

#: lang/json/MAGAZINE_from_json.py
msgid "Glock extended magazine"
msgstr "cargador extendido Glock"

#. ~ Description for Glock extended magazine
#: lang/json/MAGAZINE_from_json.py
