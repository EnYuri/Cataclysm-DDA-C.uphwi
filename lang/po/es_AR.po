#. ~ Name for scenario 'Evacuee' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Evacuee"
msgstr "Evacuado"

#. ~ Name for scenario 'Evacuee' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Evacuee"
msgstr "Evacuada"

#. ~ Description for scenario 'Evacuee' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You have survived the initial wave of panic, and have achieved (relative) "
"safety in one of the many government evac shelters."
msgstr ""
"Sobreviviste a la primera oleada de pánico, y has conseguido (relativamente)"
" la seguridad en uno de los diversos refugios de evacuados que dispuso el "
"gobierno."

#. ~ Description for scenario 'Evacuee' for a female character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_female"
msgid ""
"You have survived the initial wave of panic, and have achieved (relative) "
"safety in one of the many government evac shelters."
msgstr ""
"Sobreviviste a la primera oleada de pánico, y has conseguido (relativamente)"
" la seguridad en uno de los diversos refugios de evacuados que dispuso el "
"gobierno."

#. ~ Starting location for scenario 'Evacuee'.
#: lang/json/scenario_from_json.py
msgctxt "start_name"
msgid "Evac Shelter"
msgstr "Refugio de Evacuados"

#. ~ Name for scenario 'Refugee' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Refugee"
msgstr "Refugiado"

#. ~ Name for scenario 'Refugee' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Refugee"
msgstr "Refugiado"

#. ~ Description for scenario 'Refugee' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You made it to one of the refugee centers, but they've refused to let you "
"join the others underground.  Looks like you're on your own..."
msgstr ""
"Pudiste llegar a uno de los centros de refugiados, pero no te dejaron unirte"
" a ellos. Parece que estás solo..."

#. ~ Description for scenario 'Refugee' for a female character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_female"
msgid ""
"You made it to one of the refugee centers, but they've refused to let you "
"join the others underground.  Looks like you're on your own..."
msgstr ""
"Pudiste llegar a uno de los centros de refugiados, pero no te dejaron unirte"
" a ellos. Parece que estás sola..."

#. ~ Starting location for scenario 'Refugee'.
#: lang/json/scenario_from_json.py
msgctxt "start_name"
msgid "Refugee Center"
msgstr "Centro de Refugiados"

#. ~ Name for scenario 'Missed' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Missed"
msgstr "Perdido"

#. ~ Name for scenario 'Missed' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Missed"
msgstr "Perdida"

#. ~ Description for scenario 'Missed' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"Whether due to stubbornness, ignorance, or just plain bad luck, you missed "
"the evacuation, and are stuck in a city full of the risen dead."
msgstr ""
"Ya sea por tu cabeza dura, ignorancia, o mala suerte, te perdiste la "
"evacuación y ahora estás atrapado en una ciudad llena de muertos vivientes."

#. ~ Description for scenario 'Missed' for a female character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_female"
