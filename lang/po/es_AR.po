msgstr "Te las arreglás para evitar mirar al horrendo %s."

#: src/monattack.cpp
#, c-format
msgid "The %s flashes a LED and departs.  Human officer on scene."
msgstr "El %s apunta una luz LED y se va. Agente humano en la escena."

#: src/monattack.cpp
#, c-format
msgid ""
"The %s acknowledges you as an officer responding, but hangs around to watch."
msgstr ""
"El %s te reconoce como el agente encargado, pero se queda dando vueltas para"
