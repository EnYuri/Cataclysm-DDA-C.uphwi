msgstr ""
"Algún estúpido puso miel en su sánguche de mantequilla de maní, que en su "
"sano juicio- ah, pará, está bastante bueno."

#: lang/json/COMESTIBLE_from_json.py
msgid "PB&M sandwich"
msgid_plural "PB&M sandwiches"
msgstr[0] "sánguche PB&M"
msgstr[1] "sánguches PB&M"

