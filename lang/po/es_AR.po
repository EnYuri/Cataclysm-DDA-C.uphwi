msgstr[0] "tazón de plástico"
msgstr[1] "tazones de plástico"

#. ~ Description for plastic bowl
#: lang/json/CONTAINER_from_json.py
msgid ""
"A plastic bowl.  Can be used as a container or as a tool.  Holds 250 ml of "
