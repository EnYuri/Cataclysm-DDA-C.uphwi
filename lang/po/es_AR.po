msgid "ember carrier (lit)"
msgid_plural "ember carriers (lit)"
msgstr[0] "braserito (enc.)"
msgstr[1] "braseritos (enc.)"

#. ~ Description for ember carrier (lit)
#: lang/json/TOOL_from_json.py
