msgstr[0] "conversivo L523-CAR"
msgstr[1] "conversivos L523-CAR"

#. ~ Description for L523-CAR conversion
#: lang/json/GENERIC_from_json.py
msgid ""
"All the parts necessary to convert an L523 to the Carbine configuration, "
"Leadworks LLC's choice for close-quarters work.  In order to reconfigure an "
"already-configured L523, you'll need to disassemble it to the base platform,"
" then assemble with the parts you prefer."
msgstr ""
"Todas las partes necesarias para convertir un L523 a la configuración de "
"Carabina, la selección de Leadworks SRL para el trabajo en espacios "
"cerrados. Para poder reconfigurar un L523 ya configurado, es necesario "
"desarmarlo a su plataforma base, y luego armarlo con las partes "
"seleccionadas."

