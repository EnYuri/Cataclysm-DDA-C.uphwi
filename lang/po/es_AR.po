#: lang/json/MAGAZINE_from_json.py
msgid "Glock Drum magazine - 100 rd"
msgstr "cargador de tambor Glock - 100 balas"

#. ~ Description for Glock Drum magazine - 100 rd
#: lang/json/MAGAZINE_from_json.py
msgid "Made to fit most Glock pistols.  This drum magazine holds 100 rounds."
msgstr ""
"Hecho para la mayoría de las pistolas Glock. Este cargador de tambor "
