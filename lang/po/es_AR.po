msgid "explosive arrowhead"
msgid_plural "explosive arrowheads"
msgstr[0] "punta de flecha explosiva"
msgstr[1] "puntas de flecha explosivas"

#. ~ Description for explosive arrowhead
#: lang/json/GENERIC_from_json.py
msgid ""
"This simple IED is designed to be attached to an arrow and detonate on "
"impact."
msgstr ""
"Este simple artefacto explosivo improvisado está diseñado para ser puesto en"
