#: lang/json/ARMOR_from_json.py
msgid "Sheath sword"
msgstr "Enfundar espada"

#. ~ Description for baldric
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather scabbard, big enough for anything up to a longsword, or even a bit"
" larger than that.  Designed to be worn at the waist, secured by a shoulder "
"belt.  Activate to sheath/draw a sword."
msgstr ""
"Es una vaina de cuero suficientemente grande como para una espada larga, o "
"incluso algo un poco más grande. Diseñado para ser puesto en la cintura, y "
"ajustado con una correa al hombro. Hay que usarlo para enfundar y "
"desenfundar la espada."

#: lang/json/ARMOR_from_json.py
msgid "bandana"
msgid_plural "bandanas"
msgstr[0] "bandana"
msgstr[1] "bandanas"

#. ~ Description for bandana
#: lang/json/ARMOR_from_json.py
msgid ""
"A cotton bandana, worn over the mouth for warmth and minor protection from "
"dust and other contaminants."
msgstr ""
"Es una bandana de algodón que se usa sobre la boca para abrigar, y brinda un"
" poco de protección contra el polvo y otros contaminantes."

#: lang/json/ARMOR_from_json.py
msgid "barrette"
msgid_plural "barrettes"
msgstr[0] "pasador"
msgstr[1] "pasadores"

#. ~ Description for barrette
#: lang/json/ARMOR_from_json.py
msgid "A barrette with lots of ornaments."
msgstr "Un pasador para el pelo con muchos adornos."

#: lang/json/ARMOR_from_json.py
msgid "laundry basket"
msgid_plural "laundry baskets"
msgstr[0] "canasto de ropa"
msgstr[1] "canastos de ropa"

#. ~ Description for laundry basket
#: lang/json/ARMOR_from_json.py
msgid "A plastic basket meant for storing and hauling clothing."
msgstr "Es un canasto plástico para meter y transportar ropa."

#: lang/json/ARMOR_from_json.py
msgid "pair of beekeeping gloves"
msgid_plural "pairs of beekeeping gloves"
msgstr[0] "par de guantes de apicultor"
msgstr[1] "pares de guantes de apicultor"

#. ~ Description for pair of beekeeping gloves
#: lang/json/ARMOR_from_json.py
msgid "A pair of white beekeeping gloves made out of smooth leather."
msgstr "Es un par de guantes blancos de apicultor, hechos de cuero suave."

#: lang/json/ARMOR_from_json.py
msgid "beekeeping hood"
msgid_plural "beekeeping hoods"
msgstr[0] "máscara de apicultor"
msgstr[1] "máscaras de apicultor"

#. ~ Description for beekeeping hood
#: lang/json/ARMOR_from_json.py
msgid ""
"A beekeeping hood.  Keeps the bees out, but lets fresh air in.  Rather "
"cumbersome to wear, as it is rather bulky and hinders vision."
msgstr ""
"Una máscara de apicultor. Mantiene tu cabeza a salvo de las abejas, y deja "
"ingresar el aire fresco. Es bastante incómodo de usar, porque es grande y "
"dificulta la visión."

#: lang/json/ARMOR_from_json.py
msgid "beekeeping suit"
msgid_plural "beekeeping suits"
msgstr[0] "traje de apicultor"
msgstr[1] "trajes de apicultor"

#. ~ Description for beekeeping suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A white suit commonly worn by professional beekeepers with straps on your "
"ankles and wrists to prevent bees from flying in.  It's not a very tough "
"fabric, but it's lightweight and has plenty of storage thanks to a chest "
"pocket."
msgstr ""
"Es un traje blanco comúnmente utilizado por los apicultores profesionales, "
"con correas en los tobillos y muñecas para prevenir que las abejas se metan."
" No está hecho de una tela muy resistente, pero es ligero y tiene mucha "
"capacidad de almacenamiento gracias al bolsillo en el pecho."

#: lang/json/ARMOR_from_json.py
msgid "beret"
msgid_plural "berets"
msgstr[0] "boina"
msgstr[1] "boinas"

#. ~ Description for beret
#: lang/json/ARMOR_from_json.py
msgid "A soft cotton hat.  Commonly worn by armed forces and existentialists."
msgstr ""
"Es una gorra suave de algodón, usada comúnmente por las fuerzas armadas y "
"por los existencialistas."

#: lang/json/ARMOR_from_json.py
msgid "wool beret"
msgid_plural "wool berets"
msgstr[0] "boina de lana"
msgstr[1] "boinas de lana"

#. ~ Description for wool beret
#: lang/json/ARMOR_from_json.py
msgid "A soft wool hat.  Commonly worn by armed forces and existentialists."
msgstr ""
"Es una gorra suave de lana. Comúnmente usada por las fuerzas armadas y por "
"los existencialistas."

#: lang/json/ARMOR_from_json.py
msgid "bikini bottom"
msgid_plural "bikini bottoms"
msgstr[0] "tanga de bikini"
msgstr[1] "tangas de bikini"

#. ~ Description for bikini bottom
#: lang/json/ARMOR_from_json.py
msgid "A simple bikini bottom."
msgstr "Un tanga común de un bikini."

#: lang/json/ARMOR_from_json.py
msgid "bikini top"
msgid_plural "bikini tops"
msgstr[0] "bikini"
msgstr[1] "bikinis"

#. ~ Description for bikini top
#: lang/json/ARMOR_from_json.py
msgid "A simple bikini top."
msgstr "Una simple bikini."

#: lang/json/ARMOR_from_json.py
msgid "fur bikini top"
msgid_plural "fur bikini tops"
msgstr[0] "bikini de piel"
msgstr[1] "bikinis de piel"

#. ~ Description for fur bikini top
#: lang/json/ARMOR_from_json.py
msgid "A simple fur bikini top."
msgstr "Una simple bikini de piel."

#: lang/json/ARMOR_from_json.py
msgid "leather bikini top"
msgid_plural "leather bikini tops"
msgstr[0] "bikini de cuero"
msgstr[1] "bikinis de cuero"

#. ~ Description for leather bikini top
#: lang/json/ARMOR_from_json.py
msgid "A simple leather bikini top."
msgstr "Una simple bikini de cuero."

#: lang/json/ARMOR_from_json.py
msgid "bindle"
msgid_plural "bindles"
msgstr[0] "hatillo"
msgstr[1] "hatillos"

#. ~ Description for bindle
#: lang/json/ARMOR_from_json.py
msgid ""
"You're ready for a trip down some train tracks.  Also known as a hobo stick."
msgstr ""
"Es el típico palo con un trapo atado para cargar cosas, también se lo conoce"
" como \"palo de vagabundo\". No te vayas, Chavo..."

#: lang/json/ARMOR_from_json.py
msgid "blanket"
msgid_plural "blankets"
msgstr[0] "frazada"
msgstr[1] "frazadas"

#. ~ Description for blanket
#: lang/json/ARMOR_from_json.py
msgid "Hiding under here will not protect you from the monsters."
msgstr "Aunque te escondas debajo de ella, no te protegerá de los monstruos."

#: lang/json/ARMOR_from_json.py
msgid "blazer"
msgid_plural "blazers"
msgstr[0] "bléiser"
msgstr[1] "bléiseres"

#. ~ Description for blazer
#: lang/json/ARMOR_from_json.py
msgid "A professional-looking wool blazer.  Quite cumbersome."
msgstr ""
"Un bléiser de lana de los que usan los profesionales. Bastante incómodo."

#: lang/json/ARMOR_from_json.py
msgid "blindfold"
msgid_plural "blindfolds"
msgstr[0] "venda para ojos"
msgstr[1] "vendas para ojos"

#. ~ Description for blindfold
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple fabric covering tied over the eyes to block sight.  Useful for "
"sleeping in bright areas."
msgstr ""
"Es una tela común que se ata sobre los ojos para bloquear la visión. Útil "
"para dormir en lugares con mucha luz."

#: lang/json/ARMOR_from_json.py
msgid "bondage mask"
msgid_plural "bondage masks"
msgstr[0] "máscara de bondage"
msgstr[1] "máscaras de bondage"

#. ~ Use action menu_text for bondage mask.
#: lang/json/ARMOR_from_json.py
msgid "Zip up"
msgstr "Cerrar el cierre"

#. ~ Use action msg for bondage mask.
#: lang/json/ARMOR_from_json.py
msgid "You zip the eyes and mouth of the bondage mask closed."
msgstr ""
"Cerrás el cierre que cubre los ojos y la boca de la máscara de bondage."

#. ~ Description for bondage mask
#: lang/json/ARMOR_from_json.py
msgid ""
"A tight mask made of black leather.  The eyes and mouth can be closed using "
"zippers."
msgstr ""
"Una máscara muy ajustada hecha de cuero negro. Los agujeros de los ojos y la"
" boca pueden ser cerrados con los cierres."

#: lang/json/ARMOR_from_json.py
msgid "bondage mask (zipped)"
msgid_plural "bondage masks (zipped)"
msgstr[0] "máscara de bondage (cerrada)"
msgstr[1] "máscaras de bondage (cerradas)"

#. ~ Use action menu_text for bondage mask (zipped).
#: lang/json/ARMOR_from_json.py
msgid "Unzip"
msgstr "Abrir el cierre"

#. ~ Use action msg for bondage mask (zipped).
#: lang/json/ARMOR_from_json.py
msgid "You unzip the eyes and mouth of the bondage mask."
msgstr ""
"Abrís el cierre que cubre los ojos y la boca de la máscara de bondage."

#. ~ Description for bondage mask (zipped)
#: lang/json/ARMOR_from_json.py
msgid ""
"A tight mask made of black leather.  The eyes and mouth have been zipped "
"closed."
msgstr ""
"Es una máscara muy ajustada hecha de cuero negro. Los cierres de los ojos y "
"la boca están cerrados."

#: lang/json/ARMOR_from_json.py
msgid "bondage suit"
msgid_plural "bondage suits"
msgstr[0] "traje de bondage"
msgstr[1] "trajes de bondage"

#. ~ Description for bondage suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A suit of snug, black leather.  Has no pockets, but does feature an "
"abundance of unusually located zippers."
msgstr ""
"Es un traje ajustado de cuero negro. No tiene bolsillos, pero ofrece una "
"gran variedad de cierres en lugares extraños."

#: lang/json/ARMOR_from_json.py
msgid "bookplate"
msgid_plural "bookplates"
msgstr[0] "armadura de libros"
msgstr[1] "armaduras de libros"

#. ~ Description for bookplate
#: lang/json/ARMOR_from_json.py
msgid ""
"A crude form of armor made from stacked paper and rolls of duct tape, this "
"breastplate offers a surprising amount of protection."
msgstr ""
"Una armadura primitiva, hecha con montones de hojas y rollos de cinta "
"adhesiva. Sorprendentemente, brinda buena protección."

#: lang/json/ARMOR_from_json.py
msgid "ankle sheath"
msgid_plural "ankle sheaths"
msgstr[0] "vaina tobillera"
msgstr[1] "vainas tobilleras"

