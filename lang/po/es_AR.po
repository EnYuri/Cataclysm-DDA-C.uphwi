msgstr "Mostrar"

#. ~ hide mouse cursor
#: src/options.cpp
msgid "Hide"
msgstr "Ocultar"

#. ~ hide mouse cursor when keyboard is used
#: src/options.cpp
msgid "HideKB"
msgstr "OcultarTEC"

