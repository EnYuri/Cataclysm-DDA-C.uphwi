#: lang/json/CONTAINER_from_json.py
msgid ""
"SURGEON GENERAL'S WARNING: Smoking Causes Lung Cancer, Heart Disease, "
"Emphysema And May Complicate Pregnancy."
msgstr ""
"ADVERTENCIA DE LA DIRECCIÓN GENERAL DE SALUD PÚBLICA: Fumar Causa Cáncer de "
"Pulmón, Enfermedades del Corazón, Enfisema y Puede Perjudicar el Embarazo."

#: lang/json/CONTAINER_from_json.py
