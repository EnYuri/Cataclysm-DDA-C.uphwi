#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Infected"
msgstr "Infectado"

#. ~ Name for scenario 'Infected' for a female character
#: lang/json/scenario_from_json.py
msgctxt "scenario_female"
msgid "Infected"
msgstr "Infectada"

#. ~ Description for scenario 'Infected' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"In the chaos and panic of evacuation, you got bitten by something!  You "
"didn't get proper medical care, and now the wound has started turning green."
msgstr ""
"Durante el caos y el pánico de la evacuación, ¡fuiste mordido por algo! No "
"recibiste el cuidado médico adecuado y ahora la herida se empezó a poner un "
"poco verde."

#. ~ Description for scenario 'Infected' for a female character.
#: lang/json/scenario_from_json.py
