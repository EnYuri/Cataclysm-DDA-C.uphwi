#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "SWAT CQC Specialist"
msgstr "Especialista SWAT CQC"

#. ~ Profession (male SWAT CQC Specialist) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"A member of the police force's most elite division, your close quarters "
"combat training has kept you alive thus far.  Unfortunately, the breakdown "
"of society has brought you to your current state of affairs; you now fight "
"to simply stay alive."
msgstr ""
"Miembro de la división de elite de la fuerza policial. Tu entrenamiento en "
"combate en espacios cerrados te ha mantenido vivo hasta ahora. "
"Lamentablemente, el colapso de la sociedad ahora te puso en otra situación: "
"tenés que pelear simplemente para seguir viviendo."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "SWAT CQC Specialist"
msgstr "Especialista SWAT CQC"

