#: lang/json/GENERIC_from_json.py
msgid ""
"This jar contains a floury paste that is slowly going bad.  Someday it will "
"be sourdough."
msgstr ""
"Este frasco contiene una pasta harinosa que se va poniendo fea de a poco. "
"Algún día se volverá masa fermentada."

