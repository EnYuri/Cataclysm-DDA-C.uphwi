#. ~ Use action msg for atomic lamp.
#: lang/json/GENERIC_from_json.py
msgid "You close the lamp's cover."
msgstr "Cierras la cubierta de la lámpara."

#. ~ Description for atomic lamp
#: lang/json/GENERIC_from_json.py
msgid ""
"Enjoy the serene Cherenkov-blue glow of the Rivtech atomic desk lamp, and "
"feel confident that you won't have to worry about depleting its power supply"
" for at least 40 million years of faithful service.  Use it to close the "
"cover and hide the light."
msgstr ""
"Disfrutá el sereno resplandor azulado de Cherenkov de la lámpara atómica "
"Rivtech, y quedate tranquilo que no se va a quedar sin energía por al menos "
"unos 40 millones de años más. Usala para cerrar la cubierta y ocultar la "
"luz."

