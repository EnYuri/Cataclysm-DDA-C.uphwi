msgid_plural "circuit boards"
msgstr[0] "placa de circuitos"
msgstr[1] "placas de circuitos"

#. ~ Description for circuit board
#: lang/json/GENERIC_from_json.py
msgid ""
"A printed card that supports and electrically connects electronic components"
" on a non-conductive substrate."
msgstr ""
"Un circuito impreso que soporta y conecta eléctricamente los componentes "
"electrónicos en un sustrato no conductivo."

#: lang/json/GENERIC_from_json.py
msgid "electronic scrap"
msgid_plural "electronic scraps"
msgstr[0] "chatarra electrónica"
msgstr[1] "chatarras electrónicas"

#. ~ Description for electronic scrap
#: lang/json/GENERIC_from_json.py
