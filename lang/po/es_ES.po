msgstr "¡%s es arrancado de las manos de <npcname>!"

#: src/monattack.cpp
#, c-format
msgid "The %s unsuccessfully attempts to pull your weapon away."
msgstr "El %s intenta arrancarte tu arma pero no lo logra."

#: src/monattack.cpp
#, c-format
msgid "The %s unsuccessfully attempts to pull <npcname>'s weapon away."
msgstr "El %s intenta arrancarle el arma a <npcname> pero no lo logra."

#: src/monattack.cpp
#, c-format
msgid "The %s spews bile!"
msgstr "¡El %s arroja bilis!"

#: src/monattack.cpp
#, c-format
msgid "Bile splatters on the %s!"
msgstr "¡Cae una salpicadura de bilis en el %s!"

#: src/monattack.cpp
msgid "You dodge it!"
msgstr "¡Lo esquivaste!"

#: src/monattack.cpp
msgid "<npcname> dodges it!"
msgstr "¡<npcname> lo esquiva!"

#: src/monattack.cpp
#, c-format
msgid "The %s throws its arms wide."
msgstr "El %s extiende mucho sus brazos."

#: src/monattack.cpp
#, c-format
msgid "The %s gesticulates wildly."
msgstr "El %s gesticula ampulosamente."

#: src/monattack.cpp
#, c-format
msgid "The %s gestures at a nearby corpse."
msgstr "El %s gesticula hacia un cadáver cercano."

#: src/monattack.cpp
#, c-format
msgid "A nearby %s rises from the dead!"
msgstr "¡Un %s cercano se levanta de su muerte!"

#: src/monattack.cpp
