msgstr[0] "reja de varillas"
msgstr[1] "rejas de varillas"

#. ~ Description for rebar grate
#: lang/json/GENERIC_from_json.py
msgid ""
"Interlocked sections of rebar that allows for light and effective "
"reinforcement of vehicle sections."
msgstr ""
"Varillas corrugadas entrelazadas, lo que permite pasar la luz y es un "
"refuerzo efectivo para partes de un vehículo."

#: lang/json/GENERIC_from_json.py lang/json/vehicle_part_from_json.py
msgid "shock absorber"
msgid_plural "shock absorbers"
msgstr[0] "amortiguador"
msgstr[1] "amortiguadores"

#. ~ Description for shock absorber
#: lang/json/GENERIC_from_json.py
msgid ""
"This makeshift combination of springs and scrap, when attached to a vehicle "
"section, protects that section from impacts.  The springs can absorb a "
"surprising amount of damage."
msgstr ""
"Cuando esta combinación improvisada de chatarra y resortes se pone en un "
"vehículo, protege esa parte de los impactos. Los resortes pueden absorber "
"una cantidad sorprendente de daño."

#: lang/json/GENERIC_from_json.py
msgid "massive engine block"
msgid_plural "massive engine blocks"
msgstr[0] "bloque enorme de motor"
msgstr[1] "bloques enormes de motor"

#. ~ Description for massive engine block
