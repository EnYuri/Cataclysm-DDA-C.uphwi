msgstr "¡El %1$s alimenta un %2$s y crece!"

#: src/monattack.cpp
#, c-format
msgid "The %s lays an egg!"
msgstr "¡El %s pone un huevo!"

#: src/monattack.cpp
#, c-format
msgid "The %s tends nearby eggs, and they hatch!"
msgstr "¡El %s cuida unos huevos cercanos, y estos rompen el cascarón!"

#: src/monattack.cpp
msgid "a terrible shriek!"
msgstr "¡un alarido terrible!"

#: src/monattack.cpp
#, c-format
msgid "The %s begins shrieking!"
msgstr "¡El %s empieza a chillar!"

#: src/monattack.cpp
msgid "a piercing wail!"
msgstr "¡un gemido penetrante!"

#: src/monattack.cpp
msgid "an ear-piercing howl!"
msgstr "¡un aullido que taladra el oído!"

#: src/monattack.cpp
msgid "a sibilant rattling sound!"
msgstr "¡un estertor sibilante!"

#: src/monattack.cpp
msgid "a spitting noise."
msgstr "el ruido de una escupida."

#: src/monattack.cpp
#, c-format
msgid "A glob of acid hits the %s!"
msgstr "¡Un gota de ácido golpea el %s!"

#: src/monattack.cpp
#, c-format
msgid "The %s barfs acid at you, but you dodge!"
msgstr "¡El %s te vomita ácido, pero lo esquivas!"

#: src/monattack.cpp
#, c-format
msgid "The %s barfs acid at <npcname>, but they dodge!"
msgstr "¡El %s le vomita ácido a <npcname>, pero lo esquiva!"

