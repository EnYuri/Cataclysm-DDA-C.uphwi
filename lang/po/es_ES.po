msgstr "¡Misión cumplida! No sé qué otra cosa decir."

#: lang/json/talk_topic_from_json.py
msgid "Glad to help.  I need no payment."
msgstr "Me alegra ayudar. No necesito que me paguen."

#: lang/json/talk_topic_from_json.py
msgid "How about some items as payment?"
msgstr "¿Qué tal algunos objetos como pago?"

#: lang/json/talk_topic_from_json.py
msgid "Maybe you can teach me something as payment?"
msgstr ""

#: lang/json/talk_topic_from_json.py
msgid "Glad to help.  I need no payment.  Bye!"
msgstr "Me alegra ayudar. No necesito que me paguen. ¡Adiós!"

#: lang/json/talk_topic_from_json.py
msgid "Well, um, sorry."
msgstr "Bueno, em, perdón."

#: lang/json/talk_topic_from_json.py
