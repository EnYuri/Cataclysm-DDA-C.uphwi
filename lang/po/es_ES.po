#: lang/json/COMESTIBLE_from_json.py
msgid "morel mushroom"
msgstr "colmenilla"

#. ~ Description for morel mushroom
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Prized by chefs and woodsmen alike, morel mushrooms are delicious but must "
"be cooked before they are safe to eat."
msgstr ""
"Premiado tanto por los chefs como por los leñadores, los hongos de tipo "
"colmenilla son deliciosos pero deben ser cocinados para que se puedan comer."

#: lang/json/COMESTIBLE_from_json.py
msgid "cooked morel mushroom"
