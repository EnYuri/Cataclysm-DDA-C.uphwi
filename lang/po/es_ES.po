msgid_plural "reloaded pistol ammo, AP"
msgstr[0] "munición AP recargada de pistola"
msgstr[1] "munición AP recargada de pistola"

#. ~ Description for reloaded pistol ammo, AP
#: lang/json/AMMO_from_json.py
