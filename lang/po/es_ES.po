#: lang/json/professions_from_json.py
msgctxt "profession_male"
msgid "Camper"
msgstr "Campista"

#. ~ Profession (male Camper) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You always enjoyed hiking and camping in the wilderness before everything "
"fell apart, so it was a no-brainer to grab your bag and run when the sirens "
"sounded.  The world may be ruined, but you're prepared to make a home "
"wherever you may find yourself."
msgstr ""
"Siempre disfrutaste salir de excursión y de camping en la naturaleza, antes "
"de que todo se vaya a la mierda. Así que te resultó fácil agarrar tu bolso y"
" salir corriendo cuando sonaron las sirenas. El mundo puede estar en ruinas,"
" pero estás preparado para convertir en tu hogar cualquier lugar que "
"encuentres."

#: lang/json/professions_from_json.py
msgctxt "profession_female"
msgid "Camper"
msgstr "Campista"

#. ~ Profession (female Camper) description
#: lang/json/professions_from_json.py
