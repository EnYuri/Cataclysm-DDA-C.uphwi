msgstr ""
"Un cilindro de acero compacto diseñado para sujetar a presión gases de "
"soldadura.  Está marcado con diversos símbolos desvanecidos y ahora "
"ilegibles."

#: lang/json/MAGAZINE_from_json.py
msgid "welding tank"
msgstr "tanque de soldadura"

#. ~ Description for welding tank
#: lang/json/MAGAZINE_from_json.py
msgid ""
"A large steel cylinder designed for holding pressurized welding gases.  It "
"is marked with several faded and now unreadable symbols."
msgstr ""
"Un cilindro de acero grande diseñado para sujetar a presión gases de "
"soldadura.  Está marcado con diversos símbolos desvanecidos y ahora "
"ilegibles."

