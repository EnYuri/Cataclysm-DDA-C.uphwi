#: lang/json/MAGAZINE_from_json.py
msgid ""
"An advanced 42-round auto-magazine.  Unlike previous generations of "
"magazines, this one uses microrobotics to load cartridges."
msgstr ""
"Es un autocargador avanzado de 42 balas. A diferencia de las generaciones "
"anteriores de cargadores, este utiliza microbótica para cargar los "
"cartuchos."

#: lang/json/MAGAZINE_from_json.py
