msgid "A simple pair of short shorts."
msgstr "Es un simple pantalón muy, muy corto."

#: lang/json/ARMOR_from_json.py
msgid "fur hot pants"
msgid_plural "fur hot pants"
msgstr[0] "minipantalón de piel"
msgstr[1] "minipantalones de piel"

#. ~ Description for fur hot pants
#: lang/json/ARMOR_from_json.py
msgid "A simple pair of fur short shorts."
msgstr "Es un simple pantalón muy, muy corto de piel."

#: lang/json/ARMOR_from_json.py
msgid "leather hot pants"
msgid_plural "leather hot pants"
msgstr[0] "minipantalón de cuero"
msgstr[1] "minipantalones de cuero"

#. ~ Description for leather hot pants
#: lang/json/ARMOR_from_json.py
msgid "A simple pair of leather short shorts."
msgstr "Es un simple pantalón muy, muy corto de cuero."

#: lang/json/ARMOR_from_json.py
msgid "housecoat"
msgid_plural "housecoats"
msgstr[0] "bata"
msgstr[1] "batas"

#. ~ Description for housecoat
#: lang/json/ARMOR_from_json.py
msgid "Makes you wish you had running water to take a shower."
msgstr ""
"Te hace tener ganas de que haya agua corriente para poder pegarte una ducha."

#: lang/json/ARMOR_from_json.py
msgid "heavy survivor suit"
msgid_plural "heavy survivor suits"
msgstr[0] "traje pesado de supervivencia"
msgstr[1] "trajes pesados de supervivencia"

#. ~ Description for heavy survivor suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A heavy, hand-built combination armor made from a reinforced bulletproof "
"vest and a metal-plated leather jumpsuit.  Protects from the elements as "
"well as from harm."
msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "army jacket"
msgid_plural "army jacket"
msgstr[0] "chaqueta militar"
msgstr[1] "chaquetas militares"

#. ~ Description for army jacket
#: lang/json/ARMOR_from_json.py
msgid "A tough jacket with lots of pockets.  Favored by the military."
msgstr ""
"Una chaqueta resistente con muchos bolsillos. De las favoritas de los "
"soldados."

#: lang/json/ARMOR_from_json.py
msgid "chef's jacket"
msgid_plural "chef's jackets"
msgstr[0] "uniforme de chef"
msgstr[1] "uniformes de chef"

#. ~ Description for chef's jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"This double-breasted uniform is unusually thick to protect against the heat "
"of the kitchen."
msgstr ""
"Este uniforme de doble botonadura es bastante grueso como para proteger "
"contra los calores de la cocina."

#: lang/json/ARMOR_from_json.py
msgid "emergency jacket"
msgid_plural "emergency jackets"
msgstr[0] "chaqueta de emergencia"
msgstr[1] "chaquetas de emergencia"

#. ~ Description for emergency jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A bright & cheaply made FEMA-issue windbreaker jacket with a hood.  One "
"size, fits none.  Helps keep you unfrozen & visible for rescuers."
msgstr ""
"Cortavientos con capucha de colores brillantes y materiales baratos, de las "
"que utiliza FEMA (Agencia Federal para la Gestión de Emergencias). Existe un"
" solo tamaño que no le queda bien a nadie. Impide que te congeles y te hace "
"bien visible para los rescatadores."

#: lang/json/ARMOR_from_json.py
msgid "flannel jacket"
msgid_plural "flannel jackets"
msgstr[0] "chaqueta de franela"
msgstr[1] "chaquetas de franela"

#. ~ Description for flannel jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A jacket made from flannel-style denim, favored by outdoorsy types.  "
"Provides decent protection from cuts."
msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "jean jacket"
msgid_plural "jean jackets"
msgstr[0] "chaqueta vaquera"
msgstr[1] "chaquetas vaqueras"

#. ~ Description for jean jacket
#: lang/json/ARMOR_from_json.py
msgid "A jacket made from denim.  Provides decent protection from cuts."
msgstr ""
"Una chaqueta hecha de tela vaquera. Ofrece buena protección contra las "
"heridas cortantes."

#: lang/json/ARMOR_from_json.py
msgid "leather jacket"
msgid_plural "leather jackets"
msgstr[0] "chaqueta de cuero"
msgstr[1] "chaquetas de cuero"

#. ~ Description for leather jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A jacket made from thick leather.  Cumbersome, but offers excellent "
"protection from cuts."
msgstr ""
"Una chaqueta hecha de cuero resistente. Incómoda, pero ofrece una excelente "
"protección contra heridas cortantes."

#: lang/json/ARMOR_from_json.py
msgid "armored leather jacket"
msgid_plural "armored leather jackets"
msgstr[0] "chaqueta reforzada de cuero"
msgstr[1] "chaquetas reforzadas de cuero"

#. ~ Description for armored leather jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"An armored jacket made from thick leather and metal plates.  Cumbersome, but"
" offers excellent protection from harm."
msgstr ""
"Es una chaqueta reforzada hecha de cuero resistente y placas de metal. "
"Incómoda, pero ofrece una excelente protección contra el daño."

#: lang/json/ARMOR_from_json.py
msgid "red leather jacket"
msgid_plural "red leather jackets"
msgstr[0] "chaqueta roja de cuero"
msgstr[1] "chaquetas rojas de cuero"

#. ~ Description for red leather jacket
#: lang/json/ARMOR_from_json.py
msgid ""
"A candy-apple-red leather jacket with black strips and shoulder protrusions."
"  It has a number of zippers and snaps in the front."
msgstr ""
"Es una chaqueta de cuero color rojo manzana, con rayas negras y hombreras. "
"Tiene varios cierres y broches en la parte de adelante."

#: lang/json/ARMOR_from_json.py
msgid "light jacket"
msgid_plural "light jackets"
msgstr[0] "chaqueta ligera"
msgstr[1] "chaquetas ligeras"

#. ~ Description for light jacket
#: lang/json/ARMOR_from_json.py
msgid "A thin cotton jacket with a hood.  Good for brisk weather."
msgstr ""
"Una chaqueta fina de algodón con capucha. Útil para cuando está fresco."

#: lang/json/ARMOR_from_json.py
msgid "windbreaker"
msgid_plural "windbreakers"
msgstr[0] "rompeviento"
msgstr[1] "rompevientos"

#. ~ Description for windbreaker
#: lang/json/ARMOR_from_json.py
msgid ""
"A light synthetic jacket with a hood.  Not very warm, but will keep out the "
"rain."
msgstr ""
"Un abrigo ligero sintético con capucha. No es muy abrigado, pero te protege "
"de la lluvia."

#: lang/json/ARMOR_from_json.py
msgid "jeans"
msgid_plural "jeans"
msgstr[0] "pantalón vaquero"
msgstr[1] "pantalones vaqueros"

#. ~ Description for jeans
#: lang/json/ARMOR_from_json.py
msgid "A pair of blue jeans with two deep pockets."
msgstr "Es un pantalón vaquero azul con dos bolsillos grandes."

#: lang/json/ARMOR_from_json.py
msgid "red jeans"
msgid_plural "red jeans"
msgstr[0] "pantalón vaquero rojo"
msgstr[1] "pantalones vaqueros rojos"

#. ~ Description for red jeans
#: lang/json/ARMOR_from_json.py
msgid "A pair of tight-fitting candy-apple-red jeans with two deep pockets."
msgstr ""
"Unos vaqueros ajustados de color rojo manzana con dos bolsillos grandes."

#: lang/json/ARMOR_from_json.py
msgid "Jedi cloak"
msgid_plural "Jedi cloaks"
msgstr[0] "capa de Jedi"
msgstr[1] "capas de Jedi"

#. ~ Description for Jedi cloak
#: lang/json/ARMOR_from_json.py
msgid ""
"Long, flowing robes.  Simple and comfortable to wear.  Be sure to tear it "
"off dramatically before fighting any foes!"
msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "jerrypack"
msgid_plural "jerrypacks"
msgstr[0] "bidón-chila"
msgstr[1] "bidón-chilas"

#. ~ Description for jerrypack
#: lang/json/ARMOR_from_json.py
msgid "A jerrycan modified to be worn in a similar manner to a backpack."
msgstr ""
"Es un bidón modificado para poder ser llevado en la espalda, como una "
"mochila."

#: lang/json/ARMOR_from_json.py
msgid "sports jersey"
msgid_plural "sports jerseys"
msgstr[0] "camiseta deportiva"
msgstr[1] "camisetas deportivas"

#. ~ Description for sports jersey
#: lang/json/ARMOR_from_json.py
msgid ""
"A shirt made of thick material imprinted with the name and logo of a sports "
"team."
msgstr ""
"Una camiseta hecha de un material grueso, con el nombre y el logo de un "
"equipo deportivo."

#: lang/json/ARMOR_from_json.py
msgid ""
"A pro thunderball jersey made of thick material imprinted with the logo of "
"the Decatur Fist."
msgstr ""
"Es una camiseta profesional de thunderball, hecha de un material grueso con "
"el logo de los Decatur Fist."

#: lang/json/ARMOR_from_json.py
msgid ""
"A 43-man squamish jersey made of thick material imprinted with the logo of "
"the Gainesville Veeblefetzers."
msgstr ""
"Una camiseta de 43-man squamish hecha de un material grueso con el logo de "
"los Gainesville Veeblefetzers."

#: lang/json/ARMOR_from_json.py
msgid ""
"A zero-G football jersey made of thick material imprinted with the logo of "
"the London Jets."
msgstr ""
"Una camiseta de fútbol sin gravedad, hecha de un material grueso con el logo"
" de los London Jets."

#: lang/json/ARMOR_from_json.py
msgid ""
"A football jersey made of thick material imprinted with the logo of the "
"Endsville Fluffycats."
msgstr ""
"Una camiseta de fútbol americano, hecha con un material grueso con el logo "
"de los Endsville Fluffycats."

#: lang/json/ARMOR_from_json.py
msgid ""
"A baseball jersey made of thick material imprinted with the logo of the "
"Tokyo Samurai."
msgstr ""
"Una camiseta de béisbol hecha de un material grueso, con el logo de los "
"Tokyo Samurai."

#: lang/json/ARMOR_from_json.py
msgid ""
"A basketball jersey made of thick material imprinted with the logo of the "
"Basin City Blues."
msgstr ""
"Una camiseta de baloncesto hecha de un material grueso, con el logo de los "
"Basin City Blues."

#: lang/json/ARMOR_from_json.py
msgid ""
"A death race jersey made of thick material imprinted with Frankenstein's "
"logo and signature."
msgstr ""
"Una camiseta de carrera de la muerte, hecha de un material grueso con el "
"logo de Frankenstein y su autógrafo."

#: lang/json/ARMOR_from_json.py
msgid ""
"A rollerball jersey made of thick material imprinted with the logo of the "
"Houston Energy Corporation."
msgstr ""
"Una camiseta de rollerball hecha de un material grueso, con el logo de los "
"Houston Energy Corporation."

#: lang/json/ARMOR_from_json.py
msgid ""
"A hockey jersey made of thick material imprinted with the logo of the "
"Monroeville Zombies."
msgstr ""
"Una camiseta de hockey hecha de un material grueso, con el logo de los "
"Monroeville Zombis."

#: lang/json/ARMOR_from_json.py
msgid "judo belt template"
msgid_plural "judo belt templates"
msgstr[0] "plantilla de cinturón de judo"
msgstr[1] "plantillas de cinturones de judo"

#. ~ Description for judo belt template
#: lang/json/ARMOR_from_json.py
msgid "This is a template for judo belts.  If found in a game it is a bug."
msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "black belt"
msgid_plural "black belts"
msgstr[0] "cinturón negro"
msgstr[1] "cinturones negros"

#. ~ Description for black belt
#: lang/json/ARMOR_from_json.py
msgid "A belt worn by martial arts practitioners, advertising a master."
msgstr ""
"El cinturón que usan los que practican artes marciales, este color significa"
" maestro."

#: lang/json/ARMOR_from_json.py
msgid "blue belt"
msgid_plural "blue belts"
msgstr[0] "cinturón azul"
msgstr[1] "cinturones azules"

#. ~ Description for blue belt
#: lang/json/ARMOR_from_json.py
msgid ""
"A belt worn by martial arts practitioners, advertising a strong "
"intermediate."
msgstr ""
"El cinturón que usan los que practican artes marciales, este color significa"
" intermedio avanzado."

#: lang/json/ARMOR_from_json.py
msgid "brown belt"
msgid_plural "brown belts"
msgstr[0] "cinturón marrón"
msgstr[1] "cinturones marrones"

#. ~ Description for brown belt
#: lang/json/ARMOR_from_json.py
msgid "A belt worn by martial arts practitioners, advertising a near-master."
msgstr ""
"El cinturón que usan los que practican artes marciales, este color significa"
" casi maestro."

#: lang/json/ARMOR_from_json.py
msgid "green belt"
msgid_plural "green belts"
msgstr[0] "cinturón verde"
msgstr[1] "cinturones verdes"

#. ~ Description for green belt
#: lang/json/ARMOR_from_json.py
msgid ""
"A belt worn by martial arts practitioners, advertising an intermediate."
msgstr ""
"El cinturón que usan los que practican artes marciales, este color significa"
" nivel intermedio."

#: lang/json/ARMOR_from_json.py
msgid "orange belt"
msgid_plural "orange belts"
msgstr[0] "cinturón naranja"
msgstr[1] "cinturones naranjas"

#. ~ Description for orange belt
#: lang/json/ARMOR_from_json.py
msgid ""
"A belt worn by martial arts practitioners, advertising a fresh intermediate."
msgstr ""
"El cinturón que usan los que practican artes marciales, este color significa"
" novato intermedio."

#: lang/json/ARMOR_from_json.py
msgid "white belt"
msgid_plural "white belts"
msgstr[0] "cinturón blanco"
msgstr[1] "cinturones blancos"

#. ~ Description for white belt
#: lang/json/ARMOR_from_json.py
msgid "A belt worn by martial arts practitioners, advertising a novice."
msgstr ""
"El cinturón que usan los que practican artes marciales, este color significa"
" principiante."

#: lang/json/ARMOR_from_json.py
msgid "yellow belt"
msgid_plural "yellow belts"
msgstr[0] "cinturón amarillo"
msgstr[1] "cinturones amarillos"

#. ~ Description for yellow belt
#: lang/json/ARMOR_from_json.py
msgid ""
"A belt worn by martial arts practitioners, advertising a moderate novice."
msgstr ""
"El cinturón que usan los que practican artes marciales, este color significa"
" principiante avanzado."

#: lang/json/ARMOR_from_json.py
msgid "judo gi"
msgid_plural "judo gis"
msgstr[0] "judogi"
msgstr[1] "judogis"

#. ~ Description for judo gi
#: lang/json/ARMOR_from_json.py
msgid ""
"Plain white judo gi.  Thick and a little stiff, it gives minor protection "
"from cuts and punches."
msgstr ""
"Un judogi blanco. Grueso y un poco rígido, ofrece un poco de protección "
"contra los cortes y las piñas."

#: lang/json/ARMOR_from_json.py
msgid "jumpsuit"
msgid_plural "jumpsuits"
msgstr[0] "mono de paracaidista"
msgstr[1] "monos de paracaidista"

#. ~ Description for jumpsuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, short-sleeved jumpsuit; similar to those worn by prisoners.  "
"Provides decent storage and is not very encumbering."
msgstr ""
"Un mono delgado de mangas cortas. parecido al que usan los prisioneros. "
"Brinda una capacidad de almacenamiento decente y no es incómodo."

#: lang/json/ARMOR_from_json.py
msgid "XL jumpsuit"
msgid_plural "XL jumpsuits"
msgstr[0] "mono de paracaidista XL"
msgstr[1] "monos de paracaidista XL"

#. ~ Description for XL jumpsuit
#: lang/json/ARMOR_from_json.py
msgid ""
"A thin, short-sleeved jumpsuit updated for the trans-human who needs full-"
"body clothing.  Provides some storage and is adjustable to minimize "
"encumbrance."
msgstr ""

#: lang/json/ARMOR_from_json.py
msgid "karate gi"
msgid_plural "karate gis"
msgstr[0] "karategi"
msgstr[1] "karategis"

#. ~ Description for karate gi
#: lang/json/ARMOR_from_json.py
msgid ""
"Plain white karate gi.  Loose and flowing, it offers little protection, and "
"little encumbrance."
msgstr ""
"Un karategi blanco. Suelto y flojo ofrece poca protección, pero es cómodo."

#: lang/json/ARMOR_from_json.py
msgid "kariginu"
msgid_plural "kariginus"
msgstr[0] "kariginu"
msgstr[1] "kariginus"

#. ~ Description for kariginu
#: lang/json/ARMOR_from_json.py
msgid ""
"A traditional, ankle-length Shinto robe with several layers and very wide "
"sleeves."
msgstr ""
"Una túnica tradicional sintoísta, larga hasta los tobillos, con varias capas"
" y mangas muy anchas."

#: lang/json/ARMOR_from_json.py
msgid "keffiyeh"
msgid_plural "keffiyehs"
msgstr[0] "kufiyya"
msgstr[1] "kufiyyas"

#. ~ Description for keffiyeh
#: lang/json/ARMOR_from_json.py
msgid ""
"A type of headdress traditionally used in the Middle East.  It can be used "
"in different ways to protect the head and mouth from the elements."
msgstr ""
"Es un tradicional pañuelo del Oriente Medio que se usa en la cabeza. Puede "
"ser usado de distintas maneras para cubrir la cabeza y la boca de la "
"intemperie."

#: lang/json/ARMOR_from_json.py
msgid "keikogi"
msgid_plural "keikogis"
msgstr[0] "keikogi"
msgstr[1] "keikogis"

#. ~ Description for keikogi
#: lang/json/ARMOR_from_json.py
msgid "Plain white keikogi for use in martial arts."
msgstr "Un keikogi blanco para utilizar en las artes marciales."

#: lang/json/ARMOR_from_json.py
msgid "Kevlar vest"
msgid_plural "Kevlar vests"
msgstr[0] "chaleco de Kevlar"
msgstr[1] "chalecos de Kevlar"

#. ~ Description for Kevlar vest
#: lang/json/ARMOR_from_json.py
msgid ""
"A lightweight, bullet resistant vest.  Suitable for wearing under clothing."
msgstr ""
"Es un chaleco ligero y anti-balas. Perfecto para utilizar debajo de la ropa."

#: lang/json/ARMOR_from_json.py
msgid "kilt"
msgid_plural "kilts"
msgstr[0] "kilt"
msgstr[1] "kilts"

#. ~ Description for kilt
#. ~ Description for leather kilt
#: lang/json/ARMOR_from_json.py
msgid "No true Scotsman would leave home without his kilt."
msgstr "Ningún escocés verdadero saldría de su casa sin su kilt."

#: lang/json/ARMOR_from_json.py
msgid "leather kilt"
msgid_plural "leather kilts"
msgstr[0] "falda de cuero"
msgstr[1] "faldas de cuero"

#: lang/json/ARMOR_from_json.py
msgid "kimono"
msgid_plural "kimonos"
msgstr[0] "kimono"
msgstr[1] "kimonos"

#. ~ Description for kimono
#: lang/json/ARMOR_from_json.py
msgid ""
"A traditional, ankle-length Japanese robe, wrapped around the body with a "
"sash."
msgstr ""
"Una túnica tradicional japonesa, larga hasta los tobillos, que se envuelve "
"alrededor del cuerpo con un cinto."

#: lang/json/ARMOR_from_json.py
msgid "kippah"
msgid_plural "kippahs"
msgstr[0] "kipá"
msgstr[1] "kipás"

#. ~ Description for kippah
#: lang/json/ARMOR_from_json.py
msgid "A thin, rounded skullcap.  A traditional headdress in Judaism."
msgstr "Un gorro redondo y fino. Un tocado tradicional del judaismo."

#: lang/json/ARMOR_from_json.py
msgid "kittel"
msgid_plural "kittels"
msgstr[0] "kittel"
msgstr[1] "kittels"

#. ~ Description for kittel
#: lang/json/ARMOR_from_json.py
msgid ""
"A white, knee-length cotton robe, traditionally worn by Jews on special "
"occasions."
msgstr ""
"Una túnica blanca de algodón, larga hasta las rodillas. Tradicionalmente, "
"usada por los judíos en ocasiones especiales."

#: lang/json/ARMOR_from_json.py
msgid "pair of knee pads"
msgid_plural "pairs of knee pads"
msgstr[0] "par de rodilleras"
msgstr[1] "pares de rodilleras"

#. ~ Description for pair of knee pads
#: lang/json/ARMOR_from_json.py
msgid "A pair of knee pads made of stout plastic and cloth."
msgstr "Un par de rodilleras hechas de plástico grueso y tela."

#: lang/json/ARMOR_from_json.py
msgid "kufi cap"
msgid_plural "kufi caps"
msgstr[0] "gorra kufi"
msgstr[1] "gorras kufi"

#. ~ Description for kufi cap
#: lang/json/ARMOR_from_json.py
msgid "A brimless, short and rounded cap."
msgstr "Una gorra corta y redonda, sin ala."

#: lang/json/ARMOR_from_json.py
msgid "leather belt"
msgid_plural "leather belts"
msgstr[0] "cinturón de cuero"
msgstr[1] "cinturones de cuero"

#. ~ Use action holster_msg for leather belt.
#: lang/json/ARMOR_from_json.py
#, no-python-format
msgid "You tuck your %s into your %s"
msgstr "Metes tu %s en tu %s."

#. ~ Use action holster_prompt for leather belt.
#: lang/json/ARMOR_from_json.py
msgid "Stick what into your belt"
msgstr "Qué es lo que quieres meter en el cinturón?"

#. ~ Description for leather belt
#: lang/json/ARMOR_from_json.py
msgid "A leather belt.  Useful for making your pair of pants fit."
msgstr "Cinturón de cuero. Útil para ajustar los pantalones."

#: lang/json/ARMOR_from_json.py
msgid "pair of leather cat ears"
msgid_plural "pairs of leather cat ears"
msgstr[0] "par de orejas de gato de cuero"
msgstr[1] "pares de orejas de gato de cuero"

#. ~ Description for pair of leather cat ears
#: lang/json/ARMOR_from_json.py
msgid ""
"A shiny pair of black cat ears on a headband.  It does nothing, but there's "
"no reason not to look good even if no one's looking."
msgstr ""
"Un hermoso par de orejas de gato negras en una diadema. No sirve para nada, "
"pero uno puede verse bien incluso cuando nadie mira."

#: lang/json/ARMOR_from_json.py
msgid "leather cat tail"
msgid_plural "leather cat tails"
msgstr[0] "cola de gato de cuero"
msgstr[1] "colas de gato de cuero"

#. ~ Description for leather cat tail
#: lang/json/ARMOR_from_json.py
msgid ""
"A glossy black leather tail weighted down with tiny beads of plastic.  Sways"
" behind you when you walk."
msgstr ""
"Una cola negra de cuero con unas bolitas de plástico para mantenerla "
"balanceada. Se mueve hacia los costados cuando caminas."

#: lang/json/ARMOR_from_json.py
msgid "leather collar"
msgid_plural "leather collars"
msgstr[0] "collar de cuero"
msgstr[1] "collares de cuero"

#. ~ Description for leather collar
#: lang/json/ARMOR_from_json.py
msgid ""
"A black leather 'collar' with a bell dangling from the front.  Don't worry, "
"the bell is silent."
msgstr ""
"Un collar negro de cuero con una campana colgando en la parte de adelante. "
"No te preocupes, no hace ruido."

#: lang/json/ARMOR_from_json.py
msgid "leather pouch"
msgid_plural "leather pouches"
msgstr[0] "bolso de cuero"
msgstr[1] "bolsos de cuero"

#. ~ Description for leather pouch
#: lang/json/ARMOR_from_json.py
msgid ""
"A bag stitched together from leather scraps.  Doesn't hold an awful lot but "
"is easy to wear."
msgstr ""
"Es un bolso hecho con pedazos de cuero cosidos. No puedes meterle una "
"barbaridad de cosas, pero es cómodo de usar."

#: lang/json/ARMOR_from_json.py
msgid "leg splint"
msgid_plural "leg splints"
msgstr[0] "tablilla para pierna"
msgstr[1] "tablillas para piernas"

#: lang/json/ARMOR_from_json.py
msgid "leg splint XL"
msgid_plural "leg splint XLs"
msgstr[0] ""
msgstr[1] ""

#. ~ Description for leg splint XL
#: lang/json/ARMOR_from_json.py
msgid ""
"A tool to help set bones and hold them in place.  It is specifically "
"designed to fit Huge people."
msgstr ""
"Es una pequeña madera que sirve para ayudar a mantener los huesos en su "
"lugar. Está específicamente diseñada para gente enorme."

#: lang/json/ARMOR_from_json.py
