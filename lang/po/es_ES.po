msgstr ""
"Unos calzoncillos largos que sirven para mantener la temperatura del cuerpo."

#: lang/json/ARMOR_from_json.py
msgid "long underwear top"
msgid_plural "long underwear tops"
msgstr[0] "camiseta de mangas largas"
msgstr[1] "camisetas de mangas largas"

#. ~ Description for long underwear top
#: lang/json/ARMOR_from_json.py
msgid "A long underwear top that helps to maintain body temperature."
msgstr ""
"Una camiseta de mangas largas que sirve para mantener la temperatura del "
"cuerpo."

#: lang/json/ARMOR_from_json.py
msgid "long-sleeved shirt"
msgid_plural "long-sleeved shirts"
msgstr[0] "camiseta de mangas largas"
msgstr[1] "camisetas de mangas largas"

#. ~ Description for long-sleeved shirt
