msgid "Tourist"
msgstr "Turista"

#. ~ Profession (male Tourist) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"You came here to get a taste of New England; Now you hope New England won't "
"get a taste of you!"
msgstr ""
"Viniste aquí para probar Nueva Inglaterra; ¡Ahora esperas que Nueva "
"Inglaterra no te \"pruebe\" a ti!"

