msgstr[0] "trapo empapado de desinfectante"
msgstr[1] "trapos empapados de desinfectante"

#. ~ Description for disinfectant soaked rag
#: lang/json/COMESTIBLE_from_json.py
msgid "A rag soaked in disinfectant."
msgstr "Es un trapo empapado en desinfectante."

#: lang/json/COMESTIBLE_from_json.py
