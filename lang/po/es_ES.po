msgid_plural "reloaded pistol ammo+"
msgstr[0] "munición+ recargada de pistola"
msgstr[1] "munición+ recargada de pistola"

#. ~ Description for reloaded pistol ammo+
#: lang/json/AMMO_from_json.py
