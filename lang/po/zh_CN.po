#, c-format
msgid "The %s says: %s"
msgstr "%s 上显示着：%s"

#: src/iuse_actor.cpp
#, c-format
msgid "The %s is empty!"
msgstr "%s 已经空了！"

#: src/iuse_actor.cpp
msgid "You can't do that while underwater"
msgstr "你在水下时无法这样做。"

