#, c-format
msgid "The caravan party has returned.  Your share of the profits are $%d!"
msgstr "商队回来了。你的利润份额是 $%d！"

#: src/mission_companion.cpp
msgid "The caravan was a disaster and your companions never made it home..."
msgstr "商队遇难了，你的同伴再也回不来了……"

