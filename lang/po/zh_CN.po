#, c-format
msgid "The %s tries to land on you, but you dodge."
msgstr "%s 试图落到你的身上，但是你躲开了。"

#: src/monattack.cpp
#, c-format
msgid "You swat at the %s with your tail!"
msgstr "你用尾巴抽打 %s！"

#: src/monattack.cpp
#, c-format
msgid "The %s lands on you, but you swat it off."
msgstr "%s 落在你身上，幸好你拍打掉了它。"

#. ~ 1$s monster name(dermatik), 2$s bodypart name in accusative.
#: src/monattack.cpp
#, c-format
msgid "The %1$s lands on your %2$s, but can't penetrate your armor."
msgstr "%1$s 落在了你的 %2$s 上，但是不能刺穿你的装甲。"

#. ~ 1$s monster name(dermatik), 2$s bodypart name in accusative.
#: src/monattack.cpp
#, c-format
