msgid "ceramic cup"
msgid_plural "ceramic cups"
msgstr[0] "陶瓷杯"

#. ~ Description for ceramic cup
#: lang/json/CONTAINER_from_json.py
msgid "A ceramic teacup, pinky out!"
msgstr ""
"一个陶瓷餐用器皿。\n"
"\"似乎正在思考自己的杯具命运。\""

