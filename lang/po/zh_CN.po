#: src/overmap.cpp
msgid "invalid"
msgstr "无效"

#: src/overmap.cpp
msgid ""
"Unable to place all configured specials, some missions may fail to "
"initialize."
msgstr "无法放置配置中的所有特殊地形，一些任务可能无法正常初始化。"

#: src/overmap.cpp
#, c-format
msgid ""
"This is emergency broadcast station %d%d.  Please proceed quickly and calmly"
" to your designated evacuation point."
msgstr "这是 %d%d 电台的紧急广播。请快速、冷静地移动到你的指定的疏散点。"

#: src/overmap.cpp
msgid "Head West.  All survivors, head West.  Help is waiting."
msgstr "往西走。所有的幸存者，往西走。那里有援助。"

#: src/overmap.cpp
#, c-format
msgid ""
"This is automated emergency shelter beacon %d%d.  Supplies, amenities and "
"shelter are stocked."
msgstr "这是自动应急避难所信标 %d%d。补给，设施，避难所被储存。"

#: src/overmap.cpp
#, c-format
msgid ""
"This is FEMA camp %d%d.  Supplies are limited, please bring supplemental "
"food, water, and bedding.  This is FEMA camp %d%d.  A designated long-term "
"emergency shelter."
msgstr "这是联邦应急管理局营地 %d%d。供应有限，请自行携带食物、水和床上用品。这是联邦应急管理局营地 %d%d。一个官方的长期应急避难所。"

#: src/overmap_ui.cpp
msgid "Notes:"
msgstr "备注："

#: src/overmap_ui.cpp
msgid "< Prev notes"
msgstr "< 上一条记录"

#: src/overmap_ui.cpp
msgid "Next notes >"
msgstr "下一条记录 >"

#: src/overmap_ui.cpp
msgid "Press letter to center on note"
msgstr "按下字母"

#: src/overmap_ui.cpp
msgid "Spacebar - Return to map  "
msgstr "空格 - 返回到地图"

#: src/overmap_ui.cpp
msgid "Zone:"
msgstr "区域："

#: src/overmap_ui.cpp
msgid "# Unexplored"
msgstr "# 未探索"

#: src/overmap_ui.cpp
#, c-format
msgid "Distance to target: %d"
msgstr "距离目标：%d"

#: src/overmap_ui.cpp
msgid "Use movement keys to pan."
msgstr "使用方向键平移地图。"

#: src/overmap_ui.cpp
#, c-format
msgid "%s - %s"
msgstr "%s - %s"

#: src/overmap_ui.cpp
