msgid "SWAT CQC Specialist"
msgstr "SWAT近战专家"

#. ~ Profession (male SWAT CQC Specialist) description
#: lang/json/professions_from_json.py
msgctxt "prof_desc_male"
msgid ""
"A member of the police force's most elite division, your close quarters "
