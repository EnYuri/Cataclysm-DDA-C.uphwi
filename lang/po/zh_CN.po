msgid "Concentrate and ask again."
msgstr "集中精神在试一次。"

#: src/iuse.cpp
msgid "Don't count on it."
msgstr "别做梦了。"

#: src/iuse.cpp
msgid "My reply is no."
msgstr "结果是不。"

#: src/iuse.cpp
msgid "My sources say no."
msgstr "占卜结果是不。"

#: src/iuse.cpp
msgid "Outlook not so good."
msgstr "占卜结果不那么乐观。"

#: src/iuse.cpp
msgid "Very doubtful."
msgstr "很值得怀疑。"

