msgid "Do you wish to liquidate the crop of %d %s for a profit of $%d?"
msgstr "是否将 %d %s 的作物折算成 $%d 的利润？"

#: src/mission_companion.cpp
#, c-format
msgid "The %s are liquidated for $%d..."
msgstr "%s 被折算为 $%d……"

#: src/mission_companion.cpp
#, c-format
msgid "You receive %d %s..."
msgstr "您收到 %d %s……"

#: src/mission_companion.cpp
#, c-format
msgid ""
"While scavenging, %s's party suddenly found itself set upon by a large mob "
"of undead..."
msgstr "拾荒的时候，%s 的团队突然发现他们被一大波不死者盯上了……"

