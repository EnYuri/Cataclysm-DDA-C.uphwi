msgstr "一个将枫糖浆和花生黄油混合创造出的全新口味三明治。"

#: lang/json/COMESTIBLE_from_json.py
msgid "fish sandwich"
msgid_plural "fish sandwiches"
msgstr[0] "鱼肉三明治"

#. ~ Description for fish sandwich
#: lang/json/COMESTIBLE_from_json.py
msgid "A delicious fish sandwich."
msgstr "一份三明治，里面夹着大块鲜美的鱼肉，非常美味。"

#: lang/json/COMESTIBLE_from_json.py
