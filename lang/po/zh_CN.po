msgid "There's nothing to light there."
msgstr "这里没有可以点燃的东西。"

#: src/iuse_actor.cpp
msgid "You successfully light a fire."
msgstr "你成功地生了火。"

#: src/iuse_actor.cpp
msgid "You light a fire, but it isn't enough. You need to light more."
msgstr "你点了一把火，但这还不够。你需要点更多的火。"

#: src/iuse_actor.cpp
msgid "You happily light a fire."
msgstr "你高兴地点了一把火。"

#: src/iuse_actor.cpp
msgid "This tool doesn't have enough charges."
msgstr "工具没有足够的使用次数或能量。"

#: src/iuse_actor.cpp
msgid "You need direct sunlight to light a fire with this."
msgstr "你需要直射的阳光才能用这玩意生火。"

#: src/iuse_actor.cpp
#, c-format
msgid ""
"If the current weather holds, it will take around %d minutes to light a "
"fire."
msgstr "如果天气不变，大概需要 %d 分钟来生火。"

#: src/iuse_actor.cpp
#, c-format
msgid "At your skill level, it will take around %d minutes to light a fire."
msgstr "按你当前技能等级，需要约 %d 分钟来生火。"

#: src/iuse_actor.cpp src/player.cpp
msgid "You do not have that item."
msgstr "你没有那东西。"

#: src/iuse_actor.cpp
#, c-format
msgid "Can't salvage anything from %s."
msgstr "无法从 %s 中回收任何东西。"

#: src/iuse_actor.cpp
#, c-format
msgid "Try disassembling the %s instead."
msgstr "可以尝试拆解 %s。"

