#: lang/json/CONTAINER_from_json.py
msgid "A half-liter glass jar with a metal screw top lid, used for canning."
msgstr "一个有金属螺旋盖的半升玻璃罐，一般用于罐头。"

#: lang/json/CONTAINER_from_json.py
