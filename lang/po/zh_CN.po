msgstr[0] "小塑料瓶"

#. ~ Description for small plastic bottle
#: lang/json/CONTAINER_from_json.py
msgid "A resealable plastic bottle, holds 250 ml of liquid."
msgstr "可再密封的塑料瓶，能储存250毫升液体。"

