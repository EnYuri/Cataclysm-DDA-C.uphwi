#: lang/json/snippet_from_json.py
msgid ""
"\"Don't let the ember go out please don't go out I need you precious fire.\""
msgstr "\"不要让灰烬熄灭！我需要这宝贵的火焰。\""

#: lang/json/snippet_from_json.py
msgid "\"ITS A TRAP NO WAIT ITS A TARP\""
msgstr "\"那是个陷阱！不，等等，那是个帐篷！\"（注：Trap和Tarp）"

