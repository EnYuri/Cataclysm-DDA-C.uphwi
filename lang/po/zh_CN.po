msgstr "在 %s 时，一个幽灵般的身影悄无声息地接近了 %s……"

#: src/faction_camp.cpp
#, c-format
msgid ""
"%s notices the antlered horror and slips away before it gets too close."
msgstr "%s 察觉到了这只可怕的鹿角怪物，并在它靠近前悄悄地溜走了。"

