msgstr "一个锡制罐子，多用于作为封闭的罐装食品的容器。"

#: lang/json/CONTAINER_from_json.py
msgid "opened tin can"
msgid_plural "opened tin cans"
msgstr[0] "锡罐（开）"

#. ~ Description for opened tin can
#: lang/json/CONTAINER_from_json.py
