#: data\mods\DinoMod\monster_attacks.json
msgid "%1$s's horn hit <npcname>, but they glance off their armor!"
msgstr "%1$s의 뿔이 <npcname>에게 닿았지만 갑옷에 미끄러졌습니다!"

