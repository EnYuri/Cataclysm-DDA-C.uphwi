msgid_plural "미니 팔괘로s"
msgstr[0] "미니 팔괘로"

#: data\mods\Touhou_com\item\gun.json
msgid ""
"마리사가 가진 마법 물품. 마력의 변환부터 조리 기구, 행운의 부적까지 많은 기능이 포함되어있었습니다. 이 세계에선 마법의 힘이 약화되어"
" 있지만, 그래도 마리사의 보물이란 사실은 변함없습니다."
msgstr ""
"마리사가 가진 마법 물품. 마력의 변환부터 조리 기구, 행운의 부적까지 많은 기능이 포함되어 있었습니다. 이 세계에선 마법의 힘이 "
"약화되어 있지만, 그래도 마리사의 보물이란 사실은 변함없습니다."

#: data\mods\Touhou_com\item\gun.json
