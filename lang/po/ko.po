msgid ""
"An antique brass lamp designed to run from a pressurized cylinder of "
"acetylene.  It is an efficient, if not somewhat dangerous light source."
msgstr "고압 아세틸린으로 작동하는 구식 놋쇠 램프. 상황에 따라 위험할 수 있다는 것만 빼면 효율적인 조명기구입니다."

#: data\json\items\tool\lighting.json
msgid "acetylene lamp (on)"
msgid_plural "acetylene lamps (on)"
msgstr[0] "아세틸렌 램프 (켜짐)"

#. ~ Use action msg for {'str': 'acetylene lamp (on)', 'str_pl': 'acetylene
#. lamps (on)'}.
#: data\json\items\tool\lighting.json
msgid "The %s is extinguished"
msgstr "%s이(가) 꺼졌다"

#: data\json\items\tool\lighting.json
msgid "reading light"
msgid_plural "reading lights"
msgstr[0] "독서등"

#. ~ Use action msg for {'str': 'reading light'}.
#: data\json\items\tool\lighting.json
msgid "You switch on the reading light."
msgstr "독서등을 켠다."

#. ~ Use action need_charges_msg for {'str': 'reading light'}.
#: data\json\items\tool\lighting.json
msgid "The reading light winks out."
msgstr "독서등이 꺼진다."

#. ~ Description for {'str': 'reading light'}
#: data\json\items\tool\lighting.json
msgid "A little clip-on LED light, meant for reading books in the dark."
msgstr "독서를 위한 소형 클립식 LED 조명이다."

#: data\json\items\tool\lighting.json
msgid "reading light (on)"
msgid_plural "reading lights (on)"
msgstr[0] "독서등 (켜짐)"

#. ~ Use action msg for {'str': 'reading light (on)', 'str_pl': 'reading
#. lights (on)'}.
#: data\json\items\tool\lighting.json
msgid "You switch off the reading light."
msgstr "독서등을 끈다."

#. ~ Description for {'str': 'reading light (on)', 'str_pl': 'reading lights
#. (on)'}
#: data\json\items\tool\lighting.json
msgid ""
"A little clip-on LED light, meant for reading books in the dark.  This one "
"is turned on."
msgstr "독서를 위한 소형 클립식 LED 조명이다. 현재 켜져 있다."

#: data\json\items\tool\lighting.json
msgid "smart lamp (off)"
msgid_plural "smart lamps (off)"
msgstr[0] "스마트 램프 (꺼짐)"

#. ~ Use action msg for {'str': 'smart lamp (off)', 'str_pl': 'smart lamps
#. (off)'}.
#: data\json\items\tool\lighting.json
msgid "You turn the smart lamp on."
msgstr "스마트 램프를 켰다."

#. ~ Use action need_charges_msg for {'str': 'smart lamp (off)', 'str_pl':
#. 'smart lamps (off)'}.
#: data\json\items\tool\lighting.json
msgid "The smart lamp batteries are dead."
msgstr "스마트 램프의 배터리가 다 되었다."

#. ~ Description for {'str': 'smart lamp (off)', 'str_pl': 'smart lamps
#. (off)'}
#: data\json\items\tool\lighting.json
msgid "This is a smart lamp, it can be activated remotely."
msgstr "스마트 램프. 원격으로 켤 수 있다."

#: data\json\items\tool\lighting.json
msgid "smart lamp (on)"
msgid_plural "smart lamps (on)"
msgstr[0] "스마트 램프 (켜짐)"

#. ~ Use action msg for {'str': 'smart lamp (on)', 'str_pl': 'smart lamps
#. (on)'}.
#: data\json\items\tool\lighting.json
msgid "Your smart lamp turned off"
msgstr "스마트 램프를 껐다."

#. ~ Description for {'str': 'smart lamp (on)', 'str_pl': 'smart lamps (on)'}
#: data\json\items\tool\lighting.json
msgid ""
"This is a smart lamp, this smart lamp is turned on.  It can be deactivated "
"remotely."
msgstr "스마트 램프. 현재 작동 중이다. 원격으로 끌 수 있다."

#: data\json\items\tool\lighting.json
msgid "torch"
msgid_plural "torches"
msgstr[0] "횃불"

#. ~ Use action menu_text for {'str': 'torch', 'str_pl': 'torches'}.
#. ~ Use action menu_text for {'str': 'everburning torch', 'str_pl':
#. 'everburning torches'}.
#: data\json\items\tool\lighting.json
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "Light torch"
msgstr "횃불 점화"

#. ~ Use action msg for {'str': 'torch', 'str_pl': 'torches'}.
#. ~ Use action msg for {'str': 'everburning torch', 'str_pl': 'everburning
#. torches'}.
#: data\json\items\tool\lighting.json
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "You light the torch."
msgstr "횃불에 불을 붙였다."

#. ~ Description for {'str': 'torch', 'str_pl': 'torches'}
#: data\json\items\tool\lighting.json
msgid ""
"This is a large stick, wrapped in rags that are soaked with a flammable "
"material.  When lit, produces a fair amount of light.  You'll need a lighter"
" or matches to light it."
msgstr "가연성 물질을 적신 천조각을 둘둘만 큰 막대. 불을 붙이면 상당히 밝아집니다. 불을 붙이려면 라이터나 성냥이 필요합니다."

#: data\json\items\tool\lighting.json
msgid "torch (lit)"
msgid_plural "torches (lit)"
msgstr[0] "횃불 (점화)"

#. ~ Use action msg for {'str': 'torch (lit)', 'str_pl': 'torches (lit)'}.
#. ~ Use action msg for {'str': 'everburning torch (lit)', 'str_pl':
#. 'everburning torches (lit)'}.
#: data\json\items\tool\lighting.json
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "The torch is extinguished."
msgstr "횃불이 꺼졌다."

#. ~ Description for {'str': 'torch (lit)', 'str_pl': 'torches (lit)'}
#: data\json\items\tool\lighting.json
msgid ""
"This is a large stick, wrapped in rags that are soaked with a flammable "
"material.  It is burning, producing plenty of light."
msgstr "가연성 물질을 적신 천조각을 둘둘만 큰 막대. 불이 타오르고 있어 주변을 환히 밝혀줍니다."

#: data\json\items\tool\masonry.json
msgid "masonry saw (off)"
msgid_plural "masonry saws (off)"
msgstr[0] "석공 톱 (꺼짐)"

#. ~ Use action msg for {'str': 'masonry saw (off)', 'str_pl': 'masonry saws
#. (off)'}.
#: data\json\items\tool\masonry.json
msgid "You turn on the masonry saw."
msgstr "석공 톱을 켰다."

#. ~ Description for {'str': 'masonry saw (off)', 'str_pl': 'masonry saws
#. (off)'}
#: data\json\items\tool\masonry.json
msgid ""
"This is a construction tool for cutting through concrete or other surfaces."
"  It runs on gasoline.  Using this item will cause it to turn on, turning it"
" into a very powerful but unwieldy melee weapon or a terrible chainsaw."
msgstr ""
"콘크리트나 다른 표면을 자르는 건설 도구입니다. 휘발유로 작동합니다. 이 아이템을 사용하면 켜져, 매우 강력하지만 다루기 힘든 근접 "
"무기나 끔찍한 전기톱이 됩니다."

#: data\json\items\tool\masonry.json
msgid "masonry saw (on)"
msgid_plural "masonry saws (on)"
msgstr[0] "석공 톱 (켜짐)"

#. ~ Use action msg for {'str': 'masonry saw (on)', 'str_pl': 'masonry saws
#. (on)'}.
#: data\json\items\tool\masonry.json
msgid "You turn off the masonry saw."
msgstr "석공 톱을 껐다."

#. ~ Description for {'str': 'masonry saw (on)', 'str_pl': 'masonry saws
#. (on)'}
#: data\json\items\tool\masonry.json
msgid ""
"This masonry saw is on and making a lot of noise.  Use it to turn it off."
msgstr "이 석공 톱은 켜져 있고 큰 소음을 내고 있습니다. 사용해 끕니다."

#: data\json\items\tool\masonry.json
msgid "grinder blade"
msgid_plural "grinder blades"
msgstr[0] "그라인더 날"

#. ~ Description for {'str': 'grinder blade'}
#: data\json\items\tool\masonry.json
msgid ""
"A 125mm angle grinder blade.  You could make a powertool with it, or throw "
"it.  Wielding it without sturdy gloves is a bad idea."
msgstr "125mm 앵글 그라인더 날입니다. 전동공구를 만들거나 던질 수 있습니다. 튼튼한 장갑 없이 휘두르는 건 나쁜 생각입니다."

#: data\json\items\tool\med.json
msgid "anesthesia kit"
msgid_plural "anesthesia kits"
msgstr[0] "마취 키트"

#. ~ Description for {'str': 'anesthesia kit'}
#: data\json\items\tool\med.json
msgid ""
"A kit for inducing anesthesia for surgery, containing specialized canisters "
"with a variety of powerful hypnotic, analgetic, and stimulative drugs.  It's"
" intended for use in specialized medical equipment, and can't be "
"administered manually."
msgstr ""
"수술을 위한 마취제가 포함된 키트. 전용 용기에 여러 가지 강력한 수면성, 환각성 흥분성 약물이 들어 있습니다. 전용 의료기기에 사용되는"
" 것이기 때문에 개별적으로 사용할 수 없습니다."

#: data\json\items\tool\med.json data\json\vehicleparts\crafting.json
msgid "autoclave"
msgid_plural "autoclaves"
msgstr[0] "오토클레이브"

#. ~ Description for {'str': 'autoclave'}
#: data\json\items\tool\med.json
msgid ""
"This is an autoclave.  It's useful for sterilizing things like CBMs.  It "
"requires a massive amount of power, so standard batteries will not power it "
"sufficiently.  Examine a non-sterile CBM and mend it to sterilize."
msgstr ""
"오토클레이브입니다. CBM 같은 걸 멸균하는 데 유용합니다. 막대한 전력이 필요해 일반 배터리로는 충분히 작동하지 않습니다. 비멸균 "
"CBM을 조사하고 수리해 멸균합니다."

#: data\json\items\tool\med.json
msgid "inhaler"
msgid_plural "inhalers"
msgstr[0] "흡입기"

#. ~ Description for {'str': 'inhaler'}
#: data\json\items\tool\med.json
msgid ""
"Albuterol inhaler.  Used in the treatment of bronchospasm, it is a lifeline "
"for people with asthma.  A mild stimulant, it may cause nervousness or "
"tremors."
msgstr ""
"기관지 수축 치료용으로 사용되는 알부테롤 흡입기. 천식이 있는 사람에게는 생명 유지에 필수적인 도구이다. 약한 각성효과가 있으며, "
"어지럼증과 약간의 떨림을 유발한다."

#: data\json\items\tool\med.json
msgid "RX12 jet injector"
msgid_plural "RX12 jet injectors"
msgstr[0] "RX12 제트 주사기"

#. ~ Description for {'str': 'RX12 jet injector'}
#: data\json\items\tool\med.json
msgid ""
"The Rivtech RX12 jet injector is a small pistol-shaped device used to inject"
" advanced fast-healing chemicals through the skin without using a needle.  A"
" label on the side warns against using more than two doses per hour."
msgstr ""
"바늘을 사용하지 않고 피부를 통해 주입하는 최신식 고속회복 약물에 사용하도록 만들어진 작은 권총 형태의 리브텍 제트 분사식 주사기. "
"측면의 라벨에 한 시간에 두 번 이상 사용하지 말라는 경고문구가 쓰여있다."

#: data\json\items\tool\med.json
msgid "scalpel"
msgid_plural "scalpels"
msgstr[0] "메스"

#. ~ Description for {'str': 'scalpel'}
#: data\json\items\tool\med.json
msgid ""
"This is a very sharp knife designed for surgical cutting.  Its small, sharp "
"blade allows for precision strikes in the hands of the skilled."
msgstr "수술 절개를 위해 설계된 매우 날카로운 칼이다. 작고 날카로운 날로 숙련된 손에서는 정밀한 타격이 가능하다."

#: data\json\items\tool\med.json
msgid "emergency oxygen pack"
msgid_plural "emergency oxygen packs"
msgstr[0] "비상용 산소팩"

#. ~ Description for {'str': 'emergency oxygen pack'}
#: data\json\items\tool\med.json
msgid ""
"This is a small tank of compressed medical oxygen with a folding regulator "
"and mask.  Commonly used in emergency situations, it provides immediate "
"relief for asthma attacks or smoke inhalation, and can provide a brief burst"
" of energy."
msgstr ""
"마스크와 접을 수 있는 산소조절기가 같이 있는 압축된 의료용 산소 팩. 일반적으로 비상상황에 사용하여, 천식 발작이나 연기 흡입상태에서 "
"회복할 수 있도록 도와주고 기운을 회복시켜줍니다."

#: data\json\items\tool\med.json
msgid "syringe"
msgid_plural "syringes"
msgstr[0] "주사기"

#. ~ Description for {'str': 'syringe'}
#: data\json\items\tool\med.json
msgid "A medical syringe.  Used for administering intravenous drugs."
msgstr "의료용 주사기. 약물을 정맥에 주사할 수 있다."

#. ~ Description for {'str_sp': 'DNA'}
#: data\json\items\tool\med.json
msgid ""
"The DNA sample of some living creature.  This can be used in a cloning vat, "
"together with a sterile artificial womb, to create a copy of the creature."
msgstr ""
"어떤 살아있는 생물의 DNA 샘플입니다. 멸균 인공자궁과 함께 클로닝 배트에서 그 생물의 복사본을 만드는 데 쓸 수 있습니다."

#: data\json\items\tool\med.json
msgid "universal growth medium"
msgid_plural "universal growth medium"
msgstr[0] "만능 성장 배지"

#. ~ Description for {'str_sp': 'universal growth medium'}
#: data\json\items\tool\med.json
msgid ""
"A heavily processed nutrient liquid, containing the basic building blocks of"
" life.  A genome workstation could take a stored sample off a USB drive, and"
" convert this raw material into viable DNA for cloning."
msgstr ""
"생명의 기본 구성 요소가 든 고도로 가공된 영양 액체입니다. 유전체 워크스테이션이 USB 드라이브에서 저장 샘플을 가져와 이 원료를 "
"클로닝용 생존 DNA로 변환할 수 있습니다."

#: data\json\items\tool\med.json
msgid "thermometer"
msgid_plural "thermometers"
msgstr[0] "온도계"

#. ~ Description for {'str': 'thermometer'}
#: data\json\items\tool\med.json
msgid "A plastic thermometer that can read the air temperature."
msgstr "기온을 알려주는 플라스틱 온도계."

#: data\json\items\tool\med.json
msgid "oxygen tank"
msgid_plural "oxygen tanks"
msgstr[0] "산소 탱크"

#. ~ Description for {'str': 'oxygen tank'}
#: data\json\items\tool\med.json
msgid ""
"This is tank of compressed medical oxygen with a regulator and mask.  "
"Commonly used in emergency situations, it provides immediate relief for "
"asthma attacks or smoke inhalation, and can provide a brief burst of energy."
msgstr ""
"마스크와 산소조절기가 같이 있는 압축된 의료용 산소 팩. 일반적으로 비상상황에 사용하여, 천식발작이나 연기 흡입상태에서 회복할 수 있도록"
" 도와주고 기운을 회복시켜줍니다."

#: data\json\items\tool\med.json
msgid "blood draw kit"
msgid_plural "blood draw kits"
msgstr[0] "채혈기"

#. ~ Description for {'str': 'blood draw kit'}
#: data\json\items\tool\med.json
msgid ""
"This is a kit for drawing blood, including a test tube for holding the "
"sample.  Use this tool to draw blood, either from yourself or from a corpse "
"you are standing on."
msgstr ""
"피를 뽑는 도구. 안에는 뽑아낸 피를 보관하는시험관이 들어 있습니다. 사용하면 자기 자신이나 발밑에 있는 시체의 피를 뽑습니다."

#: data\json\items\tool\med.json
msgid "wrapped radiation badge"
msgid_plural "wrapped radiation badges"
msgstr[0] "미사용 방사선 배지"

#. ~ Use action menu_text for {'str': 'wrapped radiation badge'}.
#: data\json\items\tool\med.json
msgid "Unwrap badge"
msgstr "배지 개봉"

#. ~ Use action msg for {'str': 'wrapped radiation badge'}.
#: data\json\items\tool\med.json
msgid ""
"You remove the badge from its wrapper, exposing it to ambient radiation."
msgstr "포장지에서 배지를 꺼내 주변의 방사선에 노출시켰다."

#. ~ Description for {'str': 'wrapped radiation badge'}
#: data\json\items\tool\med.json
msgid ""
"This is a badge that detects radiation dosage sealed in a radiation-blocking"
" bag.  Use it to remove it from the bag."
msgstr "방사능의 양을 측정하는 배지로 방사능이 닿지 않게 밀봉되어 있습니다. 사용하면 포장을 제거합니다."

#. ~ Description for {'str': 'anvil'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is an enormously heavy block of oddly shaped steel with a chisel-like "
"projection set into the corner.  It's used in most metalworking fabrication "
"recipes."
msgstr "모서리에 마치 조각도 같은 돌출부가 있는 특이한 모양의 엄청나게 무거운 철 덩어리. 대개 금속 세공 및 제작에 쓰입니다."

#: data\json\items\tool\metalworking.json
msgid "bronze anvil"
msgid_plural "bronze anvils"
msgstr[0] "청동 모루"

#. ~ Description for {'str': 'bronze anvil'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a block of oddly shaped bronze with a chisel-like projection set "
"into the corner.  It's used in most metalworking fabrication recipes."
msgstr "끝 모서리에 끌 모양의 돌기가 설정된 이상한 모양의 청동 블록이다. 대부분의 금속 가공 제작 레시피에 사용된다."

#: data\json\items\tool\metalworking.json
msgid "pair of bolt cutters"
msgid_plural "pairs of bolt cutters"
msgstr[0] "절단기"

#. ~ Description for {'str': 'pair of bolt cutters', 'str_pl': 'pairs of bolt
#. cutters'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a large pair of bolt cutters.  You could use them to cut padlocks or"
" heavy gauge wire."
msgstr "커다란 절단기. 사용하면 자물쇠나 굵은 철사를 잘라낼 수 있습니다."

#: data\json\items\tool\metalworking.json
msgid "charcoal forge"
msgid_plural "charcoal forges"
msgstr[0] "목탄 용광로"

#. ~ Description for {'str': 'charcoal forge'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a portable, charcoal fired, metalworking forge.  If combined with "
"the right tools, you could use this for metalworking, or it could be used to"
" repair metal items."
msgstr "휴대용 숯 연료 금속가공 용광로입니다. 적절한 도구와 결합하면 금속가공이나 금속 아이템 수리에 쓸 수 있습니다."

#. ~ Description for {'str': 'charcoal kiln'}
#: data\json\items\tool\metalworking.json
msgid ""
"A stout metal box used for producing charcoal via pyrolysis; the incomplete "
"burning of organic materials in the absence of oxygen."
msgstr ""
"열분해 작용을 이용해 목탄, 즉 숯을 만드는 튼튼한 철제 박스입니다. 산소 부족으로 인해 유기 물질이 완전히 타지 않는 원리를 사용해서 "
"숯이 만들어집니다."

#: data\json\items\tool\metalworking.json
msgid "metalworking chisel"
msgid_plural "metalworking chisels"
msgstr[0] "금속가공용 정"

#. ~ Description for {'str': 'metalworking chisel'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a short, stout metalworking chisel.  It's used in some metalworking "
"fabrication recipes."
msgstr "짧고 튼튼한 금속 가공용 정. 금속 세공 및 제작에 쓰입니다."

#: data\json\items\tool\metalworking.json
msgid "crucible"
msgid_plural "crucibles"
msgstr[0] "도가니"

#. ~ Description for {'str': 'crucible'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a small metalworking crucible.  It's used in some metalworking "
"fabrication recipes."
msgstr "작은 금속 가공용 도가니. 몇몇 금속 물품 제작에 쓰입니다."

#: data\json\items\tool\metalworking.json
msgid "clay crucible"
msgid_plural "clay crucibles"
msgstr[0] "점토 도가니"

#. ~ Description for {'str': 'clay crucible'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a primitive metalworking crucible made of clay.  You could use it "
"for metalworking."
msgstr "점토로 만들어진 원시적인 금속 가공용 도가니. 금속 가공에 쓸 수 있습니다."

#: data\json\items\tool\metalworking.json
msgid "electric forge"
msgid_plural "electric forges"
msgstr[0] "전기 용광로"

#. ~ Description for {'str': 'electric forge'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a portable electric metalworking forge, powered by batteries.  "
"Combined with the right tools, you could use this for metalworking, or it "
"could be used to repair metal items.  With a little mechanical know-how, you"
" could probably even convert it to run directly off a vehicle's power "
"system."
msgstr ""
"배터리로 작동하는 휴대용 전기 금속가공 용광로입니다. 적절한 도구와 결합하면 금속가공이나 금속 아이템 수리에 쓸 수 있습니다. 약간의 "
"기계 지식이 있다면 차량 전원 시스템에서 직접 작동하게 개조할 수도 있을 겁니다."

#: data\json\items\tool\metalworking.json
msgid "hydraulic press"
msgid_plural "hydraulic presss"
msgstr[0] "수력 압착기"

#. ~ Description for {'str': 'hydraulic press'}
#: data\json\items\tool\metalworking.json
msgid ""
"A large, barely portable hydraulic press, that uses a 36kW motor to squash "
"whatever needs squashing.  Do not put your hand in here, it will get "
"squashed.  Can run off heavy-duty batteries, installed to run off a power "
"grid, or mounted on a vehicle."
msgstr ""
"36kW 모터로 뭉개야 할 것을 뭉개는, 간신히 휴대 가능한 대형 유압 프레스입니다. 여기에 손을 넣지 마세요 — 뭉개집니다. 중량 "
"배터리로 작동하거나, 전력망에 연결하거나, 차량에 장착할 수 있습니다."

#: data\json\items\tool\metalworking.json
msgid "finished charcoal kiln"
msgid_plural "finished charcoal kilns"
msgstr[0] "목탄 가마 (완성됨)"

#. ~ Description for {'str': 'finished charcoal kiln'}
#: data\json\items\tool\metalworking.json
msgid ""
"A charcoal kiln that has finished burning.  Disassemble it to retrieve the "
"charcoal and kiln."
msgstr "연소 완료된 목탄 가마. 분해해서 숯과 목탄 가마를 회수할 수 있다."

#. ~ Use action menu_text for {'str': 'filled charcoal kiln'}.
#: data\json\items\tool\metalworking.json
msgid "Light wood"
msgstr "불 붙이기"

#. ~ Use action msg for {'str': 'filled charcoal kiln'}.
#: data\json\items\tool\metalworking.json
msgid "You light the wood."
msgstr "나무에 불을 붙였다."

#. ~ Use action need_fire_msg for {'str': 'filled charcoal kiln'}.
#: data\json\items\tool\metalworking.json
msgid "You need something to light it with!"
msgstr "불을 붙일게 필요하다!"

#. ~ Description for {'str': 'filled charcoal kiln'}
#: data\json\items\tool\metalworking.json
msgid ""
"A kiln filled with wood which will become charcoal after a slow period of "
"burning."
msgstr "나무로 가득 찬 목탄 가마. 나무가 천천히 연소되면 숯이 될 것이다."

#: data\json\items\tool\metalworking.json
msgid "lit charcoal kiln"
msgid_plural "lit charcoal kilns"
msgstr[0] "목탄 가마 (불붙음)"

#. ~ Use action msg for {'str': 'lit charcoal kiln'}.
#: data\json\items\tool\metalworking.json
msgid ""
"The kilns embers have died out, you can now disassemble it to harvest the "
"charcoal."
msgstr "가마에 남은 불씨가 전부 꺼졌다. 가마를 분해하면 목탄을 꺼낼 수 있다."

#. ~ Use action not_ready_msg for {'str': 'lit charcoal kiln'}.
#: data\json\items\tool\metalworking.json
msgid "The kiln is still burning."
msgstr "가마가 아직 타는 중입니다."

#. ~ Description for {'str': 'lit charcoal kiln'}
#: data\json\items\tool\metalworking.json
msgid "A kiln full of wood that has been lit; better drop it!"
msgstr "땔감이 가득 찬 가마에 불이 붙어있다. 그냥 놔두는 편이 좋을 것 같다."

#: data\json\items\tool\metalworking.json
msgid "chainmail sheet"
msgid_plural "chainmail sheets"
msgstr[0] "사슬 판"

#. ~ Description for {'str': 'chainmail sheet'}
#: data\json\items\tool\metalworking.json
msgid ""
"This is a sheet of riveted chainmail.  With some skill, several of these "
"sheets could be connected to make effective armor."
msgstr "리벳으로 연결된 쇠사슬 갑옷 판이다. 충분한 기술이 있다면 여러 판을 연결하여 효과적인 갑옷을 만들 수 있다."

#: data\json\items\tool\metalworking.json
msgid "swage and die set"
msgid_plural "swage and die sets"
msgstr[0] "거푸집과 금형기 세트"

#. ~ Description for {'str': 'swage and die set'}
#: data\json\items\tool\metalworking.json
msgid ""
"These are a set of swages and dies for metalsmithing.  These loops and metal"
" blocks are used in some metalworking fabrication recipes."
msgstr "금속 세공사를 위한 단조용 도구들. 이 고리와 금속 블록들은 금속 세공 및 제작에 쓰입니다."

#: data\json\items\tool\metalworking.json
msgid "pair of metal tongs"
msgid_plural "pairs of metal tongs"
msgstr[0] "금속 집게"

#. ~ Description for {'str': 'pair of metal tongs', 'str_pl': 'pairs of metal
#. tongs'}
#: data\json\items\tool\metalworking.json
msgid ""
"These are long, metal tongs.  They are commonly used for cooking or in "
"metalworking fabrication recipes."
msgstr "긴 금속 집게. 보통 요리나 금속 세공 및 제작에 쓰입니다."

#: data\json\items\tool\misc.json
msgid "compressed air horn"
msgid_plural "compressed air horns"
msgstr[0] "압축 공기 경적"

#. ~ Use action noise_message for {'str': 'compressed air horn'}.
#: data\json\items\tool\misc.json
msgid "HOOOOONK!"
msgstr "빠아아아아앙!"

#. ~ Use action use_message for {'str': 'compressed air horn'}.
#: data\json\items\tool\misc.json
msgid "You honk your airhorn."
msgstr "경적을 울렸다."

#. ~ Description for {'str': 'compressed air horn'}
#: data\json\items\tool\misc.json
msgid ""
"This is a small can of compressed air attached to a plastic horn.  Pressing "
"the button on top causes it to emit a loud honking sound."
msgstr "자그만 압축 공기캔이 달린 플라스틱 경적입니다. 버튼을 누르면 커다란 빵빵 소리를 냅니다."

#: data\json\items\tool\misc.json
msgid "alarm clock"
msgid_plural "alarm clocks"
msgstr[0] "알람 시계"

#. ~ Description for {'str': 'alarm clock'}
#: data\json\items\tool\misc.json
msgid ""
"A wind-up alarm clock.  Though the noise it makes is unpleasant to wake up "
"to, it's always good to get an early start to your day.  Can also be "
"disassembled into some useful parts."
msgstr ""
"태엽식 알람 시계. 아침에 시끄러운 소리를 들으며 깨어나는 건 기분 나쁘긴 하지만, 하루를 일찍 시작하는 것은 언제나 좋은 일이다. "
"분해하면 몇 가지 쓸모있는 부품을 얻을 수 있다."

#: data\json\items\tool\misc.json
msgid "cow bell"
msgid_plural "cow bells"
msgstr[0] "소 방울"

#. ~ Description for {'str': 'cow bell'}
#: data\json\items\tool\misc.json
msgid "A brass cow bell.  You feel like you need more of it."
msgstr "황동 소 종입니다. 더 필요한 기분이 듭니다."

#: data\json\items\tool\misc.json
msgid "entrenching tool"
msgid_plural "entrenching tools"
msgstr[0] "야전삽"

#. ~ Description for {'str': 'entrenching tool'}
#: data\json\items\tool\misc.json
msgid ""
"This is a stout collapsible spade.  It's commonly used by military forces "
"and favored by hikers for digging.  This was a popular weapon during WW1."
msgstr "굵직한 접이식 삽입니다. 군대에서 흔히 쓰이고 굴착을 좋아하는 등산객들이 선호합니다. 1차 대전 때 인기 무기였습니다."

#: data\json\items\tool\misc.json
msgid "etched human skull"
msgid_plural "etched human skulls"
msgstr[0] "아로새겨진 인간의 두개골"

#. ~ Description for {'str': 'etched human skull'}
#: data\json\items\tool\misc.json
msgid "This is a human skull with strange etchings covering it."
msgstr "기이한 문양이 아로새겨진 인간의 두개골이다."

#: data\json\items\tool\misc.json
msgid "flammable arrow"
msgid_plural "flammable arrows"
msgstr[0] "불화살"

#. ~ Description for {'str': 'flammable arrow'}
#: data\json\items\tool\misc.json
msgid ""
"This arrow has a rag soaked in a flammable liquid wrapped around the shaft "
"near the head.  You need to light it before shooting."
msgstr "화살대의 촉 근처에 인화성 액체에 적신 걸레가 감겨 있는 화살이다. 쏘기 전에 불을 붙여야 한다."

#: data\json\items\tool\misc.json
msgid "fur rollmat"
msgid_plural "fur rollmats"
msgstr[0] "모피 롤매트"

#. ~ Use action done_message for {'str': 'fur rollmat'}.
#: data\json\items\tool\misc.json
msgid "You unroll the fur mat and lay it on the ground."
msgstr "모피 매트를 펴 바닥에 자리를 잡았다."

#. ~ Description for {'str': 'fur rollmat'}
#: data\json\items\tool\misc.json
msgid ""
"This is a bedroll made of pelts which can be rolled up for transport.  It "
"insulates you from the floor, making it easier to sleep.  Use it to unroll "
"and place on the ground."
msgstr ""
"보관을 위해 단단히 말아놓은 털가죽 매트입니다. 바닥에서 나오는 냉기를 막아주어 자기 쉽게 합니다. 사용해서 일단 펴고, 땅에 "
"놓으십시오."

#: data\json\items\tool\misc.json
msgid "grappling hook"
msgid_plural "grappling hooks"
msgstr[0] "갈고리"

#. ~ Description for {'str': 'grappling hook'}
#: data\json\items\tool\misc.json
msgid ""
"A folding grappling hook attached to a stout 30-foot long piece of "
"lightweight cord.  Useful for keeping yourself safe from falls.  Can be used"
" in place of a long rope for butchering, in a pinch."
msgstr ""
"튼튼한 30피트 경량 로프에 달린 접이식 갈고리입니다. 낙하에서 자신을 지키는 데 유용합니다. 필요하면 도축용 긴 밧줄 대신 쓸 수 "
"있습니다."

#: data\json\items\tool\misc.json
msgid "grip hook"
msgid_plural "grip hooks"
msgstr[0] "그립 훅"

#. ~ Description for {'str': 'grip hook'}
#: data\json\items\tool\misc.json
msgid "A simple steel meathook with a circular steel handle."
msgstr "원형 강철 손잡이가 있는 간단한 강철 고기 갈고리입니다."

#: data\json\items\tool\misc.json
msgid "hand pump"
msgid_plural "hand pumps"
msgstr[0] "수동 펌프"

#. ~ Description for {'str': 'hand pump'}
#: data\json\items\tool\misc.json
msgid "This pump is suitable for pumping air into inflatable objects."
msgstr "공기를 넣어 무언가를 부풀릴 때 쓰는 펌프입니다."

#: data\json\items\tool\misc.json data\json\vehicleparts\sound.json
msgid "bicycle horn"
msgid_plural "bicycle horns"
msgstr[0] "자전거 경적"

#. ~ Use action use_message for {'str': 'bicycle horn'}.
#: data\json\items\tool\misc.json
msgid "You honk the bicycle horn."
msgstr "자전거 경적을 울렸다."

#. ~ Description for {'str': 'bicycle horn'}
#: data\json\items\tool\misc.json
msgid ""
"This is a simple bulb horn, found on many bicycles.  Use to honk.  Honk "
"honk."
msgstr "자전거에 많이 달려있는 전구처럼 생긴 경적. 사용하면 경적을 울릴 수 있습니다. 빵 빵."

#: data\json\items\tool\misc.json data\json\vehicleparts\sound.json
msgid "truck horn"
msgid_plural "truck horns"
msgstr[0] "트럭용 경적"

#. ~ Description for {'str': 'truck horn'}
#: data\json\items\tool\misc.json
msgid "This is a very loud horn, usually found on large trucks like semis."
msgstr "주로 큰 트럭에 달려있는 아주 시끄러운 경적."

#: data\json\items\tool\misc.json data\json\vehicleparts\sound.json
msgid "ship air horn"
msgid_plural "ship air horns"
msgstr[0] "선박 에어 혼"

#. ~ Description for {'str': 'ship air horn'}
#: data\json\items\tool\misc.json
msgid ""
"An enormous ship air horn, extremely loud and deafening.  Usually found on "
"large vessels."
msgstr "극도로 크고 귀머거리가 될 만큼 시끄러운 거대 선박 에어 혼입니다. 보통 대형 선박에서 찾을 수 있습니다."

#: data\json\items\tool\misc.json data\json\vehicleparts\sound.json
msgid "car horn"
msgid_plural "car horns"
msgstr[0] "차량용 경적"

#. ~ Description for {'str': 'car horn'}
#: data\json\items\tool\misc.json
msgid "This is a car horn meant to be attached to a car's electrical system."
msgstr "차량 전력으로 작동하는 차량용 경적."

#: data\json\items\tool\misc.json
msgid "large space heater"
msgid_plural "large space heaters"
msgstr[0] "대형 온풍기"

#. ~ Use action msg for {'str': 'large space heater'}.
#. ~ Use action msg for {'str': 'small space heater'}.
#: data\json\items\tool\misc.json
msgid "You turn on the heater."
msgstr "히터를 켰다."

#. ~ Use action need_charges_msg for {'str': 'large space heater'}.
#. ~ Use action need_charges_msg for {'str': 'small space heater'}.
#: data\json\items\tool\misc.json
msgid "The heater needs more charge."
msgstr "히터의 충전이 더 필요하다."

#. ~ Description for {'str': 'large space heater'}
#. ~ Description for {'str': 'large space heater (on)', 'str_pl': 'large space
#. heaters (on)'}
#: data\json\items\tool\misc.json
msgid ""
"A portable electric heater that steadily emits warm air.  Raises temperature"
" about 10 degrees C and fills a larger volume of air than the smaller "
"version."
msgstr "꾸준히 따뜻한 공기를 내는 휴대용 전기 히터입니다. 온도를 약 10도 C 올리고 소형 버전보다 더 큰 공기 부피를 채웁니다."

#. ~ Use action msg for {'str': 'large space heater (on)', 'str_pl': 'large
#. space heaters (on)'}.
#. ~ Use action msg for {'str': 'small space heater (on)', 'str_pl': 'small
#. space heaters (on)'}.
#: data\json\items\tool\misc.json
msgid "You turn off the heater."
msgstr "히터를 껐다."

#: data\json\items\tool\misc.json
msgid "lifestraw"
msgid_plural "lifestraws"
msgstr[0] "라이프스트로"

#. ~ Description for {'str': 'lifestraw'}
#: data\json\items\tool\misc.json
msgid ""
"Set the lifestraw in suspect water, let sit for one minute then drink.  The "
"two part filtration system will purify the water you drink.  Water taken "
"from uncertain sources like a river may be dirty."
msgstr ""
"라이프스트로를 의심스러운 물에 넣고 1분간 둔 후 마십니다. 2단계 여과 시스템이 마시는 물을 정수합니다. 강 같은 불확실한 출처의 물은"
" 더러울 수 있습니다."

#: data\json\items\tool\misc.json
msgid "mind splicer kit"
msgid_plural "mind splicer kits"
msgstr[0] "정신 접합 키트"

#. ~ Description for {'str': 'mind splicer kit'}
#: data\json\items\tool\misc.json
msgid ""
"Surgical forceps, cables and a modified smartphone inside a small plastic "
"pouch.  Assembled to steal the mind of some poor man, these are tools of the"
" creepy high-tech sandman."
msgstr ""
"작은 플라스틱 파우치 안의 수술 집게, 케이블, 개조 스마트폰입니다. 불쌍한 사람의 정신을 훔치기 위해 조립된, 섬뜩한 하이테크 샌드맨의"
" 도구입니다."

#: data\json\items\tool\misc.json
msgid "permanent marker"
msgid_plural "permanent markers"
msgstr[0] "마커"

#. ~ Use action gerund for {'str': 'permanent marker'}.
#. ~ Use action gerund for {'str': 'survival marker'}.
#. ~ Use action gerund for {'str': 'pen'}.
#. ~ Use action gerund for 메이드 기술[kawaii].
#: data\json\items\tool\misc.json data\json\items\tool\stationary.json
#: data\mods\2.7.4 KawaiiMaidMod\kawaii_bionic.json
msgid "Written"
msgstr "쓰여진"

#. ~ Use action verb for {'str': 'permanent marker'}.
#. ~ Use action verb for {'str': 'survival marker'}.
#. ~ Use action verb for {'str': 'pen'}.
#. ~ Use action verb for 메이드 기술[kawaii].
#: data\json\items\tool\misc.json data\json\items\tool\stationary.json
#: data\mods\2.7.4 KawaiiMaidMod\kawaii_bionic.json
msgid "Write"
msgstr "쓰기"

#. ~ Description for {'str': 'permanent marker'}
#: data\json\items\tool\misc.json
msgid ""
"This is a King Size(tm) industrial strength permanent marker, about halfway "
"between a typical marker and a can of spray paint in size.  Use it to write "
"something down.  However, writing \"Elbereth\" probably won't help you."
msgstr ""
"킹 사이즈 사의 공업용 반영구 마커. 일반적인 마커와 캔 스프레이의 중간 정도 되는 크기이다. 사용하면 글을 적을 수 있다. 이걸로 'Elbereth'를 땅에다 써도 도움을 받을 수는 없을 것이다.\r\n"
"(역주: 'Elbereth'는 톨킨의 실마릴리온 세계관에서 등장하는 용어이기도 하며, 특히 로그라이크 게임 '넷핵'에서 바닥에 이걸 쓰면 대부분의 적들이 다가오지 못 하게 만드는 능력을 가진 단어이다.)"

#: data\json\items\tool\misc.json
msgid "zombie pheromone"
msgid_plural "zombie pheromones"
msgstr[0] "좀비 페로몬"

#. ~ Description for {'str': 'zombie pheromone'}
#: data\json\items\tool\misc.json
msgid ""
"This is a disgusting ball of rotting meat of zombie origin.  Squeezing this "
"gland causes a small cloud of pheromones to spray into the air.  Apparently "
"the foul secretion can change zombies' attitude towards you, and they may "
"ignore you for a short period of time.  Perhaps they briefly consider you as"
" one of them."
msgstr ""
"좀비 기원의 썩은 고기가 뭉쳐진 역겨운 공입니다. 이 샘을 짜면 작은 페로몬 구름이 공중에 뿜어집니다. 분명 이 불결한 분비물이 좀비들의"
" 태도를 바꿔, 짧은 시간 당신을 무시할 수 있습니다. 아마 잠시 자기들 중 하나로 여기는 것 같습니다."

#: data\json\items\tool\misc.json
msgid "pocket watch"
msgid_plural "pocket watches"
msgstr[0] "회중시계"

#. ~ Description for {'str': 'pocket watch', 'str_pl': 'pocket watches'}
#: data\json\items\tool\misc.json
msgid ""
"An old-fashioned pocket watch.  This one tells you the time and looks good "
"doing it.  Can also be disassembled into some useful parts."
msgstr "구식 회중시계입니다. 시간을 알려주고 멋지게 보입니다. 유용한 부품으로 분해할 수도 있습니다."

#: data\json\items\tool\misc.json
msgid "rollmat"
msgid_plural "rollmats"
msgstr[0] "롤매트"

#. ~ Use action done_message for {'str': 'rollmat'}.
#: data\json\items\tool\misc.json
msgid "You unroll the mat and lay it on the ground."
msgstr "매트를 펴 바닥에 자리를 잡았다."

#. ~ Description for {'str': 'rollmat'}
#: data\json\items\tool\misc.json
msgid ""
"This is a sheet of foam which can be rolled tightly for storage.  It "
"insulates you from the floor, making it easier to sleep.  Use it to unroll "
"and place on the ground."
msgstr ""
"보관을 위해 단단히 말아놓은 스티로폼 시트입니다. 바닥에서 나오는 냉기를 막아주어 자기 쉽게 합니다. 사용해서 일단 펴고, 땅에 "
"놓으십시오."

#: data\json\items\tool\misc.json
msgid "safe deposit box"
msgid_plural "safe deposit boxes"
msgstr[0] "안전 금고"

#. ~ Description for {'str': 'safe deposit box', 'str_pl': 'safe deposit
#. boxes'}
#: data\json\items\tool\misc.json
msgid ""
"This is a secure combination lock box.  Sadly, you don't know the "
"combination.  Breaking inside it would destroy anything of value."
msgstr "조합식 잠금장치가 된 박스. 안타깝게도 정확한 조합을 모릅니다. 강제로 부숴 열면 내용물이 파괴됩니다."

#: data\json\items\tool\misc.json
msgid "sarcophagus access code"
msgid_plural "sarcophagus access codes"
msgstr[0] "석관 접근코드"

#. ~ Description for {'str': 'sarcophagus access code'}
#: data\json\items\tool\misc.json
msgid ""
"This printout is a string of numbers to access the elevator in the hazardous"
" waste sarcophagus."
msgstr "유해 폐기물을 봉인하는 석관의 엘리베이터를 작동시킬 수 있는 코드가 적힌 쪽지."

#: data\json\items\tool\misc.json
msgid "lab door override code"
msgid_plural "lab door override codes"
msgstr[0] "연구실 문 오버라이드 코드"

#. ~ Description for {'str': 'lab door override code'}
#: data\json\items\tool\misc.json
msgid ""
"This printout contains a one-time use emergency override code for any locked"
" door in a science lab."
msgstr "과학 연구실의 잠긴 문용 일회용 비상 오버라이드 코드가 담긴 인쇄물입니다."

#: data\json\items\tool\misc.json
msgid "small space heater"
msgid_plural "small space heaters"
msgstr[0] "소형 온풍기"

#. ~ Description for {'str': 'small space heater'}
#. ~ Description for {'str': 'small space heater (on)', 'str_pl': 'small space
#. heaters (on)'}
#: data\json\items\tool\misc.json
msgid ""
"A portable electric heater that steadily emits warm air.  Raises temperature"
" about 10 degrees C."
msgstr "꾸준히 따뜻한 공기를 내는 휴대용 전기 히터입니다. 온도를 약 10도 C 올립니다."

#: data\json\items\tool\misc.json
msgid "small space heater (on)"
msgid_plural "small space heaters (on)"
msgstr[0] "소형 온풍기 (켜짐)"

#: data\json\items\tool\misc.json
msgid "spray can"
msgid_plural "spray cans"
msgstr[0] "스프레이캔"

#. ~ Description for {'str': 'spray can'}
#: data\json\items\tool\misc.json
msgid ""
"This is a spray can, filled with paint.  Use this tool to make graffiti on "
"the floor or to paint objects."
msgstr "페인트가 든 스프레이 캔입니다. 이 도구로 바닥에 그래피티를 만들거나 물건을 칠합니다."

#: data\json\items\tool\misc.json
msgid "Prototype CMHP-9000"
msgid_plural "Prototype CMHP-9000s"
msgstr[0] "프로토타입 CMHP-9000"

#. ~ Description for {'str': 'Prototype CMHP-9000'}
#: data\json\items\tool\misc.json
msgid ""
"You dont really know what this is, it appears to be filled with paint. But "
"the paint seems to be shimmering and switching colors as you look at it. Use"
" this tool to make graffiti on the floor or to paint objects."
msgstr ""
"이게 뭔지는 잘 모르겠지만 페인트로 채워진 것 같습니다. 하지만 보고 있으면 페인트가 반짝이며 색이 바뀝니다. 이 도구로 바닥에 "
"그래피티를 만들거나 물건을 칠합니다."

#. ~ Description for {'str': 'stepladder'}
#: data\json\items\tool\misc.json
msgid "This is a wooden stepladder.  Use it to set it down."
msgstr "목제 발판 사다리. 사용(a)해서 설치할 수 있습니다."

#: data\json\items\tool\misc.json
msgid "survival marker"
msgid_plural "survival markers"
msgstr[0] "수제 마커"

#. ~ Description for {'str': 'survival marker'}
#: data\json\items\tool\misc.json
msgid ""
"This is a sharpened piece of charcoal that is almost guaranteed to make your"
" hands all covered in charcoal.  Use it to write something down."
msgstr "뾰족한 숯 조각. 사용하면 글을 적을 수 있다. 하지만 손에 숯검정이 묻을 것이다."

#: data\json\items\tool\misc.json
msgid "survivor telescope"
msgid_plural "survivor telescopes"
msgstr[0] "생존용 망원경"

#. ~ Description for {'str': 'survivor telescope'}
#: data\json\items\tool\misc.json
msgid ""
"A homemade collapsible telescope.  Too large and inaccurate to use as a "
"weapon scope, but carrying this item in your inventory will double the "
"distance that is mapped around you during your travels."
msgstr ""
"수제 접이식 망원경이다. 무기 조준경으로 사용하기엔 너무 크고 부정확하지만, 인벤토리에 넣고 다니면 이동 중 주변이 지도에 표시되는 "
"거리가 두 배가 된다."

#: data\json\items\tool\misc.json
msgid "tear gas payload"
msgid_plural "tear gas payloads"
msgstr[0] "최루가스 페이로드"

#. ~ Use action msg for {'str': 'tear gas payload'}.
#: data\json\items\tool\misc.json
msgid "You pull the pin on the payload."
msgstr "페이로드의 핀을 뽑았다."

#. ~ Description for {'str': 'tear gas payload'}
#: data\json\items\tool\misc.json
msgid ""
"This is a dummy item used by tear gas hacks.  You should never see it "
"outside of debug."
msgstr "최루가스 핵이 쓰는 더미 아이템입니다. 디버그 외엔 절대 볼 일이 없습니다."

#: data\json\items\tool\misc.json
msgid "active tear gas payload"
msgid_plural "active tear gas payloads"
msgstr[0] "활성 최루가스 페이로드"

#. ~ Description for {'str': 'active tear gas payload'}
#: data\json\items\tool\misc.json
msgid ""
"This is a dummy item used by tear gas hacks that just so happens to be "
"counting down.  You should never see it outside of debug."
msgstr "마침 카운트다운 중인, 최루가스 핵이 쓰는 더미 아이템입니다. 디버그 외엔 절대 볼 일이 없습니다."

#: data\json\items\tool\misc.json
msgid "telescoping umbrella"
msgid_plural "telescoping umbrellas"
msgstr[0] "접이식 우산"

#. ~ Description for {'str': 'telescoping umbrella'}
#: data\json\items\tool\misc.json
msgid ""
"A telescoping umbrella which collapses down for easy storage, useful for "
"keeping dry when wielded."
msgstr "편하게 들고다니기 위해서 접이식으로 만든 접이식 우산입니다. 휘두르면 쉽게 말릴 수 있습니다."

#: data\json\items\tool\misc.json
msgid "Flaming Chunk of Steel +2"
msgid_plural "Flaming Chunks of Steel +2"
msgstr[0] "불타는 강철 조각 +2"

#. ~ Description for {'str': 'Flaming Chunk of Steel +2', 'str_pl': 'Flaming
#. Chunks of Steel +2'}
#: data\json\items\tool\misc.json
msgid "HOLY SHIT THIS THING IS ON FIRE"
msgstr "이런 젠장 이건 불타고 있잖아"

#: data\json\items\tool\misc.json data\mods\Arcana_BN\items\tools.json
msgid "Whistle of Tindalos"
msgid_plural "Whistles of Tindalos"
msgstr[0] "틴달로스의 호루라기"

#. ~ Description for {'str': 'Whistle of Tindalos', 'str_pl': 'Whistles of
#. Tindalos'}
#: data\json\items\tool\misc.json
msgid "Who is this Tindalos guy?"
msgstr "틴달로스라는 사람이 누구지?"

#: data\json\items\tool\misc.json
msgid "umbrella"
msgid_plural "umbrellas"
msgstr[0] "우산"

#. ~ Description for {'str': 'umbrella'}
#: data\json\items\tool\misc.json
msgid "An umbrella with a pointy end, useful for keeping dry when wielded."
msgstr "끝이 뾰족한 우산입니다. 장비하면 비를 피할 수 있습니다."

#: data\json\items\tool\misc.json
msgid "vortex stone"
msgid_plural "vortex stones"
msgstr[0] "볼텍스 스톤"

#. ~ Description for {'str': 'vortex stone'}
#: data\json\items\tool\misc.json
msgid ""
"This is a stone with spirals all over it, and holes around its perimeter.  "
"Though it is fairly large, it weighs next to nothing.  Air seems to gather "
"around it."
msgstr ""
"나선이 빼곡히 새겨진 돌. 주변부에 구멍이 많이 뚫려있다. 꽤 큼직하지만, 무게는 그리 많이 나가지 않는다. 바람이 주위로 모여드는 것 "
"같다."

#: data\json\items\tool\misc.json
msgid "whistle multitool"
msgid_plural "whistle multitools"
msgstr[0] "호루라기 멀티툴"

#. ~ Description for {'str': 'whistle multitool'}
#: data\json\items\tool\misc.json
msgid ""
"A cheap gadget combining a whistle, thermometer, magnifying glass, and "
"compass."
msgstr "호루라기, 온도계, 돋보기, 나침반을 결합한 저렴한 도구다."

#: data\json\items\tool\misc.json
msgid "handmade pocket watch"
msgid_plural "handmade pocket watches"
msgstr[0] "수제 회중시계"

#. ~ Description for {'str': 'handmade pocket watch', 'str_pl': 'handmade
#. pocket watches'}
#: data\json\items\tool\misc.json
msgid ""
"An old-fashioned pocket watch, useful for telling the time and not much "
"else."
msgstr "구식 회중시계로, 시간을 알려주는 것 외엔 별 쓸모가 없습니다."

#: data\json\items\tool\misc.json
msgid "artificial womb"
msgid_plural "artificial wombs"
msgstr[0] "인공자궁"

#. ~ Use action friendly_msg for {'str': 'artificial womb'}.
#: data\json\items\tool\misc.json
msgid "The cloned creature seems to enjoy your presence."
msgstr "클론 생물이 당신의 존재를 좋아하는 것 같다."

#. ~ Use action hostile_msg for {'str': 'artificial womb'}.
#: data\json\items\tool\misc.json
msgid "The cloned creature seems aloof to you!"
msgstr "클론 생물이 당신에게 무관심한 것 같다!"

#. ~ Description for {'str': 'artificial womb'}
#: data\json\items\tool\misc.json
msgid ""
"This artificial womb holds a nearly fully grown clone, nurtured from "
"extracted DNA within a cloning vat.  Activate it, and the organism will "
"swiftly complete its development and emerge ready to function.  Ideal for "
"quickly repopulating herds, restoring endangered species, or deploying "
"engineered creatures with minimal wait."
msgstr ""
"이 인공자궁은 클로닝 배트에서 추출 DNA로 키운 거의 다 자란 클론을 담고 있습니다. 활성화하면 유기체가 신속히 발달을 완료하고 기능할"
" 준비가 된 채 나옵니다. 무리를 빠르게 재충원하거나, 멸종 위기종을 복원하거나, 최소 대기로 설계 생물을 배치하는 데 이상적입니다."

#. ~ Description for {'str': 'artificial womb'}
#: data\json\items\tool\misc.json
msgid ""
"A single-use vessel for transporting clones safely from the cloning vat to "
"the field.  Currently empty, if sufficiently sterile it can be used by a "
"cloning vat to grow a creature from a viable DNA sample. "
msgstr ""
"클로닝 배트에서 현장으로 클론을 안전하게 운반하는 일회용 용기입니다. 현재 비어 있고, 충분히 멸균됐다면 클로닝 배트가 생존 DNA "
"샘플로 생물을 키우는 데 쓸 수 있습니다."

#: data\json\items\tool\misc.json
msgid "object variable viewer"
msgid_plural "object variable viewers"
msgstr[0] "오브젝트 변수 뷰어"

#. ~ Description for {'str': 'object variable viewer'}
#: data\json\items\tool\misc.json
msgid ""
"A compact analyzer that scans any nearby object and reveals every stored "
"variable for quick debugging without needing to drop the object.  It can "
"also add, update, or remove item variables."
msgstr ""
"근처 오브젝트를 스캔하고 저장된 모든 변수를 보여줘, 오브젝트를 내려놓지 않고 빠르게 디버그할 수 있는 소형 분석기입니다. 아이템 변수를"
" 추가, 갱신, 제거할 수도 있습니다."

#: data\json\items\tool\musical_instruments.json
msgid "banjo"
msgid_plural "banjos"
msgstr[0] "밴조"

#. ~ Description for {'str': 'banjo'}
#: data\json\items\tool\musical_instruments.json
msgid "A standard factory-made banjo.  Looks to be in working condition."
msgstr "표준적인 공장제 밴조. 상태가 나쁘지 않다."

#: data\json\items\tool\musical_instruments.json
msgid "bone flute"
msgid_plural "bone flutes"
msgstr[0] "뼈 플루트"

#. ~ Description for {'str': 'bone flute'}
#: data\json\items\tool\musical_instruments.json
msgid "A polished bone flute with five finger holes."
msgstr "5개의 손가락 구멍이 있는 뼈 플루트."

#: data\json\items\tool\musical_instruments.json
msgid "wooden flute"
msgid_plural "wooden flutes"
msgstr[0] "나무 피리"

#. ~ Description for {'str': 'wooden flute'}
#: data\json\items\tool\musical_instruments.json
msgid "A simple flute carved from wood with five finger holes."
msgstr "다섯 개의 손가락 구멍이 있는, 나무로 깎은 간단한 피리입니다."

#: data\json\items\tool\musical_instruments.json
msgid "clarinet"
msgid_plural "clarinets"
msgstr[0] "클라리넷"

#. ~ Description for {'str': 'clarinet'}
#: data\json\items\tool\musical_instruments.json
msgid "An ornate clarinet made from wood."
msgstr "나무로 만들어진 화려한 클라리넷."

#: data\json\items\tool\musical_instruments.json
msgid "flute"
msgid_plural "flutes"
msgstr[0] "플루트"

#. ~ Description for {'str': 'flute'}
#: data\json\items\tool\musical_instruments.json
msgid "A simple silver-plated flute."
msgstr "은 도금된 평범한 플루트."

#: data\json\items\tool\musical_instruments.json
msgid "trumpet"
msgid_plural "trumpets"
msgstr[0] "트럼펫"

#. ~ Description for {'str': 'trumpet'}
#: data\json\items\tool\musical_instruments.json
msgid "A brass trumpet with only a few dents here and there."
msgstr "여기저기 몇 군데 함몰이 있는 황동 트럼펫이다."

#: data\json\items\tool\musical_instruments.json
msgid "ukulele"
msgid_plural "ukuleles"
msgstr[0] "우쿨렐레"

#. ~ Description for {'str': 'ukulele'}
#: data\json\items\tool\musical_instruments.json
msgid "A small factory made ukulele.  Looks to be in working condition."
msgstr "작은 공장제 우쿨렐레. 상태가 나쁘지 않다."

#: data\json\items\tool\musical_instruments.json
msgid "violin"
msgid_plural "violins"
msgstr[0] "바이올린"

#. ~ Description for {'str': 'violin'}
#: data\json\items\tool\musical_instruments.json
msgid ""
"A cheap, factory-made violin with a built-in holder for a bow.  Still "
"produces a nice sound."
msgstr "저렴한 공장제 바이올린. 활을 넣어둘 수 있는 수납공간이 달려있다. 여전히 좋은 음색을 낸다."

#: data\json\items\tool\musical_instruments.json
msgid "golden fiddle"
msgid_plural "golden fiddles"
msgstr[0] "금색 바이올린"

#. ~ Description for {'str': 'golden fiddle'}
#: data\json\items\tool\musical_instruments.json
msgid ""
"A shiny golden fiddle, with a strange aura around it.  You feel like it once"
" belonged to the best there's ever been."
msgstr "반짝이는 황금색 바이올린. 이상한 기운이 서려 있다. 반드시 가져야 할 것 같은 느낌이 든다."

#: data\json\items\tool\pets.json
msgid "chicken cage"
msgid_plural "chicken cages"
msgstr[0] "닭장"

#. ~ Description for {'str': 'chicken cage'}
#: data\json\items\tool\pets.json
msgid ""
"A wire container made for transporting chickens, but you can use it to hold "
"any tiny animal.  Use it on a suitable animal to capture, use it on an empty"
" tile to release."
msgstr ""
"닭을 운반할 때 사용하는 닭장이지만, 작은 동물을 가둘 때 사용할 수 있습니다. 작은 동물을 포획한 다음, 풀어줄 때에는 빈 타일위에 "
"풀어줄 수 있다."

#: data\json\items\tool\pets.json
msgid "dog whistle"
msgid_plural "dog whistles"
msgstr[0] "개 호루라기"

#. ~ Description for {'str': 'dog whistle'}
#: data\json\items\tool\pets.json
msgid ""
"This is a small whistle.  When used, it produces a high tone that causes "
"nearby friendly dogs to either follow you closely and stop attacking, or "
"start attacking enemies if they are currently docile."
msgstr ""
"작은 호루라기. 사용하면 높은음을 내어 근처의 우호적인 개를 가까이 부르거나, 적을 공격하는 것을 멈추게 할 수 있으며, 얌전한 상태에서"
" 사용하면 적을 공격하게 할 수도 있습니다."

#: data\json\items\tool\pets.json
msgid "shears"
msgid_plural "shears"
msgstr[0] "가위"

#. ~ Description for {'str_sp': 'shears'}
#: data\json\items\tool\pets.json
msgid "This is a set of shears designed to obtain wool from sheep."
msgstr "양털을 얻기 위해 설계된 가위 한 쌍입니다."

#: data\json\items\tool\pets.json
msgid "electric shears"
msgid_plural "electric shears"
msgstr[0] "전기 가위"

#. ~ Description for {'str_sp': 'electric shears'}
#: data\json\items\tool\pets.json
msgid "These electric shears can be used to shear animals quicker."
msgstr "이 전기 가위로 동물을 더 빨리 깎을 수 있습니다."

#: data\json\items\tool\pets.json
msgid "horse tack"
msgid_plural "horse tacks"
msgstr[0] "말 마구"

#. ~ Description for {'str': 'horse tack'}
#: data\json\items\tool\pets.json
msgid ""
"A saddle, bridle, and associated tack that can be placed on a tamed animal "
"that is capable of being ridden."
msgstr "길들여진 탈 수 있는 동물에게 씌울 수 있는 안장, 굴레, 관련 마구입니다."

#: data\json\items\tool\pets.json
msgid "pet carrier"
msgid_plural "pet carriers"
msgstr[0] "애완동물 이동장"

#. ~ Description for {'str': 'pet carrier'}
#: data\json\items\tool\pets.json
msgid ""
"A plastic container meant to hold pets for transport.  Use it on a suitable "
"animal to capture, use it on an empty tile to release."
msgstr "반려동물 운반을 위한 플라스틱 용기다. 적합한 동물에 사용하여 포획하거나, 빈 타일에 사용하여 방출한다."

#: data\json\items\tool\pets.json
msgid "wooden pet carrier"
msgid_plural "wooden pet carriers"
msgstr[0] "나무 반려동물 운반기"

#. ~ Description for {'str': 'wooden pet carrier'}
#: data\json\items\tool\pets.json
msgid ""
"A wooden container meant to hold pets for transport.  Use it on a suitable "
"animal to capture, use it on an empty tile to release."
msgstr "운송용 반려동물을 담는 나무 용기입니다. 적합한 동물에게 사용해 포획하고, 빈 타일에 사용해 풀어줍니다."

#: data\json\items\tool\pets.json
msgid "wooden dog whistle"
msgid_plural "wooden dog whistles"
msgstr[0] "나무 개 호루라기"

#. ~ Description for {'str': 'wooden dog whistle'}
#: data\json\items\tool\pets.json
msgid ""
"This is a whistle carved out of hardwood.  When used, it produces a high "
"tone that causes nearby friendly dogs to either follow you closely and stop "
"attacking, or start attacking enemies if they are currently docile."
msgstr ""
"단단한 나무로 깎은 호루라기입니다. 사용하면 높은 음이 나와, 근처 아군 개가 가까이 따라오며 공격을 멈추거나, 얌전하다면 적 공격을 "
"시작하게 합니다."

#: data\json\items\tool\radio_tools.json
msgid "radio car base"
msgid_plural "radio car bases"
msgstr[0] "무선 자동차 베이스"

#. ~ Description for {'str': 'radio car base'}
#: data\json\items\tool\radio_tools.json
msgid "Generic radio car kit, you shouldn't see this."
msgstr "일반 무선 자동차 키트입니다. 이걸 보면 안 됩니다."

#: data\json\items\tool\radio_tools.json
msgid "radio car box"
msgid_plural "radio car boxes"
msgstr[0] "RC카 상자"

#. ~ Description for {'str': 'radio car box', 'str_pl': 'radio car boxes'}
#: data\json\items\tool\radio_tools.json
msgid ""
"An RC car, with radio-control and batteries included!  Disassemble to unpack"
" and enjoy."
msgstr "무선 조종과 배터리가 포함된 RC 카입니다! 분해해 꺼내고 즐기세요."

#: data\json\items\tool\radio_tools.json
msgid "RC control"
msgid_plural "RC controls"
msgstr[0] "RC 조종기"

#. ~ Description for {'str': 'RC control'}
#. ~ Description for {'str_sp': 'mech shutdown devices'}
#: data\json\items\tool\radio_tools.json
#: data\mods\ProjectSquirrel\monsters\sq_mechs.json
msgid ""
"A remote control for RC cars, with joystick to steer the car and colorful "
"buttons that don't seem to do anything.  Perhaps they were for the deluxe "
"model?"
msgstr ""
"RC 자동차의 무선 조종기입니다. 조이스틱이 달려 있어 방향전환이 가능하며 그 외에 달려 있는 알록달록한 버튼들은 눌러도 아무 반응이 "
"없는데 아마 디럭스 모델에 쓰는 버튼인지도 모릅니다."

#: data\json\items\tool\radio_tools.json
msgid "RC car"
msgid_plural "RC cars"
msgstr[0] "RC카"

#. ~ Description for {'str': 'RC car'}
#: data\json\items\tool\radio_tools.json
msgid "A remote-controlled car.  Fun for young and old alike."
msgstr "원격 조종식 장난감 자동차. 어린이든 어른이든 재밌게 가지고 논다."

#: data\json\items\tool\radio_tools.json
msgid "RC car (on)"
msgid_plural "RC cars (on)"
msgstr[0] "RC카 (켜짐)"

#. ~ Description for {'str': 'RC car (on)', 'str_pl': 'RC cars (on)'}
#: data\json\items\tool\radio_tools.json
msgid ""
"This remote-controlled car is on, and draining its batteries just like a "
"real electric car!  Use a remote control to drive it around."
msgstr "원격 조종식 장난감 자동차. 현재 작동 중이며 진짜 전기 자동차처럼 배터리를 소모하고 있다! 원격 조종으로 움직일 수 있다."

#: data\json\items\tool\radio_tools.json
msgid "radio activation mod"
msgid_plural "radio activation mods"
msgstr[0] "RC 작동 모듈"

#. ~ Description for {'str': 'radio activation mod'}
#: data\json\items\tool\radio_tools.json
msgid ""
"This small piece of electronics can be attached to certain items and "
"activate them after receiving a radio signal."
msgstr "적절한 물건에 부착하여 라디오 신호 수신으로 작동하게 만드는 소형 전자기기."

#: data\json\items\tool\radio_tools.json
msgid "radio (off)"
msgid_plural "radios (off)"
msgstr[0] "라디오 (꺼짐)"

#. ~ Description for {'str': 'radio (off)', 'str_pl': 'radios (off)'}
#: data\json\items\tool\radio_tools.json
msgid ""
"This is a portable radio.  Using this radio turns it on.  It will pick up "
"any nearby signals being broadcast and play them audibly."
msgstr "휴대용 라디오. 전원을 켜서 사용합니다. 근처의 신호를 잡아서 방송을 들을 수 있게 해줍니다."

#: data\json\items\tool\radio_tools.json
msgid "radio (on)"
msgid_plural "radios (on)"
msgstr[0] "라디오 (켜짐)"

#. ~ Description for {'str': 'radio (on)', 'str_pl': 'radios (on)'}
#: data\json\items\tool\radio_tools.json
msgid ""
"This portable radio is turned on, and continually draining its batteries.  "
"It is playing the broadcast being sent from any nearby radio towers."
msgstr "이 휴대용 라디오는 켜져있고, 끊임없이 배터리를 소모하고 있습니다. 근처 방송탑의 방송이 나오고있습니다."

#: data\json\items\tool\radio_tools.json
msgid "two-way radio"
msgid_plural "two-way radios"
msgstr[0] "양방향 라디오"

#. ~ Description for {'str': 'two-way radio'}
#: data\json\items\tool\radio_tools.json
msgid ""
"This is a radio with a transmitting unit.  You could use it to contact "
"someone who also has one.  Unfortunately no one seems to use those nowadays…"
msgstr "송신 장치가 있는 무전기입니다. 같은 걸 가진 사람과 연락할 수 있습니다. 불행히 요즘은 아무도 안 쓰는 것 같습니다…"

#: data\json\items\tool\radio_tools.json
msgid "remote vehicle controller"
msgid_plural "remote vehicle controllers"
msgstr[0] "차량 원격조종 장치"

#. ~ Description for {'str': 'remote vehicle controller'}
#: data\json\items\tool\radio_tools.json
msgid ""
"A remote controller for real cars.  Can turn onboard devices on and off.  "
"Some cars can be driven remotely."
msgstr "실제 자동차용 리모컨이다. 차량의 장치를 켜고 끌 수 있다. 일부 자동차는 원격으로 운전할 수 있다."

#. ~ Use action done_message for {'str': 'birchbark funnel'}.
#: data\json\items\tool\raincatchers.json
msgid "You place the birchbark funnel, waiting to collect rain."
msgstr "자작나무 껍질 깔때기를 놓고, 비를 모으기를 기다렸다."

#. ~ Description for {'str': 'birchbark funnel'}
#: data\json\items\tool\raincatchers.json
msgid ""
"This is a small birchbark funnel.  Place it above an outdoor container to "
"collect rainwater."
msgstr "작은 자작나무 껍질 깔때기입니다. 빗물을 모으기 위해 야외 용기 위에 놓습니다."

#. ~ Use action done_message for {'str': 'funnel'}.
#: data\json\items\tool\raincatchers.json
msgid "You place the funnel, waiting to collect rain."
msgstr "깔때기를 설치했다. 빗물이 모이길 기다리자."

#. ~ Description for {'str': 'funnel'}
#: data\json\items\tool\raincatchers.json
msgid ""
"This is a funnel used to collect rainwater.  Use it outside and place a "
"container beneath it to collect water when it rains."
msgstr "빗물을 모으는데 사용하는 깔때기. 비가 내릴 때 바깥에 통을 놔두고 그 위에 얹어두면 비를 모을 수 있습니다."

#. ~ Use action done_message for {'str': 'leather funnel'}.
#: data\json\items\tool\raincatchers.json
msgid "You place the leather funnel, waiting to collect rain."
msgstr "가죽 깔때기를 설치했다. 빗물이 모이길 기다리자."

#. ~ Description for {'str': 'leather funnel'}
#: data\json\items\tool\raincatchers.json
msgid ""
"This is a small, leather funnel used to collect rainwater.  Use it outside "
"and place a container beneath it to collect water when it rains."
msgstr ""
"빗물을 모으는데 사용하는 작은 가죽제 깔때기. 비가 내릴 때 바깥에 통을 놔두고 그 위에 얹어두면 통안에 비를 모을 수 있습니다."

#. ~ Use action done_message for {'str': 'makeshift funnel'}.
#: data\json\items\tool\raincatchers.json
msgid "You place the makeshift funnel, waiting to collect rain."
msgstr "간이 깔때기를 설치했다. 빗물이 모이길 기다리자."

#. ~ Description for {'str': 'makeshift funnel'}
#: data\json\items\tool\raincatchers.json
msgid ""
"This is a small, makeshift funnel used to collect rainwater.  Use it outside"
" and place a container beneath it to collect water when it rains."
msgstr ""
"빗물을 모으는데 사용하는 작은 간이 깔때기. 비가 내릴 때 바깥에 통을 놔두고 그 위에 얹어두면 통안에 비를 모을 수 있습니다."

#. ~ Use action done_message for {'str': 'metal funnel'}.
#: data\json\items\tool\raincatchers.json
msgid "You place the metal funnel, waiting to collect rain."
msgstr "금속 깔때기를 놓아 빗물을 모으기를 기다린다."

#. ~ Description for {'str': 'metal funnel'}
#: data\json\items\tool\raincatchers.json
msgid ""
"This is a large metal funnel used to collect rainwater.  Less portable than "
"plastic funnels, but collects more water.  Use it outside and place a "
"container beneath it to collect water when it rains."
msgstr ""
"빗물을 모으는데 사용하는 큰 철제 깔때기. 플라스틱 깔때기보단 휴대하기 불편하지만, 비를 더 많이 모을 수 있습니다. 비가 내릴 때 "
"바깥에 통을 놔두고 그 위에 얹어두면 비를 모을 수 있습니다."

#: data\json\items\tool\raincatchers.json data\json\vehicleparts\funnels.json
msgid "tarp raincatcher"
msgid_plural "tarp raincatchers"
msgstr[0] "방수포 비받이"

#. ~ Use action done_message for {'str': 'tarp raincatcher'}.
#: data\json\items\tool\raincatchers.json
msgid "You set up the raincatcher, waiting to collect water."
msgstr "빗물 수집기를 설치하고, 물을 모으기를 기다렸다."

#. ~ Description for {'str': 'tarp raincatcher'}
#: data\json\items\tool\raincatchers.json
msgid ""
"Some sticks and string with a tarp to set up an improvised raincatcher."
msgstr "임시 빗물 수집기를 세울 막대기와 끈, 방수포입니다."

#: data\json\items\tool\science.json
msgid "barometer"
msgid_plural "barometers"
msgstr[0] "기압계"

#. ~ Description for {'str': 'barometer'}
#: data\json\items\tool\science.json
msgid "A plastic barometer that can read the atmospheric pressure."
msgstr "대기압을 알려주는 플라스틱 기압계."

#: data\json\items\tool\science.json
msgid "goo canister"
msgid_plural "goo canisters"
msgstr[0] "오물 용기"

#. ~ Description for {'str': 'goo canister'}
#: data\json\items\tool\science.json
msgid ""
"There is a label on this canister: \"Warning: contains highly toxic and "
"corrosive materials.  Contents may be sentient.  Open at your own risk.\" "
"You think you can feel something moving inside it."
msgstr ""
"보관 용기에 이렇게 쓰여있다: \"경고: 고농도의 독성,부식성 물질, 매우 민감한 물질. 개봉시 각별한 주의 필요\" 안에서 뭔가 "
"움직이는 게 느껴집니다."

#: data\json\items\tool\science.json
msgid "chemistry set"
msgid_plural "chemistry sets"
msgstr[0] "화학 용품"

#. ~ Description for {'str': 'chemistry set'}
#: data\json\items\tool\science.json
msgid ""
"This is a chemistry set stored in a box.  The contents include glass "
"containers, hoses, metal wire, a hotplate, and safety glasses.  It might be "
"used to craft some chemistry projects if you're so inclined."
msgstr ""
"상자에 든 화학 용품 세트입니다. 유리 용기, 고무관, 철사, 핫플레이트, 보안경이 들어 있습니다. 원하는 화학 제품을 제작할 수도 "
"있지만 열원이 필요합니다."

#: data\json\items\tool\science.json
msgid "basic chemistry set"
msgid_plural "basic chemistry sets"
msgstr[0] "기초 화학 용품"

#. ~ Description for {'str': 'basic chemistry set'}
#: data\json\items\tool\science.json
msgid ""
"This is a basic chemistry set which includes glass containers, hoses and "
"safety glasses.  It might be used to craft some chemistry projects if you're"
" so inclined, but you'll need a source of heat."
msgstr "유리 용기, 고무관, 보안경이 든 기초 화학 용품 세트. 원하는 화학 제품을 제작할 수도 있지만 열원이 필요합니다."

#: data\json\items\tool\science.json
msgid "electrolysis kit"
msgid_plural "electrolysis kits"
msgstr[0] "전기분해 키트"

#. ~ Description for {'str': 'electrolysis kit'}
#: data\json\items\tool\science.json
msgid ""
"A set of wiring and electrodes for applying a direct current, usually to a "
"liquid.  Useful for crafting.  Load with a storage battery or 12V vehicle "
"battery to use."
msgstr ""
"직류를 인가하는 배선과 전극 세트로, 보통 액체에 적용한다. 제작에 유용하다. 사용하려면 축전지나 12V 차량용 배터리를 장전하라."

#: data\json\items\tool\science.json
msgid "hydrogen tank"
msgid_plural "hydrogen tanks"
msgstr[0] "수소 탱크"

#. ~ Description for {'str': 'hydrogen tank'}
#: data\json\items\tool\science.json
msgid ""
"This is a tank of compressed hydrogen gas.  If you need to make water from "
"scratch, or lift a zeppelin, it could come in handy."
msgstr "압축 수소 가스 탱크입니다. 물을 처음부터 만들거나 비행선을 띄워야 한다면 유용합니다."

#: data\json\items\tool\science.json
msgid "hygrometer"
msgid_plural "hygrometers"
msgstr[0] "습도계"

#. ~ Description for {'str': 'hygrometer'}
#: data\json\items\tool\science.json
msgid "A plastic hygrometer that can read the relative humidity in the air."
msgstr "상대 습도를 알려주는 플라스틱 습도계."

#: data\json\items\tool\science.json
msgid "nitrogen tank"
msgid_plural "nitrogen tanks"
msgstr[0] "질소 탱크"

#. ~ Description for {'str': 'nitrogen tank'}
#: data\json\items\tool\science.json
msgid ""
"This is a tank of compressed nitrogen gas.  Nitrogen is useful for its lack "
"of reactivity.  Don't try to breathe it."
msgstr "압축 질소 가스 탱크입니다. 질소는 반응성이 없어 유용합니다. 호흡하려 하지 마세요."

#: data\json\items\tool\science.json
msgid "oxygen cylinder"
msgid_plural "oxygen cylinders"
msgstr[0] "산소 실린더"

#. ~ Description for {'str': 'oxygen cylinder'}
#: data\json\items\tool\science.json
msgid ""
"A large steel cylinder used for storing pressurized gas.  It is marked with "
"a faded, but legible O2 symbol."
msgstr "가압 가스 저장용 대형 강철 실린더입니다. 희미하지만 읽을 수 있는 O2 기호가 표시돼 있습니다."

#: data\json\items\tool\science.json
msgid "carbon dioxide tank"
msgid_plural "carbon dioxide tanks"
msgstr[0] "이산화탄소 탱크"

#. ~ Description for {'str': 'carbon dioxide tank'}
#: data\json\items\tool\science.json
msgid "This is a tank of compressed carbon dioxide gas."
msgstr "압축 이산화탄소 가스 탱크입니다."

#: data\json\items\tool\science.json
msgid "platinum grille"
msgid_plural "platinum grilles"
msgstr[0] "백금 격자망"

#. ~ Description for {'str': 'platinum grille'}
#: data\json\items\tool\science.json
msgid ""
"This is a metal grille with a layer of platinum plating, suitable for use as"
" a catalyst for some chemical reactions."
msgstr "일부 화학 반응의 촉매로 사용하기에 적합한 백금 도금 금속 격자망이다."

#: data\json\items\tool\science.json data\mods\Arcana_BN\items\tools.json
msgid "portal generator"
msgid_plural "portal generators"
msgstr[0] "포탈 생성기"

#. ~ Description for {'str': 'portal generator'}
#: data\json\items\tool\science.json
msgid ""
"This is a rare, bizarre, and arcane device of an otherworldly nature.  It's "
"giving you a headache just looking at it.  It is covered in alien markings."
msgstr ""
"희귀하고, 기이하며, 불가사의한 초자연적 장치. 그저 보기만 했는데도 머리가 아파옵니다. 표면에 이질적인 문양이 새겨져 있습니다."

#. ~ Use action done_message for {'str': 'teleport pad'}.
#: data\json\items\tool\science.json
msgid "You place the telepad."
msgstr "텔레포터 패드를 설치했다."

#. ~ Description for {'str': 'teleport pad'}
#: data\json\items\tool\science.json
msgid ""
"This is a kit for a teleporter trap consisting of a teleporter and a solar "
"cell that is triggered when stepped upon."
msgstr "위에 올라서면 작동되는 텔레포터와 태양전지로 이루어진 텔레포터 함정 제작 도구입니다."

#: data\json\items\tool\science.json
msgid "teleporter"
msgid_plural "teleporters"
msgstr[0] "텔레포터"

#. ~ Description for {'str': 'teleporter'}
#: data\json\items\tool\science.json
msgid ""
"This is an experimental device that will teleport you a short distance when "
"activated."
msgstr "실험적인 장치로, 작동하면 가까운 거리로 순간이동시켜줍니다."

#: data\json\items\tool\science.json
msgid "Doppler Radar Turbo 2000"
msgid_plural "Doppler Radar Turbo 2000s"
msgstr[0] "도플러 레이더 터보 2000"

#. ~ Description for {'str': 'Doppler Radar Turbo 2000'}
#: data\json\items\tool\science.json
msgid ""
"A briefcase with built-in laptop that looks like it's from the 80s.  Its "
"vintage monochrome monitor displays a plethora of meteorological data.  No "
"sign of the FLDSMDFR, however."
msgstr ""
"80년대풍의 내장 노트북이 달린 서류 가방이다. 빈티지 단색 모니터에는 다양한 기상 데이터가 가득하다. 그러나 FLDSMDFR의 흔적은 "
"없다."

#: data\json\items\tool\science.json
msgid "basic laboratory analysis kit"
msgid_plural "basic laboratory analysis kits"
msgstr[0] "기본 실험실 분석 키트"

#. ~ Description for {'str': 'basic laboratory analysis kit'}
#: data\json\items\tool\science.json
msgid ""
"This hefty kit contains some basic things you should probably not try to do "
"precise chemistry without: namely, a small balance scale, a "
"spectrophotometer, a melting point apparatus, a pH meter, and a set of paper"
" for thin layer chromatography.  This makes it a lot easier to feel "
"confident that the chemical you've made is what you think you've made."
msgstr ""
"이 묵직한 키트에는 정밀 화학을 할 때 없어서는 안 될 기본 장비들이 들어 있다. 소형 밸런스 저울, 분광광도계, 융점 측정기, pH "
"측정기, 박층 크로마토그래피용 종이 세트. 이 키트 덕분에 만든 화학물질이 원하는 것인지 좀 더 자신 있게 확인할 수 있다."

#: data\json\items\tool\science.json
msgid "small weight scale"
msgid_plural "small weight scales"
msgstr[0] "소형 저울"

#. ~ Description for {'str': 'small weight scale'}
#: data\json\items\tool\science.json
msgid ""
"This is a simple scale that uses a set of steel weights on sliding bars to "
"measure a sample's mass quite accurately."
msgstr "강철 추가 달린 슬라이딩 막대로 표본의 질량을 꽤 정확하게 측정하는 간단한 저울이다."

#: data\json\items\tool\science.json
msgid "spectrophotometer"
msgid_plural "spectrophotometers"
msgstr[0] "분광광도계"

#. ~ Description for {'str': 'spectrophotometer'}
#: data\json\items\tool\science.json
msgid ""
"This ubiquitous analytical chemistry tool measures the light absorption of a"
" liquid sample in a special tube called a cuvette."
msgstr "분석 화학에서 널리 쓰이는 이 도구는 큐베트라는 특수 튜브에 담긴 액체 표본의 광 흡수를 측정한다."

#: data\json\items\tool\science.json
msgid "pH meter"
msgid_plural "pH meters"
msgstr[0] "pH 측정기"

#. ~ Description for {'str': 'pH meter'}
#: data\json\items\tool\science.json
msgid ""
"This is basically a pair of glass probes on a voltmeter.  By putting one "
"probe into a calibration solution (conveniently included) and the other in a"
" substance, you can calculate the acidity."
msgstr ""
"기본적으로 전압계에 달린 유리 탐침 한 쌍이다. 탐침 하나를 보정 용액에 (편의를 위해 포함되어 있음), 다른 하나를 물질에 넣어 산도를"
" 계산할 수 있다."

#: data\json\items\tool\science.json
msgid "voltmeter"
msgid_plural "voltmeters"
msgstr[0] "전압계"

#. ~ Description for {'str': 'voltmeter'}
#: data\json\items\tool\science.json
msgid ""
"This device has two probes that let you measure the electrical potential "
"between two points.  Activate to check the status of any local grid "
"connections or battery charge in your surroundings, as well as make "
"modifications to grid connections"
msgstr ""
"두 지점 사이의 전위를 측정할 수 있는 두 개의 프로브가 있는 기기입니다. 활성화해 주변의 국지 전력망 연결 상태나 배터리 충전을 "
"확인하고, 전력망 연결을 수정합니다."

#: data\json\items\tool\science.json
msgid "melting point apparatus"
msgid_plural "units of melting point apparatus"
msgstr[0] "융점 측정기"

#. ~ Description for {'str': 'melting point apparatus', 'str_pl': 'units of
#. melting point apparatus'}
#: data\json\items\tool\science.json
msgid ""
"This is basically a hot plate, with a metal housing attached.  The metal "
"housing has a magnification viewport and a slot into which a capillary tube "
"containing a crystallized sample is inserted.  The device lets you precisely"
" measure the melting point of a crystal, a property very useful in "
"identifying what it is and how pure it is."
msgstr ""
"기본적으로 금속 하우징이 부착된 가열판이다. 금속 하우징에는 확대 뷰포트와 결정화된 표본이 든 모세관을 삽입하는 슬롯이 있다. 이 장치는"
" 결정의 녹는점을 정밀하게 측정하여 물질이 무엇인지, 얼마나 순수한지 파악하는 데 도움이 된다."

#: data\json\items\tool\science.json
msgid "vortex device"
msgid_plural "vortex devices"
msgstr[0] "볼텍스 장치"

#. ~ Description for {'str': 'vortex device'}
#: data\json\items\tool\science.json
msgid ""
"This is a small, hefty, boring looking machine.  Its weighted trapezoidal "
"frame has a single on-off switch and a speed dial, and on top of it sits a "
"rubber receptacle.  Pressing a test tube into the receptacle would, with "
"power, rapidly shake and mix the contents of the test tube.  It's "
"surprisingly fun to use."
msgstr ""
"작고 묵직하고 지루해 보이는 기계입니다. 무게 있는 사다리꼴 프레임엔 단일 온오프 스위치와 속도 다이얼이 있고, 위엔 고무 소켓이 "
"있습니다. 시험관을 소켓에 눌러 넣으면 전원이 켜진 채 내용물을 빠르게 흔들어 섞습니다. 쓰는 게 의외로 재밌습니다."

#: data\json\items\tool\science.json
msgid "light detector"
msgid_plural "light detectors"
msgstr[0] "광 검출기"

#. ~ Description for {'str': 'light detector'}
#: data\json\items\tool\science.json
msgid ""
"This is a photodiode on a chip, designed to convert incoming light to "
"electrical energy for quantification."
msgstr "들어오는 빛을 전기 에너지로 변환하여 정량화하도록 설계된 칩 위의 포토다이오드다."

#: data\json\items\tool\science.json
msgid "glass prism"
msgid_plural "glass prisms"
msgstr[0] "유리 프리즘"

#. ~ Description for {'str': 'glass prism'}
#: data\json\items\tool\science.json
msgid ""
"This is a high quality crystal glass prism for separating and redirecting "
"light."
msgstr "빛을 분리하고 방향을 바꾸기 위한 고품질 크리스탈 유리 프리즘이다."

#: data\json\items\tool\science.json
msgid "small glass tube"
msgid_plural "small glass tubes"
msgstr[0] "소형 유리관"

#. ~ Description for {'str': 'small glass tube'}
#: data\json\items\tool\science.json
msgid ""
"This is a small glass tube.  What more could you possibly want to know about"
" it?"
msgstr "소형 유리관이다. 이것에 대해 뭘 더 알고 싶은 게 있나?"

#: data\json\items\tool\science.json
msgid "microscope"
msgid_plural "microscopes"
msgstr[0] "현미경"

#. ~ Description for {'str': 'microscope'}
#: data\json\items\tool\science.json
msgid ""
"A classic tool for the ages!  This hefty, durable piece of lab equipment "
"makes small things look bigger.  Without electricity the light doesn't work,"
" but the rest of it is surprisingly functional.  Unfortunately it's not "
"useful for very much at the moment."
msgstr ""
"세월을 견디는 고전 도구입니다! 이 묵직하고 튼튼한 실험 장비는 작은 걸 크게 보이게 합니다. 전기가 없으면 조명이 안 되지만 나머지는 "
"의외로 작동합니다. 불행히 지금은 별 쓸모가 없습니다."

#: data\json\items\tool\science.json
msgid "dissecting microscope"
msgid_plural "dissecting microscopes"
msgstr[0] "해부 현미경"

#. ~ Description for {'str': 'dissecting microscope'}
#: data\json\items\tool\science.json
msgid ""
"This microscope has less magnification than a standard one.  It's also "
"stereoscopic and produces a neat 3d image of the surface.  It was typically "
"used for doing dissections and other fine detail work on small creatures.  "
"It still works pretty well with an added light source, but what would you do"
" with it?"
msgstr ""
"표준 현미경보다 배율이 낮습니다. 스테레오식이라 표면의 깔끔한 3D 이미지를 만들어냅니다. 작은 생물의 해부나 정밀 작업에 쓰였습니다. "
"광원을 추가하면 여전히 꽤 잘 작동하지만, 뭘 하겠습니까?"

#: data\json\items\tool\science.json
msgid "separation funnel"
msgid_plural "separation funnels"
msgstr[0] "분리 깔때기"

#. ~ Description for {'str': 'separation funnel'}
#: data\json\items\tool\science.json
msgid ""
"This thing doesn't look much like a funnel.  It's a teardrop shaped piece of"
" glass with a stopper at the wide end and a valve at the other.  It can be "
"used to wash one liquid with another, like water and an oil, and then draw "
"off whichever of the two liquids contains a higher amount of whatever "
"compound you're trying to isolate.  With a high level of skill it can also "
"be used to make juvenile farting noises."
msgstr ""
"깔때기처럼 보이진 않습니다. 넓은 끝에 마개, 다른 쪽에 밸브가 있는 눈물방울 모양 유리 조각입니다. 물과 기름처럼 한 액체를 다른 "
"액체로 씻고, 분리하려는 화합물이 더 많이 든 액체를 뽑아낼 수 있습니다. 높은 기술로는 방귀 소리를 흉내 낼 수도 있습니다."

#: data\json\items\tool\science.json
msgid "rotary evaporator"
msgid_plural "rotary evaporators"
msgstr[0] "회전 증발기"

#. ~ Description for {'str': 'rotary evaporator'}
#: data\json\items\tool\science.json
msgid ""
"Just looking at this thing makes you feel like a proper mad scientist.  It's"
" a series of glass tubes and round flasks, connected to a central motor and "
"a heating element.  The heating element warms one flask, kept rotating by "
"the motor, evaporating the contents.  The vapour is then condensed in the "
"tubes and collected in another flask, in case you wanted to save it for "
"later."
msgstr ""
"보기만 해도 제대로 된 매드 사이언티스트 기분이 듭니다. 중앙 모터와 가열 소자에 연결된 일련의 유리관과 둥근 플라스크입니다. 가열 "
"소자가 모터로 회전하는 한 플라스크를 데워 내용물을 증발시킵니다. 증기는 튜브에서 응축돼 다른 플라스크에 모입니다 — 나중을 위해 "
"보관하고 싶다면요."

#: data\json\items\tool\science.json
msgid "fractional distillation apparatus"
msgid_plural "fractional distillation apparati"
msgstr[0] "분별 증류 장치"

#. ~ Description for {'str': 'fractional distillation apparatus', 'str_pl':
#. 'fractional distillation apparati'}
#: data\json\items\tool\science.json
msgid ""
"One of the classic pieces of mad science glassware, this is basically a "
"small volume still that passes the vapour through a fractional distillation "
"column and then condenses the distillate in a cooled collection column.  A "
"grad student or a robot (is there really any difference?) collects the "
"distillate in fractions so that specific contents can be analyzed.  Going a "
"few milliliters at a time, it would not be very effective to try to distill "
"whiskey in this thing."
msgstr ""
"고전 매드 사이언스 유리기구 중 하나로, 기본적으로 증기를 분별 증류 컬럼을 통과시키고 냉각 수집 컬럼에서 증류물을 응축하는 소용량 "
"증류기입니다. 대학원생이나 로봇이(차이가 있나요?) 특정 내용물을 분석할 수 있게 분별로 증류물을 수집합니다. 몇 밀리리터씩 가서, "
"위스키를 증류하기엔 별로 효과적이지 않을 겁니다."

#: data\json\items\tool\science.json
msgid "electrophoresis tray"
msgid_plural "electrophoresis trays"
msgstr[0] "전기영동 트레이"

#. ~ Description for {'str': 'electrophoresis tray'}
#: data\json\items\tool\science.json
msgid ""
"This is a set of plastic trays, electrodes, and a power supply designed to "
"create an electric voltage gradient through a liquid solution containing a "
"solid gel.  Stuff like proteins and DNA would then get separated on the gel "
"according to electrical charge and size.  Pretty useless now, for anything "
"but salvage."
msgstr ""
"고체 젤이 든 액체 용액에 전압 기울기를 만들도록 설계된 플라스틱 트레이, 전극, 전원 세트입니다. 단백질과 DNA 같은 것들이 전하와 "
"크기에 따라 젤에서 분리됩니다. 지금은 회수 외엔 쓸모없습니다."

#: data\json\items\tool\science.json
msgid "microcentrifuge"
msgid_plural "microcentrifuges"
msgstr[0] "마이크로원심분리기"

#. ~ Description for {'str': 'microcentrifuge'}
#: data\json\items\tool\science.json
msgid ""
"This is a smaller, benchtop version of the larger furniture-sized "
"centrifuge.  Don't be fooled by its portable scale; it's still a very "
"powerful piece of equipment that can spin stuff really quickly.  It's not a "
"toy!"
msgstr ""
"가구 크기 원심분리기의 소형 벤치탑 버전입니다. 휴대 크기라고 속지 마세요 — 여전히 물건을 정말 빨리 돌릴 수 있는 매우 강력한 "
"장비입니다. 장난감이 아닙니다!"

#: data\json\items\tool\science.json
msgid "3D printer"
msgid_plural "3D printers"
msgstr[0] "3D 프린터"

#. ~ Description for {'str': '3D printer'}
#: data\json\items\tool\science.json
msgid ""
"Although it's not nearly as fancy as the experimental nanofabricators, this "
"civilian-grade 3D printer can produce almost any item out of plastic, "
"polymer, or carbon fiber…  so long as you can program it.  It's also useful "
"for repairing items made out of plastic or carbon fiber."
msgstr ""
"실험용 나노제작기만큼 화려하진 않지만, 이 민간급 3D 프린터는 프로그래밍할 수만 있다면 플라스틱, 폴리머, 탄소섬유로 거의 모든 "
"아이템을 만들 수 있습니다. 플라스틱이나 탄소섬유 아이템 수리에도 유용합니다."

#: data\json\items\tool\science.json
msgid "advanced 3D printer"
msgid_plural "advanced 3D printers"
msgstr[0] "고급 3D 프린터"

#. ~ Description for {'str': 'advanced 3D printer'}
#: data\json\items\tool\science.json
msgid ""
"Recent advances in 3D printing technology have resulted in the ability to "
"quickly and cheaply 3D print metals and alloys.  Such 3D printers are highly"
" expensive, but sought out by collectors and preppers alike.  In addition to"
" crafting, it can be used to repair polymer and metal items alike, or "
"permeate fabric items with carbon fiber for added protection."
msgstr ""
"3D 프린팅 기술의 최근 진보로 금속과 합금을 빠르고 싸게 3D 프린트할 수 있게 됐습니다. 이런 3D 프린터는 매우 비싸지만 수집가와 "
"프레퍼 모두 찾습니다. 제작 외에도, 폴리머와 금속 아이템을 수리하거나, 추가 보호를 위해 직물 아이템에 탄소섬유를 침투시킬 수 "
"있습니다."

#: data\json\items\tool\shelters.json
msgid "damaged shelter kit"
msgid_plural "damaged shelter kits"
msgstr[0] "피난처 키트 (손상됨)"

#. ~ Description for {'str': 'damaged shelter kit'}
#: data\json\items\tool\shelters.json
msgid ""
"This is a small shelter, made of sticks and skins.  Use it to place.  This "
"shelter has been damaged, and needs repairs."
msgstr "막대기와 가죽으로 만든 작은 피난처. 사용해서 설치할 수 있습니다. 현재 손상을 입은 상태이므로, 수리가 필요합니다."

#: data\json\items\tool\shelters.json
msgid "large tent"
msgid_plural "large tents"
msgstr[0] "대형 텐트"

#. ~ Description for {'str': 'large tent'}
#: data\json\items\tool\shelters.json
msgid ""
"This is a family sized tent.  It provides a large amount of space, but is "
"very bulky."
msgstr "한 가족이 잘 수 있을 정도로 커다란 텐트. 넓은 공간을 제공해주지만, 그만큼 부피도 만만치 않습니다."

#: data\json\items\tool\shelters.json
msgid "shelter kit"
msgid_plural "shelter kits"
msgstr[0] "피난처 키트"

#. ~ Description for {'str': 'shelter kit'}
#: data\json\items\tool\shelters.json
msgid "This is a small shelter, made of sticks and skins.  Use it to place."
msgstr "막대기와 가죽으로 만든 작은 피난처. 사용해서 설치할 수 있습니다."

#: data\json\items\tool\shelters.json
msgid "tent"
msgid_plural "tents"
msgstr[0] "텐트"

#. ~ Description for {'str': 'tent'}
#: data\json\items\tool\shelters.json
msgid ""
"This is a small personal tent, it's just big enough to fit you comfortably."
msgstr "사람 한 명이 들어가 쉴 만한 크기의 소형 텐트."

#: data\json\items\tool\smoking.json
msgid "boxmod vape"
msgid_plural "boxmod vapes"
msgstr[0] "박스모드 베이프"

#. ~ Use action activation_message for {'str': 'boxmod vape'}.
#: data\json\items\tool\smoking.json
msgid "You take a puff from your boxmod vape."
msgstr "박스모드 베이프로 한 모금 들이마셨다."

#. ~ Description for {'str': 'boxmod vape'}
#: data\json\items\tool\smoking.json
msgid ""
"An advanced version of the electronic cigarette.  A less harmful way to get "
"your nicotine fix than regular cigarettes, but still addictive.  It needs "
"batteries and nicotine liquid to function.  The side has a display showing "
"the battery and amount of nicotine liquid left.  Additionally, it allows you"
" to play simple games on it."
msgstr ""
"전자담배의 고급 버전입니다. 일반 담배보다 덜 해롭게 니코틴을 섭취하는 방법이지만 여전히 중독성이 있습니다. 작동에 배터리와 니코틴 "
"액체가 필요합니다. 옆면엔 배터리와 남은 니코틴 액체를 보여주는 디스플레이가 있습니다. 추가로 간단한 게임을 할 수 있습니다."

#: data\json\items\tool\smoking.json
msgid "disposable vape"
msgid_plural "disposable vapes"
msgstr[0] "일회용 베이프"

#. ~ Use action activation_message for disposable vape.
#: data\json\items\tool\smoking.json
msgid "You take a puff from your disposable vape."
msgstr "일회용 베이프로 한 모금 들이마셨다."

#. ~ Description for disposable vape
#: data\json\items\tool\smoking.json
msgid ""
"This battery-operated device vaporizes a liquid that contains flavorings and"
" nicotine.  A less harmful alternative to traditional cigarettes, but it's "
"still addictive.  It can't be reused once it's empty.  The side has a "
"display showing the battery and amount of nicotine liquid left."
msgstr ""
"이 배터리 작동 기기는 향료와 니코틴이 든 액체를 기화시킵니다. 전통 담배보다 덜 해로운 대안이지만 여전히 중독성이 있습니다. 비면 "
"재사용할 수 없습니다. 옆면엔 배터리와 남은 니코틴 액체를 보여주는 디스플레이가 있습니다."

#: data\json\items\tool\smoking.json
msgid "crack pipe"
msgid_plural "crack pipes"
msgstr[0] "마약 흡입 파이프"

#. ~ Description for {'str': 'crack pipe'}
#: data\json\items\tool\smoking.json
msgid ""
"This is a fine glass tube with a bulb with a bowl on one end.  It's used to "
"partake of certain illicit substances."
msgstr "끝에 큰 밀폐공간이 달린 잘만들어진 유리 파이프. 불법적인 약물을 태워 흡입하는데 사용됩니다."

#: data\json\items\tool\smoking.json
msgid "glass pipe"
msgid_plural "glass pipes"
msgstr[0] "유리 파이프"

#. ~ Description for {'str': 'glass pipe'}
#: data\json\items\tool\smoking.json
msgid ""
"This is a hand-blown glass pipe.  It's of the type most commonly used to "
"smoke recreational substances."
msgstr "수제 유리 파이프. 이런 종류의 유리 파이프는 주로 뭔가 태워서 흡입할 때 사용됩니다."

#: data\json\items\tool\smoking.json
msgid "glass bong"
msgid_plural "glass bongs"
msgstr[0] "유리 봉"

#. ~ Description for {'str': 'glass bong'}
#: data\json\items\tool\smoking.json
msgid ""
"This is a hand-blown glass beaker bong.  Easy to clean, hard to tip over, "
"and functional even after society collapses."
msgstr "수제 불림 유리 비커 봉입니다. 닦기 쉽고, 넘어지기 어렵고, 사회가 붕괴한 후에도 기능합니다."

#: data\json\items\tool\smoking.json
msgid "tobacco pipe"
msgid_plural "tobacco pipes"
msgstr[0] "담배 파이프"

#. ~ Description for {'str': 'tobacco pipe'}
#: data\json\items\tool\smoking.json
msgid ""
"This is a hand-carved wooden smoking pipe.  It's designed to facilitate "
"consumption of fire cured tobacco leaves."
msgstr "수제 나무 파이프. 담뱃잎을 태워서 흡입하는데 사용됩니다."

#: data\json\items\tool\smoking.json
msgid "dab pen"
msgid_plural "dab pens"
msgstr[0] "댑 펜"

#. ~ Use action activation_message for {'str': 'dab pen'}.
#: data\json\items\tool\smoking.json
msgid "You hit your dab pen. Sooooo smooth..."
msgstr "댑 펜을 빨았다. 너어어무 부드러워…"

#. ~ Description for {'str': 'dab pen'}
#: data\json\items\tool\smoking.json
msgid ""
"This is a dab pen for vaporizing cannabis.  Now all you need is 'thc "
"distillate' and you're ready to rock and roll."
msgstr "대마초 기화용 댑 펜입니다. 이제 \"thc 증류물\"만 있으면 준비 끝입니다."

#: data\json\items\tool\smoking.json
msgid "disposable dab pen"
msgid_plural "disposable dab pens"
msgstr[0] "일회용 댑 펜"

#. ~ Use action activation_message for {'str': 'disposable dab pen'}.
#: data\json\items\tool\smoking.json
msgid "You hit your disposable dab pen. Sooooo smooth..."
msgstr "일회용 댑 펜을 빨았다. 너어어무 부드러워…"

#. ~ Description for {'str': 'disposable dab pen'}
#: data\json\items\tool\smoking.json
msgid ""
"This is a disposable dab pen for vaporizing cannabis.  This one is already "
"filled with distillate for your convenience, but can't be recharged."
msgstr "대마초 기화용 일회용 댑 펜입니다. 편의를 위해 이미 증류물이 채워져 있지만 재충전할 수 없습니다."

#: data\json\items\tool\smoking.json
msgid "nectar collector"
msgid_plural "nectar collectors"
msgstr[0] "넥타 콜렉터"

#. ~ Use action activation_message for {'str': 'nectar collector'}.
#: data\json\items\tool\smoking.json
msgid "You heat the nectar collector and hit it. Sooooo smooth..."
msgstr "넥타 콜렉터를 데우고 빨았다. 너어어무 부드러워…"

#. ~ Description for {'str': 'nectar collector'}
#: data\json\items\tool\smoking.json
msgid ""
"This is a metal and wooden nectar collector.  The top cover can be attached "
"and detached magnetically.  The wood has engravings depicting bees, honey, "
"and flowers.  You need 'thc wax' to use this item."
msgstr ""
"금속과 나무로 된 넥타 콜렉터입니다. 윗 덮개는 자석으로 붙였다 뗐다 합니다. 나무엔 벌, 꿀, 꽃을 묘사한 조각이 있습니다. 이 "
"아이템을 쓰려면 \"thc 왁스\"가 필요합니다."

#: data\json\items\tool\stationary.json
msgid "stapler"
msgid_plural "staplers"
msgstr[0] "스테이플러"

#. ~ Description for {'str': 'stapler'}
#: data\json\items\tool\stationary.json
msgid "A stapler for fastening sheets of paper together."
msgstr "종이를 함께 고정하는 스테이플러입니다."

#: data\json\items\tool\stationary.json
msgid "pen"
msgid_plural "pens"
msgstr[0] "펜"

#. ~ Description for {'str': 'pen'}
#: data\json\items\tool\stationary.json
msgid "A plastic ball point pen.  Use it to write something down."
msgstr "플라스틱 볼펜입니다. 사용해 뭔가를 적습니다."

#: data\json\items\tool\stationary.json
msgid "pair of scissors"
msgid_plural "pairs of scissors"
msgstr[0] "가위"

#. ~ Description for {'str': 'pair of scissors', 'str_pl': 'pairs of
#. scissors'}
#: data\json\items\tool\stationary.json
msgid ""
"These are a long pair of heavy-duty scissors.  Use scissors to cut items "
"made from cotton (like clothing) into rags."
msgstr "긴 중량 가위 한 쌍입니다. 가위로 면으로 된 아이템(의류 등)을 잘라 넝마로 만듭니다."

#: data\json\items\tool\stationary.json
msgid "paper"
msgid_plural "papers"
msgstr[0] "종이"

#. ~ Description for paper
#: data\json\items\tool\stationary.json
msgid "A piece of paper.  Can be used for fires."
msgstr "종잇장으로, 불 피우는데 쓸 수 있습니다."

#: data\json\items\tool\tailoring.json
msgid "bone sewing awl"
msgid_plural "bone sewing awls"
msgstr[0] "뼈 재봉 송곳"

#. ~ Description for {'str': 'bone sewing awl'}
#: data\json\items\tool\tailoring.json
msgid ""
"This is a crude sharpened bone awl; those were used for leatherworking "
"before metal was discovered.  It can also serve as an improvised stabbing "
"weapon, but will break quickly."
msgstr ""
"조잡한 날카로운 뼈 송곳입니다. 금속이 발견되기 전 가죽공예에 쓰였습니다. 임시 찌르기 무기로도 쓸 수 있지만 금방 부러집니다."

#: data\json\items\tool\tailoring.json
msgid "steel sewing awl"
msgid_plural "steel sewing awls"
msgstr[0] "강철 재봉 송곳"

#. ~ Description for {'str': 'steel sewing awl'}
#: data\json\items\tool\tailoring.json
msgid ""
"This is a steel awl with a wooden grip, usually used for leatherworking.  It"
" can also serve as an improvised stabbing weapon, but will break quickly."
msgstr "나무 그립이 있는 강철 송곳으로, 보통 가죽공예에 쓰입니다. 임시 찌르기 무기로도 쓸 수 있지만 금방 부러집니다."

#: data\json\items\tool\tailoring.json
msgid "knitting needles"
msgid_plural "pairs of knitting needles"
msgstr[0] "뜨개질바늘"

#. ~ Description for {'str': 'knitting needles', 'str_pl': 'pairs of knitting
#. needles'}
#: data\json\items\tool\tailoring.json
msgid ""
"A pair of stout wooden needles with round ends used to turn thread and yarn "
"into cloth."
msgstr "실과 실타래로 옷을 짜는데 쓰이는, 끝이 뭉툭하고 튼튼한 나무 뜨개바늘 한 쌍."

#: data\json\items\tool\tailoring.json
msgid "bone needle"
msgid_plural "bone needles"
msgstr[0] "뼈 바늘"

#. ~ Description for {'str': 'bone needle'}
#: data\json\items\tool\tailoring.json
msgid ""
"This is sharp needle made from a bone.  It would be useful for making rough "
"clothing and items.  Its low quality makes it rather unsuitable for anything"
" requiring speed or precision."
msgstr ""
"뼈로 만든 날카로운 바늘입니다. 기초적인 의류나 물품을 만들 때 유용합니다. 품질이 낮아서 정확한 작업이나 빨리 해야 하는 작업에는 "
"적합치 못합니다."

#. ~ Description for {'str': 'curved needle'}
#: data\json\items\tool\tailoring.json
msgid ""
"A curved sharp needle made of steel.  Its rounded shape allows it to make "
"stitches that only pierce one side of the material.  While unsuitable for "
"most tailoring projects, it's a necessity for stitching neoprene."
msgstr ""
"강철로 만든 휘어진 바늘입니다. 모양이 둥글어서 한땀씩만 꿰맬 수 있는 물건으로 대부분의 재봉일에는 부적합합니다만 네오프렌을 꿰맬 때 "
"필요합니다."

#: data\json\items\tool\tailoring.json
msgid "wooden needle"
msgid_plural "wooden needles"
msgstr[0] "나무 바늘"

#. ~ Description for {'str': 'wooden needle'}
#: data\json\items\tool\tailoring.json
msgid ""
"This is a wooden needle whittled down to a sharp point.  It has a narrow "
"hole carved into the head for threading.  Its low quality makes it rather "
"unsuitable for anything requiring speed or precision, or involving tougher "
"materials like Kevlar."
msgstr ""
"날카로운 끝으로 깎은 나무 바늘입니다. 머리에 실을 꿰는 좁은 구멍이 새겨져 있습니다. 낮은 품질이라 속도나 정밀도가 필요한 것, 케블라"
" 같은 단단한 재료엔 적합하지 않습니다."

#: data\json\items\tool\tailoring.json
#: data\mods\MagicalNights\items\tools.json
msgid "sewing kit"
msgid_plural "sewing kits"
msgstr[0] "반짇고리"

#. ~ Description for {'str': 'sewing kit'}
#: data\json\items\tool\tailoring.json
msgid ""
"This is a plastic kit with a variety of needles, some plastic spools for "
"thread, and a few other useful textile tools.  Use a sewing kit on an "
"article of clothing to attempt to repair or reinforce that clothing.  This "
"uses your tailoring skill, and can also sew pockets or warmer liner into "
"your gear, or resize it for mutant wearers."
msgstr ""
"다양한 바늘, 실용 플라스틱 스풀, 기타 유용한 직물 도구가 든 플라스틱 키트입니다. 의류에 재봉 키트를 사용해 수리나 보강을 "
"시도합니다. 재봉 기술을 쓰고, 장비에 주머니나 보온 라이너를 꿰매거나, 돌연변이 착용자용으로 크기를 조절할 수도 있습니다."

#: data\json\items\tool\tailoring.json
msgid "tailoring pattern set"
msgid_plural "tailoring pattern sets"
msgstr[0] "재봉 패턴 세트"

#. ~ Description for {'str': 'tailoring pattern set'}
#: data\json\items\tool\tailoring.json
msgid ""
"This is a large set of tailoring patterns made from paper.  They're useful "
"for making any kind of cloth or leather items from scratch, but are "
"necessary for more advanced projects."
msgstr ""
"종이로 만든 대형 재봉 패턴 세트입니다. 처음부터 온갖 천이나 가죽 아이템을 만드는 데 유용하지만, 더 고급 프로젝트엔 필수입니다."

#: data\json\items\tool\tailoring.json
#: data\mods\MagicalNights\items\tools.json
#: data\mods\ProjectSquirrel\miscs\sq_tailoring.json
msgid "tailor's kit"
msgid_plural "tailor's kits"
msgstr[0] "재단용 도구"

#. ~ Description for {'str': "tailor's kit"}
#: data\json\items\tool\tailoring.json
msgid ""
"This is a high quality kit consisting of a variety of needles, some plastic "
"spools for thread, some small scissors, and an awl.  Using your tailoring "
"skill, this kit can customize your clothing and armor, whether up-armoring "
"them or altering some items to fit mutant wearers."
msgstr ""
"다양한 바늘, 실용 플라스틱 스풀, 작은 가위, 송곳으로 구성된 고품질 키트입니다. 재봉 기술로, 이 키트는 의류와 갑옷을 강화하거나 "
"돌연변이 착용자에게 맞게 변경해 맞춤화할 수 있습니다."

#: data\json\items\tool\tailoring.json
msgid "sewing machine"
msgid_plural "sewing machines"
msgstr[0] "재봉틀"

#. ~ Description for {'str': 'sewing machine'}
#: data\json\items\tool\tailoring.json
msgid "A sturdy foot-crank sewing machine for fast stitching and repairs."
msgstr "빠른 바느질과 수리용 튼튼한 발크랭크 재봉틀입니다."

#: data\json\items\tool\toiletries.json
msgid "bathroom scale"
msgid_plural "bathroom scales"
msgstr[0] "체중계"

#. ~ Description for {'str': 'bathroom scale'}
#: data\json\items\tool\toiletries.json
msgid "This is a small bathroom scale, meant to weigh a person while naked."
msgstr "사람이 알몸으로 무게를 재는 소형 욕실 체중계입니다."

#: data\json\items\tool\toiletries.json
msgid "scrub brush"
msgid_plural "scrub brushes"
msgstr[0] "수세미 솔"

#. ~ Description for {'str': 'scrub brush', 'str_pl': 'scrub brushes'}
#: data\json\items\tool\toiletries.json
msgid "This is a simple scrub brush."
msgstr "간단한 수세미 솔입니다."

#: data\json\items\tool\toiletries.json data\mods\change_hairstyle\item.json
msgid "electric hair trimmer"
msgid_plural "electric hair trimmers"
msgstr[0] "전기 이발기"

#. ~ Description for {'str': 'electric hair trimmer'}
#: data\json\items\tool\toiletries.json
msgid ""
"This is a pocket-sized electric trimmer made for cutting hair.  You can use "
"it to cut your hair if it's supplied with batteries.  It requires 10 "
"batteries per use."
msgstr ""
"포켓 사이즈 전기 이발기. 배터리가 수급된다면 이걸 사용해서 머리카락을 자를 수 있습니다. 한 번 쓸 때마다 배터리를 10 소모합니다."

#: data\json\items\tool\toiletries.json
msgid "mop"
msgid_plural "mops"
msgstr[0] "대걸레"

#. ~ Description for {'str': 'mop'}
#: data\json\items\tool\toiletries.json
msgid ""
"This is an unwieldy mop.  Good for cleaning up spills.  Use to mop up any "
"'mess' you may have made."
msgstr ""
"대걸레는 장비할 수 없습니다만 사용하면 엎지른 액체를 닦아낼 수 있습니다. 좀비와 혈투를 벌인 후 주변에 묻은 *지저분한 것* 들도 "
"깨끗이 정리할 수 있습니다."

#: data\json\items\tool\toiletries.json
msgid "collapsible mop"
msgid_plural "collapsible mops"
msgstr[0] "접이식 걸레"

#. ~ Description for {'str': 'collapsible mop'}
#: data\json\items\tool\toiletries.json
msgid ""
"A long unwieldy mop with a collapsible handle for convenient transportation."
"  You may use it to clean up any 'mess' you have made."
msgstr "편리한 운반용 접이식 손잡이가 있는 길고 다루기 힘든 걸레입니다. 만든 \"엉망\"을 청소하는 데 쓸 수 있습니다."

#: data\json\items\tool\toiletries.json
msgid "razor blade"
msgid_plural "razor blades"
msgstr[0] "면도날"

#. ~ Description for {'str': 'razor blade'}
#: data\json\items\tool\toiletries.json
msgid ""
"A double-edged razor blade.  Finicky to use on its own, but can be used as a"
" cutting tool in a pinch."
msgstr "양날 면도날입니다. 그 자체로는 다루기 까다롭지만 필요하면 절단 도구로 쓸 수 있습니다."

#: data\json\items\tool\toiletries.json
msgid "shaving kit"
msgid_plural "shaving kits"
msgstr[0] "면도도구"

#. ~ Description for {'str': 'shaving kit'}
#: data\json\items\tool\toiletries.json
msgid ""
"This is a compact and lightweight shaving kit made for travelers.  You can "
"use it to shave if it's supplied with soap.  It requires 1 unit of soap per "
"use."
msgstr "소형, 경량의 여행용 면도 도구 세트. 면도할 때 비누랑 같이 사용하며, 비누의 사용량을 1회씩 소모합니다."

#: data\json\items\tool\toiletries.json
msgid "sponge"
msgid_plural "sponges"
msgstr[0] "스펀지"

#. ~ Description for {'str': 'sponge'}
#: data\json\items\tool\toiletries.json
msgid ""
"A sponge is a tool or cleaning aid made of soft, porous material.  Typically"
" used for cleaning impervious surfaces, it can also be used for sanding wood"
" when dried."
msgstr ""
"부드럽고 다공성인 재료로 만든 도구나 청소 보조구입니다. 보통 불투수 표면 청소에 쓰이지만, 마르면 나무 샌딩에도 쓸 수 있습니다."

#: data\json\items\tool\toiletries.json data\mods\change_hairstyle\item.json
msgid "makeshift haircut kit"
msgid_plural "makeshift haircut kits"
msgstr[0] "간이 이발도구"

#. ~ Description for {'str': 'makeshift haircut kit'}
#: data\json\items\tool\toiletries.json
msgid "This is a kit with tools for cutting hair."
msgstr "이발도구 모음."

#: data\json\items\tool\toiletries.json
msgid "makeshift shaving kit"
msgid_plural "makeshift shaving kits"
msgstr[0] "간이 면도도구"

#. ~ Description for {'str': 'makeshift shaving kit'}
#: data\json\items\tool\toiletries.json
msgid ""
"This is a makeshift shaving kit.  You can use it to shave if it's supplied "
"with soap.  It requires 1 unit of soap per use."
msgstr "급조한 면도 도구 세트. 면도할 때 비누랑 같이 사용하며, 비누의 잔여량을 1회씩 소모합니다."

#: data\json\items\tool\toiletries.json
msgid "washboard"
msgid_plural "washboards"
msgstr[0] "빨래판"

#. ~ Description for {'str': 'washboard'}
#: data\json\items\tool\toiletries.json
msgid ""
"This is a wooden washboard.  You can use it to wash filthy clothing if it's "
"supplied with cleansing agent."
msgstr "나무로 된 빨래판. 세정제와 함께 사용하면 불결한 옷가지를 세탁할 수 있습니다."

#: data\json\items\tool\toiletries.json
msgid "washing kit"
msgid_plural "washing kits"
msgstr[0] "세탁 키트"

#. ~ Description for {'str': 'washing kit'}
#: data\json\items\tool\toiletries.json
msgid ""
"A combination kit of a washboard and a scrubbing tool.  Everything you need "
"to clean items after the apocalypse."
msgstr "빨래판과 문지르기 도구의 결합 키트입니다. 종말 후 아이템을 닦는 데 필요한 모든 것입니다."

#. ~ Use action bury_question for {'str': 'bear trap'}.
#: data\json\items\tool\traps.json
msgid "Bury the beartrap?"
msgstr "곰 덫을 매설합니까?"

#. ~ Use action done_message for {'str': 'bear trap'}.
#: data\json\items\tool\traps.json
msgid "You set the beartrap."
msgstr "곰 덫을 설치했다."

#. ~ Use action done_message for {'str': 'bear trap'}.
#: data\json\items\tool\traps.json
msgid "You bury the beartrap."
msgstr "곰 덫을 묻었다."

#. ~ Description for {'str': 'bear trap'}
#: data\json\items\tool\traps.json
msgid ""
"This is a spring-loaded pair of steel jaws connected to a sensitive pressure"
" plate.  Use it to set it on the ground, creating a trap that will ensnare "
"and damage anything that steps on it.  If you are carrying a shovel, you "
"will have the option of burying it."
msgstr ""
"민감한 압력판에 연결된 용수철 장착 철제 집게다. 이 아이템을 사용하여 지면에 놓으면 밟는 것을 옭아매고 손상시키는 함정이 된다. 삽을 "
"가지고 있다면 묻을 수도 있다."

#: data\json\items\tool\traps.json
msgid "blade trap"
msgid_plural "blade traps"
msgstr[0] "칼날 덫"

#. ~ Use action done_message for {'str': 'blade trap'}.
#: data\json\items\tool\traps.json
msgid "You set the blade trap %d squares away."
msgstr "%d칸 떨어진 곳에 칼날 함정을 설치했다."

#. ~ Description for {'str': 'blade trap'}
#: data\json\items\tool\traps.json
msgid ""
"This is a machete attached laterally to a motor, with a tripwire controlling"
" its throttle.  When the tripwire is pulled, the blade is swung around with "
"great force.  The trap forms a 3x3 area of effect."
msgstr ""
"걸이선으로 제어하는 스로틀이 달린 모터에 마체테가 가로로 부착되어 있다. 걸이선이 당겨지면 날이 강한 힘으로 회전한다. 이 함정은 3x3"
" 범위에 영향을 미친다."

#: data\json\items\tool\traps.json
msgid "nailboard trap"
msgid_plural "nailboard traps"
msgstr[0] "못판 덫"

#. ~ Use action done_message for {'str': 'nailboard trap'}.
#: data\json\items\tool\traps.json
msgid "You set the board trap on the %s, nails facing up."
msgstr "못판 덫을 %s에 못이 위로 향하게 설치했다."

#. ~ Description for {'str': 'nailboard trap'}
#: data\json\items\tool\traps.json
msgid ""
"These are several pieces of wood nailed together, with some nails sticking "
"straight up.  If an unsuspecting victim steps on it, they'll get nails "
"through the foot."
msgstr "위로 향한 못이 박힌 나무 판자 여러 개를 못으로 연결한 것이다. 무심코 밟으면 발에 못이 박힌다."

#. ~ Use action done_message for {'str': 'booby trap'}.
#: data\json\items\tool\traps.json
msgid "You set the booby trap up and activate the grenade."
msgstr "부비트랩을 설치한 다음, 수류탄을 작동시켰다."

#. ~ Description for {'str': 'booby trap'}
#: data\json\items\tool\traps.json
msgid ""
"This is a crude explosive device triggered by a piece of string.  Use it to "
"set up and watch some poor bastard trigger it."
msgstr "끈으로 발동되는 조잡한 폭발 장치입니다. 사용해 설치하고 불쌍한 녀석이 걸리는 걸 지켜보세요."

#. ~ Use action done_message for {'str': 'bubble wrap'}.
#: data\json\items\tool\traps.json
msgid "You set the bubble wrap on the ground, ready to be popped."
msgstr "뽁뽁이 포장지가 터질 수 있도록 땅에 설치했다."

#. ~ Description for {'str': 'bubble wrap'}
#: data\json\items\tool\traps.json
msgid ""
"This is a sheet of plastic covered with air-filled bubbles.  Use it to set "
"it on the ground, creating a trap that will warn you with noise when "
"something steps on it."
msgstr ""
"공기로 채워진 기포로 덮인 플라스틱 시트다. 이 아이템을 사용하여 지면에 놓으면 뭔가가 밟을 때 소리로 경고해주는 함정이 된다."

#: data\json\items\tool\traps.json
msgid "loose caltrops"
msgid_plural "loose caltrops"
msgstr[0] "성긴 마름쇠"

#. ~ Use action done_message for {'str_sp': 'loose caltrops'}.
#: data\json\items\tool\traps.json
msgid "You scatter the caltrops on the %s."
msgstr "%s에 마름쇠를 뿌렸다."

#. ~ Description for {'str_sp': 'loose caltrops'}
#: data\json\items\tool\traps.json
msgid ""
"These are small metal objects covered with many sharp points.  If an "
"unsuspecting victim steps on one, they'll get a spine through the foot."
msgstr "여러 날카로운 부분이 있는 작은 금속 조각. 이것을 보지 못 한 적이 밟으면, 발에 구멍이 나게됩니다."

#: data\json\items\tool\traps.json
msgid "loose glass caltrops"
msgid_plural "loose glass caltrops"
msgstr[0] "흩어진 유리 철려"

#. ~ Use action done_message for {'str_sp': 'loose glass caltrops'}.
#: data\json\items\tool\traps.json
msgid "You scatter the glass caltrops on the %s."
msgstr "유리 철려를 %s에 뿌렸다."

#. ~ Description for {'str_sp': 'loose glass caltrops'}
#: data\json\items\tool\traps.json
msgid ""
"These are glass shards glued together to expose their sharp edges.  If an "
"unsuspecting victim steps on one, they'll get cut."
msgstr "날카로운 가장자리가 드러나게 붙인 유리 조각들입니다. 의심 없는 희생자가 밟으면 베일 겁니다."

#. ~ Use action done_message for {'str': 'crossbow trap'}.
#: data\json\items\tool\traps.json
msgid "You set the crossbow trap."
msgstr "쇠뇌 덫을 설치했다."

#. ~ Description for {'str': 'crossbow trap'}
#: data\json\items\tool\traps.json
msgid ""
"This is a simple tripwire, which is attached to the trigger of a loaded "
"crossbow.  When pulled, the crossbow fires.  Only a single round can be "
"used, after which the trap is disabled."
msgstr ""
"장전된 석궁의 방아쇠와 연결되어 있는 간단한 함정줄입니다. 줄이 당겨지면, 석궁이 발사됩니다. 한 번에 한 발의 볼트만 발사할 수 있고,"
" 발사된 이후에는 함정이 해제됩니다."

#. ~ Use action bury_question for {'str': 'land mine'}.
#: data\json\items\tool\traps.json
msgid "Bury the land mine?"
msgstr "지뢰를 묻습니까?"

#. ~ Use action done_message for {'str': 'land mine'}.
#: data\json\items\tool\traps.json
msgid "You set the land mine."
msgstr "지뢰를 설치했다."

#. ~ Use action done_message for {'str': 'land mine'}.
#: data\json\items\tool\traps.json
msgid "You bury the land mine."
msgstr "지뢰를 묻었다."

#. ~ Description for {'str': 'land mine'}
#: data\json\items\tool\traps.json
msgid ""
"This is a military anti-personnel mine that is triggered when stepped upon."
msgstr "밟으면 발동되는 군용 대인 지뢰입니다."

#: data\json\items\tool\traps.json
msgid "double-barreled shotgun trap"
msgid_plural "double-barreled shotgun traps"
msgstr[0] "쌍열 산탄총 함정"

#. ~ Use action done_message for {'str': 'double-barreled shotgun trap'}.
#. ~ Use action done_message for {'str': 'shotgun trap'}.
#: data\json\items\tool\traps.json
msgid "You set the shotgun trap."
msgstr "산탄총 덫을 설치했습니다."

#. ~ Description for {'str': 'double-barreled shotgun trap'}
#: data\json\items\tool\traps.json
msgid ""
"This is a simple tripwire is attached to the trigger of a loaded double-"
"barreled shotgun.  When pulled, the shotgun fires, discharging both barrels "
"into the target."
msgstr "장전된 쌍열 산탄총의 방아쇠에 붙은 간단한 트립와이어입니다. 당기면 산탄총이 발사돼 두 배럴 모두 표적에 쏩니다."

#. ~ Description for {'str': 'shotgun trap'}
#: data\json\items\tool\traps.json
msgid ""
"This is a simple tripwire is attached to the trigger of a loaded single-"
"barreled shotgun.  When pulled, the shotgun fires."
msgstr "장전된 단열 산탄총의 방아쇠에 붙은 간단한 트립와이어입니다. 당기면 산탄총이 발사됩니다."

#: data\json\items\tool\traps.json
msgid "tripwire trap"
msgid_plural "tripwire traps"
msgstr[0] "인계철선 덫"

#. ~ Use action done_message for {'str': 'tripwire trap'}.
#: data\json\items\tool\traps.json
msgid "You string up the tripwire."
msgstr "인계철선을 설치했다."

#. ~ Description for {'str': 'tripwire trap'}
#: data\json\items\tool\traps.json
msgid ""
"This is some thin strong cable with some affixing tools on either end.  A "
"tripwire trap must be placed across a doorway or other thin passage.  Its "
"purpose is to trip up bypassers, causing them to stumble and possibly hurt "
"themselves slightly."
msgstr ""
"양쪽 끝에 고정 도구가 달린 얇고 강한 케이블이다. 걸이선 함정은 출입구나 좁은 통로에 설치해야 한다. 지나가는 사람을 걸어 넘어뜨려 "
"약간의 부상을 입힐 수 있다."

#. ~ Use action done_message for {'str': 'makeshift perimeter alarm'}.
#: data\json\items\tool\traps.json
msgid "You string up some cans on a tripwire."
msgstr "트립와이어에 캔 몇 개를 매달았다."

#. ~ Description for {'str': 'makeshift perimeter alarm'}
#: data\json\items\tool\traps.json
msgid ""
"This is a set of empty cans used as makeshift noisemakers, strung up across "
"a doorway or other thin passage.  It will make noise when activated to alert"
" you of intruders, but is otherwise harmless."
msgstr ""
"문이나 다른 좁은 통로를 가로질러 매단, 임시 소음기로 쓰는 빈 캔 세트입니다. 발동되면 소음이 나 침입자를 알리지만, 그 외엔 "
"무해합니다."

#: data\json\items\tool\traps.json
msgid "glass shard trap"
msgid_plural "glass shard traps"
msgstr[0] "유리 조각 함정"

#. ~ Use action done_message for {'str': 'glass shard trap'}.
#: data\json\items\tool\traps.json
msgid ""
"You carefully place the shards on the ground, ready to be cracked by "
"something passing by."
msgstr "조심스럽게 조각들을 땅에 놓고, 지나가는 무언가에 밟혀 깨질 준비를 했다."

#. ~ Description for {'str': 'glass shard trap'}
#: data\json\items\tool\traps.json
msgid ""
"Same glass shard as before but you can activate it to place it on the "
"ground, it will make noise when stepped on."
msgstr "아까와 같은 유리 조각이지만, 활성화해 땅에 놓을 수 있습니다. 밟으면 소리가 납니다."

#: data\json\items\tool\woodworking.json
msgid "wood axe"
msgid_plural "wood axes"
msgstr[0] "벌목용 도끼"

#. ~ Description for {'str': 'wood axe'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a large, two-handed wood axe.  It makes a good melee weapon, but is "
"a bit slow to recover between swings."
msgstr "큼직한 양손 벌목 도끼. 근접 무기로 쓸 만하지만 휘두르는 동작이 커서 틈이 많습니다."

#: data\json\items\tool\woodworking.json
msgid "bronze axe"
msgid_plural "bronze axes"
msgstr[0] "청동 도끼"

#. ~ Description for {'str': 'bronze axe'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a large, two-handed wood axe with a bronze axehead.  It makes a good"
" melee weapon, but is a bit slow to recover between swings."
msgstr "청동 도끼날이 있는 대형 양손 나무 도끼입니다. 좋은 근접 무기지만 휘두른 후 회복이 약간 느립니다."

#: data\json\items\tool\woodworking.json
msgid "chainsaw (off)"
msgid_plural "chainsaws (off)"
msgstr[0] "전기톱 (꺼짐)"

#. ~ Use action msg for {'str': 'chainsaw (off)', 'str_pl': 'chainsaws
#. (off)'}.
#: data\json\items\tool\woodworking.json
msgid "You turn on the chainsaw."
msgstr "전기톱을 켰다."

#. ~ Description for {'str': 'chainsaw (off)', 'str_pl': 'chainsaws (off)'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a lumbering tool moonlighting as weapon of opportunity.  If loaded "
"with gas, using this item will cause it to turn on, turning it into a very "
"powerful but unwieldy melee weapon."
msgstr ""
"상황에 따라 무기로도 사용되는 벌목용 장비. 사용하면 매우 강력하지만 근접 무기로는 사용하기 힘든 무기가 됩니다. 휘발유로 작동합니다."

#: data\json\items\tool\woodworking.json
msgid "chainsaw (on)"
msgid_plural "chainsaws (on)"
msgstr[0] "전기톱 (켜짐)"

#. ~ Use action msg for {'str': 'chainsaw (on)', 'str_pl': 'chainsaws (on)'}.
#: data\json\items\tool\woodworking.json
msgid "You turn off the chainsaw."
msgstr "전기톱을 껐다."

#. ~ Description for {'str': 'chainsaw (on)', 'str_pl': 'chainsaws (on)'}
#: data\json\items\tool\woodworking.json
msgid "This chainsaw is on and making a lot of noise.  Use it to turn it off."
msgstr "전기톱이 작동 중이며, 많은 소음을 발생시키고 있다. 사용하면 동작을 멈춘다."

#: data\json\items\tool\woodworking.json
msgid "circular saw (off)"
msgid_plural "circular saws (off)"
msgstr[0] "원형톱 (꺼짐)"

#. ~ Use action msg for {'str': 'circular saw (off)', 'str_pl': 'circular saws
#. (off)'}.
#: data\json\items\tool\woodworking.json
msgid "You turn on the circular saw."
msgstr "원형톱의 전원을 켰습니다."

#. ~ Description for {'str': 'circular saw (off)', 'str_pl': 'circular saws
#. (off)'}
#: data\json\items\tool\woodworking.json
msgid ""
"A lightweight handheld cordless circular saw.  Spins a circular blade fast "
"enough to cut wood, zombies, or in an emergency, pizza.  The blade, while "
"effective in combat, is hard to hit with due to its small size."
msgstr ""
"가벼운 무선 충전식 원형 톱이다. 나무, 좀비, 비상시엔 피자도 자를 수 있을 만큼 빠르게 원형 날을 돌린다. 날이 전투에서 효과적이지만"
" 크기가 작아 맞히기 어렵다."

#: data\json\items\tool\woodworking.json
msgid "circular saw (on)"
msgid_plural "circular saws (on)"
msgstr[0] "원형톱 (켜짐)"

#. ~ Use action msg for {'str': 'circular saw (on)', 'str_pl': 'circular saws
#. (on)'}.
#: data\json\items\tool\woodworking.json
msgid "You turn off the circular saw."
msgstr "원형 톱을 껐다."

#. ~ Description for {'str': 'circular saw (on)', 'str_pl': 'circular saws
#. (on)'}
#: data\json\items\tool\woodworking.json
msgid ""
"A lightweight handheld cordless circular saw.  It is currently on and the "
"blade is spinning; use this item to turn it off."
msgstr "소형 경량 무선 작동식 원형톱. 현재 작동 중이며, 톱날이 회전하고 있다. 사용하면 동작을 멈춘다."

#: data\json\items\tool\woodworking.json
msgid "copper axe"
msgid_plural "copper axes"
msgstr[0] "구리 도끼"

#. ~ Description for {'str': 'copper axe'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a decent-sized chunk of worked copper affixed to a wooden shaft, to "
"make a crude yet effective axe."
msgstr "딱 알맞은 크기의 구리 도끼날이 나무 막대와 결합된, 투박하지만 효과적인 도끼입니다."

#: data\json\items\tool\woodworking.json
msgid "hatchet"
msgid_plural "hatchets"
msgstr[0] "손도끼"

#. ~ Description for {'str': 'hatchet'}
#: data\json\items\tool\woodworking.json
msgid ""
"A one-handed hatchet.  Makes a great melee weapon, and is useful both for "
"chopping things and for use as a hammer."
msgstr "한 손으로 쓸 수 있는 손도끼이다. 근접 무기로도 좋지만 대상을 쪼개거나 망치처럼 쓸 수도 있다."

#: data\json\items\tool\woodworking.json
msgid "electric chainsaw (off)"
msgid_plural "electric chainsaws (off)"
msgstr[0] "전기톱 (꺼짐)"

#. ~ Use action msg for {'str': 'electric chainsaw (off)', 'str_pl': 'electric
#. chainsaws (off)'}.
#: data\json\items\tool\woodworking.json
msgid "You turn on the electric chainsaw."
msgstr "전기톱을 켰다."

#. ~ Description for {'str': 'electric chainsaw (off)', 'str_pl': 'electric
#. chainsaws (off)'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a lumbering tool moonlighting as weapon of opportunity.  If loaded "
"with batteries, using this item will cause it to turn on, turning it into a "
"very powerful but unwieldy melee weapon."
msgstr ""
"상황에 따라 무기로도 사용되는 벌목용 장비. 사용하면 매우 강력하지만 근접 무기로는 사용하기 힘든 무기가 됩니다. 배터리로 작동합니다."

#: data\json\items\tool\woodworking.json
msgid "electric chainsaw (on)"
msgid_plural "electric chainsaws (on)"
msgstr[0] "전기톱 (켜짐)"

#. ~ Use action msg for {'str': 'electric chainsaw (on)', 'str_pl': 'electric
#. chainsaws (on)'}.
#: data\json\items\tool\woodworking.json
msgid "You turn off the electric chainsaw."
msgstr "전기톱을 껐다."

#. ~ Description for {'str': 'electric chainsaw (on)', 'str_pl': 'electric
#. chainsaws (on)'}
#: data\json\items\tool\woodworking.json
msgid ""
"This electric chainsaw is on and making a lot of noise.  Use it to turn it "
"off."
msgstr "전기톱이 작동 중이며, 많은 소음을 발생시키고 있다. 사용하면동작을 멈춘다."

#: data\json\items\tool\woodworking.json
msgid "primitive adze"
msgid_plural "primitive adzes"
msgstr[0] "원시 아즈"

#. ~ Conditional name for {'str': 'primitive adze'} when COMPONENT_ID matches
#. rock
#: data\json\items\tool\woodworking.json
msgid "stone adze"
msgid_plural "stone adzes"
msgstr[0] "돌 자귀"

#. ~ Conditional name for {'str': 'primitive adze'} when COMPONENT_ID matches
#. ceramic
#: data\json\items\tool\woodworking.json
msgid "ceramic adze"
msgid_plural "ceramic adzes"
msgstr[0] "세라믹 아즈"

#. ~ Description for {'str': 'primitive adze'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a stone or ceramic adze, somewhat useful for smoothing wood objects."
msgstr "돌이나 세라믹 아즈로, 나무 물건을 매끄럽게 하는 데 다소 유용합니다."

#: data\json\items\tool\woodworking.json
msgid "primitive axe"
msgid_plural "primitive axes"
msgstr[0] "원시 도끼"

#. ~ Conditional name for {'str': 'primitive axe'} when COMPONENT_ID matches
#. rock
#: data\json\items\tool\woodworking.json
msgid "stone axe"
msgid_plural "stone axes"
msgstr[0] "돌 도끼"

#. ~ Conditional name for {'str': 'primitive axe'} when COMPONENT_ID matches
#. ceramic
#: data\json\items\tool\woodworking.json
msgid "ceramic axe"
msgid_plural "ceramic axes"
msgstr[0] "세라믹 도끼"

#. ~ Description for {'str': 'primitive axe'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a stone with a narrow edge affixed to a stick.  It can chop wood, "
"but requires much more effort than a modern axe."
msgstr "막대기에 붙인 좁은 날의 돌입니다. 나무를 팰 수 있지만 현대 도끼보다 훨씬 힘이 듭니다."

#: data\json\items\tool\woodworking.json
msgid "wood saw"
msgid_plural "wood saws"
msgstr[0] "목공톱"

#. ~ Description for {'str': 'wood saw'}
#: data\json\items\tool\woodworking.json
msgid "This is a thin saw, useful for cutting through wood objects."
msgstr "나무를 자를 때 유용하게 쓰이는 얇은 톱."

#: data\json\items\tool\woodworking.json
msgid "stone chisel"
msgid_plural "stone chisels"
msgstr[0] "돌 끌"

#. ~ Description for {'str': 'stone chisel'}
#: data\json\items\tool\woodworking.json
msgid ""
"This is a short stone chisel.  It can be used to engrave on stone, wood, or "
"soft metals."
msgstr "짧은 돌 끌입니다. 돌, 나무, 부드러운 금속에 새기는 데 쓸 수 있습니다."

#: data\json\items\tool\woodworking.json
msgid "primitive tomahawk"
msgid_plural "primitive tomahawks"
msgstr[0] "원시 토마호크"

#. ~ Conditional name for {'str': 'primitive tomahawk'} when COMPONENT_ID
#. matches rock
#: data\json\items\tool\woodworking.json
msgid "stone tomahawk"
msgid_plural "stone tomahawks"
msgstr[0] "돌 토마호크"

#. ~ Conditional name for {'str': 'primitive tomahawk'} when COMPONENT_ID
#. matches ceramic
#: data\json\items\tool\woodworking.json
msgid "ceramic tomahawk"
msgid_plural "ceramic tomahawks"
msgstr[0] "세라믹 토마호크"

#. ~ Conditional name for {'str': 'primitive tomahawk'} when COMPONENT_ID
#. matches bone
#: data\json\items\tool\woodworking.json
msgid "bone tomahawk"
msgid_plural "bone tomahawks"
msgstr[0] "뼈 토마호크"

#. ~ Description for {'str': 'primitive tomahawk'}
#: data\json\items\tool\woodworking.json
msgid ""
"A lightweight one-handed combat hatchet typically made of stone or bone, "
"originally used by the Algonquian people.  It makes for a half decent tool "
"and weapon."
msgstr "원래 알곤퀸족이 쓰던, 보통 돌이나 뼈로 만든 경량 한손 전투 손도끼입니다. 그럭저럭 괜찮은 도구이자 무기입니다."

#: data\json\items\tool\woodworking.json
msgid "copper tomahawk"
msgid_plural "copper tomahawks"
msgstr[0] "구리 토마호크"

#. ~ Description for {'str': 'copper tomahawk'}
#: data\json\items\tool\woodworking.json
msgid ""
"A lightweight one-handed combat hatchet made using basic copper.  Slightly "
"better than stone, though not as historically accurate."
msgstr "기본 구리로 만든 경량 한손 전투 손도끼입니다. 돌보다 약간 낫지만, 역사적으로 정확하진 않습니다."

#: data\json\items\tool\woodworking.json
msgid "sandpaper"
msgid_plural "sandpapers"
msgstr[0] "사포"

#. ~ Description for {'str': 'sandpaper'}
#: data\json\items\tool\woodworking.json
msgid ""
"A sheet of cloth or paper with an abrasive material glued to one side, "
"historically glass or sand, modernly aluminum oxide or silicon carbide.  It "
"is commonly used to smooth, roughen, or strip a wooden surface."
msgstr ""
"한쪽 면에 연마 재료를 붙인 천이나 종이로, 역사적으로는 유리나 모래, 현대엔 산화알루미늄이나 탄화규소를 씁니다. 나무 표면을 매끄럽게 "
"하거나, 거칠게 하거나, 벗겨내는 데 흔히 쓰입니다."

#: data\json\items\tool\workshop.json
msgid "pallet of wet adobe bricks"
msgid_plural "pallets of wet adobe bricks"
msgstr[0] "젖은 아도베 벽돌 팔레트"

#. ~ Use action msg for {'str': 'pallet of wet adobe bricks', 'str_pl':
#. 'pallets of wet adobe bricks'}.
#: data\json\items\tool\workshop.json
msgid "You test the bricks, and they're solid enough to use."
msgstr "벽돌을 검사했고, 쓸 만큼 단단하다."

#. ~ Use action not_ready_msg for {'str': 'pallet of wet adobe bricks',
#. 'str_pl': 'pallets of wet adobe bricks'}.
#: data\json\items\tool\workshop.json
msgid "The bricks are still too damp to bear weight."
msgstr "벽돌이 아직 무게를 견디기엔 너무 축축하다."

#. ~ Description for {'str': 'pallet of wet adobe bricks', 'str_pl': 'pallets
#. of wet adobe bricks'}
#: data\json\items\tool\workshop.json
msgid ""
"A pallet full of heavy mud bricks which need to dry slowly to be usable."
msgstr "쓸 수 있게 천천히 말려야 하는 무거운 진흙 벽돌이 가득한 팔레트입니다."

#: data\json\items\tool\workshop.json
msgid "pallet of dry adobe bricks"
msgid_plural "pallets of dry adobe bricks"
msgstr[0] "마른 아도베 벽돌 팔레트"

#. ~ Description for {'str': 'pallet of dry adobe bricks', 'str_pl': 'pallets
#. of dry adobe bricks'}
#: data\json\items\tool\workshop.json
msgid ""
"A pallet of humble mud bricks that have dried out while you were out risking"
" your life.  Disassemble it to retrieve your frame and building supplies."
msgstr "당신이 목숨을 걸고 나간 사이 마른 소박한 진흙 벽돌 팔레트입니다. 분해해 프레임과 건축 자재를 회수합니다."

#: data\json\items\tool\workshop.json
msgid "pallet of wet ceramic"
msgid_plural "pallets of wet ceramic"
msgstr[0] "젖은 세라믹 팔레트"

#. ~ Use action msg for {'str': 'pallet of wet ceramic', 'str_pl': 'pallets of
#. wet ceramic'}.
#: data\json\items\tool\workshop.json
msgid "You test the ceramic, and it's the right consistency to use."
msgstr "세라믹을 검사했고, 쓰기에 적당한 농도다."

#. ~ Use action not_ready_msg for {'str': 'pallet of wet ceramic', 'str_pl':
#. 'pallets of wet ceramic'}.
#: data\json\items\tool\workshop.json
msgid "The ceramic is still too damp to be used."
msgstr "세라믹이 아직 쓰기엔 너무 축축하다."

#. ~ Description for {'str': 'pallet of wet ceramic', 'str_pl': 'pallets of
#. wet ceramic'}
#: data\json\items\tool\workshop.json
msgid ""
"A pallet full of crushed wet ceramic, which needs to dry slowly to be "
"usable."
msgstr "쓸 수 있게 천천히 말려야 하는 으깬 젖은 세라믹이 가득한 팔레트입니다."

#: data\json\items\tool\workshop.json
msgid "pallet of ceramic clay"
msgid_plural "pallets of ceramic clay"
msgstr[0] "세라믹 점토 팔레트"

#. ~ Description for {'str': 'pallet of ceramic clay', 'str_pl': 'pallets of
#. ceramic clay'}
#: data\json\items\tool\workshop.json
msgid ""
"A pallet of ceramic clay which is now ready to be made into pottery.  "
"Disassemble it to retrieve your sheet, frame and crafting supplies."
msgstr "이제 도자기로 만들 준비가 된 세라믹 점토 팔레트입니다. 분해해 시트, 프레임, 제작 자재를 회수합니다."

#: data\json\items\tool\workshop.json
msgid "acetylene-gas machine"
msgid_plural "acetylene-gas machines"
msgstr[0] "아세틸렌 가스 기계"

#. ~ Description for {'str': 'acetylene-gas machine'}
#: data\json\items\tool\workshop.json
msgid ""
"This bulky device takes water and calcium carbide and yields unpressurised "
"acetylene."
msgstr "이 부피 큰 장치는 물과 탄화칼슘을 받아 비가압 아세틸렌을 만듭니다."

#: data\json\items\tool\workshop.json
msgid "angle grinder"
msgid_plural "angle grinders"
msgstr[0] "앵글 그라인더"

#. ~ Description for {'str': 'angle grinder'}
#: data\json\items\tool\workshop.json
msgid ""
"This widespread powertool is often used for removing excess material or "
"polishing surfaces."
msgstr "이 널리 퍼진 전동공구는 과잉 재료 제거나 표면 연마에 흔히 쓰입니다."

#: data\json\items\tool\workshop.json
msgid "brick kiln"
msgid_plural "brick kilns"
msgstr[0] "벽돌 가마"

#. ~ Description for {'str': 'brick kiln'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a portable charcoal-fired kiln.  It is designed for firing bricks, "
"but you could use it to fire anything made of clay."
msgstr "목탄으로 작동하는 휴대용 가마. 원래 벽돌을 굽기 위한 것이지만 찰흙으로 만든 거라면 뭐든 구워낼 수 있습니다."

#: data\json\items\tool\workshop.json
msgid "carding paddles"
msgid_plural "pairs of carding paddles"
msgstr[0] "조면 장비"

#. ~ Description for {'str': 'carding paddles', 'str_pl': 'pairs of carding
#. paddles'}
#: data\json\items\tool\workshop.json
msgid ""
"A pair of toothy wooden paddles used to clean fibers for use in textile "
"production."
msgstr "직물 생산에 사용될 순수한 면을 만드는데 사용되는 주걱 모양의 나무 솔."

#: data\json\items\tool\workshop.json
msgid "paint chipper"
msgid_plural "paint chippers"
msgstr[0] "페인트 긁개"

#. ~ Description for {'str': 'paint chipper'}
#: data\json\items\tool\workshop.json
msgid "A tool similar to a chisel, designed to remove paint."
msgstr "페인트를 제거하기 위해 만들어진 끌처럼 생긴 도구."

#: data\json\items\tool\workshop.json
msgid "clamp"
msgid_plural "clamps"
msgstr[0] "클램프"

#. ~ Description for {'str': 'clamp'}
#: data\json\items\tool\workshop.json
msgid ""
"This clamp is useful for keeping things still, especially if you have "
"several of them."
msgstr "이 클램프는 물건을 고정하는 데 유용하며, 특히 여러 개 있으면 좋습니다."

#: data\json\items\tool\workshop.json
msgid "claw bar"
msgid_plural "claw bars"
msgstr[0] "클로 바"

#. ~ Description for {'str': 'claw bar'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a small prying tool with a clawed bend at one end for pulling "
"spikes.  Use it to open locked doors without destroying them or to lift "
"manhole covers.  You could also wield it to bash some heads in."
msgstr ""
"못을 뽑기 위해 한쪽 끝이 갈고리로 구부러진 작은 지렛대입니다. 사용해 잠긴 문을 파괴하지 않고 열거나 맨홀 뚜껑을 들어 올립니다. 몇몇"
" 머리를 깨는 데 휘두를 수도 있습니다."

#: data\json\items\tool\workshop.json
msgid "concrete mixer"
msgid_plural "concrete mixers"
msgstr[0] "콘크리트 믹서"

#. ~ Description for {'str': 'concrete mixer'}
#: data\json\items\tool\workshop.json
msgid ""
"A portable concrete mixer.  It is still large and heavy, but it can be "
"operated solo, and runs on batteries.  It also has a heater built in."
msgstr "휴대용 콘크리트 혼합기입니다. 아직 크고 무거우나 배터리로 충전시킬 수 있고 혼자서 작동합니다. 히터도 내장되어 있습니다."

#: data\json\items\tool\workshop.json
msgid "cordless drill"
msgid_plural "cordless drills"
msgstr[0] "무선 드릴"

#. ~ Description for {'str': 'cordless drill'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a cordless battery-powered drill with a selection of drill bits."
msgstr "배터리로 작동하는 무선 드릴입니다. 드릴 비트 세트가 딸려 있습니다."

#: data\json\items\tool\workshop.json
msgid "distaff and spindle"
msgid_plural "distaves and spindles"
msgstr[0] "물레"

#. ~ Description for {'str': 'distaff and spindle', 'str_pl': 'distaves and
#. spindles'}
#: data\json\items\tool\workshop.json
msgid ""
"A pair of specialized wooden rods used to spin fibers into thread and yarn."
msgstr "섬유를 실로 짜내는데 사용되도록 만들어진 나무 막대들."

#: data\json\items\tool\workshop.json
msgid "electric jackhammer"
msgid_plural "electric jackhammers"
msgstr[0] "전기 착암기"

#. ~ Description for {'str': 'electric jackhammer'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a construction tool for drilling through hard rock or other "
"surfaces.  It runs on a rechargeable cell, optionally compatible with UPS.  "
"Use it to blast a hole in adjacent solid terrain."
msgstr ""
"단단한 암석이나 다른 표면을 뚫는 건설 도구입니다. 충전 셀로 작동하고, 선택적으로 UPS와 호환됩니다. 사용해 인접한 단단한 지형에 "
"구멍을 뚫습니다."

#: data\json\items\tool\workshop.json
msgid "hacksaw"
msgid_plural "hacksaws"
msgstr[0] "쇠톱"

#. ~ Description for {'str': 'hacksaw'}
#: data\json\items\tool\workshop.json
msgid "This is a sturdy saw, useful for cutting through metal objects."
msgstr "금속 물체를 자를 때 유용하게 쓰이는 튼튼한 톱."

#: data\json\items\tool\workshop.json
msgid "wire saw"
msgid_plural "wire saws"
msgstr[0] "와이어 톱"

#. ~ Description for {'str': 'wire saw'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a flexible saw made from thin wire, with simple handles on either "
"end.  It should suffice for light metal and wood sawing, or for cutting "
"chain-link fences."
msgstr ""
"양끝에 간단한 손잡이가 있는 얇은 와이어로 만든 유연한 톱입니다. 가벼운 금속과 나무 톱질이나 체인링크 울타리 절단에 충분합니다."

#: data\json\items\tool\workshop.json src/construction.cpp
msgid "hammer"
msgid_plural "hammers"
msgstr[0] "망치"

#. ~ Description for {'str': 'hammer'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a demagnetized steel claw hammer with a wooden grip.  With a hammer,"
" nails, and two by fours in your inventory, you could board up adjacent "
"doors and windows.  It has myriad other uses as well."
msgstr ""
"나무 손잡이가 달린 소자된 강철 장도리다. 망치, 못, 2x4 목재를 인벤토리에 가지고 있으면 인접한 문과 창문을 판자로 막을 수 있다."
" 다른 무수히 많은 용도도 있다."

#: data\json\items\tool\workshop.json
msgid "bronze hammer"
msgid_plural "bronze hammers"
msgstr[0] "청동 망치"

#. ~ Description for {'str': 'bronze hammer'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a bronze claw hammer with a wooden grip, commonly used where sparks "
"from a steel hammer might be a safety hazard.  You could board up adjacent "
"doors and windows, among myriad other uses."
msgstr ""
"나무 그립이 있는 청동 네일 해머로, 강철 망치의 불꽃이 안전 위험이 되는 곳에서 흔히 쓰입니다. 인접한 문과 창을 판자로 막거나, "
"무수한 다른 용도로 쓸 수 있습니다."

#: data\json\items\tool\workshop.json
msgid "hand drill"
msgid_plural "hand drills"
msgstr[0] "손 드릴"

#. ~ Description for {'str': 'hand drill'}
#: data\json\items\tool\workshop.json
msgid ""
"A primitive manual drill with a single drill bit.  It is slow and it will "
"exhaust you quickly."
msgstr "손으로 돌리는 드릴. 속도가 느리고 빨리 지칩니다."

#: data\json\items\tool\workshop.json data\mods\2.7.4
#: KawaiiMaidMod\kawaii_override.json
msgid "rubber hose"
msgid_plural "rubber hoses"
msgstr[0] "고무호스"

#. ~ Description for {'str': 'rubber hose'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a flexible rubber hose.  It could be used for crafting, or siphoning"
" fuel from a vehicle."
msgstr "신축성 있는 고무호스. 재료로 쓰거나, 차량에서 연료를 빨아올릴 때 사용할 수 있습니다."

#: data\json\items\tool\workshop.json
msgid "plumbing kit"
msgid_plural "plumbing kits"
msgstr[0] "배관 키트"

#. ~ Description for {'str': 'plumbing kit'}
#: data\json\items\tool\workshop.json
msgid ""
"A compact kit for probing, joining, and extending fluid grid connections in "
"buildings."
msgstr "건물 내 유체 전력망 연결을 탐색, 연결, 확장하는 소형 키트입니다."

#: data\json\items\tool\workshop.json
msgid "bottle jack"
msgid_plural "bottle jacks"
msgstr[0] "보틀 잭"

#. ~ Description for {'str': 'bottle jack'}
#: data\json\items\tool\workshop.json
msgid "A portable hydraulic bottle jack used for lifting vehicles."
msgstr "병 모양의 휴대용 유압식 잭. 차량을 들어올리는 데 씁니다."

#: data\json\items\tool\workshop.json
msgid "makeshift jack"
msgid_plural "makeshift jacks"
msgstr[0] "간이 잭"

#. ~ Description for {'str': 'makeshift jack'}
#: data\json\items\tool\workshop.json
msgid ""
"A poorly constructed improvised scissor jack used for lifting vehicles if "
"you're brave enough to use it."
msgstr "조잡하게 급조한 가위 잭. 차량을 들어올리는 데 씁니다. 이걸 실제로 쓸 만한 용기가 있다면요."

#: data\json\items\tool\workshop.json
msgid "scissor jack"
msgid_plural "scissor jacks"
msgstr[0] "가위 잭"

#. ~ Description for {'str': 'scissor jack'}
#: data\json\items\tool\workshop.json
msgid "A compact scissor jack used for lifting vehicles."
msgstr "차량을 들어올리는 데 쓰는 간단한 가위형 잭."

#: data\json\items\tool\workshop.json
msgid "jackhammer"
msgid_plural "jackhammers"
msgstr[0] "착암기"

#. ~ Description for {'str': 'jackhammer'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a construction tool for drilling through hard rock or other "
"surfaces.  It runs on gasoline.  Use it (if loaded) to blast a hole in "
"adjacent solid terrain."
msgstr "단단한 돌이나 그외 표면에 구멍을 뚫는 건설 용구. 가솔린으로 작동하며 사용하면 인접한 단단한 지형에 구멍을 뚫습니다."

#: data\json\items\tool\workshop.json
msgid "Auger"
msgid_plural "Augers"
msgstr[0] "오거"

#. ~ Description for {'str': 'Auger'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a construction tool for boring holes in ground.  It runs on "
"gasoline.  For health reasons alone, augers are a worthwhile investment."
msgstr "땅에 구멍을 뚫는 건설 도구입니다. 휘발유로 작동합니다. 건강상 이유만으로도 오거는 가치 있는 투자입니다."

#: data\json\items\tool\workshop.json
msgid "electric kiln"
msgid_plural "electric kilns"
msgstr[0] "전기 가마"

#. ~ Description for {'str': 'electric kiln'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a portable electric kiln, powered by batteries.  It is designed for "
"firing bricks, but you could use it to fire anything made of clay.  With a "
"little mechanical know-how, you could probably even convert it to run "
"directly off a vehicle's power system."
msgstr ""
"배터리로 작동하는 전기 가마. 벽돌을 굽는 용도로 설계되었지만, 점토로 만든 무엇이든 구울 수 있습니다. 약간의 기계적 노하우만 있다면,"
" 차량의 전력 시스템으로 작동되게 바꿀 수도 있을 겁니다."

#: data\json\items\tool\workshop.json
msgid "gunsmith repair kit"
msgid_plural "gunsmith repair kits"
msgstr[0] "총기기술자 수리도구"

#. ~ Description for {'str': 'gunsmith repair kit'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a complete toolkit made to repair damaged firearms, disassemble "
"ammunition and manufacture firearm modifications.  Powered by standard "
"batteries, it can tackle any armory work when coupled with a hand press.  It"
" requires 25 charges of battery power per use."
msgstr ""
"손상된 화기를 수리하고, 탄약을 해체하고, 화기 개조를 제작하는 완전 공구 세트입니다. 표준 배터리로 작동하고, 수동 프레스와 결합하면 "
"모든 병기 작업을 처리합니다. 사용당 배터리 전력 25차지가 필요합니다."

#: data\json\items\tool\workshop.json
msgid "makeshift hammer"
msgid_plural "makeshift hammers"
msgstr[0] "간이 망치"

#. ~ Description for {'str': 'makeshift hammer'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a crude hammer made from a piece of metal affixed to a stick.  It "
"functions adequately as a hammer, but really can't compare to a proper one."
msgstr "막대기에 금속 조각을 붙인 조잡한 망치입니다. 망치로는 적당히 작동하지만, 제대로 된 것과는 비교가 안 됩니다."

#: data\json\items\tool\workshop.json
msgid "metal fileset"
msgid_plural "metal filesets"
msgstr[0] "금속 줄 세트"

#. ~ Description for {'str': 'metal fileset'}
#: data\json\items\tool\workshop.json
msgid ""
"These tools are commonly used to remove small amounts of materials from the "
"surface of metal objects."
msgstr "금속 물체 표면에서 소량의 재료를 제거하는 데 흔히 쓰이는 도구입니다."

#: data\json\items\tool\workshop.json
msgid "metallic smoother"
msgid_plural "metallic smoothers"
msgstr[0] "금속제 흙손"

#. ~ Description for {'str': 'metallic smoother'}
#: data\json\items\tool\workshop.json
msgid ""
"This metallic tool is most often used to smooth concrete, or mortar, in "
"construction projects."
msgstr "건설 현장에서 콘크리트나 회반죽을 평평하게 펴는데 쓰이는 금속제 도구."

#: data\json\items\tool\workshop.json data\mods\MagicalNights\items\tools.json
msgid "misc repair kit"
msgid_plural "misc repair kits"
msgstr[0] "잡다 수리 키트"

#. ~ Description for {'str': 'misc repair kit'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a portable toolkit, consisting of a small carving knife for precise "
"carving of replacement parts from raw materials, a wood saw for more heavy-"
"duty wood cutting, and a patch of soft material for cleaning surfaces.  If "
"supplied with duct tape, it can be used to repair certain items."
msgstr ""
"원재료로 교체 부품을 정밀 조각하는 작은 조각칼, 더 중량급 목공 톱, 표면 청소용 부드러운 재료 패치로 구성된 휴대용 공구 세트입니다."
" 덕트 테이프를 공급하면 특정 아이템 수리에 쓸 수 있습니다."

#: data\json\items\tool\workshop.json data\mods\MagicalNights\items\tools.json
msgid "makeshift repair kit"
msgid_plural "makeshift repair kits"
msgstr[0] "임시 수리 키트"

#. ~ Description for {'str': 'makeshift repair kit'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a portable toolkit, consisting of a primitive knife for carving "
"replacement parts, an adze for more heavy-duty wood cutting, and a patch of "
"soft material for cleaning surfaces.  It can be used to repair certain items"
" if supplied with pitch, though it isn't ideal for complex work."
msgstr ""
"교체 부품 조각용 원시 나이프, 더 중량급 목공용 아즈, 표면 청소용 부드러운 재료 패치로 구성된 휴대용 공구 세트입니다. 피치를 "
"공급하면 특정 아이템 수리에 쓸 수 있지만, 복잡한 작업엔 이상적이지 않습니다."

#: data\json\items\tool\workshop.json
msgid "plastic mold"
msgid_plural "plastic molds"
msgstr[0] "플라스틱 거푸집"

#. ~ Description for {'str': 'plastic mold'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a plastic mold.  It could be shaped and used to craft items made of "
"plastic."
msgstr "플라스틱 거푸집입니다. 이게 있으면 원하는 모양을 만들어서 플라스틱 물품을 제작할 수 있습니다."

#: data\json\items\tool\workshop.json
msgid "multi-tool"
msgid_plural "multi-tools"
msgstr[0] "멀티툴"

#. ~ Description for {'str': 'multi-tool'}
#: data\json\items\tool\workshop.json
msgid ""
"A cleverly designed all-in-one tool which combines several smaller tools "
"into the handles of a pair of pliers."
msgstr "여러 소형 도구를 펜치의 손잡이에 결합한 영리하게 설계된 만능 도구다."

#: data\json\items\tool\workshop.json
msgid "acetylene torch"
msgid_plural "acetylene torches"
msgstr[0] "아세틸렌 용접기"

#. ~ Description for {'str': 'acetylene torch', 'str_pl': 'acetylene torches'}
#: data\json\items\tool\workshop.json
msgid ""
"A compact tool kit intended for welding and cutting metal, this portable "
"oxyacetylene torch includes a torch handle and cutting attachment in an "
"easy-to-carry tote.  It requires connecting to pressurized cylinders of an "
"appropriate welding gas before use.  In addition to its metalworking uses, "
"you can activate it in order to destroy metal barriers."
msgstr ""
"용접 및 금속 절단을 위한 소형 공구 키트로, 이 휴대용 산소-아세틸렌 토치에는 쉽게 운반할 수 있는 가방에 토치 핸들과 절단 부착물이 "
"포함되어 있다. 사용하기 전에 적합한 용접 가스가 든 가압 실린더에 연결해야 한다. 금속 가공 외에도 활성화하여 금속 장벽을 파괴할 수 "
"있다."

#: data\json\items\tool\workshop.json
msgid "paint brush"
msgid_plural "paint brushes"
msgstr[0] "페인트 붓"

#. ~ Description for {'str': 'paint brush', 'str_pl': 'paint brushes'}
#: data\json\items\tool\workshop.json
msgid "A wide brush, suitable for painting walls."
msgstr "벽에 페인트칠을 할 때 사용하는 넓은 붓."

#: data\json\items\tool\workshop.json
msgid "pickaxe"
msgid_plural "pickaxes"
msgstr[0] "곡괭이"

#. ~ Description for {'str': 'pickaxe'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a large steel pickaxe, suitable for breaking up hard things or (with"
" enough skill) hard targets.  Strike the earth!"
msgstr "큰 강철 곡괭이, 단단한 것을 부수거나 적절한 기술이 있다면 단단한 적을 부수는데 적합합니다. 땅을 내려치세요!"

#: data\json\items\tool\workshop.json
msgid "debugging prospecting pick"
msgid_plural "debugging prospecting picks"
msgstr[0] "디버깅 광물 탐사 곡괭이"

#. ~ Description for {'str': 'debugging prospecting pick'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a medium pickaxe-slash-hammer that could reveal close by ore "
"pockets. This one has an obscene range, for debugging. God save your CPU."
msgstr "근처 광맥을 드러낼 수 있는 중형 곡괭이 겸 망치입니다. 디버그용으로 범위가 엄청납니다. CPU에 신의 가호를."

#: data\json\items\tool\workshop.json
msgid "crude prospecting pick"
msgid_plural "crude prospecting picks"
msgstr[0] "조잡한 광물 탐사 곡괭이"

#. ~ Description for {'str': 'crude prospecting pick'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a crude hammer-pick used for finding nearby mineral veins. Terrible "
"for anything you're not basically standing on."
msgstr "근처 광맥을 찾는 데 쓰는 조잡한 망치-곡괭이입니다. 기본적으로 서 있는 곳이 아니면 끔찍합니다."

#: data\json\items\tool\workshop.json
msgid "copper prospecting pick"
msgid_plural "copper prospecting picks"
msgstr[0] "구리 광물 탐사 곡괭이"

#. ~ Description for copper prospecting pick
#: data\json\items\tool\workshop.json
msgid ""
"This is a copper hammer-pick used for finding nearby mineral veins. Not "
"accurate enough for long range, but works."
msgstr "근처 광맥을 찾는 데 쓰는 구리 망치-곡괭이입니다. 원거리엔 부정확하지만 작동합니다."

#: data\json\items\tool\workshop.json
msgid "steel prospecting pick"
msgid_plural "steel prospecting picks"
msgstr[0] "강철 광물 탐사 곡괭이"

#. ~ Description for steel prospecting pick
#: data\json\items\tool\workshop.json
msgid ""
"This is a steel hammer-pick used for finding nearby mineral veins. Can help "
"you sniff out even faint traces of minerals."
msgstr "근처 광맥을 찾는 데 쓰는 강철 망치-곡괭이입니다. 희미한 광물 흔적도 냄새 맡아 찾도록 도울 수 있습니다."

#: data\json\items\tool\workshop.json
msgid "pin reamer"
msgid_plural "pin reamers"
msgstr[0] "핀 리머"

#. ~ Description for {'str': 'pin reamer'}
#: data\json\items\tool\workshop.json
msgid ""
"Handheld pin reamers of this kind are used to enlarge existing holes, or "
"remove any burs and such from them."
msgstr "이런 종류의 휴대용 핀 리머는 기존 구멍을 넓히거나 버를 제거하는 데 쓰입니다."

#: data\json\items\tool\workshop.json
msgid "pliers"
msgid_plural "pliers"
msgstr[0] "펜치"

#. ~ Description for {'str_sp': 'pliers'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a basic pair of slip-joint pliers, able to handle basic mechanical "
"work and pulling apart some ammunition cartridges.  Anything too complex "
"will require a wrench."
msgstr ""
"기본 슬립조인트 펜치 한 쌍으로, 기본 기계 작업과 일부 탄약 카트리지 해체를 처리합니다. 너무 복잡한 건 렌치가 필요합니다."

#: data\json\items\tool\workshop.json
msgid "electric polisher"
msgid_plural "electric polishers"
msgstr[0] "전동 사포기"

#. ~ Description for {'str': 'electric polisher'}
#: data\json\items\tool\workshop.json
msgid ""
"An electric polisher which can be used to buff metal surfaces until they are"
" reflective like a mirror."
msgstr "사용하면 금속 표면을 거울처럼 매끈하게 연마해주는 전자 공구입니다."

#: data\json\items\tool\workshop.json
msgid "stone hammer"
msgid_plural "stone hammers"
msgstr[0] "돌 망치"

#. ~ Description for {'str': 'stone hammer'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a rock affixed to a stick, in the crude facsimile of a hammer.  It "
"functions adequately as a hammer, but really can't compare to a proper one."
msgstr "돌을 막대기에 연결한 조잡한 망치. 대충 망치로 쓸 수는 있지만, 진짜 망치와는 비교할 수 없습니다."

#: data\json\items\tool\workshop.json
msgid "screwdriver"
msgid_plural "screwdrivers"
msgstr[0] "스크류드라이버"

#. ~ Description for {'str': 'screwdriver'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a Philips-head screwdriver.  It is important for almost all "
"electronics crafting, most mechanics crafting, and has many more uses."
msgstr "필립스제 스크류드라이버. 거의 모든 가전 및 기계공학 제작에 중요하며 그밖에 다른 용도도 많다."

#: data\json\items\tool\workshop.json
msgid "screwdriver set"
msgid_plural "screwdriver sets"
msgstr[0] "스크류드라이버 세트"

#. ~ Description for {'str': 'screwdriver set'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a set of screwdrivers in several sizes and blade types.  Guaranteed "
"to have the right tools for more precise work."
msgstr "크기, 용도별로 들어있는 스크류드라이버 세트. 더 정밀한 작업을 하는데 알맞습니다."

#: data\json\items\tool\workshop.json
msgid "firearm repair kit"
msgid_plural "firearm repair kits"
msgstr[0] "총기 수리도구"

#. ~ Description for {'str': 'firearm repair kit'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a portable toolkit made to repair damaged firearms.  Powered by "
"standard batteries, it is a vital tool for long-term firearms maintenance.  "
"It requires 100 charges of battery power per use."
msgstr ""
"손상을 입은 화기를 수리하기 위해 제작된 휴대용 연장 세트. 표준 배터리로 작동하며, 화기의 장기 유지보수를 위해서 없어서는 안 될 "
"필수적인 도구입니다. 한 번 사용할 때마다 배터리를 100씩 소모합니다."

#: data\json\items\tool\workshop.json
msgid "electric soldering iron"
msgid_plural "electric soldering irons"
msgstr[0] "전기 납땜 인두"

#. ~ Description for {'str': 'electric soldering iron'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a device with a metal tip that can get very hot.  It is necessary "
"for advanced electronics crafting.  You could also use it to cauterize "
"wounds, if you had to."
msgstr ""
"매우 뜨겁게 달굴 수 있는 금속 팁이 달린 기구. 고급 전자기기 제작에 필요합니다. 또한 상처를 지지는데에 사용할 수도 있습니다. "
"그렇게까지 해야만 한다면요."

#: data\json\items\tool\workshop.json
msgid "alcohol-fueled soldering iron"
msgid_plural "alcohol-fueled soldering irons"
msgstr[0] "알코올 연료 납땜 인두"

#. ~ Description for {'str': 'alcohol-fueled soldering iron'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a device with a metal tip that can get very hot.  It is necessary "
"for advanced electronics crafting.  A metal tip is hold over the burner to "
"create enough heat to solder.  Not as sophisticated as a regular soldering "
"iron."
msgstr ""
"매우 뜨거워질 수 있는 금속 팁이 달린 장치입니다. 고급 전자 제작에 필수입니다. 금속 팁을 버너 위에 올려 납땜할 충분한 열을 "
"만듭니다. 일반 납땜 인두만큼 정교하진 않습니다."

#: data\json\items\tool\workshop.json
msgid "toolbox"
msgid_plural "toolboxes"
msgstr[0] "연장통"

#. ~ Description for {'str': 'toolbox', 'str_pl': 'toolboxes'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a stout metal box containing a complete tool kit suitable for most "
"household maintenance and construction activities."
msgstr "실내 보수작업이나 건설에 적합한 도구 세트를 모두 담고 있는 투박한 금속 상자입니다."

#: data\json\items\tool\workshop.json
msgid "workshop toolbox"
msgid_plural "workshop toolboxes"
msgstr[0] "작업장 공구함"

#. ~ Description for {'str': 'workshop toolbox', 'str_pl': 'workshop
#. toolboxes'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a stout metal box containing a complete tool kit suitable for most "
"household maintenance and construction activities, as well as additional "
"tools used in workshops for advanced fabrication jobs."
msgstr "대부분의 가정 유지보수와 건설 활동에 적합한 완전 공구 세트와 작업장 고급 제작용 추가 도구가 든 튼튼한 금속 상자입니다."

#: data\json\items\tool\workshop.json
msgid "arc welder"
msgid_plural "arc welders"
msgstr[0] "아크 용접기"

#. ~ Description for {'str': 'arc welder'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a battery powered tool for welding metal pieces together using an "
"electric arc.  It is an indispensable tool for construction or repair."
msgstr "전기 아크로 금속 조각을 함께 용접하는 배터리 작동 도구입니다. 건설이나 수리에 없어선 안 될 도구입니다."

#: data\json\items\tool\workshop.json
msgid "wooden smoother"
msgid_plural "wooden smoothers"
msgstr[0] "목제 흙손"

#. ~ Description for {'str': 'wooden smoother'}
#: data\json\items\tool\workshop.json
msgid ""
"This large makeshift tool is used in smoothing concrete or mortar in "
"construction projects.  You could also use it as an improvised head-basher."
msgstr "건설 현장에서 콘크리트나 회반죽을 평평하게 펴는데 쓰이는 커다란 급조 도구. 머리를 후려치는데 쓸 수도 있다."

#: data\json\items\tool\workshop.json
msgid "wool staple"
msgid_plural "wool staples"
msgstr[0] "양털 뭉치"

#. ~ Description for {'str': 'wool staple'}
#: data\json\items\tool\workshop.json
msgid ""
"The natural cluster of wool fibers.  Could be processed to the felt patches "
"or yarns."
msgstr "천연 양모 섬유 뭉치다. 펠트 조각이나 실로 가공할 수 있다."

#: data\json\items\tool\workshop.json
msgid "X-Acto knife"
msgid_plural "X-Acto knives"
msgstr[0] "공작용 칼"

#. ~ Description for {'str': 'X-Acto knife', 'str_pl': 'X-Acto knives'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a small, sharp knife, designed for making precise cuts for textiles "
"or crafts.  It could cause decent damage, but is difficult to hit things "
"with it.  Its small, sharp blade allows for precision strikes in the hands "
"of the skilled.  It is too small to butcher corpses with."
msgstr ""
"섬유를 섬세하게 자르거나 공작품을 만드는데 쓰이는 작고 예리한 칼. 그럭저럭 나쁘지 않은 피해를 주지만, 공격을 명중시키기가 어렵다. "
"작고 날카로운 칼날은 숙련된 사람이 정확한 공격을 할 수 있도록 해준다. 시체를 도축하기에는 칼이 너무 작다."

#: data\json\items\tool\workshop.json
msgid "wrench"
msgid_plural "wrenches"
msgstr[0] "렌치"

#. ~ Description for {'str': 'wrench', 'str_pl': 'wrenches'}
#: data\json\items\tool\workshop.json
msgid ""
"This is an adjustable crescent wrench.  It could be a decent melee weapon, "
"and is used in many mechanics crafting recipes."
msgstr "조정가능한 반월형 렌치. 근접 무기로 적절하며 기계공학 제작에 많이 쓰입니다."

#: data\json\items\tool\workshop.json
msgid "leather hose"
msgid_plural "leather hoses"
msgstr[0] "가죽 호스"

#. ~ Description for leather hose
#: data\json\items\tool\workshop.json
msgid ""
"This is a hose made out of leather.  Watertight and flexiable, it can be "
"used to siphon fuel from a vehicle tank.  However, it's not as elastic a "
"rubber hose."
msgstr ""
"가죽으로 만든 호스입니다. 방수고 유연해서 차량 탱크에서 연료를 사이펀하는 데 쓸 수 있습니다. 하지만 고무 호스만큼 탄성이 있진 "
"않습니다."

#: data\json\items\tool\workshop.json
msgid "makeshift hand drill"
msgid_plural "makeshift hand drills"
msgstr[0] "임시 수동 드릴"

#. ~ Description for {'str': 'makeshift hand drill'}
#: data\json\items\tool\workshop.json
msgid ""
"This is a makeshift manual drill made out of pipe and improvised drill bit."
"  It is very slow and it will exhaust you quickly."
msgstr "파이프와 임시 드릴 비트로 만든 임시 수동 드릴입니다. 매우 느리고 금방 지칩니다."

#: data\json\items\vehicle\alternator.json
msgid "vehicle alternator"
msgid_plural "vehicle alternators"
msgstr[0] "차량용 발전기"

#: data\json\items\vehicle\alternator.json
#: data\json\vehicleparts\alternator.json
msgid "car alternator"
msgid_plural "car alternators"
msgstr[0] "차량 발전기"

#. ~ Description for {'str': 'car alternator'}
#: data\json\items\vehicle\alternator.json
msgid "A standard alternator used to power vehicle electrical systems."
msgstr "차량의 전기 시스템에 전력을 공급하는 데 쓰이는 표준 발전기."

#: data\json\items\vehicle\alternator.json
#: data\json\vehicleparts\alternator.json
msgid "motorbike alternator"
msgid_plural "motorbike alternators"
msgstr[0] "오토바이 발전기"

#. ~ Description for {'str': 'motorbike alternator'}
#: data\json\items\vehicle\alternator.json
msgid ""
"A compact lightweight alternator used to power small vehicle electrical "
"systems."
msgstr "소형 차량의 전기 시스템에 전력을 공급하는데 쓰이는 작고 가벼운 발전기입니다."

#: data\json\items\vehicle\alternator.json
#: data\json\vehicleparts\alternator.json
msgid "bicycle alternator"
msgid_plural "bicycle alternators"
msgstr[0] "자전거 교류발전기"

#. ~ Description for {'str': 'bicycle alternator'}
#: data\json\items\vehicle\alternator.json
msgid "A very lightweight alternator used to power a bicycle's headlights."
msgstr "자전거 헤드라이트에 전력을 공급하는 매우 가벼운 교류발전기다."

#: data\json\items\vehicle\alternator.json
#: data\json\vehicleparts\alternator.json
msgid "truck alternator"
msgid_plural "truck alternators"
msgstr[0] "트럭 발전기"

#. ~ Description for {'str': 'truck alternator'}
#: data\json\items\vehicle\alternator.json
msgid ""
"A larger and more powerful alternator used to power vehicle electrical "
"systems."
msgstr "차량의 전기 시스템에 전력을 공급하는 데 쓰이는 대형 발전기. 보통 발전기보다 더 크고 더 강력합니다."

#: data\json\items\vehicle\alternator.json
#: data\json\vehicleparts\alternator.json
msgid "7.5kW generator"
msgid_plural "7.5kW generators"
msgstr[0] "7.5kW 발전기"

#. ~ Description for {'str': '7.5kW generator'}
#: data\json\items\vehicle\alternator.json
msgid ""
"A bulky but efficient electrical generator designed to be attached to an "
"engine."
msgstr "엔진에 부착하도록 설계된 크지만 효율적인 전기 발전기다."

#: data\json\items\vehicle\animals.json data\json\vehicleparts\engine.json
msgid "yoke and harness"
msgid_plural "yokes and harnesses"
msgstr[0] "멍에와 하네스"

#. ~ Description for {'str': 'yoke and harness', 'str_pl': 'yokes and
#. harnesses'}
#: data\json\items\vehicle\animals.json
msgid ""
"A bar and harness to attach a creature to a wheeled vehicle, they then "
"should be able to pull it."
msgstr "생물을 바퀴 차량에 묶는 바와 하네스로, 생물이 끌 수 있게 합니다."

#: data\json\items\vehicle\armor.json
msgid "rebar grate"
msgid_plural "rebar grates"
msgstr[0] "철근 쇠창살"

#. ~ Description for {'str': 'rebar grate'}
#: data\json\items\vehicle\armor.json
msgid ""
"Interlocked sections of rebar that allows for light and effective "
"reinforcement of vehicle sections."
msgstr "철근을 서로 맞물리게 용접해 빛이 통하면서도 효과적으로 차량을 강화시킬 수 있게 만들었다."

#: data\json\items\vehicle\armor.json data\json\vehicleparts\armor.json
msgid "shock absorber"
msgid_plural "shock absorbers"
msgstr[0] "충격흡수기"

#. ~ Description for {'str': 'shock absorber'}
#: data\json\items\vehicle\armor.json
msgid ""
"This makeshift combination of springs and scrap, when attached to a vehicle "
"section, protects that section from impacts.  The springs can absorb a "
"surprising amount of damage."
msgstr ""
"용수철과 강철판을 대강 용접해 만든 것으로 차량에 부착하면 부착 부위를 충격으로부터 보호해준다. 용수철은 상상 이상으로 충격을 많이 "
"줄여준다."

#: data\json\items\vehicle\armor.json data\json\vehicleparts\misc.json
msgid "NBC seal"
msgid_plural "NBC seals"
msgstr[0] "NBC 밀봉"

#. ~ Description for {'str': 'NBC seal'}
#: data\json\items\vehicle\armor.json
msgid ""
"A series of lead-based gaskets, seals and other things meant to keep all "
"Nuclear, Biological, and Chemical contaminants out of a vehicle.  Installing"
" this on a tile will protect people seated there from toxic gas and "
"radiation."
msgstr ""
"차량에서 모든 핵, 생물, 화학 오염물질을 차단하기 위한 납 기반 개스킷, 실, 기타 부품입니다. 타일에 설치하면 앉은 사람을 유독 "
"가스와 방사선에서 보호합니다."

#: data\json\items\vehicle\balloon.json data\json\vehicleparts\balloons.json
msgid "airship balloon"
msgid_plural "airship balloons"
msgstr[0] "비행선 풍선"

#. ~ Description for {'str': 'airship balloon'}
#: data\json\items\vehicle\balloon.json
msgid ""
"A big plastic airbag filled with hydrogen gas.  Provides lift if installed "
"on a vehicle, but you'll need a propeller to do anything more than float up "
"and down."
msgstr ""
"수소 가스로 채운 큰 플라스틱 에어백입니다. 차량에 설치하면 상승력을 제공하지만, 위아래로 뜨는 것 이상을 하려면 프로펠러가 필요합니다."

#: data\json\items\vehicle\battery.json data\json\vehicleparts\battery.json
msgid "car battery"
msgid_plural "car batteries"
msgstr[0] "자동차 배터리"

#. ~ Description for {'str': 'car battery', 'str_pl': 'car batteries'}
#: data\json\items\vehicle\battery.json
msgid "A 12v lead-acid battery used to power car electrical systems."
msgstr "12v 납산 축전지로, 일반 차량의 전력 시스템을 작동시킬 때 사용합니다."

#: data\json\items\vehicle\battery.json data\json\vehicleparts\battery.json
msgid "motorbike battery"
msgid_plural "motorbike batteries"
msgstr[0] "오토바이 배터리"

#. ~ Description for {'str': 'motorbike battery', 'str_pl': 'motorbike
#. batteries'}
#: data\json\items\vehicle\battery.json
msgid ""
"A 12v lead-acid battery used to power smaller vehicles' electrical systems."
msgstr "12v 납산 축전지로, 소형 차량의 전력 시스템을 작동시킬 때 사용합니다."

#: data\json\items\vehicle\battery.json
msgid "small motorbike battery"
msgid_plural "small motorbike batteries"
msgstr[0] "소형 오토바이 배터리"

#. ~ Description for {'str': 'small motorbike battery', 'str_pl': 'small
#. motorbike batteries'}
#: data\json\items\vehicle\battery.json
msgid ""
"A miniature 12v lead-acid battery used to power smaller vehicles' electrical"
" systems."
msgstr "소형 차량 전기 시스템에 전력을 공급하는 소형 12v 납산 배터리입니다."

#: data\json\items\vehicle\battery.json
msgid "storage battery case"
msgid_plural "storage battery cases"
msgstr[0] "배터리 케이스"

#. ~ Description for {'str': 'storage battery case'}
#: data\json\items\vehicle\battery.json
msgid ""
"An empty case that can hold a storage battery, complete with charging "
"controller chip, connecting wires, and mechanisms to help lift the battery "
"to be mounted into position."
msgstr "충전 제어 칩, 연결 와이어, 배터리를 위치에 장착하도록 돕는 기구가 갖춰진, 축전지를 담을 수 있는 빈 케이스입니다."

#: data\json\items\vehicle\battery.json data\json\vehicleparts\battery.json
msgid "very large storage battery"
msgid_plural "very large storage batteries"
msgstr[0] "초대형 축전지"

#. ~ Description for {'str': 'very large storage battery', 'str_pl': 'very
#. large storage batteries'}
#: data\json\items\vehicle\battery.json
msgid ""
"A huge storage battery containing many lithium-ion cells.  Holds a "
"tremendous amount of energy.  Could be installed into a storage battery case"
" for easy removal from a vehicle, or just welded straight in."
msgstr ""
"많은 리튬이온 셀이 든 거대 축전지입니다. 엄청난 양의 에너지를 담습니다. 차량에서 쉽게 탈착하도록 축전지 케이스에 설치하거나, 그냥 "
"용접할 수 있습니다."

#: data\json\items\vehicle\battery.json data\json\vehicleparts\battery.json
#: data\mods\ProjectSquirrel\monsters\sq_mechs.json
msgid "medium storage battery"
msgid_plural "medium storage batteries"
msgstr[0] "중형 배터리"

#. ~ Description for {'str': 'medium storage battery', 'str_pl': 'medium
#. storage batteries'}
#: data\json\items\vehicle\battery.json
msgid "A medium storage battery containing multiple lithium-ion cells."
msgstr "여러 리튬이온 셀이 든 중형 축전지입니다."

#: data\json\items\vehicle\battery.json data\json\vehicleparts\battery.json
msgid "sea scooter battery"
msgid_plural "sea scooter batteries"
msgstr[0] "바다 스쿠터 배터리"

#. ~ Description for {'str': 'sea scooter battery', 'str_pl': 'sea scooter
#. batteries'}
#: data\json\items\vehicle\battery.json
msgid ""
"A medium storage battery customized to fit specifically inside the hull of a"
" sea scooter. It also weighs less."
msgstr "바다 스쿠터 선체 안에 맞게 특별 제작된 중형 축전지입니다. 무게도 더 적습니다."

#: data\json\items\vehicle\battery.json data\json\vehicleparts\battery.json
msgid "small storage battery"
msgid_plural "small storage batteries"
msgstr[0] "소형 배터리"

#. ~ Description for {'str': 'small storage battery', 'str_pl': 'small storage
#. batteries'}
#: data\json\items\vehicle\battery.json
msgid ""
"A small storage battery created with pre-Cataclysm lithium-ion technology.  "
"Useful for crafting."
msgstr "대재앙 이전 리튬이온 기술로 만든 소형 축전지입니다. 제작에 유용합니다."

#: data\json\items\vehicle\battery.json data\json\vehicleparts\battery.json
#: data\mods\ProjectSquirrel\monsters\sq_mechs.json
msgid "large storage battery"
msgid_plural "large storage batteries"
msgstr[0] "대형 축전지"

#. ~ Description for {'str': 'large storage battery', 'str_pl': 'large storage
#. batteries'}
#: data\json\items\vehicle\battery.json
msgid ""
"A large storage battery containing many lithium-ion cells.  Could be "
"installed into a storage battery case for easy removal from a vehicle, or "
"just welded straight in."
msgstr "많은 리튬이온 셀이 든 대형 축전지입니다. 차량에서 쉽게 탈착하도록 축전지 케이스에 설치하거나, 그냥 용접할 수 있습니다."

#: data\json\items\vehicle\boat.json
msgid "wood boat hull"
msgid_plural "wood boat hulls"
msgstr[0] "목재 보트 선체"

#. ~ Description for {'str': 'wood boat hull'}
#: data\json\items\vehicle\boat.json
msgid ""
"A wooden board that keeps the boat afloat.  Add boat hulls to a vehicle "
"until it floats.  Then attach oars or a motor to get the boat to move."
msgstr ""
"보트가 떠있게 해주는 나무 판자다. 차량이 뜰 때까지 보트 선체를 추가한다. 그런 다음 노나 모터를 부착하면 보트가 이동할 수 있다."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\hulls.json
msgid "raft boat hull"
msgid_plural "raft boat hulls"
msgstr[0] "뗏목 선체"

#. ~ Description for {'str': 'raft boat hull'}
#: data\json\items\vehicle\boat.json
msgid ""
"Logs tied together to make a vehicle float.  Add boat hulls to a vehicle "
"until it floats.  Then attach oars or a motor to get the boat to move."
msgstr ""
"차량을 뜨게 만드는 묶인 통나무들입니다. 차량이 뜰 때까지 보트 선체를 추가합니다. 그 다음 노나 모터를 달아 배를 움직입니다."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\hulls.json
msgid "gas sac buoyancy cell"
msgid_plural "gas sac buoyancy cells"
msgstr[0] "가스낭 부양 셀"

#. ~ Description for {'str': 'gas sac buoyancy cell'}
#: data\json\items\vehicle\boat.json
msgid ""
"Several bags tied together, filled with hydrogen to provide buoyancy.  Add "
"buoyancy cells to a vehicle until it floats, or install enough to provide "
"lift for an airship."
msgstr ""
"부양력을 위해 수소로 채운, 함께 묶인 여러 주머니입니다. 차량이 뜰 때까지 부양 셀을 추가하거나, 비행선용 상승력을 제공할 만큼 "
"설치합니다."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\hulls.json
msgid "plastic boat hull"
msgid_plural "plastic boat hulls"
msgstr[0] "플라스틱 보트 선체"

#. ~ Description for {'str': 'plastic boat hull'}
#: data\json\items\vehicle\boat.json
msgid ""
"A rigid plastic sheet that keeps the boat afloat.  Add boat hulls to a "
"vehicle until it floats.  Then attach oars or a motor to get the boat to "
"move."
msgstr ""
"보트가 떠있게 해주는 딱딱한 플라스틱 판자다. 차량이 뜰 때까지 보트 선체를 추가한다. 그런 다음 노나 모터를 부착하면 보트가 이동할 수"
" 있다."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\hulls.json
msgid "carbon fiber boat hull"
msgid_plural "carbon fiber boat hulls"
msgstr[0] "탄소 섬유 보트 선체"

#. ~ Description for {'str': 'carbon fiber boat hull'}
#: data\json\items\vehicle\boat.json
msgid ""
"A carbon fiber sheet that keeps the boat afloat.  Add boat hulls to a "
"vehicle until it floats.  Then attach oars or a motor to get the boat to "
"move."
msgstr ""
"보트가 떠있게 해주는 탄소 섬유 시트다. 차량이 뜰 때까지 보트 선체를 추가한다. 그런 다음 노나 모터를 부착하면 보트가 이동할 수 "
"있다."

#: data\json\items\vehicle\boat.json
msgid "oars"
msgid_plural "oars"
msgstr[0] "노"

#. ~ Description for {'str_sp': 'oars'}
#: data\json\items\vehicle\boat.json
msgid "Oars for a boat."
msgstr "보트에 쓰이는 노."

#: data\json\items\vehicle\boat.json
msgid "sail"
msgid_plural "sails"
msgstr[0] "돛"

#. ~ Description for {'str': 'sail'}
#: data\json\items\vehicle\boat.json
msgid "A small sail and makeshift rigging for a raft."
msgstr "뗏목용 작은 돛과 임시 장비입니다."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\engine.json
msgid "large sail"
msgid_plural "large sails"
msgstr[0] "대형 돛"

#. ~ Description for {'str': 'large sail'}
#: data\json\items\vehicle\boat.json
msgid ""
"A wooden mast with sails fit for a yacht or sloop, and about as much rigging"
" as a single sailor can handle."
msgstr "요트나 슬루프에 맞는 돛이 달린 나무 마스트와, 한 명의 선원이 감당할 수 있는 정도의 장비입니다."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\hulls.json
msgid "inflatable section"
msgid_plural "inflatable section"
msgstr[0] "고무보트 바닥"

#. ~ Description for {'str_sp': 'inflatable section'}
#: data\json\items\vehicle\boat.json
msgid "An inflatable boat section."
msgstr "공기주입식 보트 바닥."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\hulls.json
msgid "inflatable airbag"
msgid_plural "inflatable airbag"
msgstr[0] "공기주머니"

#. ~ Description for {'str_sp': 'inflatable airbag'}
#: data\json\items\vehicle\boat.json
msgid "An inflatable airbag."
msgstr "공기주입식 주머니."

#: data\json\items\vehicle\boat.json data\json\vehicleparts\hulls.json
msgid "hovercraft impeller"
msgid_plural "hovercraft impeller"
msgstr[0] "호버크래프트 임펠러"

#. ~ Description for {'str_sp': 'hovercraft impeller'}
#: data\json\items\vehicle\boat.json
msgid ""
"An impeller and skirt used by air-cushion-vehicles to float just above the "
"surface of land or water."
msgstr "공기부양 차량이 땅이나 물 표면 바로 위를 뜨게 하는 임펠러와 스커트입니다."

#: data\json\items\vehicle\cables.json data\json\vehicleparts\cables.json
msgid "jumper cable"
msgid_plural "jumper cables"
msgstr[0] "점퍼 케이블"

#. ~ Description for {'str': 'jumper cable'}
#: data\json\items\vehicle\cables.json
msgid ""
"A jumper cable, like you've seen many times before: it's a short multi-"
"stranded copper cable with power leads on either end, whose main purpose is "
"to share power between vehicles, but can also link other electrical systems."
msgstr ""
"여러 번 본 적 있는 점프 케이블입니다. 양끝에 전원 리드가 있는 짧은 다심 구리 케이블로, 주 용도는 차량 간 전력 공유지만 다른 전기"
" 시스템을 연결할 수도 있습니다."

#: data\json\items\vehicle\cables.json data\json\vehicleparts\cables.json
msgid "heavy duty tow cable"
msgid_plural "heavy duty tow cables"
msgstr[0] "중량 견인 케이블"

#. ~ Description for heavy duty tow cable
#: data\json\items\vehicle\cables.json
msgid ""
"An extremely heavy duty tow cable made from thick steel wire.  If attached "
"to a vehicle, it could be used to pull another vehicle of any weight."
msgstr "두꺼운 강철 와이어로 만든 극도의 중량 견인 케이블입니다. 차량에 부착하면 어떤 무게의 다른 차량도 끌 수 있습니다."

#: data\json\items\vehicle\cables.json data\json\vehicleparts\cables.json
msgid "heavy-duty cable"
msgid_plural "heavy-duty cables"
msgstr[0] "굵은 케이블"

#. ~ Description for {'str': 'heavy-duty cable'}
#: data\json\items\vehicle\cables.json
msgid ""
"A long, thick, heavy-duty cable with power leads on either end.  It looks "
"like you could use it to hook up two vehicles to each other.  Can also link "
"other electrical systems."
msgstr ""
"양끝에 전원 리드가 있는 길고 두꺼운 중량 케이블입니다. 두 차량을 연결할 수 있을 것 같습니다. 다른 전기 시스템을 연결할 수도 "
"있습니다."

#: data\json\items\vehicle\cables.json data\json\vehicleparts\cables.json
msgid "shiny cable"
msgid_plural "shiny cables"
msgstr[0] "빛나는 케이블"

#. ~ Description for {'str': 'shiny cable'}
#: data\json\items\vehicle\cables.json
msgid ""
"This is the cable of the gods: 50 meters long, light as a feather and fits "
"in a matchbook.  You're sure this wasn't supposed to exist, and the way it "
"shimmers makes you uneasy."
msgstr ""
"신들의 케이블입니다: 50미터 길이에 깃털처럼 가볍고 성냥갑에 들어갑니다. 존재해선 안 될 물건이 확실하고, 반짝이는 방식이 불안하게 "
"만듭니다."

#: data\json\items\vehicle\cargo.json data\json\vehicleparts\cargo.json
msgid "large wire basket"
msgid_plural "large wire baskets"
msgstr[0] "대형 철망 바구니"

#. ~ Description for {'str': 'large wire basket'}
#: data\json\items\vehicle\cargo.json
msgid "A large wire basket from a shopping cart."
msgstr "쇼핑카트에 달리는 큰 철사 바구니."

#: data\json\items\vehicle\cargo.json data\json\vehicleparts\cargo.json
msgid "bike rack"
msgid_plural "bike racks"
msgstr[0] "자전거 거치대"

#. ~ Description for {'str': 'bike rack'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A collection of pipes, cams, and straps, mounted on the edge of a vehicle "
"and used to support another vehicle for transport.  It must be mounted on a "
"vehicle to be used."
msgstr "다른 차량을 운송하기 위해 차량 가장자리에 장착된 파이프, 캠, 스트랩의 집합체다. 사용하려면 차량에 장착해야 한다."

#: data\json\items\vehicle\cargo.json data\json\vehicleparts\cargo.json
msgid "large folding wire basket"
msgid_plural "large folding wire baskets"
msgstr[0] "대형 접이식 철망 바구니"

#. ~ Description for {'str': 'large folding wire basket'}
#: data\json\items\vehicle\cargo.json
msgid "A large wire basket from a shopping cart, modified to be foldable."
msgstr "쇼핑카트에서 떼어낸 커다란 철사 바구니를 접을 수 있게 개조한 것이다."

#: data\json\items\vehicle\cargo.json data\json\vehicleparts\cargo.json
msgid "small folding wire basket"
msgid_plural "small folding wire baskets"
msgstr[0] "소형 접이식 철망 바구니"

#. ~ Description for {'str': 'small folding wire basket'}
#: data\json\items\vehicle\cargo.json
msgid "A simple wire basket.  It is small and foldable."
msgstr "간단한 철망 바구니입니다. 작고 접을 수 있습니다."

#: data\json\items\vehicle\cargo.json
msgid "cargo carrier"
msgid_plural "cargo carriers"
msgstr[0] "화물 운반고"

#. ~ Description for {'str': 'cargo carrier'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A heavy frame outfitted with tie-downs and attachment points for carrying "
"cargo."
msgstr "화물을 운반하기 위한 고정끈과 적재고가 갖춰진 무거운 프레임이다."

#: data\json\items\vehicle\cargo.json
msgid "carbon cargo carrier"
msgid_plural "carbon cargo carriers"
msgstr[0] "탄소 화물 운반대"

#. ~ Description for {'str': 'carbon cargo carrier'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A sturdy, yet lightweight carbon structure outfitted with tie-downs and "
"attachment points for carrying cargo."
msgstr "화물 운반용 타이다운과 부착점이 갖춰진, 튼튼하면서도 가벼운 탄소 구조물입니다."

#: data\json\items\vehicle\cargo.json data\json\vehicleparts\cargo.json
msgid "floor trunk"
msgid_plural "floor trunks"
msgstr[0] "플로어 트렁크"

#. ~ Description for {'str': 'floor trunk'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A section of flooring with a cargo-space beneath, and a hinged door for "
"access."
msgstr "아래 화물 공간과 접근용 힌지 문이 있는 바닥 구역입니다."

#: data\json\items\vehicle\cargo.json
msgid "carbon floor trunk"
msgid_plural "carbon floor trunks"
msgstr[0] "탄소 바닥 트렁크"

#. ~ Description for {'str': 'carbon floor trunk'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A section of carbon flooring with a cargo-space beneath, and a hinged door "
"for access."
msgstr "아래 화물 공간과 접근용 힌지 문이 있는 탄소 바닥 구역입니다."

#: data\json\items\vehicle\cargo.json
msgid "livestock carrier"
msgid_plural "livestock carriers"
msgstr[0] "가축 운반대"

#. ~ Description for {'str': 'livestock carrier'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A heavy frame outfitted with tie-downs and attachment points for carrying "
"cargo, with additional railings to keep a large animal in place.  It is "
"meant to hold large animals for transport.  Use it on a suitable animal to "
"capture, use it on an empty tile to release."
msgstr ""
"대형 동물을 고정하기 위한 레일이 추가된, 화물 고박 장치와 연결 포인트가 장착된 무거운 프레임이다. 대형 동물을 운반하기 위한 것이다."
" 적합한 동물에 사용하여 포획하거나, 빈 타일에 사용하여 방출한다."

#: data\json\items\vehicle\cargo.json data\json\vehicleparts\cargo.json
msgid "mounted spare tire"
msgid_plural "mounted spare tires"
msgstr[0] "장착 예비 타이어"

#. ~ Description for {'str': 'mounted spare tire'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A spare tire mounted on a carrier rig, ready to be attached to the rear "
"bumper of a vehicle."
msgstr "차량 후범퍼에 부착할 준비가 된, 운반대에 장착된 예비 타이어입니다."

#: data\json\items\vehicle\cargo.json
msgid "animal locker"
msgid_plural "animal lockers"
msgstr[0] "동물 보관함"

#. ~ Description for {'str': 'animal locker'}
#: data\json\items\vehicle\cargo.json
msgid ""
"A locker used to contain animals safely during transportation if installed "
"properly.  There is room for animal food and other animal care goods.  It is"
" meant to hold medium or smaller animals for transport.  Use it on a "
"suitable animal to capture, use it on an empty tile to release."
msgstr ""
"제대로 설치되면 운송 중 동물을 안전하게 보관하는 보관함이다. 동물 먹이와 기타 동물 관련 용품을 넣을 공간이 있다. 중형 이하의 동물을"
" 운반하기 위한 것이다. 적합한 동물에 사용하여 포획하거나, 빈 타일에 사용하여 방출한다."

#: data\json\items\vehicle\controls.json
msgid "camera display"
msgid_plural "camera displays"
msgstr[0] "카메라 화면"

#. ~ Description for {'str': 'camera display'}
#: data\json\items\vehicle\controls.json
msgid "A set of small monitors.  Required to view cameras' output."
msgstr "카메라 출력정보를 볼 수 있도록 해주는 소형 모니터."

#: data\json\items\vehicle\controls.json data\json\vehicleparts\controls.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "security camera"
msgid_plural "security cameras"
msgstr[0] "감시 카메라"

#. ~ Description for {'str': 'security camera'}
#: data\json\items\vehicle\controls.json
msgid ""
"A security camera you could connect to a display.  Image quality is quite "
"low, but the field of vision is great."
msgstr "화면에 연결할 수 있는 감시 카메라. 화질은 상당히 낮지만, 대신 가시 범위는 넓다."

#: data\json\items\vehicle\controls.json
msgid "vehicle controls"
msgid_plural "sets of vehicle controls"
msgstr[0] "차량 조종장치"

#. ~ Description for {'str': 'vehicle controls', 'str_pl': 'sets of vehicle
#. controls'}
#: data\json\items\vehicle\controls.json
msgid "A set of various vehicle controls.  Useful for crafting."
msgstr "다양한 자동차 조종장치 세트이다. 제작에 사용된다."

#: data\json\items\vehicle\controls.json
msgid "vehicle tracking device"
msgid_plural "vehicle tracking devices"
msgstr[0] "차량 추적장치"

#. ~ Description for {'str': 'vehicle tracking device'}
#: data\json\items\vehicle\controls.json
msgid ""
"A vehicle tracking device.  When installed on a vehicle it allows you track "
"the vehicle."
msgstr "차량 추적장치. 차량에 설치하면 차량을 위치를 쉽게 파악할 수 있습니다."

#: data\json\items\vehicle\controls.json
msgid "rein and tackle"
msgid_plural "reins and tackles"
msgstr[0] "고삐와 도구"

#. ~ Description for {'str': 'rein and tackle', 'str_pl': 'reins and tackles'}
#: data\json\items\vehicle\controls.json
msgid "A set of leather bindings to control a mountable creature."
msgstr "탈 수 있는 생물을 제어하는 가죽 묶음 세트입니다."

#: data\json\items\vehicle\controls.json data\json\vehicleparts\controls.json
msgid "dashboard"
msgid_plural "dashboards"
msgstr[0] "대시보드"

#. ~ Description for {'str': 'dashboard'}
#. ~ Description for {'str': 'electronics control unit'}
#: data\json\items\vehicle\controls.json
msgid ""
"A vehicle instrument panel with various gauges and switches.  Useful for "
"crafting."
msgstr "각종 계기와 스위치가 달린 차량 계기판이다. 제작에 유용하다."

#: data\json\items\vehicle\controls.json data\json\vehicleparts\controls.json
msgid "electronics control unit"
msgid_plural "electronics control units"
msgstr[0] "전자기기 제어장치"

#: data\json\items\vehicle\controls.json data\json\vehicleparts\controls.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "drive by wire controls"
msgid_plural "sets of drive by wire controls"
msgstr[0] "전자식 조종장치"

#. ~ Description for {'str': 'drive by wire controls', 'str_pl': 'sets of
#. drive by wire controls'}
#: data\json\items\vehicle\controls.json
msgid ""
"Fully electronic vehicle control system.  You could control it remotely if "
"you had proper tools."
msgstr "완전 전자식 차량 조종장치이다. 적절한 도구가 있다면 차량을 원격 통제할 수 있다."

#: data\json\items\vehicle\controls.json
msgid "robot driving unit"
msgid_plural "robot driving units"
msgstr[0] "로봇 조종장치"

#. ~ Description for {'str': 'robot driving unit'}
#: data\json\items\vehicle\controls.json
msgid ""
"A set of servos, microcontrollers and other devices, together capable of "
"driving an unmanned vehicle.  Its AI is not functional, but it should still "
"have some sort of maintenance mode."
msgstr ""
"서보 모터와 미세 조종장치, 그밖의 장치들을 합쳐서 무인 차량을 운전할 수 있게 만든 세트이다. AI가 작동하지 않는 상태이지만 일종의 "
"유지보수 모드가 있다."

#: data\json\items\vehicle\controls.json data\json\vehicleparts\turret.json
msgid "turret control unit"
msgid_plural "turret control units"
msgstr[0] "터렛 제어 장치"

#. ~ Description for {'str': 'turret control unit'}
#: data\json\items\vehicle\controls.json
msgid ""
"A set of motor, camera, and various electronic modules banded together to "
"allow for tracking targets, friend-or-foe identification, and firing the "
"connected turret in full automatic mode."
msgstr "표적 추적, 피아식별, 연결된 터렛의 완전 자동 발사를 허용하도록 묶인 모터, 카메라, 각종 전자 모듈 세트입니다."

#: data\json\items\vehicle\controls.json
msgid "vehicle laser designator"
msgid_plural "vehicle laser designators"
msgstr[0] "차량 레이저 지시기"

#. ~ Description for {'str': 'vehicle laser designator'}
#: data\json\items\vehicle\controls.json
msgid ""
"A laser rangefinder with associated targeting software, designed to be "
"installed on a vehicle-mounted turret.  Installing it on a vehicle-mounted "
"weapon will greatly increases accuracy, but only when firing it remotely "
"such as from the vehicle control menu."
msgstr ""
"차량 장착 터렛에 설치하도록 설계된, 관련 표적 소프트웨어가 있는 레이저 거리계입니다. 차량 장착 무기에 설치하면 정확도를 크게 "
"높이지만, 차량 제어 메뉴에서 원격 발사할 때만 해당합니다."

#: data\json\items\vehicle\controls.json data\json\vehicleparts\turret.json
msgid "bomb bay"
msgid_plural "bomb bays"
msgstr[0] "폭탄창"

#. ~ Description for {'str': 'bomb bay'}
#: data\json\items\vehicle\controls.json
msgid ""
"A set of motors and various mechanical linkages banded together to allow for"
" activation and dropping of select items from cargo spaces."
msgstr "화물 공간에서 특정 아이템의 활성화와 투하를 허용하도록 묶인 모터와 각종 기계 연동장치 세트입니다."

#: data\json\items\vehicle\engine.json
msgid "internal combustion engine"
msgid_plural "internal combustion engines"
msgstr[0] "내연기관"

#: data\json\items\vehicle\engine.json
msgid "base diesel engine"
msgid_plural "base diesel engines"
msgstr[0] "베이스 디젤 엔진"

#: data\json\items\vehicle\engine.json
msgid "strong diesel engine"
msgid_plural "strong diesel engines"
msgstr[0] "강력 디젤 엔진"

#: data\json\items\vehicle\engine.json
msgid "base gasoline engine"
msgid_plural "base gasoline engines"
msgstr[0] "베이스 휘발유 엔진"

#: data\json\items\vehicle\engine.json
msgid "strong gasoline engine"
msgid_plural "strong gasoline engines"
msgstr[0] "강력 가솔린 엔진"

#: data\json\items\vehicle\engine.json
msgid "base steam engine"
msgid_plural "base steam engines"
msgstr[0] "베이스 증기 엔진"

#: data\json\items\vehicle\engine.json
msgid "1-cylinder engine"
msgid_plural "1-cylinder engines"
msgstr[0] "단기통 엔진"

#. ~ Description for {'str': '1-cylinder engine'}
#: data\json\items\vehicle\engine.json
msgid "A single-cylinder 4-stroke combustion engine."
msgstr "단기통 4행정 연소 엔진."

#: data\json\items\vehicle\engine.json
msgid "large 1-cylinder engine"
msgid_plural "large 1-cylinder engines"
msgstr[0] "대형 1기통 엔진"

#. ~ Description for {'str': 'large 1-cylinder engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A powerful high-compression single-cylinder 4-stroke combustion engine."
msgstr "강력한 고압축 단기통 4행정 내연기관입니다."

#: data\json\items\vehicle\engine.json
msgid "Inline-4 engine"
msgid_plural "Inline-4 engines"
msgstr[0] "I4 엔진"

#. ~ Description for {'str': 'Inline-4 engine'}
#: data\json\items\vehicle\engine.json
msgid "A small, yet powerful 4-cylinder combustion engine."
msgstr "작지만 강한 직렬 4기통 연소 엔진."

#: data\json\items\vehicle\engine.json
msgid "I6 diesel engine"
msgid_plural "I6 diesel engines"
msgstr[0] "I6 디젤 엔진"

#. ~ Description for {'str': 'I6 diesel engine'}
#: data\json\items\vehicle\engine.json
msgid "A powerful straight-6 diesel engine."
msgstr "강력한 직렬 8기통 디젤 엔진."

#: data\json\items\vehicle\engine.json
msgid "V-twin engine"
msgid_plural "V-twin engines"
msgstr[0] "V2 엔진"

#. ~ Description for {'str': 'V-twin engine'}
#: data\json\items\vehicle\engine.json
msgid "A 2-cylinder 4-stroke combustion engine."
msgstr "2기통 4행정 연소 엔진."

#: data\json\items\vehicle\engine.json
msgid "V6 engine"
msgid_plural "V6 engines"
msgstr[0] "V6 엔진"

#. ~ Description for {'str': 'V6 engine'}
#: data\json\items\vehicle\engine.json
msgid "A powerful 6-cylinder combustion engine."
msgstr "강력한 6기통 연소 엔진."

#: data\json\items\vehicle\engine.json
msgid "V6 diesel engine"
msgid_plural "V6 diesel engines"
msgstr[0] "V6 디젤 엔진"

#. ~ Description for {'str': 'V6 diesel engine'}
#: data\json\items\vehicle\engine.json
msgid "A powerful 6-cylinder diesel engine."
msgstr "강력한 6기통 디젤 엔진."

#: data\json\items\vehicle\engine.json
msgid "V8 engine"
msgid_plural "V8 engines"
msgstr[0] "V8 엔진"

#. ~ Description for {'str': 'V8 engine'}
#: data\json\items\vehicle\engine.json
msgid "A large and very powerful 8-cylinder combustion engine."
msgstr "크고 아주 강력한 8기통 연소 엔진."

#: data\json\items\vehicle\engine.json
msgid "V8 diesel engine"
msgid_plural "V8 diesel engines"
msgstr[0] "V8 디젤 엔진"

#. ~ Description for {'str': 'V8 diesel engine'}
#: data\json\items\vehicle\engine.json
msgid "A powerful 8-cylinder diesel engine."
msgstr "강력한 8기통 디젤 엔진."

#: data\json\items\vehicle\engine.json
msgid "V12 engine"
msgid_plural "V12 engines"
msgstr[0] "V12 엔진"

#. ~ Description for {'str': 'V12 engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A massive and extremely powerful V12 engine, usually built into high end "
"sports cars."
msgstr "육중하고 극도로 강력한 12기통 엔진. 일반적으로 고급 스포츠카에 사용된다."

#: data\json\items\vehicle\engine.json
msgid "V12 diesel engine"
msgid_plural "V12 diesel engines"
msgstr[0] "V12 디젤엔진"

#. ~ Description for {'str': 'V12 diesel engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A massive and extremely powerful V12 engine, usually built into heavy "
"trucks."
msgstr "육중하고 극도로 강력한 12기통 엔진. 일반적으로 대형 트럭에 사용된다."

#: data\json\items\vehicle\engine.json
msgid "makeshift steam engine"
msgid_plural "makeshift steam engines"
msgstr[0] "간이 증기 엔진"

#. ~ Description for {'str': 'makeshift steam engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A small, primitive, steam engine.  An integrated boiler burns coal to heat "
"water into steam, driving a reciprocating shaft.  A condenser recaptures the"
" water, making this a closed cycle system."
msgstr "소형 원시 증기 기관. 통합 보일러가 석탄을 태워 물을 증기로 가열하고 왕복 운동으로 구동합니다."

#: data\json\items\vehicle\engine.json
msgid "small steam engine"
msgid_plural "small steam engines"
msgstr[0] "소형 증기 기관"

#. ~ Description for {'str': 'small steam engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A small steam engine.  An integrated boiler burns coal to heat water into "
"steam, driving a reciprocating shaft.  A condenser recaptures the water, "
"making this a closed cycle system."
msgstr "소형 증기 기관. 통합 보일러가 석탄을 태워 물을 증기로 가열하고 왕복 운동으로 구동합니다."

#: data\json\items\vehicle\engine.json
msgid "medium steam engine"
msgid_plural "medium steam engines"
msgstr[0] "중형 증기 기관"

#. ~ Description for {'str': 'medium steam engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A medium-sized steam engine.  An integrated boiler burns coal to heat water "
"into steam, driving a reciprocating shaft.  A condenser recaptures the "
"water, making this a closed cycle system."
msgstr ""
"중형 증기기관입니다. 통합 보일러가 석탄을 태워 물을 증기로 데우고, 왕복 축을 구동합니다. 응축기가 물을 회수해 폐쇄 순환 시스템이 "
"됩니다."

#: data\json\items\vehicle\engine.json
msgid "1350 hp steam turbine engine"
msgid_plural "1350 hp steam turbine engines"
msgstr[0] "1350마력 증기 터빈 엔진"

#. ~ Description for {'str': '1350 hp steam turbine engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A powerful steam engine for power plants, burning coal to heat water into "
"steam and driving a turbine.  A condenser recaptures the water, making this "
"a closed cycle system.  Known for its high rate of fuel consumption, but "
"installing multiple turbines will not affect vehicle power."
msgstr ""
"발전소용 강력 증기기관으로, 석탄을 태워 물을 증기로 데우고 터빈을 구동합니다. 응축기가 물을 회수해 폐쇄 순환 시스템이 됩니다. 높은 "
"연료 소비로 알려져 있지만, 여러 터빈을 설치해도 차량 출력엔 영향이 없습니다."

#: data\json\items\vehicle\engine.json
msgid "massive engine block"
msgid_plural "massive engine blocks"
msgstr[0] "대형 엔진 블록"

#. ~ Description for {'str': 'massive engine block'}
#: data\json\items\vehicle\engine.json
msgid ""
"The beginnings of a massive gas or diesel engine.  It's not good for much of"
" anything on its own."
msgstr "대형 가솔린 또는 디젤 엔진의 초기 부품이다. 단독으로는 별로 쓸모가 없다."

#: data\json\items\vehicle\engine.json
msgid "large engine block"
msgid_plural "large engine blocks"
msgstr[0] "큰 엔진 블록"

#. ~ Description for {'str': 'large engine block'}
#: data\json\items\vehicle\engine.json
msgid ""
"The beginnings of a large gas or diesel engine.  It's not good for much of "
"anything on its own."
msgstr "큰 가솔린 또는 디젤 엔진의 초기 부품이다. 단독으로는 별로 쓸모가 없다."

#: data\json\items\vehicle\engine.json
msgid "medium engine block"
msgid_plural "medium engine blocks"
msgstr[0] "중형 엔진 블록"

#. ~ Description for {'str': 'medium engine block'}
#: data\json\items\vehicle\engine.json
msgid ""
"The beginnings of a medium gas or diesel engine.  It's not good for much of "
"anything on its own."
msgstr "중형 가솔린 또는 디젤 엔진의 초기 부품이다. 단독으로는 별로 쓸모가 없다."

#: data\json\items\vehicle\engine.json
msgid "small engine block"
msgid_plural "small engine blocks"
msgstr[0] "소형 엔진 블록"

#. ~ Description for {'str': 'small engine block'}
#: data\json\items\vehicle\engine.json
msgid ""
"The beginnings of a small gas or diesel engine.  It's not good for much of "
"anything on its own."
msgstr "소형 가솔린 또는 디젤 엔진의 초기 부품이다. 단독으로는 별로 쓸모가 없다."

#: data\json\items\vehicle\engine.json
msgid "tiny engine block"
msgid_plural "tiny engine blocks"
msgstr[0] "초소형 엔진 블록"

#. ~ Description for {'str': 'tiny engine block'}
#: data\json\items\vehicle\engine.json
msgid ""
"The beginnings of a tiny gas or diesel engine.  It's not good for much of "
"anything on its own."
msgstr "초소형 가솔린 또는 디젤 엔진의 초기 부품이다. 단독으로는 별로 쓸모가 없다."

#: data\json\items\vehicle\engine.json
msgid "1350 hp gas turbine engine"
msgid_plural "1350 hp gas turbine engines"
msgstr[0] "1350마력 가스 터빈 엔진"

#. ~ Description for {'str': '1350 hp gas turbine engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A gas turbine engine, usually used for military vehicles.  Known for its "
"high rate of fuel consumption, but installing multiple turbines will not "
"affect vehicle power."
msgstr ""
"보통 군용 차량에 쓰이는 가스 터빈 엔진입니다. 높은 연료 소비로 알려져 있지만, 여러 터빈을 설치해도 차량 출력엔 영향이 없습니다."

#: data\json\items\vehicle\engine.json
msgid "1900 hp gas turbine engine"
msgid_plural "1900 hp gas turbine engines"
msgstr[0] "1900마력 가스 터빈 엔진"

#. ~ Description for {'str': '1900 hp gas turbine engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A large gas turbine engine, usually used for military helicopters.  Known "
"for its high rate of fuel consumption, but installing multiple turbines will"
" not affect vehicle power."
msgstr ""
"보통 군용 헬리콥터에 쓰이는 대형 가스 터빈 엔진입니다. 높은 연료 소비로 알려져 있지만, 여러 터빈을 설치해도 차량 출력엔 영향이 "
"없습니다."

#: data\json\items\vehicle\engine.json
msgid "6000 hp gas turbine engine"
msgid_plural "6000 hp gas turbine engines"
msgstr[0] "6000마력 가스 터빈 엔진"

#. ~ Description for {'str': '6000 hp gas turbine engine'}
#: data\json\items\vehicle\engine.json
msgid ""
"A massive gas turbine engine, used to power the V-22 Osprey.  Known for its "
"high rate of fuel consumption, but installing multiple turbines will not "
"affect vehicle power."
msgstr ""
"V-22 오스프리에 동력을 공급하는 거대 가스 터빈 엔진입니다. 높은 연료 소비로 알려져 있지만, 여러 터빈을 설치해도 차량 출력엔 "
"영향이 없습니다."

#: data\json\items\vehicle\engineering.json
msgid "steel boom crane"
msgid_plural "steel boom cranes"
msgstr[0] "강철 붐 크레인"

#. ~ Description for {'str': 'steel boom crane'}
#: data\json\items\vehicle\engineering.json
msgid ""
"A large rigid steel boom.  If attached to a frame it could be used to lift "
"up to 20 metric tonnes (or a bit over 44,000 pounds)."
msgstr "대형 강성 강철 붐입니다. 프레임에 부착하면 최대 20미터톤(약 44,000파운드 이상)까지 들 수 있습니다."

#: data\json\items\vehicle\engineering.json
msgid "telescopic cantilever crane"
msgid_plural "telescopic cantilever cranes"
msgstr[0] "텔레스코픽 캔틸레버 크레인"

#. ~ Description for {'str': 'telescopic cantilever crane'}
#: data\json\items\vehicle\engineering.json
msgid ""
"A small steel telescoping cantilever.  If attached to a frame it could be "
"used to lift up to 3.5 metric tonnes (or a bit over 7,700 pounds)."
msgstr "소형 강철 신축 캔틸레버입니다. 프레임에 부착하면 최대 3.5미터톤(약 7,700파운드 이상)까지 들 수 있습니다."

#: data\json\items\vehicle\engineering.json
#: data\json\vehicleparts\engineering.json
msgid "pallet lifter"
msgid_plural "pallet lifters"
msgstr[0] "팔렛 리프트"

#. ~ Description for {'str': 'pallet lifter'}
#: data\json\items\vehicle\engineering.json
msgid ""
"A makeshift pallet lifter.  If attached to a frame it could be used to lift "
"up to 0.5 metric tonnes (or a bit over 1,100 pounds)."
msgstr "임시 팔레트 리프터입니다. 프레임에 부착하면 최대 0.5미터톤(약 1,100파운드 이상)까지 들 수 있습니다."

#: data\json\items\vehicle\engineering.json
#: data\json\vehicleparts\engineering.json
msgid "rockwheel"
msgid_plural "rockwheels"
msgstr[0] "암반 절삭기"

#. ~ Description for {'str': 'rockwheel'}
#: data\json\items\vehicle\engineering.json
msgid "A large and heavy jagged metal disc to dig trenches."
msgstr "참호를 파기 위한 크고 무거운 톱니 금속 원반이다."

#: data\json\items\vehicle\engineering.json
#: data\json\vehicleparts\engineering.json
msgid "roadheader"
msgid_plural "roadheaders"
msgstr[0] "로드헤더"

#. ~ Description for {'str': 'roadheader'}
#: data\json\items\vehicle\engineering.json
msgid "A massive metal wheel-like drill used to bore tunnels."
msgstr "터널을 뚫는 데 쓰이는 거대 금속 바퀴형 드릴입니다."

#: data\json\items\vehicle\engineering.json
msgid "airjack"
msgid_plural "airjacks"
msgstr[0] "에어잭"

#. ~ Description for {'str': 'airjack'}
#: data\json\items\vehicle\engineering.json
msgid ""
"An extendable metal pylon used to replace a portable jack.  If mounted to a "
"vehicle, it could be used to lift it up, supporting vehicles up to 8.5 "
"metric tonnes (or a bit over 18,700 pounds)."
msgstr ""
"휴대용 잭을 대체하는 신축 금속 기둥입니다. 차량에 장착하면 들어 올려, 최대 8.5미터톤(약 18,700파운드 이상) 차량을 "
"지탱합니다."

#: data\json\items\vehicle\engineering.json
#: data\json\vehicleparts\engineering.json
msgid "motorcycle kickstand"
msgid_plural "motorcycle kickstands"
msgstr[0] "오토바이 킥스탠드"

#. ~ Description for {'str': 'motorcycle kickstand'}
#: data\json\items\vehicle\engineering.json
msgid ""
"A kickstand to keep the bike from falling over.  You could use this to lean "
"it forward or backward to change a tire, supporting vehicles up to 0.5 "
"metric tonnes (or a bit over 1,100 pounds)."
msgstr ""
"자전거가 넘어지지 않게 하는 킥스탠드입니다. 타이어를 바꾸기 위해 앞뒤로 기울여, 최대 0.5미터톤(약 1,100파운드 이상) 차량을 "
"지탱합니다."

#: data\json\items\vehicle\engineering.json
msgid "rope and pulley crane"
msgid_plural "rope and pulley cranes"
msgstr[0] "로프 도르래 크레인"

#. ~ Description for {'str': 'rope and pulley crane'}
#: data\json\items\vehicle\engineering.json
msgid ""
"A makeshift crane made from rope and pulleys.  If attached to a frame it "
"could be used to lift up to 2 metric tonnes (or a bit over 4,400 pounds)."
msgstr "로프와 도르래로 만든 임시 크레인입니다. 프레임에 부착하면 최대 2미터톤(약 4,400파운드 이상)까지 들 수 있습니다."

#: data\json\items\vehicle\farming.json
msgid "vehicle scoop"
msgid_plural "vehicle scoops"
msgstr[0] "차량용 수집기"

#. ~ Description for {'str': 'vehicle scoop'}
#: data\json\items\vehicle\farming.json
msgid ""
"An assembly of motors and sheet metal that allows a vehicle to clean the "
"road surface by removing debris and contaminants."
msgstr "모터와 금속판으로 만들어진 장치. 차량이 도로 표면의 쓰레기와 오염물을 청소할 수 있도록 해줍니다."

#: data\json\items\vehicle\farming.json data\json\vehicleparts\farming.json
msgid "seed drill"
msgid_plural "seed drills"
msgstr[0] "파종기"

#. ~ Description for {'str': 'seed drill'}
#: data\json\items\vehicle\farming.json
msgid ""
"An assembly of tubes, spikes, and wheels, that when dragged along the "
"ground, allows a vehicle to plant seeds automatically in suitably tilled "
"land."
msgstr "고무호스와 스파이크, 그리고 바퀴의 조합으로, 지표면을 따라 당길 때 잘 갈린 땅에 씨앗을 심게 해 줍니다."

#: data\json\items\vehicle\farming.json data\json\vehicleparts\farming.json
msgid "reaper"
msgid_plural "reapers"
msgstr[0] "수확기"

#. ~ Description for {'str': 'reaper'}
#: data\json\items\vehicle\farming.json
msgid ""
"An assembly of a blade, wheels, and a small lever for engaging/disengaging "
"used to cut down crops prior to picking them up."
msgstr "칼날과 바퀴, 켜고 끄기 위한 작은 레버가 달려 있어 작물을 수확하기 전에 베어 놓는 기구."

#: data\json\items\vehicle\farming.json data\json\vehicleparts\farming.json
msgid "advanced reaper"
msgid_plural "advanced reapers"
msgstr[0] "개량형 수확기"

#. ~ Description for {'str': 'advanced reaper'}
#: data\json\items\vehicle\farming.json
msgid ""
"An advanced electronic device used to cut down, collect and store crops."
msgstr "추수하는데 쓰는 고급 전자장비."

#: data\json\items\vehicle\farming.json data\json\vehicleparts\farming.json
msgid "advanced seed drill"
msgid_plural "advanced seed drills"
msgstr[0] "개량형 파종기"

#. ~ Description for {'str': 'advanced seed drill'}
#: data\json\items\vehicle\farming.json
msgid ""
"An assembly of tubes, spikes, and wheels, that when dragged along the "
"ground, allows a vehicle to plant seeds automatically in suitably tilled "
"land.  This one is equipped with an electronic control system and will avoid"
" damaging itself when used on untilled land."
msgstr ""
"고무호스와 스파이크, 그리고 바퀴의 조합으로, 지표면을 따라 당길 때 잘 갈린 땅에 씨앗을 심게 해 줍니다. 이것에는 전자 제어 장비가 "
"탑재되어 갈리지 않은 땅에 사용할 때 손상되는 것을 막습니다."

#: data\json\items\vehicle\farming.json data\json\vehicleparts\farming.json
msgid "plow"
msgid_plural "plows"
msgstr[0] "경작기"

#. ~ Description for {'str': 'plow'}
#: data\json\items\vehicle\farming.json
msgid "A heavy assembly of wheels and steel blades that turn up the ground."
msgstr "묵직한 바퀴와 회전하며 땅을 뒤엎는 강철 날을 합쳐놓은 것입니다."

#: data\json\items\vehicle\frames.json
msgid "foldable-light frame"
msgid_plural "foldable-light frames"
msgstr[0] "접이식 경량 프레임"

#. ~ Description for {'str': 'foldable-light frame'}
#: data\json\items\vehicle\frames.json
msgid "A small foldable lightweight frame made from pipework."
msgstr "접을 수 있는 작은 경량형 프레임이다. 파이프로 만들었다."

#: data\json\items\vehicle\frames.json
msgid "extra-light frame"
msgid_plural "extra-light frames"
msgstr[0] "초경량 프레임"

#. ~ Description for {'str': 'extra-light frame'}
#: data\json\items\vehicle\frames.json
msgid "A small lightweight frame made from pipework.  Useful for crafting."
msgstr "파이프로 만든 소형 경량 프레임이다. 제작에 쓰인다."

#: data\json\items\vehicle\frames.json
msgid "steel frame"
msgid_plural "steel frames"
msgstr[0] "강철 프레임"

#. ~ Description for {'str': 'steel frame'}
#: data\json\items\vehicle\frames.json
msgid "A large frame made of steel.  Useful for crafting."
msgstr "쇠로 만든 큰 프레임이다. 제작에 쓰인다."

#: data\json\items\vehicle\frames.json data\json\vehicleparts\frames.json
msgid "heavy duty frame"
msgid_plural "heavy duty frames"
msgstr[0] "고강도 프레임"

#. ~ Description for {'str': 'heavy duty frame'}
#: data\json\items\vehicle\frames.json
msgid ""
"A large, reinforced steel frame, used in military vehicle construction."
msgstr "군용 차량 건조에 사용되는 대형 강화 강철 프레임입니다."

#: data\json\items\vehicle\frames.json data\json\vehicleparts\frames.json
msgid "wooden frame"
msgid_plural "wooden frames"
msgstr[0] "목재 프레임"

#. ~ Description for {'str': 'wooden frame'}
#: data\json\items\vehicle\frames.json
msgid "A large frame made of wood.  Useful for crafting."
msgstr "나무로 된 커다란 프레임이다. 제작에 쓰인다."

#: data\json\items\vehicle\frames.json data\json\vehicleparts\frames.json
msgid "foldable wooden frame"
msgid_plural "foldable wooden frames"
msgstr[0] "접이식 목재 프레임"

#. ~ Description for {'str': 'foldable wooden frame'}
#: data\json\items\vehicle\frames.json
msgid "A small foldable frame made from scrap wood."
msgstr "접을 수 있는 소형 프레임이다. 폐 목재로 만들었다."

#: data\json\items\vehicle\frames.json data\json\vehicleparts\frames.json
msgid "light wooden frame"
msgid_plural "light wooden frames"
msgstr[0] "경량 목재 프레임"

#. ~ Description for {'str': 'light wooden frame'}
#: data\json\items\vehicle\frames.json
msgid ""
"A small frame made of few pieces of wood, held together by rope.  Useful for"
" crafting."
msgstr "나무조각 몇 개를 밧줄로 매어 만든 작은 프레임이다. 제작에 쓰인다."

#: data\json\items\vehicle\frames.json data\json\vehicleparts\frames.json
msgid "plastic frame"
msgid_plural "plastic frames"
msgstr[0] "플라스틱 프레임"

#. ~ Description for {'str': 'plastic frame'}
#: data\json\items\vehicle\frames.json
msgid ""
"A large  foldable frame made of plastic.  Useful for cheap and lightweight "
"vehicles."
msgstr "플라스틱으로 만든 대형 접이식 프레임입니다. 싸고 가벼운 차량에 유용합니다."

#: data\json\items\vehicle\frames.json data\json\vehicleparts\frames.json
msgid "carbon fiber frame"
msgid_plural "carbon fiber frames"
msgstr[0] "탄소섬유 프레임"

#. ~ Description for {'str': 'carbon fiber frame'}
#: data\json\items\vehicle\frames.json
msgid ""
"A large foldable frame made from sheets of carbon fiber.  Useful for "
"lightweight yet sturdy vehicles."
msgstr "탄소섬유 시트로 만든 대형 접이식 프레임입니다. 가볍지만 튼튼한 차량에 유용합니다."

#: data\json\items\vehicle\frames.json data\json\vehicleparts\frames.json
msgid "skateboard deck"
msgid_plural "skateboard decks"
msgstr[0] "스케이트보드 데크"

#. ~ Description for {'str': 'skateboard deck'}
#: data\json\items\vehicle\frames.json
msgid "A small skateboard frame made of thin layers of wood glued together."
msgstr "얇은 나무 층을 붙여 만든 소형 스케이트보드 프레임입니다."

#: data\json\items\vehicle\fuel_storage.json data\json\vehicleparts\tanks.json
msgid "fuel bunker"
msgid_plural "fuel bunkers"
msgstr[0] "연료 벙커"

#. ~ Description for {'str': 'fuel bunker'}
#: data\json\items\vehicle\fuel_storage.json
msgid "A bin for holding solid fuel."
msgstr "고체 연료를 보관하는 용기."

#: data\json\items\vehicle\jets.json data\json\vehicleparts\jets.json
msgid "jet thruster"
msgid_plural "jet thrusters"
msgstr[0] "제트 추진기"

#. ~ Description for {'str': 'jet thruster'}
#. ~ Description for jet thruster
#: data\json\items\vehicle\jets.json data\json\vehicleparts\jets.json
msgid ""
"This is a jet propulsion module used in military fighter jets.  It provides "
"extremely high thrust."
msgstr "군용 전투기에 쓰이는 제트 추진 모듈입니다. 극도로 높은 추력을 제공합니다."

#: data\json\items\vehicle\jets.json data\json\vehicleparts\jets.json
msgid "VTOL thruster"
msgid_plural "VTOL thrusters"
msgstr[0] "VTOL 추진기"

#. ~ Description for {'str': 'VTOL thruster'}
#. ~ Description for VTOL thruster
#: data\json\items\vehicle\jets.json data\json\vehicleparts\jets.json
msgid ""
"This is a vertical takeoff and landing (VTOL) propulsion system used in "
"military VTOL aircraft.  It provides both lift for taking off and thrust "
"when in the air."
msgstr "군용 VTOL 항공기에 쓰이는 수직 이착륙(VTOL) 추진 시스템입니다. 이륙용 상승력과 공중 추력 둘 다 제공합니다."

#: data\json\items\vehicle\jets.json data\json\vehicleparts\jets.json
msgid "hover repulsor"
msgid_plural "hover repulsors"
msgstr[0] "호버 리펄서"

#. ~ Description for {'str': 'hover repulsor'}
#. ~ Description for hover repulsor
#: data\json\items\vehicle\jets.json data\json\vehicleparts\jets.json
msgid ""
"This is an experimental hover repulsor module mounted on the underside of a "
"vehicle.  It allows the vehicle to glide and fly over rough terrain and "
"obstacles.  Though originally thought to be frictionless, unknown antigrav "
"phenomena nonetheless causes vehicles to experience a force similar to "
"friction when near the ground."
msgstr ""
"차량 하부에 장착된 실험용 호버 리펄서 모듈입니다. 차량이 거친 지형과 장애물 위를 활공하고 날 수 있게 합니다. 원래 무마찰로 "
"생각됐지만, 알 수 없는 반중력 현상이 지면 근처에서 마찰과 비슷한 힘을 경험하게 합니다."

#: data\json\items\vehicle\lights.json
msgid "car headlight"
msgid_plural "car headlights"
msgstr[0] "헤드라이트"

#. ~ Description for {'str': 'car headlight'}
#: data\json\items\vehicle\lights.json
msgid "A vehicle headlight to light up the way."
msgstr "길을 밝히는 차량용 헤드라이트입니다."

#: data\json\items\vehicle\lights.json data\json\vehicleparts\lights.json
msgid "motorcycle headlight"
msgid_plural "motorcycle headlights"
msgstr[0] "오토바이 전조등"

#. ~ Description for {'str': 'motorcycle headlight'}
#: data\json\items\vehicle\lights.json
msgid "A motorcycle headlight to light up the way."
msgstr "길을 비추는 오토바이 전조등입니다."

#: data\json\items\vehicle\lights.json
msgid "wide-angle car headlight"
msgid_plural "wide-angle car headlights"
msgstr[0] "광각 차량 헤드라이트"

#. ~ Description for {'str': 'wide-angle car headlight'}
#: data\json\items\vehicle\lights.json
msgid "A wide-angle vehicle headlight to light up the way."
msgstr "길을 밝혀주는 광각 차량 헤드라이트다."

#: data\json\items\vehicle\lights.json data\json\vehicleparts\lights.json
msgid "reinforced headlight"
msgid_plural "reinforced headlights"
msgstr[0] "보강된 헤드라이트"

#. ~ Description for {'str': 'reinforced headlight'}
#: data\json\items\vehicle\lights.json
msgid ""
"A vehicle headlight with a cage built around it to protect it from damage "
"without reducing its effectiveness."
msgstr "효율성의 감소 없이 손상으로부터 보호하기 위한 창살을 두른 차량용 헤드라이트입니다."

#: data\json\items\vehicle\lights.json data\json\vehicleparts\lights.json
msgid "reinforced wide-angle headlight"
msgid_plural "reinforced wide-angle headlights"
msgstr[0] "강화 광각 헤드라이트"

#. ~ Description for {'str': 'reinforced wide-angle headlight'}
#: data\json\items\vehicle\lights.json
msgid ""
"A wide-angle vehicle headlight with a cage built around it to protect it "
"from damage without reducing its effectiveness."
msgstr "효율을 떨어뜨리지 않으면서 손상으로부터 보호하기 위해 케이지가 장착된 광각 차량 헤드라이트다."

#: data\json\items\vehicle\lights.json
msgid "emergency vehicle light (red)"
msgid_plural "emergency vehicle lights (red)"
msgstr[0] "구급차 경광등 (빨간색)"

#. ~ Description for {'str': 'emergency vehicle light (red)', 'str_pl':
#. 'emergency vehicle lights (red)'}
#: data\json\items\vehicle\lights.json
msgid ""
"One of the red-colored lights from the top of an emergency services vehicle."
"  When turned on, the lights rotate to shine in all directions."
msgstr "구급차 위에서 떼어낸 빨간 조명이다. 켜면 빨간 빛이 회전하며 모든 방향을 비춘다."

#: data\json\items\vehicle\lights.json
msgid "emergency vehicle light (blue)"
msgid_plural "emergency vehicle lights (blue)"
msgstr[0] "구급차 경광등 (파란색)"

#. ~ Description for {'str': 'emergency vehicle light (blue)', 'str_pl':
#. 'emergency vehicle lights (blue)'}
#: data\json\items\vehicle\lights.json
msgid ""
"One of the blue-colored lights from the top of an emergency services "
"vehicle.  When turned on, the lights rotate to shine in all directions."
msgstr "구급차 위에서 떼어낸 파란 조명이다. 켜면 파란 빛이 회전하며 모든 방향을 비춘다."

#: data\json\items\vehicle\lights.json
msgid "emergency vehicle light (white)"
msgid_plural "emergency vehicle lights (white)"
msgstr[0] "긴급 차량 조명 (흰색)"

#. ~ Description for {'str': 'emergency vehicle light (white)', 'str_pl':
#. 'emergency vehicle lights (white)'}
#: data\json\items\vehicle\lights.json
msgid ""
"One of the white-colored lights from the top of an emergency services "
"vehicle.  When turned on, the lights rotate to shine in all directions."
msgstr "긴급 서비스 차량 위의 흰색 조명 중 하나입니다. 켜면 조명이 회전해 모든 방향을 비춥니다."

#: data\json\items\vehicle\lights.json data\json\vehicleparts\lights.json
msgid "floodlight"
msgid_plural "floodlights"
msgstr[0] "투광 조명등"

#. ~ Description for {'str': 'floodlight'}
#: data\json\items\vehicle\lights.json
msgid "A large and heavy light designed to illuminate wide areas."
msgstr "넓은 영역을 비추도록 설계된 크고 무거운 조명등이다."

#: data\json\items\vehicle\lights.json data\json\vehicleparts\lights.json
msgid "directed floodlight"
msgid_plural "directed floodlights"
msgstr[0] "집중 투광등"

#. ~ Description for {'str': 'directed floodlight'}
#: data\json\items\vehicle\lights.json
msgid ""
"A large and heavy light designed to illuminate a wide area in a half-"
"circular cone."
msgstr "반원형 원뿔 형태로 넓은 영역을 비추도록 설계된 크고 무거운 조명이다."

#: data\json\items\vehicle\manual.json
msgid "set of hand rims"
msgid_plural "sets of hand rims"
msgstr[0] "바퀴손잡이"

#. ~ Description for {'str': 'set of hand rims', 'str_pl': 'sets of hand
#. rims'}
#: data\json\items\vehicle\manual.json
msgid "Hand rims for use on a wheelchair."
msgstr "휠체어에 쓰이는 바퀴손잡이."

#: data\json\items\vehicle\manual.json
msgid "foot crank"
msgid_plural "foot cranks"
msgstr[0] "발 크랭크"

#. ~ Description for {'str': 'foot crank'}
#: data\json\items\vehicle\manual.json
msgid "The pedal and gear assembly from a bicycle."
msgstr "자전거에 쓰이는 페달과 기어."

#: data\json\items\vehicle\mills.json
#: data\json\overmap\overmap_terrain\overmap_terrain.json
#: data\json\vehicleparts\power.json
msgid "wind turbine"
msgid_plural "wind turbines"
msgstr[0] "풍력발전용 터빈"

#. ~ Description for {'str': 'wind turbine'}
#: data\json\items\vehicle\mills.json
msgid ""
"A small turbine that can convert wind into electric power depending on wind "
"speed."
msgstr "풍속에 따라 바람을 전력으로 바꿀 수 있는 소형 터빈입니다."

#: data\json\items\vehicle\mills.json data\json\vehicleparts\power.json
msgid "large wind turbine"
msgid_plural "large wind turbines"
msgstr[0] "대형 풍력 터빈"

#. ~ Description for {'str': 'large wind turbine'}
#: data\json\items\vehicle\mills.json
msgid ""
"A large turbine that can convert wind into electric power depending on wind "
"speed."
msgstr "풍속에 따라 바람을 전력으로 바꿀 수 있는 대형 터빈입니다."

#: data\json\items\vehicle\mills.json data\json\vehicleparts\power.json
msgid "water wheel"
msgid_plural "water wheels"
msgstr[0] "수차"

#. ~ Description for {'str': 'water wheel'}
#: data\json\items\vehicle\mills.json data\json\vehicleparts\power.json
msgid ""
"A water wheel.  Will slowly recharge the vehicle's electrical power when "
"built over shallow moving water."
msgstr "수차입니다. 얕은 흐르는 물 위에 지으면 차량의 전력을 천천히 재충전합니다."

#: data\json\items\vehicle\mills.json data\json\vehicleparts\power.json
msgid "large water wheel"
msgid_plural "large water wheels"
msgstr[0] "대형 수차"

#. ~ Description for {'str': 'large water wheel'}
#: data\json\items\vehicle\mills.json data\json\vehicleparts\power.json
msgid ""
"A large water wheel with wooden supports.  Will recharge the vehicle's "
"electrical power when built over shallow moving water."
msgstr "나무 지지대가 있는 대형 수차입니다. 얕은 흐르는 물 위에 지으면 차량의 전력을 재충전합니다."

#: data\json\items\vehicle\motors.json data\json\vehicleparts\engine.json
msgid "electric motor"
msgid_plural "electric motors"
msgstr[0] "전기모터"

#. ~ Description for {'str': 'electric motor'}
#: data\json\items\vehicle\motors.json
msgid "A powerful electric motor.  Useful for crafting."
msgstr "강력한 전기 모터이다. 제작에 사용된다."

#: data\json\items\vehicle\motors.json data\json\vehicleparts\engine.json
msgid "enhanced electric motor"
msgid_plural "enhanced electric motors"
msgstr[0] "개량형 전기모터"

#. ~ Description for {'str': 'enhanced electric motor'}
#: data\json\items\vehicle\motors.json
msgid ""
"A very powerful and yet lightweight electric motor.  Useful for crafting, "
"and its advanced design means it won't suffer power loss if multiple are "
"installed on a vehicle."
msgstr ""
"매우 강력하면서도 가벼운 전기 모터입니다. 제작에 유용하고, 고급 설계 덕에 여러 개를 차량에 설치해도 출력 손실이 없습니다."

#: data\json\items\vehicle\motors.json data\json\vehicleparts\engine.json
msgid "super electric motor"
msgid_plural "super electric motors"
msgstr[0] "슈퍼 전기 모터"

#. ~ Description for {'str': 'super electric motor'}
#: data\json\items\vehicle\motors.json
msgid ""
"The most powerful electric motor on the market.  Useful for crafting, and "
"its advanced design means it won't suffer power loss if multiple are "
"installed on a vehicle."
msgstr "시판 최강 전기 모터입니다. 제작에 유용하고, 고급 설계 덕에 여러 개를 차량에 설치해도 출력 손실이 없습니다."

#: data\json\items\vehicle\motors.json data\json\vehicleparts\engine.json
msgid "large electric motor"
msgid_plural "large electric motors"
msgstr[0] "대형 전기모터"

#. ~ Description for {'str': 'large electric motor'}
#: data\json\items\vehicle\motors.json
msgid "A large and very powerful electric motor.  Useful for crafting."
msgstr "크고 매우 강력한 전기 모터이다. 제작에 쓰인다."

#: data\json\items\vehicle\motors.json data\json\vehicleparts\engine.json
msgid "small electric motor"
msgid_plural "small electric motors"
msgstr[0] "소형 전기모터"

#. ~ Description for {'str': 'small electric motor'}
#: data\json\items\vehicle\motors.json
msgid "A small electric motor.  Useful for crafting."
msgstr "작은 전기모터이다. 제작에 쓰인다."

#: data\json\items\vehicle\motors.json data\json\vehicleparts\engine.json
msgid "tiny electric motor"
msgid_plural "tiny electric motors"
msgstr[0] "초소형 전기모터"

#. ~ Description for {'str': 'tiny electric motor'}
#: data\json\items\vehicle\motors.json
msgid "A tiny electric motor.  Useful for crafting."
msgstr "아주 작은 전기모터이다. 제작에 쓰인다."

#: data\json\items\vehicle\noise.json data\json\vehicleparts\sound.json
msgid "muffler"
msgid_plural "mufflers"
msgstr[0] "차량용 머플러"

#. ~ Description for {'str': 'muffler'}
#: data\json\items\vehicle\noise.json
msgid ""
"A muffler from a car.  Very unwieldy as a weapon.  Useful in a few crafting "
"recipes."
msgstr "차에서 떼어낸 머플러이다. 무기로서는 쓸모가 없지만 제작에 사용된다."

#: data\json\items\vehicle\noise.json data\json\vehicleparts\sound.json
msgid "back-up beeper"
msgid_plural "back-up beepers"
msgstr[0] "후방감지기"

#. ~ Description for {'str': 'back-up beeper'}
#: data\json\items\vehicle\noise.json
msgid ""
"This is a safety device intended to warn passersby of a vehicle moving in "
"reverse, but the usage of it now seems terribly unwise."
msgstr "후진하는 차량 뒤를 지나가는 행인들에게 경고음을 울리는 안전 장치이다. 하지만 요즘 이걸 쓴다는 건 어리석은 일이다."

#: data\json\items\vehicle\noise.json data\json\vehicleparts\sound.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "stereo system"
msgid_plural "stereo systems"
msgstr[0] "차량용 오디오"

#. ~ Description for {'str': 'stereo system'}
#: data\json\items\vehicle\noise.json
msgid ""
"A stereo system with speakers.  It is capable of being hooked up to a "
"vehicle."
msgstr "스피커가 달린 스테레오 장치. 차량에 연결할 수 있다."

#: data\json\items\vehicle\noise.json
msgid "chime loudspeakers"
msgid_plural "chime loudspeakers"
msgstr[0] "차임 확성기"

#. ~ Description for {'str_sp': 'chime loudspeakers'}
#: data\json\items\vehicle\noise.json
msgid ""
"A stereo system with loudspeakers and a built-in set of simple melodies that"
" it will play.  Commonly used by ice cream trucks to draw the attention of "
"children in the days when children wanted ice cream more than brains."
msgstr ""
"간단한 멜로디를 반복하도록 설정된 확성기가 달린 스테레오 장치. 주로 아이스크림 트럭에서 아이들의 주의를 끌 목적으로 사용되었다. "
"아이들이 뇌보다 아이스크림을 더 좋아하던 시절에 말이지."

#: data\json\items\vehicle\plating.json
msgid "sheet metal"
msgid_plural "sheet metal"
msgstr[0] "금속판"

#. ~ Description for {'str_sp': 'sheet metal'}
#: data\json\items\vehicle\plating.json
msgid "A thin sheet of metal."
msgstr "얇은 금속판."

#: data\json\items\vehicle\plating.json
msgid "wired sheet metal"
msgid_plural "wired sheet metal"
msgstr[0] "조명 달린 금속판"

#. ~ Description for {'str_sp': 'wired sheet metal'}
#: data\json\items\vehicle\plating.json
msgid "Sheet metal that has had light housing wired into it."
msgstr "내부에 조명이 연결된 금속판."

#: data\json\items\vehicle\plating.json
msgid "carbon sheet"
msgid_plural "carbon sheet"
msgstr[0] "탄소 시트"

#. ~ Description for {'str_sp': 'carbon sheet'}
#: data\json\items\vehicle\plating.json
msgid "A thin sheet of carbon fiber."
msgstr "얇은 탄소섬유 시트입니다."

#: data\json\items\vehicle\plating.json
msgid "aluminum sheet"
msgid_plural "aluminum sheets"
msgstr[0] "알루미늄 시트"

#. ~ Description for {'str': 'aluminum sheet'}
#: data\json\items\vehicle\plating.json
msgid ""
"A thin sheet of aluminum, usable for lightweight car body panels or to keep "
"a boat afloat."
msgstr "얇은 알루미늄 시트로, 경량 차체 패널이나 배를 뜨게 하는 데 쓸 수 있습니다."

#: data\json\items\vehicle\plating.json
msgid "wooden armor kit"
msgid_plural "wooden armor kits"
msgstr[0] "차량용 나무장갑"

#. ~ Description for {'str': 'wooden armor kit'}
#: data\json\items\vehicle\plating.json
msgid "A bundle of two by fours prepared to be used as vehicle armor."
msgstr "차량용 장갑으로 사용할 수 있도록 준비한 목재 묶음이다."

#: data\json\items\vehicle\plating.json data\json\vehicleparts\plating.json
msgid "steel plating"
msgid_plural "steel plating"
msgstr[0] "강철판"

#. ~ Description for {'str_sp': 'steel plating'}
#: data\json\items\vehicle\plating.json
msgid "A piece of armor plating made of steel."
msgstr "강철로 만들어진 장갑판."

#: data\json\items\vehicle\plating.json
msgid "carbon plating"
msgid_plural "carbon plating"
msgstr[0] "탄소 장갑판"

#. ~ Description for {'str_sp': 'carbon plating'}
#: data\json\items\vehicle\plating.json
msgid "A piece of armor plating made of carbon fiber."
msgstr "탄소섬유로 만든 장갑판 조각입니다."

#: data\json\items\vehicle\plating.json data\json\vehicleparts\plating.json
msgid "superalloy plating"
msgid_plural "superalloy plating"
msgstr[0] "초합금판"

#. ~ Description for {'str_sp': 'superalloy plating'}
#: data\json\items\vehicle\plating.json
msgid "A piece of armor plating made of sturdy superalloy."
msgstr "단단한 초합금으로 만들어진 장갑판."

#: data\json\items\vehicle\plating.json
msgid "superalloy sheet"
msgid_plural "superalloy sheets"
msgstr[0] "얇은 초합금판"

#. ~ Description for {'str': 'superalloy sheet'}
#: data\json\items\vehicle\plating.json
msgid ""
"A sheet of sturdy superalloy, incredibly hard, yet incredibly malleable."
msgstr "단단한 초합금판. 놀라울 정도로 단단하면서 전성까지 대단하다."

#: data\json\items\vehicle\plating.json data\json\vehicleparts\plating.json
msgid "spiked plating"
msgid_plural "spiked plating"
msgstr[0] "가시 박힌 철판"

#. ~ Description for {'str_sp': 'spiked plating'}
#: data\json\items\vehicle\plating.json
msgid ""
"A piece of armor plating made of steel.  It is covered with menacing spikes."
msgstr "강철로 만든 방어 장갑판이다. 무시무시한 가시로 덮여 있다."

#: data\json\items\vehicle\plating.json data\json\vehicleparts\plating.json
msgid "hard plating"
msgid_plural "hard platings"
msgstr[0] "두꺼운 강철판"

#. ~ Description for {'str': 'hard plating'}
#: data\json\items\vehicle\plating.json
msgid "A piece of very thick armor plating made of steel."
msgstr "강철로 만들어진 아주 두꺼운 장갑판."

#: data\json\items\vehicle\plating.json
msgid "military composite plating"
msgid_plural "military composite platings"
msgstr[0] "군용 복합금속판"

#. ~ Description for {'str': 'military composite plating'}
#: data\json\items\vehicle\plating.json
msgid ""
"A thick sheet of military grade armor, best bullet stopper you can stick on "
"a vehicle."
msgstr "두꺼운 군용 장갑판. 차량에 장착할 수 있는 최고의 방탄 장갑판이다."

#: data\json\items\vehicle\plating.json
msgid "chitin armor kit"
msgid_plural "chitin armor kits"
msgstr[0] "차량용 키틴장갑"

#. ~ Description for {'str': 'chitin armor kit'}
#: data\json\items\vehicle\plating.json
msgid "Light chitin plating made for a vehicle."
msgstr "차량에 장착하도록 만들어진 가벼운 키틴질 장갑판."

#: data\json\items\vehicle\plating.json
msgid "biosilicified chitin armor kit"
msgid_plural "biosilicified chitin armor kits"
msgstr[0] "유기규소 키틴장갑"

#. ~ Description for {'str': 'biosilicified chitin armor kit'}
#: data\json\items\vehicle\plating.json
msgid "Durable silica-coated chitin plating made for a vehicle."
msgstr "차량용으로 제작된 내구성 있는 규소 코팅 키틴 플레이트다."

#: data\json\items\vehicle\plating.json
msgid "bone armor kit"
msgid_plural "bone armor kits"
msgstr[0] "차량용 뼈장갑판"

#. ~ Description for {'str': 'bone armor kit'}
#: data\json\items\vehicle\plating.json
msgid "Bone plating made for a vehicle."
msgstr "차량에 장착하도록 만들어진 뼈 장갑판."

#: data\json\items\vehicle\portal_tap.json
msgid "dimensional portal tap"
msgid_plural "dimensional portal taps"
msgstr[0] "차원 포탈 탭"

#. ~ Description for {'str': 'dimensional portal tap'}
#: data\json\items\vehicle\portal_tap.json
msgid ""
"An advanced interface module designed to siphon power from a linked "
"dimensional portal directly into a vehicle's battery system.  It requires "
"installation into a vehicle and linking to a specific portal before it will "
"function."
msgstr ""
"연결된 차원 포탈에서 차량 배터리 시스템으로 직접 전력을 사이펀하도록 설계된 고급 인터페이스 모듈입니다. 작동하려면 차량에 설치하고 특정"
" 포탈에 연결해야 합니다."

#: data\json\items\vehicle\propellers.json
#: data\json\vehicleparts\propellers.json
msgid "aircraft propeller"
msgid_plural "aircraft propellers"
msgstr[0] "항공기 프로펠러"

#. ~ Description for {'str': 'aircraft propeller'}
#: data\json\items\vehicle\propellers.json
msgid ""
"A steel propeller and spinner from an airplane.  When attached to a vehicle,"
" engine power will provide lift to any installed wings, allowing it to take "
"off."
msgstr "비행기의 강철 프로펠러와 스피너입니다. 차량에 부착하면 엔진 동력이 설치된 날개에 상승력을 제공해 이륙할 수 있습니다."

#: data\json\items\vehicle\propellers.json
#: data\json\vehicleparts\propellers.json
msgid "wooden aircraft propeller"
msgid_plural "wooden aircraft propellers"
msgstr[0] "나무 항공기 프로펠러"

#. ~ Description for {'str': 'wooden aircraft propeller'}
#: data\json\items\vehicle\propellers.json
msgid ""
"A wooden propeller and spinner from an airplane.  When attached to a "
"vehicle, engine power will provide lift to any installed wings, allowing it "
"to take off."
msgstr "비행기의 나무 프로펠러와 스피너입니다. 차량에 부착하면 엔진 동력이 설치된 날개에 상승력을 제공해 이륙할 수 있습니다."

#: data\json\items\vehicle\rams.json data\json\vehicleparts\rams.json
msgid "shredder"
msgid_plural "shredders"
msgstr[0] "분쇄기"

#. ~ Description for {'str': 'shredder'}
#: data\json\items\vehicle\rams.json
msgid ""
"This menacing looking attachment is meant to be powered by a vehicle's "
"engine.  Upon doing so, the circular blades of this device will rotate "
"rapidly; anything in front of it is likely to be ripped to shreds.  It is "
"sturdy enough to withstand multiple impacts, and is designed to detach if it"
" would take a hit that would break it."
msgstr ""
"이 위협적인 외형의 부착물은 차량의 엔진에서 동력을 사용하며, 작동시키면 원형 칼날이 빠르게 회전하며 앞에 있는 것을 찢어 발긴다. 여러"
" 번의 충격을 견딜 수 있을 정도로 견고하며, 파손될 수 있는 충격이 오면 분리되도록 만들어졌다."

#: data\json\items\vehicle\rigs.json
msgid "vehicle crafting rig"
msgid_plural "vehicle crafting rigs"
msgstr[0] "차량 제작 기구"

#: data\json\items\vehicle\rigs.json data\json\vehicleparts\crafting.json
msgid "onboard chemistry lab"
msgid_plural "onboard chemistry labs"
msgstr[0] "차량용 화학 실험대"

#. ~ Description for {'str': 'onboard chemistry lab'}
#: data\json\items\vehicle\rigs.json
msgid ""
"Assembled from a chemistry set attached to a complex wiring harness, it is "
"well suited to most any chemistry project you could imagine.  Unable to "
"utilize standard batteries, it requires an external supply of electricity to"
" operate."
msgstr ""
"복잡한 철사 거치대에 붙어있는 화학 세트로 조립되었고 상상 가능한 대부분의 화학 실험에 적합하다. 일반 배터리를 사용 할 수 없기 때문에"
" 외부 전원 공급이 필요하다."

#: data\json\items\vehicle\rigs.json data\json\vehicleparts\crafting.json
msgid "FOODCO kitchen buddy"
msgid_plural "FOODCO kitchen buddies"
msgstr[0] "FOODCO 주방의 친구"

#. ~ Description for {'str': 'FOODCO kitchen buddy', 'str_pl': 'FOODCO kitchen
#. buddies'}
#: data\json\items\vehicle\rigs.json
msgid ""
"Assembled from a set of instructions you found in an old book of DIY "
"projects, the *FOODCO kitchen buddy* claims to be *the perfect solution to "
"all your home-cooking needs!*.  While it is surprisingly handy for vacuum-"
"sealing as well as dehydrating food, the cheery sales pitch neglected to "
"mention A - how awkward the damn thing is, B - That you still need a normal "
"kitchen and C - how it doesn't take batteries.  You're going to have to weld"
" it to a vehicle, or something else with a supply of electricity, if you "
"want to use it.  In addition to the food preservation features, it also has "
"a food processor, a water-purification system, a drawer for holding extra "
"tools, and for some insane reason, a press and die set for hand-loading "
"ammunition."
msgstr ""
"DIY에 관해 서술된 오래된 책에서 발견한 도구모음인 'FOODCO 주방의 친구'는 '집에서 요리할 때의 완벽한 해결책!'이라고 "
"적혀있다. 놀라울 정도로 간편한 진공 포장기기에 더해 음식 건조기기 같은 쾌활한 판매담은 집어치우고 몇 가지 중요한 점을 언급하자면, A"
" - 그 빌어먹을 것이 얼마나 불편한가. B - 당신은 아직 평범한 주방을 필요로 한다. C - 어째서 이건 배터리를 소모하지 않는가. "
"이 도구모음을 사용하기 위해서는 우선 차량 혹은 전기가 공급되는 장치에 설치할 필요가 있다. 식품 가공도구 이외에도, 정수장치, 별도의 "
"도구를 담아둘 수 있는 수납공간, 그리고 대체 어떤 정신 나간 이유 때문인지는 모르겠지만, 탄약 제작을 위한 탄약 수제작 도구가 포함되어"
" 있다."

#: data\json\items\vehicle\rigs.json
msgid "vehicle forge rig"
msgid_plural "vehicle forge rigs"
msgstr[0] "차량용 단조장치"

#. ~ Description for {'str': 'vehicle forge rig'}
#: data\json\items\vehicle\rigs.json
msgid ""
"A forge rig made to run off a vehicle's storage battery with integrated tool"
" storage for metalworking equipment."
msgstr "차량 축전지를 이용해서 작동하는 단조장치입니다. 내장형 도구모음이 딸려 있으며 금속 가공에 적합합니다."

#: data\json\items\vehicle\rigs.json
msgid "vehicle kiln"
msgid_plural "vehicle kilns"
msgstr[0] "차량 가마"

#. ~ Description for {'str': 'vehicle kiln'}
#: data\json\items\vehicle\rigs.json
msgid "An electric kiln made to run off a vehicle's storage battery."
msgstr "차량의 저장 배터리로 작동하는 전기 가마입니다."

#. ~ Description for {'str': 'RV kitchen unit'}
#: data\json\items\vehicle\rigs.json
msgid ""
"A vehicle mountable electric range and sink unit with integrated tool "
"storage for cooking utensils."
msgstr "차량 장착식 전기레인지와 싱크대 및 조리기구 수납공간 모음이다."

#: data\json\items\vehicle\rigs.json
msgid "vehicle welding rig"
msgid_plural "vehicle welding rigs"
msgstr[0] "차량용 용접장치"

#. ~ Description for {'str': 'vehicle welding rig'}
#: data\json\items\vehicle\rigs.json
msgid ""
"A welding rig made to run off a vehicle's storage battery.  It has a "
"soldering iron attachment for delicate work, and a compartment to store your"
" extra tools in."
msgstr ""
"차량 축전지를 이용해서 작동하는 용접장치. 정밀 작업용으로 쓰이는 납땜용 인두와 그 외에 다른 도구를 수납하기 위한 수납함이 달려있다."

#: data\json\items\vehicle\rigs.json data\json\vehicleparts\crafting.json
msgid "vehicle 3D printer"
msgid_plural "vehicle 3D printers"
msgstr[0] "차량 3D 프린터"

#. ~ Description for {'str': 'vehicle 3D printer'}
#: data\json\items\vehicle\rigs.json
msgid ""
"A 3D printer made to run off a vehicle's storage battery. Although it's not "
"nearly as fancy as the experimental nanofabricators, this civilian-grade 3D "
"printer can produce almost any item out of plastic, polymer, or carbon "
"fiber…  so long as you can program it.  It's also useful for repairing items"
" made out of plastic or carbon fiber."
msgstr ""
"차량 축전지로 작동하도록 만든 3D 프린터입니다. 실험용 나노제작기만큼 화려하진 않지만, 프로그래밍할 수만 있다면 플라스틱, 폴리머, "
"탄소섬유로 거의 모든 아이템을 만들 수 있습니다. 플라스틱이나 탄소섬유 아이템 수리에도 유용합니다."

#: data\json\items\vehicle\rigs.json data\json\vehicleparts\crafting.json
msgid "vehicle advanced 3D printer"
msgid_plural "vehicle advanced 3D printers"
msgstr[0] "차량 고급 3D 프린터"

#. ~ Description for {'str': 'vehicle advanced 3D printer'}
#: data\json\items\vehicle\rigs.json
msgid ""
"An advanced 3D printer made to run off a vehicle's storage battery. Recent "
"advances in 3D printing technology have resulted in the ability to quickly "
"and cheaply 3D print metals and alloys.  Such 3D printers are highly "
"expensive, but sought out by collectors and preppers alike.  In addition to "
"crafting, it can be used to repair polymer and metal items alike, or "
"permeate fabric items with carbon fiber for added protection."
msgstr ""
"차량 축전지로 작동하도록 만든 고급 3D 프린터입니다. 3D 프린팅 기술의 최근 진보로 금속과 합금을 빠르고 싸게 프린트할 수 있게 "
"됐습니다. 매우 비싸지만 수집가와 프레퍼 모두 찾습니다. 제작 외에도 폴리머와 금속 아이템을 수리하거나, 추가 보호를 위해 직물에 "
"탄소섬유를 침투시킬 수 있습니다."

#: data\json\items\vehicle\rotor.json data\json\vehicleparts\rotor.json
msgid "heavy-duty military rotors"
msgid_plural "sets of heavy-duty military rotors"
msgstr[0] "중량 군용 로터 세트"

#. ~ Description for {'str': 'heavy-duty military rotors', 'str_pl': 'sets of
#. heavy-duty military rotors'}
#: data\json\items\vehicle\rotor.json
msgid "A set of four rotor blades from a military attack helicopter."
msgstr "군용 공격 헬리콥터의 로터 날개 4개 세트입니다."

#: data\json\items\vehicle\rotor.json
msgid "small civilian helicopter rotors"
msgid_plural "sets of small civilian helicopter rotors"
msgstr[0] "소형 민간 헬리콥터 로터 세트"

#. ~ Description for {'str': 'small civilian helicopter rotors', 'str_pl':
#. 'sets of small civilian helicopter rotors'}
#: data\json\items\vehicle\rotor.json
msgid "A set of four rotor blades from a civilian light helicopter."
msgstr "민간 경량 헬리콥터의 로터 날개 4개 세트입니다."

#: data\json\items\vehicle\rotor.json
msgid "homebuilt gyrocopter rotors"
msgid_plural "sets of homebuilt gyrocopter rotors"
msgstr[0] "자작 자이로콥터 로터 세트"

#. ~ Description for {'str': 'homebuilt gyrocopter rotors', 'str_pl': 'sets of
#. homebuilt gyrocopter rotors'}
#: data\json\items\vehicle\rotor.json
msgid ""
"A two-bladed wooden rotor and propeller, for lightweight vehicles put "
"together by hobbyists."
msgstr "취미가들이 조립한 경량 차량용, 2날 나무 로터와 프로펠러입니다."

#: data\json\items\vehicle\seating.json data\json\vehicleparts\seats.json
msgid "seat"
msgid_plural "seats"
msgstr[0] "의자"

#. ~ Description for {'str': 'seat'}
#: data\json\items\vehicle\seating.json
msgid "A soft car seat made from synthetic fabric."
msgstr "합성 직물로 만든 부드러운 자동차 좌석입니다."

#: data\json\items\vehicle\seating.json data\json\vehicleparts\seats.json
msgid "leather seat"
msgid_plural "leather seats"
msgstr[0] "가죽 좌석"

#. ~ Description for {'str': 'leather seat'}
#: data\json\items\vehicle\seating.json
msgid "A soft car seat covered with leather."
msgstr "가죽으로 된 부드러운 차량용 의자입니다."

#: data\json\items\vehicle\seating.json data\json\vehicleparts\seats.json
msgid "saddle"
msgid_plural "saddles"
msgstr[0] "안장"

#. ~ Description for {'str': 'saddle'}
#: data\json\items\vehicle\seating.json
msgid "A leather-covered seat designed to be straddled."
msgstr "걸터앉을 수 있게 만들어진 가죽 덮인 안장이다."

#: data\json\items\vehicle\solar.json data\json\vehicleparts\power.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "solar panel"
msgid_plural "solar panels"
msgstr[0] "태양 전지판"

#. ~ Description for {'str': 'solar panel'}
#. ~ Description for {'str': 'foldable solar panel'}
#: data\json\items\vehicle\solar.json
msgid ""
"Electronic device that can convert solar radiation into electric power.  "
"Useful for a vehicle."
msgstr "태양 복사를 전기로 바꿔주는 전기 장치이다. 차량에 쓰인다."

#: data\json\items\vehicle\solar.json data\json\vehicleparts\power.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "reinforced solar panel"
msgid_plural "reinforced solar panels"
msgstr[0] "강화형 태양 전지판"

#. ~ Description for {'str': 'reinforced solar panel'}
#: data\json\items\vehicle\solar.json
msgid ""
"A solar panel that has been covered with a pane of reinforced glass to "
"protect the delicate solar cells from zombies or errant baseballs.  The "
"glass causes this panel to produce slightly less power than a normal panel."
"  Useful for a vehicle."
msgstr ""
"깨지기 쉬운 태양전지를 잘못 날아온 야구공이나 좀비로부터 보호하기 위해 강화유리로 덮은 태양전지판이다. 강화유리로 인해 전력 생산량이 "
"보통의 태양전지판보다 약간 낮다. 차량에 쓸 만하다."

#: data\json\items\vehicle\solar.json data\json\vehicleparts\power.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "upgraded solar panel"
msgid_plural "upgraded solar panels"
msgstr[0] "개량형 태양 전지판"

#. ~ Description for {'str': 'upgraded solar panel'}
#: data\json\items\vehicle\solar.json
msgid ""
"Electronic device that can convert solar radiation into electric power.  "
"This panel has been upgraded to convert more sunlight into power.  Useful "
"for a vehicle."
msgstr "태양 복사를 전기로 바꿔주는 전기 장치이다. 업그레이드되어서 더 많은 태양광을 에너지로 바꿀 수 있다. 차량에 쓰인다."

#: data\json\items\vehicle\solar.json data\json\vehicleparts\power.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "upgraded reinforced solar panel"
msgid_plural "upgraded reinforced solar panels"
msgstr[0] "개량강화형 태양 전지판"

#. ~ Description for {'str': 'upgraded reinforced solar panel'}
#: data\json\items\vehicle\solar.json
msgid ""
"An upgraded solar panel that has been covered with a pane of reinforced "
"glass to protect the delicate solar cells from zombies or errant baseballs."
"  The glass causes this panel to produce slightly less power than a normal "
"upgraded panel.  Useful for a vehicle."
msgstr ""
"깨지기 쉬운 태양전지를 잘못 날아온 야구공이나 좀비로부터 보호하기 위해 강화유리로 덮은 개선된 태양전지판이다. 강화유리로 인해 전력 "
"생산량이 보통의 태양전지판보다 약간 낮다. 차량에 쓸 만하다."

#: data\json\items\vehicle\solar.json data\json\vehicleparts\power.json
#: data\mods\Aftershock\vehicles\part_items.json
#: data\mods\Aftershock\vehicles\vehicle_parts.json
#: data\mods\DeoxyMod\Deoxy_vehicle_parts.json
msgid "quantum solar panel"
msgid_plural "quantum solar panels"
msgstr[0] "양자 태양 전지판"

#. ~ Description for {'str': 'quantum solar panel'}
#. ~ Description for quantum solar panel
#: data\json\items\vehicle\solar.json
#: data\mods\Aftershock\vehicles\part_items.json
msgid ""
"This solar panel is obviously cutting-edge technology and given where you "
"found it, should probably provide a LOT of power.  It's covered in strange-"
"looking material, but the covering looks rather fragile; it doesn't look "
"like it could support a reinforcing sheet, either."
msgstr ""
"이 태양 전지판은 거의 확실하게 최첨단 기술이 적용된 것으로 보이며 당신이 이것을 어디서 찾았는가를 생각해볼 때, 아마도 전력을 아주 "
"많이 제공할 것입니다. 이것은 이상해보이는 물질로 덮여있지만, 오히려 쉽게 부숴질 것 같은 모습입니다. 또한 이것은 보강할 재료도 "
"마땅찮은 것 같습니다."

#: data\json\items\vehicle\solar.json data\json\vehicleparts\power.json
msgid "foldable solar panel"
msgid_plural "foldable solar panels"
msgstr[0] "접이식 태양광 패널"

#: data\json\items\vehicle\solar.json
msgid "solar cell"
msgid_plural "solar cells"
msgstr[0] "태양 전지"

#. ~ Description for {'str': 'solar cell'}
#: data\json\items\vehicle\solar.json
msgid ""
"A small electronic device that can convert solar radiation into electric "
"power.  Useful for crafting."
msgstr "태양 복사를 전기로 바꿔주는 작은 전기 장치이다. 제작에 사용된다."

#: data\json\items\vehicle\tables.json
msgid "fancy table"
msgid_plural "fancy tables"
msgstr[0] "화려한 탁자"

#. ~ Description for {'str': 'fancy table'}
#: data\json\items\vehicle\tables.json
msgid ""
"A very fancy table from a very fancy RV.  If times were better it might be "
"useful for something more than firewood."
msgstr "멋진 RV 차량에 쓰이는 화려한 탁자. 이런 시기가 아니었다면 장작보다 더 가치있게 쓰였을 것이다."

#: data\json\items\vehicle\tables.json
msgid "wooden table"
msgid_plural "wooden tables"
msgstr[0] "나무 탁자"

#. ~ Description for {'str': 'wooden table'}
#: data\json\items\vehicle\tables.json
msgid "A crude wooden table."
msgstr "투박한 나무 탁자."

#: data\json\items\vehicle\tables.json data\json\vehicleparts\crafting.json
msgid "survivors workbench"
msgid_plural "survivors workbenches"
msgstr[0] "생존자 작업대"

#: data\json\items\vehicle\tables.json data\json\vehicleparts\crafting.json
msgid "robobench"
msgid_plural "robobenches"
msgstr[0] "로보벤치"

#. ~ Description for {'str': 'advanced butchering station'}
#: data\json\items\vehicle\tables.json data\json\vehicleparts\crafting.json
msgid ""
"Combining a fixed-up dissector, workbench and advanced electronics, this is "
"a marvel capable of butchering, dissecting and cutting like nothing else!"
msgstr "수리된 해부기, 작업대, 고급 전자기기를 결합한, 그 무엇과도 비교할 수 없는 도축·해부·절단이 가능한 경이입니다!"

#: data\json\items\vehicle\turrets.json data\json\vehicleparts\turret.json
msgid "turret mount"
msgid_plural "turret mounts"
msgstr[0] "터렛 장착대"

#. ~ Description for {'str': 'turret mount'}
#: data\json\items\vehicle\turrets.json
msgid "A universal mount for weapons intended to be installed as turrets."
msgstr "터렛으로 설치할 무기를 올려놓는데 쓰이는 범용 받침대."

#: data\json\items\vehicle\turrets.json data\json\vehicleparts\turret.json
msgid "turret autoloader"
msgid_plural "turret autoloaders"
msgstr[0] "터렛 자동장전기"

#. ~ Description for {'str': 'turret autoloader'}
#: data\json\items\vehicle\turrets.json
msgid ""
"An automated ammunition feeding system designed for vehicle-mounted turrets."
" Requires electric power to operate."
msgstr "차량 장착 터렛용으로 설계된 자동 탄약 공급 시스템입니다. 작동에 전력이 필요합니다."

#: data\json\items\vehicle\utilities.json data\json\vehicleparts\misc.json
msgid "military black box"
msgid_plural "military black boxes"
msgstr[0] "군용 블랙박스"

#. ~ Description for {'str': 'military black box', 'str_pl': 'military black
#. boxes'}
#: data\json\items\vehicle\utilities.json
msgid ""
"This is a black box, seemingly pulled from some sort of military vehicle "
"wreckage.  If you can find a system to analyze this, you may find something "
"of interest."
msgstr "어떤 군용 차량 잔해에서 뜯어낸 듯한 블랙박스입니다. 분석할 시스템을 찾으면 흥미로운 걸 발견할 수 있을 겁니다."

#: data\json\items\vehicle\utilities.json data\json\vehicleparts\power.json
msgid "minireactor"
msgid_plural "minireactors"
msgstr[0] "소형 반응로"

#. ~ Description for {'str': 'minireactor'}
#: data\json\items\vehicle\utilities.json
msgid "A small portable plutonium reactor.  Handle with great care!"
msgstr "이동 가능한 작은 플루토늄 반응기. 매우 조심해서 다뤄야 한다!"

#: data\json\items\vehicle\utilities.json
msgid "compact reactor assembly"
msgid_plural "compact reactor assemblys"
msgstr[0] "소형 원자로 조립체"

#. ~ Description for {'str': 'compact reactor assembly'}
#: data\json\items\vehicle\utilities.json
msgid ""
"A heavily shielded, vehicle-sized reactor package salvaged from a much "
"larger nuclear core.  With enough supporting electronics and fuel, it could "
"become the heart of a minireactor or plutonium generator."
msgstr ""
"훨씬 큰 핵심에서 회수된, 중차폐 차량 크기 원자로 패키지입니다. 충분한 지지 전자기기와 연료가 있으면 미니원자로나 플루토늄 발전기의 "
"심장이 될 수 있습니다."

#: data\json\items\vehicle\utilities.json
msgid "vehicle cooler"
msgid_plural "vehicle coolers"
msgstr[0] "차량 냉각기"

#. ~ Description for {'str': 'vehicle cooler'}
#: data\json\items\vehicle\utilities.json
msgid "A vehicle-mounted area cooler."
msgstr "차량 장착 구역 냉각기입니다."

#: data\json\items\vehicle\utilities.json
msgid "vehicle heater"
msgid_plural "vehicle heaters"
msgstr[0] "차량 히터"

#. ~ Description for {'str': 'vehicle heater'}
#: data\json\items\vehicle\utilities.json
msgid "A vehicle-mounted area heater."
msgstr "차량 장착 구역 히터입니다."

#: data\json\items\vehicle\utilities.json
#: data\json\vehicleparts\furniture.json
msgid "towel hanger"
msgid_plural "towel hangers"
msgstr[0] "수건걸이"

#. ~ Description for {'str': 'towel hanger'}
#: data\json\items\vehicle\utilities.json
#: data\json\vehicleparts\furniture.json
msgid "A towel hanger with towels."
msgstr "수건이 걸린 수건걸이입니다."

#: data\json\items\vehicle\utilities.json data\json\vehicleparts\battery.json
msgid "recharging station"
msgid_plural "recharging stations"
msgstr[0] "충전 스테이션"

#. ~ Description for {'str': 'recharging station'}
#: data\json\items\vehicle\utilities.json
msgid ""
"A universal recharging station designed to operate on vehicle power.  While "
"on it will steadily charge all rechargeable batteries (battery cells, lead-"
"acid batteries, etc) placed directly within its storage space, at a greater "
"rate than most consumer chargers.  The system can only be installed onto "
"existing storage compartments, and is controlled from a dashboard or "
"electronics control unit."
msgstr ""
"차량 전력으로 작동하도록 설계된 범용 충전 스테이션입니다. 켜지면 저장 공간에 직접 놓인 모든 재충전 배터리(배터리 셀, 납축전지 등)를"
" 대부분의 소비자용 충전기보다 빠른 속도로 지속 충전합니다. 기존 저장 공간에만 설치할 수 있고, 대시보드나 전자 제어 장치에서 "
"제어합니다."

#. ~ Description for {'str': 'battery charger'}
#: data\json\items\vehicle\utilities.json
msgid ""
"A small device for recharging batteries, given a source of electricty.  It "
"could easily be wired into a vehicle with power.  It will slowly charge all "
"rechargeable batteries (battery cells, lead-acid batteries, etc) placed "
"directly within its storage space.  It can only be installed onto existing "
"storage compartments."
msgstr ""
"전기 원천이 있으면 배터리를 재충전하는 소형 장치입니다. 전력 있는 차량에 쉽게 배선할 수 있습니다. 저장 공간에 직접 놓인 모든 재충전"
" 배터리(배터리 셀, 납축전지 등)를 천천히 충전합니다. 기존 저장 공간에만 설치할 수 있습니다."

#: data\json\items\vehicle\utilities.json data\json\vehicleparts\controls.json
msgid "programmable autopilot"
msgid_plural "programmable autopilots"
msgstr[0] "프로그래머블 자동조종장치"

#. ~ Description for {'str': 'programmable autopilot'}
#: data\json\items\vehicle\utilities.json
msgid ""
"A computer system hooked up to the steering and engine of a vehicle to allow"
" it to follow simple paths."
msgstr "차량의 조향과 엔진에 연결돼 단순 경로를 따라가게 하는 컴퓨터 시스템입니다."

#: data\json\items\vehicle\utilities.json data\json\vehicleparts\cargo.json
msgid "minifridge"
msgid_plural "minifridges"
msgstr[0] "소형 냉장고"

#. ~ Description for {'str': 'minifridge'}
#: data\json\items\vehicle\utilities.json
msgid ""
"A very small fridge for keeping food cool.  Provides some insulation from "
"outside weather."
msgstr "음식을 냉장시키는데 쓰이는 아주 작은 냉장고. 약간의 단열 효과가 있다."

#. ~ Description for {'str': 'minifreezer'}
#: data\json\items\vehicle\utilities.json
msgid ""
"Compact version of a chest freezer, designed as a mobile solution for "
"freezing food.  Provides insulation from the elements."
msgstr "식품 냉동을 위한 이동식 솔루션으로 설계된 소형 냉동고다. 외부 환경으로부터 단열을 제공한다."

#. ~ Description for {'str': 'cloning vat'}
#: data\json\items\vehicle\utilities.json
msgid ""
"A vessel designed to grow and sustain living beings.  If constructed and "
"provided with sufficient power, it can take a sterile artificial womb and a "
"DNA sample and create a viable clone."
msgstr ""
"살아있는 존재를 키우고 유지하도록 설계된 용기입니다. 건설하고 충분한 전력을 공급하면, 멸균 인공 자궁과 DNA 샘플로 실행 가능한 "
"클론을 만들 수 있습니다."

#: data\json\items\vehicle\utilities.json
msgid "mountable autoclave"
msgid_plural "mountable autoclaves"
msgstr[0] "거치형 오토클레이브"

#. ~ Description for {'str': 'mountable autoclave'}
#: data\json\items\vehicle\utilities.json
msgid "This autoclave has been rigged to run off a vehicle power grid."
msgstr "차량 전력망으로 작동하도록 개조된 오토클레이브입니다."

#: data\json\items\vehicle\utilities.json
msgid "mountable autodoc"
msgid_plural "mountable autodocs"
msgstr[0] "거치형 오토독"

#. ~ Description for {'str': 'mountable autodoc'}
#: data\json\items\vehicle\utilities.json
msgid "This autodoc has been rigged to run off a vehicle power grid."
msgstr "차량 전력망으로 작동하도록 개조된 오토독입니다."

#: data\json\items\vehicle\utilities.json
msgid "mountable autodoc couch"
msgid_plural "mountable autodoc couchs"
msgstr[0] "거치형 오토독 침상"

#. ~ Description for {'str': 'mountable autodoc couch'}
#: data\json\items\vehicle\utilities.json
msgid "This autodoc couch has been rigged to run off a vehicle power grid."
msgstr "차량 전력망으로 작동하도록 개조된 오토독 침상입니다."

#: data\json\items\vehicle\utilities.json
msgid "refrigerated tank"
msgid_plural "refrigerated tanks"
msgstr[0] "냉장 탱크"

#. ~ Description for {'str': 'refrigerated tank'}
#: data\json\items\vehicle\utilities.json
msgid ""
"A 60L refrigerated tank for keeping liquids cool.  Provides some insulation "
"from outside weather."
msgstr "액체를 차갑게 유지하는 60리터 냉장 탱크입니다. 외부 날씨로부터 어느 정도 단열합니다."

#: data\json\items\vehicle\utilities.json data\json\vehicleparts\crafting.json
msgid "water faucet"
msgid_plural "water faucets"
msgstr[0] "수도꼭지"

#. ~ Description for {'str': 'water faucet'}
#: data\json\items\vehicle\utilities.json
msgid "A metal faucet that can be attached to a water tank for easy access."
msgstr "쉽게 물탱크에서 물을 빼낼 수 있도록 부착하는 금속 수도꼭지."

#: data\json\items\vehicle\utilities.json data\json\vehicleparts\crafting.json
msgid "vehicle shower"
msgid_plural "vehicle showers"
msgstr[0] "차량 샤워기"

#. ~ Description for {'str': 'vehicle shower'}
#: data\json\items\vehicle\utilities.json
msgid "A compact shower head and drain that can be attached to a water tank."
msgstr "물탱크에 부착할 수 있는 소형 샤워 헤드와 배수구입니다."

#: data\json\items\vehicle\wheel.json data\json\vehicleparts\wheel.json
msgid "light wheel mount"
msgid_plural "light wheel mounts"
msgstr[0] "경량 바퀴 마운트"

#. ~ Description for {'str': 'light wheel mount'}
#: data\json\items\vehicle\wheel.json data\json\vehicleparts\wheel.json
msgid "A piece of metal with holes suitable for a bike or motorbike wheel."
msgstr "자전거나 오토바이 바퀴에 맞는 구멍이 있는 금속 조각입니다."

#: data\json\items\vehicle\wheel.json
msgid "medium wheel hub assembly"
msgid_plural "medium wheel hub assemblies"
msgstr[0] "중형 바퀴 허브 어셈블리"

#. ~ Description for {'str': 'medium wheel hub assembly', 'str_pl': 'medium
#. wheel hub assemblies'}
#: data\json\items\vehicle\wheel.json
msgid ""
"A metal assembly that allows bolting a wheel on a car.  Fit for a car wheel."
msgstr "차에 바퀴를 볼트로 고정할 수 있는 금속 어셈블리입니다. 승용차 바퀴에 맞습니다."

#: data\json\items\vehicle\wheel.json data\json\vehicleparts\wheel.json
msgid "heavy wheel hub assembly"
msgid_plural "heavy wheel hub assemblies"
msgstr[0] "중량 바퀴 허브 어셈블리"

#. ~ Description for {'str': 'heavy wheel hub assembly', 'str_pl': 'heavy
#. wheel hub assemblies'}
#: data\json\items\vehicle\wheel.json
msgid ""
"A heavy metal assembly that allows bolting a wheel on a car.  Fit for a "
"large car wheel."
msgstr "차에 바퀴를 볼트로 고정할 수 있는 중금속 어셈블리입니다. 대형 차 바퀴에 맞습니다."

#: data\json\items\vehicle\wheel.json data\json\vehicleparts\wheel.json
msgid "wheel"
msgid_plural "wheels"
msgstr[0] "바퀴"

#. ~ Description for {'str': 'wheel'}
#: data\json\items\vehicle\wheel.json
msgid "A car wheel."
msgstr "자동차 바퀴."

#: data\json\items\vehicle\wheel.json
msgid "racing wheel"
msgid_plural "racing wheels"
msgstr[0] "레이싱 바퀴"

#. ~ Description for {'str': 'racing wheel'}
#: data\json\items\vehicle\wheel.json
msgid ""
"A wide, smooth wheel intended for racing.  The slick surface provides better"
" speed on pavement but penalizes off-road speed."
msgstr "레이싱용으로 설계된 넓고 매끈한 바퀴. 포장 도로에서 더 빠른 속도를 제공합니다."

#: data\json\items\vehicle\wheel.json data\json\vehicleparts\wheel.json
msgid "armored wheel"
msgid_plural "armored wheels"
msgstr[0] "장갑차 바퀴"

#. ~ Description for {'str': 'armored wheel'}
#: data\json\items\vehicle\wheel.json
msgid "A wide military grade wheel.  Performs well off-road."
msgstr "넓은 군용 등급 바퀴입니다. 오프로드에서 성능이 좋습니다."

#: data\json\items\vehicle\wheel.json data\json\vehicleparts\wheel.json
msgid "wheelbarrow wheel"
msgid_plural "wheelbarrow wheels"
msgstr[0] "외바퀴 손수레 바퀴"

#. ~ Description for {'str': 'wheelbarrow wheel'}
#: data\json\items\vehicle\wheel.json
msgid "A small wheel from a common garden wheelbarrow."
msgstr "정원에서 흔히 쓰이는 외바퀴 손수레의 작은 바퀴."

