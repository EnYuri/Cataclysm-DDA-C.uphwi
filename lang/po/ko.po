msgstr "\"긴장한 게 귀엽네♡\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"야노 취향이 없다니 실망이야\""
msgstr "\"야노 취향이 없다니 실망이야\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"야외 노출이 얼마나 멋진 지 알겠어?\""
msgstr "\"야외 노출이 얼마나 멋진 지 알겠어?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"바람이 몸을 스칠 때의 해방감... 대단해!\""
msgstr "\"바람이 몸을 스칠 때의 해방감... 대단해!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 몸 쯤 되면, 이렇게 드러낼만한 자격이 있지?\""
msgstr "\"내 몸쯤 되면, 이렇게 드러낼 만한 자격이 있지?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"출렁이는 가슴은 좋아해?\""
msgstr "\"출렁이는 가슴은 좋아해?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"혹시 빈유파니?\""
msgstr "\"혹시 빈유파니?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가슴이 여러 개 달린 사람들은 좀 징그럽단 소리를 들어\""
msgstr "\"가슴이 여러 개 달린 사람들은 좀 징그럽단 소리를 들어\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"동물이 되면 발정기까지 온단 거 알아? 나는 나체의 짐승... 언제나 발정기야!\""
msgstr "\"동물이 되면 발정기까지 온단 거 알아? 나는 나체의 짐승... 언제나 발정기야!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아이를 낳아도~ 금방 금방~ 자라네~\""
msgstr "\"아이를 낳아도~ 금방 금방~ 자라네~\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"문명 재건... 순식간에 할 수 있을 걸?\""
msgstr "\"문명 재건... 순식간에 할 수 있을 걸?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid ""
"\"소형 선풍기를 해체하면 나오는 마이크로 모터는 따로 잘 간수하는 게 좋아. 필요할 때 없으면 오피스로 가면 널려있으니까 그 쪽으로 "
"가봐\""
msgstr ""
"\"소형 선풍기를 해체하면 나오는 마이크로 모터는 따로 잘 간수하는 게 좋아. 필요할 때 없으면 오피스로 가면 널려있으니까 그쪽으로 "
"가봐\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내가 얼마나 젖었는 지 보여?\""
msgstr "\"내가 얼마나 젖었는지 보여?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"땀에 젖은 것 뿐만이 아니야...♥\""
msgstr "\"땀에 젖은 것뿐만이 아니야...♥\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"여자도 남자처럼 대하면 남자가 되는 법이야\""
msgstr "\"여자도 남자처럼 대하면 남자가 되는 법이야\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"핥아줄래?\""
msgstr "\"핥아줄래?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"더 즐기게 해줄래?\""
msgstr "\"더 즐기게 해줄래?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"돌림빵도 OK야.\""
msgstr "\"돌림빵도 OK야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"제모도 완벽하고, 다른 준비도 완벽해☆\""
msgstr "\"제모도 완벽하고, 다른 준비도 완벽해☆\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"예아~ 연중무휴 언제나 누디스트 타임~~!!\""
msgstr "\"예아~ 연중무휴 언제나 누디스트 타임~~!!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 색... 선명한 분홍색이지?\""
msgstr "\"내 색... 선명한 분홍색이지?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"살아 있는 사람은 어디에 있을까요?\""
msgstr "\"살아 있는 사람은 어디에 있을까요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"따스한 품이 그리운가요?\""
msgstr "\"따스한 품이 그리운가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"피곤하면 언제든지 나한테 와도 돼요\""
msgstr "\"피곤하면 언제든지 나한테 와도 돼요\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"젖이... 흘러넘치고 있는데 좀 빼줄래요?\""
msgstr "\"젖이... 흘러넘치고 있는데 좀 빼줄래요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"앗... 너무 세게 빨면 아파요.\""
msgstr "\"앗... 너무 세게 빨면 아파요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가슴에 절로 눈이 가고 있네요. 그렇게 가슴이 좋아요?\""
msgstr "\"가슴에 절로 눈이 가고 있네요. 그렇게 가슴이 좋아요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀여운 인간이네요\""
msgstr "\"귀여운 인간이네요\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"여기 오세요. 안아드릴게요.\""
msgstr "\"여기 오세요. 안아드릴게요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아앗.. 그렇게 나오며언...\""
msgstr "\"아앗.. 그렇게 나오며언...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"여자는 언제나 젖어있지만... 저는 끝 부분이 젖어있답니다.\""
msgstr "\"여자는 언제나 젖어있지만... 저는 끝 부분이 젖어있답니다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"다른 몽마들이 절 보는 눈빛이 왜인지 부담스러운데... 혹시 알고 계신가요?\""
msgstr "\"다른 몽마들이 절 보는 눈빛이 왜인지 부담스러운데... 혹시 알고 계신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"서로 즐겨볼까요?\""
msgstr "\"서로 즐겨볼까요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"오랜 시간 동안 굶주렸어요.\""
msgstr "\"오랜 시간 동안 굶주렸어요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후, 서로 쥐어짜주는 건 어떤가요?\""
msgstr "\"후후, 서로 쥐어짜주는 건 어떤가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"단 한 방울도 나오지 않을 때까지... 제 가슴을 짜주실 수 있나요?\""
msgstr "\"단 한 방울도 나오지 않을 때까지... 제 가슴을 짜주실 수 있나요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"제 품 안에서... 슬픈 일, 힘든 일 다 잊도록 하세요.\""
msgstr "\"제 품 안에서... 슬픈 일, 힘든 일 다 잊도록 하세요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아이 때의 행복을 떠올리게 해드릴게요.\""
msgstr "\"아이 때의 행복을 떠올리게 해드릴게요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아기처럼 껴안아 드릴게요.\""
msgstr "\"아기처럼 껴안아 드릴게요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"제 냄새가 포근해서 좋으시다고요? 후후... 어리광쟁이네요.\""
msgstr "\"제 냄새가 포근해서 좋으시다고요? 후후... 어리광쟁이네요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가슴 사이에 끼우는 건 좋아하시나요?\""
msgstr "\"가슴 사이에 끼우는 건 좋아하시나요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"더 질척하게... 가슴을 짜주실래요?\""
msgstr "\"더 질척하게... 가슴을 짜주실래요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아앗... 가슴에 응어리가 질 것 같아요오..\""
msgstr "\"아앗... 가슴에 응어리가 질 것 같아요오..\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"질펀하게 즐기는 걸 좋아해요.\""
msgstr "\"질펀하게 즐기는 걸 좋아해요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"캠비온들이 실례를 저질렀나요? 제 몸으로라도 괜찮으시다면... 사죄의 의미로 한 번 어때요?\""
msgstr "\"캠비온들이 실례를 저질렀나요? 제 몸으로라도 괜찮으시다면... 사죄의 의미로 한 번 어때요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어떻게든 강압적으로 구려는 그 아이는... 가까이 가면 확 약해진답니다.\""
msgstr "\"어떻게든 강압적으로 구려는 그 아이는... 가까이 가면 확 약해진답니다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"채찍을 든 그 아이는 순수한 싸움 실력으로 승부를 한답니다.\""
msgstr "\"채찍을 든 그 아이는 순수한 싸움 실력으로 승부를 한답니다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저리 가도록 하세요. 좀비들.\""
msgstr "\"저리 가도록 하세요. 좀비들.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하아앙... 거기 좋아요옷...♡\""
msgstr "\"하아앙... 거기 좋아요옷...♡\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"같이 뒹굴어볼까요?\""
msgstr "\"같이 뒹굴어볼까요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"갑자기 아이가 큰다고 해서 내치지 마세요. 그 아이들은 모두 당신의 소중한 아이일테니까요.\""
msgstr "\"갑자기 아이가 큰다고 해서 내치지 마세요. 그 아이들은 모두 당신의 소중한 아이일 테니까요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"인간이 아니게 되면... 알을 대신 낳을지도 모르겠네요?\""
msgstr "\"인간이 아니게 되면... 알을 대신 낳을 지도 모르겠네요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"우리 몽마는 서큐버스만이 있는 것이 아니랍니다. 남성체인 인큐버스 또한 있어요.\""
msgstr "\"우리 몽마는 서큐버스만이 있는 것이 아니랍니다. 남성체인 인큐버스 또한 있어요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가끔씩, 저 하늘에서 따가운 비가 내린다는 걸 알고 계신가요?\""
msgstr "\"가끔씩, 저 하늘에서 따가운 비가 내린다는 걸 알고 계신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하트 모양의 불길은... 그 분이 주변에 계신다는 뜻이랍니다.\""
msgstr "\"하트 모양의 불길은... 그 분이 주변에 계신다는 뜻이랍니다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"포근한 꿈을 꾸게 해드릴게요.\""
msgstr "\"포근한 꿈을 꾸게 해드릴게요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저도 손가락으로 쑤셔드리는 건 좋아해요. 여자랑 할 때도 말예요. 우훗..♡\""
msgstr "\"저도 손가락으로 쑤셔드리는 건 좋아해요. 여자랑 할 때도 말예요. 우훗..♡\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가슴이 너무 커서... 불편하네요.\""
msgstr "\"가슴이 너무 커서... 불편하네요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"캠비온... 후후. 저도 그 아이들을 낳아본 적이 있어요. 우리를 위한 소중한 일꾼들이랍니다.\""
msgstr "\"캠비온... 후후. 저도 그 아이들을 낳아본 적이 있어요. 우리를 위한 소중한 일꾼들이랍니다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"초커? 그걸 좋아하는 서큐버스는 없을 거에요. 우리는 지배하는 쪽이지. 당하는 쪽이 아니니까요.\""
msgstr "\"초커? 그걸 좋아하는 서큐버스는 없을 거에요. 우리는 지배하는 쪽이지. 당하는 쪽이 아니니까요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀비가 된 인간들을 보면 참 가엽답니다... 그 불쾌한 것이 체내에 들어가서 사람을 꼭두각시처럼 조종하다니...\""
msgstr "\"좀비가 된 인간들을 보면 참 가엽답니다... 그 불쾌한 것이 체내에 들어가서 사람을 꼭두각시처럼 조종하다니...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"혀로... 끝 부분을... 아앗...\""
msgstr "\"혀로... 끝 부분을... 아앗...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"꽉 껴안아드릴게요.\""
msgstr "\"꽉 껴안아드릴게요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀엽게 울어주세요\""
msgstr "\"귀엽게 울어주세요\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 가슴에 눈길을 주시면... 저라도 부담되네요♪\""
msgstr "\"그렇게 가슴에 눈길을 주시면... 저라도 부담되네요♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이렇게 큰 가슴이 좋으신가요?\""
msgstr "\"이렇게 큰 가슴이 좋으신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가슴이 너무 커서... 어깨가 걸리는데.. 좀 주물러 주시지 않을래요?\""
msgstr "\"가슴이 너무 커서... 어깨가 걸리는데.. 좀 주물러 주시지 않을래요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아하핫♡ 꼭 아기같네요.\""
msgstr "\"아하핫♡ 꼭 아기 같네요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"차가운 연구소에 갈 때는 모피로 된 옷을 챙기시는 게 좋아요. 부드러운 털 가죽 속에 싸이면 기분 좋지 않나요?\""
msgstr "\"차가운 연구소에 갈 때는 모피로 된 옷을 챙기시는 게 좋아요. 부드러운 털 가죽 속에 싸이면 기분 좋지 않나요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"추운 입을 가릴 때는 그냥 스카프 말고 양모 스카프를 착용하세요... 제 이 옷도 양털로 짠거랍니다. 젖소 같은데 의외죠?\""
msgstr "\"추운 입을 가릴 때는 그냥 스카프 말고 양모 스카프를 착용하세요... 제 이 옷도 양털로 짠거랍니다. 젖소 같은데 의외죠?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"변태여도 괜찮아요. 성욕이 활발하다는 거니까. 서큐버스한텐 인기가 많을거에요!\""
msgstr "\"변태여도 괜찮아요. 성욕이 활발하다는 거니까. 서큐버스한텐 인기가 많을 거에요!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"몇 번이 한계신가요?\""
msgstr "\"몇 번이 한계신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저하고... 즐겨보지 않을래요?\""
msgstr "\"저하고... 즐겨보지 않을래요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이런 세계에서 얼마나 살아남을 수 있을 지 불안하지 않으신가요?\""
msgstr "\"이런 세계에서 얼마나 살아남을 수 있을지 불안하지 않으신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"힘든 일을 전부 잊게 해드릴게요.\""
msgstr "\"힘든 일을 전부 잊게 해드릴게요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후훗. 제 젖이 그렇게 충격적인가요?\""
msgstr "\"후훗. 제 젖이 그렇게 충격적인가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하핫! 흠뻑 젖었네요!\""
msgstr "\"하핫! 흠뻑 젖었네요!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"젖을 쏠테니... 입으로 받아마셔 주세요♪\""
msgstr "\"젖을 쏠 테니... 입으로 받아마셔 주세요♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"한 번 더 쏴드릴게요\""
msgstr "\"한 번 더 쏴드릴게요\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"에잇~!!\""
msgstr "\"에잇~!!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"지쳤을 땐... 뒷구멍 안 쪽을 누르면 절로 기운을 찾으시더라고요♪\""
msgstr "\"지쳤을 땐... 뒷구멍 안쪽을 누르면 절로 기운을 찾으시더라고요♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어리석은 인간들...\""
msgstr "\"어리석은 인간들...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"멍청한 과학자들 덕분에 우리가 이 우주에 올 수 있게 되었다.\""
msgstr "\"멍청한 과학자들 덕분에 우리가 이 우주에 올 수 있게 되었다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"여보거라, 거기 인간은 게 아무도 없느냐\""
msgstr "\"여보거라, 거기 인간은 게 아무도 없느냐\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저주받을 덩어리 괴물까지 불러오다니...\""
msgstr "\"저주받을 덩어리 괴물까지 불러오다니...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하하, 두렵느냐?\""
msgstr "\"하하, 두렵느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"마침 굶주려 있었던 참이니 바짝 마를 때까지 쥐어짜주마\""
msgstr "\"마침 굶주려 있었던 참이니 바짝 마를 때까지 쥐어짜주마\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하하하하하!!!\""
msgstr "\"하하하하하!!!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"형편 없구나\""
msgstr "\"형편 없구나\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀여운 얼굴이구나. 더 가까이 보이거라\""
msgstr "\"귀여운 얼굴이구나. 더 가까이 보이거라\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저것들이 아직도 인간으로 보이더냐? 좀비? ...저건 꼭두각시 인형이나 진배없거늘\""
msgstr "\"저것들이 아직도 인간으로 보이더냐? 좀비? ...저건 꼭두각시 인형이나 진배없거늘\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아... 이 얼마만에 마시는 인간 세상의 공기인가\""
msgstr "\"아... 이 얼마만에 마시는 인간 세상의 공긴가\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"별의 지혜 교단의 인신 공양? 그런 시시한 이야기를 할 시간에 허리를 더 흔들어 보아라\""
msgstr "\"별의 지혜 교단의 인신 공양? 그런 시시한 이야기를 할 시간에 허리를 더 흔들어 보아라\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 마음. 이 불길로 표현해주지\""
msgstr "\"내 마음. 이 불길로 표현해주지\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"정녕 이 나를 죽일 수 있다고 생각하느냐?\""
msgstr "\"정녕 이 나를 죽일 수 있다고 생각하느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"큭... 빌어먹을 고양이 같으니!\""
msgstr "\"큭... 빌어먹을 고양이 같으니!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"징그러운 거대한 벌레는... 도통 이해할 수가 없구나\""
msgstr "\"징그러운 거대한 벌레는... 도통 이해할 수가 없구나\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"공포스러운 울음 소리인가, 끔찍한 울음 소리인가. 그 두 가지를 잘 분간하거라.\""
msgstr "\"공포스러운 울음 소린가, 끔찍한 울음 소린가. 그 두 가지를 잘 분간하거라.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"손으로 해주는 게 좋느냐? 아니면... 발으로?\""
msgstr "\"손으로 해주는 게 좋느냐? 아니면... 발로?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그 가슴이 큰 아이. 몽마들 사이에서 꽤나 인망이 두텁건만. 본인은 자각이 없는 게야.\""
msgstr "\"그 가슴이 큰 아이. 몽마들 사이에서 꽤나 인망이 두텁건만. 본인은 자각이 없는 게야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 세상에서 가장 신비로운 것이 있다면... 그 덩어리 괴물의 영향을 받고도. 본연의 모습을 유지하는 구더기떼니라.\""
msgstr "\"이 세상에서 가장 신비로운 것이 있다면... 그 덩어리 괴물의 영향을 받고도. 본연의 모습을 유지하는 구더기떼니라.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "유황 냄새가 풍겨온다..."
msgstr "유황 냄새가 풍겨온다..."

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"흥분했느냐?\""
msgstr "\"흥분했느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"여색이던, 남색이던 개의치 않는다.\""
msgstr "\"여색이던, 남색이던 개의치 않는다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"남자는 여자처럼 다루면 여자가 되는 법인게야♪\""
msgstr "\"남자는 여자처럼 다루면 여자가 되는 법인 게야♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"성별이 바뀌고 싶느냐? 후후..\""
msgstr "\"성별이 바뀌고 싶느냐? 후후..\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀여운 얼굴을 하고 있구나.\""
msgstr "\"귀여운 얼굴을 하고 있구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"핥으면 달콤한 맛이 날 것 같구나.\""
msgstr "\"핥으면 달콤한 맛이 날 것 같구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 내가 봉사해준다는 걸 영광으로 알거라\""
msgstr "\"이 내가 봉사해준다는 걸 영광으로 알 거라\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하등한 인간 따위가.\""
msgstr "\"하등한 인간 따위가.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후... 헌데 그 뾰족한 산란관은 무엇이느냐?\""
msgstr "\"후후... 헌데 그 뾰족한 산란관은 무엇이느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 세계엔 우리의 힘 또한 가득 퍼져있다... 인간이 줄어들었으니, 늘리기 쉽게도 해야 하지 않겠느냐?\""
msgstr "\"이 세계엔 우리의 힘 또한 가득 퍼져있다... 인간이 줄어들었으니, 늘리기 쉽게도 해야 하지 않겠느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아... 캠비온... 우리의 몸종, 영원한 하인들이다.\""
msgstr "\"아... 캠비온... 우리의 몸종, 영원한 하인들이다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀 더 농후한 것을 내보거라\""
msgstr "\"좀 더 농후한 것을 내보거라\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀여운 울음 소리로군...\""
msgstr "\"귀여운 울음 소리로군...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"추한 교성을 내지르는 모습이 마치 돼지 같구나.\""
msgstr "\"추한 교성을 내지르는 모습이 마치 돼지 같구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"달콤한 꿈에 빠지고 싶느냐? 후후... 대신 목숨은 보장못하느니라.\""
msgstr "\"달콤한 꿈에 빠지고 싶느냐? 후후... 대신 목숨은 보장못 하느니라.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀 더 울어보거라.\""
msgstr "\"좀 더 울어보거라.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"인간은 역시 시체 따위와는 다르군...\""
msgstr "\"인간은 역시 시체 따위와는 다르군...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그 얼굴, 마음에 들었다.\""
msgstr "\"그 얼굴, 마음에 들었다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"오늘 너는 아주 운이 좋구나. 이 나를 보다니.\""
msgstr "\"오늘 너는 아주 운이 좋구나. 이 나를 보다니.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"감히 이 나에게 목줄을 채울 셈이더냐?\""
msgstr "\"감히 이 나에게 목줄을 채울 셈이더냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아앗... 정말이지. 최고로구나!\""
msgstr "\"아앗... 정말이지. 최고로구나!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후. 어리광쟁이는 좋아한다.\""
msgstr "\"후후. 어리광쟁이는 좋아한다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"악마와 구분이 안될 정도로 타락시켜주마...\""
msgstr "\"악마와 구분이 안 될 정도로 타락시켜주마...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"피임 도구라... 왜 그런걸 쓰느냐? 아이는 낳으면 되고. 이 세상에선 귀찮은 육아는 신경 쓰지 않아도 되거늘.\""
msgstr "\"피임 도구라... 왜 그런 걸 쓰느냐? 아이는 낳으면 되고. 이 세상에선 귀찮은 육아는 신경 쓰지 않아도 되거늘.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"무릎 꿇고 빌어보거라. 그럼 죽기 직전까지만 뽑아내주마.\""
msgstr "\"무릎 꿇고 빌어보거라. 그럼 죽기 직전까지만 뽑아내주마.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 이 불꽃... 아름답지 않느냐?\""
msgstr "\"내 이 불꽃... 아름답지 않느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하트 모양의 불꽃이라서... 소녀 같다고? 낮부끄러운 소리를 잘도...\""
msgstr "\"하트 모양의 불꽃이라서... 소녀 같다고? 낮부끄러운 소리를 잘도...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀 더 즐기게 해다오♪\""
msgstr "\"좀 더 즐기게 해다오♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"손가락에 살짝 닿는 것만으로도, 자지러지게 해주마♪\""
msgstr "\"손가락에 살짝 닿는 것만으로도, 자지러지게 해주마♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"더 원하느냐?\""
msgstr "\"더 원하느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후. 성에 데려가서 키우고 싶구나.\""
msgstr "\"후후. 성에 데려가서 키우고 싶구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나의 하인이 되는 건 어떻느냐?\""
msgstr "\"나의 하인이 되는 건 어떻느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"사랑스러운 목소리로 더 울어다오.\""
msgstr "\"사랑스러운 목소리로 더 울어다오.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후... 벌써 참지 못하게 됐느냐?\""
msgstr "\"후후... 벌써 참지 못 하게 됐느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"정말로... 사랑스럽구나.\""
msgstr "\"정말로... 사랑스럽구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"인간이 감히...\""
msgstr "\"인간이 감히...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"기어오르지 말거라. 한낱 여흥에 불과하거늘.\""
msgstr "\"기어오르지 말거라. 한낱 여흥에 불과하거늘.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그 자를 만난다면, 마음이 도둑맞을 각오는 해두거라.\""
msgstr "\"그 자를 만난다면, 마음이 도둑맞을 각오는 해두거라.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"겁에 질린 게 느껴지는구나...\""
msgstr "\"겁에 질린 게 느껴지는구나...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"살짝 건드렸을 뿐인데 벌써부터 젖어있구나\""
msgstr "\"살짝 건드렸을 뿐인데 벌써부터 젖어있구나\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 기분이 좋느냐?\""
msgstr "\"그렇게 기분이 좋느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너는 순결을 지켜왔느냐? 오랜만에... 동정을 맛보고 싶은데.\""
msgstr "\"너는 순결을 지켜왔느냐? 오랜만에... 동정을 맛보고 싶은데.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"첫 경험이 서큐버스라면 자랑해도 된다.\""
msgstr "\"첫 경험이 서큐버스라면 자랑해도 된다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이렇게나 흐트러지다니... 사랑스러운지고♪\""
msgstr "\"이렇게나 흐트러지다니... 사랑스러운지고♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀비로... 성욕을 해소한다고? 정말. 인간은 밑도 끝도 없군...\""
msgstr "\"좀비로... 성욕을 해소한다고? 정말. 인간은 밑도 끝도 없군...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"인간의 무기 중에 케빈이라고 적힌 것이 있었다... 늙은 여자에게 누가 던지니 터졌는데 말이다..\""
msgstr "\"인간의 무기 중에 케빈이라고 적힌 것이 있었다... 늙은 여자에게 누가 던지니 터졌는데 말이다..\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"천국과 지옥은 종이 한 장... 쾌락으로 알려주마\""
msgstr "\"천국과 지옥은 종이 한 장... 쾌락으로 알려주마\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이렇게 침으로 질척해지다니... 사랑스러운 몸인지고♪\""
msgstr "\"이렇게 침으로 질척해지다니... 사랑스러운 몸인지고♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 손가락이 좋았느냐? 꽉 물어서 놔주지를 않는구나\""
msgstr "\"그렇게 손가락이 좋았느냐? 꽉 물어서 놔주지를 않는구나\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"거추장스러운 옷은 벗어던지거라. 함께 즐겨보지 않겠느냐♪\""
msgstr "\"거추장스러운 옷은 벗어던지거라. 함께 즐겨보지 않겠느냐♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저 걸어다니는 시체들은... 상대하기가 곤란해서 대부분의 서큐버스는 숲이나 평야에서 생존자를 몰색하고 있다.\""
msgstr "\"저 걸어다니는 시체들은... 상대하기가 곤란해서 대부분의 서큐버스는 숲이나 평야에서 생존자를 몰색하고 있다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저택에서 우리를 보았느냐?\""
msgstr "\"저택에서 우리를 보았느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 세상에 올 때... 가끔씩 실수를 해서 지하의 연구소 같은 곳에 가는 아이도 있다.\""
msgstr "\"이 세상에 올 때... 가끔씩 실수를 해서 지하의 연구소 같은 곳에 가는 아이도 있다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"동굴? 너희의 책에도 악마의 자손들이 동굴로 숨어들어 산다는 말이 나오지 않았느냐? 하하하!!\""
msgstr "\"동굴? 너희의 책에도 악마의 자손들이 동굴로 숨어들어 산다는 말이 나오지 않았느냐? 하하하!!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"애교가 많은 인간은... 싫어할 수가 없지♪\""
msgstr "\"애교가 많은 인간은... 싫어할 수가 없지♪\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어떻게 해주길 바라느냐?\""
msgstr "\"어떻게 해주길 바라느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후. 가고 싶다면 가게 해달라고. 정중하게 부탁을 해야 하지 않겠느냐?\""
msgstr "\"후후. 가고 싶다면 가게 해달라고. 정중하게 부탁을 해야 하지 않겠느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"꽉 꽉. 깨물어대는 것이 아주 명기로구나.\""
msgstr "\"꽉 꽉. 깨물어대는 것이 아주 명기로구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"끈적끈적한 것으로 손이 이렇게나 젖어버렸구나.\""
msgstr "\"끈적끈적한 것으로 손이 이렇게나 젖어버렸구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 발을 더럽히고 싶느냐?\""
msgstr "\"내 발을 더럽히고 싶느냐?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"몸을 맡기거라...\""
msgstr "\"몸을 맡기거라...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나랑 하고 싶어요?\""
msgstr "\"나랑 하고 싶어요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어려보여도 알 건 다 알고 있어요\""
msgstr "\"어려보여도 알 건 다 알고 있어요\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"성적인 자유란 건 굉장하지 않나요?\""
msgstr "\"성적인 자유란 건 굉장하지 않나요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저를 즐겁게 해줄... 멋진 사람을 찾고 있어요.\""
msgstr "\"저를 즐겁게 해줄... 멋진 사람을 찾고 있어요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어린 소년에 대한 성적 기호는... 고대 그리스 시절때부터 유행해왔다는 사실. 알고 계신가요?\""
msgstr "\"어린 소년에 대한 성적 기호는... 고대 그리스 시절 때부터 유행해왔다는 사실. 알고 계신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"제게 욕정하셔도 부끄러운 일이 아니에요.\""
msgstr "\"제게 욕정하셔도 부끄러운 일이 아니에요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"절 즐겁게 해주세요.\""
msgstr "\"절 즐겁게 해주세요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀비... 저는 시간 취향은 없어서 무리에요.\""
msgstr "\"좀비... 저는 시간 취향은 없어서 무리에요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이런 곳에서 사람을 찾는 처지라니...\""
msgstr "\"이런 곳에서 사람을 찾는 처지라니...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"사람의 온기가 그리워요...\""
msgstr "\"사람의 온기가 그리워요...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"세상이 이렇게 돼도, 욕정만은 사라지지 않네요!\""
msgstr "\"세상이 이렇게 돼도, 욕정만은 사라지지 않네요!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"뜨겁게 얽혀보지 않을래요?\""
msgstr "\"뜨겁게 얽혀보지 않을래요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나하고... 하고 싶어요?\""
msgstr "\"나하고... 하고 싶어요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"제게 여자 옷을 입혀보고 싶은가요?\""
msgstr "\"제게 여자 옷을 입혀보고 싶은가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"목걸이를 내게 걸고 싶다니. 진짜 최저네요.\""
msgstr "\"목걸이를 내게 걸고 싶다니. 진짜 최저네요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"재밌는 얼굴이네요\""
msgstr "\"재밌는 얼굴이네요\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"악마에게 나이는 없으니까... 안심하세요.\""
msgstr "\"악마에게 나이는 없으니까... 안심하세요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"초등학생하고 하는 건... 위험하죠?\""
msgstr "\"초등학생하고 하는 건... 위험하죠?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그 가랑이 사이에 숨긴 건 뭔가요?\""
msgstr "\"그 가랑이 사이에 숨긴 건 뭔가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"예전에는 가상 세상에 빠져서 현실을 등진 사람들도 있었다고 해요.\""
msgstr "\"예전에는 가상 세상에 빠져서 현실을 등진 사람들도 있었다고 해요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"주종관계를 성립한다면 저는 주인 쪽이 좋아요.\""
msgstr "\"주종관계를 성립한다면 저는 주인 쪽이 좋아요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"남자도... 여자도... 어느 쪽이던 좋아해요.\""
msgstr "\"남자도... 여자도... 어느 쪽이던 좋아해요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아아...! 가 버릴 것 같아..\""
msgstr "\"아아...! 가 버릴 것 같아..\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"우리에게 피임 도구는 필요 없어요.\""
msgstr "\"우리에게 피임 도구는 필요 없어요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"오랜만에 보네요. 우리를 기억하고 계시나요?\""
msgstr "\"오랜만에 보네요. 우리를 기억하고 계시나요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"상냥하게 어뤄만져 드릴게요.\""
msgstr "\"상냥하게 어뤄만져 드릴게요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 기분 좋았어요?\""
msgstr "\"그렇게 기분 좋았어요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"혀를 내밀어보세요. 후후훗\""
msgstr "\"혀를 내밀어보세요. 후후훗\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"허리가 빠질 지도 모르겠네요.\""
msgstr "\"허리가 빠질 지도 모르겠네요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"갈 정도는 아니네요...\""
msgstr "\"갈 정도는 아니네요...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저하고 하기 전엔... 굳이 준비할 필요가 없다고요?\""
msgstr "\"저하고 하기 전엔... 굳이 준비할 필요가 없다고요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후훗...\""
msgstr "\"후후훗...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 굶주렸어요?\""
msgstr "\"그렇게 굶주렸어요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"야한 얼굴을 하고 계시네요...\""
msgstr "\"야한 얼굴을 하고 계시네요...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"제가 좀 짖굳어요.\""
msgstr "\"제가 좀 짖굳어요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"제게 여자 옷을 입히고... 하고 싶으신가요?\""
msgstr "\"제게 여자 옷을 입히고... 하고 싶으신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"메이드... 메이드의 생태는 희안하네요.\""
msgstr "\"메이드... 메이드의 생태는 희안하네요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"야한 얼굴...\""
msgstr "\"야한 얼굴...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"작은 물건이여도, 편한 점이 있어요.\""
msgstr "\"작은 물건이여도, 편한 점이 있어요.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"쉬실 때 악마에게 몸이 뺏기지 않게 조심하세요!\""
msgstr "\"쉬실 때 악마에게 몸이 뺏기지 않게 조심하세요!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"저는 가슴이 몇 개던, 신경쓰지 않아요. 의외신가요?\""
msgstr "\"저는 가슴이 몇 개던, 신경쓰지 않아요. 의외신가요?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하루 밤의 꿈을 보여줄게.\""
msgstr "\"하루 밤의 꿈을 보여줄게.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"꿈을 보여드리는 데에 성별은 중요치 않아.\""
msgstr "\"꿈을 보여드리는 데에 성별은 중요치 않아.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"더 즐겁게 울어줘. 교성을 내질러줘\""
msgstr "\"더 즐겁게 울어줘. 교성을 내질러줘\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너를 기다리고 있었어\""
msgstr "\"너를 기다리고 있었어\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내가 못참겠어. 침대가 아니여도 괜찮으니까 어서 하자!\""
msgstr "\"내가 못 참겠어. 침대가 아니여도 괜찮으니까 어서 하자!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"야한 얼굴이구나...\""
msgstr "\"야한 얼굴이구나...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후후...\""
msgstr "\"후후후...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 애태우지 말아줘. 나는 벌써 준비만전이야.\""
msgstr "\"그렇게 애태우지 말아줘. 나는 벌써 준비만전이야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"젤은 충분히 준비해뒀어. 없는 게 더 좋아?\""
msgstr "\"젤은 충분히 준비해뒀어. 없는 게 더 좋아?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 기분 좋아?\""
msgstr "\"그렇게 기분 좋아?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"위아래로 괴롭혀지는 건 싫어?\""
msgstr "\"위아래로 괴롭혀지는 건 싫어?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀 더 깨물어보라고. 저항을 할거면 확실히 해줘야지.\""
msgstr "\"좀 더 깨물어보라고. 저항을 할 거면 확실히 해줘야지.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하하하하!!!\""
msgstr "\"하하하하!!!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"정말로 야한 몸을 하고 있구나.\""
msgstr "\"정말로 야한 몸을 하고 있구나.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하지 않을래?\""
msgstr "\"하지 않을래?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"탱탱하게 씹히는 게... 씹는 맛이 있어.\""
msgstr "\"탱탱하게 씹히는 게... 씹는 맛이 있어.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후. 얌전히 있어줘.\""
msgstr "\"후후. 얌전히 있어줘.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"남자의 탄탄한 몸도 안는 맛이 있어.\""
msgstr "\"남자의 탄탄한 몸도 안는 맛이 있어.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"더 즐겁게 해줄게.\""
msgstr "\"더 즐겁게 해줄게.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀여운 얼굴이구나...\""
msgstr "\"귀여운 얼굴이구나...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"쾌락으로 울부짖게 해줄게.\""
msgstr "\"쾌락으로 울부짖게 해줄게.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 새디즘을 자극하는구나...\""
msgstr "\"내 새디즘을 자극하는구나...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"크... 이런 얼굴의 남자라니... 참을 수가 없어!\""
msgstr "\"크... 이런 얼굴의 남자라니... 참을 수가 없어!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그 분을 만나신다면 마음이 뺏기지 않게 주의해.\""
msgstr "\"그 분을 만나신다면 마음이 뺏기지 않게 주의해.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"탱탱하구나?\""
msgstr "\"탱탱하구나?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"주인님이라고 불러.\""
msgstr "\"주인님이라고 불러.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"성인 용품 가게라... 한 번 가보고 싶네.\""
msgstr "\"성인 용품 가게라... 한 번 가보고 싶네.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"벌써 가는 거야? 성질하고 몸... 어느 쪽이 예민한걸까?\""
msgstr "\"벌써 가는 거야? 성질하고 몸... 어느 쪽이 예민한 걸까?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"함께 저속하게 떨어지자고\""
msgstr "\"함께 저속하게 떨어지자고\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"동성 관계에서도 아이가 생길까? 기대되네. 서로의 몸으로 실험... 해보지 않을래?\""
msgstr "\"동성 관계에서도 아이가 생길까? 기대되네. 서로의 몸으로 실험... 해보지 않을래?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 눈이 지금... 너만을 보고 있다는 거 알아?\""
msgstr "\"내 눈이 지금... 너만을 보고 있다는 거 알아?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"후후. 빈유라고 해서 차별하는 일은 없어. 가슴이 여러개여도 난 괜찮아.\""
msgstr "\"후후. 빈유라고 해서 차별하는 일은 없어. 가슴이 여러개여도 난 괜찮아.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"초등학생은 아무리 나도 좀...\""
msgstr "\"초등학생은 아무리 나도 좀...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"원자력... 바이브레이터?\""
msgstr "\"원자력... 바이브레이터?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"훌륭한 가슴이야.\""
msgstr "\"훌륭한 가슴이야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어떻게 주물러 줄까?\""
msgstr "\"어떻게 주물러 줄까?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아래 쪽이 벌써 질척해졌구나...\""
msgstr "\"아래쪽이 벌써 질척해졌구나...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내걸 빨아볼래? 내 정을 마시면... 우리처럼 될 지도 모르겠네.\""
msgstr "\"내걸 빨아볼래? 내 정을 마시면... 우리처럼 될 지도 모르겠네.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나는 아직 만족 못했어. 더 즐기자.\""
msgstr "\"나는 아직 만족 못 했어. 더 즐기자.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가끔씩 차가 사라지고 온 적도 없는 장소에 가는 일이 생긴다는데 세이브의 백업은 꾸준히 해둬...\""
msgstr "\"가끔씩 차가 사라지고 온 적도 없는 장소에 가는 일이 생긴다는데 세이브의 백업은 꾸준히 해둬...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 발정한 얼굴로 말해도...\""
msgstr "\"그렇게 발정한 얼굴로 말해도...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"언제나 눈에 담아두고 싶어.\""
msgstr "\"언제나 눈에 담아두고 싶어.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"오늘은 몇 번 갔어?\""
msgstr "\"오늘은 몇 번 갔어?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아주 야하구나...\""
msgstr "\"아주 야하구나...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어떤 취향이야?\""
msgstr "\"어떤 취향이야?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 하루, 꿈을 체험시켜줄게\""
msgstr "\"이 하루, 꿈을 체험시켜줄게\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좋은 몸을 하고 있네...\""
msgstr "\"좋은 몸을 하고 있네...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"목걸이라. 나는 거는 쪽이 더 좋은데.\""
msgstr "\"목걸이라. 나는 거는 쪽이 더 좋은데.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나는 남자 여자 가리지 않고 해버린다고\""
msgstr "\"나는 남자 여자 가리지 않고 해버린다고\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"근육은 정말 아름답지 않나? ANG?\""
msgstr "\"근육은 정말 아름답지 않나? ANG?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 이 듬직한 근육으로 하루밤의 꿈을 보여주지\""
msgstr "\"내 이 듬직한 근육으로 하루밤의 꿈을 보여주지\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"싫다고 앙탈을 부려도 소용없다고?\""
msgstr "\"싫다고 앙탈을 부려도 소용없다고?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"남자도 여자처럼 다루면 여자가 되는 법이지!\""
msgstr "\"남자도 여자처럼 다루면 여자가 되는 법이지!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하하하하하하하!!!\""
msgstr "\"하하하하하하하!!!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"테크닉이 엉망진창이군\""
msgstr "\"테크닉이 엉망진창이군\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 멋진 근육 앞에서 무드가 중요하다고 생각하나?\""
msgstr "\"이 멋진 근육 앞에서 무드가 중요하다고 생각하나?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"몸과 몸이 부딪히는 순간은 아름답지...\""
msgstr "\"몸과 몸이 부딪히는 순간은 아름답지...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"손 브라를 하고 오라니... 꽤나 대담한 요구군!\""
msgstr "\"손 브라를 하고 오라니... 꽤나 대담한 요구군!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"몸이 애타게 달아오르는군...\""
msgstr "\"몸이 애타게 달아오르는군...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"프로틴은 어디있지?\""
msgstr "\"프로틴은 어디있지?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그건 내 이두박근이라네\""
msgstr "\"그건 내 이두박근이라네\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"농후한 단백질... 원하는가?\""
msgstr "\"농후한 단백질... 원하는가?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀비 따위가 내 근육을 상대할 수 있을까!\""
msgstr "\"좀비 따위가 내 근육을 상대할 수 있을까!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그런 눈으로 보면 느끼고 말아♡\""
msgstr "\"그런 눈으로 보면 느끼고 말아♡\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀여운 아이도... 나름대로 좋아해\""
msgstr "\"귀여운 아이도... 나름대로 좋아해\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 사랑으로 꽉 껴안아주지\""
msgstr "\"내 사랑으로 꽉 껴안아주지\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "끔찍한 뭔가가 느껴지고 있다..."
msgstr "끔찍한 뭔가가 느껴지고 있다..."

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나한테서... 눈을 떼지 마라. 이 멋진 근육을 한순간이라도 놓치는 건 짧은 인생에 있어서 큰 손해라고 생각하지 않나?\""
msgstr "\"나한테서... 눈을 떼지 마라. 이 멋진 근육을 한순간이라도 놓치는 건 짧은 인생에 있어서 큰 손해라고 생각하지 않나?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"굉장하지 않은가?\""
msgstr "\"굉장하지 않은가?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"잘 가라. 애송아.\""
msgstr "\"잘 가라. 애송아.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"남자도 여자처럼 다루면 여자가 되는 법이다. 성별은 무의미하다.\""
msgstr "\"남자도 여자처럼 다루면 여자가 되는 법이다. 성별은 무의미하다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"순순히 항복해라. 천국을 보여주지\""
msgstr "\"순순히 항복해라. 천국을 보여주지\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"꺼져라, 더러운 좀비들\""
msgstr "\"꺼져라, 더러운 좀비들\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너는 불타오르는 프로레슬링에 대해서 얼마나 알고 있지?\""
msgstr "\"너는 불타오르는 프로레슬링에 대해서 얼마나 알고 있지?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"매일마다 하는 단련이... 강한 근육을 낳는다.\""
msgstr "\"매일마다 하는 단련이... 강한 근육을 낳는다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"찰지구나!\""
msgstr "\"찰지구나!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"엉덩이를 더 치켜올려봐라!\""
msgstr "\"엉덩이를 더 치켜올려봐라!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"크...! 이런 얼굴의 남자라니 참을 수 없군!\""
msgstr "\"크...! 이런 얼굴의 남자라니 참을 수 없군!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너와 침대 위에서 겨루고 싶군!\""
msgstr "\"너와 침대 위에서 겨루고 싶군!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"레슬링에는 한 종류만이 있는 게 아니다. 침대도 링이다!\""
msgstr "\"레슬링에는 한 종류만이 있는 게 아니다. 침대도 링이다!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"남자의 탄탄한 근육이 제법 좋지.\""
msgstr "\"남자의 탄탄한 근육이 제법 좋지.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"여자의 몸도 안는 맛이 있다.\""
msgstr "\"여자의 몸도 안는 맛이 있다.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나랑 *기분 좋은 일* 안할래?\""
msgstr "\"나랑 *기분 좋은 일* 안 할래?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하반신이 뻐근해지게 해줄게\""
msgstr "\"하반신이 뻐근해지게 해줄게\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 물건을 봐줘. 어떻게 생각해?\""
msgstr "\"내 물건을 봐줘. 어떻게 생각해?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 쪽으로 와... 천국을 보여줄게\""
msgstr "\"이쪽으로 와... 천국을 보여줄게\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"거기가 뜨거워... 뜨겁게 작동되려고 하고 있어!\""
msgstr "\"거기가 뜨거워... 뜨겁게 작동되려고 하고 있어!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"더는 못참겠어\""
msgstr "\"더는 못 참겠어\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"있잖아, 남자도 여자처럼 다루면 여자가 된다는 거 알아?\""
msgstr "\"있잖아, 남자도 여자처럼 다루면 여자가 된다는 거 알아?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"남자의 뒤에는 *스위치*가 있다는 사실 알아?\""
msgstr "\"남자의 뒤에는 *스위치*가 있다는 사실 알아?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"앞 부분에도 넣을 수 있어. 잘 풀면 말이야.\""
msgstr "\"앞 부분에도 넣을 수 있어. 잘 풀면 말이야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 몸은 특별제야. 풀지 않으면 무리일 걸?\""
msgstr "\"내 몸은 특별제야. 풀지 않으면 무리일 걸?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 가랑이에 뭐가 있는 지 알겠어?\""
msgstr "\"내 가랑이에 뭐가 있는지 알겠어?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"방금 *기분 좋은 일*하다가 왔어\""
msgstr "\"방금 *기분 좋은 일*하다가 왔어\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"오줌이 나오는 부분이면 무리라고 생각해?\""
msgstr "\"오줌이 나오는 부분이면 무리라고 생각해?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나는 앞도, 뒤도 가리지 않아. 너도 앞에 넣어볼래?\""
msgstr "\"나는 앞도, 뒤도 가리지 않아. 너도 앞에 넣어볼래?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"세상이 이렇다면... 장소에 연연할 필요는 없는 게 아닐까?\""
msgstr "\"세상이 이렇다면... 장소에 연연할 필요는 없는 게 아닐까?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"여기야. 여기.\""
msgstr "\"여기야. 여기.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너 정말로 귀엽구나. 벌써 서버렸어.\""
msgstr "\"너 정말로 귀엽구나. 벌써 서버렸어.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"히익 히익 울게 해줄게\""
msgstr "\"히익 히익 울게 해줄게\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이거면 너도 잘 풀릴 걸?\""
msgstr "\"이거면 너도 잘 풀릴 걸?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"더 느슨하게 흐물흐물 만들어줄게\""
msgstr "\"더 느슨하게 흐물흐물 만들어줄게\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이 쪽은 어때? 난 좋아해\""
msgstr "\"이쪽은 어때? 난 좋아해\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"즐기게 해줄래? 성적인 즐거움보다... 더 짜릿한 게 있지.\""
msgstr "\"즐기게 해줄래? 성적인 즐거움보다... 더 짜릿한 게 있지.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 크고 아름다운 총을 봐줘. 아랫도리가 아니라 손에 든 이거야. 이거.\""
msgstr "\"내 크고 아름다운 총을 봐줘. 아랫도리가 아니라 손에 든 이거야. 이거.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"다시 한 번 더. 잘 봐! 내 총알에서는 벗어날 수 있다는 걸 알게 해줄테니!\""
msgstr "\"다시 한 번 더. 잘 봐! 내 총알에서는 벗어날 수 있다는 걸 알게 해줄 테니!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"발 없는 도마뱀, 백발백중이지.\""
msgstr "\"발 없는 도마뱀, 백발백중이지.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"종말이 왔는데 총 든 악마가 그리 신기해?\""
msgstr "\"종말이 왔는데 총 든 악마가 그리 신기해?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"춤춰 볼래? 내 총의 박자에 맞춰서 발버둥치라고.\""
msgstr "\"춤춰 볼래? 내 총의 박자에 맞춰서 발버둥치라고.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"소리 내지 마. 어차피 너한테 조심하란 귀뜀 하나 해줄 사람도 남아 있지 않아!\""
msgstr "\"소리 내지 마. 어차피 너한테 조심하란 귀뜀 하나 해줄 사람도 남아 있지 않아!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하하하하하!!! 더, 더 쏘고 싶어!\""
msgstr "\"하하하하하!!! 더, 더 쏘고 싶어!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"대단해. 대단하다고.\""
msgstr "\"대단해. 대단하다고.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"생존자... 오랜만이야. 잘 지냈어? 내 표적으로 생을 마감해줘.\""
msgstr "\"생존자... 오랜만이야. 잘 지냈어? 내 표적으로 생을 마감해줘.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"늙은 들소의 시체 위에서 사냥을 즐겨보자고. 아직도 신선한 머리가 하나 남아 있으니까 충분히 즐길 수 있을거야.\""
msgstr "\"늙은 들소의 시체 위에서 사냥을 즐겨보자고. 아직도 신선한 머리가 하나 남아 있으니까 충분히 즐길 수 있을 거야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"재밌어! 정말로 짜릿해!\""
msgstr "\"재밌어! 정말로 짜릿해!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"망상이 밉고 싫어져야 할거야. 빛나고 따뜻했던 과거를 떠올리면 떠올릴수록 현재의 생각은 쓸쓸함과 고통으로 가득찰테니!\""
msgstr "\"망상이 밉고 싫어져야 할 거야. 빛나고 따뜻했던 과거를 떠올리면 떠올릴수록 현재의 생각은 쓸쓸함과 고통으로 가득찰 테니!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"생존자. 간단한 게임 한 번 어때?\""
msgstr "\"생존자. 간단한 게임 한 번 어때?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"규칙은 간단해. 먼저 쏴서 죽이는 쪽이 이기는 거야.\""
msgstr "\"규칙은 간단해. 먼저 쏴서 죽이는 쪽이 이기는 거야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아직도 신이 이 지상을 굽어살핀다고 생각해?\""
msgstr "\"아직도 신이 이 지상을 굽어살핀다고 생각해?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아, 인류... 가련한 인류... 너희가 줄어들어서 우리 남매들은 발버둥치며 먹잇감을 찾고 있어...\""
msgstr "\"아, 인류... 가련한 인류... 너희가 줄어들어서 우리 남매들은 발버둥치며 먹잇감을 찾고 있어...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"별 위에 계신 그 분은 자비가 넘치시지. 오늘 밤, 그 분께서도 네가 내 총알에 맞아 숨을 거두는 모습을 지켜보고 계실거야.\""
msgstr ""
"\"별 위에 계신 그 분은 자비가 넘치시지. 오늘 밤, 그 분께서도 네가 내 총알에 맞아 숨을 거두는 모습을 지켜보고 계실 거야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너는 얼마나 할 수 있을까. 기대돼.\""
msgstr "\"너는 얼마나 할 수 있을까. 기대돼.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"마음이 순결하고 죄 없이 사는 사람들은 어디 있을까? 생존자. 네가 저지른 죄가 보여...\""
msgstr "\"마음이 순결하고 죄 없이 사는 사람들은 어디 있을까? 생존자. 네가 저지른 죄가 보여...\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"지옥에서 기다리고 있을게\""
msgstr "\"지옥에서 기다리고 있을게\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"다음에도 살아 있다면 더 즐겁게 놀아 보자고.\""
msgstr "\"다음에도 살아 있다면 더 즐겁게 놀아 보자고.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"하늘에 대고 총을 쏴본들 별 일 있겠어? 천둥 바람도 저 괴물들을 못죽이는데?\""
msgstr "\"하늘에 대고 총을 쏴본들 별 일 있겠어? 천둥 바람도 저 괴물들을 못 죽이는데?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"다른 곳에서 온 괴물의 속임수에 넘어간 적 있어? 그렇게 순진하진 않길 바래.\""
msgstr "\"다른 곳에서 온 괴물의 속임수에 넘어간 적 있어? 그렇게 순진하진 않길 바래.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"걸어다니는 시체를 옆에 두고 한 잔 한다니. 네가 나보다 더 선수네. 내가 서큐버스였으면 바로 덮쳤을거야.\""
msgstr "\"걸어다니는 시체를 옆에 두고 한 잔 한다니. 네가 나보다 더 선수네. 내가 서큐버스였으면 바로 덮쳤을 거야.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너의 마음을 훔쳐가주지\""
msgstr "\"너의 마음을 훔쳐가주지\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"사랑스러운 얼굴을 하고 있잖아\""
msgstr "\"사랑스러운 얼굴을 하고 있잖아\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"힘들면 이 품에 안겨도 돼\""
msgstr "\"힘들면 이 품에 안겨도 돼\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"위 아래로 괴롭혀지는 건 싫나?\""
msgstr "\"위 아래로 괴롭혀지는 건 싫나?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"어느 쪽이던 핥는 맛이 있을 것 같아\""
msgstr "\"어느 쪽이던 핥는 맛이 있을 것 같아\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나는 박애주의자다. 훔치는 데에 성별, 외모를 가리진 않아.\""
msgstr "\"나는 박애주의자다. 훔치는 데에 성별, 외모를 가리진 않아.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"좀비에겐 마음이 없어서 훔칠 수 없단 말이야. 나라도 없는 걸 훔칠 순 없어.\""
msgstr "\"좀비에겐 마음이 없어서 훔칠 수 없단 말이야. 나라도 없는 걸 훔칠 순 없어.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나에게 반할 것 같나?\""
msgstr "\"나에게 반할 것 같나?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"스팽킹이 취향인가?\""
msgstr "\"스팽킹이 취향인가?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"자! 하하하!\""
msgstr "\"자! 하하하!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너의 리비도를 보여줘\""
msgstr "\"너의 리비도를 보여줘\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"뜨겁게 얽혀보자고\""
msgstr "\"뜨겁게 얽혀보자고\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"서버렸다...!\""
msgstr "\"서버렸다...!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 나름의 애무야\""
msgstr "\"내 나름의 애무야\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"가버릴 것 같군...!\""
msgstr "\"가버릴 것 같군...!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이런 플레이도 나쁘진 않아\""
msgstr "\"이런 플레이도 나쁘진 않아\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"설마 처음인가? 이거 영광인 걸\""
msgstr "\"설마 처음인가? 이거 영광인 걸\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"내 생각만 나게 만들어주지\""
msgstr "\"내 생각만 나게 만들어주지\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"혹시 내 마조히즘을 자극할 셈인가?\""
msgstr "\"혹시 내 마조히즘을 자극할 셈인가?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"이거 걸작이군!\""
msgstr "\"이거 걸작이군!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"손끝만으로 갖고 놀아줄까?\""
msgstr "\"손끝만으로 갖고 놀아줄까?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"귀여운 얼굴로 애태우지 말라고\""
msgstr "\"귀여운 얼굴로 애태우지 말라고\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아아! 참을 수가 없어\""
msgstr "\"아아! 참을 수가 없어\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"목걸이? 주종 플레이인가! 그것도 나쁘지 않아! 하지만, 그냥 당해주진 않을거라고?\""
msgstr "\"목걸이? 주종 플레인가! 그것도 나쁘지 않아! 하지만, 그냥 당해주진 않을 거라고?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"무시라니... 쌀쌀 맞구만~!!\""
msgstr "\"무시라니... 쌀쌀 맞구만~!!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나는 언제나 서있어. 남자는 언제나 마음 속에서만큼은 발기하고 있지.\""
msgstr "\"나는 언제나 서있어. 남자는 언제나 마음 속에서만큼은 발기하고 있지.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"너의 야한 모습을 상상했더니 벌써부터 벌떡벌떡인 걸?\""
msgstr "\"너의 야한 모습을 상상했더니 벌써부터 벌떡벌떡인 걸?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"그렇게 애타는 눈으로 보지 마. 덮치고 싶어지잖아.\""
msgstr "\"그렇게 애타는 눈으로 보지 마. 덮치고 싶어지잖아.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"벌써 도둑 맞았나?\""
msgstr "\"벌써 도둑 맞았나?\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"나한테 반해도 된다고. 베이비.\""
msgstr "\"나한테 반해도 된다고. 베이비.\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"인외 플레이인가! 나쁘지 않군!\""
msgstr "\"인외 플레인가! 나쁘지 않군!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"깨물어보라고!\""
msgstr "\"깨물어보라고!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"앙탈이 심하구만!\""
msgstr "\"앙탈이 심하구만!\""

#: data\mods\Hentai_sp\json\hen_speech.json
msgid "\"아아.. 좋아! 그 얼굴이다!\""
msgstr "\"아아.. 좋아! 그 얼굴이다!\""

