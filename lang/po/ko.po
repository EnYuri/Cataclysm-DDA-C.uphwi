#: data\mods\Nechronica\nec_martialarts.json
msgid "쿵푸"
msgstr "쿵푸"

#. ~ Description for martial art '쿵푸'
#: data\mods\Nechronica\nec_martialarts.json
msgid ""
"쿵푸란 일종의 무술이지만 본고장인 중국에서는 단련 훈련의 의미로도 쓰입니다. 강철같은 타격력과 유연한 몸놀림이 특징으로 상대를 날려버리는"
" 기술이 뛰어납니다."
msgstr ""
"쿵푸란 일종의 무술이지만 본고장인 중국에서는 단련 훈련의 의미로도 쓰입니다. 강철 같은 타격력과 유연한 몸놀림이 특징으로 상대를 "
"날려버리는 기술이 뛰어납니다."

#. ~ Initiate message for martial art '쿵푸'
#. ~ Initiate message for martial art '이천일류'
#: data\mods\Nechronica\nec_martialarts.json
msgid "You assume a combat stance."
msgstr "전투 자세를 취합니다."

#. ~ Initiate message for martial art '쿵푸'
#. ~ Initiate message for martial art '이천일류'
#: data\mods\Nechronica\nec_martialarts.json
#, c-format
msgid "%s assumes a combat stance."
msgstr "%s이(가) 전투 자세를 취했습니다."

#: data\mods\Nechronica\nec_martialarts.json
msgid "쿵푸 호흡"
msgstr "쿵푸 호흡"

#. ~ Description of buff '쿵푸 호흡' for martial art '쿵푸'
#: data\mods\Nechronica\nec_martialarts.json
msgid "독특한 호흡 방법으로 언제나 평정을 유지합니다. 회피와 타격에 보정을 받습니다."
msgstr "독특한 호흡 방법으로 언제나 평정을 유지합니다. 회피와 타격에 보정을 받습니다."

#: data\mods\Nechronica\nec_martialarts.json
msgid "쿵푸 보법"
msgstr "쿵푸 보법"

#. ~ Description of buff '쿵푸 보법' for martial art '쿵푸'
#: data\mods\Nechronica\nec_martialarts.json
msgid "언제나 공격과 회피를 자유자재로 할 수 있는 공방일체의 보법입니다. 명중과 회피에 보정을 받습니다."
msgstr "언제나 공격과 회피를 자유자재로 할 수 있는 공방일체의 보법입니다. 명중과 회피에 보정을 받습니다."

#: data\mods\Nechronica\nec_martialarts.json
msgid "쿵푸 회피"
msgstr "쿵푸 회피"

#. ~ Description of buff '쿵푸 회피' for martial art '쿵푸'
#: data\mods\Nechronica\nec_martialarts.json
msgid "공격을 피해낸 순간, 적에게 기회는 없습니다. 항상 반격의 틈을 노리고 있습니다. 회피와 타격에 보정을 받습니다. 중복 가능."
msgstr ""
"공격을 피해낸 순간, 적에게 기회는 없습니다. 항상 반격의 틈을 노리고 있습니다. 회피와 타격에 보정을 받습니다. 중복 가능."

#: data\mods\Nechronica\nec_martialarts.json
msgid "이천일류"
msgstr "이천일류"

#. ~ Description for martial art '이천일류'
#: data\mods\Nechronica\nec_martialarts.json
msgid "이천일류는 고대의 미야모토 무사시로부터 비롯된 일본 전통의 검술입니다."
msgstr "이천일류는 고대의 미야모토 무사시로부터 비롯된 일본 전통의 검술입니다."

#: data\mods\Nechronica\nec_martialarts.json
msgid "막기"
msgstr "막기"

#. ~ Description of buff '막기' for martial art '이천일류'
#: data\mods\Nechronica\nec_martialarts.json
msgid "공격할 때 마다 회피를 할 수 없게 되지만, 더 많은 방어를 시도할 수 있습니다."
msgstr "공격할 때마다 회피를 할 수 없게 되지만, 더 많은 방어를 시도할 수 있습니다."

#. ~ Description of buff for martial art '이천일류'
#: data\mods\Nechronica\nec_martialarts.json
msgid "인지력이 피해와 회피를 높입니다."
msgstr "인지력이 피해와 회피를 높입니다."

#. ~ Description of buff '막기' for martial art '이천일류'
#: data\mods\Nechronica\nec_martialarts.json
msgid "움직일 때 마다 회피를 할 수 없게 되지만, 더 많은 방어를 시도할 수 있습니다."
msgstr "움직일 때마다 회피를 할 수 없게 되지만, 더 많은 방어를 시도할 수 있습니다."

#: data\mods\Nechronica\nec_martialarts.json
msgid "한 순간"
msgstr "한 순간"

#. ~ Description of buff '한 순간' for martial art '이천일류'
#: data\mods\Nechronica\nec_martialarts.json
msgid "당신은 적이 방어하는 사이의 빈틈을 찾아냈습니다!"
msgstr "당신은 적이 방어하는 사이의 빈틈을 찾아냈습니다!"

#: data\mods\Nechronica\nec_monsters.json
msgid "좀비 퀸"
msgid_plural "좀비 퀸s"
msgstr[0] "좀비 퀸"

#. ~ Description for 좀비 퀸
#: data\mods\Nechronica\nec_monsters.json
msgid "겉보기에는 아름다운 소녀로 보이지만 그 실체는 무수한 언데드의 대군을 이끄는 죽은 자들의 여왕입니다."
msgstr "겉보기에는 아름다운 소녀로 보이지만 그 실체는 무수한 언데드의 대군을 이끄는 죽은 자들의 여왕입니다."

#. ~ Description for 좀비 퀸
#: data\mods\Nechronica\nec_monsters.json
msgid "아름다운 소녀로 보이지만 실제론 어떨까요..?"
msgstr "아름다운 소녀로 보이지만 실제론 어떨까요..?"

#: data\mods\Nechronica\nec_monsters.json
msgid "밴쉬"
msgid_plural "밴쉬s"
msgstr[0] "밴쉬"

#. ~ Description for 밴쉬
#: data\mods\Nechronica\nec_monsters.json
msgid "원래는 소녀였던 걸로 보이지만, 지금은 자아가 붕괴해서 광기를 발산하고 있을 뿐입니다."
msgstr "원래는 소녀였던 걸로 보이지만, 지금은 자아가 붕괴해서 광기를 발산하고 있을 뿐입니다."

#: data\mods\Nechronica\nec_monsters.json
msgid "네메시스"
msgid_plural "네메시스s"
msgstr[0] "네메시스"

#. ~ Description for 네메시스
#: data\mods\Nechronica\nec_monsters.json
msgid ""
"외관은 어린 소녀의 모습이지만 분명히 인간의 것이 아닌 속도와 괴력으로 칼을 휘두르고 있는 괴물이다. 모독적인 기술로 강화된 개체임이 "
"분명합니다."
msgstr ""
"외관은 어린 소녀의 모습이지만 분명히 인간의 것이 아닌 속도와 괴력으로 칼을 휘두르고 있는 괴물이다. 모독적인 기술로 강화된 개체임이 "
"분명합니다."

#: data\mods\Nechronica\nec_monsters.json
msgid "발키리"
msgid_plural "발키리s"
msgstr[0] "발키리"

#. ~ Description for 발키리
#: data\mods\Nechronica\nec_monsters.json
msgid ""
"원래 모습을 알아보지 못할만큼 기계 개조를 당한 불쾌한 괴물입니다. 다리가 아니라 부유물같은 것에 의해서 둥둥 떠다니고 있습니다."
msgstr ""
"원래 모습을 알아보지 못 할 만큼 기계 개조를 당한 불쾌한 괴물입니다. 다리가 아니라 부유물 같은 것에 의해서 둥둥 떠다니고 있습니다."

#: data\mods\Nechronica\nec_monsters.json
msgid "히루코"
msgid_plural "히루코s"
msgstr[0] "히루코"

#. ~ Description for 히루코
#: data\mods\Nechronica\nec_monsters.json
msgid ""
"인간이었던 걸로 보이지만 사지가 절단되고 거기에 갈고리가 꿰인 괴물입니다. 뛰어난 재생력을 지니고 있지만 눈이 없어서 시력은 없는 "
"모양입니다."
msgstr ""
"인간이었던 걸로 보이지만 사지가 절단되고 거기에 갈고리가 꿰인 괴물입니다. 뛰어난 재생력을 지니고 있지만 눈이 없어서 시력은 없는 "
"모양입니다."

#: data\mods\Nechronica\nec_mutagen.json
msgid "언데드 혈청"
msgid_plural "언데드 혈청s"
msgstr[0] "언데드 혈청"

#. ~ Description for 언데드 혈청
#: data\mods\Nechronica\nec_mutagen.json
msgid "농축된 뮤타젠입니다. 거무튀튀한 것이 꿈틀거리고 있습니다. 사용하기 위해선 주사기가 필요합니다..."
msgstr "농축된 뮤타젠입니다. 거무튀튀한 것이 꿈틀거리고 있습니다. 사용하기 위해선 주사기가 필요합니다..."

#: data\mods\Nechronica\nec_mutagen.json
msgid "언데드 뮤타젠"
msgid_plural "언데드 뮤타젠s"
msgstr[0] "언데드 뮤타젠"

#. ~ Mutation class name
#: data\mods\Nechronica\nec_mutation_category.json
#: data\mods\Nechronica\nec_mutations.json
msgid "언데드"
msgstr "언데드"

#. ~ Mutation class: 언데드 mutagen_message
#: data\mods\Nechronica\nec_mutation_category.json
msgid "이제 너는 몸을 누더기처럼 기우는 것이 당연해졌다."
msgstr "이제 너는 몸을 누더기처럼 기우는 것이 당연해졌다."

#. ~ Mutation class: 언데드 iv_message
#: data\mods\Nechronica\nec_mutation_category.json
msgid "다음은 어디를 자르고 어떤 걸 새로 붙여볼까?"
msgstr "다음은 어디를 자르고 어떤 걸 새로 붙여볼까?"

#. ~ Mutation class: 언데드 Male memorial messsage
#: data\mods\Nechronica\nec_mutation_category.json
msgctxt "memorial_male"
msgid "몸이 부숴져도 순식간에 고칠 수 있다."
msgstr "몸이 부숴져도 순식간에 고칠 수 있다."

#. ~ Mutation class: 언데드 Female memorial messsage
#: data\mods\Nechronica\nec_mutation_category.json
msgctxt "memorial_female"
msgid "몸이 부숴져도 순식간에 고칠 수 있다."
msgstr "몸이 부숴져도 순식간에 고칠 수 있다."

#: data\mods\Nechronica\nec_mutations.json
msgid "오토코노코"
msgstr "오토코노코"

#. ~ Description for 오토코노코
#: data\mods\Nechronica\nec_mutations.json
msgid "당신의 몸은 소녀의 모습을 하고 있지만 소년의 특징 또한 가지고 있다. 귀중하긴 하지만 지금 당장 유용하지는 않을 것이다."
msgstr "당신의 몸은 소녀의 모습을 하고 있지만 소년의 특징 또한 가지고 있다. 귀중하긴 하지만 지금 당장 유용하지는 않을 것이다."

#. ~ Description for 언데드
#: data\mods\Nechronica\nec_mutations.json
msgid "망가진 몸뚱이를 누더기처럼 기워서 유지하고 있다. 부숴지더라도 새로운 부품으로 대체하면 된다."
msgstr "망가진 몸뚱이를 누더기처럼 기워서 유지하고 있다. 부숴지더라도 새로운 부품으로 대체하면 된다."

#: data\mods\Nechronica\nec_mutations.json
msgid "질척질척"
msgstr "질척질척"

#. ~ Description for 질척질척
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"Your body is coated with a fine slime.  Protects from long term effects of "
"acid, though not short term ones.  Greatly increases wet benefits."
msgstr ""
"몸이 얇은 점액에 싸여 있다. 장기적인 산성 피해를 막아주지만 단기 피해는 막지 못 한다. 몸이 젖었을 때 상당한 보너스를 받는다."

#. ~ Description for Very Fast Metabolism
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"You find yourself hungry.  A lot.  You need about twice as much food as the "
"average human."
msgstr "항상 배가 고픕니다. 정말로요. 평균적인 인간의 약 두 배의 음식이 필요합니다."

#. ~ Description for Extreme Metabolism
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"You burn calories like gasoline-soaked tinder.  You consume three times as "
"much food as the average human."
msgstr "휘발유에 적신 부싯깃처럼 칼로리를 태웁니다. 평균적인 인간의 세 배 음식을 섭취합니다."

#. ~ Description for Hyper-Metabolism
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"You metabolize nutrients so rapidly that you can convert food directly into "
"useful tissue.  Excess nutrition will convert to HP, rather than being "
"wasted.  Activate to skip prompt for overeating."
msgstr ""
"영양분을 너무 빠르게 대사하여 음식을 직접 유용한 조직으로 변환할 수 있습니다. 과잉 영양은 낭비되는 대신 HP로 변환됩니다. 과식 "
"프롬프트를 건너뛰려면 활성화하세요."

#. ~ Description for Regeneration
#: data\mods\Nechronica\nec_mutations.json
#: data\mods\Touhou_com\mutations_hourai.json
msgid "Your flesh regenerates from wounds incredibly quickly."
msgstr "몸의 상처가 극도로 빨리 회복됩니다."

#: data\mods\Nechronica\nec_mutations.json
msgid "여분의 눈"
msgstr "여분의 눈"

#. ~ Description for 여분의 눈
#: data\mods\Nechronica\nec_mutations.json
msgid "당신의 몸에는 새로운 눈이 생겨났다. 시야가 넓어지지만 겉모습은 징그러워졌다. 지각력이 꽤 뛰어나졌다. 지각력 +2"
msgstr "당신의 몸에는 새로운 눈이 생겨났다. 시야가 넓어지지만 겉모습은 징그러워졌다. 지각력이 꽤 뛰어나졌다. 지각력 +2"

#: data\mods\Nechronica\nec_mutations.json
msgid "여분의 팔"
msgstr "여분의 팔"

#. ~ Description for 여분의 팔
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"당신의 팔은 두 개로 끝나지 않는다. 어깨에 팔이 더 돋아나있다. 원래 쓰던 팔이 아니라서 쓰긴 불편하지만 전술의 폭은 넓어졌다. 민첩성"
" +2"
msgstr ""
"당신의 팔은 두 개로 끝나지 않는다. 어깨에 팔이 더 돋아나있다. 원래 쓰던 팔이 아니라서 쓰긴 불편하지만 전술의 폭은 넓어졌다. 민첩성"
" +2"

#: data\mods\Nechronica\nec_mutations.json
msgid "여분의 다리"
msgstr "여분의 다리"

#. ~ Description for 여분의 다리
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"당신의 다리는 두 개뿐만이 아니다. 또 다른 한쌍의 다리가 허리에서부터 자라났다. 전용 다리 방어구를 착용헤야 하지만 보다 빠르게 움직일"
" 수 있다."
msgstr ""
"당신의 다리는 두 개뿐만이 아니다. 또 다른 한 쌍의 다리가 허리에서부터 자라났다. 전용 다리 방어구를 착용헤야 하지만 보다 빠르게 "
"움직일 수 있다."

#: data\mods\Nechronica\nec_mutations.json
msgid "큰 구멍"
msgstr "큰 구멍"

#. ~ Description for 큰 구멍
#: data\mods\Nechronica\nec_mutations.json
msgid "당신의 몸에는 큰 결손이 있다. 전투에 지장은 없지만, 사람들이 구멍을 보고 살짝 놀랄만큼 크다."
msgstr "당신의 몸에는 큰 결손이 있다. 전투에 지장은 없지만, 사람들이 구멍을 보고 살짝 놀랄 만큼 크다."

#: data\mods\Nechronica\nec_mutations.json
msgid "큰 뿔"
msgstr "큰 뿔"

#. ~ Description for 큰 뿔
#: data\mods\Nechronica\nec_mutations.json
msgid "근거리에서 찌르거나 다리를 걸기 충분한 길이의 큰 돌기가 나있다."
msgstr "근거리에서 찌르거나 다리를 걸기 충분한 길이의 큰 돌기가 나있다."

#: data\mods\Nechronica\nec_mutations.json
msgid "당신은 뿔로 %s 를 찔렀다"
msgstr "당신은 뿔로 %s를 찔렀다"

#: data\mods\Nechronica\nec_mutations.json
msgid "%1$ 는 뿔로 %2$ 를 찔렀다."
msgstr "%1$는 뿔로 %2$를 찔렀다."

#: data\mods\Nechronica\nec_mutations.json
msgid "긴 혀"
msgstr "긴 혀"

#. ~ Description for 긴 혀
#: data\mods\Nechronica\nec_mutations.json
msgid "당신의 혀는 긴 대롱처럼 늘어났다. 별 효과는 없다."
msgstr "당신의 혀는 긴 대롱처럼 늘어났다. 별 효과는 없다."

#: data\mods\Nechronica\nec_mutations.json
msgid "주르륵주르륵"
msgstr "주르륵주르륵"

#. ~ Description for 주르륵주르륵
#: data\mods\Nechronica\nec_mutations.json
msgid "혀가 질질 거리며 침을 흘리고 있다. 입에는 아무것도 착용할 수 없지만 혀로 기습 공격을 할 수 있다."
msgstr "혀가 질질 거리며 침을 흘리고 있다. 입에는 아무것도 착용할 수 없지만 혀로 기습 공격을 할 수 있다."

#: data\mods\Nechronica\nec_mutations.json
msgid "당신의 길다란 혀가 %s 에게 박혔다."
msgstr "당신의 길다란 혀가 %s에게 박혔다."

#: data\mods\Nechronica\nec_mutations.json
msgid "%1$s 의 길다란 혀가 %2$s 에게 박혔다."
msgstr "%1$s의 길다란 혀가 %2$s에게 박혔다."

#: data\mods\Nechronica\nec_mutations.json
msgid "실패작"
msgstr "실패작"

#. ~ Description for 실패작
#: data\mods\Nechronica\nec_mutations.json
msgid "여기저기 몸을 기워보고 만져봤지만 실수가 많았다. 전신에 방해도가 늘어나고 방어력이 감소한다."
msgstr "여기저기 몸을 기워보고 만져봤지만 실수가 많았다. 전신에 방해도가 늘어나고 방어력이 감소한다."

#: data\mods\Nechronica\nec_mutations.json
msgid "찢어진 피막"
msgstr "찢어진 피막"

#. ~ Description for 찢어진 피막
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"시체의 살로 된 피막, 시체 천사의 날개. 하늘을 날 수는 없지만 당신의 몸을 감싸서 보호할 수는 있다. 당신을 향하는 대부분의 공격을 "
"받아넘겨준다."
msgstr ""
"시체의 살로 된 피막, 시체 천사의 날개. 하늘을 날 수는 없지만 당신의 몸을 감싸서 보호할 수는 있다. 당신을 향하는 대부분의 공격을 "
"받아넘겨준다."

#: data\mods\Nechronica\nec_mutations.json
msgid "여분의 머리"
msgstr "여분의 머리"

#. ~ Description for 여분의 머리
#: data\mods\Nechronica\nec_mutations.json
msgid ""
"어깨에 새로운 머리가 있다. 머리의 역활을 해주는 사람은 어떻게든 잘 해주고 있다. 얼굴의 반대편은 직접 볼 수는 없지만 저 쪽이 보고 "
"느낀 것을 왠지 모르게 알게 된다. 지능 +5 지각력 +3"
msgstr ""
"어깨에 새로운 머리가 있다. 머리의 역할을 해주는 사람은 어떻게든 잘 해주고 있다. 얼굴의 반대편은 직접 볼 수는 없지만 저쪽이 보고 "
"느낀 것을 웬지 모르게 알게 된다. 지능 +5 지각력 +3"

#: data\mods\Nechronica\nec_mutations.json
msgid "반파"
msgstr "반파"

#. ~ Description for 반파
#: data\mods\Nechronica\nec_mutations.json
msgid "엉망진찬으로 기우고 만진 탓에 몸이 반쯤 무너졌다. 전신 방해도는 더 증가하고 방어력은 더 감소한다."
msgstr "엉망진찬으로 기우고 만진 탓에 몸이 반쯤 무너졌다. 전신 방해도는 더 증가하고 방어력은 더 감소한다."

#: data\mods\Nechronica\nec_mutations.json
msgid "누덕누덕"
msgstr "누덕누덕"

#. ~ Description for 누덕누덕
#: data\mods\Nechronica\nec_mutations.json
msgid "당신은 몸을 딱 좋게 기워서 개조할 수 있었다. 공격에는 조금 약해지지만 전신 방해도가 크게 감소된다."
msgstr "당신은 몸을 딱 좋게 기워서 개조할 수 있었다. 공격에는 조금 약해지지만 전신 방해도가 크게 감소된다."

#: data\mods\Nechronica\nec_professions.json
msgctxt "profession_male"
msgid "앨리스"
msgstr "앨리스"

#: data\mods\Nechronica\nec_professions.json
msgctxt "profession_female"
msgid "앨리스"
msgstr "앨리스"

#. ~ Profession (male 앨리스) description
#: data\mods\Nechronica\nec_professions.json
msgctxt "prof_desc_male"
msgid ""
"아무리 싸워도 싸움에 익숙해질 수 없는 돌도 있습니다. 싸움의 날이 몇 년 계속되더라도 그 마음은 평온한 나날에 남겨진 채입니다. 하지만"
" 그렇기 때문에, 그 아이는 계속해서 사람으로서 남을 수 있습니다."
msgstr ""
"아무리 싸워도 싸움에 익숙해질 수 없는 돌도 있습니다. 싸움의 날이 몇 년 계속되더라도 그 마음은 평온한 나날에 남겨진 채입니다. 하지만"
" 그렇기 때문에, 그 아이는 계속해서 사람으로서 남을 수 있습니다."

