#: data\mods\Jump Pad\items\jump_pad.json
msgid ""
"A tool that uses science to generate a trampoline made of energy which "
"disipates in 5 seconds.  You can use it to reach a ledge and climb up."
msgstr "과학을 사용해 5초 후 소멸하는 에너지 트램펄린을 만드는 도구입니다. 절벽 가장자리에 닿아 올라가는 데 쓸 수 있습니다."

#: data\mods\Jump Pad\items\jump_pad.json
msgid "jump pad"
msgstr "점프 패드"

#. ~ Description for jump pad
#: data\mods\Jump Pad\items\jump_pad.json
msgid "A trampoline made of energy that allows you to jump up to a ledge."
msgstr "절벽 위로 뛰어오를 수 있게 하는 에너지 트램펄린입니다."

#: data\mods\Limit Fungal Growth\modinfo.json
msgid "Limit Fungal Growth"
msgstr "곰팡이 성장 제한"

#. ~ Description for Limit Fungal Growth
#: data\mods\Limit Fungal Growth\modinfo.json
msgid "Greatly limits the exponential growth ability of fungaloids."
msgstr "곰팡이형의 기하급수적 성장 능력을 크게 제한합니다."

#: data\mods\MMA\martial.json
msgid "Scorching Sirocco"
msgid_plural "Scorching Sirocco"
msgstr[0] "불타는 시로코"

#. ~ Description for {'str_sp': 'Scorching Sirocco'}
#: data\mods\MMA\martial.json
msgid "This book contains the teaching of the Desert Wind discipline."
msgstr "사막바람 계파의 가르침이 담긴 책입니다."

#: data\mods\MMA\martial.json
msgid "Perfect Clarity of Mind and Body"
msgid_plural "Perfect Clarity of Mind and Body"
msgstr[0] "심신의 완전한 명징"

#. ~ Description for {'str_sp': 'Perfect Clarity of Mind and Body'}
#: data\mods\MMA\martial.json
msgid "This book contains the teaching of the Diamond Mind discipline."
msgstr "다이아몬드 마인드 계파의 가르침이 담긴 책입니다."

#: data\mods\MMA\martial.json
msgid "The Book of Mudora"
msgid_plural "The Book of Mudora"
msgstr[0] "무도라의 서"

#. ~ Description for {'str_sp': 'The Book of Mudora'}
#: data\mods\MMA\martial.json
msgid ""
"A collection of ancient Hylian lore and stories.  A section on historic "
"battles is bookmarked."
msgstr "고대 하일리아의 전승과 이야기 모음집입니다. 역사적 전투에 대한 부분에 책갈피가 꽂혀 있습니다."

#: data\mods\MMA\martial.json
msgid "Stormguard Warrior"
msgid_plural "Stormguard Warrior"
msgstr[0] "스톰가드 전사"

#. ~ Description for {'str_sp': 'Stormguard Warrior'}
#: data\mods\MMA\martial.json
msgid "This book contains the teaching of the Iron Heart discipline."
msgstr "무쇠심장 계파의 가르침이 담긴 책입니다."

#: data\mods\MMA\martial.json
msgid "The Life and Work of Tiger Sauer"
msgid_plural "The Life and Work of Tiger Sauer"
msgstr[0] "타이거 자우어의 생애와 작품"

#. ~ Description for {'str_sp': 'The Life and Work of Tiger Sauer'}
#: data\mods\MMA\martial.json
msgid ""
"A biography of a combat cyborg agent detailing his philosophy and martial "
"art."
msgstr "전투 사이보그 요원의 전기로, 그의 철학과 무술을 상세히 다룹니다."

#: data\mods\MMA\martial.json
msgid "Pocket Monster Encyclopedia"
msgid_plural "Pocket Monster Encyclopedia"
msgstr[0] "포켓몬스터 백과사전"

#. ~ Description for {'str_sp': 'Pocket Monster Encyclopedia'}
#: data\mods\MMA\martial.json
msgid ""
"This encyclopedia contains a detailed listing of the strengths and "
"techniques of various fictional monsters and how to apply them the in a real"
" fight."
msgstr "이 백과사전은 각종 가공의 몬스터들의 강점과 기술, 그리고 그것을 전투에 적용하는 법을 상세히 담고 있습니다."

#: data\mods\MMA\martial.json
msgid "Distant Horizon"
msgid_plural "Distant Horizon"
msgstr[0] "먼 지평선"

#. ~ Description for {'str_sp': 'Distant Horizon'}
#: data\mods\MMA\martial.json
msgid "This book contains the teaching of the Setting Sun discipline."
msgstr "석양 계파의 가르침이 담긴 책입니다."

#: data\mods\MMA\martial.json
msgid "Jedi Holocrons: Form I"
msgid_plural "Jedi Holocrons: Form I"
msgstr[0] "제다이 홀로크론: 1형"

#. ~ Description for {'str_sp': 'Jedi Holocrons: Form I'}
#: data\mods\MMA\martial.json
msgid ""
"This device contains the teachings of the first form of Jedi lightsaber "
"combat: Shii-Cho."
msgstr "이 장치에는 제다이 라이트세이버 전투의 첫 번째 형식인 시초의 가르침이 담겨 있습니다."

#: data\mods\MMA\martial.json
msgid "Shards of Granite"
msgid_plural "Shards of Granite"
msgstr[0] "화강암 파편"

#. ~ Description for {'str_sp': 'Shards of Granite'}
#: data\mods\MMA\martial.json
msgid "This book contains the teaching of the Stone Dragon discipline."
msgstr "돌의 용 계파의 가르침이 담긴 책입니다."

#: data\mods\MMA\martial.json
msgid "Reaping Talons"
msgid_plural "Reaping Talons"
msgstr[0] "수확의 발톱"

#. ~ Description for {'str_sp': 'Reaping Talons'}
#: data\mods\MMA\martial.json
msgid "This book contains the teaching of the Tiger Claw discipline."
msgstr "범의 발톱 계파의 가르침이 담긴 책입니다."

#: data\mods\MMA\martialarts.json
msgid "Desert Wind"
msgstr "사막 바람"

#. ~ Description for martial art '{'str': 'Desert Wind'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Desert Wind maneuvers focus on quick movement and swirling, flaming strikes."
"  The complex spinning and slashing of the curved blade incorporated into "
"many Desert Wind maneuvers are in fact carefully honed gestures that evoke "
"the power of fire, if performed correctly and with the proper focus."
msgstr ""
"사막 바람 학파의 기술은 빠른 움직임과 소용돌이치는 화염 타격에 중점을 둡니다. 수많은 사막 바람 기술에 녹아든 곡도의 복잡한 회전과 "
"베기는, 제대로 집중하여 올바르게 수행하면 화염의 힘을 불러내는 세심하게 다듬어진 몸짓입니다."

#. ~ Initiate message for martial art '{'str': 'Desert Wind'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You feel a wave of heat wash over you as you assume a running combat stance."
msgstr "달리기 전투 자세를 취하자 열기가 파도처럼 밀려왔다."

#. ~ Initiate message for martial art '{'str': 'Desert Wind'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s assumes into a running combat stance."
msgstr "%s(이)가 달리기 전투 자세를 취했다."

#: data\mods\MMA\martialarts.json
msgid "Wind Stride"
msgstr "바람 걸음"

#. ~ Description of buff 'Wind Stride' for martial art '{'str': 'Desert
#. Wind'}'
#: data\mods\MMA\martialarts.json
msgid ""
"A warm breeze swirls about you as you move speedily away.\n"
"\n"
"+1.0 Dodging skill.\n"
"Lasts 1 turn."
msgstr ""
"빠르게 물러나며 따뜻한 산들바람이 휘감깁니다.\n"
"\n"
"회피 기술 +1.0.\n"
"1턴 지속."

#: data\mods\MMA\martialarts.json
msgid "Zephyr Dance"
msgstr "서풍의 춤"

#. ~ Description of buff 'Zephyr Dance' for martial art '{'str': 'Desert
#. Wind'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You spin gracefully away from attacks, whirling like the dersert zephyr racing across the sands.\n"
"\n"
"+1.0 Dodging skill, +1 Dodge attempt\n"
"Lasts 1 turn."
msgstr ""
"공격을 우아하게 돌아 피하며, 모래를 가로질러 달리는 사막의 바람처럼 선회합니다.\n"
"\n"
"회피 기술 +1.0, 회피 시도 +1.\n"
"1턴 지속."

#: data\mods\MMA\martialarts.json
msgid "Diamond Mind"
msgstr "다이아몬드 마인드"

#. ~ Description for martial art '{'str': 'Diamond Mind'}'
#: data\mods\MMA\martialarts.json
msgid ""
"True quickness lies in the mind, not the body.  A student of the Diamond "
"Mind discipline seeks to hone his perceptions and discipline his thoughts so"
" that he can act in slivers of time so narrow that others cannot even "
"perceive them.  A corollary of this speed of thought and action is the "
"concept of the mind as the battleground.  An enemy defeated in his mind must"
" inevitably be defeated in truth."
msgstr ""
"진정한 민첩함은 몸이 아니라 마음에 있습니다. 다이아몬드 마인드 학파의 수련자는 남들이 인지조차 못 하는 좁은 시간의 틈에서 행동할 수 "
"있도록 지각을 갈고 생각을 단련합니다. 이 빠른 사고와 행동의 필연적 귀결은 마음 그 자체가 전장이라는 개념입니다. 마음에서 패배한 적은"
" 필연적으로 진정으로도 패배합니다."

#. ~ Initiate message for martial art '{'str': 'Diamond Mind'}'
#: data\mods\MMA\martialarts.json
msgid "You concentrate and become very still for a moment."
msgstr "집중하며 잠시 극도로 고요해졌다."

#. ~ Initiate message for martial art '{'str': 'Diamond Mind'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s becomes very still for a moment."
msgstr "%s(이)가 잠시 극도로 고요해졌다."

#: data\mods\MMA\martialarts.json
msgid "Stance of Alacrity"
msgstr "민첩의 자세"

#. ~ Description of buff 'Stance of Alacrity' for martial art '{'str':
#. 'Diamond Mind'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You move slightly faster than normal due to a combination of confidence, raining, and clarity of mind.  This slight edge adds up with each action.\n"
"\n"
"-15% move cost"
msgstr ""
"자신감과 훈련, 맑은 정신의 결합으로 평소보다 약간 빠르게 움직입니다. 이 작은 우위가 행동할 때마다 쌓입니다.\n"
"\n"
"이동 비용 -15%"

#: data\mods\MMA\martialarts.json
msgid "Pearl of Black Doubt"
msgstr "흑색 의혹의 진주"

#. ~ Description of buff 'Pearl of Black Doubt' for martial art '{'str':
#. 'Diamond Mind'}'
#: data\mods\MMA\martialarts.json
msgid ""
"With every miss, your opponents become more uncertain, their doubt growing like an irritating pearl in the mouth of a helpless oyster.\n"
"\n"
"+1 Dodge attempt\n"
"Lasts 1 turn.  Stacks 2 times"
msgstr ""
"공격이 빗나갈 때마다 상대가 점점 불안해합니다. 속수무책인 굴의 입속에서 점점 자라나는 성가신 진주처럼 의혹이 커집니다.\n"
"\n"
"회피 시도 +1.\n"
"1턴 지속. 2회 중첩."

#: data\mods\MMA\martialarts.json
msgid "Hylian Swordsmanship"
msgstr "하일리아 검술"

#. ~ Description for martial art '{'str': 'Hylian Swordsmanship'}'
#: data\mods\MMA\martialarts.json
msgid ""
"This rare form of combat has been practiced by many legendary heroes "
"throughout the ages.  Hylian Swordsmanship favors mobility for offense and "
"defense by using spins, jumps, and flips to confuse enemies and strike from "
"unexpected angles."
msgstr ""
"이 희귀한 전투술은 시대를 통틀어 수많은 전설적 영웅들이 연마해왔습니다. 하일리아 검술은 회전, 도약, 공중제비로 적을 혼란시키고 예상 "
"밖의 각도에서 타격하는, 공수 양면의 기동성을 중시합니다."

#. ~ Initiate message for martial art '{'str': 'Hylian Swordsmanship'}'
#: data\mods\MMA\martialarts.json
msgid "You begin to step lightly from side to side."
msgstr "좌우로 가볍게 발놀림하기 시작했다."

#. ~ Initiate message for martial art '{'str': 'Hylian Swordsmanship'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s begins to step lightly from side to side."
msgstr "%s(이)가 좌우로 가볍게 발놀림하기 시작했다."

#: data\mods\MMA\martialarts.json
msgid "Combat Acrobat"
msgstr "전투 곡예사"

#. ~ Description of buff 'Combat Acrobat' for martial art '{'str': 'Hylian
#. Swordsmanship'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Always stay light on your feet.  It is better to evade than be hit.\n"
"\n"
"+1.0 Dodging skill."
msgstr ""
"항상 발을 가볍게. 맞는 것보다 피하는 것이 낫습니다.\n"
"\n"
"회피 기술 +1.0."

#: data\mods\MMA\martialarts.json
msgid "Intermediate Combat Acrobat"
msgstr "중급 전투 곡예사"

#. ~ Description of buff 'Intermediate Combat Acrobat' for martial art
#. '{'str': 'Hylian Swordsmanship'}'
#: data\mods\MMA\martialarts.json
msgid ""
"After a great deal of practice, you have become even more nimble in a battle.\n"
"\n"
"+1.0 Dodging skill."
msgstr ""
"오랜 수련 끝에 전투에서 더욱 날렵해졌습니다.\n"
"\n"
"회피 기술 +1.0."

#: data\mods\MMA\martialarts.json
msgid "Master Combat Acrobat"
msgstr "달인 전투 곡예사"

#. ~ Description of buff 'Master Combat Acrobat' for martial art '{'str':
#. 'Hylian Swordsmanship'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You have seen so much combat that your dodging skills have become top notch!\n"
"\n"
"+1.0 Dodging skill."
msgstr ""
"수많은 전투를 겪어 회피 기술이 일류가 되었습니다!\n"
"\n"
"회피 기술 +1.0."

#: data\mods\MMA\martialarts.json
msgid "Dash Attack"
msgstr "돌진 공격"

#. ~ Description of buff 'Dash Attack' for martial art '{'str': 'Hylian
#. Swordsmanship'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Taking advantage of momentum, you rush towards foes to deliver a powerful strike.\n"
"\n"
"+10% damage.\n"
"Lasts 1 turn.  Stacks 3 times."
msgstr ""
"기세를 살려 적에게 돌진해 강력한 일격을 가합니다.\n"
"\n"
"피해 +10%.\n"
"1턴 지속. 3회 중첩."

#: data\mods\MMA\martialarts.json
msgid "Flurry Rush"
msgstr "연격 돌격"

#. ~ Description of buff 'Flurry Rush' for martial art '{'str': 'Hylian
#. Swordsmanship'}'
#: data\mods\MMA\martialarts.json
msgid ""
"When you perfectly dodge an attack, you can attack rapidly for a short time.\n"
"\n"
"-25% move cost.\n"
"Lasts 1 turn."
msgstr ""
"공격을 완벽히 회피하면 잠시 빠르게 공격할 수 있습니다.\n"
"\n"
"이동 비용 -25%.\n"
"1턴 지속."

#: data\mods\MMA\martialarts.json
msgid "Iron Heart"
msgstr "아이언 하트"

#. ~ Description for martial art '{'str': 'Iron Heart'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Absolute mastery of the sword is the goal of the Iron Heart discipline.  "
"Through unending practice and study, the Iron Heart adept achieves "
"superhuman skill with her weapons.  Iron Heart maneuvers are demonstrations "
"of uncanny martial skill—weaving patterns of steel that dizzy, confuse, and "
"ultimately kill with no recourse."
msgstr ""
"검의 절대적 숙달이 아이언 하트 학파의 목표입니다. 끝없는 수련과 연구를 통해 아이언 하트의 숙련자는 무기로 초인적인 솜씨를 이룹니다. "
"아이언 하트의 기술은 기이한 무술의 과시이며, 어지럽히고 혼란시키고 결국 어쩔 수 없이 죽이는 강철의 문양을 짜냅니다."

#. ~ Initiate message for martial art '{'str': 'Iron Heart'}'
#: data\mods\MMA\martialarts.json
msgid "You push away your fear and stand tall."
msgstr "두려움을 떨치고 당당히 섰다."

#. ~ Initiate message for martial art '{'str': 'Iron Heart'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s takes a bold and fearless stance."
msgstr "%s(이)가 과감하고 두려움 없는 자세를 취했다."

#: data\mods\MMA\martialarts.json
msgid "Panzer Kunst"
msgstr "판처 쿤스트"

#. ~ Description for martial art '{'str': 'Panzer Kunst'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Panzer Kunst or \"Armor Art\" is a futuristic martial art devised for "
"cyborgs fighting in zero-gravity environments."
msgstr "판처 쿤스트, 일명 \"갑주술\"은 무중력 환경에서 싸우는 사이보그를 위해 고안된 미래형 무술입니다."

#. ~ Initiate message for martial art '{'str': 'Panzer Kunst'}'
#: data\mods\MMA\martialarts.json
msgid "You adopt a panzer kunst stance."
msgstr "판처 쿤스트 자세를 취했다."

#. ~ Initiate message for martial art '{'str': 'Panzer Kunst'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s adopts a panzer kunst stance."
msgstr "%s(이)가 판처 쿤스트 자세를 취했다."

#: data\mods\MMA\martialarts.json
msgid "Schatten Folgen"
msgstr "샤텐 폴겐"

#. ~ Description of buff 'Schatten Folgen' for martial art '{'str': 'Panzer
#. Kunst'}'
#: data\mods\MMA\martialarts.json
msgid ""
"\"Shadow Tracking\"\n"
"As a künstler, you are trained to stay in your target's blind spot.\n"
"\n"
"+1 Dodge attemps, Dodge Skill increased by 12%% of Perception."
msgstr ""
"\"그림자 추적\"\n"
"퀸슬러로서 목표의 사각에 머무르는 훈련을 받았습니다.\n"
"\n"
"회피 시도 +1, 지각의 12%%만큼 회피 기술 증가."

#: data\mods\MMA\martialarts.json
msgid "Einzug Rüstungen"
msgstr "아인추크 뤼스퉁겐"

#. ~ Description of buff 'Einzug Rüstungen' for martial art '{'str': 'Panzer
#. Kunst'}'
#: data\mods\MMA\martialarts.json
msgid ""
"\"Armor Penetration\"\n"
"By attuning to the rhythm of your opponent, you can strike where their guard is the weakest.\n"
"+5 bash Armor Penetration.\n"
"Lasts 2 turns."
msgstr ""
"\"갑주 관통\"\n"
"상대의 리듬에 감응해 방어가 가장 약한 곳을 타격할 수 있습니다.\n"
"타격 갑주 관통 +5.\n"
"2턴 지속."

#: data\mods\MMA\martialarts.json
msgid "Pokken"
msgstr "포켄"

#. ~ Description for martial art '{'str': 'Pokken'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Pokken or \"Pocket Fist\" is a strange martial art developed from the famous"
" Pokemon video game series.  Somehow, a group of dedicated fans managed to "
"combine the moves used by various pokemon with multiple existing martial "
"arts such as boxing and karate.  Amazingly, it actually works.  Some might "
"even say it's a super effective way to fight."
msgstr ""
"포켄, 일명 \"포켓 펀치\"는 유명한 포켓몬 비디오 게임 시리즈에서 발전한 이색 무술입니다. 어찌 된 일인지 열성적인 팬들이 여러 "
"포켓몬의 동작을 복싱, 가라테 같은 기존 무술과 결합하는 데 성공했습니다. 놀랍게도 실제로 효과가 있습니다. 어떤 이들은 엄청난 효과를 "
"발휘하는 싸움법이라고도 합니다."

#. ~ Initiate message for martial art '{'str': 'Pokken'}'
#: data\mods\MMA\martialarts.json
msgid "You get ready to battle."
msgstr "배틀 준비를 했다."

#. ~ Initiate message for martial art '{'str': 'Pokken'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s is about to challenge someone to a battle."
msgstr "%s(이)가 누군가에게 배틀을 신청하려 한다."

#: data\mods\MMA\martialarts.json
msgid "Setting Sun"
msgstr "석양"

#. ~ Description for martial art '{'str': 'Setting Sun'}'
#: data\mods\MMA\martialarts.json
msgid ""
"The Setting Sun discipline teaches its initiates to turn their opponents' "
"strength against them.  With a quick shift in stance and carefully aimed "
"attack, a Setting Sun warrior sends a charging enemy tumbling in a new "
"direction."
msgstr ""
"석양 학파는 입문자에게 상대의 힘을 거꾸로 이용하는 법을 가르칩니다. 빠른 자세 전환과 정확히 조준한 공격으로, 석양의 전사는 돌진해오는"
" 적을 새로운 방향으로 나뒹굴게 합니다."

#. ~ Initiate message for martial art '{'str': 'Setting Sun'}'
#: data\mods\MMA\martialarts.json
msgid "You shift your weight and prepare to defend yourself."
msgstr "중심을 옮기며 방어 태세를 갖췄다."

#. ~ Initiate message for martial art '{'str': 'Setting Sun'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s shifts their weight and assumes a new stance."
msgstr "%s(이)가 중심을 옮기며 새로운 자세를 취했다."

#: data\mods\MMA\martialarts.json
msgid "Shii-Cho"
msgstr "시-초"

#. ~ Description for martial art '{'str': 'Shii-Cho'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Shii-Cho, \"The way of the Sarlacc\" was the first form lightsaber combat "
"developed by the Jedi during their transition from metal weaponry to "
"lightsabers.  Shii-Cho is regarded as a training form that all Jedi learn to"
" understand the basics of armed combat.  Shii-Cho excels at fighting against"
" groups but lacks the offensive power of the other lightsaber forms."
msgstr ""
"시-초, \"살라크의 길\"은 제다이가 금속 무기에서 라이트세이버로 넘어가는 과정에서 개발한 최초의 라이트세이버 전투 형식입니다. "
"시-초는 모든 제다이가 무장 전투의 기초를 익히기 위해 배우는 수련 형식으로 여겨집니다. 다수와의 전투에 뛰어나지만 다른 라이트세이버 "
"형식에 비해 공격력이 부족합니다."

#. ~ Initiate message for martial art '{'str': 'Shii-Cho'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You place one foot back and hold your weapon vertically on your dominant "
"side."
msgstr "한 발을 뒤로 빼고 주로 쓰는 쪽에 무기를 세워 들었다."

#. ~ Initiate message for martial art '{'str': 'Shii-Cho'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s places one foot back and hold their weapon vertically."
msgstr "%s(이)가 한 발을 뒤로 빼고 무기를 세워 들었다."

#: data\mods\MMA\martialarts.json
msgid "Determination"
msgstr "결의"

#. ~ Description of buff 'Determination' for martial art '{'str': 'Shii-Cho'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You are a determined warrior.  Your inner calm aids you in landing your strikes and protecting yourself.\n"
"\n"
"Blocked damage reduced by 100% of Strength, +1 Accuracy."
msgstr ""
"당신은 결의에 찬 전사입니다. 내적 평온이 타격 적중과 방어를 돕습니다.\n"
"\n"
"막은 피해가 힘의 100%만큼 감소, 명중 +1."

#: data\mods\MMA\martialarts.json
msgid "Apprentice Training"
msgstr "견습생 수련"

#. ~ Description of buff 'Apprentice Training' for martial art '{'str': 'Shii-
#. Cho'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Your training in Shii-Cho teaches you how to combat multiple opponents.\n"
"\n"
"+1 block attempts, +1 block effectiveness."
msgstr ""
"시-초 수련으로 다수의 상대와 싸우는 법을 익힙니다.\n"
"\n"
"막기 시도 +1, 막기 효율 +1."

#: data\mods\MMA\martialarts.json
msgid "Knight Training"
msgstr "기사 수련"

#. ~ Description of buff 'Knight Training' for martial art '{'str': 'Shii-
#. Cho'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Further training in Shii-Cho improves your ability to combat multiple opponents.\n"
"\n"
"+1 block attempts, +1 block effectiveness."
msgstr ""
"시-초의 추가 수련으로 다수의 상대와 싸우는 능력이 향상됩니다.\n"
"\n"
"막기 시도 +1, 막기 효율 +1."

#: data\mods\MMA\martialarts.json
msgid "Master Training"
msgstr "마스터 수련"

#. ~ Description of buff 'Master Training' for martial art '{'str': 'Shii-
#. Cho'}'
#: data\mods\MMA\martialarts.json
msgid ""
"As a master of Shii-Cho, your ability to fight against groups is second to none.\n"
"\n"
"+1 block attempts, +1 block effectiveness."
msgstr ""
"시-초의 달인으로서 다수와 싸우는 능력이 그 누구에게도 뒤지지 않습니다.\n"
"\n"
"막기 시도 +1, 막기 효율 +1."

#: data\mods\MMA\martialarts.json
msgid "Stone Dragon"
msgstr "스톤 드래곤"

#. ~ Description for martial art '{'str': 'Stone Dragon'}'
#: data\mods\MMA\martialarts.json
msgid ""
"The Stone Dragon discipline for focuses on strength, power, and toughness.  "
"Its teachings grant a martial adept the ability to splinter steel with a "
"single, focused blow.  Stone Dragon's defensive abilities focus on tapping "
"into the enduring power of stone to turn aside attacks."
msgstr ""
"스톤 드래곤 학파는 힘과 파괴력, 강인함에 중점을 둡니다. 그 가르침은 무술의 숙련자에게 집중된 한 번의 타격으로 강철을 쪼갤 수 있는 "
"능력을 줍니다. 스톤 드래곤의 방어 능력은 바위의 영속적인 힘을 빌어 공격을 옆으로 흘리는 데 중점을 둡니다."

#. ~ Initiate message for martial art '{'str': 'Stone Dragon'}'
#: data\mods\MMA\martialarts.json
msgid "You dig your heels into the ground and steady yourself."
msgstr "뒤꿈치를 땅에 파고들게 하며 몸을 고정했다."

#. ~ Initiate message for martial art '{'str': 'Stone Dragon'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s digs their heels into the ground."
msgstr "%s(이)가 뒤꿈치를 땅에 파고들게 했다."

#: data\mods\MMA\martialarts.json
msgid "Stone Bones"
msgstr "돌뼈"

#. ~ Description of buff 'Stone Bones' for martial art '{'str': 'Stone
#. Dragon'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You focus your energy to enhance your defenses, drawing on the power of your weapon's impact with a foe to toughen yourself against a counterattack.\n"
"\n"
"+1 bash, cut, and stab armor.\n"
"Lasts 1 turn.  Stacks 5 times."
msgstr ""
"에너지를 집중해 방어를 강화하며, 무기가 적과 부딪힌 충격의 힘을 끌어와 반격에 대비해 몸을 단단하게 만듭니다.\n"
"\n"
"타격, 베기, 찌르기 갑주 +1.\n"
"1턴 지속. 5회 중첩."

#: data\mods\MMA\martialarts.json
msgid "Stonefoot Stance"
msgstr "돌발 자세"

#. ~ Description of buff 'Stonefoot Stance' for martial art '{'str': 'Stone
#. Dragon'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You crouch and set your feet flat on the ground, drawing the resilience of the earth into your body.  However, moving too much will break your stance.\n"
"\n"
"+10% damage, +2 bash, cut, and stab armor."
msgstr ""
"웅크리고 발바닥을 땅에 붙여 대지의 강인함을 몸으로 끌어들입니다. 단, 너무 많이 움직이면 자세가 무너집니다.\n"
"\n"
"피해 +10%, 타격, 베기, 찌르기 갑주 +2."

#: data\mods\MMA\martialarts.json
msgid "Cracked Stone"
msgstr "금 간 돌"

#. ~ Description of buff 'Cracked Stone' for martial art '{'str': 'Stone
#. Dragon'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Moving too much will negate the effects of Surefoot Stance.  Stay still to avoid shattering your stance!\n"
"\n"
"Enables \"Shattered Stone\" buff.\n"
"Lasts 1 turn."
msgstr ""
"너무 많이 움직이면 돌발 자세의 효과가 무효화됩니다. 자세가 산산조각 나지 않으려면 가만히 있으세요!\n"
"\n"
"\"산산조각 돌\" 버프 활성화.\n"
"1턴 지속."

#: data\mods\MMA\martialarts.json
msgid "Stattered Stone"
msgstr "산산조각 돌"

#. ~ Description of buff 'Stattered Stone' for martial art '{'str': 'Stone
#. Dragon'}'
#: data\mods\MMA\martialarts.json
msgid ""
"You are unable to maintain your Surefoot Stance and must stop moving for a short time to regain its benefits.\n"
"\n"
"-10% damage, -2 bash, cut, and stab armor.\n"
"Lasts 4 turn."
msgstr ""
"돌발 자세를 유지할 수 없어, 효과를 되찾으려면 잠시 움직임을 멈춰야 합니다.\n"
"\n"
"피해 -10%, 타격, 베기, 찌르기 갑주 -2.\n"
"4턴 지속."

#: data\mods\MMA\martialarts.json
msgid "Tiger Claw"
msgstr "타이거 클로"

#. ~ Description for martial art '{'str': 'Tiger Claw'}'
#: data\mods\MMA\martialarts.json
msgid ""
"The Tiger Claw discipline embraces a feral rage that lurks within the heart "
"of its initiates.  In battle, such warriors growl like wild animals, attack "
"with a furry similar to that of a barbarian, and rely on overwhelming, "
"vicious assaults to defeat their enemies."
msgstr ""
"타이거 클로 학파는 입문자의 마음속에 잠복한 야수 같은 분노를 받아들입니다. 전투에서 이 전사들은 야생 동물처럼 으르렁거리고 야생인에 "
"맞먹는 맹렬함으로 공격하며, 압도적이고 잔인한 맹습에 의지해 적을 쓰러뜨립니다."

#. ~ Initiate message for martial art '{'str': 'Tiger Claw'}'
#: data\mods\MMA\martialarts.json
msgid "You emit a low growl as you prepare for battle."
msgstr "전투를 준비하며 낮게 으르렁거렸다."

#. ~ Initiate message for martial art '{'str': 'Tiger Claw'}'
#: data\mods\MMA\martialarts.json
#, c-format
msgid "%s hunkers down like a wild animal."
msgstr "%s(이)가 야생 동물처럼 몸을 움츠렸다."

#: data\mods\MMA\martialarts.json
msgid "Improved Critical"
msgstr "향상된 결정타"

#. ~ Description of buff 'Improved Critical' for martial art '{'str': 'Tiger
#. Claw'}'
#: data\mods\MMA\martialarts.json
msgid ""
"Always strike with full force.  Never hold back anything unless you want to die.\n"
"\n"
"+2 Accuracy, n+15 speed, +25% damage."
msgstr ""
"항상 전력으로 타격합니다. 죽고 싶지 않다면 절대 힘을 아끼지 마세요.\n"
"\n"
"명중 +2, 속도 +15, 피해 +25%."

#: data\mods\MMA\martialarts.json
msgid "Pounching Charge"
msgstr "덮치는 돌진"

#. ~ Description of buff 'Pounching Charge' for martial art '{'str': 'Tiger
#. Claw'}'
#: data\mods\MMA\martialarts.json
msgid ""
"With the roar of a wild beast, you throw yourself into the fray.  Strike first and strike hard.\n"
"\n"
"+2 Accuracy, +10% damage.\n"
"Lasts 1 turn."
msgstr ""
"야수의 포효와 함께 난전 속으로 몸을 던집니다. 먼저 치고, 세게 치세요.\n"
"\n"
"명중 +2, 피해 +10%.\n"
"1턴 지속."

#: data\mods\MMA\modinfo.json
msgid "Mythical Martial Arts"
msgstr "신화의 격투술"

#. ~ Description for Mythical Martial Arts
#: data\mods\MMA\modinfo.json
msgid ""
"A collection of fictional, mythologically inspired or otherwise unrealistic "
"martial arts."
msgstr "가공적이거나 신화에서 영감받은, 다소 비현실적인 격투술 모음입니다."

#: data\mods\MMA\mutations.json
msgid "Künstler"
msgstr "퀸슬러"

#. ~ Description for {'str': 'Künstler'}
#: data\mods\MMA\mutations.json
msgid ""
"You have lingering memories of training to fight cyborgs and war machines in"
" zero gravity using the obscure Panzer Kunst."
msgstr "알려지지 않은 판처 쿤스트로 무중력 속 사이보그와 전쟁기계와 싸우는 훈련의 잔여 기억이 있습니다."

#: data\mods\MMA\mutations.json
msgid "Drunken Master"
msgstr "취권 사부"

#. ~ Description for {'str': 'Drunken Master'}
#: data\mods\MMA\mutations.json
msgid ""
"The ancient arts of drunken brawling come naturally to you!  While under the"
" influence of alcohol, your melee skill will rise considerably, especially "
"unarmed combat."
msgstr ""
"고대 취권의 능력이 몸에 잠재되어 있습니다! 술을 마셨을 때 근접공격 기술이 상당히 향상되며, 특히 비무장 공격 기술이 많이 향상됩니다."

#: data\mods\MMA\mutations.json
msgid "Hero's Spirit"
msgstr "영웅의 기백"

#. ~ Description for {'str': "Hero's Spirit"}
#: data\mods\MMA\mutations.json
msgid ""
"You have studied the deeds and legends of ancient heroes.  From your "
"research, you have learned an ancient form of combat called Hylian "
"Swordsmanship."
msgstr "고대 영웅들의 업적과 전설을 연구했습니다. 그 연구로 하이리안 검술이라는 고대 전투법을 배웠습니다."

#: data\mods\MMA\mutations.json
msgid "Jedi Training"
msgstr "제다이 수련"

#. ~ Description for {'str': 'Jedi Training'}
#: data\mods\MMA\mutations.json
msgid ""
"You are trained in the ways of the Jedi.  Your knowledge allows you to "
"utilize a form of lightsaber combat."
msgstr "제다이의 길을 수련했습니다. 그 지식으로 라이트세이버 격투형을 구사할 수 있습니다."

#: data\mods\MMA\mutations.json
msgid "Pokken Master"
msgstr "포켄 마스터"

#. ~ Description for {'str': 'Pokken Master'}
#: data\mods\MMA\mutations.json
msgid ""
"You are well versed in the monsterous Pocket Fist martial art.  Train well, "
"because it is your destiny to be a master."
msgstr "괴물 같은 포켓 피스트 무술에 정통합니다. 잘 수련하세요. 마스터가 되는 것이 당신의 운명이니까요."

#: data\mods\MMA\mutations.json
msgid "Martial Adept"
msgstr "무술 적성자"

#. ~ Description for {'str': 'Martial Adept'}
#: data\mods\MMA\mutations.json
msgid ""
"You are a martial adept and learned one of the martial disciplines of the "
"Sublime Way.  You start with your choice of Desert Wind, Diamond Mind, Iron "
"Heart, Setting Sun, Stone Dragon, or Tiger Claw."
msgstr ""
"당신은 무술 적성자로 숭고한 길의 무술 유파 하나를 배웠습니다. 사막의 바람, 다이아몬드의 정신, 철의 심장, 지는 태양, 돌의 용, "
"호랑이 발톱 중 선택해 시작합니다."

#: data\mods\MMA\professions.json
msgctxt "profession_male"
msgid "Battle Angel"
msgstr "배틀 엔젤"

#: data\mods\MMA\professions.json
msgctxt "profession_female"
msgid "Battle Angel"
msgstr "배틀 엔젤"

#. ~ Profession (male Battle Angel) description
#: data\mods\MMA\professions.json
msgctxt "prof_desc_male"
msgid "A combat-ready cyborg once salvaged from an obscure junkyard…"
msgstr "외진 고물상에서 구조된 전투용 사이보그입니다…"

#. ~ Profession (female Battle Angel) description
#: data\mods\MMA\professions.json
msgctxt "prof_desc_female"
msgid "A combat-ready cyborg once salvaged from an obscure junkyard…"
msgstr "외진 고물상에서 구조된 전투용 사이보그입니다…"

#: data\mods\MMA\techniques.json
msgid "Burning Blade"
msgstr "불타는 칼날"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You unleash a fiery attack against %s"
msgstr "%s에게 화염 공격을 발했다"

#: data\mods\MMA\techniques.json
#, c-format
msgid "<npcname> unleash a fiery attack against %s"
msgstr "<npcname>(이)가 %s에게 화염 공격을 발했다"

#: data\mods\MMA\techniques.json
msgid "Inferno Blade"
msgstr "인페르노 블레이드"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You strike %s with powerful inferno"
msgstr "강력한 인페르노로 %s을(를) 쳤다"

#: data\mods\MMA\techniques.json
#, c-format
msgid "<npcname> strikes %s with powerful inferno"
msgstr "<npcname>(이)가 강력한 인페르노로 %s을(를) 쳤다"

#: data\mods\MMA\techniques.json
msgid "Firesnake"
msgstr "화염뱀"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You strike through %s with a snaking flame"
msgstr "구불거리는 화염으로 %s을(를) 꿰뚫어 쳤다"

#: data\mods\MMA\techniques.json
#, c-format
msgid "<npcname> strikes through %s with a snaking flame"
msgstr "<npcname>(이)가 구불거리는 화염으로 %s을(를) 꿰뚫어 쳤다"

#: data\mods\MMA\techniques.json
msgid "Ring of Fire"
msgstr "불의 고리"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You become a flaming blur as you strike %s and those around you"
msgstr "불꽃 잔상이 되어 %s와(과) 주변의 것들을 쳤다"

#: data\mods\MMA\techniques.json
#, c-format
msgid ""
"<npcname> becomes a flaming blur as they strike %s and those around them"
msgstr "<npcname>(이)가 불꽃 잔상이 되어 %s와(과) 주변의 것들을 쳤다"

#: data\mods\MMA\techniques.json
msgid "Flashing Sun"
msgstr "번쩍이는 태양"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You carve an arc through %s and those nearby"
msgstr "%s과(와) 주변의 것들을 호를 그으며 베었다"

#: data\mods\MMA\techniques.json
#, c-format
msgid "<npcname> carve an arc through %s and those nearby"
msgstr "<npcname>(이)가 %s과(와) 주변의 것들을 호를 그으며 베었다"

#: data\mods\MMA\techniques.json
msgid "Insightful Strike"
msgstr "통찰의 일격"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You spot %s's weakpoint and strike"
msgstr "%s의 약점을 보고 타격했다"

#: data\mods\MMA\techniques.json
#, c-format
msgid "<npcname> spot %s's weakpoint and strike"
msgstr "<npcname>(이)가 %s의 약점을 보고 타격했다"

#: data\mods\MMA\techniques.json
msgid "Greater Insightful Strike"
msgstr "상급 통찰의 일격"

#: data\mods\MMA\techniques.json
msgid "Spin Attack"
msgstr "회전 공격"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You unleash a spin attack against %s and those nearby"
msgstr "%s과(와) 주변의 것들에게 회전 공격을 발했다"

#: data\mods\MMA\techniques.json
#, c-format
msgid "<npcname> unleashes a spin attack against %s and those nearby"
msgstr "<npcname>(이)가 %s과(와) 주변의 것들에게 회전 공격을 발했다"

#: data\mods\MMA\techniques.json
msgid "Disarming Strike"
msgstr "무장해제 일격"

#: data\mods\MMA\techniques.json
#, c-format
msgid "You skillfully aim to disarm %s"
msgstr "교묘하게 %s의 무장해제를 노렸다"

#: data\mods\MMA\techniques.json
#, c-format
msgid "<npcname> skillfully aims to disarm %s"
msgstr "<npcname>(이)가 교묘하게 %s의 무장해제를 노렸다"

#: data\mods\MMA\techniques.json
msgid "Lightning Recovery"
msgstr "전광 회복"

#: data\mods\MMA\techniques.json
