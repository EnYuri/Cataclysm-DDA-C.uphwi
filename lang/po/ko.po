msgstr "파란색 페인트 한 통."

#: data\json\items\resources\home_improvement.json
msgid "cyan paint"
msgid_plural "cyan paint"
msgstr[0] "청록색 페인트"

#. ~ Description for {'str_sp': 'cyan paint'}
#: data\json\items\resources\home_improvement.json
msgid "A can of cyan paint."
msgstr "청록색 페인트 한 캔입니다."

#: data\json\items\resources\home_improvement.json
msgid "magenta paint"
msgid_plural "magenta paint"
msgstr[0] "자홍색 페인트"

#. ~ Description for {'str_sp': 'magenta paint'}
#: data\json\items\resources\home_improvement.json
msgid "A can of magenta paint."
