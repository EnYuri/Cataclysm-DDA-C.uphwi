#. ~ message when finished sawing Window with metal grate
#: data\json\furniture_and_terrain\furniture-storage.json
#: data\json\furniture_and_terrain\terrain-doors.json
#: data\json\furniture_and_terrain\terrain-fences-gates.json
#: data\json\furniture_and_terrain\terrain-walls.json
#: data\json\furniture_and_terrain\terrain-windows.json
msgid "You finish cutting the metal."
msgstr "금속 절단을 마쳤다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "wooden rack"
msgstr "나무 선반"

#. ~ Description for wooden rack
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A simple wooden rack.  Display your items on it."
msgstr "간단한 나무 선반입니다. 아이템을 그 위에 진열하세요."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "coat rack"
msgstr "코트걸이"

#. ~ Description for coat rack
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A hooked rack for hanging jackets and hats."
msgstr "재킷과 모자를 걸기 위한 고리 달린 걸이입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "recycle bin"
msgstr "재활용 쓰레기통"

#. ~ Description for recycle bin
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "Stores items for recycling."
msgstr "재활용 품목을 보관합니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "safe"
msgstr "금고"

#. ~ Description for safe
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "Holds items.  Securely."
msgstr "안전하게 물건을 보관하는 금고다."

#. ~ Description for safe
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "What needs protection like this?"
msgstr "이 정도 보호가 필요한 게 뭐가 있을까요?"

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "open safe"
msgstr "열린 금고"

#. ~ Description for open safe
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "Grab the firearms!"
msgstr "총기를 가져가세요!"

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "trash can"
msgstr "쓰레기통"

#. ~ Description for trash can
#: data\json\furniture_and_terrain\furniture-storage.json
msgid ""
"One man's trash is another man's dinner.  Examine it to take down, if you "
"need an improvised bucket."
msgstr "누군가의 쓰레기는 다른 누군가의 저녁입니다. 사제 양동이가 필요하다면 조사해서 떼어내세요."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "wardrobe"
msgstr "옷장"

#. ~ Description for wardrobe
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A tall piece of furniture - basically a freestanding closet."
msgstr "높은 가구로 — 기본적으로 독립형 옷장입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
#: data\json\mapgen\city_blocks\urban_37_office_tower_beehive.json
msgid "filing cabinet"
msgstr "사무용 수납장"

#. ~ Description for filing cabinet
#: data\json\furniture_and_terrain\furniture-storage.json
msgid ""
"A set of drawers in a sturdy metal cabinet, used to hold files.  It can be "
"locked to protect important information.  If you're lucky, there are often "
"keys nearby."
msgstr ""
"서류를 보관하는 튼튼한 금속 캐비닛의 서랍 세트입니다. 중요한 정보를 보호하기 위해 잠글 수 있습니다. 운이 좋다면 근처에 열쇠가 있을 "
"때가 많습니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "utility shelf"
msgstr "실용 선반"

#. ~ Description for utility shelf
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A simple heavy-duty plastic and metal shelving unit."
msgstr "간단한 중량용 플라스틱과 금속 선반 유닛입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "warehouse shelf"
msgstr "창고 선반"

#. ~ Description for warehouse shelf
#: data\json\furniture_and_terrain\furniture-storage.json
msgid ""
"A large, sturdy shelf made of metal for storing pallets and crates in "
"warehouses."
msgstr "창고에서 팔레트와 상자를 보관하는, 금속으로 만든 크고 튼튼한 선반입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "wooden keg"
msgstr "나무통"

#. ~ Description for wooden keg
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A keg made mostly of wood.  Holds liquids, preferably alcoholic."
msgstr "대부분 나무로 만든 통입니다. 액체를 담습니다. 가급적 알코올이요."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "display case"
msgstr "진열장"

#. ~ Description for display case
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "Display your stuff fancily and securely."
msgstr "물건을 화려하고 안전하게 진열하세요."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "You pry open the display case."
msgstr "진열장을 비틀어 열었다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "You pry, but cannot pry open the display."
msgstr "비틀어봤지만 진열장을 열 수 없었다."

#: data\json\furniture_and_terrain\furniture-storage.json
#: data\json\furniture_and_terrain\terrain-windows.json
msgid "You break the glass."
msgstr "유리를 깼다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "With a satisfying click, the display case slides open."
msgstr "기분 좋은 찰칵 소리와 함께 진열장이 밀려 열렸다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "broken display case"
msgstr "부서진 진열장"

#. ~ Description for broken display case
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "Display your stuff.  It'll get stolen."
msgstr "물건을 전시합니다. 도둑맞을 것입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "unlocked display case"
msgstr "잠금 해제된 진열장"

#. ~ Description for unlocked display case
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "Display your stuff.  Not very secure anymore, but still looks nice."
msgstr "물건을 진열하세요. 더는 그다지 안전하지는 않지만, 여전히 보기 좋습니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "standing tank"
msgstr "물탱크"

#. ~ Description for standing tank
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A large freestanding metal tank, useful for holding liquids."
msgstr "액체를 담는 데 유용한 대형 독립형 금속 탱크입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "standing tank (plumbed)"
msgstr "독립형 탱크 (배관 연결)"

#. ~ Description for standing tank (plumbed)
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A large freestanding metal tank hooked into a fluid grid."
msgstr "유체망에 연결된 대형 독립형 금속 탱크입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "clay water pots"
msgstr "점토 물단지"

#. ~ Description for clay water pots
#: data\json\furniture_and_terrain\furniture-storage.json
msgid ""
"Four large water pots together in a corner, holding up to 150 liters of a "
"single type of liquid.  It is quite fragile but can be constructed and "
"removed without tools."
msgstr ""
"한 모서리에 놓인 네 개의 큰 물단지로, 한 종류의 액체를 최대 150리터까지 담습니다. 꽤 깨지기 쉽지만 도구 없이 만들고 제거할 수 "
"있습니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "ceramic shattering!"
msgstr "도자기 깨지는 소리!"

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "dumpster"
msgstr "쓰레기 컨테이너"

#. ~ Description for dumpster
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "Stores trash.  Doesn't get picked up anymore.  Note the smell."
msgstr "쓰레기를 보관합니다. 더는 수거되지 않습니다. 냄새에 주의하세요."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "butter churn"
msgstr "버터 교유기"

#. ~ Description for butter churn
#: data\json\furniture_and_terrain\furniture-storage.json
msgid "A pedal driven butter churn."
msgstr "페달로 구동하는 버터 교유기입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "atomic butter churn on a stand"
msgstr "거치된 원자력 버터 교유기"

#. ~ Description for atomic butter churn on a stand
#: data\json\furniture_and_terrain\furniture-storage.json
msgid ""
"The Rivtech Atomic Butter Churn in deployed state.  It hums menacingly.  "
"Ready to add raw milk and salt.  It will churn till the earth is a cinder."
msgstr ""
"전개 상태의 리브텍 원자력 버터 교유기입니다. 위협적으로 윙윙거립니다. 생우유와 소금을 넣을 준비가 되었습니다. 지구가 재가 될 때까지 "
"휘저을 것입니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "metal foot locker"
msgstr "금속 풋로커"

#. ~ Description for metal foot locker
#: data\json\furniture_and_terrain\furniture-storage.json
msgid ""
"A metal storage box, capable of holding any number of things.  The lid has "
"has a small lock."
msgstr "무엇이든 담을 수 있는 금속 보관함입니다. 뚜껑에 작은 자물쇠가 있습니다."

#: data\json\furniture_and_terrain\furniture-storage.json
msgid "wooden chest"
msgstr "나무 상자"

#. ~ Description for wooden chest
#: data\json\furniture_and_terrain\furniture-storage.json
msgid ""
"A nice big wooden box with a hinged lid, to store all manner of things in."
msgstr "온갖 물건을 넣어둘 수 있는, 경첩 달린 뚜껑이 있는 크고 좋은 나무 상자입니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "counter"
msgstr "계산대"

#. ~ Description for counter
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Affixed to the wall or found in kitchens or stores."
msgstr "벽에 고정되어 있거나 주방이나 가게에서 발견됩니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "cupboard"
msgstr "찬장"

#. ~ Description for cupboard
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Store your cups."
msgstr "컵을 보관합니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "closed counter gate"
msgstr "닫힌 카운터 출입문"

#. ~ Description for closed counter gate
#. ~ Description for open counter gate
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"A commercial quality swinging door made of wood that allows passage behind "
"counters."
msgstr "카운터 뒤로 통행할 수 있게 하는, 상업용 품질의 나무 여닫이 문입니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "open counter gate"
msgstr "열린 카운터 출입문"

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "desk"
msgstr "책상"

#. ~ Description for desk
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Sit down at it or work on it."
msgstr "그 앞에 앉거나 위에서 작업하세요."

#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\items\vehicle\tables.json data\json\vehicleparts\crafting.json
msgid "workbench"
msgid_plural "workbenches"
msgstr[0] "작업대"

#. ~ Description for workbench
#. ~ Description for {'str': 'workbench', 'str_pl': 'workbenches'}
#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\items\vehicle\tables.json
msgid ""
"A sturdy workbench built out of metal.  It is perfect for crafting large and"
" heavy things."
msgstr "금속으로 만들어진 튼튼한 작업대입니다. 크고 무거운 물건을 제작하기에 완벽합니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "survivor workbench"
msgstr "생존자 작업대"

#. ~ Description for survivor workbench
#. ~ Description for {'str': 'survivors workbench', 'str_pl': 'survivors
#. workbenches'}
#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\items\vehicle\tables.json
msgid ""
"A sturdy workbench built out of metal.  It is perfect for crafting large and"
" heavy things.  This one contains a few extra tools and supplies, making it "
"more useful than a standard workbench."
msgstr ""
"금속으로 만들어진 튼튼한 작업대입니다. 크고 무거운 물건을 제작하기에 완벽합니다. 이것에는 추가 도구와 소모품이 들어 있어 일반 "
"작업대보다 유용합니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "robotic workbench"
msgstr "로봇 작업대"

#. ~ Description for robotic workbench
#. ~ Description for {'str': 'robobench', 'str_pl': 'robobenches'}
#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\items\vehicle\tables.json
msgid ""
"Having upgraded the basic workbench, you've now created a robotic workbench "
"that helps speed up crafting."
msgstr "기본 작업대를 업그레이드해, 제작 속도를 높여주는 로봇 작업대를 만들었습니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\items\tool\deployable.json
msgid "leather tarp"
msgid_plural "leather tarps"
msgstr[0] "가죽 방수포"

#. ~ Description for leather tarp
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"A large sheet of sewn leather that can be used instead of a picnic blanket, "
"but it's more valuable as a butchery appliance as it does not soak in blood."
msgstr "피크닉 담요 대신 사용할 수 있는 큰 가죽 시트이지만, 피를 흡수하지 않아 도축 도구로 더 유용합니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "plastic groundsheet"
msgstr "플라스틱 지면 시트"

#. ~ Description for plastic groundsheet
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"A large sheet of thick plastic has been tossed on the ground here.  It would"
" be a useful place to do some butchery, perhaps."
msgstr "두꺼운 플라스틱 큰 시트가 여기 지면에 놓여 있습니다. 아마도 도축 작업을 하기에 유용한 장소일 겁니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "whuff!"
msgstr "푹!"

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "crinkle."
msgstr "바스락."

#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\items\tool\deployable.json
msgid "fiber mat"
msgid_plural "fiber mats"
msgstr[0] "섬유 매트"

#. ~ Description for fiber mat
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"A large mat woven from fibrous material that can be used instead of a picnic"
" blanket, but it's more valuable as a butchery appliance.  Too thin to be a "
"comfortable sleeping place."
msgstr ""
"피크닉 담요 대신 사용할 수 있는 섬유질 재료로 짠 큰 매트이지만, 도축 도구로 더 유용합니다. 편안하게 잠을 자기에는 너무 얇습니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\items\tool\deployable.json
msgid "tourist table"
msgid_plural "tourist tables"
msgstr[0] "관광용 테이블"

#. ~ Description for tourist table
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"Small metal folding table, ideal for off-road trips into the wild.  Can be "
"used as a workbench in a pinch, or tipped over to create a more solid "
"obstacle."
msgstr ""
"야외 오프로드 여행에 이상적인 작은 금속 접이식 테이블입니다. 급할 때는 작업대로 쓸 수 있고, 넘어뜨려 더 견고한 장애물을 만들 수도 "
"있습니다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Flip tourist table"
msgstr "캠핑 테이블 뒤집기"

#. ~ Message for furniture 'tourist table'
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "You knock the tourist table onto its side."
msgstr "캠핑 테이블을 옆으로 넘어뜨렸다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "flipped tourist table"
msgstr "뒤집힌 캠핑 테이블"

#. ~ Description for flipped tourist table
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"This little metal table looks like a bear's had lunch off it.  Examine it to"
" set it back upright to be less of a tripping hazard."
msgstr "이 작은 금속 테이블은 곰이 점심을 먹은 것처럼 보입니다. 조사해서 다시 세워 걸려 넘어질 위험을 줄이세요."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Set tourist table upright"
msgstr "캠핑 테이블 바로 세우기"

#. ~ Message for furniture 'flipped tourist table'
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "You set the tourist table back upright."
msgstr "캠핑 테이블을 다시 바로 세웠다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
#: data\json\vehicleparts\furniture.json
msgid "table"
msgstr "탁자"

#. ~ Description for table
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"Sit down when you eat!  Examine to flip it on its side if you're feeling "
"angry, or want a barricade in a hurry."
msgstr "먹을 때는 앉으세요! 화가 나거나 급히 바리케이드가 필요하면 조사해서 옆으로 뒤집으세요."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Flip table"
msgstr "테이블 뒤집기"

#. ~ Message for furniture 'table'
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "You flip the table onto its side."
msgstr "테이블을 옆으로 뒤집었다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "flipped table"
msgstr "뒤집힌 테이블"

#. ~ Description for flipped table
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"Not so good for eating on, but will buy you a few more seconds before the "
"zombies eat you.  Examine to set it back up for more civilized uses."
msgstr "그 위에서 먹기엔 별로지만, 좀비가 당신을 먹기 전 몇 초를 벌어줍니다. 조사해서 문명화된 용도로 다시 세우세요."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Set table upright"
msgstr "테이블 바로 세우기"

#. ~ Message for furniture 'flipped table'
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "You set the table back on its feet."
msgstr "테이블을 다시 발 위로 세웠다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "coffee table"
msgstr "커피 테이블"

#. ~ Description for coffee table
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid ""
"a low table for livingrooms.  Examine it to tip it onto its side, to slow "
"down the horde in a pinch."
msgstr "거실용 낮은 테이블입니다. 조사해서 옆으로 넘어뜨려 급할 때 무리를 지연시키세요."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Flip coffee table"
msgstr "커피 테이블 뒤집기"

#. ~ Message for furniture 'coffee table'
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "You kick the coffee table onto its side."
msgstr "커피 테이블을 발로 차서 옆으로 넘어뜨렸다."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "flipped coffee table"
msgstr "뒤집힌 커피 테이블"

#. ~ Description for flipped coffee table
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "a low table knocked onto its side.  Examine to upright it."
msgstr "옆으로 넘어진 낮은 테이블입니다. 조사해서 세우세요."

#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "Set coffee table upright"
msgstr "커피 테이블 바로 세우기"

#. ~ Message for furniture 'flipped coffee table'
#: data\json\furniture_and_terrain\furniture-surfaces.json
msgid "You tip the coffee table back onto its feet."
msgstr "커피 테이블을 다시 발 위로 세웠다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "tatami mat"
msgstr "다다미"

#. ~ Description for tatami mat
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A tatami is a type of mat used as a flooring material in traditional "
"Japanese-style rooms."
msgstr "다다미는 전통 일본식 방에서 바닥재로 쓰이는 일종의 매트입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "pillow fort"
msgstr "베개 요새"

#. ~ Description for pillow fort
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "A comfy place to hide from the world.  Not very defensible, though."
msgstr "세상으로부터 숨을 수 있는 아늑한 장소입니다. 다만 방어는 잘 안 됩니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "paf!"
msgstr "팍!"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "cardboard fort"
msgstr "골판지 요새"

#. ~ Description for cardboard fort
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A fort built by tipping a cardboard box on its side, lining it with "
"blankets, and partly weather sealing it with a plastic sheet."
msgstr "골판지 상자를 옆으로 눕히고 담요를 깔고, 부분적으로 플라스틱 시트로 방풍 처리해 지은 요새입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "cardboard wall"
msgstr "골판지 벽"

#. ~ Description for cardboard wall
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"This is a pile of cardboard boxes that have been filled with rags and junk "
"and stacked together like bricks to form a wall."
msgstr "헝겊과 잡동사니로 채워진 골판지 상자를 벽돌처럼 쌓아 올려 만든 벽입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "cardboard floor"
msgstr "골판지 바닥"

#. ~ Description for cardboard floor
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A flat floor made of sheets of cardboard duct-taped together overtop a "
"plastic sheet."
msgstr "플라스틱 시트 위에 골판지 조각을 덕트 테이프로 붙여 만든 평평한 바닥입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "cardboard roof"
msgstr "골판지 지붕"

#. ~ Description for cardboard roof
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A sloped roof made of cardboard boxes, stuffed with scrap cardboard and "
"paper and layered atop each other.  Sheets of plastic are carefully arrayed "
"on top to shed water.  It looks like it could last a season or two at least "
"before crumbling."
msgstr ""
"골판지 상자로 만든 경사 지붕으로, 고철 골판지와 종이로 채워지고 겹쳐 있습니다. 물을 흘려보내도록 플라스틱 시트가 위에 조심스럽게 "
"배열되어 있습니다. 무너지기 전에 적어도 한두 계절은 버틸 수 있을 것 같습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "cardboard door"
msgstr "골판지 문"

#. ~ Description for cardboard door
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"This is a pile of cardboard boxes that have been filled with rags and junk "
"and stacked together like bricks to form a wall.  The largest box has been "
"cut open and folded to form a makeshift door, which is open."
msgstr ""
"헝겊과 잡동사니로 채워진 골판지 상자를 벽돌처럼 쌓아 올려 만든 벽입니다. 가장 큰 상자가 잘려 접혀 사제 문이 되었으며, 열려 "
"있습니다."

#. ~ Description for cardboard door
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"This is a pile of cardboard boxes that have been filled with rags and junk "
"and stacked together like bricks to form a wall.  The largest box has been "
"cut open and folded to form a makeshift door, which is closed."
msgstr ""
"헝겊과 잡동사니로 채워진 골판지 상자를 벽돌처럼 쌓아 올려 만든 벽입니다. 가장 큰 상자가 잘려 접혀 사제 문이 되었으며, 닫혀 "
"있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "beaded curtain"
msgstr "구슬 커튼"

#. ~ Description for beaded curtain
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This beaded curtain could be pulled aside."
msgstr "이 구슬 커튼은 옆으로 젖힐 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "clickity clack… clack… clack"
msgstr "찰랑… 찰랑… 찰랑"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "clickity clack… clack"
msgstr "찰랑… 찰랑"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "open beaded curtain"
msgstr "열린 구슬 커튼"

#. ~ Description for open beaded curtain
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This beaded curtain has been pulled aside."
msgstr "이 구슬 커튼은 옆으로 젖혀져 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "clickity clack… clack… clack!"
msgstr "찰랑… 찰랑… 찰랑!"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "canvas floor"
msgstr "캔버스 바닥"

#. ~ Description for canvas floor
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Flooring made out of stretched, waterproof cloth.  Helps keep the dirt out "
"of the tent."
msgstr "늘인 방수 천으로 만든 바닥입니다. 천막에 흙이 들어오는 것을 막아줍니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "skylight canvas floor"
msgstr "채광창 캔버스 바닥"

#. ~ Description for skylight canvas floor
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Flooring made out of stretched, waterproof cloth.  Helps keep the dirt out "
"of the tent. Has a plastic skylight to let light"
msgstr "늘인 방수 천으로 만든 바닥입니다. 천막에 흙이 들어오는 것을 막아줍니다. 빛을 들이는 플라스틱 채광창이 있습니다"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "canvas wall"
msgstr "캔버스 벽"

#. ~ Description for canvas wall
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A wall made of stretched, waterproof cloth and supported by wooden or metal "
"stakes."
msgstr "늘인 방수 천으로 만들고 나무나 금속 말뚝으로 지탱한 벽입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
#: data\json\furniture_and_terrain\terrain-doors.json
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-roofs.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "slap!"
msgstr "찰싹!"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "heavy-duty canvas wall"
msgstr "중량용 캔버스 벽"

#. ~ Description for heavy-duty canvas wall
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A wall made of stretched, waterproof cloth and supported by wooden or metal "
"stakes. It has been strenghtened with plastic sheets."
msgstr "늘인 방수 천으로 만들고 나무나 금속 말뚝으로 지탱한 벽입니다. 플라스틱 시트로 보강되었습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "canvas flap"
msgstr "캔버스 덮개"

#. ~ Description for canvas flap
#. ~ Description for heavy-duty canvas flap
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"This canvas flap door could be pulled aside. If you examine it closely, you "
"could peek outside."
msgstr "이 캔버스 덮개 문은 옆으로 젖힐 수 있습니다. 가까이 조사하면 밖을 엿볼 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "open canvas flap"
msgstr "열린 캔버스 덮개"

#. ~ Description for open canvas flap
#. ~ Description for open heavy-duty canvas flap
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This canvas flap door has been pulled aside."
msgstr "이 캔버스 덮개 문은 옆으로 젖혀져 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "heavy-duty canvas flap"
msgstr "중량용 캔버스 덮개"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "open heavy-duty canvas flap"
msgstr "열린 중량용 캔버스 덮개"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "groundsheet"
msgstr "방수포"

#. ~ Description for groundsheet
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This plastic groundsheet could keep you dry."
msgstr "이 플라스틱 지면 시트는 당신을 건조하게 유지해줄 수 있습니다."

#. ~ Description for groundsheet
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This large plastic groundsheet could keep you dry."
msgstr "이 큰 플라스틱 지면 시트는 당신을 건조하게 유지해줄 수 있습니다."

#. ~ Description for groundsheet
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"This plastic government-issue groundsheet could keep you dry, but was made "
"by the lowest bidder."
msgstr "이 플라스틱 정부 지급 지면 시트는 당신을 건조하게 유지해줄 수 있지만, 최저가 입찰자가 만들었습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "animalskin wall"
msgstr "짐승가죽 벽"

#. ~ Description for animalskin wall
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Wall made out of animal skin.  Either an amazing or horrifying sight."
msgstr "동물 가죽으로 만든 벽입니다. 놀랍거나 끔찍한 광경입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "animalskin flap"
msgstr "짐승가죽 덮개"

#. ~ Description for animalskin flap
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This animal skin flap could be pulled aside."
msgstr "이 동물 가죽 덮개는 옆으로 젖힐 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "open animalskin flap"
msgstr "열린 짐승가죽 덮개"

#. ~ Description for open animalskin flap
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This animal skin flap has been pulled aside."
msgstr "이 동물 가죽 덮개는 옆으로 젖혀져 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "animalskin floor"
msgstr "짐승가죽 바닥"

#. ~ Description for animalskin floor
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "This animal skin groundsheet could keep you dry."
msgstr "이 동물 가죽 지면 시트는 당신을 건조하게 유지해줄 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "pile of rubble"
msgstr "깨진 돌무더기"

#. ~ Description for pile of rubble
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Pile of various metals, bricks, and other building materials.  You could "
"clear it with a shovel."
msgstr "각종 금속, 벽돌 및 기타 건축 자재 더미입니다. 삽으로 치울 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "pile of rocky rubble"
msgstr "깨진 바위더미"

#. ~ Description for pile of rocky rubble
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Pile of rocks.  Useless?"
msgstr "돌 더미입니다. 쓸모없나요?"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "pile of trashy rubble"
msgstr "쓰레기 잔해 더미"

#. ~ Description for pile of trashy rubble
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Trash topped with dirt and grass, it smells gross, but another man's trash…"
msgstr "흙과 풀이 얹힌 쓰레기로, 역겨운 냄새가 나지만, 누군가에겐 보물일 수도…"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "pile of floating trash"
msgstr "떠 있는 쓰레기 더미"

#. ~ Description for pile of floating trash
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Trash floating in the water. I guess it really does all end up here..."
msgstr "물에 떠 있는 쓰레기입니다. 결국 전부 여기로 흘러오는 모양입니다..."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "metal wreckage"
msgstr "금속 잔해"

#. ~ Description for metal wreckage
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Pile of various bent and twisted metals."
msgstr "구부러지고 뒤틀린 각종 금속 더미입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "pile of ash"
msgstr "잿더미"

#. ~ Description for pile of ash
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Some ash, from wood or possibly bodies."
msgstr "나무 또는 아마도 시체에서 나온 재입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "small boulder"
msgstr "작은 바위"

#. ~ Description for small boulder
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Blocking your path.  Should be easy to move.  It can be used as a primitive "
"anvil."
msgstr "길을 막고 있습니다. 쉽게 옮길 수 있을 것입니다. 원시적인 모루로 사용할 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "upturned small boulder"
msgstr "뒤집힌 작은 바위"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "medium boulder"
msgstr "중간 크기의 바위"

#. ~ Description for medium boulder
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Blocking your path.  It'll be a struggle to move.  It can be used as a "
"primitive anvil."
msgstr "길을 막고 있습니다. 옮기기 힘들 것입니다. 원시적인 모루로 사용할 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "large boulder"
msgstr "큰 바위"

#. ~ Description for large boulder
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Now how are you going to move this?"
msgstr "이것을 어떻게 옮길 생각입니까?"

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "street light"
msgstr "가로등"

#. ~ Description for street light
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Raised source of light which used to illuminate streets and their "
"surrounding area, but it's useless without electricity."
msgstr "거리와 주변을 비추던 높은 광원이지만, 전기 없이는 쓸모없습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "traffic light"
msgstr "신호등"

#. ~ Description for traffic light
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"Signaling device positioned at road intersections and pedestrian crossings "
"to control flows of traffic, but it's useless without electricity."
msgstr "도로 교차로와 횡단보도에서 교통 흐름을 통제하던 신호 장치이지만, 전기 없이는 쓸모없습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "utility pole"
msgstr "전신주"

#. ~ Description for utility pole
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A long wooden post which used to support overhead power lines and other "
"public utilities, but it doesn't work anymore."
msgstr "가공 전선과 기타 공공설비를 지탱하던 긴 나무 기둥이지만, 더는 작동하지 않습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "concrete lump"
msgstr "콘크리트 덩어리"

#. ~ Description for concrete lump
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"The result of you pouring concrete over mi-go gas emitters.  It's stuck to "
"the floor.  It can be used as a primitive anvil."
msgstr "미고의 가스 방출구 위에 콘크리트를 부은 결과물입니다. 바닥에 붙어 있습니다. 원시적인 모루로 쓸 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "flagpole"
msgstr "깃대"

#. ~ Description for flagpole
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"An old metal flagpole, with no flag to fly.  Don't lick it if it's cold out."
msgstr "게양할 깃발이 없는 오래된 금속 깃대입니다. 추운 날 핥지 마세요."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "flagpole with American flag"
msgstr "성조기 달린 깃대"

#. ~ Description for flagpole with American flag
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"An old metal flagpole flying an American flag.  A leftover from before the "
"world ended, you could take it down if you need one for some reason."
msgstr "성조기를 게양한 오래된 금속 깃대입니다. 세계가 끝나기 전의 잔재로, 어떤 이유로 필요하다면 내릴 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "wooden flagpole"
msgstr "나무 깃대"

#. ~ Description for wooden flagpole
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "A makeshift flagpole constructed from a wooden beam and rope."
msgstr "나무 들보와 밧줄로 만든 사제 깃대입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "wooden flagpole with American flag"
msgstr "성조기 달린 나무 깃대"

#. ~ Description for wooden flagpole with American flag
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Someone's hoisted an old American flag from this makeshift flagpole."
msgstr "누군가 이 사제 깃대에 낡은 성조기를 게양했습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "flagpole with Jolly Roger"
msgstr "해적기 달린 깃대"

#. ~ Description for flagpole with Jolly Roger
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "An old metal flagpole, now flying a black pirate flag."
msgstr "이제 검은 해적기를 게양한 오래된 금속 깃대입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "wooden flagpole with Jolly Roger"
msgstr "해적기 달린 나무 깃대"

#. ~ Description for wooden flagpole with Jolly Roger
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "Someone's hoisted a black pirate flag from this makeshift flagpole."
msgstr "누군가 이 사제 깃대에 검은 해적기를 게양했습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "room divider"
msgstr "칸막이"

#. ~ Description for room divider
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "A tall piece of furniture used to divide rooms into separate areas."
msgstr "방을 별도 구역으로 나누는 데 쓰이는 높은 가구입니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
#: data\json\obsoletion\uncategorized.json
msgid "tarp lean-to"
msgstr "방수포 피난처"

#. ~ Description for tarp lean-to
#: data\json\furniture_and_terrain\furniture-terrains.json
#: data\json\obsoletion\uncategorized.json
msgid ""
"A small shelter covered by waterproof tarp, that can be used to take refuge "
"from the elements."
msgstr "방수 타프로 덮인 작은 대피소로, 자연 요소로부터 피난하는 데 쓸 수 있습니다."

#: data\json\furniture_and_terrain\furniture-terrains.json
msgid "leather tarp lean-to"
msgstr "가죽 타프 린투"

#. ~ Description for leather tarp lean-to
#: data\json\furniture_and_terrain\furniture-terrains.json
msgid ""
"A makeshift shelter made from a lather tarp and stakes driven into the "
"ground."
msgstr "가죽 타프와 땅에 박은 말뚝으로 만든 사제 대피소입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "broken console"
msgstr "고장난 콘솔"

#. ~ Description for broken console
#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a standalone computer terminal.  It doesn't seem to be working.  "
"It's the broken screen and shattered circuit boards that's telling you that."
msgstr "독립형 컴퓨터 단말기입니다. 작동하는 것 같지 않습니다. 깨진 화면과 산산조각 난 회로 기판이 그걸 알려줍니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "computer console"
msgstr "컴퓨터 콘솔"

#. ~ Description for computer console
#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a standalone computer terminal.  It can be used to view contents and"
" perform any allowed functions.  It might even be possible to hack it, given"
" the skills."
msgstr ""
"독립형 컴퓨터 단말기입니다. 내용물을 보고 허용된 기능을 수행하는 데 쓸 수 있습니다. 기술이 있다면 해킹도 가능할지 모릅니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\fake.json
msgid "artifact analyzer console"
msgid_plural "artifact analyzer consoles"
msgstr[0] "아티팩트 분석 콘솔"

#. ~ Description for artifact analyzer console
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A research console configured to analyze artifacts.  Use it to scan any "
"artifacts you are carrying."
msgstr "아티팩트를 분석하도록 설정된 연구용 콘솔입니다. 소지한 아티팩트를 스캔하는 데 사용하세요."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "forge"
msgstr "단조 화로"

#. ~ Description for forge
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "Metalworking station typically used in combination with an anvil."
msgstr "일반적으로 모루와 함께 사용되는 금속 가공 작업대입니다."

#. ~ Description for anvil
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "Used in metalworking."
msgstr "금속 가공에 사용됩니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\cooking.json
msgid "still"
msgid_plural "stills"
msgstr[0] "증류기"

#. ~ Description for still
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"An essential component for brewing and chemistry that allows for refining "
"liquid mixtures."
msgstr "액체 혼합물을 정제할 수 있는 양조 및 화학에 필수적인 구성 요소입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\metalworking.json
msgid "charcoal kiln"
msgid_plural "charcoal kilns"
msgstr[0] "목탄 가마"

#. ~ Description for charcoal kiln
#. ~ Description for filled charcoal kiln
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A rock kiln designed to burn wood and organic material into charcoal in "
"absence of oxygen."
msgstr "산소가 없는 상태에서 나무와 유기물을 숯으로 태우도록 설계된 암석 가마입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\metalworking.json
msgid "filled charcoal kiln"
msgid_plural "filled charcoal kilns"
msgstr[0] "목탄 가마 (가득참)"

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\deployable.json
msgid "metal charcoal kiln"
msgid_plural "metal charcoal kilns"
msgstr[0] "금속 목탄 가마"

#. ~ Description for metal charcoal kiln
#. ~ Description for filled metal charcoal kiln
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A metal kiln designed to burn wood and organic material into charcoal in "
"absence of oxygen."
msgstr "산소가 없는 상태에서 나무와 유기물을 숯으로 태우도록 설계된 금속 가마입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "filled metal charcoal kiln"
msgstr "금속 목탄 가마-가득참"

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\fake.json
msgid "arc furnace"
msgid_plural "arc furnaces"
msgstr[0] "아크 용광로"

#. ~ Description for arc furnace
#. ~ Description for filled arc furnace
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"An arc furnace designed to burn a powdery mix of coke and limestone to "
"create calcium carbide."
msgstr "코크스와 석회석의 가루 혼합물을 태워 탄화칼슘을 만들도록 설계된 아크 용광로입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "filled arc furnace"
msgstr "채워진 아크 용광로"

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "smoking rack"
msgstr "훈제 선반"

#. ~ Description for smoking rack
#. ~ Description for metal smoking rack
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste.  "
"Works as a charcoal smoker in crafting recipes."
msgstr "보존성과 맛을 높이기 위해 음식을 훈제하도록 설계된 특별한 선반입니다. 제작 레시피에서 목탄 훈제기로 작동합니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "active smoking rack"
msgstr "작동 중인 훈제 선반"

#. ~ Description for active smoking rack
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste.  It"
" is lit and smoking."
msgstr "더 나은 보존과 맛을 위해 음식을 훈제하도록 설계된 특수 선반입니다. 불이 켜지고 연기가 나고 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\deployable.json
msgid "metal smoking rack"
msgid_plural "metal smoking racks"
msgstr[0] "금속 훈제 선반"

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "active metal smoking rack"
msgstr "작동 중인 금속 훈제 선반"

#. ~ Description for active metal smoking rack
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A special rack designed to smoke food for better preservation and taste."
msgstr "더 나은 보존과 맛을 위해 음식을 훈제하도록 설계된 특수 선반입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "rock forge"
msgstr "석재 단조 화로"

#. ~ Description for rock forge
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"Metalworking station made of rock, typically used in combination with an "
"anvil.  Works as a charcoal forge in crafting recipes."
msgstr "돌로 만든 금속 세공대로, 보통 모루와 함께 사용됩니다. 제작 레시피에서 목탄 화로로 작동합니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "clay kiln"
msgstr "점토 가마"

#. ~ Description for clay kiln
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "A kiln designed to bake clay pottery and bricks."
msgstr "점토 도자기와 벽돌을 굽도록 설계된 가마입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "charcoal purifier"
msgstr "숯 정수기"

#. ~ Description for charcoal purifier
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A makeshift filter constructed to hold a supply of charcoal, for purifying "
"water."
msgstr "물을 정수하기 위해 목탄을 담아두도록 만든 사제 필터입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\misc.json
msgid "stepladder"
msgid_plural "stepladders"
msgstr[0] "발판 사다리"

#. ~ Description for stepladder
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A short, foldable ladder.  Can help you climb to a rooftop, or maybe slow "
"something down."
msgstr "짧은 접이식 사다리입니다. 옥상에 오르는 데 도움이 되거나, 무언가를 지연시킬 수도 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "electric arc furnace"
msgstr "전기 아크 용광로"

#. ~ Description for electric arc furnace
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"Not the kind of furnace you'd heat your house with, this is a device for "
"heating things to extreme temperatures as part of industrial fabrication "
"processes."
msgstr "집을 난방하는 종류의 화로가 아니라, 산업 제조 공정의 일환으로 물건을 극한 온도까지 가열하는 장치입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "drill press"
msgstr "드릴 프레스"

#. ~ Description for drill press
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A powerful drill mounted on a slide that lets it drop precisely down.  "
"Useful in all kinds of projects from industrial fabrication to home "
"woodworking."
msgstr ""
"정확하게 아래로 내려갈 수 있게 슬라이드에 장착된 강력한 드릴입니다. 산업 제조부터 가정 목공까지 온갖 프로젝트에 유용합니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "tablesaw"
msgstr "테이블톱"

#. ~ Description for tablesaw
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A rotating saw blade set into a large flat table, for making straight "
"measured cuts.  One of the key tools in a carpenter's arsenal."
msgstr "직선으로 재어 자르기 위해 커다란 평평한 테이블에 박힌 회전 톱날입니다. 목수 무기고의 핵심 도구 중 하나입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "mitre saw"
msgstr "마이터쏘"

#. ~ Description for mitre saw
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A circular saw blade on an arm that can slide and rotate in several "
"directions, this is a staple tool for nearly any carpentry."
msgstr "여러 방향으로 미끄러지고 회전할 수 있는 팔 위의 원형 톱날로, 거의 모든 목공 작업의 기본 도구입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "bandsaw"
msgstr "밴드쏘"

#. ~ Description for bandsaw
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A ribbonlike sawblade runs in a single direction in this tool, allowing "
"precise cuts at almost any angle."
msgstr "리본 같은 톱날이 이 도구에서 한 방향으로 돌며, 거의 모든 각도에서 정밀한 절단을 가능하게 합니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "router table"
msgstr "라우터 테이블"

#. ~ Description for router table
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"This table has an inset router, a rotating motor with an exchangeable blade "
"head for cutting specific profiles and grooves and stuff."
msgstr "이 테이블에는 라우터가 박혀 있습니다. 특정 단면과 홈 등을 깎기 위한 교체형 날 머리가 달린 회전 모터입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "planer"
msgstr "전동 대패"

#. ~ Description for planer
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A hefty tool that will take in a board and cut it smooth and flat to a "
"specific width.  Particularly great if working with raw lumber stock, but "
"also good just for shaving wood down to size."
msgstr ""
"판재를 넣어 특정 두께로 매끄럽고 평평하게 깎아주는 묵직한 도구입니다. 생목재를 다룰 때 특히 훌륭하지만, 그냥 나무를 치수에 맞게 깎는"
" 데도 좋습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "jointer"
msgstr "조인터"

#. ~ Description for jointer
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A table-shaped tool with a rotating blade that will cut down, smooth out, "
"and square off a board to make it very smooth and nice indeed."
msgstr "판재를 깎아내리고 매끄럽게 다듬고 직각으로 만들어 정말 매끄럽고 좋게 해주는, 회전 날이 달린 테이블 모양 도구입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "power lathe"
msgstr "동력 선반"

#. ~ Description for power lathe
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"An industrial-grade lathe, for turning chunks of metal and other hard things"
" into round chunks of metal and other hard things.  Power it back up and it "
"could be used to practice Fabrication."
msgstr ""
"금속 덩어리와 다른 단단한 것들을 둥근 금속 덩어리와 다른 단단한 것들로 바꾸는 산업용 선반입니다. 전원을 다시 공급하면 제작 기술 "
"연습에 쓸 수 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "industrial laser cutter"
msgstr "산업용 레이저 절단기"

#. ~ Description for industrial laser cutter
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A large box of tinted glass, with a robotic arm inside.  Before the "
"cataclysm, it used to cut and etch sheet metal with a high-powered laser.  "
"Now, it's better suited for scrap parts."
msgstr ""
"안에 로봇 팔이 있는, 착색 유리로 된 큰 상자입니다. 대재앙 전에는 고출력 레이저로 판금을 절단하고 에칭했습니다. 지금은 고철 "
"부품용으로 더 적합합니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "air compressor"
msgstr "공기 압축기"

#. ~ Description for air compressor
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"This durable tank is topped with a motor that will cram as much air into the"
" tank as possible."
msgstr "이 튼튼한 탱크 위에는 탱크에 가능한 한 많은 공기를 집어넣는 모터가 얹혀 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "fermenting vat"
msgstr "발효 통"

#. ~ Description for fermenting vat
#. ~ Description for filled fermenting vat
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "A sealable vat for fermenting vinegar and various alcoholic brews."
msgstr "식초와 각종 알코올 발효를 위한 밀폐 가능한 통입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "filled fermenting vat"
msgstr "가득 찬 발효 통"

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "butchering rack"
msgstr "도축걸이"

#. ~ Description for butchering rack
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "Butchering rack designed to hang a carcass in the air."
msgstr "사체를 공중에 매달기 위해 설계된 도축걸이입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\deployable.json
msgid "metal butchering rack"
msgid_plural "metal butchering racks"
msgstr[0] "금속 도축 거치대"

#. ~ Description for metal butchering rack
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"Metal butchering rack designed to hang a carcass in the air.  It can be "
"deconstructed and folded for easy transportation."
msgstr "사체를 공중에 매달기 위해 설계된 금속 도축걸이입니다. 분해하고 접어서 쉽게 운반할 수 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "hanging meathook"
msgstr "매달린 고기 갈고리"

#. ~ Description for hanging meathook
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "A hefty hook suspended from a chain for stringing up corpses."
msgstr "시체를 매달기 위해 사슬에 매달린 묵직한 갈고리입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\deployable.json
msgid "wind mill"
msgid_plural "wind mills"
msgstr[0] "풍차"

#. ~ Description for wind mill
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "A small wind-powered mill that can be used to grind down materials."
msgstr "재료를 갈아내리는 데 쓸 수 있는 작은 바람 동력 맷돌입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "active wind mill"
msgstr "작동 중인 풍차"

#. ~ Description for active wind mill
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A small wind-powered mill that can be used to grind down materials.  Its "
"brake has been removed and it is turning."
msgstr "재료를 갈아내리는 데 쓸 수 있는 작은 바람 동력 맷돌입니다. 브레이크가 해제되어 돌아가고 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\items\tool\deployable.json
msgid "water mill"
msgid_plural "water mills"
msgstr[0] "물레방아"

#. ~ Description for water mill
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "A small water-powered mill that can be used to grind down materials."
msgstr "재료를 갈아내리는 데 쓸 수 있는 작은 물 동력 맷돌입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "active water mill"
msgstr "작동 중인 물레방아"

#. ~ Description for active water mill
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A small water-powered mill that can be used to grind down materials.  Its "
"brake has been removed and it is turning."
msgstr "재료를 갈아내리는 데 쓸 수 있는 작은 물 동력 맷돌입니다. 브레이크가 해제되어 돌아가고 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "automated gas console"
msgstr "자동식 주유 제어기"

#. ~ Description for automated gas console
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "Automated gas flow control console."
msgstr "자동화된 가스 흐름 제어 콘솔입니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "broken automated gas console"
msgstr "고장난 자동식 주유 제어기"

#. ~ Description for broken automated gas console
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"Automated gas flow control console.  Broken.  This is not a good thing."
msgstr "자동화된 가스 흐름 제어 콘솔입니다. 고장 났습니다. 좋은 일이 아닙니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "reinforced vending machine"
msgstr "강화된 자판기"

#. ~ Description for reinforced vending machine
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"A bit tougher to crack open than regular vending machines.  That just makes "
"it all the sweeter a target, doesn't it?"
msgstr "일반 자판기보다 부수기 조금 더 어렵습니다. 그게 오히려 더 달콤한 표적으로 만들지 않나요?"

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "vending machine"
msgstr "자판기"

#. ~ Description for vending machine
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "Buy stuff with a cash card."
msgstr "현금 카드로 물건을 구매합니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "broken vending machine"
msgstr "고장난 자판기"

#. ~ Description for broken vending machine
#: data\json\furniture_and_terrain\furniture-tools.json
msgid ""
"Ponder if you could buy stuff, as it's broken.  Maybe if you broke it more, "
"you wouldn't need to pay at all!"
msgstr "고장 났으니 물건을 살 수 있을지 생각해보세요. 더 부수면, 돈을 안 내도 될 지도 모릅니다!"

#: data\json\furniture_and_terrain\furniture-tools.json
#: data\json\furniture_and_terrain\terrain-zlevel-transitions.json
msgid "rope leading up"
msgstr "위로 올라가는 밧줄"

#. ~ Description for rope leading up
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "A rope.  You could climb it up."
msgstr "밧줄입니다. 위로 올라갈 수 있습니다."

#: data\json\furniture_and_terrain\furniture-tools.json
msgid "web rope leading up"
msgstr "거미줄 밧줄 (위로)"

#. ~ Description for web rope leading up
#: data\json\furniture_and_terrain\furniture-tools.json
msgid "A web rope.  You could climb it up."
msgstr "거미줄 밧줄입니다. 위로 올라갈 수 있습니다."

#: data\json\furniture_and_terrain\furniture-triffid.json
msgid "luminous plant bulb"
msgstr "발광 식물 구근"

#. ~ Description for luminous plant bulb
#: data\json\furniture_and_terrain\furniture-triffid.json
msgid ""
"A small plant grows among the roots here, its green onion-like bulb "
"illuminating the area around it."
msgstr "뿌리 사이에 작은 식물이 자라고 있고, 그 녹색 양파 같은 구근이 주변을 밝히고 있습니다."

#: data\json\furniture_and_terrain\furniture-triffid.json
msgid "brambles"
msgstr "가시덤불"

#. ~ Description for brambles
#: data\json\furniture_and_terrain\furniture-triffid.json
msgid ""
"A wall of tangled roots blocks the path here, you'd have destroy it to get "
"past."
msgstr "얽힌 뿌리로 된 벽이 여기 길을 막고 있습니다. 지나가려면 부숴야 합니다."

#: data\json\furniture_and_terrain\furniture-triffid.json
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "smash"
msgstr "쿵!"

#: data\json\furniture_and_terrain\furniture-triffid.json
msgid "composting midden"
msgstr "퇴비 쓰레기 더미"

#. ~ Description for composting midden
#: data\json\furniture_and_terrain\furniture-triffid.json
msgid ""
"A hole that has been dug into the roots here, a pretty unpleasant smell "
"emits from it."
msgstr "여기 뿌리에 파인 구멍으로, 꽤 불쾌한 냄새가 납니다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "walkway"
msgstr "통로"

#. ~ Description for walkway
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A metallic bridge commonly used in industrial settings to meet specified "
"safety standards."
msgstr "지정된 안전 기준을 충족하기 위해 산업 환경에서 일반적으로 사용되는 금속 다리다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\overmap\overmap_terrain\overmap_terrain_recreational.json
msgid "dock"
msgstr "부두"

#. ~ Description for dock
#. ~ Description for shallow bridge
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "A wooden platform held by a support made of logs dug into the ground."
msgstr "땅에 박힌 통나무 지지대 위에 얹힌 나무 플랫폼이다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "deep dock pile"
msgstr "심수 부두 말뚝"

#. ~ Description for deep dock pile
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A sturdy pile made of wood extending all the way to the riverbed.  A frame "
"will be required to support a surface."
msgstr "강바닥까지 뻗은, 나무로 만든 튼튼한 말뚝입니다. 상면을 지탱하려면 프레임이 필요합니다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "deep dock frame"
msgstr "심수 부두 프레임"

#. ~ Description for deep dock frame
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A log frame secured atop a wooden pile.  Adding a wood surface will make "
"this into a proper dock section."
msgstr "나무 말뚝 위에 고정된 통나무 프레임입니다. 나무 상면을 추가하면 제대로 된 부두 구간이 됩니다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "deep dock"
msgstr "심수 부두"

#. ~ Description for deep dock
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A wooden platform held by a tall wooden pile that extend to the riverbed.  "
"Very sturdy, and likely to outlast you."
msgstr "강바닥까지 뻗은 높은 나무 말뚝이 받치는 나무 플랫폼입니다. 매우 튼튼해서 당신보다 오래 갈 가능성이 높습니다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "shallow bridge"
msgstr "얕은 다리"

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "pontoon bridge"
msgstr "부교"

#. ~ Description for pontoon bridge
#. ~ Description for river bridge
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A floating temporary bridge, like the ones army used to make to cross "
"rivers."
msgstr "군대가 강을 건너기 위해 만든 것과 같은 떠다니는 임시 다리다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "river bridge"
msgstr "강 다리"

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\furniture_and_terrain\terrain-highways.json
msgid "bridge pavement"
msgstr "도로-다리"

#. ~ Description for bridge pavement
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\furniture_and_terrain\terrain-highways.json
msgid "A bridge section made out of metal and concrete."
msgstr "금속과 콘크리트로 만든 다리 구간입니다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\furniture_and_terrain\terrain-highways.json
msgid "concrete cracking and metal screeching!"
msgstr "콘크리트가 깨지고 금속이 긁히는 소리!"

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\furniture_and_terrain\terrain-highways.json
msgid "bridge yellow pavement"
msgstr "중앙선-다리"

#. ~ Description for bridge yellow pavement
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\furniture_and_terrain\terrain-highways.json
msgid "A bridge section made out of metal and concrete.  It's painted yellow."
msgstr "금속과 콘크리트로 만든 다리 구간입니다. 노란색으로 칠해져 있습니다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\furniture_and_terrain\terrain-highways.json
msgid "bridge sidewalk"
msgstr "인도-다리"

#. ~ Description for bridge sidewalk
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
#: data\json\furniture_and_terrain\terrain-highways.json
msgid "The sidewalk section of a concrete bridge."
msgstr "콘크리트 다리의 인도 구간입니다."

#. ~ Description for dock
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A metal platform held by a support made of concrete set into the ground."
msgstr "땅에 박은 콘크리트 지지대가 받치는 금속 플랫폼입니다."

#. ~ Description for deep dock pile
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A sturdy pile made of poured concrete extending all the way to the riverbed."
"  A metal frame will be required to support a surface."
msgstr "강바닥까지 뻗은, 부어넣은 콘크리트로 만든 튼튼한 말뚝입니다. 상면을 지탱하려면 금속 프레임이 필요합니다."

#. ~ Description for deep dock frame
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A metal frame secured atop a concrete pile.  Adding a metal surface will "
"make this into a proper dock section."
msgstr "콘크리트 말뚝 위에 고정된 금속 프레임입니다. 금속 상면을 추가하면 제대로 된 부두 구간이 됩니다."

#. ~ Description for deep dock
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid ""
"A metal platform held by a tall metal pile that extends to the riverbed.  "
"Very sturdy, and likely to outlast you."
msgstr "강바닥까지 뻗은 높은 금속 말뚝이 받치는 금속 플랫폼입니다. 매우 튼튼해서 당신보다 오래 갈 가능성이 높습니다."

#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "metal floating dock"
msgstr "금속 부유 부두"

#. ~ Description for metal floating dock
#: data\json\furniture_and_terrain\terrain-bridges-docks.json
msgid "A floating temporary dock, anchored to keep it from drifting away."
msgstr "떠 있는 임시 부두로, 떠내려가지 않도록 닻이 내려져 있습니다."

#: data\json\furniture_and_terrain\terrain-dimensional.json
msgid "dimensional boundary"
msgstr "차원 경계"

#. ~ Description for dimensional boundary
#: data\json\furniture_and_terrain\terrain-dimensional.json
msgid ""
"An impenetrable barrier marking the edge of a pocket dimension.  The space "
"beyond seems to shimmer and distort, as if reality itself is uncertain about"
" what lies there."
msgstr ""
"포켓 차원의 가장자리를 표시하는 뚫을 수 없는 장벽입니다. 너머의 공간은 현실 자체가 거기에 무엇이 있는지 불확실한 듯 아른거리고 "
"일그러져 보입니다."

#: data\json\furniture_and_terrain\terrain-dimensional.json
msgid "The dimensional boundary absorbs the impact without effect."
msgstr "차원 경계가 충격을 아무런 효과 없이 흡수했다."

#: data\json\furniture_and_terrain\terrain-dimensional.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "stone wall"
msgstr "돌벽"

#. ~ Description for stone wall
#: data\json\furniture_and_terrain\terrain-dimensional.json
msgid "It's solid rock."
msgstr "견고한 암반입니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed laminated glass door"
msgstr "닫힌 접합 유리문"

#. ~ Description for closed laminated glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A closed laminated glass door is composed layers of glass and plastic held "
"together by an interlayer."
msgstr "닫힌 접합 유리문은 중간층으로 붙잡힌 유리와 플라스틱 층으로 구성되어 있습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open laminated glass door"
msgstr "열린 접합 유리문"

#. ~ Description for open laminated glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"Laminated glass door is composed layers of glass and plastic held together "
"by an interlayer.  Yep, it's open."
msgstr "접합 유리문은 중간층으로 붙잡힌 유리와 플라스틱 층으로 구성되어 있습니다. 네, 열려 있습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed ballistic glass door"
msgstr "닫힌 방탄 유리문"

#. ~ Description for closed ballistic glass door
#. ~ Description for ballistic glass
#: data\json\furniture_and_terrain\terrain-doors.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Ballistic glass consists of layers of laminated glass."
msgstr "방탄 유리는 접합 유리 층으로 이루어져 있습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open ballistic glass door"
msgstr "열린 방탄 유리문"

#. ~ Description for open ballistic glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"Ballistic glass consists of layers of laminated glass.  Yep, it's open."
msgstr "방탄 유리는 접합 유리 층으로 이루어져 있습니다. 네, 열려 있습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed reinforced glass door"
msgstr "닫힌 강화 유리 문"

#. ~ Description for closed reinforced glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A closed glass door reinforced with woven steel wires in a stylish, but "
"practical pattern."
msgstr "세련되고 실용적인 패턴의 강철 와이어가 짜인 닫힌 강화 유리문이다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open reinforced glass door"
msgstr "열린 강화 유리 문"

#. ~ Description for open reinforced glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A glass door reinforced with woven steel wires in a stylish, but practical "
"pattern.  Yep, it's open."
msgstr "세련되고 실용적인 패턴의 강철 와이어가 짜인 강화 유리문이다. 열려 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed wood door"
msgstr "닫힌 나무 문"

#. ~ Description for closed wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too."
msgstr "그다지 회복력이 있어 보이지 않는 표준 나무 문이다. 쉽게 불에 탈 것 같기도 하다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open wood door"
msgstr "열린 나무 문"

#. ~ Description for open wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one is wide open."
msgstr "그다지 회복력이 있어 보이지 않는 표준 나무 문이다. 쉽게 불에 탈 것 같기도 하다. 이것은 활짝 열려 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "damaged wood door"
msgstr "파손된 나무 문"

#. ~ Description for damaged wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A trashed wooden door, that is more of an obstacle than a door.  Also, you "
"can see right through it.  It could be boarded up with a few two by fours."
msgstr "문이라기보다 장애물에 가까운 부서진 나무 문이다. 게다가 바로 들여다볼 수 있다. 2x4 목재 몇 개로 막을 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "empty door frame"
msgstr "빈 문틀"

#. ~ Description for empty door frame
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An empty door frame made from two by fours and nails.  A variety of doors "
"could be constructed here."
msgstr "2x4 목재와 못으로 만든 빈 문틀이다. 다양한 문을 여기에 만들 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed glass door"
msgstr "닫힌 유리 문"

#. ~ Description for closed glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A sliding glass door, the kind that was on social media with people and "
"animals running into.  This one is closed, so don't hurt yourself."
msgstr "사람과 동물들이 달려 들어가는 소셜 미디어의 그 슬라이딩 유리문이다. 이것은 닫혀 있으니 다치지 않도록 조심해라."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open glass door"
msgstr "열린 유리 문"

#. ~ Description for open glass door
#. ~ Description for open frosted glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A sliding glass door that has been left open for all manner of things to "
"travel through."
msgstr "각종 것들이 통과할 수 있도록 열린 슬라이딩 유리문이다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed wood door with peephole"
msgstr "닫힌 나무 문-외시경"

#. ~ Description for closed wood door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole."
msgstr "일반적인 나무로 만든 평범한 문인데, 이것은 들여다볼 수 있는 구멍이 있다. 더 자세히 살펴보면 구멍을 통해 엿볼 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "damaged wood door with peephole"
msgstr "파손된 나무 문-외시경"

#. ~ Description for damaged wood door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"Bad news is the peephole is broken and you can't look outside the door.  "
"Good news is the door is nearly broken down, so there's nothing blocking the"
" view.  A few planks, nails and the right tools could patch up all the "
"damage."
msgstr ""
"나쁜 소식은 들여다볼 수 있는 구멍이 부서져 문 밖을 내다볼 수 없다. 좋은 소식은 문이 거의 부서져 있어 아무것도 시야를 막지 않는다."
" 판자, 못, 적절한 도구로 모든 손상을 수리할 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open wood door with peephole"
msgstr "열린 나무 문-외시경"

#. ~ Description for open wood door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  "
"Although, you don't need to peek through it since the door is open anyway."
msgstr ""
"일반적인 나무로 만든 평범한 문인데, 이것은 들여다볼 수 있는 구멍이 있다. 더 자세히 살펴보면 구멍을 통해 엿볼 수 있다. 어차피 문이"
" 열려 있으니 엿볼 필요가 없다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed reinforced wood door"
msgstr "닫힌 강화 나무 문"

#. ~ Description for closed reinforced wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"Just like other wooden doors, except this one has layers of nailed in two by"
" fours and additional hinge for reinforcement.  It might be barricaded, but "
"still susceptible to fire."
msgstr ""
"다른 목재 문과 같지만, 이것은 2x4 목재를 못 박은 층과 보강용 추가 경첩이 있습니다. 바리케이드가 되어 있을 수 있지만, 여전히 "
"화재에 취약합니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "damaged reinforced wood door"
msgstr "파손된 강화 나무 문"

#. ~ Description for damaged reinforced wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"There are splintering planks and visible holes in the wood, it looks like it"
" could be smashed apart if not repaired."
msgstr "나무에 부서진 판자와 눈에 보이는 구멍이 있어 수리하지 않으면 산산조각 날 것 같다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open reinforced wood door"
msgstr "열린 강화 나무 문"

#. ~ Description for open reinforced wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"Just like other wooden doors, except this one has layers of nailed in two by"
" fours for reinforcement.  It might be fortified, but still susceptible to "
"fire.  It's open so it's not stopping anything right now."
msgstr ""
"다른 나무 문과 비슷하지만, 보강을 위해 2x4 목재 여러 개가 못으로 박혀 있다. 강화되어 있을 수 있지만 여전히 화재에 취약하다. "
"열려 있어 현재 아무것도 막지 않는다."

#. ~ Description for closed wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has an extra keyhole, so it's likely locked.  You "
"could pry it open or pick the lock."
msgstr ""
"그다지 회복력이 있어 보이지 않는 표준 나무 문이다. 쉽게 불에 탈 것 같기도 하다. 열쇠 구멍이 추가로 있으니 잠겨 있을 가능성이 "
"높다. 힘으로 열거나 자물쇠를 딸 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "You pry open the door."
msgstr "지레질로 문을 열었다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "You pry, but cannot pry open the door."
msgstr "지레질을 해봤지만, 문을 열지 못 했다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "You damage the door!"
msgstr "문을 손상시켰다!"

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "With a satisfying click, the lock on the door opens."
msgstr "기분좋은 딸깍소리와 함께 문의 잠금장치가 열렸다."

#. ~ Description for closed wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one has a deadbolt keyhole, so it's likely locked.  You "
"could pry it open or pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"그다지 회복력이 있어 보이지 않는 표준 나무 문이다. 쉽게 불에 탈 것 같기도 하다. 보조 잠금장치 열쇠 구멍이 있으니 잠겨 있을 "
"가능성이 높다. 힘으로 열거나 자물쇠를 따거나 내부에서 보조 잠금장치를 열 수 있다."

#. ~ Description for closed wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A regular door made of ordinary wood, except this one has a peephole.  If "
"you examined it more closely, you'd be able to peek through the hole.  This "
"one has a deadbolt keyhole, so it's likely locked.  You could pry it open or"
" pick the lock, or unlock the deadbolt from the inside."
msgstr ""
"일반적인 나무로 만든 평범한 문인데, 이것은 들여다볼 수 있는 구멍이 있다. 더 자세히 살펴보면 구멍을 통해 엿볼 수 있다. 보조 "
"잠금장치 열쇠 구멍이 있으니 잠겨 있을 가능성이 높다. 힘으로 열거나 자물쇠를 따거나 내부에서 보조 잠금장치를 열 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed door curtain"
msgstr "닫힌 커튼 달린 문"

#. ~ Description for closed door curtain
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else."
msgstr "창문의 커튼을 재활용하여 문으로 사용한 것이다. 보급품으로 쉽게 떼거나 다른 곳에 설치할 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed makeshift door"
msgstr "닫힌 임시 문"

#. ~ Description for closed makeshift door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A makeshift screen consisting of two by fours bound together with vertical "
"rope hanging from the top of the doorway.  Could be easily taken down and "
"re-purposed."
msgstr "문틀 상단에서 수직 밧줄로 묶인 2x4 목재로 구성된 수제 가림막이다. 쉽게 뜯어 다른 용도로 사용할 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "wham."
msgstr "쿵."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open door curtain"
msgstr "열린 커튼 달린 문"

#. ~ Description for open door curtain
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"Repurposed curtains from a window acting as a door.  Could be easily taken "
"down for supplies or placed somewhere else.  These curtains are open, "
"bundled and tied next to the doorway."
msgstr ""
"창문의 커튼을 재활용하여 문으로 사용한 것이다. 보급품으로 쉽게 떼거나 다른 곳에 설치할 수 있다. 이 커튼은 열려 있어 묶여서 문 옆에"
" 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open makeshift door"
msgstr "열린 임시 문"

#. ~ Description for open makeshift door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A makeshift screen consisting of two by fours bound together with rope "
"hanging from the top of the doorway.  Could be easily taken down and re-"
"purposed.  The planks have been rolled up and attached to the top of the "
"doorway, allowing free movement through."
msgstr ""
"문틀 상단에서 밧줄로 묶인 2x4 목재로 구성된 수제 가림막이다. 쉽게 뜯어 다른 용도로 사용할 수 있다. 판자가 말려 문틀 상단에 "
"부착되어 자유롭게 통과할 수 있다."

#. ~ Description for empty door frame
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An empty door frame made from wood.  A variety of doors could be constructed"
" here."
msgstr "나무로 만든 빈 문틀입니다. 여러 종류의 문을 여기에 지을 수 있습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "empty metal door frame"
msgstr "빈 금속 문틀"

#. ~ Description for empty metal door frame
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An empty door frame made of steel and assorted metal.  A variety of doors "
"could be constructed here."
msgstr "강철과 각종 금속으로 만든 빈 문틀이다. 다양한 문을 여기에 만들 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "empty metal window frame"
msgstr "빈 금속 창문틀"

#. ~ Description for empty metal window frame
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An empty window frame constructed from assembled metal and carefully braced "
"with various hardware."
msgstr "금속을 조립하여 각종 철물로 신중하게 지지된 빈 창문 틀이다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "boarded up door"
msgstr "판자로 막은 문"

#. ~ Description for boarded up door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A standard wooden door that has several planks across it, nailed down to "
"board it up and increase its durability.  Still flammable though."
msgstr "내구성을 높이기 위해 여러 개의 판자가 못으로 박혀 있는 표준 나무 문이다. 여전히 가연성이 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "boarded up damaged door"
msgstr "파손된 판자로 막은 문"

#. ~ Description for boarded up damaged door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A boarded up wooden door, except some of the planks are fractured or coming "
"loose.  Without repairs, it could be broken down easily."
msgstr "일부 판자가 부러지거나 느슨해진 막아놓은 나무 문이다. 수리하지 않으면 쉽게 부술 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "boarded up door with peephole"
msgstr "판자로 막은 문-외시경"

#. ~ Description for boarded up door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A boarded up door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, you could still examine the "
"peephole."
msgstr ""
"들여다볼 수 있는 구멍이 있는 일반 나무로 만든 막아놓은 문이다. 판자로 덮여 있지만 들여다볼 수 있는 구멍을 여전히 살펴볼 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "boarded up reinforced door"
msgstr "판자로 막은 강화 문"

#. ~ Description for boarded up reinforced door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An additionally reinforced door of layered two by fours that has been "
"boarded up with more wood to prevent it from opening.  Still susceptible to "
"fire."
msgstr "추가 나무로 막아 열리지 않도록 한 2x4 목재로 이중 보강된 문이다. 여전히 화재에 취약하다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "boarded up damaged reinforced door"
msgstr "파손된 판자로 막은 강화 문"

#. ~ Description for boarded up damaged reinforced door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A battered and torn reinforced door with planks bursting from the joints.  "
"The boarded up two by fours are fragmented and in pieces, this doesn't look "
"like an easy repair."
msgstr ""
"접합부에서 판자가 터지는 손상되고 찢어진 보강 문이다. 막아놓은 2x4 목재가 파편화되어 조각났으며, 이것은 쉽게 수리할 수 있을 것 "
"같지 않다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "boarded up damaged door with peephole"
msgstr "파손된 판자로 막은 문-외시경"

#. ~ Description for boarded up damaged door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A wrecked door made of ordinary wood, except this one has a peephole.  "
"Although it's been covered up in planks, the peephole was damaged and can't "
"be used to see through."
msgstr ""
"들여다볼 수 있는 구멍이 있는 일반 나무로 만든 부서진 문이다. 판자로 덮여 있지만 들여다볼 수 있는 구멍이 손상되어 통해 볼 수 없다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed metal door"
msgstr "닫힌 금속 문"

#. ~ Description for closed metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape."
msgstr "각종 강철을 깎고 두드려 모양을 만든 매우 회복력 있는 문이다."

#: data\json\furniture_and_terrain\terrain-doors.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "metal wall"
msgstr "금속 벽"

#. ~ Description for metal wall
#: data\json\furniture_and_terrain\terrain-doors.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned and joined "
"seamlessly with perimeter sealant, this wall is capable of resisting extreme"
" elements as well as hostile forces.  Blast load rated and extremely fire-"
"retardant, breaching will require specialized tools or industrial vehicles."
msgstr ""
"산업적으로 제작된 두꺼운 판을 조심스럽게 배치하고 둘레 밀봉재로 이음새 없이 접합한 이 벽은 극한 환경과 적대적 세력에 저항할 수 있다."
" 폭발 하중 등급이며 매우 내화성이 있어 특수 도구나 산업 차량이 필요하다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open secret door"
msgstr "열린 비밀 문"

#. ~ Description for open secret door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"This apparently normal segment of metal wall has opened to reveal a secret "
"passage."
msgstr "보기엔 평범한 금속 벽 구간이 열리며 비밀 통로를 드러냈습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open metal door"
msgstr "열린 금속 문"

#. ~ Description for open metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's open, so no tools are needed to break in."
msgstr "각종 강철을 깎고 두드려 모양을 만든 매우 회복력 있는 문이다. 열려 있어 침입에 도구가 필요 없다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed metal door with peephole"
msgstr "닫힌 금속 문-외시경"

#. ~ Description for closed metal door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole."
msgstr "각종 강철을 깎고 두드려 모양을 만든 매우 회복력 있는 문이다. 더 자세히 살펴보면 구멍을 통해 엿볼 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open metal door with peephole"
msgstr "열린 금속 문-외시경"

#. ~ Description for open metal door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  If you examined it more closely, you'd be able to peek through the "
"hole.  Although, you don't need to peek through it since the door is open "
"anyway."
msgstr ""
"각종 강철을 깎고 두드려 모양을 만든 매우 회복력 있는 문이다. 더 자세히 살펴보면 구멍을 통해 엿볼 수 있다. 어차피 문이 열려 있으니"
" 엿볼 필요가 없다."

#. ~ Description for closed metal door
#. ~ Description for underwater closed metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A galvanized steel door, forged to withstand punishment and impede anyone or"
" anything.  Typically used in conjunction with automated electronic locking "
"mechanisms that require an external source to unlock."
msgstr ""
"처벌을 견디고 누구든 막을 수 있도록 단조된 아연 도금 강철 문이다. 일반적으로 잠금 해제를 위해 외부 전원이 필요한 자동 전자 잠금 "
"메커니즘과 함께 사용된다."

#. ~ Description for open metal door
#. ~ Description for underwater open metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A hanging metal gate.  Typically used in conjunction with mechanical winch."
"  Probably shouldn't be underneath when it comes down."
msgstr "매달린 금속 게이트입니다. 보통 기계식 윈치와 함께 사용됩니다. 내려올 때 밑에 있지 않는 게 좋을 겁니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "underwater closed metal door"
msgstr "수중 닫힌 금속 문"

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "underwater open metal door"
msgstr "수중 열린 금속 문"

#. ~ Description for closed metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  This one has an extra keyhole, so it's likely locked.  You could "
"probably pick the lock, or a very strong tool could pry it open."
msgstr ""
"온갖 강철을 깎고 두들겨 만든 극도로 튼튼한 문입니다. 이것은 추가 열쇠구멍이 있어 잠겨 있을 가능성이 높습니다. 아마 자물쇠를 따거나 "
"아주 강한 도구로 비틀어 열 수 있을 겁니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed junk metal door"
msgstr "닫힌 고철 문"

#. ~ Description for closed junk metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A makeshift door made of rusty scrap metal bolted together, with metal wires"
" for hinges.  Very fashionable in post-apocalyptic shantytowns."
msgstr "녹슨 고철을 볼트로 잇고 금속 철사로 경첩을 만든 사제 문입니다. 포스트 아포칼립스 판자촌에서 아주 유행입니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open junk metal door"
msgstr "열린 고철 문"

#. ~ Description for open junk metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A makeshift door made of rusty scrap metal bolted together, with metal wires"
" for hinges.  Very fashionable in post-apocalyptic shantytowns.  Somehow "
"even draftier now that it's open."
msgstr ""
"녹슨 고철을 볼트로 잇고 금속 철사로 경첩을 만든 사제 문입니다. 포스트 아포칼립스 판자촌에서 아주 유행입니다. 열려 있으니 어쩐지 더 "
"바람이 잘 통합니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed bar door"
msgstr "닫힌 쇠창살 문"

#. ~ Description for closed bar door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism doesn't appear to be engaged."
msgstr "교차된 스테인리스 강철 막대로 구성된 구금 문이다. 잠금 메커니즘이 작동하지 않는 것 같다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open bar door"
msgstr "열린 쇠창살 문"

#. ~ Description for open bar door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  It's swung "
"wide open.  Freedom!"
msgstr "교차된 스테인리스 강철 막대로 구성된 구금 문이다. 활짝 열렸다. 자유!"

#. ~ Description for closed bar door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  The locking "
"mechanism appears to be engaged.  The mechanism could be picked open with "
"enough skill."
msgstr "교차된 스테인리스 강철 막대로 구성된 구금 문이다. 잠금 메커니즘이 작동하는 것 같다. 충분한 기술로 자물쇠를 딸 수 있다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "The door swings open…"
msgstr "문이 활짝 열린다…"

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed frosted glass door"
msgstr "닫힌 무광 유리문"

#. ~ Description for closed frosted glass door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid "A sliding door of frosted white glass."
msgstr "무광 흰색 유리 슬라이딩 문이다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open frosted glass door"
msgstr "열린 무광 유리문"

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed bulkhead door"
msgstr "닫힌 격벽 문"

#. ~ Description for closed bulkhead door
#. ~ Description for open bulkhead door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door of cast metal, it is watertight and opened using"
" the fly wheel."
msgstr "주조 금속으로 된 극도로 튼튼한 문으로, 수밀이며 돌림 핸들로 엽니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open bulkhead door"
msgstr "열린 격벽 문"

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "underwater closed bulkhead door"
msgstr "수중 닫힌 격벽 문"

#. ~ Description for underwater closed bulkhead door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door of cast metal, opened using the fly wheel.  It's"
" technically still watertight, but that's a moot point when both sides are "
"flooded."
msgstr ""
"돌림 핸들로 여는, 주조 금속으로 된 극도로 튼튼한 문입니다. 기술적으로는 여전히 수밀이지만, 양쪽이 다 물에 잠겼으니 의미가 없습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "underwater open bulkhead door"
msgstr "수중 열린 격벽 문"

#. ~ Description for underwater open bulkhead door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door of cast metal, currently open and letting all "
"the fish in."
msgstr "주조 금속으로 된 극도로 튼튼한 문으로, 현재 열려 있어 물고기가 전부 들어오고 있습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "welded metal door"
msgstr "용접된 금속 문"

#. ~ Description for welded metal door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's been welded shut, that oughta hold 'em."
msgstr "온갖 강철을 깎고 두들겨 만든 극도로 튼튼한 문입니다. 용접으로 봉해졌으니, 그것들을 막아줄 겁니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "welded metal door with peephole"
msgstr "엿보기 구멍 있는 용접 금속 문"

#. ~ Description for welded metal door with peephole
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient door made of assorted steel, carved and pounded into "
"shape.  It's been welded shut, that oughta hold 'em.  If you examined it "
"more closely, you'd be able to peek through the hole."
msgstr ""
"온갖 강철을 깎고 두들겨 만든 극도로 튼튼한 문입니다. 용접으로 봉해졌으니, 그것들을 막아줄 겁니다. 더 자세히 조사하면 구멍 너머를 "
"엿볼 수 있습니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "welded bulkhead door"
msgstr "용접된 격벽 문"

#. ~ Description for welded bulkhead door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"An extremely resilient watertight door of cast metal.  Used to open using "
"the fly wheel, it's since been welded shut.  That oughta hold 'em."
msgstr ""
"주조 금속으로 된 극도로 튼튼한 수밀 문입니다. 예전엔 돌림 핸들로 열었지만, 이후 용접으로 봉해졌습니다. 그것들을 막아줄 겁니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "welded bar door"
msgstr "용접된 철창 문"

#. ~ Description for welded bar door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A detention door made up of crisscrossed stainless steel bars.  It's been "
"welded shut, that oughta hold 'em."
msgstr "엇갈린 스테인리스 철창으로 된 감금 문입니다. 용접으로 봉해졌으니, 그것들을 막아줄 겁니다."

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed screen door"
msgstr "닫힌 방충망 문"

#. ~ Description for closed screen door
#. ~ Description for open screen door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid "A simple wooden doorway with screen mesh."
msgstr "망이 달린 간단한 나무 문입니다."

#: data\json\furniture_and_terrain\terrain-doors.json
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "rattle!"
msgstr "덜거덕!"

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "open screen door"
msgstr "열린 방충망 문"

#: data\json\furniture_and_terrain\terrain-doors.json
msgid "closed wood windowed door"
msgstr "닫힌 창문 달린 목재 문"

#. ~ Description for closed wood windowed door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too. This one has a window."
msgstr "그다지 튼튼해 보이지 않는 표준 목재 문입니다. 아마 쉽게 불탈 겁니다. 이것은 창문이 있습니다."

#. ~ Description for open wood door
#: data\json\furniture_and_terrain\terrain-doors.json
msgid ""
"A standard wooden door that doesn't look very resilient.  It'd probably burn"
" easily, too.  This one is wide open, and has a window."
msgstr "그다지 튼튼해 보이지 않는 표준 목재 문입니다. 아마 쉽게 불탈 겁니다. 이것은 활짝 열려 있고 창문이 있습니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "palisade gate"
msgstr "말뚝 대문"

#. ~ Description for palisade gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A large doorway consisting of long logs cabled together, that could be "
"expanded upon.  Can act as a door if some type of pulley system were rigged "
"on an adjacent palisade wall."
msgstr ""
"긴 통나무를 케이블로 연결한 큰 출입구로, 확장할 수 있다. 인접한 목책 벽에 도르래 시스템이 설치되어 있다면 문으로 작동할 수 있다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "open palisade gate"
msgstr "열린 목책 문"

#. ~ Description for open palisade gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A hanging palisade gate, hoisted by a nearby pulley system.  Probably "
"shouldn't be underneath when it comes down."
msgstr "근처 도르래 시스템으로 올라간 매달린 목책 문이다. 내려올 때 아래에 있으면 안 될 것 같다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "makeshift portcullis"
msgstr "간이 쇠창살 문"

#. ~ Description for makeshift portcullis
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"An immense gateway scrapped together with various bits of steel and metal "
"scraps."
msgstr "각종 강철 조각과 금속 파편으로 긁어모아 만든 거대한 출입문이다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "locked wire gate"
msgstr "잠긴 철책 문"

#. ~ Description for locked wire gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A gate for a chain link fence.  This one has a locked padlock on the latch "
"system.  With the right tools, you could cut the metal fence, pick the lock,"
" or pry the whole thing open.  You could also examine the fence to see if it"
" looks climbable."
msgstr ""
"철망 울타리용 문입니다. 이것은 걸쇠에 자물쇠가 잠겨 있습니다. 적절한 도구가 있으면 철망을 자르거나, 자물쇠를 따거나, 통째로 비틀어 "
"열 수 있습니다. 울타리를 조사해서 올라갈 수 있을지 확인할 수도 있습니다."

#. ~ sound of bolt cutting locked wire gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "Gachunk!"
msgstr "카칭!"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "You pry open the gate."
msgstr "울타리 문을 비틀어 열었다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "You pry, but cannot pry open the gate."
msgstr "비틀어봤지만 울타리 문을 열 수 없었다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "With a satisfying click, the lock on the gate opens."
msgstr "기분 좋은 찰칵 소리와 함께 울타리 문의 자물쇠가 풀렸다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "closed wire gate"
msgstr "닫힌 철책 문"

#. ~ Description for closed wire gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A gate for a chain link fence with a latch system to stay closed."
msgstr "닫힌 상태를 유지하는 잠금 시스템이 있는 체인 링크 울타리의 대문이다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "open wire gate"
msgstr "열린 철책 문"

#. ~ Description for open wire gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A gate for a chain link fence with a latch system to stay closed.  The latch"
" is undone, so the gate has swung open."
msgstr "닫힌 상태를 유지하는 잠금 시스템이 있는 체인 링크 울타리의 대문이다. 잠금이 해제되어 대문이 열렸다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "closed wooden gate"
msgstr "닫힌 나무 울타리 문"

#. ~ Description for closed wooden gate
#. ~ Description for closed wooden split rail gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A commercial quality gate made of wood with a latch system."
msgstr "잠금 시스템이 있는 나무로 만든 상업용 품질의 대문이다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "open wooden gate"
msgstr "열린 나무 울타리 문"

#. ~ Description for open wooden gate
#. ~ Description for open wooden split rail gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A commercial quality gate made of wood with a latch system.  The gate is "
"wide open, allowing anything to travel through."
msgstr "잠금 시스템이 있는 나무로 만든 상업용 품질의 대문이다. 대문이 활짝 열려 있어 아무것이나 통과할 수 있다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "closed chickenwire gate"
msgstr "닫힌 닭 울타리 문"

#. ~ Description for closed chickenwire gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed."
msgstr "닫힌 상태를 유지하는 간단한 걸쇠가 달린 닭 울타리용 문입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "open chickenwire gate"
msgstr "열린 닭 울타리 문"

#. ~ Description for open chickenwire gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A gate for a chickenwire fence with a simple latch system to stay closed.  "
"The latch is undone, so the gate has swung open."
msgstr "닫힌 상태를 유지하는 간단한 걸쇠가 달린 닭 울타리용 문입니다. 걸쇠가 풀려 문이 활짝 열렸습니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "picket fence"
msgstr "울타리"

#. ~ Description for picket fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A barrier made of wood, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr "나무로 만든 장벽으로, 복잡하지 않다. 어디로 가면 안 된다는 것을 약하게 알려준다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "chain link fence"
msgstr "철책"

#. ~ Description for chain link fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A tall fence made of woven wires.  It doesn't suggest to stop, it just "
"stops."
msgstr "짜여진 철사로 만든 높은 울타리다. 멈추라고 권고하는 게 아니라 그냥 멈추게 한다."

#. ~ sound of bolt cutting chain link fence
#. ~ sound of bolt cutting wire fence
#. ~ sound of bolt cutting barbed wire fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
#: src/activity_actor.cpp
msgid "Snick, snick, gachunk!"
msgstr "짤깍, 짤깍, 카칭!"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "metal post"
msgstr "금속 기둥"

#. ~ Description for metal post
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "Set of metal posts, that can hold more serious fences."
msgstr "더 견고한 울타리를 지탱할 수 있는 금속 기둥 세트다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "chickenwire fence"
msgstr "닭 울타리 철망"

#. ~ Description for chickenwire fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A rather flimsy tall fence made of 2x4s and woven wire, suitable for "
"containing small livestock like chickens."
msgstr "2x4 목재와 엮은 철사로 만든 꽤 얄팍한 높은 울타리로, 닭 같은 소형 가축을 가두기에 적합합니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "metal rattling!"
msgstr "금속이 덜거덕거린다!"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "chickenwire fence post"
msgstr "닭 울타리 철망 기둥"

#. ~ Description for chickenwire fence post
#. ~ Description for fence post
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A couple of posts that support the fence.  They look alone without the "
"fence."
msgstr "울타리를 지지하는 기둥들이다. 울타리 없이 홀로 있어 보인다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "fence post"
msgstr "울타리 기둥"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "wire fence"
msgstr "철조망"

#. ~ Description for wire fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A barrier made of wire, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr "철사로 만든 장벽으로, 복잡하지 않다. 어디로 가면 안 된다는 것을 약하게 알려준다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "barbed wire fence"
msgstr "가시철조망"

#. ~ Description for barbed wire fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A barrier made of sharp barbed wire.  More persuasive brother of wire fence."
msgstr "날카로운 가시 철사로 만든 장벽이다. 철사 울타리보다 설득력 있는 형제다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "rope fence"
msgstr "밧줄 울타리"

#. ~ Description for rope fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A barrier made of rope, it's nothing complicated.  Mildly suggests where not"
" to go."
msgstr "밧줄로 만든 장벽으로, 복잡하지 않다. 어디로 가면 안 된다는 것을 약하게 알려준다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "split rail fence"
msgstr "쪼갠 통나무 울타리"

#. ~ Description for split rail fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A rather stout fence made of split logs with notches, held together by "
"gravity and suitable for containing livestock like horses, cows and pigs."
msgstr "홈이 있는 쪼갠 통나무로 만든 꽤 튼튼한 울타리로, 중력으로 유지되며 말, 소, 돼지 같은 가축을 가두기에 적합합니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "closed wooden split rail gate"
msgstr "닫힌 쪼갠 통나무 울타리 문"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "open wooden split rail gate"
msgstr "열린 쪼갠 통나무 울타리 문"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "metal fence"
msgstr "금속 울타리"

#. ~ Description for metal fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A simple metal fence."
msgstr "간단한 금속 울타리입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "closed metal gate"
msgstr "닫힌 금속 문"

#. ~ Description for closed metal gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A closed metal gate."
msgstr "닫힌 금속 문입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "open metal gate"
msgstr "열린 금속 문"

#. ~ Description for open metal gate
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "An open metal gate."
msgstr "열린 금속 문입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "wooden privacy fence"
msgstr "목재 프라이버시 울타리"

#. ~ Description for wooden privacy fence
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A rather stout fence made of 2x4s and fence posts, it is tall and prevents "
"people from seeing into your yard."
msgstr "2x4 목재와 울타리 기둥으로 만든 꽤 튼튼한 울타리로, 높아서 사람들이 당신의 마당을 들여다보지 못합니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "railing"
msgstr "난간"

#. ~ Description for railing
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A section of wooden railing."
msgstr "나무 난간 한 구간입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
#: data\json\furniture_and_terrain\terrain-recreational.json
#: src/map/mapdata.cpp
msgid "crack!"
msgid_plural "crack!"
msgstr[0] "콰직!"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "underwater railing"
msgstr "수중 난간"

#. ~ Description for underwater railing
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A flooded section of wooden railing.  Much less effective at stopping you "
"from jumping overboard, now."
msgstr "물에 잠긴 나무 난간 구간입니다. 이제 물에 뛰어드는 걸 막는 데 훨씬 덜 효과적입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "glass railing"
msgstr "유리 난간"

#. ~ Description for glass railing
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A section of railing made out of glass."
msgstr "유리로 만든 난간 한 구간입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "glass braking!"
msgstr "유리 깨짐!"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "metal railing"
msgstr "금속 난간"

#. ~ Description for metal railing
#. ~ Description for underwater metal railing
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A section of metal railing."
msgstr "금속 난간 한 구간입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "underwater metal railing"
msgstr "수중 금속 난간"

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "concrete railing"
msgstr "콘크리트 난간"

#. ~ Description for concrete railing
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "A section of cemented concrete railing."
msgstr "시멘트로 굳힌 콘크리트 난간 한 구간입니다."

#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid "guard rail"
msgstr "가드레일"

#. ~ Description for guard rail
#: data\json\furniture_and_terrain\terrain-fences-gates.json
msgid ""
"A section of metal railing, put in place to prevent people from falling or "
"taking the easy way out."
msgstr "사람들이 떨어지거나 지름길로 새나가는 걸 막기 위해 설치된 금속 난간 한 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "concrete floor"
msgstr "콘크리트 바닥"

#. ~ Description for concrete floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A bare and cold concrete floor with matching roof, could still insulate from"
" the outdoors but roof collapse is possible if supporting walls are broken "
"down."
msgstr ""
"맞는 지붕이 있는 차갑고 매끈한 콘크리트 바닥이다. 야외로부터의 단열은 가능하지만 지지 벽이 무너지면 지붕이 붕괴될 수 있다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
#: data\json\furniture_and_terrain\terrain-fungal.json
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "SMASH!"
msgstr "쿵!"

#. ~ Description for concrete floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A bare and cold concrete floor with a streak of yellow paint, could still "
"insulate from the outdoors but roof collapse is possible if supporting walls"
" are broken down."
msgstr ""
"노란 페인트 자국이 있는 휑하고 차가운 콘크리트 바닥입니다. 여전히 실외와 단열해주지만, 지지 벽이 무너지면 천장이 붕괴할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "concrete floor, overhead light"
msgstr "콘크리트 바닥, 천장 조명"

#. ~ Description for concrete floor, overhead light
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A bare and cold concrete floor with a still-functioning light attached to "
"the ceiling above."
msgstr "천장에 아직 작동하는 조명이 달린 차갑고 매끈한 콘크리트 바닥이다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "wooden floor, overhead light"
msgstr "목재 바닥, 천장 조명"

#. ~ Description for wooden floor, overhead light
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with a still-functioning light attached to the ceiling above."
msgstr "아마 방화 처리된 맞물리는 나무 타일로, 위 천장에는 아직 작동하는 조명이 달려 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "metal floor, with overhead light"
msgstr "금속 바닥, 천장 조명 있음"

#. ~ Description for metal floor, with overhead light
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls,"
" with a still-functioning light attached to the ceiling above."
msgstr "미끄러짐과 낙상 위험을 줄이는 고품질 튼튼한 체크무늬 바닥으로, 위 천장에는 아직 작동하는 조명이 달려 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
#: data\json\furniture_and_terrain\terrain-flora.json
#: data\json\furniture_and_terrain\terrain-liquids.json
#: data\json\furniture_and_terrain\terrain-traps.json
#: data\json\furniture_and_terrain\terrain-walls.json data\mods\2.7.4
#: KawaiiMaidMod\kawaii_override.json data\mods\MagicalNights\terrain.json
#: data\mods\desert_region\desert_terrain.json
msgid "thump"
msgstr "쿵"

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "small rebar roof cage"
msgstr "작은 철근 지붕 골조"

#. ~ Description for small rebar roof cage
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A series of structural support crafted from rebar in order to allow the "
"pouring of concrete for a more stable floor and roof."
msgstr "더 안정적인 바닥과 지붕을 위한 콘크리트 타설이 가능하도록 철근으로 제작된 일련의 구조 지지대다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "SCRRRASH!"
msgstr "끄으르 쾅!"

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "reinforced concrete floor"
msgstr "철근 콘크리트 바닥"

#. ~ Description for reinforced concrete floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"Extremely resilient floor made from carefully placed rebar and poured "
"concrete, capable of providing protection from the elements.  As for the "
"matching roof, it still requires supporting walls, otherwise it may very "
"well cave in."
msgstr ""
"조심스럽게 배치된 철근과 부어진 콘크리트로 만든 매우 회복력 있는 바닥이다. 환경으로부터 보호할 수 있다. 맞는 지붕은 지지 벽이 없으면"
" 무너질 수 있다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "rebar roof cage"
msgstr "철근 지붕 골조"

#. ~ Description for rebar roof cage
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A network of architecturally sound rebar in order to support a floor and "
"roof, looks like it's missing the poured concrete."
msgstr "바닥과 지붕을 지탱하기 위한 건축학적으로 견고한 철근 네트워크다. 부어진 콘크리트가 없는 것 같다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "half-built reinforced concrete floor"
msgstr "반쯤 만든 철근 콘크리트 바닥"

#. ~ Description for half-built reinforced concrete floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Unfinished series of rebar and poured concrete; the floor hasn't been "
"smoothed and the roof isn't quite filled in yet."
msgstr "미완성된 철근과 부어진 콘크리트 시리즈로, 바닥이 매끄럽게 처리되지 않았고 지붕도 완전히 채워지지 않았다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "rock floor"
msgstr "돌 바닥"

#. ~ Description for rock floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A relatively flat area of rock and stone.  Looks stable enough to be mined "
"with the proper mining gear."
msgstr "비교적 평평한 바위와 돌 지역이다. 적절한 채굴 장비로 채굴하기에 충분히 안정적인 것 같다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "metal floor"
msgstr "금속 바닥"

#. ~ Description for metal floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls,"
" with a matching roof."
msgstr "미끄러짐과 넘어짐의 위험을 줄이기 위한 고품질의 튼튼한 격자무늬 바닥과 맞는 지붕이다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "underwater metal floor"
msgstr "수중 금속 바닥"

#. ~ Description for underwater metal floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"High-quality and tough checkered flooring, with a matching roof.  Designed "
"to reduce risk of slips and falls, but definitely needs a \"wet floor\" sign"
" now."
msgstr ""
"어울리는 지붕이 있는 고품질 튼튼한 체크무늬 바닥입니다. 미끄러짐과 낙상 위험을 줄이도록 설계됐지만, 이제 확실히 \"젖은 바닥\" "
"표지판이 필요합니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "wooden floor"
msgstr "목재 바닥"

#. ~ Description for wooden floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Interlocking wooden tiles that are more than likely treated against fire, "
"with wooden posts and beams supporting a roof."
msgstr "화재에 처리된 것으로 보이는 맞물리는 목재 타일로, 목재 기둥과 대들보가 지붕을 지탱하고 있다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "primitive floor"
msgstr "원시 바닥"

#. ~ Description for primitive floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Timber floor and supports, holding up a sod roof."
msgstr "목재 바닥과 지지대가 잔디 지붕을 받치고 있다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "simple metal floor"
msgstr "단순한 금속 바닥"

#. ~ Description for simple metal floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A crudely welded together floor of metal with steel trusses and supporting "
"girders."
msgstr "금속 트러스와 지지 거더가 있는 조잡하게 용접된 금속 바닥이다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "waxed floor"
msgstr "왁스칠한 바닥"

#. ~ Description for waxed floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Hardwood flooring that has been treated with chemicals to improve slip "
"resistance and sliding, commonly for recreational sports."
msgstr "일반적으로 레크리에이션 스포츠를 위해 화학 처리된 미끄럼 저항 및 슬라이딩 처리된 단단한 나무 바닥재다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "dirt floor"
msgstr "흙바닥"

#. ~ Description for dirt floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Floor consisting of finely mixed earth that has been tamped down, with a "
"wooden ceiling above it."
msgstr "곱게 섞어 다져진 흙으로 된 바닥으로, 위에는 나무 천장이 있습니다."

#. ~ Description for dirt floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Floor consisting of finely mixed earth that has been tamped down, with "
"thatched roof above it."
msgstr "곱게 섞어 다져진 흙으로 된 바닥으로, 위에는 초가지붕이 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "metal grate"
msgstr "쇠살대"

#. ~ Description for metal grate
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A type of walkway that can be used as protective covering over drains or "
"even used as a filter."
msgstr "배수구 위에 보호 덮개로 사용하거나 필터로 사용할 수 있는 보도 유형이다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "utility light"
msgstr "시설 조명"

#. ~ Description for utility light
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"An industrial flood light set up to illuminate the surroundings.  It could "
"be salvaged to install elsewhere, but will require grid power once taken "
"down.  Examine it to switch it off."
msgstr ""
"주변을 밝히도록 설치된 산업용 투광등입니다. 철거해서 다른 곳에 설치할 수 있지만, 철거 후엔 전력망 전원이 필요합니다. 조사해서 끌 수"
" 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Switch off the utility light"
msgstr "작업등 끄기"

#. ~ Message for terrain 'utility light'
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "You flick the utility light off."
msgstr "작업등을 껐다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "utility light (off)"
msgstr "작업등 (꺼짐)"

#. ~ Description for utility light (off)
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"An industrial flood light, which could be turned on to illuminate your "
"surroundings.  It could also be salvaged if you're willing to provide it "
"more than emergency power.  Examine it to switch it back on."
msgstr ""
"켜서 주변을 밝힐 수 있는 산업용 투광등입니다. 비상 전력 이상을 제공할 의지가 있다면 철거할 수도 있습니다. 조사해서 다시 켤 수 "
"있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Switch on the utility light"
msgstr "작업등 켜기"

#. ~ Message for terrain 'utility light (off)'
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "You flick the utility light on."
msgstr "작업등을 켰다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "wax floor"
msgstr "밀랍 바닥"

#. ~ Description for wax floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "A floor section made entirely out of wax."
msgstr "전부 밀랍으로 된 바닥 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "elevator"
msgstr "엘리베이터"

#. ~ Description for elevator
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "The interior section of an elevator."
msgstr "엘리베이터의 내부 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "red floor"
msgstr "적색 바닥"

#. ~ Description for red floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "A red section of flooring."
msgstr "빨간색 바닥 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "green floor"
msgstr "녹색 바닥"

#. ~ Description for green floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "A green section of flooring."
msgstr "초록색 바닥 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "blue floor"
msgstr "청색 바닥"

#. ~ Description for blue floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "A blue section of flooring."
msgstr "파란색 바닥 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\items\resources\home_improvement.json
msgid "red carpet"
msgid_plural "red carpets"
msgstr[0] "빨간색 카펫"

#. ~ Description for red carpet
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Soft red carpet."
msgstr "부드러운 빨간색 카펫"

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\items\resources\home_improvement.json
msgid "yellow carpet"
msgid_plural "yellow carpets"
msgstr[0] "노란색 카펫"

#. ~ Description for yellow carpet
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Soft yellow carpet."
msgstr "부드러운 노란색 카펫"

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\items\resources\home_improvement.json
msgid "green carpet"
msgid_plural "green carpets"
msgstr[0] "녹색 카펫"

#. ~ Description for green carpet
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Soft green carpet."
msgstr "부드러운 초록색 카펫"

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\items\resources\home_improvement.json
msgid "purple carpet"
msgid_plural "purple carpets"
msgstr[0] "자주색 카펫"

#. ~ Description for purple carpet
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Soft purple carpet."
msgstr "부드러운 보라색 카펫"

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "industrial carpet"
msgstr "산업용 카펫"

#. ~ Description for industrial carpet
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Firm, low-pile, high-durability carpet in a neutral gray color, for laying "
"down on bare concrete."
msgstr "단단하고 파일이 낮은 고내구성 카펫으로, 중성 회색이며 콘크리트 바닥에 깔기 위한 것입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "bunker carpet"
msgstr "벙커 카펫"

#. ~ Description for bunker carpet
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Firm, low-pile, totally non-flammable carpet in a neutral cream color, with "
"an insulation layer beneath."
msgstr "단단하고 파일이 낮은 완전 불연성 카펫으로, 중성 크림색이며 아래에 단열층이 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "linoleum tile"
msgstr "리놀륨 타일"

#. ~ Description for linoleum tile
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A section of flooring made out of a tough, rubbery material.  Colored a "
"simple white."
msgstr "튼튼한 고무 질감 재료로 된 바닥 구간입니다. 단순한 흰색입니다."

#. ~ Description for linoleum tile
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "A section of flooring made out of a tough, gray, rubbery material."
msgstr "튼튼한 회색 고무 질감 재료로 된 바닥 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "painted waxed floor"
msgstr "페인트/왁스칠한 바닥"

#. ~ Description for painted waxed floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "This section of wax flooring has been painted."
msgstr "이 밀랍 바닥 구간은 칠해져 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "radiation platform"
msgstr "방사능 플랫폼"

#. ~ Description for radiation platform
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A dual-purpose platform that exposes items placed on it to a radioactive "
"source by temporarily hoisting the radioactive material stored within, while"
" also safely containing all objects to avoid contaminating its surroundings."
"  Operated from an external console."
msgstr ""
"내부에 저장된 방사성 물질을 일시적으로 끌어올려 위에 놓인 물품을 방사선원에 노출시키면서, 주변 오염을 피하도록 모든 물체를 안전하게 "
"격리하는 이중 목적 플랫폼입니다. 외부 콘솔에서 작동합니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "junk metal floor"
msgstr "잡동사니 금속 바닥"

#. ~ Description for junk metal floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A simple roof and floor of rusty scrap metal bolted and wire-tied to a "
"makeshift frame.  Very fashionable in post-apocalyptic shantytowns.  Hope "
"you like the sound of rain on corrugated metal."
msgstr ""
"수제 프레임에 볼트로 고정하고 철사로 묶은 녹슨 고철 금속의 단순한 지붕과 바닥이다. 포스트 아포칼립스 판자촌에서 매우 유행한다. 골진 "
"금속 위에 빗소리를 좋아하기 바란다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "dirt"
msgstr "땅"

#. ~ Description for dirt
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"It's dirt.  Looks like some fine soil for tillage.  Could also be dug out "
"for construction projects."
msgstr "흙이다. 경작에 좋은 토양처럼 보인다. 건설 프로젝트를 위해 파낼 수도 있다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
#: data\json\items\chemicals_and_resources.json
msgid "sand"
msgid_plural "sand"
msgstr[0] "모래"

#. ~ Description for sand
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A large area of fine sand that could be useful in a number of ways, if it "
"was extracted properly.  Dig a shallow pit here to harvest the sand."
msgstr "제대로 채취하면 여러모로 쓸모 있는 고운 모래가 넓은 지역에 있습니다. 여기에 얕은 구덩이를 파서 모래를 수확하세요."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "mud"
msgstr "진흙"

#. ~ Description for mud
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "An area of wet, slick mud."
msgstr "축축하고 미끄러운 진흙 지역입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "moss"
msgstr "이끼"

#. ~ Description for moss
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "Moist spongy moss."
msgstr "촉촉하고 스펀지 같은 이끼다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "clay"
msgstr "점토"

#. ~ Description for clay
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A field full of malleable clay, suitable for kiln firing if it was extracted"
" properly.  Dig a shallow pit here to harvest the clay."
msgstr "제대로 채취하면 가마 소성에 적합한 가소성 점토로 가득한 지대입니다. 여기에 얕은 구덩이를 파서 점토를 수확하세요."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "mound of clay"
msgstr "점토더미"

#. ~ Description for mound of clay
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "A mound of clay soil."
msgstr "점토 흙 더미입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "paper floor"
msgstr "종이 바닥"

#. ~ Description for paper floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "Floor made of pulpy mass, covered in sticky wasp saliva."
msgstr "펄프 덩어리로 된 바닥으로, 끈적한 말벌 침이 덮여 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "hard paper floor"
msgstr "단단한 종이 바닥"

#. ~ Description for hard paper floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Hardened cardboard floor made of chewed up trees and resin mixed with wasp "
"saliva."
msgstr "말벌 침과 섞인 씹힌 나무와 수지로 만든 경화된 판지 바닥입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "paper brood cap"
msgstr "종이 번데기 덮개"

#. ~ Description for paper brood cap
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"A thin paper floor, protecting the pupatig wasp larva until it's ready to "
"emerge."
msgstr "우화 준비가 될 때까지 번데기가 되는 말벌 유충을 보호하는 얇은 종이 바닥입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-roofs.json
#: data\json\overmap\overmap_terrain\overmap_terrain.json
#: data\json\overmap\overmap_terrain\overmap_terrain_commercial.json
#: data\json\overmap\overmap_terrain\overmap_terrain_evac_center.json
#: data\json\overmap\overmap_terrain\overmap_terrain_hardcoded.json
#: data\json\overmap\overmap_terrain\overmap_terrain_lab.json
#: data\json\overmap\overmap_terrain\overmap_terrain_mall.json
#: data\json\overmap\overmap_terrain\overmap_terrain_military.json
#: data\json\overmap\overmap_terrain\overmap_terrain_residential.json
#: data\json\overmap\overmap_terrain\overmap_terrain_robofachq.json
#: data\json\overmap\overmap_terrain\overmap_terrain_waste_junk.json
#: data\mods\Arcana_BN\overmap_and_mapgen\overmap_terrain.json
#: data\mods\alt_map_key\overmap_terrain.json
msgid "open air"
msgstr "허공"

#. ~ Description for open air
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "This is open air."
msgstr "탁 트인 공간입니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "quarry hole air"
msgstr "채석장 구멍 공기"

#. ~ Description for quarry hole air
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"This is effectively open air, with a frame bracing to ensure anything around"
" it doesnt collapse into it. Blocks roofs, but deconstructing the bracing "
"would be rather easy."
msgstr ""
"사실상 트인 공기로, 주변이 무너지지 않도록 프레임 버팀대가 있습니다. 지붕을 차단하지만, 버팀대를 해체하는 건 꽤 쉽습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "crude plank bridge"
msgstr "조잡한 판자 다리"

#. ~ Description for crude plank bridge
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "A gathering of planks over a large hole or air. Not very sturdy."
msgstr "큰 구멍이나 공기 위에 놓인 판자 모음입니다. 별로 튼튼하지 않습니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid "metal bridge"
msgstr "금속 다리"

#. ~ Description for metal bridge
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Some sturdy metal sheets welded into a makeshift bridge. Suprisingly sturdy."
msgstr "튼튼한 금속 판을 용접해 만든 사제 다리입니다. 놀랄 만큼 튼튼합니다."

#: data\json\furniture_and_terrain\terrain-floors-indoor.json
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "adobe floor"
msgstr "아도베 바닥"

#. ~ Description for adobe floor
#: data\json\furniture_and_terrain\terrain-floors-indoor.json
msgid ""
"Adobe bricks and mortar smoothed out to make a clean fireproof floor, with a"
" matching roof of adobe."
msgstr "아도베 벽돌과 모르타르를 다듬어 만든 깨끗한 내화 바닥으로, 어울리는 아도베 지붕이 있습니다."

#. ~ Description for mound of clay
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "A mound of clay soil.  Dig a shallow pit here to harvest the clay."
msgstr "점토 흙 더미입니다. 여기에 얕은 구덩이를 파서 점토를 수확하세요."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "mound of sand"
msgstr "모래더미"

#. ~ Description for mound of sand
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "A mound of sand.  Dig a shallow pit here to harvest the sand."
msgstr "모래 더미입니다. 여기에 얕은 구덩이를 파서 모래를 수확하세요."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "bog iron"
msgstr "늪철"

#. ~ Description for bog iron
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A wet pit with exposed hints of iron-rich earth.  Dig a shallow pit here to "
"stake your claim on the ore."
msgstr "철분이 풍부한 흙의 흔적이 드러난 축축한 구덩이입니다. 여기에 얕은 구덩이를 파서 광석에 대한 권리를 주장하세요."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "alluvial deposit"
msgstr "충적 광상"

#. ~ Description for alluvial deposit
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A patch of wet sediment washed ashore by the steady flow of a river, often "
"containing mineral deposits.  And washed-up litter, thanks to pre-cataclysm "
"humanity.  Dig a shallow pit here to see if you strike paydirt."
msgstr ""
"강의 꾸준한 흐름에 씻겨 온 축축한 퇴적물 지대로, 종종 광물 퇴적층이 있습니다. 그리고 대재앙 전 인류 덕분에 씻겨온 쓰레기도요. "
"여기에 얕은 구덩이를 파서 금맥을 발견하는지 확인해보세요."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
#: data\json\overmap\overmap_terrain\overmap_terrain.json
msgid "mound of dirt"
msgstr "흙더미"

#. ~ Description for mound of dirt
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"An area of heaped dirt, not easily traversable.  If examined more closely, "
"it's quite favorable for planting seeds and the like."
msgstr "쉽게 통과하기 어려운 쌓인 흙 지역이다. 더 자세히 살펴보면 씨앗 등을 심기에 꽤 좋은 환경이다."

#. ~ Description for mound of dirt
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A giant hill of dirt that looks like you could crawl inside for shelter."
msgstr "안에 들어가서 대피할 수 있을 것 같은 거대한 흙 더미다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "paddy field"
msgstr "논"

#. ~ Description for paddy field
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A damp, muddy field used to grow crops that require a lot of water.  The "
"clay holds moisture, making it perfect for the crops."
msgstr "물이 많이 필요한 작물을 기르는 데 쓰이는 축축하고 진흙투성이 논입니다. 점토가 수분을 유지해서 작물에 완벽합니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "ooze bog"
msgstr "진흙 늪"

#. ~ Description for ooze bog
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A pit filled with muddy water.  With additional work, some clay could be "
"separated from the silt."
msgstr "진흙탕물이 채워진 구덩이입니다. 추가 작업으로 미사에서 점토 일부를 분리할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "odd fault"
msgstr "특이한 단층"

#. ~ Description for odd fault
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"An unnaturally humanoid-shaped hole, it seems oddly familiar.  There's a "
"strange sensation to examine it closer, as if it belongs to you somehow."
msgstr ""
"부자연스럽게 인간 형상을 한 구멍으로, 묘하게 낯익다. 어째서인지 마치 당신 것인 양 더 가까이 살펴보고 싶은 이상한 감각이 있다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "grave"
msgstr "무덤"

#. ~ Description for grave
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A dirt grave, with some grass growing on it.  At least some of the dead do "
"actually rest in peace."
msgstr "풀이 조금 자란 흙 무덤입니다. 최소한 일부 죽은 자들은 실제로 평안히 잠들어 있습니다."

#. ~ Description for grave
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A fresh grave, covered with stones, either to keep something from digging it"
" out or to keep one inside from digging out of it.  Two planks mark this "
"place of someone's eternal rest."
msgstr ""
"무언가가 파내지 못 하게 하거나 안의 것이 파고 나오지 못 하게 하기 위해 돌로 덮인 새 무덤입니다. 두 개의 판자가 누군가의 영원한 "
"안식처를 표시합니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "pavement"
msgstr "도로"

#. ~ Description for pavement
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A segment of asphalt, slowly degrading from cracks, frost heaves and lack of"
" maintenance."
msgstr "균열, 결빙 융기 및 유지 관리 부재로 서서히 열화되는 아스팔트 구역이다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "yellow pavement"
msgstr "중앙선"

#. ~ Description for yellow pavement
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"Streaks of carefully aligned yellow paint mark the road to inform drivers "
"not to cross.  No one is enforcing these rules anymore."
msgstr ""
"운전자에게 교차하지 말라는 것을 알리는 신중하게 배치된 노란색 페인트 줄무늬가 도로에 있다. 이제 이 규칙을 시행하는 사람은 아무도 "
"없다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "sidewalk"
msgstr "인도"

#. ~ Description for sidewalk
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"An area of common poured concrete, damaged by frost heaves and large cracks "
"due to lack of maintenance."
msgstr "유지 관리 부재로 결빙 융기와 큰 균열이 생긴 일반적인 부어진 콘크리트 지역이다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
#: data\json\items\generic.json
msgid "concrete"
msgid_plural "concrete"
msgstr[0] "콘크리트"

#. ~ Description for concrete
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles."
msgstr "미적 감각과 동결-해동 사이클에 대한 저항성을 위한 표면 마감재가 적용된 새로운 부어진 콘크리트 구역이다."

#. ~ Description for concrete
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A newer segment of poured concrete with surface finishes for aesthetics and "
"resistance to freeze-thaw cycles.  Covered with a streak of yellow paint."
msgstr "미관과 동결-융해 주기 저항성을 위한 표면 마감이 있는 새로 부어넣은 콘크리트 구간입니다. 노란 페인트 자국이 있습니다."

#. ~ Description for wooden floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"Wooden floor created from boards, packed tightly together and nailed down.  "
"Common in patios."
msgstr "촘촘히 맞추고 못 박은 판자로 만든 목재 바닥입니다. 테라스에 흔합니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "underwater wooden floor"
msgstr "수중 목재 바닥"

#. ~ Description for underwater wooden floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "Rotting old floorboards long since repurposed as Davy Jones's patio."
msgstr "오래전에 데이비 존스의 테라스로 용도 변경된 썩은 낡은 마루판입니다."

#. ~ Description for metal floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"High-quality and tough checkered flooring to reduce risk of slips and falls."
msgstr "미끄러짐과 낙상 위험을 줄이는 고품질 튼튼한 체크무늬 바닥입니다."

#. ~ Description for junk metal floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A simple floor of rusty scrap metal bolted and wire-tied to a makeshift "
"frame.  Very fashionable in post-apocalyptic shantytowns."
msgstr "녹슨 고철을 볼트와 철사로 사제 프레임에 묶은 간단한 바닥입니다. 포스트 아포칼립스 판자촌에서 아주 유행입니다."

#. ~ Description for dirt floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "Floor consisting of finely mixed earth that has been tamped down."
msgstr "다져진 고운 흙으로 이루어진 바닥이다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "orifice"
msgstr "개구부"

#. ~ Description for orifice
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A large round orifice with trails of fresh and dried up strange green liquid"
" with a strong acid odor covering its inner sides."
msgstr "강한 산 냄새가 나는 이상한 녹색 액체의 신선한 자국과 말라붙은 자국이 안쪽을 덮은 커다란 둥근 개구부입니다."

#. ~ Description for elevator
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "An elevator section of the flight deck."
msgstr "비행 갑판의 엘리베이터 구간입니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "deck coating"
msgstr "갑판 코팅"

#. ~ Description for deck coating
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"Thick metal coating of a hull, covered with a military grade epoxy mix.  "
"Used for runways, and can't be melted by jet engine nozzles."
msgstr "군용 등급 에폭시 혼합물이 덮인 선체의 두꺼운 금속 코팅입니다. 활주로에 사용되며 제트 엔진 노즐로도 녹일 수 없습니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "yellow deck coating"
msgstr "노란색 갑판 코팅"

#. ~ Description for yellow deck coating
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"Thick metal covering of a hull, covered with a military grade epoxy mix, and"
" painted in yellow color."
msgstr "군용 등급 에폭시 혼합물이 덮이고 노란색으로 칠해진 선체의 두꺼운 금속 덮개입니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "red deck coating"
msgstr "빨간색 갑판 코팅"

#. ~ Description for red deck coating
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"Thick metal covering of a hull, covered with a military grade epoxy mix, and"
" painted in red color."
msgstr "군용 등급 에폭시 혼합물이 덮이고 빨간색으로 칠해진 선체의 두꺼운 금속 덮개입니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "white deck coating"
msgstr "흰색 갑판 코팅"

#. ~ Description for white deck coating
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"Thick metal covering of a hull, covered with a military grade epoxy mix, and"
" painted in white color."
msgstr "군용 등급 에폭시 혼합물이 덮이고 흰색으로 칠해진 선체의 두꺼운 금속 덮개입니다."

#. ~ Description for concrete floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "A bare and cold concrete floor with a streak of yellow paint."
msgstr "노란 페인트 자국이 있는 휑하고 차가운 콘크리트 바닥입니다."

#. ~ Description for concrete floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "A bare and cold concrete floor."
msgstr "휑하고 차가운 콘크리트 바닥입니다."

#. ~ Description for adobe floor
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "Adobe bricks and mortar smoothed out to make a clean fireproof floor."
msgstr "아도베 벽돌과 모르타르를 다듬어 만든 깨끗한 내화 바닥입니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "trash island"
msgstr "쓰레기 섬"

#. ~ Description for trash island
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A small section of floating trash debris, neatly tied and packed together."
msgstr "깔끔하게 묶고 채운, 떠다니는 쓰레기 잔해의 작은 구역입니다."

#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid "sandy trash island"
msgstr "모래 쓰레기 섬"

#. ~ Description for sandy trash island
#: data\json\furniture_and_terrain\terrain-floors-outdoors.json
msgid ""
"A small section of floating trash debris, neatly tied and packed together.  "
"This section has been covered with sand and soil, making it more stable and "
"able to sustain certain plants."
msgstr ""
"깔끔하게 묶고 채운, 떠다니는 쓰레기 잔해의 작은 구역입니다. 이 구역은 모래와 흙으로 덮여 더 안정적이고 특정 식물을 키울 수 "
"있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "walnut tree"
msgstr "호두나무"

#. ~ Description for walnut tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive tree belonging to the 'Juglans' genus.  If you look closely you "
"can see some unharvested walnuts.  You could cut it down with the right "
"tools."
msgstr "'Juglans' 속에 속하는 거대한 나무다. 자세히 보면 수확되지 않은 호두가 보인다. 적절한 도구로 베어낼 수 있다."

#. ~ Description for walnut tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive tree belonging to the 'Juglans' genus.  You could cut it down with"
" the right tools."
msgstr "'Juglans' 속에 속하는 거대한 나무다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "blackjack oak"
msgstr "블랙잭 오크"

#. ~ Description for blackjack oak
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  You could peel off the bark "
"sections if you examined the tree more closely.  You could cut it down with "
"the right tools."
msgstr ""
"나무 껍질이 좁은 오렌지색 균열로 갈라진 직사각형 검은 판으로 금이 간 참나무속('Quercus')의 낙엽수입니다. 나무를 더 자세히 "
"조사하면 껍질 조각을 벗길 수 있습니다. 적절한 도구로 벌목할 수 있습니다."

#. ~ Description for blackjack oak
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A deciduous tree of the genus 'Quercus', with bark cracked into rectangular "
"black plates split by narrow orange fissures.  All usable bark has been "
"stripped off.  You could cut it down with the right tools."
msgstr ""
"나무 껍질이 좁은 오렌지색 균열로 갈라진 직사각형 검은 판으로 금이 간 참나무속('Quercus')의 낙엽수입니다. 사용 가능한 껍질은 "
"전부 벗겨졌습니다. 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "chestnut tree"
msgstr "밤나무"

#. ~ Description for chestnut tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive tree belonging to the 'Castanea' genus.  If you look closely you "
"can see some unharvested chestnuts.  You could cut it down with the right "
"tools."
msgstr "'Castanea' 속에 속하는 거대한 나무다. 자세히 보면 수확되지 않은 밤이 보인다. 적절한 도구로 베어낼 수 있다."

#. ~ Description for chestnut tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive tree belonging to the 'Castanea' genus.  You could cut it down "
"with the right tools."
msgstr "'Castanea' 속에 속하는 거대한 나무다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "beech tree"
msgstr "너도밤나무"

#. ~ Description for beech tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive tree belonging to the 'Fagus' genus.  If you look closely you can "
"see some unharvested beech nuts.  You could cut it down with the right "
"tools."
msgstr "'Fagus' 속에 속하는 거대한 나무다. 자세히 보면 수확되지 않은 너도밤이 보인다. 적절한 도구로 베어낼 수 있다."

#. ~ Description for beech tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive tree belonging to the 'Fagus' genus.  You could cut it down with "
"the right tools."
msgstr "'Fagus' 속에 속하는 거대한 나무다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "hazelnut tree"
msgstr "개암나무"

#. ~ Description for hazelnut tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  If you look closely you can"
" see some unharvested hazelnuts.  You could cut it down with the right "
"tools."
msgstr "'Corylus' 속에 속하는 작은 나무다. 자세히 보면 수확되지 않은 개암이 보인다. 적절한 도구로 베어낼 수 있다."

#. ~ Description for hazelnut tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A stubby tree belonging to the 'Corylus' genus.  You could cut it down with "
"the right tools."
msgstr "'Corylus' 속에 속하는 작은 나무다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "oak tree"
msgstr "오크 나무"

#. ~ Description for oak tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout New England region.  If you look closely you can see some acorns "
"the squirrels haven't gotten yet.  You could cut it down with the right "
"tools."
msgstr ""
"뉴잉글랜드 지역 전체에서 흔히 발견되는 'Quercus' 속에 속하는 거대한 낙엽수다. 자세히 보면 다람쥐가 아직 가져가지 않은 도토리가"
" 보인다. 적절한 도구로 베어낼 수 있다."

#. ~ Description for oak tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A massive deciduous tree belonging to the 'Quercus' genus, commonly found "
"throughout New England region.  You could cut it down with the right tools."
msgstr "뉴잉글랜드 지역 전체에서 흔히 발견되는 'Quercus' 속에 속하는 거대한 낙엽수다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "cottonwood tree"
msgstr "미루나무"

#. ~ Description for cottonwood tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A large tree belonging to the 'Populus' genus, commonly found throughout New"
" England region.  You could cut it down with the right tools."
msgstr "뉴잉글랜드 지역 전체에서 흔히 발견되는 'Populus' 속에 속하는 큰 나무다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "elm tree"
msgstr "느릅나무"

#. ~ Description for elm tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A large tree belonging to the 'Ulmus' genus, commonly found throughout New "
"England region.  You could cut it down with the right tools."
msgstr "뉴잉글랜드 지역 전체에서 흔히 발견되는 'Ulmus' 속에 속하는 큰 나무다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "dead tree"
msgstr "죽은 나무"

#. ~ Description for dead tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"An indiscernible tree that has withered away, whether by weather, fire or "
"otherworldy.  You could cut it down with the right tools."
msgstr "날씨, 불 또는 다른 세상의 이유로 시들어 버린 알 수 없는 나무다. 적절한 도구로 베어낼 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "young tree"
msgstr "어린 나무"

#. ~ Description for young tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A relatively young sapling of an indeterminate species.  It could take "
"decades before reaching maturity, so there's no use waiting around."
msgstr "불확실한 종의 비교적 어린 나무 묘목이다. 성숙하려면 수십 년이 걸릴 수 있으니 기다려봐야 소용없다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "apple tree"
msgstr "사과 나무"

#. ~ Description for apple tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known "
"as apples.  If you examined the branches more closely, you could probably "
"find a few mature ones in autumn."
msgstr ""
"이 나무는 흔히 사과로 알려진 열매를 맺는 'Malus' 속의 일원입니다. 가지를 더 자세히 조사하면 가을에 여읜 것 몇 개를 찾을 수 "
"있을 겁니다."

#. ~ Description for apple tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This tree is a member of the 'Malus' genus, producing fruit commonly known "
"as apples.  There doesn't appear to be any ripe apples now.  You could also "
"cut it down with the right tools."
msgstr ""
"'Malus' 속에 속하는 이 나무는 사과로 알려진 과일을 생산한다. 지금은 익은 사과가 없는 것 같다. 적절한 도구로 베어낼 수도 "
"있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "pear tree"
msgstr "배 나무"

#. ~ Description for pear tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces viable "
"pears in the fall.  If you examined the branches more closely, you could "
"probably find a few mature ones.  You could also cut it down with the right "
"tools."
msgstr ""
"'Pyrus communis' 즉 일반 배나무로, 가을에 열매를 맺는다. 가지를 자세히 살펴보면 몇 개의 익은 것을 찾을 수 있을 "
"것이다. 적절한 도구로 베어낼 수도 있다."

#. ~ Description for pear tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This is 'Pyrus communis', or the common pear tree, which produces viable "
"pears in the fall.  Looks like all the ripe pears have been picked.  You "
"could also cut it down with the right tools."
msgstr ""
"'Pyrus communis' 즉 일반 배나무로, 가을에 열매를 맺는다. 익은 배가 모두 수확된 것 같다. 적절한 도구로 베어낼 수도 "
"있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "coffee tree"
msgstr "커피나무"

#. ~ Description for coffee tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This is 'gymnocladus dioicus', or the kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  If you examined the "
"branches more closely, you could probably find a few mature ones.  You could"
" also cut it down with the right tools."
msgstr ""
"'gymnocladus dioicus' 즉 켄터키 커피나무로, 가을에 구울 수 있는 커피 꼬투리와 우려낼 수 있는 잎을 생산한다. 가지를"
" 자세히 살펴보면 몇 개의 익은 것을 찾을 수 있을 것이다. 적절한 도구로 베어낼 수도 있다."

#. ~ Description for coffee tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This is 'gymnocladus dioicus', or the kentucky coffee tree, which produces "
"roastable coffee pods and brewable leaves in the fall.  Looks like all the "
"ripe pods have been picked.  You could also cut it down with the right "
"tools."
msgstr ""
"'gymnocladus dioicus' 즉 켄터키 커피나무로, 가을에 구울 수 있는 커피 꼬투리와 우려낼 수 있는 잎을 생산한다. 익은 "
"꼬투리가 모두 수확된 것 같다. 적절한 도구로 베어낼 수도 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "cherry tree"
msgstr "체리 나무"

#. ~ Description for cherry tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  If you examined the foliage more closely, you could"
" probably find some viable clusters.  You could also cut it down with the "
"right tools."
msgstr ""
"뉴잉글랜드에서 발견되는 여러 'Prunus' 종의 나무 중 하나로, 여름에 체리를 맺는다. 나뭇잎을 자세히 살펴보면 수확 가능한 무리를 "
"찾을 수 있을 것이다. 적절한 도구로 베어낼 수도 있다."

#. ~ Description for cherry tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"cherries in the summer.  Looks like all the ripe bunches of cherries have "
"been picked.  You could also cut it down with the right tools."
msgstr ""
"뉴잉글랜드에서 발견되는 여러 'Prunus' 종의 나무 중 하나로, 여름에 체리를 맺는다. 익은 체리 무리가 모두 수확된 것 같다. "
"적절한 도구로 베어낼 수도 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "juniper tree"
msgstr "노간주나무"

#. ~ Description for juniper tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries"
" grow over two to three years, first flowering.  On the second year "
"producing a green berry, the last, they produce their more famed blue "
"varieties.  If you examined the foliage more closely, you could probably "
"find some viable clusters.  You could also cut it down with the right tools."
msgstr ""
"뉴잉글랜드에서 자라는 'Juniperus' 종 중 하나로, 노간주 열매는 2~3년에 걸쳐 자라며 먼저 꽃이 핍니다. 둘째 해엔 녹색 "
"열매를, 마지막엔 더 유명한 파란색 품종을 맺습니다. 잎사귀를 더 자세히 조사하면 쓸 만한 송이를 찾을 수 있을 겁니다. 적절한 도구로 "
"벌목할 수도 있습니다."

#. ~ Description for juniper tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the species of 'Juniperus' that grows in New England, juniper berries"
" grow over two to three years.  In the first year they flower, in the second"
" year they produce a green berry, the last, they produce their more famed "
"blue varieties.  Looks like all the ripe bunches of berries have been "
"picked.  You could also cut it down with the right tools."
msgstr ""
"뉴잉글랜드에서 자라는 'Juniperus' 종 중 하나로, 노간주 열매는 2~3년에 걸쳐 자랍니다. 첫 해엔 꽃이 피고, 둘째 해엔 녹색"
" 열매를, 마지막엔 더 유명한 파란색 품종을 맺습니다. 잘 여읜 열매 송이는 전부 따간 것 같습니다. 적절한 도구로 벌목할 수도 "
"있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "peach tree"
msgstr "복숭아 나무"

#. ~ Description for peach tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  If you examined the branches more closely, you could"
" probably find some mature peaches.  You could also cut it down with the "
"right tools."
msgstr ""
"뉴잉글랜드에서 발견되는 여러 'Prunus' 종의 나무 중 하나로, 여름에 복숭아를 맺는다. 가지를 자세히 살펴보면 몇 개의 익은 "
"복숭아를 찾을 수 있을 것이다. 적절한 도구로 베어낼 수도 있다."

#. ~ Description for peach tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it bears "
"peaches in the summer.  Looks like all the ripe peaches have been picked.  "
"You could also cut it down with the right tools."
msgstr ""
"뉴잉글랜드에서 발견되는 여러 'Prunus' 종의 나무 중 하나로, 여름에 복숭아를 맺는다. 익은 복숭아가 모두 수확된 것 같다. 적절한"
" 도구로 베어낼 수도 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "apricot tree"
msgstr "살구 나무"

#. ~ Description for apricot tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  If you examined the spurs more closely,"
" you could probably find some mature apricots.  You could also cut it down "
"with the right tools."
msgstr ""
"뉴잉글랜드에서 거의 발견되지 않는 이식된 'Prunus armeniaca' 종이다. 여름에 살구를 생산한다. 짧은 가지를 자세히 살펴보면"
" 몇 개의 익은 살구를 찾을 수 있을 것이다. 적절한 도구로 베어낼 수도 있다."

#. ~ Description for apricot tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A transplanted species of 'Prunus armeniaca', rarely found in New England.  "
"It produces apricots in the summer.  Looks like all the ripe apricots have "
"been picked.  You could also cut it down with the right tools."
msgstr ""
"뉴잉글랜드에서 거의 발견되지 않는 이식된 'Prunus armeniaca' 종이다. 여름에 살구를 생산한다. 익은 살구가 모두 수확된 것"
" 같다. 적절한 도구로 베어낼 수도 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "plum tree"
msgstr "자두 나무"

#. ~ Description for plum tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  If you examined the spurs more closely, you "
"could probably find some ripe plums.  You could also cut it down with the "
"right tools."
msgstr ""
"뉴잉글랜드에서 발견되는 여러 'Prunus' 종의 나무 중 하나로, 여름에 자두를 생산한다. 짧은 가지를 자세히 살펴보면 몇 개의 익은 "
"자두를 찾을 수 있을 것이다. 적절한 도구로 베어낼 수도 있다."

#. ~ Description for plum tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"One of the several species of 'Prunus' trees found in New England, it "
"produces plums in the summer.  Looks like all the ripe plums have been "
"picked.  You could also cut it down with the right tools."
msgstr ""
"뉴잉글랜드에서 발견되는 여러 'Prunus' 종의 나무 중 하나로, 여름에 자두를 생산한다. 익은 자두가 모두 수확된 것 같다. 적절한 "
"도구로 베어낼 수도 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "mulberry tree"
msgstr "뽕나무"

#. ~ Description for mulberry tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known "
"as mulberries.  In the summer many berries can be picked.  You could also "
"cut it down with the right tools."
msgstr ""
"'Morus' 속에 속하는 이 나무는 오디로 알려진 과일을 생산한다. 여름에 많은 열매를 딸 수 있다. 적절한 도구로 베어낼 수도 있다."

#. ~ Description for mulberry tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This tree is a member of the 'Morus' genus, producing fruit commonly known "
"as mulberries.  There doesn't appear to be any ripe mulberries now.  You "
"could also cut it down with the right tools."
msgstr ""
"'Morus' 속에 속하는 이 나무는 오디로 알려진 과일을 생산한다. 지금은 익은 오디가 없는 것 같다. 적절한 도구로 베어낼 수도 "
"있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "elderberry tree"
msgstr "딱총나무"

#. ~ Description for elderberry tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly "
"known as elderberries.  In the summer many berries can be picked.  You could"
" also cut it down with the right tools."
msgstr ""
"'Sambucus' 속에 속하는 이 나무는 엘더베리로 알려진 과일을 생산한다. 여름에 많은 열매를 딸 수 있다. 적절한 도구로 베어낼 "
"수도 있다."

#. ~ Description for elderberry tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"This tree is a member of the 'Sambucus' genus, producing fruit commonly "
"known as elderberries.  There doesn't appear to be any ripe elderberries "
"now.  You could also cut it down with the right tools."
msgstr ""
"'Sambucus' 속에 속하는 이 나무는 엘더베리로 알려진 과일을 생산한다. 지금은 익은 엘더베리가 없는 것 같다. 적절한 도구로 "
"베어낼 수도 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "pine tree"
msgstr "소나무"

#. ~ Description for pine tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"If you examined the tree more closely, you might find usable sticky whorls "
"and unharvested pinecones.  Also, you could cut it down with the right "
"tools."
msgstr ""
"뉴잉글랜드 종이 'P. strobus', 'P. resinosa', 'P. rigida'로 다양한 'Pinus' 속에 속하는 우뚝 솟은 "
"침엽수다. 나무를 자세히 살펴보면 사용할 수 있는 끈적한 솔방울 가지와 수확되지 않은 솔방울을 찾을 수 있다. 적절한 도구로 베어낼 수도"
" 있다."

#. ~ Description for pine tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"Some of the branches have been stripped away and many of the pinecones "
"aren't developed fully yet, but given a season, it could be harvestable "
"again.  Also, you could cut it down with the right tools."
msgstr ""
"뉴잉글랜드 종은 'P. strobus', 'P. resinosa', 'P. rigida' 등 다양한 'Pinus' 속의 우뚝 솟은 "
"침엽수입니다. 일부 가지가 벗겨졌고 솔방울 대부분이 아직 충분히 발달하지 않았지만, 한 계절이 지나면 다시 수확할 수 있습니다. 또한 "
"적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "dead pine tree"
msgstr "죽은 소나무"

#. ~ Description for dead pine tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A towering coniferous tree that belongs to the 'Pinus' genus, with the New "
"England species varying from 'P. strobus', 'P. resinosa' and 'P. rigida'.  "
"This trees branches are bare, and it appears to be dead.  You could cut it "
"down with the right tools."
msgstr ""
"뉴잉글랜드 종은 'P. strobus', 'P. resinosa', 'P. rigida' 등 다양한 'Pinus' 속의 우뚝 솟은 "
"침엽수입니다. 이 나무는 가지가 벌거벗었고 죽은 것 같습니다. 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "birch tree"
msgstr "자작나무"

#. ~ Description for birch tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling"
" bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  You could tear "
"off some strips of bark if you examined the tree more closely.  You could "
"cut it down with the right tools."
msgstr ""
"특징적인 벗겨지는 껍질을 가진 'Betula' 속의 키 큰 낙엽수로, 'B. alleghaniensis', 'B. papyrifera',"
" 'B. populifolia'가 뉴잉글랜드 지역에서 가장 흔하다. 나무를 자세히 살펴보면 껍질 조각을 뜯어낼 수 있다. 적절한 도구로 "
"베어낼 수 있다."

#. ~ Description for birch tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Betula' genus, with the characteristic peeling"
" bark.  Species like 'B. alleghaniensis', 'B. papyrifera', and 'B. "
"populifolia' are the most common in the New England region.  Looks like "
"there isn't enough rhytidome to peel off yet.  You could cut it down with "
"the right tools."
msgstr ""
"특징적인 벗겨지는 껍질을 가진 'Betula' 속의 키 큰 낙엽수로, 'B. alleghaniensis', 'B. papyrifera',"
" 'B. populifolia'가 뉴잉글랜드 지역에서 가장 흔하다. 아직 뜯어낼 껍질이 충분하지 않은 것 같다. 적절한 도구로 베어낼 수"
" 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "willow tree"
msgstr "버드나무"

#. ~ Description for willow tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long thin leafy "
"branches that hang down like curtains.  You could tear off some bark.  You "
"could cut it down with the right tools."
msgstr ""
"커튼처럼 늘어지는 길고 가는 잎가지가 있는 'Salix' 속의 키 크고 넓은 낙엽수입니다. 껍질을 좀 뜯어낼 수 있습니다. 적절한 도구로"
" 벌목할 수 있습니다."

#. ~ Description for willow tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall, wide deciduous tree of the 'Salix' genus, with long thin leafy "
"branches that hang down like curtains.  Looks like all usable bark has been "
"torn off, and new rhytidomes have not formed yet.  You could cut it down "
"with the right tools."
msgstr ""
"커튼처럼 늘어지는 길고 가는 잎가지가 있는 'Salix' 속의 키 크고 넓은 낙엽수입니다. 쓸 수 있는 껍질은 전부 뜯겼고 새 수피는 "
"아직 형성되지 않은 것 같습니다. 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "maple tree"
msgstr "단풍나무"

#. ~ Description for maple tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  It could be tapped in order to extract maple "
"syrup.  You could cut it down with the right tools."
msgstr ""
"'Acer' 속의 큰 낙엽수입니다. 잎은 특징적인 다섯 갈래 모양입니다. 수액을 받아 메이플 시럽을 추출할 수 있습니다. 적절한 도구로 "
"벌목할 수 있습니다."

#. ~ Description for maple tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A large deciduous tree of the 'Acer' genus.  The leaves are distinctively "
"shaped with five prongs.  A spigot is wedged into the trunk, and sweet maple"
" syrup can be extracted.  You could cut it down with the right tools."
msgstr ""
"'Acer' 속의 큰 낙엽수입니다. 잎은 특징적인 다섯 갈래 모양입니다. 줄기에 꼭지가 꽂혀 있고 달콤한 메이플 시럽을 추출할 수 "
"있습니다. 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "hickory tree"
msgstr "히코리 나무"

#. ~ Description for hickory tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for hickory nuts"
" if you examined the tree more closely.  You could cut it down with the "
"right tools."
msgstr ""
"'Carya' 속의 키 큰 낙엽수입니다. 나무를 더 자세히 조사하면 히커리 열매를 찾을 수 있습니다. 적절한 도구로 벌목할 수 있습니다."

#. ~ Description for hickory tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It looks like the tree has been"
" picked clean of hickory nuts.  You could cut it down with the right tools."
msgstr "'Carya' 속의 키 큰 낙엽수입니다. 히커리 열매가 깨끗이 따여진 것 같습니다. 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "pistachio tree"
msgstr "피스타치오나무"

#. ~ Description for pistachio tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is"
" not native to this region.  You could look for pistachio nuts if you "
"examined the tree more closely.  You could cut it down with the right tools."
msgstr ""
"'Pistacia' 속의 낙엽수입니다. 재배된 나무로 이 지역 토착종이 아닙니다. 나무를 더 자세히 조사하면 피스타치오 열매를 찾을 수 "
"있습니다. 적절한 도구로 벌목할 수 있습니다."

#. ~ Description for pistachio tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A deciduous tree of the 'Pistacia' genus.  This is a cultivated tree, and is"
" not native to this region.  Unfortunately, it looks like it has been picked"
" clean of pistachio nuts.  You could cut it down with the right tools."
msgstr ""
"'Pistacia' 속의 낙엽수입니다. 재배된 나무로 이 지역 토착종이 아닙니다. 아쉽게도 피스타치오 열매가 깨끗이 따여진 것 같습니다."
" 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "almond tree"
msgstr "아몬드나무"

#. ~ Description for almond tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  You could look for fresh almonds if you examined"
" the tree more closely.  You could cut it down with the right tools."
msgstr ""
"'Prunus' 속의 낙엽수입니다. 재배된 나무로 이 지역 토착종이 아닙니다. 나무를 더 자세히 조사하면 신선한 아몬드를 찾을 수 "
"있습니다. 적절한 도구로 벌목할 수 있습니다."

#. ~ Description for almond tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A deciduous tree of the 'Prunus' genus.  This is a cultivated tree, and is "
"not native to this region.  There are no almonds left to pick on the tree.  "
"You could cut it down with the right tools."
msgstr ""
"'Prunus' 속의 낙엽수입니다. 재배된 나무로 이 지역 토착종이 아닙니다. 나무에 딸 아몬드가 남아있지 않습니다. 적절한 도구로 "
"벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "pecan tree"
msgstr "피칸나무"

#. ~ Description for pecan tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  You could look for pecan nuts "
"if you examined the tree more closely.  You could cut it down with the right"
" tools."
msgstr ""
"'Carya' 속의 키 큰 낙엽수입니다. 나무를 더 자세히 조사하면 피칸 열매를 찾을 수 있습니다. 적절한 도구로 벌목할 수 있습니다."

#. ~ Description for pecan tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tall deciduous tree of the 'Carya' genus.  It doesn't look like there are "
"any pecan nuts left on the tree.  You could cut it down with the right "
"tools."
msgstr "'Carya' 속의 키 큰 낙엽수입니다. 나무에 피칸 열매가 남아있지 않은 것 같습니다. 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "dead hickory tree"
msgstr "죽은 히코리 나무"

#. ~ Description for dead hickory tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"The dead remnants of a tall deciduous tree of the 'Carya' genus.  Nothing "
"useful can be foraged from this poor, dead tree.  You could cut it down with"
" the right tools."
msgstr ""
"'Carya' 속의 키 큰 낙엽수의 죽은 잔해입니다. 이 불쌍한 죽은 나무에서 채집할 쓸모 있는 건 없습니다. 적절한 도구로 벌목할 수 "
"있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
#: data\json\items\comestibles\other.json
msgid "underbrush"
msgid_plural "underbrushes"
msgstr[0] "덤불"

#. ~ Description for underbrush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  An observant forager "
"could obtain edible plants, acorns, eggs, and mushrooms from it."
msgstr "숲을 장식하는 작은 식물과 관목들이다. 관찰력 있는 채집자는 식용 식물, 도토리, 알, 버섯을 얻을 수 있다."

#: data\json\furniture_and_terrain\terrain-flora.json
#: data\json\furniture_and_terrain\terrain-manufactured.json
#: data\mods\desert_region\desert_terrain.json
msgid "brush."
msgstr "스윽."

#. ~ Description for underbrush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it."
msgstr "숲을 장식하는 작은 식물과 관목입니다. 뒤져봤고 채집할 쓸모 있는 건 남아있지 않습니다."

#. ~ Description for underbrush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"Small plants and shrubs that decorate the forest.  It has been rummaged "
"through and doesn't have anything useful left to forage from it.  Frost "
"covers it."
msgstr "숲을 장식하는 작은 식물과 관목입니다. 뒤져봤고 채집할 쓸모 있는 건 남아있지 않습니다. 서리가 덮여 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "shrub"
msgstr "관목"

#. ~ Description for shrub
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small shrub."
msgstr "작은 관목입니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "peanut bush"
msgstr "땅콩 덤불"

#. ~ Description for peanut bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small bush of crunchy peanuts."
msgstr "바삭한 땅콩이 달린 작은 덤불이다."

#. ~ Description for peanut bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small peanut bush that's fruitless."
msgstr "열매가 없는 작은 땅콩 덤불이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "blueberry bush"
msgstr "블루베리 덤불"

#. ~ Description for blueberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small bush of sweet blueberries."
msgstr "달콤한 블루베리가 달린 작은 덤불이다."

#. ~ Description for blueberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small blueberry bush that's fruitless."
msgstr "열매가 없는 작은 블루베리 덤불이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "strawberry bush"
msgstr "딸기 덤불"

#. ~ Description for strawberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small bush of juicy strawberries."
msgstr "즙이 많은 딸기가 달린 작은 덤불이다."

#. ~ Description for strawberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small strawberry bush that's fruitless."
msgstr "열매가 없는 작은 딸기 덤불이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "blackberry bush"
msgstr "블랙베리 덤불"

#. ~ Description for blackberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small bush of delicious blackberries.  Watch out for its thorns!"
msgstr "맛있는 블랙베리가 달린 작은 덤불이다. 가시를 조심해라!"

#. ~ Description for blackberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small blackberry bush that's fruitless.  Watch out for its thorns!"
msgstr "열매가 없는 작은 블랙베리 덤불이다. 가시를 조심해라!"

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "huckleberry bush"
msgstr "허클베리 덤불"

#. ~ Description for huckleberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small bush of huckleberries, often mistaken as blueberries."
msgstr "블루베리로 자주 오인되는 허클베리가 달린 작은 덤불이다."

#. ~ Description for huckleberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small huckleberry bush that's fruitless."
msgstr "열매가 없는 작은 허클베리 덤불이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "raspberry bush"
msgstr "라즈베리 덤불"

#. ~ Description for raspberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small bush of delicious raspberries.  Watch out for its thorns!"
msgstr "맛있는 라즈베리가 달린 작은 덤불이다. 가시를 조심해라!"

#. ~ Description for raspberry bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small raspberry bush that's fruitless.  Watch out for its thorns!"
msgstr "열매가 없는 작은 라즈베리 덤불이다. 가시를 조심해라!"

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "grape bush"
msgstr "포도 덤불"

#. ~ Description for grape bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A bush of a different species invaded by vines of grapes."
msgstr "포도 덩굴에 점령된 다른 종의 덤불이다."

#. ~ Description for grape bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A bush of a different species invaded by grape vines but they're fruitless."
msgstr "포도 덩굴에 점령되었지만 열매가 없는 다른 종의 덤불이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "rose bush"
msgstr "장미 덩굴"

#. ~ Description for rose bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A fat bush of beautiful red roses, if only you could get a date!  Watch out "
"for its thorns!"
msgstr "아름다운 붉은 장미가 가득한 풍성한 덤불이다. 데이트 상대만 있었으면! 가시를 조심해라!"

#. ~ Description for rose bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A fat rose bush that currently has no blooms.  Watch out for its thorns!"
msgstr "현재 꽃이 피지 않은 풍성한 장미 덤불이다. 가시를 조심해라!"

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "hydrangea bush"
msgstr "수국 덤불"

#. ~ Description for hydrangea bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A fat, bush of fragrant blue hydrangeas."
msgstr "향기로운 파란 수국이 가득한 풍성한 덤불이다."

#. ~ Description for hydrangea bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A fat hydrangea bush that currently has no blooms."
msgstr "현재 꽃이 피지 않은 풍성한 수국 덤불이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "lilac bush"
msgstr "라일락 덤불"

#. ~ Description for lilac bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A wide, bush of bright pinkish purple lilacs."
msgstr "밝은 분홍빛 보라 라일락이 가득한 넓은 덤불이다."

#. ~ Description for lilac bush
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A wide lilac bush that currently has no blooms."
msgstr "현재 꽃이 피지 않은 넓은 라일락 덤불이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "tree trunk"
msgstr "나무 줄기"

#. ~ Description for tree trunk
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A section of trunk from a tree that has been cut down.  Can be sawn into "
"logs with the right tool."
msgstr "벌목된 나무의 줄기 한 토막입니다. 적절한 도구로 통나무로 켤 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "sunken tree trunk"
msgstr "가라앉은 나무줄기"

#. ~ Description for sunken tree trunk
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A section of trunk from a tree that has fallen from the shallows above and "
"ended up down here at some point. It's waterlogged and seems to be partially"
" eaten by worms."
msgstr ""
"위의 얕은 곳에서 떨어져 어느 시점에 여기까지 온 나무 줄기 한 토막입니다. 물을 머금었고 벌레에게 일부 갉아먹힌 것 같습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "glub."
msgstr "꼬르륵."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "tree stump"
msgstr "나무 그루터기"

#. ~ Description for tree stump
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A tree stump, remnant of a tree that has been cut down."
msgstr "벌목된 나무의 잔해인 그루터기입니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "woodchips"
msgstr "나무 부스러기"

#. ~ Description for woodchips
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"Small splinters of wood laid out in a layer to prevent unwanted plants from "
"growing."
msgstr "원치 않는 식물이 자라는 것을 막기 위해 깔아놓은 작은 나무 파편들이다."

#: data\json\furniture_and_terrain\terrain-flora.json
#: data\json\items\comestibles\other.json
msgid "grass"
msgid_plural "grasses"
msgstr[0] "풀"

#. ~ Description for grass
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"An area of hardy Kentucky bluegrass about ankle high.  Cutting the grass "
"short enough would destroy the root system, causing this area to turn into a"
" patch of dirt."
msgstr "발목 높이의 튼튼한 켄터키 블루그래스 지역이다. 뿌리 체계가 파괴될 정도로 짧게 자르면 이 지역이 흙 구역으로 변한다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "white grass"
msgstr "하얀 풀"

#. ~ Description for white grass
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A section of Kentucky bluegrass covered in white latex-based paint, with "
"neat lines designed for recreational sports."
msgstr "스포츠용으로 설계된 선명한 선이 그려진 흰색 라텍스 페인트로 덮인 켄터키 블루그래스 구역이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "long grass"
msgstr "긴풀"

#. ~ Description for long grass
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "Long shaggy grass about shin high."
msgstr "길고 무성하게 무릎높이까지 자란 풀"

#: data\json\furniture_and_terrain\terrain-flora.json data\mods\2.7.4
#: KawaiiMaidMod\kawaii_override.json
msgid "tall grass"
msgstr "긴풀"

#. ~ Description for tall grass
#: data\json\furniture_and_terrain\terrain-flora.json data\mods\2.7.4
#: KawaiiMaidMod\kawaii_override.json
msgid "Tall grass about head high."
msgstr "머리높이까지 자란 풀."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "dead grass"
msgstr "죽은 풀"

#. ~ Description for dead grass
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "Long shaggy grass that hasn't been cut recently."
msgstr "길고 무성하게 자랐던 풀을 베어둔 것, 시간이 좀 지난 것 같다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "golf green"
msgstr "골프 그린"

#. ~ Description for golf green
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "Grass mowed very short and neat."
msgstr "매우 짧고 깔끔하게 깎인 잔디다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "golf hole"
msgstr "골프 홀"

#. ~ Description for golf hole
#: data\json\furniture_and_terrain\terrain-flora.json
msgid "A small plastic cup embedded in the grass."
msgstr "잔디에 박힌 작은 플라스틱 컵이다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "fern"
msgstr "고사리"

#. ~ Description for fern
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A short plant with thousands of leaves which grow in a fractal pattern from "
"the stem."
msgstr "줄기에서 프랙탈 패턴으로 자라는 수천 개의 잎이 있는 낮은 식물입니다."

#. ~ Description for fern
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A short plant with thousands leaves which grow in a fractal pattern, without"
" any curled shoots."
msgstr "줄기에서 프랙탈 패턴으로 자라는 수천 개의 잎이 있는 낮은 식물로, 돌돌 말린 순은 없습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "cacao tree"
msgstr "카카오 나무"

#. ~ Description for cacao tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A thick tree belonging to the 'Theobroma' genus, native to Central and South"
" America, that has been genetically engineered to withstand New England's "
"four seasons.  If you examined the trunk of the tree, you could probably "
"find some mature cacao pods.  Even in the face of apocalypse, you can't give"
" up chocolate, of course.  You could cut it down with the right tools."
msgstr ""
"중남미 원산으로 뉴잉글랜드의 사계절을 견디도록 유전자 조작된 'Theobroma' 속의 굵은 나무입니다. 줄기를 조사하면 잘 여읜 카카오"
" 열매를 찾을 수 있을 겁니다. 물론 아포칼립스가 와도 초콜릿을 포기할 순 없죠. 적절한 도구로 벌목할 수 있습니다."

#. ~ Description for cacao tree
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A thick tree belonging to the 'Theobroma' genus, native to Central and South"
" America, that has been genetically engineered to withstand New England's "
"four seasons.  Looks like all the ripe cacao pods have been picked.  You "
"could cut it down with the right tools."
msgstr ""
"중남미 원산으로 뉴잉글랜드의 사계절을 견디도록 유전자 조작된 'Theobroma' 속의 굵은 나무입니다. 잘 여읜 카카오 열매는 전부 "
"따여진 것 같습니다. 적절한 도구로 벌목할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "coca plant"
msgstr "코카 나무"

#. ~ Description for coca plant
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tree native to South America, coca leaves have been used as medicine, "
"tonic, and tea for thousands of years.  It was modified to withstand New "
"England weather for medical research, only to be accidentally introduced to "
"the wild.  If you examined the trunk of the tree, you could probably find "
"some mature coca leaves."
msgstr ""
"남미 원산 나무로, 코카 잎은 수천 년간 약과 강장제, 차로 쓰였습니다. 의학 연구를 위해 뉴잉글랜드 날씨를 견디도록 개량됐다가 야생에 "
"우발적으로 유입됐습니다. 줄기를 조사하면 잘 여읜 코카 잎을 찾을 수 있을 겁니다."

#: data\json\furniture_and_terrain\terrain-flora.json
msgid "harvested coca plant"
msgstr "수확된 코카 나무"

#. ~ Description for harvested coca plant
#: data\json\furniture_and_terrain\terrain-flora.json
msgid ""
"A tree native to South America, coca leaves have been used as medicine, "
"tonic, and tea for thousands of years.  Looks like all the coca leaves have "
"been picked."
msgstr "남미 원산 나무로, 코카 잎은 수천 년간 약과 강장제, 차로 쓰였습니다. 코카 잎은 전부 따여진 것 같습니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
#: data\mods\No_Fungi\terrain.json
msgid "marloss bush"
msgstr "말로스 덤불"

#. ~ Description for marloss bush
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid ""
"This alien plant superficially resembles a blueberry bush, and hangs with "
"large, juicy pink pomes that emit a heady, fruity aroma."
msgstr ""
"이 외계 식물은 겉보기엔 블루베리 덤불과 비슷하고, 취할 듯한 과일 향기를 풍기는 크고 즙 많은 분홍색 이과를 매달고 있습니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "poof!"
msgstr "팟!"

#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "fungal bed"
msgstr "진균층"

#. ~ Description for fungal bed
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "Fungus grows thick here, obscuring the ground beneath it."
msgstr "진균이 여기에 무성하게 자라 아래 땅을 가립니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "fungal floor"
msgstr "진균 바닥"

#. ~ Description for fungal floor
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid ""
"Grayish mold coats both the floor and the roof here, silent and still.  "
"Stray spores waft through the air."
msgstr "회백색 곰팡이가 여기 바닥과 지붕을 덮고, 고요하고 정적입니다. 떠돈 포자가 공중에 흩날립니다."

#. ~ Description for fungal floor
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "Grayish mold coats the floor here, silent and still."
msgstr "회백색 곰팡이가 여기 바닥을 덮고, 고요하고 정적입니다."

#. ~ Description for fungal floor
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "Grayish mold coats the ground here, silent and still."
msgstr "회백색 곰팡이가 여기 땅을 덮고, 고요하고 정적입니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
#: data\json\monsters\fungus.json data\mods\Limit Fungal Growth\modinfo.json
msgid "fungal wall"
msgid_plural "fungal walls"
msgstr[0] "진균체 벽"

#. ~ Description for fungal wall
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid ""
"Several thick, large tendrils of fungus perforate the wall here, piercing "
"straight through it from the outside.  Despite the apparent damage, the wall"
" is still structurally sound."
msgstr ""
"굵고 큰 진균 덩굴 몇 개가 여기 벽을 뚫고 밖에서부터 곧장 관통합니다. 눈에 보이는 손상에도 불구하고 벽은 여전히 구조적으로 "
"견고합니다."

#. ~ Description for fungal wall
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid ""
"The fungus here has grown thickly and tightly enough to form a solid wall.  "
"It feels very stiff to the touch, and seems to be very strong."
msgstr "여기 진균은 견고한 벽을 이룰 만큼 빽빽하고 조밀하게 자랐습니다. 만지면 매우 단단하고, 아주 강해 보입니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "fungal mound"
msgstr "진균 더미"

#. ~ Description for fungal mound
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "A mound of fungal matter, intertwined in itself."
msgstr "스스로 얽혀 있는 균사 물질 더미입니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "fungal shrub"
msgstr "진균 관목"

#. ~ Description for fungal shrub
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid ""
"This shrub has been completely absorbed by the mushrooms.  Its branches "
"droop and have lost much of their structure, and its leaves have vanished, "
"replaced by fleshy gray sacks that visibly expand and contract."
msgstr ""
"이 관목은 버섯에 완전히 흡수됐습니다. 가지는 처지고 구조를 많이 잃었으며, 잎은 사라지고 눈에 보이게 수축과 팽창을 반복하는 살집 있는"
" 회색 주머니로 대체됐습니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "fungal tree"
msgstr "진균체 나무"

#. ~ Description for fungal tree
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid ""
"Once tall and majestic, this tree is now a slave to the fungus like the "
"landscape around it.  Its bark is penetrated by and covered with fungal "
"tendrils, and the canopy has rotted away, leaving only the branches, "
"stretching forlornly to the sky as if to escape the infection overrunning "
"it."
msgstr ""
"한때 크고 장엄했던 이 나무는 이제 주변 경관처럼 진균의 노예가 됐습니다. 껍질은 진균 덩굴에 뚫리고 덮였으며, 수관은 썩어 사라져 "
"가지만이 덮치는 감염에서 벗어나려는 듯 쓸쓸하게 하늘로 뻗어 있습니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "young fungal tree"
msgstr "어린 진균 나무"

#. ~ Description for young fungal tree
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid "A small sapling poking through the ground, infested by fungal mold."
msgstr "진균 곰팡이에 감염된, 땅을 뚫고 나온 작은 묘목입니다."

#: data\json\furniture_and_terrain\terrain-fungal.json
#: data\mods\No_Fungi\terrain.json
msgid "marloss tree"
msgstr "말로스 나무"

#. ~ Description for marloss tree
#: data\json\furniture_and_terrain\terrain-fungal.json
msgid ""
"This tree stands as a stark outlier to the landscape around it.  Despite its"
" infestation, its leaves wave proudly in the wind, colored pinkish-white.  "
"Its branches are heavy with pink fruit that looks both mutated and "
"delicious."
msgstr ""
"이 나무는 주변 경관에서 뚜렷하게 튀는 존재로 서 있습니다. 감염됐음에도 불구하고 잎은 분홍빛 흰색으로 바람에 자랑스럽게 흔들립니다. "
"가지에는 변이됐으면서도 맛있어 보이는 분홍 과실이 주렁주렁 달려 있습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "shallow water"
msgstr "얕은 물"

#. ~ Description for shallow water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The water isn't too deep here.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr "여기 물은 그리 깊지 않습니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지 않습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "deep water"
msgstr "깊은 물"

#. ~ Description for deep water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a"
" watertight container, you could gather fresh water from here.  Not safe to "
"drink as is."
msgstr ""
"여기 깊은 물을 뚫고 바닥이 잘 보이지 않습니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지 "
"않습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "murky shallow water"
msgstr "탁한 얕은 물"

#. ~ Description for murky shallow water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The water isn't too deep here but is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"여기 물은 그리 깊지 않지만 유기물로 탁합니다. 밀폐 용기로 여기서 악취 나는 물을 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지"
" 않습니다."

#. ~ Description for murky shallow water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The water isn't too deep here but it is murky with organic matter.  With a "
"watertight container, you could gather fetid water from here.  Not safe to "
"drink as is."
msgstr ""
"여기 물은 그리 깊지 않지만 유기물로 탁합니다. 밀폐 용기로 여기서 악취 나는 물을 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지"
" 않습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "flowing shallow water"
msgstr "흐르는 얕은 물"

#. ~ Description for flowing shallow water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The streaming water isn't too deep here.  With a watertight container, you "
"could gather fresh water from here.  Not safe to drink as is, although "
"probably safer than stagnant water."
msgstr ""
"여기 흐르는 물은 그리 깊지 않습니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 고인 물보다는 안전하겠지만, 있는 그대로 마시는 "
"건 안전하지 않습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "flowing deep water"
msgstr "흐르는 깊은 물"

#. ~ Description for flowing deep water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The streaming water looks deep here.  With a watertight container, you could"
" gather fresh water from here.  Not safe to drink as is, although probably "
"safer than stagnant water."
msgstr ""
"여기 흐르는 물은 깊어 보입니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 고인 물보다는 안전하겠지만, 있는 그대로 마시는 건 "
"안전하지 않습니다."

#. ~ Description for shallow water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The water isn't too deep here.  With a watertight container, you could "
"gather salt water from here."
msgstr "여기 물은 그리 깊지 않습니다. 밀폐 용기로 여기서 바닷물을 채취할 수 있습니다."

#. ~ Description for deep water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"You're having trouble seeing the bottom through the deep water here.  With a"
" watertight container, you could gather salt water from here."
msgstr "여기 깊은 물을 뚫고 바닥이 잘 보이지 않습니다. 밀폐 용기로 여기서 바닷물을 채취할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "pool water"
msgstr "물 웅덩이"

#. ~ Description for pool water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"A deep pool full of water.  Never swim without a lifeguard present.  Even "
"though monsters probably ate them."
msgstr "물이 가득한 깊은 수영장입니다. 안전요원 없이 수영하지 마세요. 괴물이 그들을 잡아먹었을 지도 모르지만요."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "shallow pool water"
msgstr "얕은 수영장 물"

#. ~ Description for shallow pool water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "A shallow pool of water."
msgstr "얕은 물 웅덩이입니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "sewage"
msgstr "하수"

#. ~ Description for sewage
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"Gross.  Sewage water flows through here.  As if it needed saying, this isn't"
" safe to drink."
msgstr "으엑. 하수가 여기로 흐릅니다. 말할 필요도 없지만 마시는 건 안전하지 않습니다."

#. ~ Description for lava
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"An extremely hot, glowing liquid, composed of molten rock and/or metal.  In "
"some places, lava-grilled steak is a delicacy."
msgstr "용융된 암반이나 금속으로 이루어진 극도로 뜨겁고 빛나는 액체입니다. 어떤 곳에선 용암구이 스테이크가 별미입니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "submersed water"
msgstr "잠긴 물"

#. ~ Description for submersed water
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"You are submerged below the surface of the water, your feet can't touch the "
"ground.  With a watertight container, you could gather fresh water from "
"here.  Not safe to drink as is."
msgstr ""
"수면 아래로 잠겨 발이 땅에 닿지 않습니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지 않습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "lake bed"
msgstr "호수 바닥"

#. ~ Description for lake bed
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of fresh water.  With a watertight "
"container, you could gather fresh water from here.  Not safe to drink as is."
msgstr "담수 수역의 바닥에 서 있습니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지 않습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "water moss"
msgstr "물이끼"

#. ~ Description for water moss
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "Moist spongy water moss."
msgstr "축축하고 스펀지 같은 물이끼입니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "ocean bed"
msgstr "해저"

#. ~ Description for ocean bed
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of salt water.  With a watertight "
"container, you could gather salt water from here.  Not safe to drink as is."
msgstr ""
"바닷물 수역의 바닥에 서 있습니다. 밀폐 용기로 여기서 바닷물을 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지 않습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "bulkhead"
msgstr "격벽"

#. ~ Description for bulkhead
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The top of a submerged structure.  With a watertight container, you could "
"gather fresh water from here.  Not safe to drink as is."
msgstr "침수된 구조물의 꼭대기입니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지 않습니다."

#. ~ Description for bulkhead
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"The interior of a submerged structure.  At least this part hasn't flooded "
"yet."
msgstr "침수된 구조물의 내부입니다. 최소한 이 부분은 아직 물에 잠기지 않았습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "underwater bulkhead"
msgstr "수중 격벽"

#. ~ Description for underwater bulkhead
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "The interior of a submerged structure.  This part has been flooded."
msgstr "침수된 구조물의 내부입니다. 이 부분은 물에 잠겼습니다."

#: data\json\furniture_and_terrain\terrain-liquids.json
msgid "submerged concrete"
msgstr "침수된 콘크리트"

#. ~ Description for submerged concrete
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of "
"concrete.  With a watertight container, you could gather fresh water from "
"here.  Not safe to drink as is."
msgstr ""
"담수 수역 바닥의 콘크리트 패드 위에 서 있습니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 있는 그대로 마시는 건 안전하지 "
"않습니다."

#. ~ Description for submerged concrete
#: data\json\furniture_and_terrain\terrain-liquids.json
msgid ""
"You are standing at the bottom of a body of fresh water on a pad of concrete"
" with yelllow paint.  With a watertight container, you could gather fresh "
"water from here.  Not safe to drink as is."
msgstr ""
"담수 수역 바닥의 노란 페인트가 있는 콘크리트 패드 위에 서 있습니다. 밀폐 용기로 여기서 담수를 채취할 수 있습니다. 있는 그대로 "
"마시는 건 안전하지 않습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "gasoline pump"
msgstr "휘발유 펌프"

#. ~ Description for gasoline pump
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"Precious GASOLINE.  The former world bowed to their petroleum god as it led "
"them to their ruin.  There's plenty left over to fuel your inner road "
"warrior.  If this gas dispenser doesn't give up the goods for free, you may "
"have to pay at a nearby terminal."
msgstr ""
"귀중한 휘발유. 이전 세계는 석유 신에게 절했고 그 신은 그들을 파멸로 이끌었습니다. 당신 안의 로드 워리어에게 연료를 줄 만큼 충분히 "
"남아 있습니다. 이 주유기가 무료로 내주지 않는다면 근처 단말기에서 결제해야 할 수도 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "fuel tank"
msgstr "연료 탱크"

#. ~ Description for fuel tank
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A tank filled with gasoline."
msgstr "휘발유가 채워진 탱크입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "broken fuel tank"
msgstr "부서진 연료 탱크"

#. ~ Description for broken fuel tank
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A broken tank which was filled with gasoline."
msgstr "휘발유가 채워져 있던 부서진 탱크입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "smashed gas pump"
msgstr "박살난 가스 펌프"

#. ~ Description for smashed gas pump
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"The horror!  This gasoline pump has been destroyed, denying you access to "
"the liquid gold."
msgstr "끔찍합니다! 이 휘발유 펌프는 파괴되어 액체 황금에 접근할 수 없습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "diesel pump"
msgstr "디젤 펌프"

#. ~ Description for diesel pump
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This is a diesel fuel pump.  This roadside attraction provides all the "
"thick, gloopy liquid POWER you need to move your sensibly oversized "
"APOCOLYPTIC SUPERTRUCK from point A to points beyond.  If it doesn't "
"dispense fuel immediately, try banging on it or grunt your way over the "
"nearby payment terminal."
msgstr ""
"디젤 연료 펌프입니다. 이 길가 명물은 당신의 합리적으로 거대한 아포칼립스 슈퍼트럭을 A지점에서 그 너머로 옮기는 데 필요한 걸쭉하고 "
"끈적한 액체 동력을 전부 제공합니다. 연료가 바로 나오지 않으면 두드려보거나 끙끙거리며 근처 결제 단말기로 가보세요."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "smashed diesel pump"
msgstr "박살난 디젤 펌프"

#. ~ Description for smashed diesel pump
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"You're not getting any diesel out of this pump any time soon.  Some "
"barbarian decided to take their frustration out on it."
msgstr "이 펌프에서 당분간 디젤은 못 얻을 겁니다. 어떤 야만인이 화풀이로 박살 냈습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "ATM"
msgstr "ATM"

#. ~ Description for ATM
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"For your banking convenience, this Automated Teller Machine is fully capable"
" of operating autonomously in the event of complete network failure.  You "
"can deposit funds from cash cards and migrate all of your inflation-adjusted"
" earnings to a single card.  These things have seen better days.  There's "
"been a run on the bank, and this machine has the dents and cracks to prove "
"it."
msgstr ""
"은행 업무 편의를 위해, 이 자동 입출금기는 네트워크가 완전히 마비돼도 자율 작동이 가능합니다. 현금 카드에서 자금을 입금하고 인플레이션"
" 조정 수입 전부를 한 카드로 옮길 수 있습니다. 이것들도 좋았던 시절이 있었죠. 은행 뱅크런이 있었고, 이 기계엔 그걸 증명하는 "
"찌그러짐과 금이 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "Critical failure imminent, self destruct activated.  Have a nice day!"
msgstr "치명적인 손상 감지. 자폭 기능이 작동되었습니다. 좋은 하루 되세요!"

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "ticket vendor"
msgstr "표 판매기"

#. ~ Description for ticket vendor
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This machine has a little screen, and slots intended to take your money and "
"provide you with a ticket."
msgstr "이 기계엔 작은 화면과, 돈을 받고 표를 주는 투입구가 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "ticket machine"
msgstr "표 발매기"

#. ~ Description for ticket machine
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This machine will provide you access to whatever is beyond it - for the "
"price of a ticket, of course."
msgstr "이 기계는 너머의 무엇이든 접근할 수 있게 해줍니다 - 물론 표 값으로요."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "ventilation shutters"
msgstr "환기 셔터"

#. ~ Description for ventilation shutters
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A large wall mounted panel, covered fragile metal sheets that regulate "
"airflow."
msgstr "공기 흐름을 조절하는 부서지기 쉬운 금속 판이 덮인, 벽에 부착된 큰 패널입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "broken generator"
msgstr "고장난 발전기"

#. ~ Description for broken generator
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This generator is broken and will not help you produce usable electricity."
msgstr "이 발전기는 고장 나서 쓸 수 있는 전기를 생산하는 데 도움이 되지 않습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "missile"
msgstr "미사일"

#. ~ Description for missile
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This is a section of an ICBM, an Intercontinental Ballistic Missile.  This "
"isn't the kind of rocket that goes to the moon."
msgstr "ICBM, 대륙간 탄도 미사일의 일부입니다. 달에 가는 종류의 로켓이 아닙니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "blown-out missile"
msgstr "터진 미사일"

#. ~ Description for blown-out missile
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This is a section of an ICBM, an Intercontinental Ballistic Missile.  This "
"isn't the kind of rocket that's going anywhere."
msgstr "ICBM, 대륙간 탄도 미사일의 일부입니다. 이건 어디든 날아갈 종류의 로켓이 아닙니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
#: data\json\overmap\overmap_terrain\overmap_terrain.json
#: data\json\overmap\overmap_terrain\overmap_terrain_military.json
#: data\mods\alt_map_key\overmap_terrain.json
msgid "radio tower"
msgstr "방송탑"

#. ~ Description for radio tower
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "This is the structure of a radio transmission tower."
msgstr "라디오 송신탑의 구조물입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "radio controls"
msgstr "라디오 제어판"

#. ~ Description for radio controls
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This console appears to control a nearby radio transmission tower.  It "
"doesn't seem to be fully operational."
msgstr "이 콘솔은 근처 라디오 송신탑을 제어하는 것 같습니다. 완전히 작동하진 않는 것 같습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "high gauge pipe"
msgstr "고압 배관"

#. ~ Description for high gauge pipe
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "This is a section of high gauge pipe."
msgstr "고압 배관 한 구간입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "high gauge pump"
msgstr "고압 펌프"

#. ~ Description for high gauge pump
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This unpowered pump previously would have moved fluids around in a hurry."
msgstr "전원 없는 이 펌프는 예전엔 유체를 빠르게 옮겼을 겁니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "CVD machine"
msgstr "CVD 장치"

#. ~ Description for CVD machine
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"The bulk of a highly technical-looking apparatus controlled by a nearby "
"console."
msgstr "근처 콘솔로 제어되는 고도로 기술적으로 보이는 장치의 본체입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "nanofabricator"
msgstr "나노제작기"

#. ~ Description for nanofabricator
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A great column of advanced machinery.  Within this self-contained, "
"miniaturized factory, several 3d printers work in tandem with a robotic "
"assembler to manufacture nearly any inorganic object."
msgstr ""
"고급 기계의 우뚝 솟은 기둥이다. 이 자급자족 소형화된 공장 안에서 여러 3D 프린터가 로봇 조립기와 연동하여 거의 모든 무기물을 "
"제조한다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "nanofabricator control panel"
msgstr "나노제작기 조작 패널"

#. ~ Description for nanofabricator control panel
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A small computer panel attached to a nanofabricator.  It has a single slot "
"for reading templates."
msgstr "나노제작기에 부착된 소형 컴퓨터 패널이다. 템플릿을 읽기 위한 단일 슬롯이 있다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "superalloy forge"
msgstr "초합금 제련기"

#. ~ Description for superalloy forge
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A great column of advanced machinery.  Within this self-contained, "
"miniaturized factory, several specialized 3d printers work in tandem with "
"robotic forge units to efficiently manufacture superalloy sheets from steel "
"sheets and nanomaterial."
msgstr ""
"거대한 첨단 기계 기둥입니다. 이 자체 완결형 소형 공장 안에서, 특수 3D 프린터 몇 대가 로봇 단조 유닛과 협력해 강판과 나노재료로 "
"초합금 판을 효율적으로 제조합니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "superalloy forge control panel"
msgstr "초합금 제련기 제어 패널"

#. ~ Description for superalloy forge control panel
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A small computer panel attached to a superalloy forge."
msgstr "초합금 제련기에 부착된 작은 컴퓨터 패널입니다."

#. ~ Description for cloning vat
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A vat full of solution, probably intended to hold growing clones of people "
"or other life forms."
msgstr "사람이나 다른 생명체의 자라나는 복제체를 담기 위한 것으로 보이는, 용액이 가득한 통입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "slot machine"
msgstr "슬롯 머신"

#. ~ Description for slot machine
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A machine with a bright screen flashing hypnotic promises of wealth.  If "
"gambling with your life on a daily basis isn't enough for you, you can also "
"gamble with this."
msgstr ""
"부의 최면 같은 약속을 깜빡이는 밝은 화면이 있는 기계입니다. 매일 목숨을 건 도박으로 부족하다면 이걸로도 도박할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "water pump"
msgstr "워터 펌프"

#. ~ Description for water pump
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"Deep well collecting ground water.  Installed water pump allows to draw "
"water from it."
msgstr "지하수를 모으는 깊은 우물이다. 설치된 물 펌프로 물을 퍼올릴 수 있다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
#: data\json\items\furniture.json data\json\vehicleparts\power.json
msgid "plutonium generator"
msgid_plural "plutonium generators"
msgstr[0] "플루토늄 발전기"

#. ~ Description for plutonium generator
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This imposing apparatus harnesses the power of the atom, configured to "
"provide nearly limitless backup power from the nuclear fuel installed in it."
"  It's not doing much good here though.  It has a complicated security "
"system that is dangerous and difficult to bypass without authorization; a "
"small slot suggests that it can accept some form of ID card."
msgstr ""
"이 위압적인 장치는 원자의 힘을 이용해, 설치된 핵연료로 거의 무한한 예비 전력을 제공하도록 설정됐습니다. 하지만 여기선 별 도움이 안 "
"됩니다. 승인 없이 우회하기 위험하고 어려운 복잡한 보안 시스템이 있고, 작은 슬롯으로 보아 일종의 신분증 카드를 받아들이는 것 "
"같습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "telecom cabinet"
msgstr "통신장비 보관함"

#. ~ Description for telecom cabinet
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A cabinet full of telecoms equipment.  With the lines down, you might be "
"able to take it apart for its useful electronics."
msgstr "통신 장비가 가득한 캐비닛입니다. 선이 끊긴 지금, 유용한 전자 부품을 위해 분해할 수 있을 겁니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "damaged telecom cabinet"
msgstr "손상된 통신장비 보관함"

#. ~ Description for damaged telecom cabinet
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A damaged telecoms cabinet.  Might still be able to salvage some useful "
"electronics scrap from it."
msgstr "손상된 통신 캐비닛입니다. 여전히 유용한 전자 부품 고철을 회수할 수 있을 겁니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "HV oil circuit breaker"
msgstr "고압 유입식 차단기"

#. ~ Description for HV oil circuit breaker
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A circuit breaker that uses oil in its arc suppression chamber."
msgstr "아크 소호실에 기름을 사용하는 차단기입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "pow!"
msgstr "빵!"

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "small HV oil circuit breaker"
msgstr "소형 고압 유입식 차단기"

#. ~ Description for small HV oil circuit breaker
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A small circuit breaker that uses oil in its arc suppression chamber."
msgstr "아크 소호실에 기름을 사용하는 소형 차단기입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "large switchgear"
msgstr "대형 개폐기"

#. ~ Description for large switchgear
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A switchgear panel.  It's covered in breaker switches, fuses, and gauges."
msgstr "개폐 장치 패널입니다. 차단 스위치와 퓨즈, 계기가 빼곡합니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "small switchgear"
msgstr "소형 개폐기"

#. ~ Description for small switchgear
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A small switchgear panel.  It's covered in breaker switches, fuses, and "
"gauges."
msgstr "소형 개폐 장치 패널입니다. 차단 스위치와 퓨즈, 계기가 빼곡합니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "lightning arrester"
msgstr "피뢰기"

#. ~ Description for lightning arrester
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A component designed to protect insulation and conductors in an electrical "
"system by directing lightning through itself and into the ground."
msgstr "번개를 자신을 통해 땅으로 유도해 전기 시스템의 절연체와 도체를 보호하도록 설계된 부품입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "disconnect switch"
msgstr "단로기"

#. ~ Description for disconnect switch
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A switch used to make sure an electrical system doesn't have any current "
"flowing through it, for maintenance periods."
msgstr "정비 기간 동안 전기 시스템에 전류가 흐르지 않도록 확실히 하는 스위치입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "current transformer"
msgstr "변류기"

#. ~ Description for current transformer
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "An electronic component used to transform the voltage of a current."
msgstr "전류의 전압을 변환하는 전자 부품입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "potential transformer"
msgstr "계기용 변압기"

#. ~ Description for potential transformer
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A specialized type of electrical transformer, "
msgstr "특수한 종류의 전기 변압기로,"

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "conveyor belt"
msgstr "컨베이어 벨트"

#. ~ Description for conveyor belt
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A conveyor belt.  Used to transport things."
msgstr "컨베이어 벨트입니다. 물건을 운반하는 데 사용됩니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "light machinery"
msgstr "가벼운 기계"

#. ~ Description for light machinery
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "Assorted light machinery.  You could scavenge it for parts."
msgstr "온갖 경량 기계입니다. 부품을 찾아 뜯어낼 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "heavy machinery"
msgstr "무거운 기계"

#. ~ Description for heavy machinery
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "Assorted heavy machinery.  You could scavenge it for parts."
msgstr "온갖 중량 기계입니다. 부품을 찾아 뜯어낼 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "old machinery"
msgstr "낡은 기계"

#. ~ Description for old machinery
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "Assorted old machinery.  You could scavenge it for parts."
msgstr "온갖 낡은 기계입니다. 부품을 찾아 뜯어낼 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "electronic machinery"
msgstr "전자 기계"

#. ~ Description for electronic machinery
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "Assorted electronic machinery.  You could scavenge it for parts."
msgstr "온갖 전자 기계입니다. 부품을 찾아 뜯어낼 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "milking machine"
msgstr "착유기"

#. ~ Description for milking machine
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A machine used in the dairy industry to milk cows."
msgstr "낙농업에서 소의 젖을 짜는 데 쓰는 기계입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "bulk tank"
msgstr "벌크 탱크"

#. ~ Description for bulk tank
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A heavy, high capacity tank."
msgstr "무겁고 대용량인 탱크입니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "root cellar"
msgstr "지하 저장고"

#. ~ Description for root cellar
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "A cellar dug into the earth for storing food in a cool environment."
msgstr "시원한 환경에서 식품을 보관하기 위해 땅을 파서 만든 저장고다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "covered well"
msgstr "폐쇄된 우물"

#. ~ Description for covered well
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"Deep well collecting ground water.  Requires a method to draw water from."
msgstr "지하수를 모으는 깊은 우물이다. 물을 퍼올리는 방법이 필요하다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "improvised shelter"
msgstr "임시 피난처"

#. ~ Description for improvised shelter
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"Improvised shelter providing little bit of protection, that can be used to "
"take refuge from the elements, or conceal you from view."
msgstr "약간의 보호를 제공하는 즉흥 대피소로, 날씨를 피하거나 시야에서 당신을 숨기는 데 쓸 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "pine lean-to"
msgstr "소나무 피난처"

#. ~ Description for pine lean-to
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A small shelter roofed with pine leaves, that can be used to take refuge "
"from the elements."
msgstr "솔잎으로 지붕을 덮은 작은 대피소로, 날씨를 피하는 데 쓸 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "unfinished niter bed"
msgstr "미완성 초석 침대"

#. ~ Description for unfinished niter bed
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"A wet heap of fertilizer and plant matter covered in soil for traditional "
"saltpeter production.  In about a season, enough potassium nitrate will "
"leach through and crystallize to be harvestable."
msgstr ""
"전통적인 초석 생산을 위해 흙으로 덮은 비료와 식물 물질의 축축한 더미입니다. 약 한 계절이면 충분한 질산칼륨이 스며나와 결정화되어 "
"수확할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid "mature niter bed"
msgstr "성숙한 초석 침대"

#. ~ Description for mature niter bed
#: data\json\furniture_and_terrain\terrain-manufactured.json
msgid ""
"This heap of nitrated compost has leached out and crystallized a bunch of "
"niter.  Dig here to extract it."
msgstr "이 질산화된 퇴비 더미는 스며나와 한 움큼의 초석을 결정화했습니다. 여기를 파서 추출하세요."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "mechanical winch"
msgstr "기계식 윈치"

#. ~ Description for mechanical winch
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a gate control winch.  If it's functioning, it can be used to open "
"or close a nearby gate or door."
msgstr "문 제어 윈치입니다. 작동하면 근처 출입구나 문을 여닫는 데 쓸 수 있습니다."

#. ~ Description for mechanical winch
#. ~ Description for control lever
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a gate control winch.  If it's functioning, it can be used to open "
"or close a nearby gate."
msgstr "문 제어 윈치입니다. 작동하면 근처 출입구를 여닫는 데 쓸 수 있습니다."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "control lever"
msgstr "조종용 레버"

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "rope and pulley"
msgstr "줄과 도르래"

#. ~ Description for rope and pulley
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "A system of ropes and pulleys that allows to pull up heavy doors."
msgstr "무거운 문을 들어올릴 수 있는 밧줄과 도르래 시스템이다."

#. ~ Description for rope and pulley
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"A system of ropes and pulleys that allows to pull up heavy doors or gates."
msgstr "무거운 문이나 대문을 들어올릴 수 있는 밧줄과 도르래 시스템이다."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
#: data\json\npcs\robofac\NPC_ROBOFAC_INTERCOM.json
msgid "intercom"
msgstr "인터콤"

#. ~ Description for intercom
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"An intercom panel.  For when you want to scare the crap out of someone, or "
"just talk to them over the intercom system, if you're boring like that."
msgstr ""
"인터콤 패널입니다. 누군가를 똥오줌 지리게 겁주고 싶을 때, 혹은 그냥 인터콤으로 얘기하고 싶을 때 씁니다 - 그렇게 재미없는 "
"스타일이라면요."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "card reader"
msgstr "카드 인식기"

#. ~ Description for card reader
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom inside"
" a flask that is universally known to indicate SCIENCE.  An ominous red LED "
"reminds you of a robot gone haywire from an old sci-fi flick.  You could "
"swipe a scientific ID badge near it if you do not fear the machine."
msgstr ""
"스마트카드 리더기입니다. 보편적으로 과학을 나타내는 플라스크 속 원자의 양식화된 상징이 있습니다. 불길한 빨간 LED는 오래된 SF "
"영화에서 폭주한 로봇을 연상시킵니다. 기계가 두렵지 않다면 과학 신분증 배지를 가까이 스캔할 수 있습니다."

#. ~ Description for card reader
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  It sports the stylized symbol of an atom inside"
" a flask that is universally known to indicate SCIENCE.  The stark red LED "
"blinks askance at your geek cred.  You could swipe a scientific ID badge "
"near it to unlock the gates to discovery."
msgstr ""
"스마트카드 리더기입니다. 보편적으로 과학을 나타내는 플라스크 속 원자의 양식화된 상징이 있습니다. 냉정한 빨간 LED가 당신의 괴짜 "
"이력을 곁눈질하며 깜빡입니다. 발견의 문을 열 수 있도록 과학 신분증 배지를 가까이 스캔할 수 있습니다."

#. ~ Description for card reader
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  The universal symbol of an eagle driving a "
"tank, biting a grenade pin stands rampant in front of an American flag.  A "
"small, red LED remains constant, as if watching you, waiting.  You could "
"swipe a military ID card in front of the reader if you dared."
msgstr ""
"스마트카드 리더기입니다. 미국 국기 앞에 탱크를 운전하고 수류탄 핀을 무는 독수리라는 보편적 상징이 우뚝 서 있습니다. 작은 빨간 "
"LED가 당신을 지켜보듯 기다리며 점등된 채입니다. 감히 한다면 군용 신분증을 리더기 앞에 스캔할 수 있습니다."

#. ~ Description for card reader
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a smartcard reader.  The symbol of a gear in front of a bulging "
"bicep is emblazoned on the matte black surface with an illegible heavy "
"industrial company title.  A red LED blinks on the card reader.  Perhaps an "
"industrial ID card could still open it."
msgstr ""
"스마트카드 리더기입니다. 불룩한 이두박근 앞 톱니바퀴 상징이 무광 검정 표면에 읽을 수 없는 중공업 회사명과 함께 새겨져 있습니다. 카드"
" 리더기의 빨간 LED가 깜빡입니다. 산업용 신분증으로 아직 열 수 있을 지도 모릅니다."

#. ~ Description for card reader
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This looks like the console controlling the security door, there's a pretty "
"big reading surface on it.  You can see \"Fp\" soberly printed above the "
"reader.  You have no idea what could open it."
msgstr ""
"보안 문을 제어하는 콘솔인 것 같습니다. 꽤 큰 판독면이 있습니다. 리더 위에 \"Fp\"가 단정히 인쇄되어 있습니다. 무엇으로 열 수 "
"있을지 전혀 모르겠습니다."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "broken card reader"
msgstr "고장난 카드 인식기"

#. ~ Description for broken card reader
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is a smartcard reader, but it doesn't seem to be functioning.  Probably"
" because there's no more blinking red LED."
msgstr "스마트카드 리더기지만 작동하지 않는 것 같습니다. 아마 깜빡이는 빨간 LED가 더 이상 없기 때문이겠죠."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "elevator controls"
msgstr "엘리베이터 제어기"

#. ~ Description for elevator controls
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"This is the control face for an elevator.  You could press the appropriate "
"button to take you to your choice of floor."
msgstr "엘리베이터의 제어면입니다. 알맞은 버튼을 눌러 원하는 층으로 갈 수 있습니다."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "powerless controls"
msgstr "정전된 제어기"

#. ~ Description for powerless controls
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "This is the control face for an elevator.  It's currently unpowered."
msgstr "엘리베이터의 제어면입니다. 현재 전원이 없습니다."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "dark pedestal"
msgstr "짙은 받침대"

#. ~ Description for dark pedestal
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"A dark stone pedestal covered in ancient, unintelligible symbols.  Looks "
"ominous."
msgstr "고대의 알 수 없는 상징이 덮인 어두운 돌 받침대입니다. 불길해 보입니다."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "light pedestal"
msgstr "밝은 받침대"

#. ~ Description for light pedestal
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "A light stone pedestal covered in ancient, unintelligible symbols."
msgstr "고대의 알 수 없는 상징이 덮인 밝은 돌 받침대입니다."

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "yellow switch"
msgstr "노란색 스위치"

#. ~ Description for yellow switch
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "A yellow switch.  Should you activate it?"
msgstr "노란 스위치입니다. 작동시켜야 할까요?"

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "cyan switch"
msgstr "청록색 스위치"

#. ~ Description for cyan switch
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "A cyan switch.  Should you activate it?"
msgstr "청록 스위치입니다. 작동시켜야 할까요?"

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "purple switch"
msgstr "보라색 스위치"

#. ~ Description for purple switch
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "A purple switch.  Should you activate it?"
msgstr "보라 스위치입니다. 작동시켜야 할까요?"

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "checkered switch"
msgstr "체크무늬 버튼"

#. ~ Description for checkered switch
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "A checkered switch.  Should you activate it?"
msgstr "체크무늬 스위치입니다. 작동시켜야 할까요?"

#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid "nuclear reactor core"
msgstr "노심"

#. ~ Description for nuclear reactor core
#: data\json\furniture_and_terrain\terrain-mechanisms.json
msgid ""
"The critical infrastructure of a nuclear reactor.  If it was still running, "
"it could produce enough steam to generate 125 megawatts of energy.  It could"
" be salvaged for valuable components, which could be used to juryrig more "
"smaller-scale sources of nuclear power."
msgstr ""
"원자로의 핵심 설비입니다. 아직 가동 중이었다면 125메가와트의 에너지를 생산할 증기를 만들 수 있었을 겁니다. 더 소규모 핵동력원을 "
"급조하는 데 쓸 수 있는 귀중한 부품을 회수할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "resin wall"
msgstr "수지 벽"

#. ~ Description for resin wall
#: data\json\furniture_and_terrain\terrain-migo.json
msgid ""
"This wall is made of a glistening, nearly opaque, plastic-like substance.  "
"Deep within the material making it up, you can barely see a network of "
"pulsating green conduits, snaking like blood vessels through it.  The "
"material is hard, warm to the touch, and slightly damp."
msgstr ""
"이 벽은 빛나는, 거의 불투명한 플라스틱 같은 물질로 만들어졌습니다. 재료 깊은 곳에 혈관처럼 구불거리는 맥동하는 녹색 도관망이 어렴풋이"
" 보입니다. 재료는 단단하고, 만지면 따뜻하며, 약간 축축합니다."

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "boom!"
msgstr "쾅!"

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "resin cage"
msgstr "수지 우리"

#. ~ Description for resin cage
#: data\json\furniture_and_terrain\terrain-migo.json
msgid ""
"This resin wall opens into a series of small honeycomb-like hexagons, "
"allowing the passage of air and light.  While still made of the same sturdy "
"material, it is thinner and more delicate in appearance."
msgstr ""
"이 수지 벽은 벌집 같은 작은 육각형들로 뚫려 있어 공기와 빛이 지날 수 있습니다. 같은 튼튼한 재료지만 더 얇고 가냘파 보입니다."

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "resin floor"
msgstr "수지 바닥"

#. ~ Description for resin floor
#: data\json\furniture_and_terrain\terrain-migo.json
msgid ""
"This nearly opaque, plastic-like floor has a gentle curve from wall to wall,"
" but in the central areas is quite flat.  The material is hard, warm to the "
"touch, and slightly damp."
msgstr ""
"이 거의 불투명한 플라스틱 같은 바닥은 벽에서 벽까지 완만하게 휘어 있지만 중앙 부분은 꽤 평평합니다. 재료는 단단하고, 만지면 "
"따뜻하며, 약간 축축합니다."

#. ~ Description for resin floor
#: data\json\furniture_and_terrain\terrain-migo.json
msgid ""
"This nearly opaque, plastic-like floor is smooth and flat.  The material is "
"hard, warm to the touch, and slightly damp."
msgstr "이 거의 불투명한 플라스틱 같은 바닥은 매끄럽고 평평합니다. 재료는 단단하고, 만지면 따뜻하며, 약간 축축합니다."

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "resin roof"
msgstr "수지 지붕"

#. ~ Description for resin roof
#: data\json\furniture_and_terrain\terrain-migo.json
msgid ""
"A wide, domed section of nearly opaque, plastic-like material.  When the "
"light hits it, a network of multicolored conduits like blood vessels can be "
"seen snaking through its glistening interior."
msgstr ""
"거의 불투명한 플라스틱 같은 재료로 된 넓은 돔형 구간입니다. 빛이 닿으면 혈관 같은 다색 도관망이 빛나는 내부를 구불구불 지나는 게 "
"보입니다."

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "closed resin portal"
msgstr "닫힌 수지 통로"

#. ~ Description for closed resin portal
#: data\json\furniture_and_terrain\terrain-migo.json
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is closed tightly, but it looks like a firm push would cause it to snap "
"open."
msgstr "축축하고 유연한 수지질 재료로 된 삼첨 해치입니다. 이것은 꼭 닫혀 있지만, 힘껏 밀면 벌컥 열릴 것 같습니다."

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "open resin portal"
msgstr "열린 수지 통로"

#. ~ Description for open resin portal
#: data\json\furniture_and_terrain\terrain-migo.json
msgid ""
"A tricuspid hatch of some sort of damp, flexible, resinous material.  This "
"one is open, the flaps held out by some sort of stringy mucus-like "
"substance."
msgstr "축축하고 유연한 수지질 재료로 된 삼첨 해치입니다. 이것은 열려 있고, 실 같은 점액질 물질이 덮개를 잡고 있습니다."

#: data\json\furniture_and_terrain\terrain-migo.json
msgid "resin-lined hole"
msgstr "수지로 늘인 구멍"

#. ~ Description for resin-lined hole
#: data\json\furniture_and_terrain\terrain-migo.json
msgid "An open hole in the resin wall, large enough to pass through."
msgstr "수지 벽의 열린 구멍으로, 지나갈 만큼 큽니다."

#. ~ Description for dimensional portal
#: data\json\furniture_and_terrain\terrain-nether.json
msgid ""
"The portal that started it all.  A dimly shimmering, completely opaque mist,"
" jet black at the edges, and deep red in the center.  A nuclear explosive "
"placed inside may destabilize and close it.  Alternatively, you may be able "
"to close it from the other side."
msgstr ""
"모든 것을 시작하게 한 포탈입니다. 흐릿하게 아른거리는 완전히 불투명한 안개로, 가장자리는 칠흑 같고 중앙은 짙은 붉은색입니다. 안에 "
"핵폭발물을 놓으면 불안정해져 닫힐 수도 있습니다. 또는 반대쪽에서 닫을 수도 있을 겁니다."

#: data\json\furniture_and_terrain\terrain-nether.json
msgid "void wall"
msgstr "공허 벽"

#. ~ Description for void wall
#: data\json\furniture_and_terrain\terrain-nether.json
msgid "A perfectly smooth wall that looks like a window into the void."
msgstr "공허로 통하는 창처럼 보이는 완전히 매끄러운 벽입니다."

#: data\json\furniture_and_terrain\terrain-nether.json
msgid "shifting floor"
msgstr "변화하는 바닥"

#. ~ Description for shifting floor
#: data\json\furniture_and_terrain\terrain-nether.json
msgid "An endless kaleidoscope of shifting floor."
msgstr "끝없는 만화경처럼 변화하는 바닥입니다."

#: data\json\furniture_and_terrain\terrain-railroads.json
msgid "gravel"
msgstr "자갈"

#. ~ Description for gravel
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid ""
"A small mallet that a judge uses to call - er, wait.  Oh, gravel!  Gravel is"
" a collection of small stones often used for roads, as railroad ballast, and"
" in many other applications."
msgstr ""
"판사가 부르는 데 사용하는 작은 망치인데... 잠깐. 오, 자갈! 자갈은 도로, 철도 자갈, 그 밖의 많은 용도로 자주 사용되는 작은 "
"돌들의 모음이다."

#: data\json\furniture_and_terrain\terrain-railroads.json
msgid "railroad track"
msgstr "선로"

#. ~ Description for railroad track
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm."
msgstr "기차가 예전엔 이 위를 턱턱 달렸습니다. 이 철로는 대재앙 속에 쓰이지 않고 서 있습니다."

#: data\json\furniture_and_terrain\terrain-railroads.json
msgid "railroad tie"
msgstr "침목"

#. ~ Description for railroad tie
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid "This crosstie is used to support the rails."
msgstr "이 침목은 레일을 지탱하는 데 쓰입니다."

#. ~ Description for railroad track
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid ""
"Trains used to chug along on these.  These rail tracks stand unused in the "
"face of the Cataclysm.  A crosstie sits underneath, supporting the rails."
msgstr ""
"기차가 예전엔 이 위를 턱턱 달렸습니다. 이 철로는 대재앙 속에 쓰이지 않고 서 있습니다. 아래엔 레일을 지탱하는 침목이 있습니다."

#: data\json\furniture_and_terrain\terrain-railroads.json
msgid "buffer stop"
msgstr "차막이"

#. ~ Description for buffer stop
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid ""
"A tiny blockade on the train tracks, meant to signify the end of a track, or"
" mark a 'no-go' zone for trains."
msgstr "선로 끝을 표시하거나 기차 '진입 금지' 구역을 표시하기 위한 선로 위 작은 차단물입니다."

#: data\json\furniture_and_terrain\terrain-railroads.json
msgid "railroad crossing signal"
msgstr "철도 건널목 신호기"

#. ~ Description for railroad crossing signal
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid ""
"Traffic lights meant to light and make noise when a train approaches, to "
"prevent people from turning into meaty mush while they cross the tracks.  "
"Won't stop people from turning into meaty mush by other means, though."
msgstr ""
"기차가 다가올 때 불이 켜지고 소리가 나는 신호등으로, 사람들이 선로를 건너다 걸레짝이 되지 않게 합니다. 하지만 다른 방법으로 걸레짝이"
" 되는 건 못 막죠."

#: data\json\furniture_and_terrain\terrain-railroads.json
msgid "crossbuck"
msgstr "교차로 표지판"

#. ~ Description for crossbuck
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid ""
"A traffic sign intended to indicate a level railway crossing.  If the trains"
" were still running."
msgstr "철도 건널목을 나타내기 위한 교통 표지입니다. 기차가 아직 다닌다면요."

#: data\json\furniture_and_terrain\terrain-railroads.json
#: data\json\items\generic.json
msgid "small railroad track"
msgid_plural "small railroad tracks"
msgstr[0] "작은 철로"

#. ~ Description for small railroad track
#: data\json\furniture_and_terrain\terrain-railroads.json
msgid ""
"Like a railroad track, only smaller.  You could probably run a small vehicle"
" on this."
msgstr "철로와 같지만 더 작습니다. 아마 이 위로 작은 차량을 굴릴 수 있습니다."

#: data\json\furniture_and_terrain\terrain-recreational.json
msgid "sandbox"
msgstr "모래상자"

#. ~ Description for sandbox
#: data\json\furniture_and_terrain\terrain-recreational.json
msgid ""
"Children used to play in this sandbox.  The population of lice probably "
"diminished considerably now that they no longer do."
msgstr "아이들이 예전엔 이 모래상자에서 놀았습니다. 더 이상 놀지 않으니 이의 개체 수도 상당히 줄었을 겁니다."

#: data\json\furniture_and_terrain\terrain-recreational.json
msgid "slide"
msgstr "미끄럼틀"

#. ~ Description for slide
#: data\json\furniture_and_terrain\terrain-recreational.json
msgid "A children's slide.  Too small to slide on comfortably anymore."
msgstr "어린이용 미끄럼틀입니다. 이제 편하게 미끄러지기엔 너무 작습니다."

#: data\json\furniture_and_terrain\terrain-recreational.json
msgid "monkey bars"
msgstr "정글짐"

#. ~ Description for monkey bars
#: data\json\furniture_and_terrain\terrain-recreational.json
msgid ""
"A set of monkey bars, to be used by children to train their arms by hanging "
"from the bars, and have fun."
msgstr "아이들이 봉에 매달려 팔을 단련하고 노는 데 쓰는 구름다리입니다."

#: data\json\furniture_and_terrain\terrain-recreational.json
msgid "backboard"
msgstr "농구골대"

#. ~ Description for backboard
#: data\json\furniture_and_terrain\terrain-recreational.json
msgid "A basketball backboard."
msgstr "농구 백보드입니다."

#. ~ Description for backboard
#: data\json\furniture_and_terrain\terrain-recreational.json
msgid "A metal backboard."
msgstr "금속 백보드입니다."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data\json\furniture_and_terrain\terrain-regional-pseudo.json
msgid "this should never actually show up, it's a pseudo terrain"
msgstr "이건 실제로 나타나면 안 됩니다. 의사 지형입니다."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data\json\furniture_and_terrain\terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"people have trampled away grass, or otherwise cleared plant life."
msgstr "이건 실제로 나타나면 안 됩니다. 의사 지형입니다. 사람들이 풀을 짓밟거나 식물을 제거한 곳용입니다."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data\json\furniture_and_terrain\terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"clean, curated grass is the only expected terrain - modified by whatever the"
" biome equivalent is"
msgstr ""
"이건 실제로 나타나면 안 됩니다. 의사 지형입니다. 깨끗하고 관리된 풀만이 예상되는 지형용입니다 - 바이옴 해당 부분에 의해 수정됩니다."

#. ~ Description for this should never actually show up, it's a pseudo terrain
#: data\json\furniture_and_terrain\terrain-regional-pseudo.json
msgid ""
"this should never actually show up, it's a pseudo terrain.  For use where "
"plants have been planted and grass/groundcover kept clear"
msgstr "이건 실제로 나타나면 안 됩니다. 의사 지형입니다. 식물이 심어지고 풀/지피식물이 제거된 곳용입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "rain gutter"
msgstr "빗물 홈통"

#. ~ Description for rain gutter
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "Channels water from the roof towards the ground, it looks flimsy."
msgstr "지붕에서 땅으로 물을 흘려보냅니다. 허술해 보입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "gutter drop"
msgstr "홈통 낙하구"

#. ~ Description for gutter drop
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid ""
"Funnels water from gutter system towards the ground, it looks flimsy.  You "
"may be able to climb down here."
msgstr "홈통 시스템의 물을 땅으로 모읍니다. 허술해 보입니다. 여기로 내려갈 수 있을 지도 모릅니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "downspout"
msgstr "빗물받이 수직관"

#. ~ Description for downspout
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid ""
"A length of gutter running from the roof to the ground, you could place a "
"container underneath it to collect rainwater.  It looks flimsy.  You may be "
"able to climb down here."
msgstr ""
"지붕에서 땅까지 이어지는 홈통으로, 아래에 용기를 놓아 빗물을 모을 수 있습니다. 허술해 보입니다. 여기로 내려갈 수 있을 지도 "
"모릅니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "flat roof"
msgstr "평평한 지붕"

#. ~ Description for flat roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A flat, gray section of rooftop."
msgstr "평평하고 회색인 지붕 구간입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "tar paper flat roof"
msgstr "타르지 평지붕"

#. ~ Description for tar paper flat roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A flat, gray section of rooftop covered with tar paper."
msgstr "타르지로 덮인 평평하고 회색인 지붕 구간입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "shingle flat roof"
msgstr "지붕널 평지붕"

#. ~ Description for shingle flat roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A flat section of rooftop covered in shingles."
msgstr "지붕널로 덮인 평평한 지붕 구간입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "thatched roof"
msgstr "초가지붕"

#. ~ Description for thatched roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A section of roof made out of straw."
msgstr "짚으로 만든 지붕 구간입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "metal flat roof"
msgstr "금속 평지붕"

#. ~ Description for metal flat roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A section of flat, sheet metal rooftop."
msgstr "평평한 얇은 금속판 지붕 구간입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "tile flat roof"
msgstr "타일 평지붕"

#. ~ Description for tile flat roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A section of tiled, flat rooftop."
msgstr "타일이 깔린 평평한 지붕 구간입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "skylight"
msgstr "천창"

#. ~ Description for skylight
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid ""
"A giant sheet of glass inserted into the roof, lets light pass through."
msgstr "지붕에 끼워진 거대한 유리판으로, 빛이 통과합니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "rock roof"
msgstr "암석 지붕"

#. ~ Description for rock roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A section of flat natural rock."
msgstr "평평한 자연 암석 구간입니다."

#. ~ Description for flat roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A flat surface made of pulpy mass, covered in sticky wasp saliva."
msgstr "펄프 덩어리로 된 평평한 표면으로, 끈적한 말벌 침이 덮여 있습니다."

#. ~ Description for flat roof
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid ""
"A flat surface made of hardened pulpy mass, covered in sticky wasp saliva."
msgstr "경화된 펄프 덩어리로 된 평평한 표면으로, 끈적한 말벌 침이 덮여 있습니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "web bridge"
msgstr "거미줄 다리"

#. ~ Description for web bridge
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "A hammock like bridge spun from spider silk."
msgstr "거미줄로 짜인 해먹 같은 다리입니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "treetop"
msgstr "나무 꼭대기"

#. ~ Description for treetop
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "The upper branches of a tree.  There's just enough room to perch here."
msgstr "나무의 위쪽 가지입니다. 여기에 앉을 만큼 딱 자리가 있습니다."

#: data\json\furniture_and_terrain\terrain-roofs.json
msgid "dead treetop"
msgstr "죽은 나무 꼭대기"

#. ~ Description for dead treetop
#: data\json\furniture_and_terrain\terrain-roofs.json
msgid ""
"The bare upper branches of a dead tree.  There's just enough room to perch "
"here."
msgstr "죽은 나무의 벌거벗은 위쪽 가지입니다. 여기에 앉을 만큼 딱 자리가 있습니다."

#: data\json\furniture_and_terrain\terrain-traps.json
msgid "shallow pit"
msgstr "얕은 구덩이"

#. ~ Description for shallow pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"A pit that could be dug even deeper or filled up.  Also useful as a starting"
" foundation for some constructions."
msgstr "더 깊이 팔 수도 있고 채울 수도 있는 구덩이다. 일부 건설 프로젝트의 기초로도 유용하다."

#. ~ Description for pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"A steep hole that could seriously injure something if it fell in, "
"potentially fatal if it was filled with sharp and dangerous things.  Deep "
"enough for more advanced construction projects, and possibly to reach "
"groundwater if constructed properly."
msgstr ""
"무언가가 떨어지면 심각한 부상을 입힐 수 있는 가파른 구덩이로, 날카롭고 위험한 것들로 채워져 있다면 치명적일 수 있다. 고급 건설 "
"프로젝트에 충분히 깊고, 제대로 구성되면 지하수에 도달할 수 있다."

#: data\json\furniture_and_terrain\terrain-traps.json
msgid "corpse filled pit"
msgstr "시체 구덩이"

#. ~ Description for corpse filled pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"A giant trench full of corpses, maybe even a mass graveyard.  The bodies "
"could be dug out but none of it looks remotely usable."
msgstr "시체로 가득 찬 거대한 참호로, 집단 매장지일 수 있다. 시체를 파낼 수는 있지만 전혀 사용할 수 없어 보인다."

#: data\json\furniture_and_terrain\terrain-traps.json
msgid "covered pit"
msgstr "덮인 구덩이"

#. ~ Description for covered pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"A deep pit with a two by four placed across it, looks sturdy enough to cross"
" safely or the plank could be removed to turn it back into trap fall."
msgstr ""
"2x4 목재가 걸쳐진 깊은 구덩이로, 안전하게 건너기에 충분히 튼튼해 보이거나 판자를 제거하여 함정 낙하구로 되돌릴 수 있다."

#. ~ Description for spiked pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"A narrow trench full of very pointy things that would easily puncture a "
"body."
msgstr "몸을 쉽게 찌를 수 있는 매우 날카로운 것들로 가득 찬 좁은 참호다."

#: data\json\furniture_and_terrain\terrain-traps.json
msgid "covered spiked pit"
msgstr "덮인 가시 구덩이"

#. ~ Description for covered spiked pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"Menacing with sharp spears along the bottom, this pit has a plank across it "
"to allow someone or something to cross safely.  The two by four could be "
"removed to revert it back into a trap."
msgstr ""
"바닥을 따라 날카로운 창이 가득 찬 공포스러운 구덩이에 안전하게 건너갈 수 있도록 판자가 놓여 있다. 2x4 목재를 제거하면 다시 "
"함정으로 되돌릴 수 있다."

#. ~ Description for glass pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"Looks like a ton of broken glass was dumped into this pit, maybe not fatal "
"to fall in but wouldn't be pleasant to try to crawl out."
msgstr "이 구덩이에는 깨진 유리 조각이 잔뜩 쏟아진 것 같다. 떨어져도 치명적이지는 않지만 기어나오기가 무척 불쾌할 것이다."

#: data\json\furniture_and_terrain\terrain-traps.json
msgid "covered glass pit"
msgstr "덮인 유리 구덩이"

#. ~ Description for covered glass pit
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"A two by four has been placed carefully to allow traversal over this ditch "
"full of large glass shards.  The wooden board could be removed so it "
"couldn't be safely crossed."
msgstr ""
"큰 유리 파편으로 가득 찬 이 도랑을 건너갈 수 있도록 2x4 목재가 조심스럽게 놓여 있다. 나무 판자를 제거하면 안전하게 건너갈 수 "
"없다."

#: data\json\furniture_and_terrain\terrain-traps.json
msgid "slime"
msgstr "슬라임"

#. ~ Description for slime
#: data\json\furniture_and_terrain\terrain-traps.json
msgid ""
"A disgusting and slippery mess that could be used to stash things because "
"who'd want to touch it?"
msgstr "물건을 숨기는 데 사용할 수 있는 역겹고 미끄러운 혼란이다. 누가 만지려 하겠는가?"

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "solid bark wall"
msgstr "견고한 나무껍질 벽"

#. ~ Description for solid bark wall
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid ""
"A solid wall of bark, enclosing the trunk of a massive tree.  It will "
"probably burn quite well."
msgstr "거대한 나무의 줄기를 둘러싼 견고한 나무껍질 벽입니다. 아마 잘 탈 겁니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "chipped bark wall"
msgstr "벗겨진 나무껍질 벽"

#. ~ Description for chipped bark wall
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid ""
"A solid wall of bark enclosing the trunk of a massive tree.  Some of it has "
"been broken away."
msgstr "거대한 나무의 줄기를 둘러싼 견고한 나무껍질 벽입니다. 일부가 떨어져 나갔습니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "broken bark wall"
msgstr "부서진 나무껍질 벽"

#. ~ Description for broken bark wall
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid ""
"A formerly solid wall of bark, now almost completely destroyed and waiting "
"to collapse."
msgstr "예전엔 견고했던 나무껍질 벽으로, 이제 거의 완전히 파괴되어 무너지기를 기다리고 있습니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "solid wood wall"
msgstr "견고한 목재 벽"

#. ~ Description for solid wood wall
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "A solid wall of naturally grown wood.  Likely very flammable."
msgstr "자연적으로 자란 나무로 된 견고한 벽입니다. 아주 잘 탈 가능성이 높습니다."

#. ~ Mutation class name
#: data\json\furniture_and_terrain\terrain-triffid.json
#: data\mods\ProjectSquirrel\mutations\mutation_category.json
msgid "bark"
msgstr "나무껍질"

#. ~ Description for bark
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "A solid piece of bark covers the floor here."
msgstr "견고한 나무껍질 조각이 여기 바닥을 덮습니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "branches with leaves"
msgstr "잎 달린 가지"

#. ~ Description for branches with leaves
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "Thin branches emerge here, covered with thick, large leaves."
msgstr "가는 가지가 여기서 뻗어 나와 두껍고 큰 잎으로 덮여 있습니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "root floor"
msgstr "뿌리 바닥"

#. ~ Description for root floor
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "A dirt floor covered with roots."
msgstr "뿌리로 덮인 흙 바닥입니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "downward root slope"
msgstr "내려가는 뿌리 경사"

#. ~ Description for downward root slope
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "A downward-facing slope of root-covered dirt."
msgstr "뿌리 덮인 흙의 아래로 향한 경사입니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "upward root slope"
msgstr "올라가는 뿌리 경사"

#. ~ Description for upward root slope
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "An upward-facing slope of root-covered dirt."
msgstr "뿌리 덮인 흙의 위로 향한 경사입니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "closed bramble roots"
msgstr "닫힌 가시덤불 뿌리"

#. ~ Description for closed bramble roots
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid ""
"A bramble of roots can be seen here, covering a hole.  They could easily be "
"pulled apart."
msgstr "구멍을 덮는 얽힌 뿌리가 여기 보입니다. 쉽게 잡아당겨 열 수 있습니다."

#: data\json\furniture_and_terrain\terrain-triffid.json
msgid "open bramble roots"
msgstr "열린 가시덤불 뿌리"

#. ~ Description for open bramble roots
#: data\json\furniture_and_terrain\terrain-triffid.json
msgid ""
"A bramble of roots can be seen here, they have been pulled apart to reveal a"
" hole."
msgstr "얽힌 뿌리가 여기 보입니다. 잡아당겨 열려 구멍이 드러났습니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "plastered wooden wall"
msgstr "회벽 바른 목재 벽"

#. ~ Description for plastered wooden wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"The stereotypical wall with wooden support structure filled with insulation "
"and drywalled.  Paint job is the all too common and neutral off-white or "
"cream color, it could use more vibrant paint.  The underlying material is "
"still somewhat flammable."
msgstr ""
"단열재를 채우고 석고보드를 댄 목재 지지 구조의 전형적인 벽입니다. 페인트는 너무나 흔한 중성적 오프화이트나 크림색이라 더 활기찬 "
"페인트를 쓸 수 있을 겁니다. 아래 재료는 여전히 다소 가연성입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "dark plastered wooden wall"
msgstr "어두운 회벽 목재 벽"

#. ~ Description for dark plastered wooden wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"The stereotypical wall with wooden support structure filled with insulation "
"and drywalled.  Paint job is by default is the all too common and neutral "
"off-white, but it is simple and easy to paint with spray cans.  The "
"underlying material is still somewhat flammable."
msgstr ""
"단열재를 채우고 석고보드를 댄 목재 지지 구조의 전형적인 벽입니다. 페인트는 기본적으로 너무나 흔한 중성적 오프화이트지만, 스프레이 "
"캔으로 칠하기 간단하고 쉽습니다. 아래 재료는 여전히 다소 가연성입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built wooden wall"
msgstr "반쯤 지은 목재 벽"

#. ~ Description for half-built wooden wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"An incomplete wall of refined wood, dotted with carefully placed nails to "
"provide proper support.  It requires some more two by fours and nails before"
" it'd be considered a suitable wall."
msgstr ""
"주의 깊게 박힌 못으로 적절한 지지를 제공하는 미완성된 정제 목재 벽이다. 적합한 벽으로 인정받으려면 2x4 목재와 못이 더 필요하다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built domestic wall"
msgstr "반쯤 지은 주택 벽"

#. ~ Description for half-built domestic wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Wooden slats nailed across the bare skeleton of what will eventually be a "
"modern interior wall.  The finishing touches would typically be drywall or "
"plaster, or whatever one can improvise out of local materials."
msgstr ""
"결국 현대식 내벽이 될 벌거벗은 골조에 못 박은 목재 판입니다. 마무리는 보통 석고보드나 회벽, 혹은 현지 재료로 급조한 무엇이 됩니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "pony wall"
msgstr "낮은 칸막이 벽"

#. ~ Description for pony wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A short divider wall with wooden support structure with drywall.  Paint job "
"is the all too common and neutral off-white or cream color.  Appears as "
"though the material is flammable."
msgstr ""
"석고보드가 있는 목재 지지 구조의 낮은 칸막이 벽입니다. 페인트는 너무나 흔한 중성적 오프화이트나 크림색입니다. 재료는 가연성으로 "
"보입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "red wall"
msgstr "빨간색 벽"

#. ~ Description for red wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Wall painted red."
msgstr "빨간색 벽"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "white wall"
msgstr "하얀색 벽"

#. ~ Description for white wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Wall painted white."
msgstr "하얀색 벽"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "blue wall"
msgstr "파란색 벽"

#. ~ Description for blue wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Wall painted blue."
msgstr "파란색 벽"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "green wall"
msgstr "녹색 벽"

#. ~ Description for green wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Wall painted green."
msgstr "초록색 벽"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "yellow wall"
msgstr "노란색 벽"

#. ~ Description for yellow wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Wall painted yellow."
msgstr "노란색 벽"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "pink wall"
msgstr "분홍 벽"

#. ~ Description for pink wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Wall painted pink."
msgstr "분홍색으로 칠해진 벽입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "purple wall"
msgstr "자주색 벽"

#. ~ Description for purple wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "Wall painted purple."
msgstr "보라색 벽"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built brick wall"
msgstr "반쯤 만든 벽돌 벽"

#. ~ Description for half-built brick wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Half of a brick wall, looks like it still requires some more resources and "
"effort before being considered a real wall."
msgstr "반쯤 완성된 벽돌 벽이다. 진짜 벽으로 인정받으려면 아직 자재와 작업이 더 필요하다."

#: data\json\furniture_and_terrain\terrain-walls.json
#: data\mods\Arcana_BN\furniture_and_terrain\terrain.json
msgid "bash!"
msgstr "쿵!"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "brick wall"
msgstr "벽돌 벽"

#. ~ Description for brick wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A solid brick wall, sturdy enough to support a roof with enough walls and "
"keep out any unwanted visitors."
msgstr "튼튼한 벽돌 벽이다. 충분한 벽이 있으면 지붕을 지탱할 수 있으며 원치 않는 방문객을 차단할 수 있다."

#. ~ Description for stone wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "A sturdy stone wall."
msgstr "튼튼한 돌 벽입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built stone wall"
msgstr "반쯤 만든 돌벽"

#. ~ Description for half-built stone wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Half of a sturdy stone wall.  Some work still needs to be done before this "
"stone wall is complete."
msgstr "튼튼한 돌 벽의 절반입니다. 이 돌 벽이 완성되려면 아직 작업이 더 필요합니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "smoothed rock"
msgstr "매끄러운 돌"

#. ~ Description for smoothed rock
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A block of stone that's been smoothed and shaped, commonly granite or marble"
" for funerary chapels and mausoleums."
msgstr "매끄럽고 모양이 다듬어진 돌 블록으로, 일반적으로 장례 예배당과 납골당에 사용되는 화강암이나 대리석이다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built adobe wall"
msgstr "반쯤 지은 아도베 벽"

#. ~ Description for half-built adobe wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Half of an adobe brick wall, looks like it still requires some more "
"resources and effort before being considered a real wall."
msgstr "아도베 벽돌 벽의 절반으로, 진짜 벽으로 여겨지려면 자원과 노력이 더 필요해 보입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "adobe wall"
msgstr "아도베 벽"

#. ~ Description for adobe wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A solid adobe brick wall, sturdy enough to support a roof with enough walls "
"and keep out any unwanted visitors."
msgstr "견고한 아도베 벽돌 벽으로, 충분한 벽이 있으면 지붕을 지탱하고 원치 않는 방문객을 막을 만큼 튼튼합니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "concrete wall"
msgstr "콘크리트 벽"

#. ~ Description for concrete wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"An aesthetically pleasing design with simple lines, this type of concrete "
"was used with a weaker chemical mixture in order to have faster setting "
"times.  Not ideal for multi-story buildings, but still capable of supporting"
" a roof."
msgstr ""
"미려한 단순한 선 디자인으로, 이 유형의 콘크리트는 더 빠른 경화 시간을 위해 약한 화학 혼합물로 사용되었다. 다층 건물에 이상적이지는 "
"않지만 지붕을 지탱할 수 있다."

#. ~ Description for bulkhead
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces."
msgstr "산업적으로 제작된 두꺼운 판이 신중하게 배치된 이 벽은 극한의 환경과 적대 세력을 견딜 수 있습니다."

#. ~ Description for underwater bulkhead
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"An industrially fabricated thick sheet carefully positioned, this wall is "
"capable of resisting extreme elements as well as hostile forces.  Seems to "
"have sprung a leak, however."
msgstr ""
"산업적으로 제작된 두꺼운 판이 신중하게 배치된 이 벽은 극한의 환경과 적대 세력을 견딜 수 있습니다. 하지만 물이 새기 시작한 것 "
"같습니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "simple concrete wall"
msgstr "간이 콘크리트 벽"

#. ~ Description for simple concrete wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A durable and uniform concrete wall, quite drab without decoration.  More "
"than capable of supporting a roof, as well as keeping out most anything, "
"save for vehicles."
msgstr "내구성 있고 균일한 콘크리트 벽으로 장식 없이 다소 단조롭다. 지붕을 지탱하고 차량을 제외한 대부분의 것을 막을 수 있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built simple concrete wall"
msgstr "반쯤 만든 간이 콘크리트 벽"

#. ~ Description for half-built simple concrete wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A partially poured concrete wall that could probably keep anything behind it"
" quite safe if it were finished."
msgstr "완성되면 뒤쪽을 상당히 안전하게 할 수 있는 부분적으로 부어진 콘크리트 벽이다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "reinforced concrete wall"
msgstr "철근 콘크리트 벽"

#. ~ Description for reinforced concrete wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"An extremely resilient wall, filled with concrete and rebar.  Best suited "
"for supporting multi-level buildings, only serious explosives and high-speed"
" impacts would be capable of damaging this wall."
msgstr ""
"콘크리트와 철근이 가득 찬 극도로 회복력 있는 벽이다. 다층 건물 지탱에 적합하며 심각한 폭발물과 고속 충격만이 이 벽을 손상시킬 수 "
"있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "scrrrash!"
msgstr "끄으르르 쾅!"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built reinforced concrete wall"
msgstr "반쯤 만든 철근 콘크리트 벽"

#. ~ Description for half-built reinforced concrete wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Poured concrete with methodically placed rebar sticking out, which isn't "
"practical for supporting roofs or shelter.  It appears to need more "
"resources before being considered complete."
msgstr ""
"지붕이나 대피소를 지탱하기에 실용적이지 않은, 방법론적으로 배치된 철근이 삐져나온 부어진 콘크리트다. 완성되려면 자재가 더 필요하다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "rebar cage"
msgstr "철근 골조"

#. ~ Description for rebar cage
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A structural support system made of rebar that appears to be the early "
"stages of a reinforced concrete wall, just missing the poured concrete."
msgstr "철근으로 만든 구조 지지대로, 부어진 콘크리트만 없는 철근 콘크리트 벽의 초기 단계로 보인다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "simple metal wall"
msgstr "간이 금속 벽"

#. ~ Description for simple metal wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A relatively simple wall made of scraped together metal.  It's still capable"
" of blocking intruders and supporting a roof with adjacent walls."
msgstr "긁어모은 금속으로 만든 비교적 단순한 벽이다. 침입자를 차단하고 인접한 벽과 함께 지붕을 지탱할 수 있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built simple metal wall"
msgstr "반쯤 만든 간이 금속 벽"

#. ~ Description for half-built simple metal wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A partially built makeshift wall of metal that could potentially support a "
"roof if it were completed."
msgstr "지붕을 지탱할 수 있는 수제 금속 벽이 부분적으로 건설되었다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "screen mesh wall"
msgstr "방충망 벽"

#. ~ Description for screen mesh wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A rather flimsy tall wall made of 2x4s and screen mesh, suitable for keeping"
" the bugs out."
msgstr "2x4 목재와 방충망으로 만든 꽤 얄팍한 높은 벽으로, 벌레를 막기에 적합합니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "wooden wall"
msgstr "나무 벽"

#. ~ Description for wooden wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A finished wall of planks and support beams, capable of supporting an upper "
"level or roof.  Still highly flammable."
msgstr "지붕이나 상층을 지탱할 수 있는 판자와 지지 대들보로 완성된 벽이다. 여전히 매우 가연성이 있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "chipped wood wall"
msgstr "금간 나무 벽"

#. ~ Description for chipped wood wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A wall of aligned two by fours that's starting to crack and break open.  "
"Some cut wood and a number of nails could patch this up quick."
msgstr "갈라지고 벌어지기 시작한 정렬된 2x4 목재 벽이다. 잘라낸 나무와 못 몇 개로 빠르게 수리할 수 있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "broken wood wall"
msgstr "부서진 나무 벽"

#. ~ Description for broken wood wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A number of planks are missing and the structure is beginning to sag and "
"fall apart.  It's going to need quite a bit of work to repair this wall."
msgstr "판자 여러 개가 없어지고 구조물이 처지고 무너지기 시작했다. 이 벽을 수리하려면 상당한 작업이 필요하다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "underwater wooden wall"
msgstr "수중 목재 벽"

#. ~ Description for underwater wooden wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A decaying old section of wooden wall, soaked through and leaking.  It will "
"likely crumble to bits if damaged."
msgstr "흠뻑 젖어 새고 있는 썩어가는 낡은 목재 벽 구간입니다. 손상되면 부스러질 가능성이 높습니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built log wall"
msgstr "반쯤 만든 통나무 벽"

#. ~ Description for half-built log wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A half-constructed wall of notched logs that interlock to provide stability."
"  Needs a few more logs to hold up a roof.  Looks flammable."
msgstr ""
"안정성을 위해 맞물리도록 홈이 패인 통나무를 반쯤 쌓아 올린 벽이다. 지붕을 지탱하려면 몇 개의 통나무가 더 필요하다. 가연성이 있어 "
"보인다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "log wall"
msgstr "통나무 벽"

#. ~ Description for log wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A tall wall of timber suitable for housing and insulating from the weather."
"  Quite flammable."
msgstr "주거용으로 적합하고 날씨를 차단하는 높은 목재 벽이다. 꽤 가연성이 있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "chipped log wall"
msgstr "금간 통나무 벽"

#. ~ Description for chipped log wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A moderately damaged wall, could probably be patched up with some planks and"
" nails."
msgstr "중간 정도 손상된 벽으로, 몇 개의 판자와 못으로 수리할 수 있을 것 같다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "broken log wall"
msgstr "부서진 통나무 벽"

#. ~ Description for broken log wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A destroyed wood wall, with only a supporting log left, ready to collapse.  "
"Looks repairable if the damage was replaced and patched together with nails "
"and planks."
msgstr "지지 통나무만 남아 무너지려는 파괴된 나무 벽이다. 못과 판자로 손상을 교체하고 수리하면 복구 가능하다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "palisade wall"
msgstr "말뚝 벽"

#. ~ Description for palisade wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"An age-old type of fortification consisting of hefty lumber staked into the "
"ground and cabled together."
msgstr "땅에 박아 케이블로 연결한 두꺼운 목재로 이루어진 오래된 유형의 요새 구조물이다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "wattle-and-daub wall"
msgstr "초벽"

#. ~ Description for wattle-and-daub wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A relatively primitive wall made by daubing together a lattice of wooden "
"strips using some combination of wet soil, clay, sand, animal dung and "
"straw."
msgstr "축축한 흙과 점토, 모래, 짐승 배설물, 짚을 조합해 나무 띠 격자를 발라 만든 비교적 원시적인 벽입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "broken wattle-and-daub wall"
msgstr "부서진 초벽"

#. ~ Description for broken wattle-and-daub wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"This wattle-and-daub wall section has been destroyed, leaving mostly just "
"frame, and is barely held together."
msgstr "이 회벽 구간은 파괴되어 대부분 골조만 남았고 겨우 붙어 있습니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "half-built wattle-and-daub wall"
msgstr "반쯤 만든 초벽"

#. ~ Description for half-built wattle-and-daub wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"This wattle-and-daub wall has some of the wooden strip lattice in place, and"
" still requires the rest of the lattice and supporting wet compound to be "
"filled in."
msgstr "이 회벽엔 나무 띠 격자 일부가 갖춰져 있고, 나머지 격자와 지탱하는 젖은 재료를 채워 넣어야 합니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "smooth dirt wall"
msgstr "매끈한 흙 벽"

#. ~ Description for smooth dirt wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A solid wall of compressed dirt, mixed with… something to keep it stable.  "
"Its surface glistens slightly, and it smells like rotten milk."
msgstr "안정을 위해… 무언가와 섞인 압축 흙으로 된 견고한 벽입니다. 표면이 살짝 반짝이고 썩은 우유 냄새가 납니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "heavy rumbling!"
msgstr "우르르 쿠궁!"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "junk metal wall"
msgstr "잡동사니 금속 벽"

#. ~ Description for junk metal wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A wall of rusty scrap metal bolted and wire-tied to a sturdy frame.  Very "
"fashionable in post-apocalyptic shantytowns.  Can support a roof."
msgstr ""
"튼튼한 프레임에 볼트로 고정하고 철사로 묶은 녹슨 고철 금속 벽이다. 포스트 아포칼립스 판자촌에서 매우 유행한다. 지붕을 지탱할 수 "
"있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "rammed earth wall"
msgstr "다짐 흙 벽"

#. ~ Description for rammed earth wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A solid wall of compressed dirt, sturdy enough to support a roof with enough"
" walls and keep out some unwanted visitors."
msgstr "압축 흙으로 된 견고한 벽으로, 충분한 벽이 있으면 지붕을 지탱하고 일부 원치 않는 방문객을 막을 만큼 튼튼합니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "junk metal barrier"
msgstr "잡동사니 금속 장벽"

#. ~ Description for junk metal barrier
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A short wall of rusty scrap metal bolted and wire-tied to a makeshift frame."
"  Very fashionable in post-apocalyptic shantytowns.  This one isn't quite "
"strong enough to support a roof, but could be reinforced."
msgstr ""
"녹슨 고철을 볼트와 철사로 사제 프레임에 묶은 낮은 벽입니다. 포스트 아포칼립스 판자촌에서 아주 유행입니다. 이것은 지붕을 지탱할 만큼 "
"충분히 강하지 않지만 보강할 수 있습니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "glass wall"
msgstr "유리 벽"

#. ~ Description for glass wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A barrier made of glass, it's nothing complicated, and looks extremely "
"fragile.  Some contain glass break sensors or window sensors that trigger if"
" the glass is tampered."
msgstr "유리로 만든 장벽으로 복잡하지 않으며 매우 깨지기 쉬워 보인다. 일부는 유리 파손 센서나 창문 센서가 장착되어 있다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "laminated glass"
msgstr "접합 유리"

#. ~ Description for laminated glass
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Laminated glass is composed layers of glass and plastic held together by an "
"interlayer."
msgstr "접합 유리는 중간층으로 붙잡힌 유리와 플라스틱 층으로 구성되어 있습니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "ballistic glass"
msgstr "방탄 유리"

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "reinforced glass"
msgstr "강화 유리"

#. ~ Description for reinforced glass
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A thicker pane of glass with thin metal wires embedded throughout, "
"strengthening the structural properties.  It's a lot stronger than drywall, "
"but it's not made to support a roof and is weaker than concrete."
msgstr ""
"구조적 강도를 높이기 위해 가는 금속선이 전체에 박힌 두꺼운 유리판입니다. 석고보드보다 훨씬 강하지만, 지붕을 지탱하도록 만들어지지 "
"않았고 콘크리트보다 약합니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "reinforced glass with closed shutters"
msgstr "셔터가 닫힌 강화 유리"

#. ~ Description for reinforced glass with closed shutters
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A secondary layer of protection over reinforced glass, these metal shutters "
"are typically used to ward off criminals or protect against damage from "
"extreme weather.  Looks like it can only be opened from the inside.  Even "
"with the installed shutters, it isn't feasible in supporting a roof."
msgstr ""
"강화 유리 위에 있는 2차 보호층인 이 금속 셔터는 일반적으로 범죄자를 막거나 극한 기상 피해로부터 보호하는 데 사용된다. 내부에서만 열"
" 수 있는 것 같다. 설치된 셔터가 있어도 지붕을 지탱하는 것은 불가능하다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "reinforced glass with open shutters"
msgstr "셔터가 열린 강화 유리"

#. ~ Description for reinforced glass with open shutters
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Hanging metal shutters that haven't been deployed, exposing the reinforced "
"glass.  It appears as though the metal shutters can only be activated from "
"the inside."
msgstr "닫혀 있지 않아 강화 유리가 노출된 매달린 금속 셔터다. 금속 셔터는 내부에서만 활성화할 수 있는 것 같다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "metal bars"
msgstr "쇠창살"

#. ~ Description for metal bars
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"Thick, heavy bars from the floor to the ceiling, interlaced wall to wall.  "
"Not made to support roofs, but great for blocking paths."
msgstr ""
"바닥에서 천장까지 벽에서 벽까지 교차하는 두꺼운 무거운 철봉이다. 지붕을 지탱하도록 만들어지지 않았지만 통로를 차단하기에 훌륭하다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "paper wall"
msgstr "종이 벽"

#. ~ Description for paper wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A huge wall of pulpy mass, covered in sticky wasp saliva.  You could smash "
"it down effortlessly."
msgstr "펄프 덩어리로 된 거대한 벽으로, 끈적한 말벌 침이 덮여 있습니다. 손쉽게 부술 수 있습니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "layered paper wall"
msgstr "겹친 종이 벽"

#. ~ Description for layered paper wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid ""
"A thick wall of layered tree pulp and wasp saliva, hardened to withstand the"
" elements.  You could break through this, but it won't be easy."
msgstr "겹친 나무 펄프와 말벌 침으로 된 두꺼운 벽으로, 날씨를 견디도록 경화됐습니다. 뚫을 수는 있지만 쉽지 않을 겁니다."

#: data\json\furniture_and_terrain\terrain-walls.json
#: data\mods\Arcana_BN\furniture_and_terrain\terrain.json
msgid "root wall"
msgstr "뿌리 벽"

#. ~ Description for root wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "A dirt wall covered with roots."
msgstr "뿌리로 덮인 흙 벽입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
msgid "wax wall"
msgstr "밀랍 벽"

#. ~ Description for wax wall
#: data\json\furniture_and_terrain\terrain-walls.json
msgid "A wall made entirely out of wax."
msgstr "전부 밀랍으로 된 벽입니다."

#: data\json\furniture_and_terrain\terrain-walls.json
#: data\json\overmap\overmap_terrain\overmap_terrain.json
