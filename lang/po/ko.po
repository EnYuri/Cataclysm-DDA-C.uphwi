msgstr "구덩이에 빠졌다!"

#: src/trapfunc.cpp
msgid "You fall in a spiked pit!"
msgstr "가시 구덩이에 떨어졌다!"

#: src/trapfunc.cpp
msgid "You fall into the sinkhole!"
msgstr "싱크홀에 빠졌다!"

#: src/game.cpp
msgid "You fall into water."
msgstr "물 속에 들어갔다."

#: src/character.cpp
msgid "You fall off your mount!"
