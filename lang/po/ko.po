#: src/suffer.cpp
msgid "You fall over!"
msgstr "넘어졌습니다!"

#: src/monattack.cpp
msgid ""
"You fall to the ground and feign a sudden convulsive attack.  Though you're "
"obviously still alive, the riotbot cannot tell the difference between your "
"'attack' and a potentially fatal medical condition.  It backs off, signaling"
" for medical help."
msgstr ""
"바닥에 쓰러지면서 급성 발작을 연기했다. 멀쩡히 살아있음에도 불구하고, 지금 일어난 '급성 발작'과 치명적인 질병을 구분하지 못 한 폭동"
" 진압 로봇은 물러서서 긴급 구조 신호를 보내기 시작했다."

#: src/suffer.cpp
msgid "You fall to the ground!"
msgstr "지면에 쓰러졌다!"

#: src/consumption.cpp
msgid "You feast upon the sweet honey."
msgstr "달콤한 꿀을 아주 맛있게 즐겼다."

#: src/iuse.cpp
msgid "You feed your %1$s to the %2$s."
msgstr "%2$s에게 %1$s을(를) 먹였습니다."

#: src/suffer.cpp
msgid "You feel a bit queasy in your sleep."
msgstr "잠결에 약간 메스꺼움을 느낍니다."

#: src/iuse.cpp
msgid "You feel a bit wobbly."
msgstr "약간 어지럽다."

#: src/iuse.cpp
msgid "You feel a burning sensation under your skin that quickly fades away."
msgstr "피부 밑에서 타오르는 감각이 느껴졌지만, 금세 사라졌다."

#: src/player_hardcoded_effects.cpp
msgid "You feel a buzzing in the back of your mind, but it passes."
msgstr "머릿속에서 윙윙거림을 느끼지만 지나갑니다."

#: src/iuse.cpp
msgid "You feel a distinct burning inside, but it passes."
msgstr "체내에서 열기를 느꼈지만, 금세 사라졌다."

#: src/iuse.cpp
msgid ""
"You feel a familiar warmth, but suddenly it surges into an excruciating burn"
" as you convulse, vomiting, and black out…"
msgstr "익숙한 온기가 느껴지지만, 갑자기 견딜 수 없는 화상 같은 고통으로 치솟으며 경련과 구토와 함께 정신을 잃습니다…"

#: src/iuse.cpp
msgid ""
"You feel a familiar warmth, but suddenly it surges into painful burning as "
"you convulse and collapse to the ground…"
msgstr "익숙한 온기가 느껴지지만, 갑자기 고통스러운 타는 감각으로 치솟으며 경련과 함께 바닥에 쓰러집니다…"

#: src/game.cpp
msgid "You feel a force pulling you inwards."
msgstr "체내로 집중되는 힘이 느껴진다."

#: src/player_hardcoded_effects.cpp
msgid "You feel a little strange."
msgstr "조금 이상한 기분이 들었다."

#: src/game.cpp
msgid "You feel a pleasant tingle."
msgstr "기분 좋은 저림이 느껴집니다."

#: src/iuse.cpp
msgid "You feel a slight itching inside, but it passes."
msgstr "조금 간질거렸지만, 금세 사라졌다."

#: src/monattack.cpp
msgid "You feel a strange reverberation across your body."
msgstr "몸 전체에 이상한 울림이 느껴진다."

#: src/iuse.cpp
msgid "You feel a strange warmth spreading throughout your body…"
msgstr "이상한 온기가 온몸에 퍼지는 것을 느낍니다…"

#: src/teleport.cpp
msgid "You feel a strange, inwards force."
msgstr "기묘한 안쪽으로의 힘을 느낍니다."

#: src/ranged.cpp
msgid "You feel a surge of euphoria as flames roar out of the %s!"
msgstr "%s에서 불꽃이 쏟아지자 행복감이 밀려옵니다!"

#: src/game.cpp
msgid "You feel a tickle of insanity."
msgstr "광기로 인해 몸이 근질거린다."

#: src/bionics.cpp
msgid ""
"You feel a tiny pricking sensation in your right arm, and lose all sensation"
" before abruptly blacking out."
msgstr "오른팔에 살짝 따끔하더니 갑자기 감각이 사라지며 정신을 잃습니다."

#: src/activity_handlers.cpp
msgid "You feel a tug on your line!"
msgstr "낚싯줄이 당겨지는 게 느껴진다!"

#: src/monattack.cpp src/mondefense.cpp
msgid "You feel an angry presence."
msgstr "분노한 존재가 느껴진다."

#: src/suffer.cpp
msgid "You feel an anomalous sensation coming from your radiation sensors."
msgstr "당신의 방사능 센서로부터 오는 비정상적인 신호가 느껴진다."

#: src/game.cpp
msgid "You feel an otherworldly attention upon you…"
msgstr "이세상의 시선이 당신에게 향하는 것을 느낍니다…"

#: src/addiction.cpp
msgid "You feel anxious.  You need your painkillers!"
msgstr "불안감이 느껴진다. 진통제가 필요해!"

#: src/suffer.cpp
msgid "You feel as if your insides are rotting away."
msgstr "속이 썩어가는 듯한 느낌이 듭니다."

#: src/consumption.cpp
msgid "You feel as though you're going to split open!  In a good way?"
msgstr "찢어지는 듯한 기분이다! 긍정적인 의미로."

#: src/mondeath.cpp
msgid "You feel ashamed for killing %s."
msgstr "%s을(를) 죽인 것이 부끄럽습니다."

#: src/iuse.cpp
msgid "You feel better all over."
msgstr "기분이 매우 좋아졌다."

#: src/iuse.cpp
msgid "You feel cleansed."
msgstr "정화되는 듯한 느낌이다."

#: src/iuse.cpp
msgid "You feel completely exhausted."
msgstr "완전히 지쳤다."

#: src/addiction.cpp
msgid "You feel depressed.  Speed would help."
msgstr "우울한 기분이 든다. 각성제가 도움이 될 것 같다."

#: src/teleport.cpp
msgid "You feel disjointed."
msgstr "몸이 어긋난 듯한 느낌이 듭니다."

#: src/suffer.cpp
msgid "You feel dizzy for a moment."
msgstr "잠깐 어지러움을 느꼈다."

#: src/bionics.cpp
msgid ""
"You feel excited as the Autodoc slices painlessly into you.  You enjoy the "
"sight of scalpels slicing you apart."
msgstr "오토닥이 고통 없이 당신을 절개하는 것에 흥분을 느낍니다. 메스가 당신을 가르는 광경을 즐깁니다."

#: src/bionics.cpp
msgid "You feel excited as the operation starts."
msgstr "수술이 시작되자 설레는 느낌이 듭니다."

#: src/mutation.cpp
msgid "You feel extremely disappointed as nothing happens."
msgstr "아무 일도 일어나지 않아 극도로 실망합니다."

#: src/game.cpp src/relic.cpp
msgid "You feel fatigue seeping into your body."
msgstr "피로가 몸속으로 스며드는 느낌이 듭니다."

#: src/suffer.cpp
msgid "You feel fatigued all of a sudden."
msgstr "갑자기 피로감이 든다."

#: src/mondeath.cpp
msgid "You feel guilty for killing %s."
msgstr "%s을(를) 죽인 것에 죄책감을 느꼈다."

#: src/suffer.cpp
msgid "You feel heartburn and an acid taste in your mouth."
msgstr "속쓰림과 신맛이 느껴집니다."

#: src/consumption.cpp
msgid "You feel horrible for eating a person."
msgstr "식인하는 것에 대해 끔찍한 기분이 들었다."

#: src/iuse_actor.cpp
msgid "You feel horrible for mutilating and enslaving someone's corpse."
msgstr "누군가의 시체를 훼손하고 노예처럼 부리려 한다는 사실에 죄책감이 몰려온다."

#: src/game.cpp
msgid "You feel hungry."
msgstr "허기가 느껴진다."

#: src/game.cpp
msgid "You feel insulated."
msgstr "절연 상태가 된 것이 느껴진다."

#: src/monattack.cpp src/mondefense.cpp
msgid "You feel intensely hated for a moment."
msgstr "순간 강렬한 증오가 느껴진다."

#: src/suffer.cpp
msgid "You feel lightheaded for a moment."
msgstr "잠깐 어지러움을 느꼈다."

#: src/suffer.cpp
msgid ""
"You feel like something is judging you from afar, leaving your head "
"spinning."
msgstr "멀리서 무언가가 당신을 심판하는 듯해 머리가 핑핑 돕니다."

#: src/mutation.cpp src/mutation_ui.cpp
msgid "You feel like using your %s would kill you!"
msgstr "%s을(를) 사용하면 죽을 지도 모른다!"

#: src/character.cpp
msgid "You feel like you haven't slept in days."
msgstr "며칠 동안 잠을 못 잔 것 같다."

#: src/addiction.cpp
msgid "You feel like you need a bump."
msgstr "뭔가 끝내주는 게 더 필요할 것 같다."

#: src/monattack.cpp
msgid "You feel like you're being watched, it makes you sick."
msgstr "뭔가가 날 바라보는 것 같아 불편한 기분이 든다."

#: src/activity_handlers.cpp
msgid "You feel like you've learned a little bit."
msgstr "조금 배운 것 같습니다."

#: src/suffer.cpp
msgid "You feel mentally tired."
msgstr "정신적인 피로감이 느껴진다."

#: src/monattack.cpp
msgid "You feel millions of live spores pumping into you…"
msgstr "수백만 개의 살아있는 포자가 몸속으로 쏟아져 들어오는 게 느껴진다…"

#: src/iuse.cpp
msgid "You feel much better - almost entirely."
msgstr "훨씬 나아진 느낌입니다 - 거의 완전히."

#: src/activity_handlers.cpp
msgid "You feel much better."
msgstr "기분이 훨씬 나아졌다."

#: src/player_hardcoded_effects.cpp
msgid "You feel nauseous!"
msgstr "토할 것 같다!"

#: src/player_hardcoded_effects.cpp
msgid "You feel nauseous."
msgstr "메스꺼움이 느껴진다."

#: src/suffer.cpp
msgid "You feel nauseous…"
msgstr "메스꺼움을 느낍니다…"

#: src/iuse.cpp
msgid "You feel nostalgic as you stare at the photo."
msgstr "사진을 보며 향수에 잠겼다."

#: src/iexamine.cpp
msgid "You feel out of place as you explore the %s. Drink?"
msgstr "%s을(를) 조사하다 보니 얼떨떨하고 갑자기 세상이 낯설게 느껴진다. 마십니까?"

#: src/player_hardcoded_effects.cpp
msgid ""
"You feel physically rested, but you haven't been able to catch up on your "
"missed sleep yet."
msgstr "몸은 개운하지만 밀린 잠을 완전히 만회하지 못 했습니다."

#: src/creature.cpp
msgid "You feel poison coursing through your body!"
msgstr "독이 몸속을 흐르는 걸 느낍니다!"

#: src/monattack.cpp
msgid "You feel poison enter your body!"
msgstr "몸에 독이 퍼지는 것을 느꼈다!"

#: src/construction.cpp
msgid ""
"You feel relieved after providing last rites for this human being, whose "
"name is lost in the Cataclysm."
msgstr "대재앙에 이름이 잊힌 이 사람에게 장례를 치러주고 나니 안도감이 듭니다."

#: src/mondeath.cpp
msgid "You feel remorse for killing %s."
msgstr "%s을(를) 죽인 것에 대해 회한을 느꼈다."

#: src/construction.cpp
msgid ""
"You feel sadness, but also relief after providing last rites for %s, whose "
"name you will keep in your memory."
msgstr "기억 속에 남길 %s에게 장례를 치러주고 나니 슬프면서도 안도감이 듭니다."

#: src/player_hardcoded_effects.cpp
msgid "You feel sick to your stomach."
msgstr "배가 아프다."

#: src/iuse.cpp
msgid "You feel sleepy…"
msgstr "졸음이 옵니다…"

#: src/player_hardcoded_effects.cpp
msgid "You feel something probing your mind, but it is rebuffed!"
msgstr "무언가가 마음을 헤집는 걸 느끼지만 튕겨냈습니다!"

#: src/player_hardcoded_effects.cpp
msgid ""
"You feel something reaching out to you, before reality around you frays!"
msgstr "주변 현실이 흩어지기 전, 무언가가 당신에게 손을 뻗는 걸 느낍니다!"

#: src/player_hardcoded_effects.cpp
msgid "You feel something scream in the back of your mind!"
msgstr "머릿속에서 무언가가 비명 지르는 걸 느낍니다!"

#: src/mutation.cpp
msgid "You feel something straining deep inside you, yearning to be free…"
msgstr "내면 깊은 곳에서 무언가가 자유를 갈망하며 몸부림치는 걸 느낍니다…"

#: src/game.cpp
msgid "You feel storms coming."
msgstr "폭풍이 다가오는 것이 느껴진다."

#: src/character.cpp
msgid "You feel that %s tasks of this level are becoming trivial."
msgstr "이 정도의 %s작업은 쉬워진 것 같다."

#: src/map/map.cpp
msgid "You feel the ground beneath you shake from the impact!"
msgstr "충격으로 발밑의 땅이 흔들리는 걸 느낍니다!"

#: src/suffer.cpp
msgid "You feel the water burning your skin."
msgstr "물이 피부를 태우는 걸 느낍니다."

#: src/game.cpp
msgid "You feel thirsty."
msgstr "갈증이 느껴진다."

#: src/monattack.cpp
msgid "You feel thousands of live spores pumping into you…"
msgstr "수천 개의 살아있는 포자가 몸속으로 쏟아져 들어오는 게 느껴진다…"

#: src/suffer.cpp
msgid "You feel tired…"
msgstr "피곤함을 느낍니다…"

#: src/iuse_actor.cpp
msgid "You feel too weak to play your %s"
msgstr "힘이 많이 부족해서 %s 연주를 할 수 없다"

#: src/iuse.cpp
msgid "You feel tough."
msgstr "강해진 것 같다."

#: src/game.cpp
msgid "You feel unwell."
msgstr "몸이 편치 않다."

#: src/monster.cpp
msgid "You feel venom enter your body!"
msgstr "몸에 독이 퍼지는 것을 느꼈다!"

#: src/creature.cpp src/monster.cpp
msgid "You feel venom flood your body, wracking you with pain…"
msgstr "독이 온몸에 퍼져 고통에 몸부림칩니다…"

#: src/player_hardcoded_effects.cpp
msgid "You feel weird for a moment, but it passes."
msgstr "잠시 이상한 느낌이 들지만 지나갑니다."

#: src/player_hardcoded_effects.cpp
msgid "You feel well rested."
msgstr "편히 잘 쉰 것 같다."

#: src/iexamine.cpp
msgid "You feel woozy as you explore the %s. Drink?"
msgstr "%s을(를) 조사하다 보니 머리가 멍해진다. 마십니까?"

#: src/character.cpp
msgid "You feel your %s beginning to go numb from the cold!"
msgstr "추위 때문에 %s에 감각이 없어졌다!"

#: src/character.cpp
msgid "You feel your %s getting chilly."
msgstr "%s이(가) 약간 차가워졌다."

#: src/character.cpp
msgid "You feel your %s getting red hot from the heat!"
msgstr "열기에 %s이(가) 달아 오르는 게 느껴진다!"

#: src/character.cpp
msgid "You feel your %s getting very cold."
msgstr "%s이(가) 아주 차가워졌다."

#: src/character.cpp
msgid "You feel your %s getting very hot."
msgstr "%s이(가) 아주 뜨거워졌다."

#: src/character.cpp
msgid "You feel your %s getting warm."
msgstr "%s이(가) 약간 뜨거워졌다."

#: src/game.cpp src/relic.cpp
msgid "You feel your body decaying."
msgstr "몸이 점점 썩어가는 것이 느껴진다."

#: src/suffer.cpp
msgid "You feel your faulty bionic shuddering."
msgstr "결함 있는 바이오닉이 떨리는 것을 느낍니다."

#: src/game.cpp
msgid "You feel your genetic makeup degrading."
msgstr "유전자 구성이 나빠지는 것 같다."

#: src/trapfunc.cpp
msgid "You feel your life force sapping away."
msgstr "생기가 빨려나가는 것 같다."

#: src/bionics.cpp
msgid "You feel your throat open up and air filling your lungs!"
msgstr "목구멍이 열리고 폐에 공기가 들어오는 것을 느꼈습니다!"

#: src/iexamine.cpp
msgid "You fertilize the %1$s with the %2$s."
msgstr "%2$s으로 %1$s에 비료를 줍니다."

