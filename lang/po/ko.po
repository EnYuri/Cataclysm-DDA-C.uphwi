msgid_plural "skeletal torvosaurus brutes"
msgstr[0] "해골 토르보사우루스 브루트"

#. ~ Description for {'str': 'skeletal torvosaurus brute'}
#: data\mods\DinoMod\monsters\zinosaur_upgrade.json
msgid ""
"Distorted outgrowths of calcified bone plates cover this dinosaur's rotten "
"flesh and long toothy jaws.  Joints and cracks around its body ooze with "
"black goo."
msgstr ""
"석회화된 뼈판이 뒤틀리게 자라나 이 공룡의 썩은 살점과 이빨이 난 긴 턱을 덮고 있습니다. 몸 전체의 관절과 균열에서 검은 점액이 스며 "
"나옵니다."

#: data\mods\DinoMod\monsters\zinosaur_upgrade.json
