#: data\mods\DinoMod\monster_attacks.json
msgid "T-Rex Bio-Operator recording"
msgstr "티라노 바이오 오퍼레이터 녹음"

#. ~ Description for {'str': 'T-Rex Bio-Operator recording'}
#: data\mods\DinoMod\monster_attacks.json
