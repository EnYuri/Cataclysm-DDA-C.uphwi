#: data\mods\ProjectSquirrel\items\item_common\sq_shields.json
msgid "Stash ammo"
msgstr "탄약 수납"

#. ~ Description for {'str': 'magazine satchel'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A fabric ammo bag worn at the waist which is capable of holding two "
"magazines, ammo belts, speedloaders of nearly any size close at hand."
msgstr "허리에 차고 탄창 2개, 탄약 벨트, 거의 모든 크기의 스피드로더를 가까이 넣을 수 있는 천 탄약 가방입니다."

#: data\json\items\armor\ammo_pouch.json
msgid "chest magazine pouch"
msgid_plural "chest magazine pouches"
msgstr[0] "흉부 탄창 파우치"

#. ~ Description for {'str': 'chest magazine pouch', 'str_pl': 'chest magazine
#. pouches'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A fabric ammo pouch that can be strapped to your chest which is capable of "
"holding two magazines or speedloaders close at hand."
msgstr "가슴에 묶을 수 있고 탄창 2개나 스피드로더를 가까이 넣을 수 있는 천 탄약 파우치입니다."

#: data\json\items\armor\ammo_pouch.json
msgid "chest rig"
msgid_plural "chest rig"
msgstr[0] "군용 조끼"

#. ~ Description for {'str_sp': 'chest rig'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"Popularized during the Vietnam War, chest rigs like these are typically "
"plain, barebones affairs consisting of three or more pouches in a row, with "
"straps to secure them on your chest.  This one can hold four magazines or "
"speedloaders in its pouches."
msgstr ""
"베트남전 때 유행한 이런 체스트 리그는 보통 소박하고 단출한 것으로, 가슴에 고정하는 끈이 달린 3개 이상의 파우치 열로 구성됩니다. "
"이건 파우치에 탄창이나 스피드로더 4개를 넣을 수 있습니다."

#: data\json\items\armor\ammo_pouch.json
msgid "javelin bag"
msgid_plural "javelin bags"
msgstr[0] "자벨린 가방"

#. ~ Use action holster_prompt for {'str': 'javelin bag'}.
#: data\json\items\armor\ammo_pouch.json
msgid "Stash javelins"
msgstr "자벨린 집어넣기"

#. ~ Description for {'str': 'javelin bag'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"An open medieval-looking bag, designed to store javelins for easy reach."
msgstr "자벨린을 잡아 던지기 편하도록 만들어진 중세식 가방."

#: data\json\items\armor\ammo_pouch.json
msgid "ankle magazine pouch"
msgid_plural "ankle magazine pouches"
msgstr[0] "발목 탄창 파우치"

#. ~ Description for {'str': 'ankle magazine pouch', 'str_pl': 'ankle magazine
#. pouches'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A small fabric ammo pouch that can be strapped to your ankle which is "
"capable of holding a single small magazine or speedloader close at hand."
msgstr "발목에 묶을 수 있고 작은 탄창이나 스피드로더 하나를 가까이 넣을 수 있는 작은 천 탄약 파우치입니다."

#: data\json\items\armor\ammo_pouch.json
msgid "leg magazine pouch"
msgid_plural "leg magazine pouches"
msgstr[0] "다리 탄창 파우치"

#. ~ Description for {'str': 'leg magazine pouch', 'str_pl': 'leg magazine
#. pouches'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A fabric ammo pouch that can be strapped to your leg and capable of holding "
"two magazines close at hand."
msgstr "다리에 묶을 수 있고 탄창 2개를 가까이 넣을 수 있는 천 탄약 파우치입니다."

#: data\json\items\armor\ammo_pouch.json
msgid "leg magazine satchel"
msgid_plural "leg magazine satchels"
msgstr[0] "다리 탄창 가방"

#. ~ Description for {'str': 'leg magazine satchel'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A fabric ammo pouch that can be strapped to the leg, capable of holding a "
"single magazine, ammo belt, or speedloader of modest size."
msgstr "다리에 묶을 수 있고 적당한 크기의 탄창, 탄약 벨트, 스피드로더 하나를 넣을 수 있는 천 탄약 파우치입니다."

#: data\json\items\armor\ammo_pouch.json
#: data\mods\MagicalNights\items\armor.json
msgid "quiver"
msgid_plural "quivers"
msgstr[0] "화살통"

#. ~ Description for {'str': 'quiver'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A leather quiver worn at the waist that can hold 20 arrows.  Activate to "
"store arrows."
msgstr "허리에 매는 가죽 화살통. 사용키를 눌러 최대 20발의 화살을 담을 수 있습니다."

#: data\json\items\armor\ammo_pouch.json
#: data\mods\MagicalNights\items\armor.json
msgid "birchbark quiver"
msgid_plural "birchbark quivers"
msgstr[0] "자작나무 화살통"

#. ~ Description for {'str': 'birchbark quiver'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A quiver woven from strips of birch bark, worn at the waist, that can hold "
"20 arrows.  Activate to store arrows."
msgstr "자작나무 껍질을 엮어만든 허리에 메는 화살통. 사용키를 눌러 최대 20발의 화살을 담을 수 있습니다."

#: data\json\items\armor\ammo_pouch.json
#: data\mods\MagicalNights\items\armor.json
msgid "large quiver"
msgid_plural "large quivers"
msgstr[0] "큰 화살통"

#. ~ Description for {'str': 'large quiver'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A large leather quiver trimmed with metal, worn on the back, that can hold "
"60 arrows.  Historically used by horse archers, rather than foot archers, "
"but neither of THEM had to fight zombies.  Activate to store arrows."
msgstr ""
"가죽에 금속을 덧대서 만든 커다란 화살통. 등에 착용하며 화살 60발을 수납할 수 있습니다. 역사상 일반 궁수들보다는 기마 궁수들이 흔히"
" 사용한 장비입니다만 그들은 좀비와 싸울 필요는 없었지요. 사용하면 화살을 채워넣습니다."

#: data\json\items\armor\ammo_pouch.json
#: data\mods\MagicalNights\items\armor.json
msgid "large birchbark quiver"
msgid_plural "large birchbark quivers"
msgstr[0] "대형 자작나무 화살통"

#. ~ Description for {'str': 'large birchbark quiver'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A large quiver woven from strips of birchbark, worn on the back, that can "
"hold 60 arrows.  Activate to store arrows."
msgstr "자작나무 껍질을 엮어만든 등에 메는 대형 화살통. 사용키를 눌러 최대 60발의 화살을 담을 수 있습니다."

#: data\json\items\armor\ammo_pouch.json
msgid "atlatl dart quiver"
msgid_plural "atlatl dart quivers"
msgstr[0] "아틀라틀 다트 통"

#. ~ Description for {'str': 'atlatl dart quiver'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A leather quiver worn at the waist, lengthened to hold atlatl darts.  "
"Activate to store up to 10 darts."
msgstr "아틀라틀 다트를 담게 길게 만든, 허리에 차는 가죽 퀴버입니다. 활성화해 최대 10개의 다트를 보관합니다."

#: data\json\items\armor\ammo_pouch.json
msgid "birchbark atlatl dart quiver"
msgid_plural "birchbark atlatl dart quivers"
msgstr[0] "자작나무껍질 아틀라틀 다트 통"

#. ~ Description for {'str': 'birchbark atlatl dart quiver'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A quiver woven from strips of birch bark, worn at the waist, lengthened to "
"hold atlatl darts.  Activate to store up to 10 darts."
msgstr ""
"자작나무 껍질 조각으로 짠 퀴버로, 허리에 차고 아틀라틀 다트를 담게 길게 만들었습니다. 활성화해 최대 10개의 다트를 보관합니다."

#: data\json\items\armor\ammo_pouch.json
msgid "tac vest"
msgid_plural "tac vests"
msgstr[0] "전술 조끼"

#. ~ Description for {'str': 'tac vest'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"This light vest is meant to carry your gear and ammunition comfortably "
"distributed about your torso.  They are popular amongst law enforcement, but"
" less so than combination tactical vests incorporating Kevlar.  Lightweight "
"and easy to don, this vest can hold four magazines close at hand in its many"
" pouches."
msgstr ""
"이 가벼운 조끼는 장비와 탄약을 몸통에 편하게 분산해 나르도록 된 것입니다. 법집행에게 인기지만 케블라 결합 전술 조끼보단 덜 "
"인기입니다. 가볍고 입기 쉬우며, 여러 파우치에 탄창 4개를 가까이 넣을 수 있습니다."

#: data\json\items\armor\ammo_pouch.json
#: data\mods\exotic_ammo\bandoliers-pouches.json
msgid "leg ammo satchel"
msgid_plural "leg ammo satchels"
msgstr[0] "다리 탄약 가방"

#. ~ Description for {'str': 'leg ammo satchel'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A small pouch wrapped around the leg that can be used to store most types of"
" small ammunition, rockets will not fit.  Activate to store ammunition."
msgstr ""
"다리에 두르는 작은 파우치로 대부분의 소형 탄약을 보관하는 데 쓸 수 있지만, 로켓탄은 안 들어갑니다. 활성화해 탄약을 보관합니다."

#: data\json\items\armor\ammo_pouch.json
msgid "shoulder magazine pouch"
msgid_plural "shoulder magazine pouches"
msgstr[0] "어깨 탄창 파우치"

#. ~ Description for {'str': 'shoulder magazine pouch', 'str_pl': 'shoulder
#. magazine pouches'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A shoulder pouch designed to be worn under a jacket or coat that can hold "
"two small magazines or speedloaders. Normally meant to be worn alongside a "
"shoulder holster, but can be used on its own."
msgstr ""
"재킷이나 코트 안에 차도록 설계된 어깨 파우치로, 작은 탄창이나 스피드로더 2개를 넣을 수 있습니다. 보통 어깨 홀스터와 함께 차지만 "
"단독으로도 쓸 수 있습니다."

#: data\json\items\armor\ammo_pouch.json
msgid "magazine belt"
msgid_plural "magazine belt"
msgstr[0] "탄창 벨트"

#. ~ Description for {'str_sp': 'magazine belt'}
#: data\json\items\armor\ammo_pouch.json
msgid ""
"A belt worn across the waist, with pouches that can hold up to eight small "
"magazines or speedloaders."
msgstr "허리에 차는 벨트로, 최대 8개의 작은 탄창이나 스피드로더를 넣을 수 있는 파우치가 달렸습니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of 2-by-arm guards"
msgid_plural "pairs of 2-by-arm guards"
msgstr[0] "강화된 팔 보호대"

#. ~ Description for {'str': 'pair of 2-by-arm guards', 'str_pl': 'pairs of
#. 2-by-arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A pair of improvised arm guards made from broken pieces of a two by four "
"that are tied to your arms with rags and string.  They offer good "
"protection, but are really uncomfortable to wear."
msgstr ""
"부서진 재목 조각을 천 조각과 실을 이용해 팔에 맞게 묶은 팔 보호대 한 쌍. 훌륭한 방어력을 제공하지만, 착용하면 상당히 불편합니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of chitin arm guards"
msgid_plural "pairs of chitin arm guards"
msgstr[0] "키틴질 팔 보호구"

#. ~ Description for {'str': 'pair of chitin arm guards', 'str_pl': 'pairs of
#. chitin arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A pair of arm guards made from the exoskeletons of insects.  Light and "
"durable."
msgstr "곤충의 외골격으로 만들어진 팔 보호구 한 쌍. 가볍고 견고합니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of biosilicified chitin arm guards"
msgid_plural "pairs of biosilicified chitin arm guards"
msgstr[0] "유기규소 키틴질 팔 보호구"

#. ~ Description for {'str': 'pair of biosilicified chitin arm guards',
#. 'str_pl': 'pairs of biosilicified chitin arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A pair of arm guards crafted from the carefully cleaned and pruned "
"biosilicified exoskeletons of acidic ants.  Acid-resistant and very durable."
msgstr ""
"조심스럽게 다듬고 잘라낸 유기규소화된 산성 개미의 외골격으로 만들어진 한 쌍의 팔 보호구입니다. 내산성이 있고 아주 견고합니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of hard arm guards"
msgid_plural "pairs of hard arm guards"
msgstr[0] "견고한 팔 보호구"

#. ~ Description for {'str': 'pair of hard arm guards', 'str_pl': 'pairs of
#. hard arm guards'}
#: data\json\items\armor\arms_armor.json
msgid "A pair of neoprene arm sleeves covered with molded plastic sheaths."
msgstr "플라스틱 피복으로 감싼 네오프렌 팔 보호대 한 쌍."

#: data\json\items\armor\arms_armor.json
msgid "pair of leather arm guards"
msgid_plural "pairs of leather arm guards"
msgstr[0] "가죽 팔 보호구"

#. ~ Description for {'str': 'pair of leather arm guards', 'str_pl': 'pairs of
#. leather arm guards'}
#: data\json\items\armor\arms_armor.json
msgid "A pair of tough leather arm guards.  Light and comfortable."
msgstr "튼튼한 가죽 팔 보호대 한 쌍. 가볍고 착용감이 편합니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of steel arm guards"
msgid_plural "pairs of steel arm guards"
msgstr[0] "강철 팔 보호구"

#. ~ Description for {'str': 'pair of steel arm guards', 'str_pl': 'pairs of
#. steel arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A full assembly of medieval arm protection.  Rerebraces, couters, and "
"vambraces, with leather straps to secure each piece and connect it as part "
"of a set."
msgstr ""
"완전한 중세 팔 보호구 한 세트. 팔 상부 보호대, 팔꿈치 보호대, 팔 하부 보호대와 각 부분이 가죽끈으로 고정되었고, 연결되어 한 "
"세트로 되어 있습니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of superalloy arm guards"
msgid_plural "pairs of superalloy arm guards"
msgstr[0] "초합금 팔 보호대 한 쌍"

#. ~ Description for {'str': 'pair of superalloy arm guards', 'str_pl': 'pairs
#. of superalloy arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A full assembly of medieval arm protection, made from cutting-edge "
"superalloy.  Rerebraces, couters, and vambraces, with leather straps to "
"secure each piece and connect it as part of a set."
msgstr ""
"최첨단 초합금으로 만든 중세식 팔 보호 전체 조립품입니다. 리어브레이스, 쿠터, 밤브레이스와 각 부분을 고정하고 세트로 연결하는 가죽 "
"끈이 있습니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of metal arm guards"
msgid_plural "pairs of metal arm guards"
msgstr[0] "금속 팔 보호구"

#. ~ Description for {'str': 'pair of metal arm guards', 'str_pl': 'pairs of
#. metal arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A pair of arm guards hammered out from metal.  Perfect for the Post-"
"Apocalyptic Warrior look."
msgstr "금속을 두드려 만든 팔 보호구 한 쌍. 포스트 아포칼립스의 전사 같은 분위기를 냅니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of bronze arm guards"
msgid_plural "pairs of bronze arm guards"
msgstr[0] "청동 팔 보호대 한 쌍"

#. ~ Description for {'str': 'pair of bronze arm guards', 'str_pl': 'pairs of
#. bronze arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A pair of arm guards hammered out from sheets of bronze, for a classical "
"take on the Post-Apocalyptic Warrior look."
msgstr "청동판을 두들겨 만든 팔 보호대 한 쌍으로, 포스트아포칼립스 전사 룩을 고전적으로 연출합니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of paper arm guards"
msgid_plural "pairs of paper arm guards"
msgstr[0] "종이 팔 보호구"

#. ~ Description for {'str': 'pair of paper arm guards', 'str_pl': 'pairs of
#. paper arm guards'}
#: data\json\items\armor\arms_armor.json
msgid "Arm guards made of stacked paper sheets held together with duct tape."
msgstr "종이를 여러 장 덧대고 접착 테이프로 붙여 만든 팔 보호구."

#: data\json\items\armor\arms_armor.json
msgid "pair of scrap arm guards"
msgid_plural "pairs of scrap arm guards"
msgstr[0] "고철 팔 보호대 한 쌍"

#. ~ Description for {'str': 'pair of scrap arm guards', 'str_pl': 'pairs of
#. scrap arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"A pair of arm guards made from scraps of metal secured by simple strings; "
"the loose collection of plates provides decent but not the most convenient "
"protection."
msgstr ""
"단순한 끈으로 고정한 금속 조각으로 만든 팔 보호대 한 쌍입니다. 느슨한 판 모음이 괜찮지만 가장 편하진 않은 보호를 제공합니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of neoprene arm sleeves"
msgid_plural "pairs of neoprene arm sleeves"
msgstr[0] "네오프렌 팔 소매"

#. ~ Description for {'str': 'pair of neoprene arm sleeves', 'str_pl': 'pairs
#. of neoprene arm sleeves'}
#: data\json\items\armor\arms_armor.json
msgid "A pair of soft neoprene arm sleeves.  Often used in contact sports."
msgstr "부드러운 네오프렌 팔 보호대 한 쌍. 직접 몸이 닿는 스포츠용으로 사용됩니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of chainmail sleeves"
msgid_plural "pairs of chainmail sleeves"
msgstr[0] "사슬 소매"

#. ~ Description for {'str': 'pair of chainmail sleeves', 'str_pl': 'pairs of
#. chainmail sleeves'}
#: data\json\items\armor\arms_armor.json
msgid ""
"Customized chainmail arms.  Each sleeve has straps to connect them with each"
" other.  The lack of fingers makes them less cumbersome and allows them to "
"be used with gloves."
msgstr ""
"개조 사슬갑옷 팔 부분입니다. 각 소매엔 서로 연결하는 끈이 있습니다. 손가락이 없어 덜 거추장스럽고 장갑과 같이 쓸 수 있습니다."

#: data\json\items\armor\arms_armor.json
msgid "pair of elbow pads"
msgid_plural "pairs of elbow pads"
msgstr[0] "팔꿈치 보호대"

#. ~ Description for {'str': 'pair of elbow pads', 'str_pl': 'pairs of elbow
#. pads'}
#: data\json\items\armor\arms_armor.json
msgid "A pair of elbow pads made of stout plastic and cloth."
msgstr "천과 플라스틱으로 만들어진, 팔꿈치 보호용 패드."

#: data\json\items\armor\arms_armor.json
msgid "pair of leather vambraces"
msgid_plural "pairs of leather vambraces"
msgstr[0] "가죽 완갑"

#. ~ Description for {'str': 'pair of leather vambraces', 'str_pl': 'pairs of
#. leather vambraces'}
#: data\json\items\armor\arms_armor.json
msgid "A pair of light leather arm guards, made for archery."
msgstr "양궁용으로 제작된 가벼운 가죽제 팔 보호대 한 쌍."

#: data\json\items\armor\arms_armor.json
msgid "pair of bone vambraces"
msgid_plural "pairs of bone vambraces"
msgstr[0] "뼈 밤브레이스 한 쌍"

#. ~ Description for {'str': 'pair of bone vambraces', 'str_pl': 'pairs of
#. bone vambraces'}
#: data\json\items\armor\arms_armor.json
msgid ""
"Arm protection made from strips of carved bone, laced together as splint "
"armor.  Tough but stiff, and a bit brittle."
msgstr "조각한 뼈 조각으로 만든 팔 보호구로, 부목 갑옷처럼 꿰맸습니다. 튼튼하지만 뻣뻣하고 약간 부서집니다."

#: data\json\items\armor\arms_armor.json
msgid "carbon fiber arm guards"
msgid_plural "carbon fiber arm guardss"
msgstr[0] "탄소섬유 팔 보호대"

#. ~ Description for {'str': 'carbon fiber arm guards'}
#: data\json\items\armor\arms_armor.json
msgid ""
"Custom armguards of layered carbon fiber armor made using a 3D printer.  Its"
" rigid plates are more comparable to a suit of armor than kevlar, but it's "
"very protective and lightweight."
msgstr ""
"3D 프린터로 만든 층상 탄소섬유 갑옷의 개조 팔 보호대입니다. 단단한 판은 케블라보다 갑옷 한 벌에 더 가깝지만 아주 보호적이고 "
"가볍습니다."

#: data\json\items\armor\arms_armor.json
msgid "scaleskin armguards"
msgid_plural "scaleskin armguardss"
msgstr[0] "비늘피 팔 보호대"

#. ~ Description for {'str': 'scaleskin armguards'}
#: data\json\items\armor\arms_armor.json
msgid "Arm guards made from the hardened scales of large reptiles."
msgstr "대형 파충류의 경화 비늘로 만든 팔 보호대입니다."

#: data\json\items\armor\ballistic_armor.json
msgid "Kevlar vest"
msgid_plural "Kevlar vests"
msgstr[0] "케블라 조끼"

#. ~ Description for {'str': 'Kevlar vest'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A lightweight, concealable bullet resistant vest.  It will reliably protect "
"against anything up to 9x19mm, but will struggle against tougher rounds like"
" .45 ACP or .357 Magnum."
msgstr ""
"가볍고 은닉 가능한 방탄 조끼입니다. 9x19mm까지는 확실히 보호하지만 .45 ACP나 .357 매그넘 같은 더 강한 탄엔 버겁습니다."

#: data\json\items\armor\ballistic_armor.json
msgid "dragon skin vest"
msgid_plural "dragon skin vests"
msgstr[0] "드래곤 스킨 조끼"

#. ~ Description for {'str': 'dragon skin vest'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"An improved iteration of a flexible, bullet-resistant vest that originally "
"suffered from reliability issues.  Reliably protects against 5.56x45mm "
"rounds while being less cumbersome than normal hard ballistic armor.  "
"Damaged plates will require it to be disassembled to replace."
msgstr ""
"원래 신뢰성 문제를 겪던 유연 방탄 조끼의 개량 반복판입니다. 일반 경질 탄도 갑옷보다 덜 거추장스러우면서 5.56x45mm 탄을 확실히"
" 보호합니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "lamellar Kevlar vest"
msgid_plural "lamellar Kevlar vests"
msgstr[0] "라멜라 케블라 조끼"

#. ~ Description for {'str': 'lamellar Kevlar vest'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A lamellar Kevlar vest, providing modest protection from pistol rounds up to"
" .40 S&W.  It was designed to slot in multiple small ceramic disks to "
"improve bullet resistance."
msgstr ""
"라멜라 케블라 조끼로, .40 S&W까지 권총탄에서 적당한 보호를 제공합니다. 방탄성을 높이려고 여러 작은 세라믹 디스크를 끼우도록 "
"설계됐습니다."

#: data\json\items\armor\ballistic_armor.json
msgid "MBR vest (empty)"
msgid_plural "MBR vests (empty)"
msgstr[0] "MBR 방탄조끼 (비어있음)"

#. ~ Description for {'str': 'MBR vest (empty)', 'str_pl': 'MBR vests
#. (empty)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A Modular Bullet Resistant Vest.  It has pouches for extra armor inserts, "
"but even without them it will protect against anything up to .40 S&W.  It "
"has four pouches capable of carrying magazines."
msgstr ""
"모듈식 방탄 조끼입니다. 추가 갑옷 삽입용 파우치가 있지만, 없어도 .40 S&W까지 보호합니다. 탄창을 넣을 수 있는 파우치 4개가 "
"있습니다."

#: data\json\items\armor\ballistic_armor.json
msgid "MBR vest (ceramic plates)"
msgid_plural "MBR vests (ceramic plates)"
msgstr[0] "MBR 방탄조끼 (세라믹판)"

#. ~ Description for {'str': 'MBR vest (ceramic plates)', 'str_pl': 'MBR vests
#. (ceramic plates)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A Modular Bullet Resistant Vest.  Ceramic plates have been inserted to "
"improve its protection, protecting against anything up to 7.62x51mm at the "
"expense of moderate encumbrance, and being less durable than other plate "
"options.  It has four pouches capable of carrying magazines.  Damaged plates"
" will require it to be disassembled to replace."
msgstr ""
"모듈식 방탄 조끼입니다. 세라믹 판이 삽입돼 보호가 향상되어 7.62x51mm까지 보호하지만 적당히 거추장스럽고 다른 판 옵션보다 덜 "
"튼튼합니다. 탄창을 넣을 수 있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "MBR vest (hard plates)"
msgid_plural "MBR vests (hard plates)"
msgstr[0] "MBR 방탄조끼 (경화철판)"

#. ~ Description for {'str': 'MBR vest (hard plates)', 'str_pl': 'MBR vests
#. (hard plates)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A Modular Bullet Resistant Vest.  Hardened steel plates have been inserted, "
"reliably negating anything up to 7.62x51mm at the cost of a great deal of "
"weight and loss of flexibility.  It has four pouches capable of carrying "
"magazines.  Damaged plates will require it to be disassembled to replace."
msgstr ""
"모듈식 방탄 조끼입니다. 경화 강철 판이 삽입돼 7.62x51mm까지 확실히 무효화하지만 상당한 무게와 유연성 상실을 대가로 합니다. "
"탄창을 넣을 수 있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "MBR vest (steel plating)"
msgid_plural "MBR vests (steel plating)"
msgstr[0] "MBR 방탄조끼 (강철판)"

#. ~ Description for {'str': 'MBR vest (steel plating)', 'str_pl': 'MBR vests
#. (steel plating)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A Modular Bullet Resistant Vest.  Its armor pouches have steel plates in "
"them, protecting against 5.56x45mm but making the vest much heavier and "
"encumbering.  It has four pouches capable of carrying magazines.  Damaged "
"plates will require it to be disassembled to replace."
msgstr ""
"모듈식 방탄 조끼입니다. 갑옷 파우치에 강철 판이 들어 있어 5.56x45mm를 보호하지만 조끼가 훨씬 무겁고 거추장스럽습니다. 탄창을 "
"넣을 수 있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "MBR vest (superalloy)"
msgid_plural "MBR vests (superalloy)"
msgstr[0] "MBR 방탄조끼 (초합금판)"

#. ~ Description for {'str': 'MBR vest (superalloy)', 'str_pl': 'MBR vests
#. (superalloy)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A Modular Bullet Resistant Vest.  Its armor pouches have superalloy plating "
"in them, protecting against anything up to 5.56x45mm with marginal "
"flexibility loss and additional weight.  It has four pouches capable of "
"carrying magazines.  Damaged plates will require it to be disassembled to "
"replace."
msgstr ""
"모듈식 방탄 조끼입니다. 갑옷 파우치에 초합금 도금판이 들어 있어 미미한 유연성 손실과 추가 무게로 5.56x45mm까지 보호합니다. "
"탄창을 넣을 수 있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "Old Guard IOTV suit (empty)"
msgid_plural "Old Guard IOTV suits (empty)"
msgstr[0] "올드 가드 IOTV 수트 (빈 것)"

#. ~ Description for {'str': 'Old Guard IOTV suit (empty)', 'str_pl': 'Old
#. Guard IOTV suits (empty)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A military ballistic vest rated for .40 S&W, modified with additional "
"protective panels to improve coverage at the expense of encumbrance.  Made "
"and used by military remnants to provide robust protection against the new "
"threats of the cataclysm, it has four pouches capable of carrying magazines."
msgstr ""
".40 S&W 등급의 군용 탄도 조끼로, 거추장스러움을 대가로 방호 범위를 넓히는 추가 보호 패널로 개조됐습니다. 카타클리즘의 새 위협에"
" 대비해 군 잔당이 만들고 쓰는 것으로, 탄창을 넣을 수 있는 파우치 4개가 있습니다."

#: data\json\items\armor\ballistic_armor.json
msgid "Old Guard IOTV suit (ceramic plates)"
msgid_plural "Old Guard IOTV suits (ceramic plates)"
msgstr[0] "올드 가드 IOTV 수트 (세라믹 판)"

#. ~ Description for {'str': 'Old Guard IOTV suit (ceramic plates)', 'str_pl':
#. 'Old Guard IOTV suits (ceramic plates)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A military ballistic vest with additional protective panels, improving "
"coverage at the expense of encumbrance.  Ceramic plates have been inserted "
"to improve its protection, protecting against anything up to 7.62x51mm at "
"the expense of moderate encumbrance, and being less durable than other plate"
" options.  Made and used by military remnants to provide robust protection "
"against the new threats of the cataclysm, it has four pouches capable of "
"carrying magazines.  Damaged plates will require it to be disassembled to "
"replace."
msgstr ""
"추가 보호 패널이 달린 군용 탄도 조끼로, 거추장스러움을 대가로 방호 범위를 넓힙니다. 세라믹 판이 삽입돼 보호가 향상되어 "
"7.62x51mm까지 보호하지만 적당히 거추장스럽고 다른 판 옵션보다 덜 튼튼합니다. 카타클리즘의 새 위협에 대비해 군 잔당이 만들고 "
"쓰는 것으로, 탄창을 넣을 수 있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "Old Guard IOTV suit (hard plates)"
msgid_plural "Old Guard IOTV suits (hard plates)"
msgstr[0] "올드 가드 IOTV 수트 (경질 판)"

#. ~ Description for {'str': 'Old Guard IOTV suit (hard plates)', 'str_pl':
#. 'Old Guard IOTV suits (hard plates)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A military ballistic vest with additional protective panels, improving "
"coverage at the expense of encumbrance.  Hardened steel plates have been "
"inserted, reliably negating anything up to 7.62x51mm at the cost of a great "
"deal of weight and loss of flexibility.  Made and used by military remnants "
"to provide robust protection against the new threats of the cataclysm, it "
"has four pouches capable of carrying magazines.  Damaged plates will require"
" it to be disassembled to replace."
msgstr ""
"추가 보호 패널이 달린 군용 탄도 조끼로, 거추장스러움을 대가로 방호 범위를 넓힙니다. 경화 강철 판이 삽입돼 상당한 무게와 유연성 "
"상실을 대가로 7.62x51mm까지 확실히 무효화합니다. 카타클리즘의 새 위협에 대비해 군 잔당이 만들고 쓰는 것으로, 탄창을 넣을 수 "
"있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "Old Guard IOTV suit (steel plating)"
msgid_plural "Old Guard IOTV suits (steel plating)"
msgstr[0] "올드 가드 IOTV 수트 (강철 도금판)"

#. ~ Description for {'str': 'Old Guard IOTV suit (steel plating)', 'str_pl':
#. 'Old Guard IOTV suits (steel plating)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A military ballistic vest with additional protective panels, improving "
"coverage at the expense of encumbrance.  Its armor pouches have steel plates"
" in them, protecting against 5.56x45mm but making the vest much heavier and "
"encumbering.  Made and used by military remnants to provide robust "
"protection against the new threats of the cataclysm, it has four pouches "
"capable of carrying magazines.  Damaged plates will require it to be "
"disassembled to replace."
msgstr ""
"추가 보호 패널이 달린 군용 탄도 조끼로, 거추장스러움을 대가로 방호 범위를 넓힙니다. 갑옷 파우치에 강철 판이 들어 있어 "
"5.56x45mm를 보호하지만 조끼가 훨씬 무겁고 거추장스럽습니다. 카타클리즘의 새 위협에 대비해 군 잔당이 만들고 쓰는 것으로, 탄창을"
" 넣을 수 있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "Old Guard IOTV suit (superalloy)"
msgid_plural "Old Guard IOTV suits (superalloy)"
msgstr[0] "올드 가드 IOTV 수트 (초합금)"

#. ~ Description for {'str': 'Old Guard IOTV suit (superalloy)', 'str_pl':
#. 'Old Guard IOTV suits (superalloy)'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A military ballistic vest with additional protective panels, improving "
"coverage at the expense of encumbrance.  Its armor pouches have superalloy "
"plating in them, protecting against anything up to 5.56x45mm with marginal "
"flexibility loss and additional weight.  Made and used by military remnants "
"to provide robust protection against the new threats of the cataclysm, it "
"has four pouches capable of carrying magazines.  Damaged plates will require"
" it to be disassembled to replace."
msgstr ""
"추가 보호 패널이 달린 군용 탄도 조끼로, 거추장스러움을 대가로 방호 범위를 넓힙니다. 갑옷 파우치에 초합금 도금판이 들어 있어 미미한 "
"유연성 손실과 추가 무게로 5.56x45mm까지 보호합니다. 카타클리즘의 새 위협에 대비해 군 잔당이 만들고 쓰는 것으로, 탄창을 넣을 "
"수 있는 파우치 4개가 있습니다. 손상된 판은 교체하려면 분해해야 합니다."

#: data\json\items\armor\ballistic_armor.json
msgid "makeshift ballistic vest"
msgid_plural "makeshift ballistic vests"
msgstr[0] "자작 탄도 조끼"

#. ~ Description for {'str': 'makeshift ballistic vest'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A flotation vest, cut open and tightly packed with sand or earth as "
"improvised ballistic protection.  Incredibly cumbersome, it won't do much "
"but it'll keep your organs inside your torso against anything up to .40 S&W."
msgstr ""
"모래나 흙을 꽉 채워 즉석 탄도 보호로 만든, 잘라낸 부양 조끼입니다. 믿을 수 없을 만큼 거추장스럽지만 .40 S&W까지는 장기를 몸통"
" 안에 지켜줍니다."

#: data\json\items\armor\ballistic_armor.json
msgid "hard steel trench armor"
msgid_plural "hard steel trench armors"
msgstr[0] "경화 강철 참호 갑옷"

#. ~ Description for {'str': 'hard steel trench armor'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"Cumbersome body armor forged from hardened steel plating.  Very heavy, but "
"able to take considerable punishment, laughing off anything up to .44 "
"Magnum."
msgstr "경화 강철판으로 단련된 거추장스러운 몸통 갑옷입니다. 아주 무겁지만 상당한 타격을 견디고 .44 매그넘까지는 우습게 봅니다."

#: data\json\items\armor\ballistic_armor.json
msgid "hard steel trench helmet"
msgid_plural "hard steel trench helmets"
msgstr[0] "경화 강철 참호 헬멧"

#. ~ Description for {'str': 'hard steel trench helmet'}
#: data\json\items\armor\ballistic_armor.json
msgid ""
"A cumbersome full-face helm forged from hardened steel plating.  Very heavy,"
" but able to take considerable punishment, laughing off anything up to .44 "
"Magnum."
msgstr "경화 강철판으로 단련된 거추장스러운 전면 투구입니다. 아주 무겁지만 상당한 타격을 견디고 .44 매그넘까지는 우습게 봅니다."

#: data\json\items\armor\bandolier.json
#: data\mods\exotic_ammo\bandoliers-pouches.json
msgid "pistol bandolier"
msgid_plural "pistol bandoliers"
msgstr[0] "권총용 탄약대"

#. ~ Description for {'str': 'pistol bandolier'}
#: data\json\items\armor\bandolier.json
msgid ""
"An embroidered leather bandolier for keeping pistol cartridges close to "
"hand.  If this doesn't make you feel like a cowboy, nothing will."
msgstr "권총 탄약을 가까이 두는 수놓은 가죽 밴돌리어입니다. 이걸 차도 카우보이 기분이 안 나면 아무것도 안 날 겁니다."

#: data\json\items\armor\bandolier.json
#: data\mods\exotic_ammo\bandoliers-pouches.json
msgid "rifle bandolier"
msgid_plural "rifle bandoliers"
msgstr[0] "소총용 탄약대"

#. ~ Description for {'str': 'rifle bandolier'}
#: data\json\items\armor\bandolier.json
msgid "A leather bandolier for keeping rifle cartridges close to hand."
msgstr "소총탄을 빠르게 꺼낼 수 있게 만들어진 가죽 탄약대."

#: data\json\items\armor\bandolier.json
msgid "waist shotgun bandolier"
msgid_plural "waist shotgun bandoliers"
msgstr[0] "허리 산탄총 밴돌리어"

#. ~ Description for {'str': 'waist shotgun bandolier'}
#: data\json\items\armor\bandolier.json
msgid ""
"A leather bandolier worn around the waist for keeping shotgun shells close "
"to hand."
msgstr "산탄총 셸을 가까이 두게 허리에 차는 가죽 밴돌리어입니다."

#: data\json\items\armor\bandolier.json
msgid "torso shotgun bandolier"
msgid_plural "torso shotgun bandoliers"
msgstr[0] "몸통 산탄총 밴돌리어"

#. ~ Description for {'str': 'torso shotgun bandolier'}
#: data\json\items\armor\bandolier.json
msgid ""
"A leather bandolier strapped around the torso for keeping shotgun shells "
"close to hand."
msgstr "산탄총 셸을 가까이 두게 몸통에 묶는 가죽 밴돌리어입니다."

#: data\json\items\armor\bandolier.json
msgid "paper cartridge pouch"
msgid_plural "paper cartridge pouches"
msgstr[0] "종이 화약포 주머니"

#. ~ Description for {'str': 'paper cartridge pouch', 'str_pl': 'paper
#. cartridge pouches'}
#: data\json\items\armor\bandolier.json
msgid ""
"A covered leather pouch, worn at the waist to store and protect prepared "
"blackpowder cartridges."
msgstr "가죽 주머니. 허리에 착용하며, 미리 준비한 흑색 화약 포를 안전하게 넣어 둘 수 있습니다."

#: data\json\items\armor\bandolier.json
#: data\mods\exotic_ammo\bandoliers-pouches.json
msgid "wrist bandolier"
msgid_plural "wrist bandoliers"
msgstr[0] "손목 탄약대"

#. ~ Description for {'str': 'wrist bandolier'}
#: data\json\items\armor\bandolier.json
msgid ""
"A small fabric bandolier for rifle cartridges designed to be worn around the"
" wrist."
msgstr "소총탄을 빠르게 꺼낼 수 있게 만든 직물 재질의 작은 탄약대. 손목에 착용할 수 있습니다."

#: data\json\items\armor\bandolier.json
msgid "grenade ammo pouch"
msgid_plural "grenade ammo pouches"
msgstr[0] "수류탄 탄약 파우치"

#. ~ Description for {'str': 'grenade ammo pouch', 'str_pl': 'grenade ammo
#. pouches'}
#: data\json\items\armor\bandolier.json
msgid ""
"A small pouch for storing cartridge grenades with straps for attaching it to"
" your belt or other webbing."
msgstr "유탄을 보관할 수 있는 작은 주머니. 스트랩이 있어서 벨트나 다른 띠에 부착할 수 있습니다."

#: data\json\items\armor\bandolier.json
msgid "stone pouch"
msgid_plural "stone pouches"
msgstr[0] "돌 파우치"

#. ~ Description for {'str': 'stone pouch', 'str_pl': 'stone pouches'}
#: data\json\items\armor\bandolier.json
msgid ""
"A medium-sized pouch for storing rocks, with straps for attaching it to your"
" belt or other webbing."
msgstr "벨트나 웨빙에 다는 끈이 달린, 돌을 저장하는 중간 크기 파우치입니다."

#: data\json\items\armor\bandolier.json
msgid "hand grenade pouch"
msgid_plural "hand grenade pouches"
msgstr[0] "수류탄 파우치"

#. ~ Use action holster_prompt for {'str': 'hand grenade pouch', 'str_pl':
#. 'hand grenade pouches'}.
#: data\json\items\armor\bandolier.json
msgid "Stash grenades"
msgstr "수류탄 집어넣기"

#. ~ Description for {'str': 'hand grenade pouch', 'str_pl': 'hand grenade
#. pouches'}
#: data\json\items\armor\bandolier.json
msgid "A pouch for holding up to four full-sized grenades of various types."
msgstr "다양한 종류의 유탄을 4개까지 담을 수 있는 주머니."

#: data\json\items\armor\bandolier.json
msgid "grenade ammo bandolier"
msgid_plural "grenade ammo bandoliers"
msgstr[0] "유탄 밴돌리어"

#. ~ Description for {'str': 'grenade ammo bandolier'}
#: data\json\items\armor\bandolier.json
msgid "A leather bandolier for keeping cartridge grenades close to hand."
msgstr "유탄을 가까이 두는 가죽 밴돌리어입니다."

#: data\json\items\armor\bandolier.json
msgid "throwing knife bandolier"
msgid_plural "throwing knife bandoliers"
msgstr[0] "투척용 나이프 밴돌리어"

