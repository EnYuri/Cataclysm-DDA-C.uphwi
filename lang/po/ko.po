msgstr "탱크 장전수"

#: data\json\professions.json
msgctxt "profession_female"
msgid "Tank Loader"
msgstr "탱크 장전수"

#. ~ Profession (male Tank Loader) description
#: data\json\professions.json
msgctxt "prof_desc_male"
msgid ""
"Your job was to help the main gunner with loading, now you'll have to do all"
" the work yourself."
msgstr "주포수의 장전을 돕는 게 일이었지만, 이제 모든 일을 혼자 해야 합니다."

#. ~ Profession (female Tank Loader) description
#: data\json\professions.json
