#: data\mods\DinoMod\monsters\dinosaur.json
msgid "a dinosaur"
msgstr "공룡"

#: data\mods\DinoMod\monsters\dinosaur.json
msgid "a heavy thud."
msgstr "쿵 하는 무거운 소리."

#: data\mods\DinoMod\monsters\dinosaur.json
msgid "the crash of weight on the ground."
msgstr "땅에 무게가 부딪히는 소리."

#: data\mods\DinoMod\monsters\dinosaur.json
