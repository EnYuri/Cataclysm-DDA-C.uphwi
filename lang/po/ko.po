#: data\mods\Nechronica\nec_professions.json
msgctxt "prof_desc_male"
msgid ""
"포기했기에 얻은 힘입니다. 하지만, 아직 모든 걸 포기한 건 아닙니다. 더이상 잃을 것이 얻는 몸입니다. 하지만, 아직 잃지 않은 것도 "
"있습니다. 상처 투성이의 몸으로도 계속해서 발버둥을 칩니다."
msgstr ""
