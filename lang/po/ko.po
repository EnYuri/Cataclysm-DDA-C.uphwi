msgid "<npcname> chops %s"
msgstr "<npcname>(이)가 %s을(를) 찍어버렸습니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "85% moves, 66% Bash, 76% Cut, 86% Stab, Down two turns"
msgstr "행동력 85%, 타격 66%, 베기 76%, 찌르기 86%, 2턴 다운"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "Your hooking attack makes %s stagger and fall"
msgstr "당신의 갈고리 공격이 %s을(를) 비틀거리게 하고 넘어뜨립니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "INERTIAL SWING"
msgstr "관성 휘두르기"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid ""
"50% moves, 60% damage, wide arc, damage increased by 10% of STR, min 4 melee"
msgstr "행동력 50%, 피해 60%, 넓은 원호, 근력의 10%만큼 피해 증가, 최소 근접 4"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "Your momentum causes your weapon to glance off of %s"
msgstr "당신의 관성이 무기를 %s에게서 미끄러지게 합니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "CHOP"
msgstr "내려찍기"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid ""
"Crit only, 118% move cost, 105% Bash and Stab, 125% Cut, damage increased by"
" 15-30% of PER, min 2 melee"
msgstr "치명타 전용, 행동 비용 118%, 타격·찌르기 105%, 베기 125%, 지각의 15-30%만큼 피해 증가, 최소 근접 2"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "You draw back your arm and release a well placed chop %s"
msgstr "팔을 뒤로 뻗어 %s에게 정확히 내려찍기를 합니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "SMASH"
msgstr "분쇄"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid ""
"Crit only, 110% move cost, 120% Bash, 105% Stab, 110% Cut, damage increased "
"by 15-25% of STR, min 2 melee"
msgstr ""
"치명타 전용, 행동 비용 110%, 타격 120%, 찌르기 105%, 베기 110%, 근력의 15-25%만큼 피해 증가, 최소 근접 2"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "You grip your weapon with two hands and slam it into %s"
msgstr "무기를 두 손으로 쥐고 %s에게 내리꽂습니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "<npcname> smashes their weapon onto %s"
msgstr "<npcname>(이)가 무기를 %s에게 내리꽂았습니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "UNDERHAND"
msgstr "하단 공격"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "Crit only, 120% moves, 125% damage, Stun for 1 turn, min melee 1"
msgstr "치명타 전용, 행동력 120%, 피해 125%, 1턴 기절, 최소 근접 1"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "You lunge forward with all your weight and swing upwards at %s"
msgstr "온몸의 무게를 실어 앞으로 돌진하며 %s을(를) 위로 후려칩니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "<npcname> swings upwards with all their weight at %s"
msgstr "<npcname>(이)가 온몸의 무게를 실어 %s을(를) 위로 후려쳤습니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "SHOVE"
msgstr "밀치기"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "65% moves, dramatically reduced damage, knockback 2 tiles, stun 1 turn"
msgstr "행동력 65%, 피해 대폭 감소, 넉백 2타일, 1턴 기절"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "You quickly shove %s out of the way"
msgstr "%s을(를) 재빨리 밀쳐냅니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "<npcname> quickly shoves %s"
msgstr "<npcname>(이)가 %s을(를) 재빨리 밀쳐냈습니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "SHIELDED SHOVE"
msgstr "방패 밀치기"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid ""
"75% moves, no cut damage, 110% Bash and Stab damage, knockback 2 tiles, min "
"melee 1"
msgstr "행동력 75%, 베기 피해 없음, 타격·찌르기 피해 110%, 넉백 2타일, 최소 근접 1"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "You quickly shove %s out of the way with your weapon"
msgstr "무기로 %s을(를) 재빨리 밀쳐냅니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "TEAR"
msgstr "찢기"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
msgid "Crit only, 110% Cut, 115% Stab, min melee 2"
msgstr "치명타 전용, 베기 110%, 찌르기 115%, 최소 근접 2"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "You stab into %s and rake your blade out"
msgstr "%s을(를) 찌른 뒤 칼날을 긁어내며 뺍니다"

#: data\mods\CRT_EXPANSION\martial\generaltechn.json
#, c-format
msgid "<npcname> tears into %s flesh"
msgstr "<npcname>(이)가 %s의 살을 찢었습니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid "THRUST"
msgstr "강찌르기"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid ""
"110% Stab damage, damage increased by 10% of STR and 20% of PER, min 1 melee"
msgstr "찌르기 피해 110%, 근력의 10%와 지각의 20%만큼 피해 증가, 최소 근접 1"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "You step forward and stab at %s"
msgstr "앞으로 나서며 %s을(를) 찌릅니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "<npcname> stabs into %s's flesh"
msgstr "<npcname>(이)가 %s의 살을 찔렀습니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid "LUNGE"
msgstr "돌격 찌르기"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid ""
"Crit only, 115% Stab damage, Crit only, damage increased by 20% of STR and "
"PER, min 2 melee"
msgstr "치명타 전용, 찌르기 피해 115%, 근력·지각의 20%만큼 피해 증가, 최소 근접 2"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "You explosively jab at %s"
msgstr "%s을(를) 향해 폭발적으로 찌릅니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "<npcname> violently jabs at %s"
msgstr "<npcname>(이)가 %s을(를) 향해 격렬하게 찔렀습니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid "PROD"
msgstr "건드리기"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid ""
"66% movecost, 70% Stab damage, damage increased by 15% of STR and 25% of "
"PER, min 3 melee"
msgstr "행동 비용 66%, 찌르기 피해 70%, 근력의 15%와 지각의 25%만큼 피해 증가, 최소 근접 3"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "You prod at %s defensively"
msgstr "방어적으로 %s을(를) 쿡 찌릅니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "<npcname> prods at %s"
msgstr "<npcname>(이)가 %s을(를) 쿡 찔렀습니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid "PROBE"
msgstr "헤집기"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
msgid ""
"80% movecost, 75% Stab damage, damage increased by 25% of STR and 30% of "
"PER, arpen increased by 12% of per, min 3 melee"
msgstr ""
"행동 비용 80%, 찌르기 피해 75%, 근력의 25%와 지각의 30%만큼 피해 증가, 지각의 12%만큼 관통력 증가, 최소 근접 3"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "You probe %s's openings"
msgstr "%s의 빈틈을 헤집습니다"

#: data\mods\CRT_EXPANSION\martial\stabtechn.json
#, c-format
msgid "<npcname> probe %s's openings"
msgstr "<npcname>(이)가 %s의 빈틈을 헤집었습니다"

#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid "Slasher Necromorph"
msgid_plural "Slasher Necromorphs"
msgstr[0] "슬래셔 네크로모프"

#. ~ Description for Slasher Necromorph
#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid ""
"A horrifically twisted human body.  Two massive, bladed appendages have "
"burst through its shoulders where they are poised above its head as it "
"stalks about with terrifying purpose."
msgstr ""
"끔찍하게 뒤틀린 인간의 몸입니다. 거대한 칼날 부속지 두 개가 어깨를 뚫고 솟아 머리 위로 솟아 있고, 섬뜩한 목적을 가지고 배회합니다."

#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid "Weak Slasher Necromorph"
msgid_plural "Weak Slasher Necromorphs"
msgstr[0] "약한 슬래셔 네크로모프"

#. ~ Description for Weak Slasher Necromorph
#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid ""
"A horrifically mutilated human body.  Two scrawny blades have freshly "
"bursted through its hand to deal with prey and the haunting visage of a "
"jawless maw and a gaping wound in its forehead sends chills down your spine."
"  The awkward steps it takes slows it down greatly."
msgstr ""
"끔찍하게 절단된 인간의 몸입니다. 마른 칼날 두 개가 손에서 막 터져 나와 먹잇감을 처리하고, 턱 없는 입과 이마의 벌어진 상처라는 "
"섬뜩한 모습이 등골을 오싹하게 합니다. 어색한 걸음 때문에 속도가 크게 느립니다."

#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid "Waster Necromorph"
msgid_plural "Waster Necromorphs"
msgstr[0] "웨이스터 네크로모프"

#. ~ Description for Waster Necromorph
#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid ""
"Clad in heavy assault gear, an eerie light green glows beneath its helmet "
"from sunken eye sockets and a gaping mouth.  Strange blade like points have "
"burst out of it's forearms making it a formidable force to be reckoned with."
msgstr ""
"중형 강습 장비를 입고 있으며, 헬멧 아래로 움푹 들어간 눈구멍과 벌어진 입에서 기묘한 연두빛이 빛납니다. 이상한 칼날 같은 돌기가 "
"전완에서 터져 나와 상대하기에 무시무시한 존재입니다."

#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid "Leaper Necromorph"
msgid_plural "Leaper Necromorphs"
msgstr[0] "리퍼 네크로모프"

#. ~ Description for Leaper Necromorph
#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid ""
"This once-human body is barely recognizable, scrambling about on its abdomen"
" as it leaps forward with immense arm strength.  With elongated fangs that "
"can easily mutilate your flesh, the grotesque face roars incessantly.  The "
"lower body has fused together into one giant tail with a barbed spike."
msgstr ""
"옛 인간의 몸이 거의 알아볼 수 없게 됐고, 배로 기어다니며 엄청난 팔 힘으로 앞으로 도약합니다. 살을 쉽게 훼손할 수 있는 길어진 "
"송곳니로 괴기한 얼굴이 쉬지 않고 포효합니다. 하반신은 미늘가시가 달린 거대한 꼬리 하나로 융합됐습니다."

#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid "Twitcher Necromorph"
msgid_plural "Twitcher Necromorphs"
msgstr[0] "트위처 네크로모프"

#. ~ Description for Twitcher Necromorph
#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid ""
"With narrow blades coming out of its hands, this corpse spasmically dashes "
"to-and-fro with surprising speed.  It carries itself quite steadily when "
"idle, further observation shows that the person before this husk was a "
"C.R.I.T S-I G.E.A.R operator."
msgstr ""
"손에서 좁은 칼날이 나온 이 시체는 놀라운 속도로 경련하듯 오락가락 질주합니다. 가만히 있을 땐 꽤 안정적으로 행동하고, 자세히 보면 이"
" 허물의 전 주인은 C.R.I.T S-I G.E.A.R 대원이었습니다."

#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid "Pack Necromorph"
msgid_plural "Pack Necromorphs"
msgstr[0] "팩 네크로모프"

#. ~ Description for Pack Necromorph
#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid ""
"A shrieking mutated child zombie.  The face is is mainly blank with eyes "
"swollen shut and a torn-open mouth with flaps of flesh hanging to the side."
"  A pair of seemingly purposeless appendages sprout from its shoulders "
"before ending in its arms.  Its small hands end in sharp claws."
msgstr ""
"비명을 지르는 돌연변이 아이 좀비입니다. 얼굴은 거의 무표정에 눈은 붓고 닫혔으며, 찢어진 입 옆에 살 조각이 매달려 있습니다. 목적 "
"없어 보이는 부속지 한 쌍이 어깨에서 돋아 팔로 이어집니다. 작은 손 끝은 날카로운 발톱입니다."

#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid "Puker Necromorph"
msgid_plural "Puker Necromorphs"
msgstr[0] "퓨커 네크로모프"

#. ~ Description for Puker Necromorph
#: data\mods\CRT_EXPANSION\monsters\crt_monster.json
msgid ""
"A rather mutilated corpse covered in gaping sores.  Hanging arms with hands "
"that have long corroded away reveal jagged edges that could easily pierce "
"into your flesh.  A sticky, frothing yellow sludge flows from its exposed "
"internal organs to its unhinged jaw where it drips, hissing as it eats "
"through material."
msgstr ""
"벌어진 상처투성이의 상당히 훼손된 시체입니다. 오래전에 부식되어 사라진 손의 축 늘어진 팔이 살을 쉽게 꿰뚫을 수 있는 뾰족한 가장자리를"
" 드러냅니다. 끈적하고 거품 이는 노란 슬러지가 노출된 내부 장기에서 어긋난 턱으로 흘러, 재료를 녹이며 치직 소리를 냅니다."

#: data\mods\CRT_EXPANSION\monsters\monster.json
msgid "Animate Arm"
msgid_plural "Animate Arms"
msgstr[0] "움직이는 팔"

#. ~ Description for Animate Arm
#: data\mods\CRT_EXPANSION\monsters\monster.json
msgid ""
"A dismembered arm that slowly crawls forward.  Occasionally, tentacles "
"sprout out from the wound and lash about wildly."
msgstr "천천히 기어가는 절단된 팔입니다. 가끔 상처에서 촉수가 튀어나와 미친 듯이 휘두릅니다."

#: data\mods\CRT_EXPANSION\monsters\monster.json
msgid "Dullahan"
msgid_plural "Dullahans"
msgstr[0] "듀라한"

#. ~ Description for Dullahan
#: data\mods\CRT_EXPANSION\monsters\monster.json
msgid ""
"A headless humanoid that slowly sways.  Ornate and functional armor adorn "
"this dreadful corpse which carries itself with an unerringly terrible "
"steadiness.  A long tentacle has sprouted out of its right arm which "
"occasionally flails about wildly."
msgstr ""
"천천히 흔들리는 머리 없는 인간형입니다. 화려하고 실용적인 갑옷이 이 끔찍한 시체를 장식하고, 정확하고 끔찍한 안정감으로 움직입니다. "
"오른팔에서 긴 촉수가 돋아나 가끔 미친 듯이 휘두릅니다."

#: data\mods\CRT_EXPANSION\mutations\crt_mutatinoc.json
msgid "Shadow Meld"
msgstr "그림자 융합"

#. ~ Description for Shadow Meld
#: data\mods\CRT_EXPANSION\mutations\crt_mutatinoc.json
msgid ""
"The light around you bends strangely, making it harder for enemies to notice"
" you."
msgstr "주변의 빛이 이상하게 휘어져 적이 당신을 알아채기 어려워집니다."

#: data\mods\CRT_EXPANSION\mutations\crt_mutatinoc.json
msgid "Moon-lit Grace"
msgstr "달빛의 우아함"

#. ~ Description for Moon-lit Grace
#: data\mods\CRT_EXPANSION\mutations\crt_mutatinoc.json
msgid ""
"Aside from your appearances, your movements are incredibly graceful and "
"allow you to seemingly glide through every task."
msgstr "외모는 차치하고, 동작이 믿을 수 없이 우아해 모든 일을 미끄러지듯 처리합니다."

#: data\mods\CRT_EXPANSION\mutations\crt_mutatinoc.json
msgid "Red Iris"
msgstr "붉은 홍채"

#. ~ Description for Red Iris
#: data\mods\CRT_EXPANSION\mutations\crt_mutatinoc.json
msgid ""
"You eyes are a pleasant shade of hypnotic scarlet.  People feel mildly "
"persuaded by you."
msgstr "눈이 최면적인 주홍색의 보기 좋은 색조입니다. 사람들이 당신에게 살짝 설득당합니다."

#: data\mods\CRT_EXPANSION\mutations\crt_vamp_mutations.json
msgid "Night Walker"
msgstr "나이트 워커"

#. ~ Description for Night Walker
#: data\mods\CRT_EXPANSION\mutations\crt_vamp_mutations.json
msgid ""
"Emerge from the grave of the old world, and become the night once again."
msgstr "구세계의 무덤에서 나와 다시 밤이 되십시오."

#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid "Forest Guardian"
msgstr "숲의 수호자"

#. ~ Description for Forest Guardian
#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid ""
"The forests have longed for your help, and this last cry shook the world."
msgstr "숲이 오랫동안 당신의 도움을 갈망했고, 이 마지막 외침이 세상을 흔들었습니다."

#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid "Nature's Boon"
msgstr "자연의 은혜"

#. ~ Description for Nature's Boon
#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid ""
"Your very prescence is masked by nature itself.  You are slightly harder to "
"detect."
msgstr "당신의 존재 자체가 자연에 의해 가려집니다. 탐지하기가 약간 어려워집니다."

#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid "Slashers"
msgstr "난도자"

#. ~ Description for Slashers
#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid ""
"Your torso has an extra set of appendages that have burst out of your back, "
"they are tipped with massive bone blades at the end, and look like they can "
"do some serious damage with the thick acid that they secrete."
msgstr ""
"몸통에 등을 뚫고 나온 추가 부속지가 있고, 끝엔 거대한 뼈 칼날이 달렸으며 분비하는 진한 산으로 심각한 피해를 줄 수 있어 보입니다."

#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid "You tear into %s with your blades"
msgstr "칼날로 %s을(를) 찢어발깁니다"

#: data\mods\CRT_EXPANSION\mutations\crt_wendigo_mutations.json
msgid "%1$s tears into %2$s with their blades"
msgstr "%1$s이(가) 칼날로 %2$s을(를) 찢어발겼습니다"

#. ~ Mutation class name
#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "Vampire"
msgstr "뱀파이어"

#. ~ Mutation class: Vampire mutagen_message
#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid ""
"Nearby shadows seem to bend towards you for a moment and then reality warps "
"back into place."
msgstr "주변 그림자가 잠시 당신을 향해 휘어지다가 현실이 제자리로 되돌아옵니다."

#. ~ Mutation class: Vampire iv_message
#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid ""
"You twitch and pant randomly as your desire to slake your inhuman thirst "
"becomes overwhelming."
msgstr "인간 아닌 갈증을 채우고 싶은 욕망이 압도적으로 커지면서 무작위로 움찔거리고 헐떡입니다."

#. ~ Mutation class: Vampire Male memorial messsage
#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgctxt "memorial_male"
msgid "Dispersed into the shadows."
msgstr "그림자 속으로 흩어졌다."

#. ~ Mutation class: Vampire Female memorial messsage
#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgctxt "memorial_female"
msgid "Dispersed into the shadows."
msgstr "그림자 속으로 흩어졌다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "vampire mutagen"
msgid_plural "vampire mutagens"
msgstr[0] "뱀파이어 뮤타젠"

#. ~ Description for vampire mutagen
#. ~ Description for wendigo mutagen
#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "Mutagen cocktail simply labeled 'C.R.I.T R&D.'"
msgstr "단순히 \"C.R.I.T R&D\"라고 적힌 돌연변이 칵테일입니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "vampire serum"
msgid_plural "vampire serums"
msgstr[0] "뱀파이어 혈청"

#. ~ Description for vampire serum
#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid ""
"A super-concentrated pitch-black substance with silvery flecks that reminds "
"you of a starry-night sky.  You need a syringe to inject it… if you really "
"want to?"
msgstr ""
"초고농축 칠흑색 물질로 은빛 반점이 별이 빛나는 밤하늘을 떠올리게 합니다. 주사하려면 주사기가 필요합니다… 정말 하고 싶다면요?"

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "You have a strange dream about the shadows."
msgstr "그림자에 대한 이상한 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "Your dreams give you a peculiar feeling of sinking into the dark."
msgstr "꿈이 어둠 속으로 가라앉는 듯한 특이한 느낌을 줍니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "You have a vivid dream of talking a midnight stroll."
msgstr "한밤중에 산책하는 생생한 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "You dream of drinking copious amounts of warm water."
msgstr "따뜻한 물을 아주 많이 마시는 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid ""
"You have a dream of being chased by dogs as something warm drips from your "
"mouth."
msgstr "입가에서 따뜻한 무언가가 흘러내리며 개에게 쫓기는 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "Snippets of stalking something in the star-lit night shakes you awake."
msgstr "별빛 밤 무언가를 스토킹하는 장면의 파편이 당신을 깨웁니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid "You dream of sinking your fangs into more and more enemies."
msgstr "점점 더 많은 적에게 송곳니를 박는 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\vamp_mut_cat.json
msgid ""
"You have a lucid dream where streams of blood are slowly pooling around your"
" feet."
msgstr "피의 물줄기가 발밑으로 천천히 고여드는 자각몽을 꿉니다."

#. ~ Mutation class name
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "Wendigo"
msgstr "웬디고"

#. ~ Mutation class: Wendigo mutagen_message
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid ""
"Nearby plants seem to bend towards you for a moment and then they shift back"
" into place."
msgstr "주변 식물이 잠시 당신을 향해 휘어지다가 제자리로 되돌아옵니다."

#. ~ Mutation class: Wendigo iv_message
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid ""
"A serene feeling of terror grips you as become acutely aware of the flora "
"and fauna beckoning towards you."
msgstr "당신을 손짓하는 동식물을 절박하게 자각하면서 고요한 공포가 당신을 움켜쥡니다."

#. ~ Mutation class: Wendigo Male memorial messsage
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgctxt "memorial_male"
msgid "Reclaimed by nature."
msgstr "자연에 회수되었다."

#. ~ Mutation class: Wendigo Female memorial messsage
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgctxt "memorial_female"
msgid "Reclaimed by nature."
msgstr "자연에 회수되었다."

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "wendigo mutagen"
msgid_plural "wendigo mutagens"
msgstr[0] "웬디고 뮤타젠"

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "wendigo serum"
msgid_plural "wendigo serums"
msgstr[0] "웬디고 혈청"

#. ~ Description for wendigo serum
#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid ""
"A super-concentrated peat-brown substance with glittering green flecks that "
"reminds you of a a tree.  You need a syringe to inject it… if you really "
"want to?"
msgstr "초고농축 토탄갈색 물질로 반짝이는 초록 반점이 나무를 떠올리게 합니다. 주사하려면 주사기가 필요합니다… 정말 하고 싶다면요?"

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "You have a strange dream about the mountain forests."
msgstr "산속 숲에 대한 이상한 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "Your dreams give you a peculiar feeling of sinking into the treelines."
msgstr "꿈이 수목선 안으로 가라앉는 듯한 특이한 느낌을 줍니다."

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "You have a vivid dream of strolling through the woods."
msgstr "숲을 산책하는 생생한 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "You have a dream of chasing something as a raw hunger sears your mind."
msgstr "날것의 허기가 정신을 태우며 무언가를 쫓는 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "Recollections of stalking a human shakes you awake."
msgstr "인간을 스토킹한 회상이 당신을 깨웁니다."

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "You dream of tearing into more and more enemies."
msgstr "점점 더 많은 적을 찢어발기는 꿈을 꿉니다."

#: data\mods\CRT_EXPANSION\mutations\wendigo_mut_cat.json
msgid "You have a lucid dream where nature carefully welcomes your body."
msgstr "자연이 당신의 몸을 조심스레 환영하는 자각몽을 꿉니다."

#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "profession_male"
msgid "C.R.I.T. Bionic Enforcer"
msgstr "C.R.I.T. 바이오닉 집행관"

#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "profession_female"
msgid "C.R.I.T. Bionic Enforcer"
msgstr "C.R.I.T. 바이오닉 집행관"

#. ~ Profession (male C.R.I.T. Bionic Enforcer) description
#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "prof_desc_male"
msgid ""
"STR 10 recommended.  You were a granted the authority of a U.S Marshal. "
"While hired as a guard, with some others joking that you were nothing more "
"than a mall cop with a fancy badge, you eventually got promoted. From merely"
" a guard to a highly augmented melee fighter. You were sent in to retake a "
"city, but with most of the others failing, mission parameters have expanded "
"quite a bit."
msgstr ""
"근력 10 권장. 미합중국 치안관의 권한을 부여받았습니다. 경비원으로 고용됐을 때 일부는 멋진 배지만 단 쇼핑몰 경비라고 농담했지만, "
"결국 승진했습니다. 단순한 경비원에서 고도로 개조된 근접 전사로. 도시를 탈환하러 투입됐지만 대부분이 실패하면서 임무 범위가 상당히 "
"넓어졌습니다."

#. ~ Profession (female C.R.I.T. Bionic Enforcer) description
#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "prof_desc_female"
msgid ""
"STR 10 recommended.  You were a granted the authority of a U.S Marshal. "
"While hired as a guard, with some others joking that you were nothing more "
"than a mall cop with a fancy badge, you eventually got promoted. From merely"
" a guard to a highly augmented melee fighter. You were sent in to retake a "
"city, but with most of the others failing, mission parameters have expanded "
"quite a bit."
msgstr ""
"근력 10 권장. 미합중국 치안관의 권한을 부여받았습니다. 경비원으로 고용됐을 때 일부는 멋진 배지만 단 쇼핑몰 경비라고 농담했지만, "
"결국 승진했습니다. 단순한 경비원에서 고도로 개조된 근접 전사로. 도시를 탈환하러 투입됐지만 대부분이 실패하면서 임무 범위가 상당히 "
"넓어졌습니다."

#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "profession_male"
msgid "C.R.I.T. Enforcer"
msgstr "C.R.I.T. 집행관"

#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "profession_female"
msgid "C.R.I.T. Enforcer"
msgstr "C.R.I.T. 집행관"

#. ~ Profession (male C.R.I.T. Enforcer) description
#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "prof_desc_male"
msgid ""
"STR 10 recommended.  You were a granted the authority of a U.S Marshal.  As "
"a guard, others joked that you were nothing more than a mall cop with a "
"fancy badge.  Knowingly, you laughed it off as the you donned your equipment"
" and deployed.  While you mainly spent time at base, you honed your skills "
"and received special implants to do your job easier at the low low cost of "
"serving as a \"guard\" forever.  Time to do your job, mission parameters "
"look like they've expanded quite a bit though."
msgstr ""
"근력 10 권장. 미합중국 치안관의 권한을 부여받았습니다. 경비원으로서 다른 이들은 멋진 배지만 단 쇼핑몰 경비라고 농담했습니다. "
"알면서도 장비를 차려입고 배치되며 웃어넘겼습니다. 주로 기지에서 시간을 보내며 기술을 갈고 닦았고, 영원히 \"경비\"로 복무한다는 "
"저렴한 대가로 일을 쉽게 하는 특별 임플란트를 받았습니다. 이제 일할 시간입니다. 임무 범위가 꽤 넓어진 듯하지만요."

#. ~ Profession (female C.R.I.T. Enforcer) description
#: data\mods\CRT_EXPANSION\scenarios\crt_enforcer.json
msgctxt "prof_desc_female"
msgid ""
"STR 10 recommended.  You were a granted the authority of a U.S Marshal.  As "
"a guard, others joked that you were nothing more than a mall cop with a "
"fancy badge.  Knowingly, you laughed it off as the you donned your equipment"
" and deployed.  While you mainly spent time at base, you honed your skills "
"and received special implants to do your job easier at the low low cost of "
"serving as a \"guard\" forever.  Time to do your job, mission parameters "
"look like they've expanded quite a bit though."
msgstr ""
"근력 10 권장. 미합중국 치안관의 권한을 부여받았습니다. 경비원으로서 다른 이들은 멋진 배지만 단 쇼핑몰 경비라고 농담했습니다. "
