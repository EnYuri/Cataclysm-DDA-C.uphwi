msgstr "수동 래서레이터"

#: data\mods\blazemod\blaze_weapons_parts.json
msgid "manual RM451 flamethrower"
msgstr "수동 RM451 화염방사기"

#: data\mods\blazemod\blaze_weapons_parts.json
msgid "manual perforator"
msgstr "수동 퍼포레이터"

#: data\mods\blazemod\blaze_weapons_parts.json
