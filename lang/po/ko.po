#. ~ Use action msg for {'str': 'wrist control computer'}.
#: data\json\items\tool\electronics.json
msgid "You activate the flashlight."
msgstr "손전등을 활성화했다."

#. ~ Use action need_charges_msg for {'str': 'wrist computer'}.
#. ~ Use action need_charges_msg for {'str': 'wrist control computer'}.
#: data\json\items\tool\electronics.json
