#: data\json\items\generic.json
msgid "topaz"
msgid_plural "topazs"
msgstr[0] "토파즈"

#. ~ Description for {'str': 'topaz'}
#: data\json\items\generic.json
msgid "A sparkling blue topaz."
msgstr "반짝이는 청색 토파즈입니다."

#: data\json\items\generic.json
msgid "cured hide"
msgid_plural "cured hides"
msgstr[0] "건조된 가죽"

#. ~ Description for {'str': 'cured hide'}
#: data\json\items\generic.json
msgid ""
"A rolled up animal hide which has been scraped of extraneous hair and flesh "
"and treated to prevent decay.  It could be tanned and transformed into "
"usable leather patches."
msgstr ""
"불필요한 털과 살을 긁어내고 부패 방지 처리한, 말아둔 동물 가죽입니다. 무두질해서 쓸 만한 가죽 조각으로 바꿀 수 있습니다."

#: data\json\items\generic.json
msgid "cured pelt"
msgid_plural "cured pelts"
msgstr[0] "건조된 모피"

#. ~ Description for {'str': 'cured pelt'}
#: data\json\items\generic.json
msgid ""
"A rolled up animal hide which has been scraped of extraneous hair and flesh "
"and treated to prevent decay.  It could be tanned and transformed into "
"usable fur pelts."
msgstr ""
"불필요한 털과 살을 긁어내고 부패 방지 처리한, 말아둔 동물 가죽입니다. 무두질해서 쓸 만한 모피 가죽으로 바꿀 수 있습니다."

#: data\json\items\generic.json
msgid "pile of straw"
msgid_plural "piles of straw"
msgstr[0] "짚단"

#. ~ Description for {'str': 'pile of straw', 'str_pl': 'piles of straw'}
#: data\json\items\generic.json
msgid ""
"A pile of dry grass.  Can be used to craft a straw bed if there is nothing "
"else to sleep on."
msgstr "건초 더미다. 잠잘 곳이 마땅치 않다면 짚 침대를 만드는 데 쓸 수 있다."

#: data\json\items\generic.json
msgid "pile of money"
msgid_plural "piles of money"
msgstr[0] "돈 더미"

#. ~ Description for {'str': 'pile of money', 'str_pl': 'piles of money'}
#: data\json\items\generic.json
msgid ""
"A pile of cash.  Can be used to fill a bathtub with cash or as a comforting "
"reminder of the past."
msgstr "현금 더미입니다. 욕조를 현금으로 채우거나 과거를 위로하는 기념으로 쓸 수 있습니다."

#: data\json\items\generic.json
msgid "straw doll"
msgid_plural "straw dolls"
msgstr[0] "짚 인형"

#. ~ Description for {'str': 'straw doll'}
#: data\json\items\generic.json
msgid "Old straw doll.  Represents a woman in a dress."
msgstr "드레스를 입은 여자를 본떠 만든 낡은 짚 인형."

#: data\json\items\generic.json
msgid "pillow"
msgid_plural "pillows"
msgstr[0] "베개"

#. ~ Description for {'str': 'pillow'}
#: data\json\items\generic.json
msgid "A pillow to rest your head on when sleeping."
msgstr "잘 때 머리에 베는 베개."

#: data\json\items\generic.json
msgid "body pillow"
msgid_plural "body pillows"
msgstr[0] "전신 베개"

#. ~ Description for {'str': 'body pillow'}
#: data\json\items\generic.json
msgid ""
"A big, body-sized pillow with a print of an anime character on the front and"
" their scantily clad version on the back."
msgstr "앞면에 애니메이션 캐릭터가 그려져있고 뒷면에는 알몸 상태의 캐릭터가 그려져있는 몸집이 큰 베개."

#: data\json\items\generic.json
msgid "down-filled pillow"
msgid_plural "down-filled pillows"
msgstr[0] "오리털 베개"

#. ~ Description for {'str': 'down-filled pillow'}
#: data\json\items\generic.json
msgid "A fluffy pillow to rest your head on when sleeping."
msgstr "잘 때 머리에 베는 푹신한 베개."

#: data\json\items\generic.json
msgid "teddy bear"
msgid_plural "teddy bears"
msgstr[0] "테디 베어"

#. ~ Description for {'str': 'teddy bear'}
#: data\json\items\generic.json
msgid ""
"An old and half rotten teddy bear.  Looks like this one commemorates the "
"grave of the child who once owned it."
msgstr "낡고 반쯤 썩은 테디 베어. 이 인형은 마치 옛 주인이었던 아이의 무덤을 기리는 것 같다."

#. ~ Description for {'str': 'teddy bear'}
#: data\json\items\generic.json
msgid ""
"A cuddly plush teddy bear.  It is wearing a little red tshirt but no pants."
msgstr "포근한 봉제 테디 베어입니다. 작은 빨간 티셔츠를 입고 있지만 바지는 없습니다."

#: data\json\items\generic.json
msgid "money bundle"
msgid_plural "money bundles"
msgstr[0] "돈다발"

#. ~ Description for {'str': 'money bundle'}
#: data\json\items\generic.json
msgid "A bundle holding many 20 dollar bills, pretty useless now though."
msgstr "20달러 정도의 돈뭉치지만, 지금 같은 상황에서는 쓸모가 없습니다."

#: data\json\items\generic.json
msgid "autoclave pouch"
msgid_plural "autoclave pouches"
msgstr[0] "오토클레이브 파우치"

#. ~ Description for {'str': 'autoclave pouch', 'str_pl': 'autoclave pouches'}
#: data\json\items\generic.json
msgid ""
"This is a medical device that bears the approval of the FDA (Food and Drug "
"Administration).  If used properly, these pouches can keep things sterile "
"indefinitely."
msgstr ""
"FDA(식품의약국) 승인을 받은 의료 기기입니다. 제대로 사용하면 이 파우치는 물건을 무기한 멸균 상태로 유지할 수 있습니다."

