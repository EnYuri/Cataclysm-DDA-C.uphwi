msgstr "고장난 채광 로봇. 이제 더 이상 구멍을 뚫지 않으니 그다지 위협적이지 않다. 부품 회수 가능."

#: data\json\items\generic.json
msgid "broken recon mech"
msgid_plural "broken recon mechs"
msgstr[0] "부서진 정찰 메크"

