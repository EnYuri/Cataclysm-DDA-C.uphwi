msgid_plural "glyphs of Yuggoth"
msgstr[0] "유고스의 문양"

#. ~ Description for {'str': 'glyph of Yuggoth', 'str_pl': 'glyphs of
#. Yuggoth'}
#: data\mods\Arcana_BN\items\tools.json
