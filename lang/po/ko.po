msgid "titanium barrel"
msgid_plural "titanium barrels"
msgstr[0] "티타늄 총열"

#: data\mods\Aftershock\items\gunmod\barrel.json
msgid ""
"A precision-machined titanium replacement barrel.  Significantly lighter "
"than steel with improved heat dissipation, resulting in a more controllable "
"weapon."
msgstr "정밀 가공된 티타늄 교체용 총열입니다. 강철보다 훨씬 가볍고 방열성이 개선되어 더 제어하기 쉬운 무기가 됩니다."

