#: data\json\monsters\fish.json
msgid "salmon"
msgid_plural "salmons"
msgstr[0] "연어"

#. ~ Description for {'str': 'salmon'}
#: data\json\monsters\fish.json
msgid ""
"An Atlantic salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr "대서양 연어입니다. 아주 기름진 영양가 높은 물고기입니다. 훈제하면 맛있습니다."

#: data\json\monsters\fish.json
msgid "kokanee salmon"
msgid_plural "kokanee salmons"
msgstr[0] "코카니 연어"

#. ~ Description for {'str': 'kokanee salmon'}
#: data\json\monsters\fish.json
msgid ""
"A Kokanee salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr "코카니 연어입니다. 아주 기름진 영양가 높은 물고기입니다. 훈제하면 맛있습니다."

#: data\json\monsters\fish.json
msgid "chinook salmon"
msgid_plural "chinook salmons"
msgstr[0] "치누크 연어"

#. ~ Description for {'str': 'chinook salmon'}
#: data\json\monsters\fish.json
msgid ""
"A Chinook salmon.  A very fatty, nutritious fish.  Tastes great smoked."
msgstr "치누크 연어입니다. 아주 기름진 영양가 높은 물고기입니다. 훈제하면 맛있습니다."

#: data\json\monsters\fish.json
msgid "coho salmon"
msgid_plural "coho salmons"
msgstr[0] "코호 연어"

#. ~ Description for {'str': 'coho salmon'}
