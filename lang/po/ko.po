#: data\json\items\armor\belts.json
#: data\mods\MagicalNights\items\enchanted\enchanted_belts.json
msgid "You tuck your %s into your %s"
msgstr "%s을(를) %s에 꽃아넣었다."

#. ~ Use action holster_prompt for {'str': 'leather belt'}.
#. ~ Use action holster_prompt for {'str': 'webbing belt'}.
#. ~ Use action holster_prompt for magic leather belt.
#. ~ Use action holster_prompt for {'str': 'Belt of Weaponry', 'str_pl':
#. 'Belts of Weaponry'}.
#: data\json\items\armor\belts.json
#: data\mods\MagicalNights\items\enchanted\enchanted_belts.json
msgid "Stick what into your belt"
msgstr "벨트에 무엇을 끼웁니까?"

#. ~ Description for {'str': 'leather belt'}
#. ~ Description for magic leather belt
#: data\json\items\armor\belts.json
#: data\mods\MagicalNights\items\enchanted\enchanted_belts.json
msgid "A leather belt.  Useful for making your pair of pants fit."
msgstr "가죽 허리띠. 바지의 허리를 몸에 맞게 조절할 때 사용합니다."

#: data\json\items\armor\belts.json
msgid "obi"
msgid_plural "obis"
msgstr[0] "오비"

#. ~ Description for {'str': 'obi'}
#: data\json\items\armor\belts.json
msgid "A broad, black obi gi."
msgstr "넓은 검은 오비 도복 벨트입니다."

#: data\json\items\armor\belts.json
msgid "police duty belt"
msgid_plural "police duty belts"
msgstr[0] "경찰 근무 벨트"

#. ~ Use action holster_msg for {'str': 'police duty belt'}.
#: data\json\items\armor\belts.json
msgid "You attach your %s to your %s."
msgstr "%s을(를) %s에 부착했다."

#. ~ Use action holster_prompt for {'str': 'police duty belt'}.
#: data\json\items\armor\belts.json
msgid "Attach what to holder?"
msgstr "홀더에 무엇을 부착합니까?"

#. ~ Description for {'str': 'police duty belt'}
#: data\json\items\armor\belts.json
msgid ""
"Black leather belt used by police officers.  It has several pouches and a "
"holder for a baton."
msgstr "경찰이 쓰는 검은 가죽 벨트입니다. 여러 파우치와 바톤 홀더가 있습니다."

#: data\json\items\armor\belts.json
msgid "survivor belt"
msgid_plural "survivor belts"
msgstr[0] "생존용 벨트"

#. ~ Use action holster_msg for {'str': 'survivor belt'}.
#. ~ Use action holster_msg for {'str': 'tool belt'}.
#: data\json\items\armor\belts.json
msgid "You put your %1$s in your %2$s"
msgstr "%1$s을(를) %2$s에 넣었다."

#. ~ Use action holster_prompt for {'str': 'survivor belt'}.
#. ~ Use action holster_prompt for {'str': 'tool belt'}.
#: data\json\items\armor\belts.json
msgid "Store tool or blade"
msgstr "도구나 칼날 넣기"

#. ~ Description for {'str': 'survivor belt'}
#: data\json\items\armor\belts.json
msgid ""
"A custom-built leather utility belt covered with straps and pouches to store"
" up to six tools or blades.  Durable and carefully crafted to be comfortable"
" to wear.  Activate to sheathe/draw a weapon."
msgstr ""
"최대 6개의 도구나 칼날을 저장하는 끈과 파우치로 덮인 수제 가죽 유틸리티 벨트입니다. 튼튼하고 신중하게 제작돼 착용이 편합니다. "
"활성화해 무기를 넣거나 뽑습니다."

#: data\json\items\armor\belts.json
msgid "tool belt"
msgid_plural "tool belts"
msgstr[0] "도구 벨트"

#. ~ Description for {'str': 'tool belt'}
#: data\json\items\armor\belts.json
msgid ""
"A common belt with pockets, loops and sheaths to store up to six tools or "
"blades.  Widely used by handymen and electricians."
msgstr "최대 6개의 도구나 칼날을 저장하는 주머니, 고리, 칼집이 달린 흔한 벨트입니다. 잡역부와 전기기사에게 널리 쓰입니다."

#: data\json\items\armor\belts.json
msgid "webbing belt"
msgid_plural "webbing belts"
msgstr[0] "웨빙 벨트"

#. ~ Description for {'str': 'webbing belt'}
#: data\json\items\armor\belts.json
msgid "A 2-inch nylon webbing belt commonly used by military forces."
msgstr "군이 흔히 쓰는 2인치 나일론 웨빙 벨트입니다."

#: data\json\items\armor\boots.json
msgid "pair of cord sandals"
msgid_plural "pairs of cord sandals"
msgstr[0] "끈 샌들"

#. ~ Description for {'str': 'pair of cord sandals', 'str_pl': 'pairs of cord
#. sandals'}
#: data\json\items\armor\boots.json
msgid ""
"Lightweight sandals made from wound cord.  They offer little in the way of "
"protection, but keep you cool during warmer months."
msgstr "끈을 감아 만든 가벼운 샌들. 발을 조금 보호해주지만, 더울 때 시원하게 발을 유지해 줍니다."

#: data\json\items\armor\boots.json data\mods\Nechronica\nec_boots.json
msgid "pair of boots"
msgid_plural "pairs of boots"
msgstr[0] "부츠"

#. ~ Description for {'str': 'pair of boots', 'str_pl': 'pairs of boots'}
#. ~ Description for pair of boots
#: data\json\items\armor\boots.json data\mods\Nechronica\nec_boots.json
msgid "Tough leather boots.  Very durable."
msgstr "튼튼한 가죽 부츠. 아주 견고합니다."

#: data\json\items\armor\boots.json
msgid "pair of occult boots"
msgid_plural "pairs of occult boots"
msgstr[0] "오컬트 장화 한 켤레"

#. ~ Description for {'str': 'pair of occult boots', 'str_pl': 'pairs of
#. occult boots'}
#: data\json\items\armor\boots.json
msgid ""
