#. ~ Use action menu_text for {'str': 'springstaff(baton)', 'str_pl':
#. 'springstaves(baton)'}.
#: data\mods\MagicalNights\items\enchanted\enchanted_melee.json
msgid "Extend to staff"
msgstr "장봉으로 펼치기"

#. ~ Use action msg for {'str': 'springstaff(baton)', 'str_pl':
#. 'springstaves(baton)'}.
#: data\mods\MagicalNights\items\enchanted\enchanted_melee.json
msgid "You snap open your springstaff into staff mode."
msgstr "스프링스태프를 장봉 형태로 펼쳤습니다."

#. ~ Description for {'str': 'springstaff(baton)', 'str_pl':
#. 'springstaves(baton)'}
#: data\mods\MagicalNights\items\enchanted\enchanted_melee.json
msgid ""
"This versatile weapon uses Technomancy-enhanced springs to keep the staff "
"tips retracted while in baton configuration.  Activate to extend."
msgstr "이 다목적 무기는 단봉 형태일 때 테크노맨시로 강화된 스프링으로 봉 끝을 수납 상태로 유지합니다. 활성화하면 펼쳐집니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_melee.json
msgid "springstaff(staff)"
msgid_plural "springstaves(staff)"
msgstr[0] "스프링스태프(장봉)"

#. ~ Use action menu_text for {'str': 'springstaff(staff)', 'str_pl':
#. 'springstaves(staff)'}.
#: data\mods\MagicalNights\items\enchanted\enchanted_melee.json
msgid "Retract to baton"
msgstr "단봉으로 접기"

#. ~ Use action msg for {'str': 'springstaff(staff)', 'str_pl':
#. 'springstaves(staff)'}.
#: data\mods\MagicalNights\items\enchanted\enchanted_melee.json
msgid "You collapse your springstaff into baton mode."
msgstr "스프링스태프를 단봉 형태로 접었습니다."

#. ~ Description for {'str': 'springstaff(staff)', 'str_pl':
#. 'springstaves(staff)'}
#: data\mods\MagicalNights\items\enchanted\enchanted_melee.json
msgid ""
"This versatile weapon uses Technomancy-enhanced springs to keep the staff "
"tips from retracting while in staff configuration.  Activate to extend."
msgstr "이 다목적 무기는 장봉 형태일 때 테크노맨시로 강화된 스프링으로 봉 끝이 수납되지 않게 유지합니다. 활성화하면 접힙니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "heat cube"
msgid_plural "heat cubes"
msgstr[0] "열기 큐브"

#. ~ Use action menu_text for heat cube.
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "Activate torch mode"
msgstr "횃불 모드 활성화"

#. ~ Use action msg for heat cube.
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"You push the torch button and the cube emits a large flame from the top, one"
" that does radiate heat, but won't burn anything."
msgstr "횃불 버튼을 누르자 큐브 위쪽에서 큰 불꽃을 뿜어냅니다. 열기는 발산하지만 아무것도 태우지는 않습니다."

#. ~ Description for heat cube
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"A smooth steel cube the size of your fist.  Several buttons on the sides "
"activate the powers of the cube."
msgstr "주먹만한 매끄러운 강철 큐브입니다. 옆면의 버튼 몇 개가 큐브의 힘을 활성화합니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "heat cube (torch on)"
msgid_plural "heat cubes (torch on)"
msgstr[0] "열기 큐브 (횃불 켜짐)"

#. ~ Use action msg for {'str': 'heat cube (torch on)', 'str_pl': 'heat cubes
#. (torch on)'}.
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "The torch flame is extinguished."
msgstr "횃불 불꽃이 꺼졌습니다."

#. ~ Description for {'str': 'heat cube (torch on)', 'str_pl': 'heat cubes
#. (torch on)'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"The heat cube in the torch configuration, where it emits warmth and a bright"
" flame that does not burn."
msgstr "횃불 구성 상태의 열기 큐브로, 타지 않는 밝은 불꽃과 온기를 뿜어냅니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "skeleton key of opening"
msgid_plural "skeleton keys of opening"
msgstr[0] "열림의 해골 열쇠"

#. ~ Description for {'str': 'skeleton key of opening', 'str_pl': 'skeleton
#. keys of opening'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"A small gold skeleton key.  You can activate it to unlock locked things."
msgstr "작은 금 해골 열쇠입니다. 활성화하면 잠긴 것들을 열 수 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "everburning torch"
msgid_plural "everburning torches"
msgstr[0] "영원불 횃불"

#. ~ Description for {'str': 'everburning torch', 'str_pl': 'everburning
#. torches'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"This is a high quality engraved wooden torch.  On command, the tip bursts "
"into flame and produces a fair amount of light.  It will burn forever."
msgstr "고급스럽게 조각된 나무 횃불입니다. 명령하면 끝이 불꽃에 휩싸여 상당한 빛을 냅니다. 영원히 탈 것입니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "everburning torch (lit)"
msgid_plural "everburning torches (lit)"
msgstr[0] "영원불 횃불 (점화됨)"

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "endless flask"
msgid_plural "endless flasks"
msgstr[0] "끝없는 플라스크"

#. ~ Use action msg for {'str': 'endless flask'}.
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "You open the flask and discover it full of sweet, sweet, whiskey!"
msgstr "플라스크를 열자 달콤한, 아주 달콤한 위스키로 가득 차 있음을 발견했습니다!"

#. ~ Use action not_ready_msg for {'str': 'endless flask'}.
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "The flask isn't done refilling yet."
msgstr "플라스크가 아직 다 차오르지 않았습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "enchanted tailor's kit"
msgid_plural "enchanted tailor's kits"
msgstr[0] "마법 재단 도구"

#. ~ Description for enchanted tailor's kit
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"This is a high quality, engraved steel kit with a variety of needles, some "
"plastic spools for thread, some small scissors, even a small heating element"
" for melting and joining plastic.  Use a tailor's kit to customize your "
"clothing and armor.  This uses your tailoring skill.  It also contains one "
"of those magic spiders that constantly, if slowly, makes new thread."
msgstr ""
"다양한 바늘, 실을 감는 플라스틱 실패, 작은 가위, 심지어 플라스틱을 녹여 이어주는 소형 가열 소자까지 갖춘, 고급스럽게 조각된 강철 "
"키트입니다. 재단 도구로 의복과 갑옷을 개조하세요. 재단 기술을 사용합니다. 천천히지만 끊임없이 새 실을 만드는 마법 거미도 들어 "
"있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "spider box"
msgid_plural "spider boxes"
msgstr[0] "거미 상자"

#. ~ Description for {'str': 'spider box', 'str_pl': 'spider boxes'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"This is a small glass box that contains a spider that diligently works day "
"and night to produce silk thread that it stores in a reservoir you can open "
"and retrieve it from."
msgstr ""
"거미가 들어 있는 작은 유리 상자입니다. 거미가 밤낮으로 부지런히 일해 비단실을 생산해 저장소에 모아두며, 열어서 꺼낼 수 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "magical reading light (covered)"
msgid_plural "magical reading lights (covered)"
msgstr[0] "마법 독서등 (덮개)"

#. ~ Description for {'str': 'magical reading light (covered)', 'str_pl':
#. 'magical reading lights (covered)'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"Powered by the magic of glow powder and lesser mana potions, this extremely "
"expensive little light will provide just enough light to read by for at "
"least a decade.  The cover is closed.  Use it to open the cover and show the"
" light."
msgstr ""
"발광 가루와 하급 마나 물약의 마법으로 구동되는 이 엄청나게 비싼 작은 조명은 최소 10년은 읽기에 충분한 빛을 제공합니다. 덮개가 닫혀"
" 있습니다. 사용하면 덮개를 열어 빛을 드러냅니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "magical reading light"
msgid_plural "magical reading lights"
msgstr[0] "마법 독서등"

#. ~ Description for magical reading light
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"Powered by the magic of glow powder and lesser mana potions, this extremely "
"expensive little light will provide just enough light to read by for at "
"least a decade.  Use it to close the cover and hide the light."
msgstr ""
"발광 가루와 하급 마나 물약의 마법으로 구동되는 이 엄청나게 비싼 작은 조명은 최소 10년은 읽기에 충분한 빛을 제공합니다. 사용하면 "
"덮개를 닫아 빛을 숨깁니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "bulette 45 acp bag"
msgid_plural "bulette 45 acp bags"
msgstr[0] "불레트 .45 ACP 가방"

#. ~ Description for {'str': 'bulette 45 acp bag'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"An ammo bag enchanted to slowly produce ammo over time.  In this case, it's "
"tuned to .45 ACP."
msgstr "시간이 지나며 천천히 탄약을 만들어내도록 마법이 걸린 탄약 가방입니다. 이 경우 .45 ACP로 맞춰져 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "bulette 357 magnum bag"
msgid_plural "bulette 357 magnum bags"
msgstr[0] "불레트 .357 매그넘 가방"

#. ~ Description for {'str': 'bulette 357 magnum bag'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"An ammo bag enchanted to slowly produce ammo over time.  In this case, it's "
"tuned to .357 magnum."
msgstr "시간이 지나며 천천히 탄약을 만들어내도록 마법이 걸린 탄약 가방입니다. 이 경우 .357 매그넘으로 맞춰져 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "bulette 40 S&W bag"
msgid_plural "bulette 40 S&W bags"
msgstr[0] "불레트 .40 S&W 가방"

#. ~ Description for {'str': 'bulette 40 S&W bag'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"An ammo bag enchanted to slowly produce ammo over time.  In this case, it's "
"tuned to .40 S&W."
msgstr "시간이 지나며 천천히 탄약을 만들어내도록 마법이 걸린 탄약 가방입니다. 이 경우 .40 S&W로 맞춰져 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid "mana-fueled vibrator"
msgid_plural "mana-fueled vibrators"
msgstr[0] "마나 구동 바이브레이터"

#. ~ Description for {'str': 'mana-fueled vibrator'}
#: data\mods\MagicalNights\items\enchanted\enchanted_misc.json
msgid ""
"This mana-devouring device is just the thing to knead the tension out and "
"help you relax.  Wizards have needs too, after all."
msgstr "이 마나를 먹는 장치는 긴장을 풀어주고 이완을 돕기에 딱 좋습니다. 마법사에게도 욕구는 있으니까요."

#: data\mods\MagicalNights\items\enchanted\enchanted_ranged.json
msgid "M47A1 Techno-Medusa"
msgid_plural "M47A1 Techno-Medusae"
msgstr[0] "M47A1 테크노-메두사"

#: data\mods\MagicalNights\items\enchanted\enchanted_ranged.json
msgid ""
"A magically-enhanced update to the Phillips & Rodgers' M47 Medusa, a  multi-"
"caliber revolver aimed at survivalists.  While Technomancy improves the "
"reliability with smaller cartridges, it is not as accurate as dedicated "
"caliber revolvers due to freebore."
msgstr ""
"필립스 & 로저스의 서바이벌리스트용 다구경 리볼버 M47 메두사의 마법 강화 개량형입니다. 테크노맨시가 소구경 탄약의 신뢰성을 높여주지만"
" 프리보어로 인해 전용 구경 리볼버만큼 정확하지는 않습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_ranged.json
msgid "gunblade"
msgid_plural "gunblades"
msgstr[0] "건블레이드"

#: data\mods\MagicalNights\items\enchanted\enchanted_ranged.json
msgid ""
"Constructed similarly to a falcata, this forward-sloping blade has a short-"
"barrel pump shotgun attached to the blade's spine for finishing blows or a "
"first strike."
msgstr "팔카타와 비슷하게 만들어진 전경사 칼날로, 마무리 일격이나 선공을 위해 칼등에 단총열 펌프 산탄총이 부착되어 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "copper magic ring"
msgid_plural "copper magic rings"
msgstr[0] "구리 마법 반지"

#. ~ Description for copper magic ring
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "A generic copper magic ring."
msgstr "일반 구리 마법 반지입니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "magic ring"
msgid_plural "magic rings"
msgstr[0] "마법 반지"

#. ~ Description for magic ring
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "A generic silver magic ring."
msgstr "일반 은 마법 반지입니다."

#. ~ Description for magic ring
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "A generic gold magic ring."
msgstr "일반 금 마법 반지입니다."

#. ~ Description for magic ring
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "A generic platinum magic ring."
msgstr "일반 백금 마법 반지입니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "ring of blades"
msgid_plural "rings of blades"
msgstr[0] "칼날의 반지"

#. ~ Description for {'str': 'ring of blades', 'str_pl': 'rings of blades'}
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid ""
"An ornate silver ring engraved with daggers that conjures a near perfect "
"throwing knife into your hand on activation."
msgstr "단도가 새겨진 화려한 은 반지로, 작동하면 손에 거의 완벽한 투척 나이프를 소환합니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "eel ring"
msgid_plural "eel rings"
msgstr[0] "장어 반지"

#. ~ Description for eel ring
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid ""
"A thin silver band ring, depicting an eel coiled on itself.  Allows you to "
"dodge an extra attack per turn."
msgstr "몸을 말은 장어가 새겨진 얇은 은 반지입니다. 턴당 공격 하나를 추가로 회피할 수 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "bicephalous eel ring"
msgid_plural "bicephalous eel rings"
msgstr[0] "쌍두 장어 반지"

#. ~ Description for {'str': 'bicephalous eel ring'}
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid ""
"A thin gold band ring, depicting a bicephalous eel coiled on itself.  Allows"
" you to dodge two extra attacks per turn."
msgstr "몸을 말은 쌍두 장어가 새겨진 얇은 금 반지입니다. 턴당 공격 둘을 추가로 회피할 수 있습니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "ring of strength +1"
msgid_plural "rings of strength +1"
msgstr[0] "힘의 반지 +1"

#. ~ Description for {'str': 'ring of strength +1', 'str_pl': 'rings of
#. strength +1'}
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "A copper ring that makes you a little stronger when you wear it."
msgstr "끼면 조금 더 강해지는 구리 반지입니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "ring of strength +2"
msgid_plural "rings of strength +2"
msgstr[0] "힘의 반지 +2"

#. ~ Description for {'str': 'ring of strength +2', 'str_pl': 'rings of
#. strength +2'}
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "A silver ring that makes you a good bit stronger when you wear it."
msgstr "끼면 꽤 더 강해지는 은 반지입니다."

#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "ring of strength +3"
msgid_plural "rings of strength +3"
msgstr[0] "힘의 반지 +3"

#. ~ Description for {'str': 'ring of strength +3', 'str_pl': 'rings of
#. strength +3'}
#: data\mods\MagicalNights\items\enchanted\enchanted_rings.json
msgid "A golden ring that makes you surprisingly stronger when you wear it."
msgstr "끼면 놀랄 만큼 더 강해지는 금 반지입니다."

