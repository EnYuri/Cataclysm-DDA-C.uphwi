#: data\mods\DinoMod\monster_attacks.json
msgid "%1$s swings its massive tail at <npcname>'s %2$s!"
msgstr "%1$s이(가) 거대한 꼬리를 휘둘러 <npcname>의 %2$s을(를) 으깹니다!"

#: data\mods\DinoMod\monster_attacks.json
msgid "%s swings its tail at you, but it's blunted by your armor."
