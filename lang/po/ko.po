#: data\mods\Nechronica\nec_speech.json
msgid "\"자, 오래된 후일담을 시작해보죠.\""
msgstr "\"자, 오래된 후일담을 시작해보죠.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"모형 정원 속의 이야기에 어서 와요.\""
msgstr "\"모형 정원 속의 이야기에 어서 와요.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"왜곡의 무도를 즐겨주세요.\""
msgstr "\"왜곡의 무도를 즐겨주세요.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"잃어버린 기억은 돌아왔나요?\""
msgstr "\"잃어버린 기억은 돌아왔나요?\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"다과회를 한 번 더, 시작해볼까요.\""
msgstr "\"다과회를 한 번 더, 시작해볼까요.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"그 종 소리는 두 번 다시... 아니, 그만두죠.\""
msgstr "\"그 종 소리는 두 번 다시... 아니, 그만두죠.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"당신을 인형으로 만들어볼까요.\""
msgstr "\"당신을 인형으로 만들어볼까요.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"실패 따위는 대수롭지 않아요. 결국에는 사자가 되실테니까요.\""
msgstr "\"실패 따위는 대수롭지 않아요. 결국에는 사자가 되실 테니까요.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"인형은 사랑스러워요.\""
msgstr "\"인형은 사랑스러워요.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"사자들의 춤사위에 막을 올립시다.\""
msgstr "\"사자들의 춤사위에 막을 올립시다.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"...쿠후후훗...\""
msgstr "\"...쿠후후훗...\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"아름다운 악몽에 어서 와요.\""
msgstr "\"아름다운 악몽에 어서 와요.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"부디 편하신대로 서로를 망가뜨리고 모욕해주시길.\""
msgstr "\"부디 편하신 대로 서로를 망가뜨리고 모욕해주시길.\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"10면체 주사위 하나를 준비해주세요\""
msgstr "\"10면체 주사위 하나를 준비해주세요\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"제 실력을 보여드릴 때가 왔군욧\""
msgstr "\"제 실력을 보여드릴 때가 왔군욧\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"저는 완벽깜찍하게 아름다워요!\""
msgstr "\"저는 완벽깜찍하게 아름다워요!\""

#: data\mods\Nechronica\nec_speech.json
msgid "\"읏, 여자 끼리 야한 짓하는 게 시, 싫은 사람도 있는 거랍니다!\""
msgstr "\"읏, 여자 끼리 야한 짓하는 게 시, 싫은 사람도 있는 거랍니다!\""

#: data\mods\Nechronica\nec_speech.json
