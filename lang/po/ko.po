#: src/trapfunc.cpp
msgid "You fall down under %s!"
msgstr "%s 밑으로 떨어졌다!"

#: src/trapfunc.cpp
msgid "You fall in a pit filled with glass shards!"
msgstr "유리 파편이 가득한 구덩이에 빠졌다!"

#: src/trapfunc.cpp
