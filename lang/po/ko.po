msgstr "놈들은 다시 일어나. 헤드샷 안 먹혀."

#: data\json\snippets\graffiti.json
msgid "stay out of <city>"
msgstr "<city>에 들어가지 마"

#: data\json\snippets\graffiti.json
msgid "<city> has fallen"
msgstr "<city> 함락됐다"

#: data\json\snippets\graffiti.json
msgid "NO ONE LEFT HERE MOVE ON"
msgstr "여기 남은 사람 없다 지나가라"

#: data\json\snippets\graffiti.json
msgid "deth trap"
msgstr "죽음의 함정"

#: data\json\snippets\graffiti.json
msgid "no ones coming"
msgstr "아무도 안 온다"

#: data\json\snippets\graffiti.json
msgid "GOVERMENT DID THIS TO US"
msgstr "정부가 우리한테 이랬다"

#: data\json\snippets\graffiti.json
msgid "FUCK CHINA"
