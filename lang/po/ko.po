#: data\json\speech.json
msgid "\"Are you feeling all right?\""
msgstr "\"너 괜찮니?\""

#: data\json\speech.json
msgid "\"I think I'll live.\""
msgstr "\"난 아무렇지도 않아.\""

#: data\json\speech.json
msgid "\"I think I need to see a doctor.\""
msgstr "\"아무래도 진찰이 필요할 것 같아.\""

#: data\json\speech.json
msgid "\"Is everything all right?\""
msgstr "\"이제 괜찮은 건가?\""

#: data\json\speech.json
