#: data\mods\Touhou_com\item\book.json
msgid "낡은 오컬트 책입니다. 표지도 페이지도 변색될 정도로 낡아서, 주술적인 분위기가 느껴집니다. 어쩌면 진짜일지도 모르겠네요."
msgstr "낡은 오컬트 책입니다. 표지도 페이지도 변색될 정도로 낡아서, 주술적인 분위기가 느껴집니다. 어쩌면 진짜일지도 모르겠네요."

#: data\mods\Touhou_com\item\book.json
msgid "피투성이 일기장"
msgid_plural "피투성이 일기장s"
msgstr[0] "피투성이 일기장"

#. ~ Description for 피투성이 일기장
#: data\mods\Touhou_com\item\book.json
msgid ""
"피에 젖은 일기입니다. 비장한 마음으로 일기를 열자 『광기에 미쳐버린 여동생이 폭주했다』『저택 사람들이 흡혈귀가 됐어』『어떻게든 동생을 "
"막아야 해……』라는 내용으로 일기가 끝납니다."
msgstr ""
"피에 젖은 일기입니다. 비장한 마음으로 일기를 열자 『광기에 미쳐버린 여동생이 폭주했다』『저택 사람들이 흡혈귀가 됐어』『어떻게든 동생을 "
