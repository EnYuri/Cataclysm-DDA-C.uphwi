msgid_plural "skeletal ornithomimid brutes"
msgstr[0] "해골 오르니토미무스류 브루트"

#. ~ Description for {'str': 'skeletal ornithomimid brute'}
#. ~ Description for {'str': 'skeletal thescelosaurus brute'}
