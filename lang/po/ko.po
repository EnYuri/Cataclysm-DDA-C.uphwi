#: data\mods\Nechronica\nec_tool.json
msgid "죠기리"
msgid_plural "죠기리s"
msgstr[0] "죠기리"

#. ~ Description for 죠기리
#: data\mods\Nechronica\nec_tool.json
msgid ""
"중간 정도 길이의 칼을 톱이나 작은 칼로 엉망진창으로 다듬은 무기입니다. 섬세한 작업은 무리지만 난도질하고 토막내는 것 하나는 유별나게 "
"잘 합니다."
msgstr ""
"중간 정도 길이의 칼을 톱이나 작은 칼로 엉망진창으로 다듬은 무기입니다. 섬세한 작업은 무리지만 난도질하고 토막내는 것 하나는 유별나게 "
"잘 합니다."

#: data\mods\Nechronica\nec_tool.json
msgid "단분자섬유"
msgid_plural "단분자섬유s"
msgstr[0] "단분자섬유"

#. ~ Description for 단분자섬유
#: data\mods\Nechronica\nec_tool.json
msgid ""
"겉보기엔 가늘어보이는 실이지만 모든 것을 양단할 수 있는 튼튼한 섬유입니다. 달인이라면 손가락을 움직이는 것만으로도 희생자를 "
"산산조각냅니다."
msgstr ""
"겉보기엔 가늘어보이는 실이지만 모든 것을 양단할 수 있는 튼튼한 섬유입니다. 달인이라면 손가락을 움직이는 것만으로도 희생자를 "
"산산조각냅니다."

#: data\mods\Nechronica\nec_tool.json
msgid "거대 가위"
msgid_plural "거대 가위s"
msgstr[0] "거대 가위"

#. ~ Description for 거대 가위
#: data\mods\Nechronica\nec_tool.json
msgid "거대한 전투용 가위입니다. 다루기는 힘들지만 그 견고함과 압도적인 절단력은 매력적입니다."
msgstr "거대한 전투용 가위입니다. 다루기는 힘들지만 그 견고함과 압도적인 절단력은 매력적입니다."

#: data\mods\Nechronica\nec_tool.json
msgid "명도"
msgid_plural "명도s"
msgstr[0] "명도"

#. ~ Description for 명도
#: data\mods\Nechronica\nec_tool.json
msgid "빼어난 기술로 제작된 칼로 명문이 새겨져 있다. 평범한 카타나보다 훌륭한 성능을 가지고 있다."
msgstr "빼어난 기술로 제작된 칼로 명문이 새겨져 있다. 평범한 카타나보다 훌륭한 성능을 가지고 있다."

#: data\mods\Nechronica\nec_tool.json
msgid "강철추"
msgid_plural "강철추s"
msgstr[0] "강철추"

#. ~ Description for 강철추
#: data\mods\Nechronica\nec_tool.json
msgid "쇠사슬에 강철공이 붙어 있습니다. 휘둘러서 철구로 후려치는 것말고도 사슬로 적의 몸을 얽어서 움직임을 막는 사용법도 있습니다."
msgstr ""
"쇠사슬에 강철공이 붙어 있습니다. 휘둘러서 철구로 후려치는 것말고도 사슬로 적의 몸을 얽어서 움직임을 막는 사용법도 있습니다."

#: data\mods\Nechronica\nec_tool.json
msgid "날아다니는 단두대"
msgid_plural "날아다니는 단두대s"
msgstr[0] "날아다니는 단두대"

#. ~ Description for 날아다니는 단두대
#: data\mods\Nechronica\nec_tool.json
msgid "수 많은 날이 돋아난 원반톱이 붙어 있는 쇠사슬입니다. 멀리 떨어진 적도 다진 고기로 만드는 흉악한 무기입니다."
msgstr "수많은 날이 돋아난 원반톱이 붙어 있는 쇠사슬입니다. 멀리 떨어진 적도 다진 고기로 만드는 흉악한 무기입니다."

#: data\mods\Nechronica\nec_tool.json
msgid "전투용 잔디깍이 (off)"
msgid_plural "전투용 잔디깍이 (off)s"
msgstr[0] "전투용 잔디깍이 (off)"

#. ~ Use action msg for 전투용 잔디깍이 (off).
#: data\mods\Nechronica\nec_tool.json
msgid "스크류가 큰 소리를 내면서 흉악하게 회전한다!"
msgstr "스크류가 큰 소리를 내면서 흉악하게 회전한다!"

#. ~ Use action need_charges_msg for 전투용 잔디깍이 (off).
#: data\mods\Nechronica\nec_tool.json
msgid "줄을 당겨서 시동을 걸었지만... 아무런 일도 일어나지 않았다."
msgstr "줄을 당겨서 시동을 걸었지만... 아무런 일도 일어나지 않았다."

#. ~ Description for 전투용 잔디깍이 (off)
#: data\mods\Nechronica\nec_tool.json
msgid "좀비를 깍아버리기 위해 개조된 잔디깍이입니다. 스위치를 켜면 무수한 날이 달린 스크류가 회전을 시작합니다."
msgstr "좀비를 깍아버리기 위해 개조된 잔디깍이입니다. 스위치를 켜면 무수한 날이 달린 스크류가 회전을 시작합니다."

#: data\mods\Nechronica\nec_tool.json
msgid "전투용 잔디깍이 (on)"
msgid_plural "전투용 잔디깍이 (on)s"
msgstr[0] "전투용 잔디깍이 (on)"

#. ~ Use action msg for 전투용 잔디깍이 (on).
#: data\mods\Nechronica\nec_tool.json
msgid "스크류가 천천히 회전을 멈춘다."
msgstr "스크류가 천천히 회전을 멈춘다."

#. ~ Description for 전투용 잔디깍이 (on)
#: data\mods\Nechronica\nec_tool.json
msgid "수 많은 날들이 무자비하게 돌아가고 있습니다. 닿은 것은 바로 갈려나갈겁니다!"
msgstr "수많은 날들이 무자비하게 돌아가고 있습니다. 닿은 것은 바로 갈려나갈 겁니다!"

#: data\mods\Nechronica\nec_tool.json
msgid "어새신 블레이드"
msgid_plural "어새신 블레이드s"
msgstr[0] "어새신 블레이드"

#. ~ Description for 어새신 블레이드
#: data\mods\Nechronica\nec_tool.json
msgid ""
"토시 안쪽에 수납된 발사 장치로 뽑아내는 단검입니다. 순식간에 수납과 사출을 할 수 있고, 중요한 인물들을 암살하는 데에 많이 "
"사용됐습니다."
msgstr ""
"토시 안쪽에 수납된 발사 장치로 뽑아내는 단검입니다. 순식간에 수납과 사출을 할 수 있고, 중요한 인물들을 암살하는 데에 많이 "
"사용됐습니다."

#: data\mods\NoVehicleColors\modinfo.json
msgid "No Vehicle Colors"
msgstr "차량 색상 없음"

#. ~ Description for No Vehicle Colors
#: data\mods\NoVehicleColors\modinfo.json
msgid "Limits vehicle colors to standard Cataclysm Red and Green"
msgstr "차량 색상을 표준 캐털리즘 레드와 그린으로 제한합니다"

#: data\mods\No_Acid_Zombies\modinfo.json
msgid "No Acid Zombies"
msgstr "산성 좀비 제거"

#. ~ Description for No Acid Zombies
#: data\mods\No_Acid_Zombies\modinfo.json
msgid "Removes all acid-based zombies from the game."
msgstr "산성 공격을 하는 좀비를 게임에서 제거합니다."

#: data\mods\No_Anthills\modinfo.json
msgid "No Ants"
msgstr "개미 없음"

#. ~ Description for No Ants
#: data\mods\No_Anthills\modinfo.json
msgid "Removes ants and anthills from the game"
msgstr "게임에서 개미와 개미탑을 제거합니다."

#: data\mods\No_Blobs\modinfo.json
msgid "No Blobs"
msgstr "블럽 없음"

#. ~ Description for No Blobs
#: data\mods\No_Blobs\modinfo.json
msgid "Removes all slime blobs from the game."
msgstr "게임에서 모든 슬라임 블럽을 제거합니다."

#: data\mods\No_Cockroaches\modinfo.json
msgid "No Cockroaches"
msgstr "바퀴벌레 없음"

#. ~ Description for No Cockroaches
#: data\mods\No_Cockroaches\modinfo.json
msgid "Removes all cockroach type enemies from the game."
msgstr "게임에서 모든 바퀴벌레류 적을 제거합니다."

#: data\mods\No_Explosive_Zombies\modinfo.json
msgid "No Explosive Zombies"
msgstr "폭발 좀비 제거"

#. ~ Description for No Explosive Zombies
#: data\mods\No_Explosive_Zombies\modinfo.json
msgid "Removes all explosion-based zombies from the game."
msgstr "폭발 기반의 좀비들을 게임에서 모두 제거합니다."

#: data\mods\No_Feral_Humans\modinfo.json
msgid "No Feral Humans"
msgstr "야생 인간 없음"

#. ~ Description for No Feral Humans
#: data\mods\No_Feral_Humans\modinfo.json
msgid "Removes all feral humans from the game."
msgstr "게임에서 모든 야생 인간을 제거합니다."

#: data\mods\No_Fungi\comestibles.json
msgid "marloss wine must"
msgid_plural "marloss wine must"
msgstr[0] "말로스 와인즙"

#: data\mods\No_Fungi\modinfo.json
msgid "No Fungal Monsters"
msgstr "진균 괴물 제거"

#. ~ Description for No Fungal Monsters
#: data\mods\No_Fungi\modinfo.json
msgid "Removes fungal monsters and regions from the game."
msgstr "게임에서 진균 괴물과 진균 지역을 제거합니다."

#: data\mods\No_Global_Uniques\modinfo.json
msgid "No Global Uniques"
msgstr "전역 고유 장소 없음"

#. ~ Description for No Global Uniques
#: data\mods\No_Global_Uniques\modinfo.json
msgid "Makes all special locations no longer globally unique!!"
msgstr "모든 특수 장소가 더 이상 전역적으로 고유하지 않게 합니다!!"

#: data\mods\No_Lift_Requirements\modinfo.json
msgid "No Lifting Reqs"
msgstr "인양 요구 없음"

#. ~ Description for No Lifting Reqs
#: data\mods\No_Lift_Requirements\modinfo.json
msgid ""
"Strength checks and lifting qualities are no longer required for installing "
"or removing vehicle parts."
msgstr "차량 부품 설치/제거에 힘 검사와 인양 특성이 더 이상 필요 없습니다."

#: data\mods\No_NPC_Food\modinfo.json
msgid "Disable NPC Needs"
msgstr "NPC 욕구 제거"

#. ~ Description for Disable NPC Needs
#: data\mods\No_NPC_Food\modinfo.json
msgid "Makes NPCs not require food, water or rest."
msgstr "NPC가 음식, 물, 휴식을 필요로 하지 않습니다."

#: data\mods\No_Rail_Stations\modinfo.json
msgid "No Rail Stations"
msgstr "철도역 없음"

#. ~ Description for No Rail Stations
#: data\mods\No_Rail_Stations\modinfo.json
msgid ""
"Removes above-ground rail stations from the game.  They are supposed to "
"connect to the railroad, but railroads haven't been implemented yet."
msgstr "게임에서 지상 철도역을 제거합니다. 철로와 연결되어야 하지만 철로는 아직 구현되지 않았습니다."

#: data\mods\No_Reviving\modinfo.json
msgid "Prevent Zombie Revivication"
msgstr "좀비 부활 방지"

#. ~ Description for Prevent Zombie Revivication
#: data\mods\No_Reviving\modinfo.json
msgid "Disables zombie revival."
msgstr "좀비가 부활하지 않습니다."

#: data\mods\No_Wasps\modinfo.json
msgid "No Wasps"
msgstr "말벌 없음"

#. ~ Description for No Wasps
#: data\mods\No_Wasps\modinfo.json
msgid "Removes wasps, dermatiks, and their associated maps from the game"
msgstr "말벌, 더마틱과 관련 맵을 게임에서 제거합니다"

#: data\mods\No_Zombify\modinfo.json
msgid "Prevent Zombification"
msgstr "좀비화 방지"

#. ~ Description for Prevent Zombification
#: data\mods\No_Zombify\modinfo.json
msgid "Disables zombification for monsters."
msgstr "몬스터의 좀비화를 비활성화합니다."

#: data\mods\No_encum_backpacks\modinfo.json
msgid "No encumbrance backpacks"
msgstr "방해도 배낭 없음"

#. ~ Description for No encumbrance backpacks
#: data\mods\No_encum_backpacks\modinfo.json
msgid ""
"If you don't want to bother backpacks every fight because it's annoying, "
"this is the mod for you."
msgstr "싸울 때마다 배낭 때문에 신경 쓰이는 게 싫다면, 이 모드가 딱입니다."

#: data\mods\No_encum_backpacks\override.json
msgid "survivor backpack"
msgid_plural "survivor backpacks"
msgstr[0] "생존용 배낭"

#: data\mods\Old_Mutations\modinfo.json
msgid "Old Mutations"
msgstr "구형 돌연변이"

#. ~ Description for Old Mutations
#: data\mods\Old_Mutations\modinfo.json
msgid ""
"Makes mutations work like before, without balancing changes and mutagen "
"accumulation."
msgstr "밸런스 변경과 뮤타젠 누적 없이 돌연변이를 예전처럼 작동하게 합니다."

#: data\mods\Only_Wildlife\modinfo.json
msgid "No Monsters"
msgstr "괴물 제거"

#. ~ Description for No Monsters
#: data\mods\Only_Wildlife\modinfo.json
msgid ""
"Removes all monsters from the game, save for those in the WILDLIFE category."
msgstr "게임에서 야생동물을 제외한 모든 괴물을 제거합니다."

#: data\mods\ProjectSquirrel\modinfo.json
msgid "<color_yellow>Project: Packrat</color>"
msgstr "<color_yellow>프로젝트: 다람쥐</color>"

#. ~ Description for <color_yellow>Project: Packrat</color>
#: data\mods\ProjectSquirrel\modinfo.json
msgid "Endgame high-tech mod. More information is available in README.md."
msgstr "엔드게임 하이테크 모드. 자세한 정보는 README.md를 참조하세요."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "ranger lightweight combat armor"
msgid_plural "ranger lightweight combat armors"
msgstr[0] "레인저 경량 전투 갑옷"

#. ~ Description for {'str': 'ranger lightweight combat armor'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized non-powered lightweight combat armor with excellent defense and "
"mobility, great for dangerous missions. With a distinctive look and feel, "
"this is the dignity of non-powered combat armor for survivors."
msgstr ""
"맞춤형 비동력 경량 전투복입니다. 뛰어난 방어력과 기동성을 갖춘 보호장비로, 위험한 임무를 수행할 때 사용하기 좋습니다. 특색있는 "
"분위기와 디자인으로, 생존자들에게 있어선 비동력 컴뱃 아머의 존엄이라고 할 수 있습니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "Power Actuator"
msgstr "파워 액츄에이터"

#. ~ Description for {'str': 'Power Actuator'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Powerful hydraulic pistons mounted on your combat armor bring your punching "
"power to practical levels. Greatly increases the damage of unarmed attacks."
msgstr ""
"컴뱃 아머에 장착된 강력한 유압 피스톤이 당신의 주먹질을 실용적인 수준으로 끌어올려줍니다. 비무장 공격의 타격 대미지가 크게 상승합니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Warden' heavy combat armor"
msgid_plural "'Warden' heavy combat armors"
msgstr[0] "«워든» 중형 전투 갑옷"

#. ~ Description for {'str': "'Warden' heavy combat armor"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"A customized powered heavy combat suit. It's design was inspired by adapting"
" and scaling down version of DoubleTech's Power Armor in a survivor's style."
" While it has limited protection compared to real power armor, this rugged, "
"clunky look ensures that the armor will work. When used, it activates the "
"arm's powerful motor."
msgstr ""
"맞춤형 동력 중량 전투복입니다. 더블테크사의 강화복을 생존자의 스타일로 어레인지하고 축소하여 만들었습니다. 진짜 강화복에 비하면 제한적인"
" 방호력을 가지고 있지만, 이 견고하고 투박한 만듦새는 아머의 동작을 보증합니다. 사용하면 팔의 강력한 모터를 가동시킵니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Warden' heavy combat armor (on)"
msgid_plural "'Warden' heavy combat armors (on)"
msgstr[0] "«워든» 중형 전투 갑옷 (작동)"

#. ~ Description for {'str': "'Warden' heavy combat armor (on)", 'str_pl':
#. "'Warden' heavy combat armors (on)"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"A customized powered heavy combat suit. It's design was inspired by adapting"
" and scaling down version of DoubleTech's Power Armor in a survivor's style."
" While it has limited protection compared to real power armor, this rugged, "
"clunky look ensures that the armor will work. Use to stop it from "
"functioning."
msgstr ""
"맞춤형 동력 중량 전투복입니다. 더블테크사의 강화복을 생존자의 스타일로 어레인지하고 축소하여 만들었습니다. 진짜 강화복에 비하면 제한적인"
" 방호력을 가지고 있지만, 이 견고하고 투박한 만듦새는 아머의 동작을 보증합니다. 사용하여 작동을 멈춥니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "Circulatory System Manager"
msgstr "순환계 관리 시스템"

#. ~ Description for {'str': 'Circulatory System Manager'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"The combat armor monitors your circulatory and respiratory systems, and "
"absorbs oxygen directly into your skin through artificial muscle fibers. "
"Your maximum stamina is increased, and your stamina regeneration rate "
"increases dramatically."
msgstr ""
"컴뱃 아머가 당신의 순환계와 호흡계를 모니터링하고, 인공근섬유를 통해 산소를 당신의 피부로 직접 흡수시킵니다. 지구력의 최대치가 "
"증가하며, 지구력 재생 속도가 비약적으로 상승합니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Rampart' assault armor"
msgid_plural "'Rampart' assault armors"
msgstr[0] "«램파트» 강습 장갑복"

#. ~ Description for {'str': "'Rampart' assault armor"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized semi-rigid power armor that is internally powered by UPS. "
"Basically built like a human-shaped tank with superalloy plates and layered "
"carbides all over its body, it augments the wearer's strength and protects "
"against most physical threats. When used, it augments defense."
msgstr ""
"UPS로 돌아가는 맞춤형 반경질 강화복입니다. 기본적으로 전신에 초합금판과 겹층 탄화물을 떡칠한 사람 모양의 탱크를 상정하고 "
"제작되었으며, 착용자의 힘을 증강시키고 대부분의 물리적인 위협으로부터 몸을 보호해줍니다. 사용하면 방어력이 증강됩니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Rampart' assault armor (on)"
msgid_plural "'Rampart' assault armors (on)"
msgstr[0] "«램파트» 강습 장갑복 (작동)"

#. ~ Description for {'str': "'Rampart' assault armor (on)", 'str_pl':
#. "'Rampart' assault armors (on)"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized semi-rigid power armor that is internally powered by UPS. "
"Basically built like a human-shaped tank with superalloy plates and layered "
"carbides all over its body, it augments the wearer's strength and protects "
"against most physical threats. It is turned on, and continually draining "
"power.  Use it to turn it off."
msgstr ""
"UPS로 돌아가는 맞춤형 반경질 강화복입니다. 기본적으로 전신에 초합금판과 겹층 탄화물을 떡칠한 사람 모양의 탱크를 상정하고 "
"제작되었으며, 착용자의 힘을 증강시키고 대부분의 물리적인 위협으로부터 몸을 보호해줍니다. 현재 작동 중이며, 지속적으로 전력을 소모하고 "
"있습니다. 사용하여 작동을 멈춥니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Pioneer' environmental carapace"
msgid_plural "'Pioneer' environmental carapaces"
msgstr[0] "«파이어니어» 환경 피갑복"

#. ~ Description for {'str': "'Pioneer' environmental carapace"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized non-rigid power armor that is internally powered by UPS. Built to"
" survive in the worst environments, including cryogenic and hyperthermal "
"regions. It protects you from all kinds of hazards, including psychic "
"attacks and teleportation sickness. It provides X-ray vision for "
"exploration, allowing you to see through terrain. When used, it completely "
"ignores the effects of temperature and allows for a wider range of vision."
msgstr ""
"UPS로 돌아가는 맞춤형 비경질 강화복입니다. 초저온과 초고온 지역을 포함한 최악의 환경에서도 생존할 수 있도록 제작되었으며, 정신공격과"
" 순간이동 멀미를 포함한 모든 종류의 위험으로부터 몸을 지켜줍니다. 탐사를 위한 X-레이 시야를 제공하여 지형지물을 꿰뚫어 볼 수 "
"있습니다. 사용하면 온도의 영향을 완전히 무시하고, 더욱 넓은 범위의 투시가 가능합니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "Transmissive Scanner System"
msgstr "투과성 스캐너 시스템"

#. ~ Description for {'str': 'Transmissive Scanner System'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"The combat armor's scanners and high-performance processor analyze and image"
" the surrounding terrain and show it to you. Your night vision range "
"dramatically increases and you can see through walls."
msgstr ""
"컴뱃 아머의 스캐너와 고성능 프로세서가 주변 지형을 분석하고 이미지화하여 당신에게 보여줍니다. 야간 시야의 범위가 비약적으로 상승하며 "
"벽을 넘어서 볼 수 있습니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Pioneer' environmental carapace (on)"
msgid_plural "'Pioneer' environmental carapaces (on)"
msgstr[0] "«파이어니어» 환경 피갑복 (작동)"

#. ~ Description for {'str': "'Pioneer' environmental carapace (on)",
#. 'str_pl': "'Pioneer' environmental carapaces (on)"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized non-rigid power armor that is internally powered by UPS. Built to"
" survive in the worst environments, including cryogenic and hyperthermal "
"regions. It protects you from all kinds of hazards, including psychic "
"attacks and teleportation sickness. It provides X-ray vision for "
"exploration, allowing you to see through terrain. It is turned on, and "
"continually draining power.  Use it to turn it off."
msgstr ""
"UPS로 돌아가는 맞춤형 비경질 강화복입니다. 초저온과 초고온 지역을 포함한 최악의 환경에서도 생존할 수 있도록 제작되었으며, 정신공격과"
" 순간이동 멀미를 포함한 모든 종류의 위험으로부터 몸을 지켜줍니다. 탐사를 위한 X-레이 시야를 제공하여 지형지물을 꿰뚫어 볼 수 "
"있습니다. 현재 작동 중이며, 지속적으로 전력을 소모하고 있습니다. 사용하여 작동을 멈춥니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "Synaptic Augmented Reflexes"
msgstr "시냅스 증강 반사신경"

#. ~ Description for {'str': 'Synaptic Augmented Reflexes'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"The controls of your combat armor tap into your neural network to boost your"
" motor and reflexes. Dodging becomes easier, and you can now move as if you "
"were on flat ground on ledges, stalls, etc. that are blocking you."
msgstr ""
"컴뱃 아머의 제어장치가 당신의 신경망에 접속하여 운동신경과 반사신경을 상승시킵니다. 회피가 더욱 쉬워지며, 이제 당신을 가로막는 난간이나"
" 가판대 등에서 평지처럼 이동할 수 있습니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Corsair' blitz strike suit"
msgid_plural "'Corsair' blitz strike suits"
msgstr[0] "«콜세어» 기동 타격복"

#. ~ Description for {'str': "'Corsair' blitz strike suit"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized non-rigid power armor that is internally powered by UPS. Built "
"for rapid infiltration and exfiltration, it is equipped with aiming aids and"
" synaptic accelerators to drastically improve the wearer's perception and "
"reaction speed.When used, it grants the wearer an extremely high speed of "
"action for 10 turns, as if time had stopped."
msgstr ""
"UPS로 돌아가는 맞춤형 비경질 강화복입니다. 신속한 침투와 이탈을 위해 제작되었으며, 조준 보조장치와 시냅스 가속기가 탑재되어 착용자의"
" 인지능력과 반응속도를 대폭 개선시킵니다. 사용하면 시간을 멈춘 듯 10턴 동안 행동 속도가 매우 빨라집니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "survivor combat armor"
msgid_plural "survivor combat armors"
msgstr[0] "생존용 전투 갑옷"

#. ~ Description for {'str': 'survivor combat armor'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"A custom-built armor made from a bulletproof vest and a jumpsuit with "
"circuitry inserted into it, designed to internally powered by UPS. Based on "
"the design of the Rivtech RM13 Combat Armor. Some features have been omitted"
" due to difficulty of interpreting technology and for productivity, but it "
"still protects you from the elements as well as from harm. It is turned on, "
"and continually draining power.  Use it to turn it on."
msgstr ""
"UPS로 돌아가게끔 만든, 방탄조끼와 회로가 삽입된 점프슈트를 사용해서 만든 수제 방어구. 재료의 한계와 양산성을 고려하여 일부 기능이 "
"생략되었지만, 여전히 각종 피해로부터 몸을 보호해주는 기본적인 기능이 탑재된 '싼데 비슷한' 방어구입니다. 누군가는 RM13 컴뱃 아머의"
" 디자인을 베꼈다고 할 테지만 아무도 뭐라 할 사람은 없습니다. 사용하면 전원을 켭니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "survivor combat armor (on)"
msgid_plural "survivor combat armors (on)"
msgstr[0] "생존용 전투 갑옷 (작동)"

#. ~ Description for {'str': 'survivor combat armor (on)', 'str_pl': 'survivor
#. combat armors (on)'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"A custom-built armor made from a bulletproof vest and a jumpsuit with "
"circuitry inserted into it, designed to internally powered by UPS. Based on "
"the design of the Rivtech RM13 Combat Armor. Some features have been omitted"
" due to difficulty of interpreting technology and for productivity, but it "
"still protects you from the elements as well as from harm. It is turned on, "
"and continually draining power.  Use it to turn it off."
msgstr ""
"UPS로 돌아가게끔 만든, 방탄조끼와 회로가 삽입된 점프슈트를 사용해서 만든 수제 방어구. 재료의 한계와 양산성을 고려하여 일부 기능이 "
"생략되었지만, 여전히 각종 피해로부터 몸을 보호해주는 기본적인 기능이 탑재된 '싼데 비슷한' 방어구입니다. 누군가는 RM13 컴뱃 아머의"
" 디자인을 베꼈다고 할 테지만 아무도 뭐라 할 사람은 없습니다. 현재 작동 중이며, 지속적으로 전력을 소모하고 있습니다. 사용하여 작동을"
" 멈춥니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "powered suit schematics"
msgid_plural "powered suit schematics"
msgstr[0] "강화복 설계도"

#. ~ Description for {'str_sp': 'powered suit schematics'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Assembly plans, design specs, and technical drawings for the powered suit.  "
"Most of this is useless to you, but you could use the assembly plans to re-"
"assemble the suit from salvaged parts."
msgstr ""
"강화복의 조립 계획도, 설계 사양, 기술 도면. 이 중 대부분은 당신에게 쓸모가 없지만, 조립 계획도는 당신이 부품들을 재활용하는데 "
"사용할 수 있을 것입니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "Integrated Combat System"
msgstr "통합 전투 체계"

#. ~ Description for {'str': 'Integrated Combat System'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"The nano-foam structure of the combat armor's endothelium aids in the body's"
" recovery from damage. Your speed to recover from pain and perceptive "
"abilities will increase dramatically while wearing it."
msgstr ""
"컴뱃 아머 내피의 나노 폼 구조물이 손상된 신체의 회복을 돕습니다. 입고 있는 동안 고통에서 벗어나는 속도와 인지 능력이 비약적으로 "
"상승합니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Legion' powered suit"
msgid_plural "'Legion' powered suits"
msgstr[0] "«레기온» 강화복"

#. ~ Use action holster_msg for {'str': "'Legion' powered suit"}.
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
#: src/iuse_actor.cpp
msgid "You holster your %s"
msgstr "%s을(를) 집어넣었다"

#. ~ Use action holster_prompt for {'str': "'Legion' powered suit"}.
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "Integrated weapon storage container"
msgstr "통합 무장 수납 컨테이너"

#. ~ Description for {'str': "'Legion' powered suit"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized military grade non-rigid power armor that is internally powered "
"by UPS. It's a trifecta of mobility, durability, and lethality. With a "
"built-in energy weapon generation system and six expansion weapon slots, the"
" ST-301 'Legion' is the combat armor for the next generation of super "
"soldiers. When used, it generates a plasma impact grenade in the form of a "
"combat knife."
msgstr ""
"UPS로 돌아가는 맞춤형 군용 비경질 강화복입니다. 기동성과 내구성, 그리고 치명성이 삼박자를 이루고 있습니다. 내장형 에너지 무기 생성"
" 체계, 6개의 확장 무기슬롯을 포함한 ST-301 '리전'은 차세대 슈퍼 솔저를 위한 컴뱃 아머입니다. 사용하면 컴뱃 나이프 형태의 "
"플라즈마 충격 수류탄을 생성합니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "assassin suit schematics"
msgid_plural "assassin suit schematics"
msgstr[0] "암살자 슈트 설계도"

#. ~ Description for {'str_sp': 'assassin suit schematics'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Assembly plans, design specs, and technical drawings for the assassin suit."
"  Most of this is useless to you, but you could use the assembly plans to "
"re-assemble the suit from salvaged parts."
msgstr ""
"암살 잠입복의 조립 계획도, 설계 사양, 기술 도면. 이 중 대부분은 당신에게 쓸모가 없지만, 조립 계획도는 당신이 부품들을 재활용하는데"
" 사용할 수 있을 것입니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "Active Camouflage System"
msgstr "능동 위장 체계"

#. ~ Description for {'str': 'Active Camouflage System'}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"The combat armor is equipped with a fluid armor structure using liquefied "
"smart metal, a noise-canceling system, and a breathing filter. The wearer's "
"range of recognition is reduced by 40%, and footsteps and body odor are also"
" masked, providing complete stealth when using the Invisibility feature. "
"Additionally, the extra liquefied metal in the armor can form blades to "
"amplify unarmed damage."
msgstr ""
"컴뱃 아머에 액화 스마트 금속을 이용한 유동적인 장갑 구조와 노이즈 캔슬링 시스템, 그리고 호흡 필터가 장착되었습니다. 착용자를 인식할 "
"수 있는 범위가 40% 감소하며, 발소리와 체취 또한 은폐되어 투명화 기능 사용시 완전한 은신 기능을 제공합니다. 또한, 아머 내 여분의"
" 액화금속이 칼날을 형성하여 비무장 피해를 증폭시킬 수 있습니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Revenant' assassination infiltration suit"
msgid_plural "'Revenant' assassination infiltration suits"
msgstr[0] "«레버넌트» 암살 침투복"

#. ~ Description for {'str': "'Revenant' assassination infiltration suit"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized military grade flexible power armor that is internally powered by"
" UPS. Equipped with active optical cloaking using refraction of a liquid "
"smart metal that bonds with the user, Latitude Industries' R34-P 'Revenant' "
"Assassination Infiltration Suit was used in small numbers to assassinate "
"enemy nationals in the event of a nuclear war between the United States and "
"China. It cancels footsteps and body odor when worn, and turns on stealth "
"mode when used."
msgstr ""
"UPS로 돌아가는 맞춤형 군용 비경질 강화복입니다. 사용자와 결합하는 액화 스마트 금속의 굴절을 이용한 능동 광학 미채를 탑재한 래티튜드"
" 인더스트리의 R34-P '레버넌트' 암살 잠입복은 미국과 중국간의 핵전쟁이 발발하였을 때 적국의 요인 암살 작전에 소수 투입되었습니다."
" 착용시 발소리와 체취를 없애주고, 사용하면 은신 모드를 켭니다."

#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid "'Revenant' assassination infiltration suit (on)"
msgid_plural "'Revenant' assassination infiltration suits (on)"
msgstr[0] "«레버넌트» 암살 침투복 (작동)"

#. ~ Description for {'str': "'Revenant' assassination infiltration suit
#. (on)", 'str_pl': "'Revenant' assassination infiltration suits (on)"}
#: data\mods\ProjectSquirrel\items\advtech\sq_advanced_armor.json
msgid ""
"Customized military grade flexible power armor that is internally powered by"
" UPS. Equipped with active optical cloaking using refraction of a liquid "
"smart metal that bonds with the user, Latitude Industries' R34-P 'Revenant' "
"Assassination Infiltration Suit was used in small numbers to assassinate "
"enemy nationals in the event of a nuclear war between the United States and "
"China. It is turned on, and continually draining power.  Use it to turn it "
"off."
msgstr ""
"UPS로 돌아가는 맞춤형 군용 비경질 강화복입니다. 사용자와 결합하는 액화 스마트 금속의 굴절을 이용한 능동 광학 미채를 탑재한 래티튜드"
" 인더스트리의 R34-P '레버넌트' 암살 잠입복은 미국과 중국간의 핵전쟁이 발발하였을 때 적국의 요인 암살 작전에 소수 투입되었습니다."
" 현재 작동 중이며, 지속적으로 전력을 소모하고 있습니다. 사용하여 작동을 멈춥니다."

