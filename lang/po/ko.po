#: data\mods\innawoods\modinfo.json
msgid "innawoods"
msgstr "이나우즈"

#. ~ Description for innawoods
#: data\mods\innawoods\modinfo.json
msgid ""
"This mod removes all urban locations and lets you live in the woods.  "
"Remember to set `CITY_SIZE` = 0"
msgstr "이 모드는 모든 도시 장소를 제거하고 숲에서 살게 합니다. `CITY_SIZE` = 0으로 설정하는 것을 잊지 마세요"

#: data\mods\lethal_zeds\modinfo.json
msgid "<color_red>Lethal Zombies</color>"
msgstr "<color_red>치명적 좀비</color>"

#. ~ Description for <color_red>Lethal Zombies</color>
#: data\mods\lethal_zeds\modinfo.json
msgid "For an uncompromising and brutal experience."
msgstr "타협 없고 잔혹한 경험을 위하여."

#: data\mods\lua_ai_attitude_debug\item_action.json
msgid "Run Lua AI debug helper"
msgstr "Lua AI 디버그 도우미 실행"

#: data\mods\lua_ai_attitude_debug\item_action.json
msgid "Set Lua AI debug drone mode"
msgstr "Lua AI 디버그 드론 모드 설정"

#: data\mods\lua_ai_attitude_debug\items.json
msgid "Lua AI debug remote"
msgid_plural "Lua AI debug remotes"
msgstr[0] "Lua AI 디버그 리모컨"

#. ~ Description for {'str': 'Lua AI debug remote'}
#: data\mods\lua_ai_attitude_debug\items.json
msgid ""
"A throwaway remote that spawns the Lua debug drone and cycles its attitude "
"modes for quick testing."
msgstr "Lua 디버그 드론을 소환하고 태도 모드를 순환해 빠르게 테스트하는 일회용 리모컨입니다."

#: data\mods\lua_ai_attitude_debug\items.json
msgid "Lua AI debug selector"
msgid_plural "Lua AI debug selectors"
msgstr[0] "Lua AI 디버그 선택기"

#. ~ Description for {'str': 'Lua AI debug selector'}
#: data\mods\lua_ai_attitude_debug\items.json
msgid ""
"Cycles the debug drone behavior mode and applies it to nearby Lua debug "
"drones."
msgstr "디버그 드론 행동 모드를 순환하고 근처 Lua 디버그 드론에 적용합니다."

#: data\mods\lua_ai_attitude_debug\modinfo.json
msgid "Lua AI Examples"
msgstr "Lua AI 예제"

#. ~ Description for Lua AI Examples
#: data\mods\lua_ai_attitude_debug\modinfo.json
msgid ""
"Demonstrates lua_ai and lua_attitude bindings with a controllable debug "
"monster and Lua item action."
msgstr "제어 가능한 디버그 몬스터와 Lua 아이템 액션으로 lua_ai와 lua_attitude 바인딩을 시연합니다."

#: data\mods\lua_ai_attitude_debug\monsters.json
msgid "Lua debug drone"
msgid_plural "Lua debug drones"
msgstr[0] "Lua 디버그 드론"

#. ~ Description for {'str': 'Lua debug drone'}
#: data\mods\lua_ai_attitude_debug\monsters.json
msgid ""
"A harmless reference monster for testing lua_ai and lua_attitude. Spawn it "
"from debug or the Lua AI remote to watch it react."
msgstr ""
"lua_ai와 lua_attitude를 테스트하기 위한 무해한 참조 몬스터입니다. 디버그나 Lua AI 리모컨으로 소환해 반응을 "
"지켜보세요."

#: data\mods\lua_ai_attitude_debug\monsters.json
msgid "Lua dance bot"
msgid_plural "Lua dance bots"
msgstr[0] "Lua 댄스 봇"

#. ~ Description for {'str': 'Lua dance bot'}
#: data\mods\lua_ai_attitude_debug\monsters.json
msgid ""
"A cheerful example creature whose lua_ai makes it dance in a square around "
"its anchor point until it gets hit, then it drops into normal hostile AI."
msgstr "lua_ai가 앵커 지점 주위를 사각형으로 춤추게 하는 명랑한 예제 생물입니다. 맞으면 일반 적대 AI로 돌아갑니다."

#: data\mods\makeshift\item.json
msgid "makeshift kevlar vest"
msgid_plural "makeshift kevlar vests"
msgstr[0] "수제 케블라 조끼"

#. ~ Description for makeshift kevlar vest
#: data\mods\makeshift\item.json
msgid ""
"A vest sewn together from Kevlar plates, less durable and protective than a "
"proper Kevlar vest.  Suitable for wearing under clothing."
msgstr "조끼를 케블라판과 같이 재봉한 것. 시판 케블라 조끼보다 내구성과 보호력이 떨어집니다. 옷 안에 입기에 적합합니다."

#: data\mods\makeshift\item.json
msgid "makeshift pistol bayonet"
msgid_plural "makeshift pistol bayonets"
msgstr[0] "급조 권총용 총검"

#: data\mods\makeshift\item.json
msgid ""
"A makeshift version of a bayonet meant for a pistol that consists of a mere "
"spike with some string.  It still makes a decent melee weapon in a pinch "
"when attached to a pistol."
msgstr "단순한 고철 침을 끈으로 고정시켜서 만든 급조 총검. 권총에 부착하면 위기상황에서 쓸 만한 근접 무기로 사용할 수 있습니다."

#: data\mods\makeshift\item.json
msgid "makeshift sword bayonet"
msgid_plural "makeshift sword bayonets"
msgstr[0] "간이 대형 총검"

#: data\mods\makeshift\item.json
msgid ""
"A makeshift version of a sword bayonet that consists of a salvaged blade "
"with some string.  It still makes a good melee weapon providing reach "
"attacks when attached to long arm or crossbow."
msgstr "쓸 만한 칼날을 끈을 약간 사용해 만든 간이 대형 총검. 긴 화기나 쇠뇌에 부착하면 괜찮은 근접무기가 됩니다."

#: data\mods\makeshift\modinfo.json
msgid "Makeshift Items Mod"
msgstr "수제작 아이템 모드"

#. ~ Description for Makeshift Items Mod
#: data\mods\makeshift\modinfo.json
msgid "Adds more improvised item variants and rebalances existing ones."
msgstr "급조한 아이템을 추가하고 기존의 아이템의 밸런스를 재조정합니다."

#: data\mods\modern_weapon\modinfo.json
msgid "Modern Weapons Pack (Expanded)"
msgstr "현대 무기 팩 (확장)"

#. ~ Description for Modern Weapons Pack (Expanded)
#: data\mods\modern_weapon\modinfo.json
msgid "현대 총기 다수를 추가합니다. (BN 이관: 신규 총기만, 겹치는 항목은 BN 유지)"
msgstr "현대 총기 다수를 추가합니다. (BN 이관: 신규 총기만, 겹치는 항목은 BN 유지)"

#: data\mods\modern_weapon\modern_ammo\modern_ammo.json
msgid ".30-30 Winchester"
msgid_plural ".30-30 Winchester"
msgstr[0] ".30-30 윈체스터"

#. ~ Description for {'str_sp': '.30-30 Winchester'}
#: data\mods\modern_weapon\modern_ammo\modern_ammo.json
msgid ""
"30-06구경 탄보다 반동이 적은 탄환으로 30-30구경 윈체스터는 사냥꾼들에게 사슴, 흑곰, 심지어는 무스까지 사냥할수있는 탄으로 "
"유명합니다. 150 그레인의 둥근 코 모양의 카트리지는 레버 액션 소총의 탄창에 들어가기에 아주 알맞게 되어있습니다."
msgstr ""
"30-06구경 탄보다 반동이 적은 탄환으로 30-30구경 윈체스터는 사냥꾼들에게 사슴, 흑곰, 심지어는 무스까지 사냥할 수 있는 탄으로 "
"유명합니다. 150 그레인의 둥근 코 모양의 카트리지는 레버 액션 소총의 탄창에 들어가기에 아주 알맞게 되어 있습니다."

#: data\mods\modern_weapon\modern_ammo\modern_ammo.json
msgid ".30-30 Winchester (재생)"
msgid_plural ".30-30 Winchester (재생)"
msgstr[0] ".30-30 Winchester (재생)"

#. ~ Description for {'str_sp': '.30-30 Winchester (재생)'}
#: data\mods\modern_weapon\modern_ammo\modern_ammo.json
msgid ""
"30-06구경 탄보다 반동이 적은 탄환으로 30-30구경 윈체스터는 사냥꾼들에게 사슴, 흑곰, 심지어는 무스까지 사냥할수있는 탄으로 "
"유명합니다. 150그레인의 둥근 코 모양의 카트리지는 레버 액션 소총의 탄창에 들어가기에 아주 알맞게 되어있습니다. 이것은 재생탄입니다."
msgstr ""
"30-06구경 탄보다 반동이 적은 탄환으로 30-30구경 윈체스터는 사냥꾼들에게 사슴, 흑곰, 심지어는 무스까지 사냥할 수 있는 탄으로 "
