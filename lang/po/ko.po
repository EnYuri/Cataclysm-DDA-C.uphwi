#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "싸움꾼"
msgid_plural "싸움꾼s"
msgstr[0] "싸움꾼"

#. ~ Description for 싸움꾼
#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "간단한 근접무기로 무장한 탈옥한 죄수입니다. 머리통 부수는 솜씨가 나쁘진 않아 보이네요."
msgstr "간단한 근접무기로 무장한 탈옥한 죄수입니다. 머리통 부수는 솜씨가 나쁘진 않아 보이네요."

#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "전투광"
msgid_plural "전투광s"
msgstr[0] "전투광"

#. ~ Description for 전투광
#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid ""
"세기말 전에도 꽤나 잘 싸우던 탈옥한 죄수입니다. 세상이 무너져서 잡혀갈 일도 없어지니까 괴물과 사람상대로 마음껏 솜씨를 뽐내고 다니는데"
" 참 보기 좋습니다."
msgstr ""
"세기말 전에도 꽤나 잘 싸우던 탈옥한 죄수입니다. 세상이 무너져서 잡혀갈 일도 없어지니까 괴물과 사람 상대로 마음껏 솜씨를 뽐내고 "
"다니는데 참 보기 좋습니다."

#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "사이코"
msgid_plural "사이코s"
msgstr[0] "사이코"

#. ~ Description for 사이코
#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "마약에 찌든 미치광이입니다. 상처 입는 것조차 두려워하지 않고 짐승처럼 달려듭니다."
msgstr "마약에 찌든 미치광이입니다. 상처 입는 것조차 두려워하지 않고 짐승처럼 달려듭니다."

#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "창잡이"
msgid_plural "창잡이s"
msgstr[0] "창잡이"

#. ~ Description for 창잡이
#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "검을 휘두르는 것보단 창으로 멀리서 찌르는 게 더 낫다고 생각한 약탈자입니다. 간단한 방패로 공격을 막고 창을 휘두릅니다."
msgstr "검을 휘두르는 것보단 창으로 멀리서 찌르는 게 더 낫다고 생각한 약탈자입니다. 간단한 방패로 공격을 막고 창을 휘두릅니다."

#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "돌팔이"
msgid_plural "돌팔이s"
msgstr[0] "돌팔이"

#. ~ Description for 돌팔이
#: data\mods\ADD_BANDITS+\bandits_plu.json
msgid "마스크를 뒤집어쓰고 전기톱을 휘두르는 이 덩치 큰 미치광이는 괴물들과 다른 이들을 “치료” 해주기위해 열정적으로 움직입니다."
msgstr ""
"마스크를 뒤집어쓰고 전기톱을 휘두르는 이 덩치 큰 미치광이는 괴물들과 다른 이들을 “치료” 해주기 위해 열정적으로 움직입니다."

