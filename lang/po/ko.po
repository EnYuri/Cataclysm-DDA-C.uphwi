#: data\mods\Battle_Maid_Bell\snippets.json
msgid "머리 위에…요? 저, 괜찮으신가요!?"
msgstr "머리 위에…요? 저, 괜찮으신가요!?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "헤헤♪ 이제 한몸이라는 거네요!"
msgstr "헤헤♪ 이제 한몸이라는 거네요!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "여기가 낙원이네요! 틀림없어요!"
msgstr "여기가 낙원이네요! 틀림없어요!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "파일더 온!...파일더?"
msgstr "파일더 온!...파일더?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "오늘은 테케리·리 해도 되는 건가요!?"
msgstr "오늘은 테케리·리 해도 되는 건가요!?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "아아~ 주인님의 냄새가 나요~ 행복해~"
msgstr "아아~ 주인님의 냄새가 나요~ 행복해~"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "조금만 더 같이 있고 싶었는데~ 라고 생각했어요♪"
msgstr "조금만 더 같이 있고 싶었는데~라고 생각했어요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "음~ 아쉽지만 어쩔 수 없네요"
msgstr "음~ 아쉽지만 어쩔 수 없네요"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "괜찮으시면 또 태워 주세요♪"
msgstr "괜찮으시면 또 태워 주세요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "목이 아프…다구요? 저 그렇게 무겁지 않아요!!"
msgstr "목이 아프…다구요? 저 그렇게 무겁지 않아요!!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "테케리~♪ 테케리~♪"
msgstr "테케리~♪ 테케리~♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님! 여기서 테케리·리 해도 될까요!?"
msgstr "주인님! 여기서 테케리·리 해도 될까요!?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "평소랑 다른 풍경을 볼 수 있는 것도 신선하네요♪"
msgstr "평소랑 다른 풍경을 볼 수 있는 것도 신선하네요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "테케리 테케리·리 테케리·리·리~♪"
msgstr "테케리 테케리·리 테케리·리·리~♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "테케리·리!"
msgstr "테케리·리!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "테케리·리! 테케리·리!"
msgstr "테케리·리! 테케리·리!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "테케리·리?"
msgstr "테케리·리?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "테케리 테케리·리 테케리·리~♪ 기분이 좋아지면 저절로 흥얼거리게 돼요"
msgstr "테케리 테케리·리 테케리·리~♪ 기분이 좋아지면 저절로 흥얼거리게 돼요"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님! 저, 저는 주인님을...테케리·리!...꺄ー♪ 말해버렸다♪"
msgstr "주인님! 저, 저는 주인님을...테케리·리!...꺄ー♪ 말해버렸다♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "저는 메이드♪ 당신의 메이드♪ 청소, 세탁, 요리... 다음은 뭐였더라?"
msgstr "저는 메이드♪ 당신의 메이드♪ 청소, 세탁, 요리... 다음은 뭐였더라?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님이 원하시면 얼마든지 계속 말할게요! 원치 않으셔도 계속 말할게요!"
msgstr "주인님이 원하시면 얼마든지 계속 말할게요! 원치 않으셔도 계속 말할게요!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님이 원하시면 얼마든지 낳을게요♪"
msgstr "주인님이 원하시면 얼마든지 낳을게요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님 주인님! 벽으로 몰린 미=고 놀이를 하면서 같이 놀지 않을래요?"
msgstr "주인님 주인님! 벽으로 몰린 미=고 놀이를 하면서 같이 놀지 않을래요?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "미=고를 조금씩 몰아붙이는 그 감각...중독돼버려요･･･♪"
msgstr "미=고를 조금씩 몰아붙이는 그 감각...중독돼버려요･･･♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "이 모습이 봉사 종족으로서 가장 적합한 인간 형태라고 배웠어요! 어때요? 음욕이 솟지 않나요?"
msgstr "이 모습이 봉사 종족으로서 가장 적합한 인간 형태라고 배웠어요! 어때요? 음욕이 솟지 않나요?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid ""
"블롭, 트리피드, 펑갈...인류가 맞서기엔 너무 어려운 적들이에요. 그래서...녀석들에 맞서 저와 아이를 만들어봅시다♪ 우선 가볍게 "
"1000명 정도!"
msgstr ""
"블럽, 트리피드, 펑갈...인류가 맞서기엔 너무 어려운 적들이에요. 그래서...녀석들에 맞서 저와 아이를 만들어봅시다♪ 우선 가볍게 "
"1000명 정도!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님은 제게 처음의 죽음을 주셨어요. 다른 처음도 잔뜩 주세요"
msgstr "주인님은 제게 처음의 죽음을 주셨어요. 다른 처음도 잔뜩 주세요"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "안심하세요, 안 입었어요♪"
msgstr "안심하세요, 안 입었어요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid ""
"과거는 바꿀 수 없어요. 미래는 어둠일지도 몰라요. 하지만 주인님에겐 제가 있어요. 제겐 주인님이 있어요. 그러니 부디...슬픈 얼굴 "
"하지 말아 주세요"
msgstr ""
"과거는 바꿀 수 없어요. 미래는 어둠일지도 몰라요. 하지만 주인님에겐 제가 있어요. 제겐 주인님이 있어요. 그러니 부디...슬픈 얼굴 "
"하지 말아 주세요"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님께 해를 끼치는 분은 민치민치! 예요♪"
msgstr "주인님께 해를 끼치는 분은 민치민치! 예요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "어쩌고저쩌고, 인가요? 이아이아 크툴루, 라는 거군요"
msgstr "어쩌고저쩌고, 인가요? 이아이아 크툴루,라는 거군요"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님은 로리콘인가요? 아니면 가슴인가요? 말해주시면 주인님의 취향에 맞출게요!"
msgstr "주인님은 로리콘인가요? 아니면 가슴인가요? 말해주시면 주인님의 취향에 맞출게요!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "제 몸으로 가구나 음식도 만들 수 있어요! 어때요?...필요 없나요? 그렇군요, 아쉽네요..."
msgstr "제 몸으로 가구나 음식도 만들 수 있어요! 어때요?...필요 없나요? 그렇군요, 아쉽네요..."

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "꿈은 크게 아담과 이브예요! 주인님과 제 아이들로 인류를 재건해요!"
msgstr "꿈은 크게 아담과 이브예요! 주인님과 제 아이들로 인류를 재건해요!"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "목욕이 필요하시면 말씀해 주세요. 제가 감싸서 땀도 때도 냄새의 원인까지 전부 깨끗하게 해드릴게요♪"
msgstr "목욕이 필요하시면 말씀해 주세요. 제가 감싸서 땀도 때도 냄새의 원인까지 전부 깨끗하게 해드릴게요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid ""
"주인님은 알비노 펭귄들을 본 적 있나요? 얌전하지만 동료 의식이 강한 애들이라 너무 괴롭히면 안 돼요!...고기는 맛있긴 하지만요"
msgstr ""
"주인님은 알비노 펭귄들을 본 적 있나요? 얌전하지만 동료 의식이 강한 애들이라 너무 괴롭히면 안 돼요!...고기는 맛있긴 하지만요"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "너무 일만 시키면 삐쳐버릴 테니까요! 그러니까 가끔은 포상으로 저와 데이트를..."
msgstr "너무 일만 시키면 삐쳐버릴 테니까요! 그러니까 가끔은 포상으로 저와 데이트를..."

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "다 쓴 옷은 저에게 주세요. 말끔하게 깨끗이 해드릴게요♪"
msgstr "다 쓴 옷은 저에게 주세요. 말끔하게 깨끗이 해드릴게요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid ""
"쇼고스를 죽이고도 괜찮아요? 농담이에요♪ 아, 저는 죽어도 부활하니까 괜찮아요. 분자 수준으로 산산조각 나면 어렵지만...그러니까, "
"죽어도 안 떨어질 거예요, 주인님♪"
msgstr ""
"쇼고스를 죽이고도 괜찮아요? 농담이에요♪ 아, 저는 죽어도 부활하니까 괜찮아요. 분자 수준으로 산산조각 나면 어렵지만...그러니까, "
"죽어도 안 떨어질 거예요, 주인님♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "쇼고스여도 사랑해 주실 건가요? 아, 저는 종족 차이 같은 건 전혀 신경 안 써요! 주인님이라면 언제든 웰컴이에요♪"
msgstr "쇼고스여도 사랑해 주실 건가요? 아, 저는 종족 차이 같은 건 전혀 신경 안 써요! 주인님이라면 언제든 웰컴이에요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "처음 주인님을 뵀을 때, 이분을 따라갈 수밖에 없다고 생각했어요. 설마 이게 첫눈에 반한 거라는 걸까요!?"
msgstr "처음 주인님을 뵀을 때, 이분을 따라갈 수밖에 없다고 생각했어요. 설마 이게 첫눈에 반한 거라는 걸까요!?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "헤헤~♪ 주인님~♪ 테케리~♪"
msgstr "헤헤~♪ 주인님~♪ 테케리~♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "제 종족은 반항적인 애가 꽤 많거든요. 하지만 저는 주인님의 사랑의 노예니까 걱정 안 하셔도 돼요♪"
msgstr "제 종족은 반항적인 애가 꽤 많거든요. 하지만 저는 주인님의 사랑의 노예니까 걱정 안 하셔도 돼요♪"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "사모하고 있습니다, 주인님♪...먹어버리고 싶을 정도로"
msgstr "사모하고 있습니다, 주인님♪...먹어버리고 싶을 정도로"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid "주인님ー, 바람피우면 안 돼요ー? 만약 바람피우면 테케리예요ー?"
msgstr "주인님ー, 바람피우면 안 돼요ー? 만약 바람피우면 테케리예요ー?"

#: data\mods\Battle_Maid_Bell\snippets.json
msgid ""
"인간 모습이 되어서 좋았던 점, 인가요? 이렇게 주인님과 이야기할 수 있는 것과 주인님과 손잡고 걸을 수 있는 것과 주인님의 아이를 품을"
" 수 있는 몸이 된 것과, 그리고 또 그리고...아무튼 잔뜩이에요!"
msgstr ""
