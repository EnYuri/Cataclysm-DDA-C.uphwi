#: data\mods\cuphwi_firearms\gunmods.json
#: data\mods\exotic_ammo\items\gunmod\barrel.json
msgid "barrel"
msgstr "총열"

#: data\json\items\gunmod\barrel.json
msgid "upstest"
msgid_plural "upstests"
msgstr[0] "UPS 시험용"

#: data\json\items\gunmod\barrel.json
msgid ""
"Testmod for UPS drain on mods, this should never spawn, if you see this, "
"it's a bug.  50x more UPS drain."
msgstr "모드 UPS 소모 테스트용 모드 아이템으로, 스폰되어선 안 됩니다. 보이면 버그입니다. 50배 더 많은 UPS 소모."

#: data\json\items\gunmod\barrel.json
msgid "makeshift rifle accelerator"
msgid_plural "makeshift rifle accelerators"
msgstr[0] "임시 소총 가속기"

#: data\json\items\gunmod\barrel.json
msgid ""
"Advents in power transfer technology has resulted in coilguns becoming much "
"more viable.  Makeshift coilgun conversions like this one were a rare but "
"known sight in the riots before the Cataclysm, and it may help you survive "
"it.  This particular attachment is designed for long-barreled guns."
msgstr ""
"전력 전달 기술의 발전으로 코일건이 훨씬 실용적이 됐습니다. 이 같은 임시 코일건 개조는 대재앙 전 폭동에서 드물지만 알려진 광경이었고,"
" 생존에 도움이 될 수도 있습니다. 이 부착물은 긴 총열 총용입니다."

#: data\json\items\gunmod\barrel.json
msgid "makeshift pistol accelerator"
msgid_plural "makeshift pistol accelerators"
msgstr[0] "임시 권총 가속기"

#: data\json\items\gunmod\barrel.json
msgid ""
"Advents in power transfer technology has resulted in coilguns becoming much "
"more viable.  Makeshift coilgun conversions like this one were a rare but "
"known sight in the riots before the Cataclysm, and it may help you survive "
"it.  This particular attachment is designed for short-barreled guns."
msgstr ""
"전력 전달 기술의 발전으로 코일건이 훨씬 실용적이 됐습니다. 이 같은 임시 코일건 개조는 대재앙 전 폭동에서 드물지만 알려진 광경이었고,"
" 생존에 도움이 될 수도 있습니다. 이 부착물은 짧은 총열 총용입니다."

#: data\json\items\gunmod\barrel.json
msgid "aux flamethrower"
msgid_plural "aux flamethrowers"
msgstr[0] "부착형 화염방사기"

#: data\json\items\gunmod\barrel.json
msgid ""
"This custom-built miniature flamethrower is made to be attached to most "
"firearms, greatly expanding its lethality."
msgstr "대부분의 화기에 부착하도록 만들어져 치명성을 크게 확장하는 맞춤 제작 소형 화염방사기입니다."

#: data\json\items\gunmod\barrel.json data\json\items\gunmod\bionicmods.json
