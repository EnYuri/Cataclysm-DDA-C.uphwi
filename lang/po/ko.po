#: data\mods\DinoMod\monster_attacks.json
msgid "%s swings its tail at <npcname>, but they appear unharmed."
msgstr "%s이(가) 꼬리를 <npcname>에게 휘두르지만 다치지 않은 듯합니다."

#: data\mods\DinoMod\monster_attacks.json
msgid "%1$s swings its spiked tail at your %2$s, smashing it!"
msgstr "%1$s이(가) 가시 꼬리를 휘둘러 당신의 %2$s을(를) 부숩니다!"

#: data\mods\DinoMod\monster_attacks.json
msgid "%1$s swings its spiked tail at <npcname>'s %2$s!"
msgstr "%1$s이(가) 가시 꼬리를 휘둘러 <npcname>의 %2$s을(를) 부숩니다!"

#: data\mods\DinoMod\monster_attacks.json
msgid "%s swings its spiked tail at you, but it's blunted by your armor."
msgstr "%s이(가) 가시 꼬리를 휘두르지만 갑옷에 막혔습니다."

#: data\mods\DinoMod\monster_attacks.json
msgid "%s swings its spiked tail at <npcname>, but they appear unharmed."
msgstr "%s이(가) 가시 꼬리를 <npcname>에게 휘두르지만 다치지 않은 듯합니다."

#: data\mods\DinoMod\monster_attacks.json
