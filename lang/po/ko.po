#: data\json\items\armor\bandolier.json data\json\items\armor\sheath.json
msgid "Sheath tool"
msgstr "도구 넣기"

#. ~ Description for {'str': 'throwing knife bandolier'}
#: data\json\items\armor\bandolier.json
msgid ""
"A bandolier worn across the chest with small leather loops sewn on.  Able to"
" hold up to twelve small knives or similar tools, whether throwing knives, "
"shurikens, or other small items.  Activate to sheath or draw a tool."
msgstr ""
"작은 가죽 고리를 꿰맨, 가슴에 차는 밴돌리어입니다. 투척용 나이프, 수리검, 다른 작은 물건 등 최대 12개의 작은 칼이나 유사 도구를"
" 넣을 수 있습니다. 활성화해 도구를 넣거나 뽑습니다."

#: data\json\items\armor\bedding.json
#: data\mods\ProjectSquirrel\items\item_common\sq_armor_override.json
msgid "sheet"
msgid_plural "sheets"
msgstr[0] "시트"

#. ~ Description for {'str': 'sheet'}
#: data\json\items\armor\bedding.json
msgid ""
"A large fabric sheet, could be used as a curtain or bedsheets; or cut up for"
" a bunch of rags."
msgstr "큰 섬유 시트. 커튼이나 침대 시트로 사용되며, 잘라서 천 조각을 만들 수도 있습니다."

#: data\json\items\armor\bedding.json
#: data\mods\ProjectSquirrel\items\item_common\sq_armor_override.json
msgid "blanket"
msgid_plural "blankets"
msgstr[0] "담요"

#. ~ Description for {'str': 'blanket'}
#: data\json\items\armor\bedding.json
msgid "Hiding under here will not protect you from the monsters."
msgstr "담요 밑에 숨는다고 괴물들에게서 안전해지는 것은 아닙니다."

#: data\json\items\armor\bedding.json
#: data\mods\ProjectSquirrel\items\item_common\sq_armor_override.json
msgid "down-filled blanket"
msgid_plural "down-filled blankets"
msgstr[0] "솜털 담요"

#. ~ Description for {'str': 'down-filled blanket'}
#: data\json\items\armor\bedding.json
msgid ""
"Hiding under here will not protect you from the monsters, but it'll keep you"
" warm."
msgstr "담요 밑에 숨는다고 괴물들에게서 안전해지는 것은 아닙니다만, 담요는 온기를 유지할 수 있게 해줍니다."

#: data\json\items\armor\bedding.json
#: data\mods\ProjectSquirrel\items\item_common\sq_armor_override.json
msgid "fur blanket"
msgid_plural "fur blankets"
msgstr[0] "모피 담요"

#. ~ Description for {'str': 'fur blanket'}
#: data\json\items\armor\bedding.json
msgid "A heavy fur blanket that covers most of your body."
msgstr "몸 대부분을 덮을 수 있는 무거운 털 담요."

#: data\json\items\armor\bedding.json
#: data\mods\ProjectSquirrel\items\item_common\sq_armor_override.json
msgid "quilt"
msgid_plural "quilts"
msgstr[0] "이불"

#. ~ Description for quilt
#: data\json\items\armor\bedding.json
msgid ""
"A big, comfy quilt made of thick wool in a triangle pattern.  Extremely "
"cozy!"
msgstr "삼각 패턴의 두꺼운 양모로 만든 크고 편한 이불입니다. 극도로 아늑합니다!"

#: data\json\items\armor\bedding.json
#: data\mods\ProjectSquirrel\items\item_common\sq_armor_override.json
msgid "patchwork quilt"
msgid_plural "patchwork quilts"
msgstr[0] "패치워크 이불"

#. ~ Description for patchwork quilt
#: data\json\items\armor\bedding.json
msgid "A huge, patchwork wool quilt.  Very, very warm."
msgstr "거대한 패치워크 양모 이불입니다. 매우, 매우 따뜻합니다."

#: data\json\items\armor\bedding.json
#: data\mods\ProjectSquirrel\items\item_common\sq_armor_override.json
msgid "sleeping bag"
msgid_plural "sleeping bags"
msgstr[0] "침낭"

#. ~ Use action menu_text for {'str': 'sleeping bag'}.
#. ~ Use action menu_text for {'str': 'fur sleeping bag'}.
#: data\json\items\armor\bedding.json data\json\items\armor\misc.json
msgid "Roll up"
msgstr "말아 올리다"

#. ~ Use action msg for {'str': 'sleeping bag'}.
#: data\json\items\armor\bedding.json
msgid "You roll up the sleeping bag, preparing it for transport."
msgstr "당신은 침낭을 옮길 수 있도록 말아 올린다."

#. ~ Description for {'str': 'sleeping bag'}
#: data\json\items\armor\bedding.json
msgid ""
"A large sleeping bag that covers you head to toe.  This one is medium "
"weight."
msgstr "머리부터 발끝까지 덮는 대형 침낭입니다. 이건 중간 무게입니다."

#: data\json\items\armor\belts.json
msgid "firefighter belt"
msgid_plural "firefighter belts"
msgstr[0] "소방관 벨트"

#. ~ Use action holster_msg for {'str': 'firefighter belt'}.
#: data\json\items\armor\belts.json
msgid "You clip your %s to your %s"
msgstr "%s을(를) %s에 부착했다."

#. ~ Use action holster_prompt for {'str': 'firefighter belt'}.
#: data\json\items\armor\belts.json
msgid "Attach what to belt loop?"
msgstr "벨트 고리에 무엇을 부착합니까?"

#. ~ Description for {'str': 'firefighter belt'}
#: data\json\items\armor\belts.json
msgid ""
"A stout firefighter's belt.  Useful for keeping your bunker gear up, it also"
" doubles as an equipment belt with a reinforced loop for holding a large "
"tool."
msgstr "소방관이 착용하는 벨트. 무거운 장비를 부착하기 쉽도록 아주 견고하게 만들어져 있으며, 여러 고리가 달려 있습니다."

#: data\json\items\armor\belts.json
msgid "judo belt template"
msgid_plural "judo belt templates"
msgstr[0] "유도 띠 템플릿"

#. ~ Description for {'str': 'judo belt template'}
#: data\json\items\armor\belts.json
msgid "This is a template for judo belts.  If found in a game, it is a bug."
msgstr "유도 벨트용 템플릿입니다. 게임에서 발견되면 버그입니다."

#: data\json\items\armor\belts.json
msgid "black belt"
msgid_plural "black belts"
msgstr[0] "검은띠"

#. ~ Description for {'str': 'black belt'}
#: data\json\items\armor\belts.json
msgid "A belt worn by martial arts practitioners, advertising a master."
msgstr "무술 수련자가 착용하는 띠로, 달인이라는 것을 알려줍니다."

#: data\json\items\armor\belts.json
msgid "blue belt"
msgid_plural "blue belts"
msgstr[0] "파란띠"

#. ~ Description for {'str': 'blue belt'}
#: data\json\items\armor\belts.json
msgid ""
"A belt worn by martial arts practitioners, advertising a strong "
"intermediate."
msgstr "무술 수련자가 착용하는 띠로, 실력있는 중급자라는 것을 알려줍니다."

#: data\json\items\armor\belts.json
msgid "brown belt"
msgid_plural "brown belts"
msgstr[0] "갈색띠"

#. ~ Description for {'str': 'brown belt'}
#: data\json\items\armor\belts.json
msgid "A belt worn by martial arts practitioners, advertising a near-master."
msgstr "무술 수련자가 착용하는 띠로, 달인에 가까워졌다는 것을 알려줍니다."

#: data\json\items\armor\belts.json
msgid "green belt"
msgid_plural "green belts"
msgstr[0] "초록띠"

#. ~ Description for {'str': 'green belt'}
#: data\json\items\armor\belts.json
msgid ""
"A belt worn by martial arts practitioners, advertising an intermediate."
msgstr "무술 수련자가 착용하는 띠로, 중급자라는 것을 알려줍니다."

#: data\json\items\armor\belts.json
msgid "orange belt"
msgid_plural "orange belts"
msgstr[0] "주황띠"

#. ~ Description for {'str': 'orange belt'}
#: data\json\items\armor\belts.json
msgid ""
"A belt worn by martial arts practitioners, advertising a fresh intermediate."
msgstr "무술 수련자가 착용하는 띠로, 갓 중급자가 되었다는 것을 알려줍니다."

#: data\json\items\armor\belts.json
msgid "white belt"
msgid_plural "white belts"
msgstr[0] "하얀띠"

#. ~ Description for {'str': 'white belt'}
#: data\json\items\armor\belts.json
msgid "A belt worn by martial arts practitioners, advertising a novice."
msgstr "무술 수련자가 착용하는 띠로, 처음 시작한 초보자라는 것을 알려줍니다."

#: data\json\items\armor\belts.json
msgid "yellow belt"
msgid_plural "yellow belts"
msgstr[0] "노란띠"

#. ~ Description for {'str': 'yellow belt'}
#: data\json\items\armor\belts.json
msgid ""
"A belt worn by martial arts practitioners, advertising a moderate novice."
msgstr "무술 수련자가 착용하는 띠로, 보통수준의 초보자라는 것을 알려줍니다."

#: data\json\items\armor\belts.json
msgid "leather belt"
msgid_plural "leather belts"
msgstr[0] "가죽 벨트"

#. ~ Use action holster_msg for {'str': 'leather belt'}.
#. ~ Use action holster_msg for {'str': 'webbing belt'}.
#. ~ Use action holster_msg for magic leather belt.
