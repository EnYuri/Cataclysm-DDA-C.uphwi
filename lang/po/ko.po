msgstr "수동 니들러"

#: data\mods\blazemod\blaze_weapons_parts.json
msgid "manual hypervelocity driver"
msgstr "수동 초고속 드라이버"

#: data\mods\blazemod\blaze_weapons_parts.json
msgid "manual ripper"
msgstr "수동 리퍼"

#: data\mods\blazemod\blaze_weapons_parts.json
msgid "manual rotary speargun"
msgstr "수동 회전식 작살총"

#: data\mods\blazemod\blaze_weapons_parts.json
msgid "manual scorpion ballista"
msgstr "수동 스콜피온 발리스타"

#: data\mods\blazemod\blaze_weapons_parts.json
