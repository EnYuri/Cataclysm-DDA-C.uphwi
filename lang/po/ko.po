#: data\mods\DinoMod\monsters\juvenile.json
msgid "diplodocus juvenile"
msgid_plural "diplodocus juveniles"
msgstr[0] "디플로도쿠스 새끼"

#: data\mods\DinoMod\monsters\juvenile.json
msgid "barosaurus juvenile"
msgid_plural "barosaurus juveniles"
msgstr[0] "바로사우루스 새끼"

#: data\mods\DinoMod\monsters\juvenile.json
msgid "camarasaurus juvenile"
msgid_plural "camarasaurus juveniles"
msgstr[0] "카마라사우루스 새끼"

#: data\mods\DinoMod\monsters\juvenile.json
msgid "brachiosaurus juvenile"
msgid_plural "brachiosaurus juveniles"
msgstr[0] "브라키오사우루스 새끼"

#: data\mods\DinoMod\monsters\juvenile.json
msgid "astrodon juvenile"
msgid_plural "astrodon juveniles"
msgstr[0] "아스트로돈 새끼"

#: data\mods\DinoMod\monsters\juvenile.json
msgid "alamosaurus juvenile"
msgid_plural "alamosaurus juveniles"
msgstr[0] "알라모사우루스 새끼"

#: data\mods\DinoMod\monsters\juvenile.json
msgid "green and magenta four-legged juvenile"
msgid_plural "green and magenta four-legged juveniles"
msgstr[0] "녹자색 네 발 새끼"

#. ~ Description for green and magenta four-legged juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A small four-legged plant-eating dinosaur juvenile, it could be from a "
"number of different species."
msgstr "작은 네 발 초식 공룡 새끼입니다. 여러 종 중 하나일 수 있습니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "green and yellow four-legged juvenile"
msgid_plural "green and yellow four-legged juveniles"
msgstr[0] "녹황색 네 발 새끼"

#: data\mods\DinoMod\monsters\juvenile.json
msgid "gray and magenta two-legged juvenile"
msgid_plural "gray and magenta two-legged juveniles"
msgstr[0] "회자색 두 발 새끼"

#. ~ Description for gray and magenta two-legged juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A small two-legged plant-eating dinosaur juvenile, it could be from a number"
" of different species."
msgstr "작은 두 발 초식 공룡 새끼입니다. 여러 종 중 하나일 수 있습니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "leptoceratops juvenile"
msgid_plural "leptoceratops juveniles"
msgstr[0] "렙토케라톱스 새끼"

#. ~ Description for leptoceratops juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A four-legged plant-eating dinosaur juvenile with a beak and head crest."
msgstr "부리와 머리 볏을 가진 네 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "zuniceratops juvenile"
msgid_plural "zuniceratops juveniles"
msgstr[0] "주니케라톱스 새끼"

#. ~ Description for zuniceratops juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A four-legged plant-eating dinosaur juvenile with a tall thin bony head "
"crest, two brow horns, and a beak."
msgstr "키 크고 얇은 뼈 머리 볏, 눈썹 뿔 둘, 부리를 가진 네 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "styracosaurus juvenile"
msgid_plural "styracosaurus juveniles"
msgstr[0] "스티라코사우루스 새끼"

#. ~ Description for styracosaurus juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A huge four-legged plant-eating dinosaur juvenile with a beak, a bony crest "
"with spikes, and a horn above the nose."
msgstr "부리, 가시 달린 뼈 볏, 코 위의 뿔을 가진 거대한 네 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "centrosaurus juvenile"
msgid_plural "centrosaurus juveniles"
msgstr[0] "켄트로사우루스 새끼"

#. ~ Description for centrosaurus juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A huge four-legged plant-eating dinosaur juvenile with a beak and a horn "
"above the nose."
msgstr "부리와 코 위의 뿔을 가진 거대한 네 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "einiosaurus juvenile"
msgid_plural "einiosaurus juveniles"
msgstr[0] "에이니오사우루스 새끼"

#. ~ Description for einiosaurus juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A four-legged plant-eating dinosaur juvenile with a beak and a horn curved "
"forward above the nose."
msgstr "부리와 코 위로 앞쪽으로 휜 뿔을 가진 네 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "achelousaurus juvenile"
msgid_plural "achelousaurus juveniles"
msgstr[0] "아켈로사우루스 새끼"

#. ~ Description for achelousaurus juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A four-legged plant-eating dinosaur juvenile with a tall bony crest with two"
" curved spikes and three rough bosses above the eyes and nose as well as a "
"short tail and hooked beak."
msgstr ""
"휜 가시 둘이 달린 키 큰 뼈 볏과 눈과 코 위의 울퉁불퉁한 혹 셋, 그리고 짧은 꼬리와 갈고리 부리를 가진 네 발 초식 공룡 "
"새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "pachyrhinosaurus juvenile"
msgid_plural "pachyrhinosaurus juveniles"
msgstr[0] "파키리노사우루스 새끼"

#. ~ Description for pachyrhinosaurus juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A huge four-legged plant-eating dinosaur juvenile with a beak, two horns, "
"and a broad bony nose."
msgstr "부리, 뿔 둘, 넓은 뼈 코를 가진 거대한 네 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "green and magenta ceratopsian juvenile"
msgid_plural "green and magenta ceratopsian juveniles"
msgstr[0] "녹자색 각룡 새끼"

#. ~ Description for green and magenta ceratopsian juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A huge four-legged plant-eating dinosaur juvenile with a bony crest, beak, "
"and horns."
msgstr "뼈 볏, 부리, 뿔을 가진 거대한 네 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "thescelosaurus juvenile"
msgid_plural "thescelosaurus juveniles"
msgstr[0] "테스켈로사우루스 새끼"

#. ~ Description for thescelosaurus juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A two-legged plant-eating dinosaur juvenile with strong arms and a long "
"toothy beak."
msgstr "강한 앞발과 이빨 난 긴 부리를 가진 두 발 초식 공룡 새끼입니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "winged juvenile"
msgid_plural "winged juveniles"
msgstr[0] "날개 달린 새끼"

#. ~ Description for winged juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A small winged dinosaur juvenile with huge shiny eyes, it could be from a "
"number of different species."
msgstr "커다랗고 빛나는 눈을 가진 작은 날개 달린 공룡 새끼입니다. 여러 종 중 하나일 수 있습니다."

#: data\mods\DinoMod\monsters\juvenile.json
msgid "mosasaurus juvenile"
msgid_plural "mosasaurus juveniles"
msgstr[0] "모사사우루스 새끼"

#. ~ Description for mosasaurus juvenile
#: data\mods\DinoMod\monsters\juvenile.json
msgid ""
"A juvenile predatory aquatic reptile with large pointy teeth, but not the "
"largest."
msgstr "크고 뾰족한 이빨을 가진 새끼 육식 수생 파충류입니다. 가장 큰 편은 아닙니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "dilophosaurus zombie"
msgid_plural "dilophosaurus zombies"
msgstr[0] "딜로포사우루스 좀비"

#. ~ Description for {'str': 'dilophosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"The shuffling corpse of a medium-sized dinosaur with sharp teeth and two "
"prominent bony crests on its head, with ragged strips of ripped flesh "
"hanging down like a frill."
msgstr ""
"날카로운 이빨과 머리에 두드러진 두 개의 뼈 관을 가진 중형 공룡의, 질질 끌 듯 움직이는 시체입니다. 찢어진 살점이 프릴처럼 축 늘어져"
" 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "ceratosaurus zombie"
msgid_plural "ceratosaurus zombies"
msgstr[0] "케라토사우루스 좀비"

#. ~ Description for {'str': 'ceratosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"This zombie is enormous, scaly, and studded with bony spikes; it moves with "
"horrible speed.  Its colorful horns are worn and wet with filth and its "
"bright scales and bone spikes have taken a beating."
msgstr ""
"비늘로 뒤덮이고 뼈 가시가 돋아난 거대한 좀비로, 끔찍한 속도로 움직입니다. 알록달록한 뿔은 닳고 오물로 젖어 있고, 밝은 비늘과 뼈 "
"가시는 얻어맞은 흔적이 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "spinosaurus zombie"
msgid_plural "spinosaurus zombies"
msgstr[0] "스피노사우루스 좀비"

#. ~ Description for {'str': 'spinosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Enormous putrid dinosaur corpse with a ferocious crocodile-like head, oozing"
" black eyes, and a tattered sail on its back."
msgstr "흉포한 악어를 닮은 머리와 검은 액체를 흘리는 눈, 등의 너덜한 돛을 가진 거대한 부패 공룡 시체입니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "torvosaurus zombie"
msgid_plural "torvosaurus zombies"
msgstr[0] "토르보사우루스 좀비"

#. ~ Description for {'str': 'torvosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Putrid dinosaur corpse with a large head, long sharp teeth, oozing black "
"eyes, and a long tail."
msgstr "커다란 머리와 길고 날카로운 이빨, 검은 액체를 흘리는 눈, 긴 꼬리를 가진 부패 공룡 시체입니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "allosaurus zombie"
msgid_plural "allosaurus zombies"
msgstr[0] "알로사우루스 좀비"

#. ~ Description for {'str': 'allosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"The shambling corpse of a large predatory bipedal dinosaur with a mouth full"
" of sharp serrated teeth."
msgstr "날카로운 톱니 이빨이 가득한 입을 가진 큰 육식 이족보행 공룡의 비틀거리는 시체입니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "acrocanthosaurus zombie"
msgid_plural "acrocanthosaurus zombies"
msgstr[0] "아크로칸토사우루스 좀비"

#. ~ Description for {'str': 'acrocanthosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"The shambling corpse of a huge, bipedal dinosaur predator, with a tall ridge"
" running down the length of its back covered with heavy muscles.  Its teeth "
"are curved and serrated like sawblades."
msgstr ""
"등 전체를 따라 높은 능선이 두꺼운 근육으로 덮인 거대한 이족보행 육식 공룡의 비틀거리는 시체입니다. 이빨은 톱날처럼 굽고 톱니 "
"모양입니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "siats zombie"
msgid_plural "siats zombies"
msgstr[0] "시아츠 좀비"

#. ~ Description for {'str': 'siats zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"The shambling corpse of a huge, bipedal dinosaur predator with long claws "
"and strong arms for grappling."
msgstr "붙잡기에 적합한 긴 발톱과 강한 팔을 가진 거대한 이족보행 육식 공룡의 비틀거리는 시체입니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "dryptosaurus zombie"
msgid_plural "dryptosaurus zombie"
msgstr[0] "드립토사우루스 좀비"

#. ~ Description for {'str_sp': 'dryptosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Large jaws drooling black liquid lifted over a shuffling dinosaur corpse."
msgstr "검은 액체를 줄줄 흘리는 커다란 턱이, 질질 끌 듯 움직이는 공룡 시체 위로 들려 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "appalachiosaurus zombie"
msgid_plural "appalachiosaurus zombie"
msgstr[0] "아팔라치오사우루스 좀비"

#. ~ Description for {'str_sp': 'appalachiosaurus zombie'}
#. ~ Description for {'str_sp': 'gorgosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Massive jaws drooling black liquid lifted over a huge shuffling dinosaur "
"corpse."
msgstr "검은 액체를 줄줄 흘리는 거대한 턱이, 질질 끌 듯 움직이는 거대한 공룡 시체 위로 들려 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "gorgosaurus zombie"
msgid_plural "gorgosaurus zombie"
msgstr[0] "고르고사우루스 좀비"

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "albertosaurus zombie"
msgid_plural "albertosaurus zombies"
msgstr[0] "알베르토사우루스 좀비"

#. ~ Description for {'str': 'albertosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Massive jaws drooling black liquid, lifted over grasping claws by a huge "
"shuffling dinosaur corpse."
msgstr "검은 액체를 줄줄 흘리는 거대한 턱이, 질질 끌 듯 움직이는 거대한 공룡 시체의 붙잡는 발톱 위로 들려 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "qianzhousaurus zombie"
msgid_plural "qianzhousaurus zombies"
msgstr[0] "치엔저우사우루스 좀비"

#. ~ Description for {'str': 'qianzhousaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Massive, long jaws drooling black liquid, lifted by a huge but shuffling "
"dinosaur corpse."
msgstr "검은 액체를 줄줄 흘리는 거대하고 긴 턱이, 거대하지만 질질 끌 듯 움직이는 공룡 시체에 의해 들려 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "nanuqsaurus zombie"
msgid_plural "nanuqsaurus zombies"
msgstr[0] "나누크사우루스 좀비"

#. ~ Description for {'str': 'nanuqsaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Huge jaws with long sharp teeth drooling black liquid over white feathers, "
"lifted by a huge but shuffling dinosaur corpse."
msgstr ""
"검은 액체를 줄줄 흘리는 길고 날카로운 이빨이 난 거대한 턱이 흰 깃털 위로 드리우고, 거대하지만 질질 끌 듯 움직이는 공룡 시체에 의해"
" 들려 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "daspletosaurus zombie"
msgid_plural "daspletosaurus zombies"
msgstr[0] "다스플레토사우루스 좀비"

#. ~ Description for {'str': 'daspletosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"Huge jaws with long sharp teeth drooling black liquid, lifted by a huge but "
"shuffling dinosaur corpse."
msgstr ""
"검은 액체를 줄줄 흘리는 길고 날카로운 이빨이 난 거대한 턱이, 거대하지만 질질 끌 듯 움직이는 공룡 시체에 의해 들려 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "Z-Rex"
msgid_plural "Z-Rexes"
msgstr[0] "Z-렉스"

#. ~ Description for {'str': 'Z-Rex', 'str_pl': 'Z-Rexes'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "Massive piles of ragged, stinking flesh lifting enormous sharp teeth."
msgstr "너덜너덜하고 악취 나는 살점 더미가 거대하고 날카로운 이빨을 들어 올리고 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "chained tyrannosaurus zombie"
msgid_plural "chained tyrannosaurus zombies"
msgstr[0] "사슬에 묶인 티라노사우루스 좀비"

#. ~ Description for {'str': 'chained tyrannosaurus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"A massive dinosaur corpse with enormous teeth wrapped with heavy chains to "
"allow some control."
msgstr "무거운 사슬이 감긴 거대한 이빨을 가진 육중한 공룡 시체로, 어느 정도 통제할 수 있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "gallimimus zombie"
msgid_plural "gallimimus zombies"
msgstr[0] "갈리미무스 좀비"

#. ~ Description for {'str': 'gallimimus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"The shuffling corpse of a medium-sized bipedal dinosaur, covered with "
"tattered feathers and black, putrid liquid."
msgstr "너덜한 깃털과 검은 부패 액체로 뒤덮인 중형 이족보행 공룡의, 질질 끌 듯 움직이는 시체입니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "struthiomimus zombie"
msgid_plural "struthiomimus zombies"
msgstr[0] "스트루티오미무스 좀비"

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "ornithomimus zombie"
msgid_plural "ornithomimus zombies"
msgstr[0] "오르니토미무스 좀비"

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "nothronychus zombie"
msgid_plural "nothronychus zombies"
msgstr[0] "노트로니쿠스 좀비"

#. ~ Description for {'str': 'nothronychus zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"The shuffling corpse of a large-sized bipedal dinosaur covered with tattered"
" feathers and black putrid liquid.  Sharp curved claws protrude from its "
"hands."
msgstr ""
"너덜한 깃털과 검은 부패 액체로 뒤덮인 대형 이족보행 공룡의, 질질 끌 듯 움직이는 시체입니다. 손에서 날카롭게 굽은 발톱이 돌출해 "
"있습니다."

#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid "anzu zombie"
msgid_plural "anzu zombies"
msgstr[0] "안주 좀비"

#. ~ Description for {'str': 'anzu zombie'}
#: data\mods\DinoMod\monsters\zed-dinosaur.json
msgid ""
"The shuffling corpse of a large bipedal dinosaur covered with tattered "
"feathers and black putrid liquid.  Long claws protrude from its hands."
msgstr ""
