msgstr ""
"석회화된 뼈판이 뒤틀리게 자라나 이 공룡의 부리와 깃털을 덮고 있습니다. 몸 전체의 관절과 균열에서 검은 점액이 스며 나옵니다."

#: data\mods\DinoMod\monsters\zinosaur_upgrade.json
msgid "skeletal beaked juggernaut"
msgid_plural "skeletal beaked juggernaut"
msgstr[0] "해골 부리공룡 저거너트"

#. ~ Description for {'str_sp': 'skeletal beaked juggernaut'}
#: data\mods\DinoMod\monsters\zinosaur_upgrade.json
msgid ""
