msgid "An aisle.  A hatch lets you access a cargo space beneath it."
msgstr "통로. 해치를 통해 아래의 화물 공간에 접근할 수 있습니다."

#: data\json\vehicleparts\cargo.json
msgid "carbon fiber floor trunk"
msgstr "탄소섬유 바닥 트렁크"

#: data\json\vehicleparts\cargo.json
msgid "flat trunk"
msgstr "평평한 트렁크"

#: data\json\vehicleparts\cargo.json
