msgstr "머리카락이 흰색입니다."

#: data\json\mutations\mutation_appearance.json
msgid "Hair style: crew-cut"
msgstr "머리 모양: 크루컷"

#. ~ Description for {'str': 'Hair style: crew-cut'}
#: data\json\mutations\mutation_appearance.json
msgid "Crew-cut hair"
msgstr "크루컷 머리"

#: data\json\mutations\mutation_appearance.json
msgid "Hair style: mohawk"
msgstr "머리 모양: 모히칸"

#. ~ Description for {'str': 'Hair style: mohawk'}
#: data\json\mutations\mutation_appearance.json
msgid "Hair buzzes at the sides"
msgstr "옆쪽 머리를 민 모양"

#: data\json\mutations\mutation_appearance.json
msgid "Hair style: 'fro"
msgstr "머리 모양: 아프로"

#. ~ Description for {'str': "Hair style: 'fro"}
#: data\json\mutations\mutation_appearance.json
msgid "Well groomed 'fro"
msgstr "잘 정돈된 아프로"

#: data\json\mutations\mutation_appearance.json
msgid "Hair style: short"
msgstr "머리 모양: 짧은 머리"

#. ~ Description for {'str': 'Hair style: short'}
#: data\json\mutations\mutation_appearance.json
msgid "Short hair"
msgstr "짧은 머리"

#: data\json\mutations\mutation_appearance.json
msgid "Hair style: medium-length"
msgstr "머리 모양: 중간 길이"

#. ~ Description for {'str': 'Hair style: medium-length'}
#: data\json\mutations\mutation_appearance.json
msgid "Medium-length hair"
msgstr "중간 길이 머리"

#: data\json\mutations\mutation_appearance.json
msgid "Hair style: long"
msgstr "머리 모양: 긴 머리"

#. ~ Description for {'str': 'Hair style: long'}
#: data\json\mutations\mutation_appearance.json
msgid "Long hair"
