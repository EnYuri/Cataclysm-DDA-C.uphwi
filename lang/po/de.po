#. ~ Description for scenario 'Fled the Riots' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"You were present at the last of the real riots; one of the last to flee when"
" the rioters stopped breathing but kept moving."
msgstr ""
"Du warst beim letzten echten Aufstand dabei. Du warst einer der Letzten, die"
" flohen, als die die Randalierer aufhörten, zu atmen, aber sich immer noch "
