" <full_name> & <full_name>. Crashed their motorcycles at 120mph. Buried the "
"pieces together."
msgstr ""
" <full_name> und <full_name>. Hatten einen Motorradunfall bei 193 km/h. Hab "
"die Teile zusammen begraben."

#: lang/json/snippet_from_json.py
msgid " <full_name>. Friend, Lover, Cannibal."
msgstr " <full_name>. Freund, Liebhaber, Kannibale."

#: lang/json/snippet_from_json.py
msgid " <full_name>. Vaporized by Tank Bot."
msgstr " <full_name>. Vaporisiert von Panzer-Bot."

#: lang/json/snippet_from_json.py
msgid " <given_name>. Died in his sleep. Lucky Bastard."
msgstr " <given_name>. Starb im Schlaf. Verdammter Glückspilz!"

#: lang/json/snippet_from_json.py
