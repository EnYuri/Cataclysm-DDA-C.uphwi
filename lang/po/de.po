msgid "You took a photo of %1$s. It is %2$s."
msgstr "Du nimmst ein Foto von %1$s auf. Es ist %2$s."

#: src/iuse.cpp
#, c-format
msgid "%s got in the way of your photo."
msgstr "%s war im Weg für dein Foto."

