msgstr ""
" Hier ruht <full_name>. Rauchen neben des Molotovlagers strengstens "
"verboten!"

#: lang/json/snippet_from_json.py
msgid " <full_name>. Gunned down in his prime."
msgstr " <full_name>. Wurde in seiner Blütezeit erschossen."

#: lang/json/snippet_from_json.py
msgid " <full_name>. Drank a mystery serum and mutated to death."
msgstr " <full_name>. Trank ein mysteriöses Serum und mutierte zu Tode."

#: lang/json/snippet_from_json.py
msgid " <given_name>. We'll never see another like him."
msgstr " <given_name>. Wir werden nie wieder so einen wie ihn sehen."

#: lang/json/snippet_from_json.py
msgid " <full_name>. Done in by mutant wasps."
msgstr " <full_name>. Von Mutantenwesten fertig gemacht."

