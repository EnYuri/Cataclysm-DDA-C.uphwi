msgstr[0] "Schlauchboot"
msgstr[1] "Schlauchboote"

#. ~ Use action unfold_msg for inflatable boat.
#: lang/json/TOOL_from_json.py
#, no-python-format
msgid "You painstakingly unfold, inflate, and launch the %s."
msgstr "Sorgfältig entfaltest du %s, bläst es auf und stößt es an."

#. ~ Description for inflatable boat
#: lang/json/TOOL_from_json.py
msgid ""
"This rubber rowboat (oars included) is deflated for storage.  Activate it "
"(having an air pump in inventory) to inflate and launch."
msgstr ""
"Dieses Gummiruderboot (mit Rudern) ist für die Lagerung entleert. Aktiviere "
"es, um es aufzublasen und anzustoßen, vorausgesetzt, dass du eine Luftpumpe "
"im Inventar hast."

