#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"The building you had chosen to reside in has suddenly caught fire!  You "
"might want to leave."
msgstr ""
"Das Gebäude, in dem du wohntest, hat plötzlich Feuer gefangen! Du möchtest "
"es vermutlich verlassen."

