msgid "You have no tool to dig with..."
msgstr "Du hast kein Werkzeug zum Graben."

#: src/iexamine.cpp
#, c-format
msgid "Dig up %s? This kills the tree!"
msgstr "%s ausgraben? Das würde den Baum töten!"

#: src/iexamine.cpp
msgid "Which container?"
msgstr "Welcher Behälter?"

