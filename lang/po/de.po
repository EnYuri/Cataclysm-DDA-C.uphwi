#: lang/json/BOOK_from_json.py
msgid "Paramedics"
msgid_plural "Paramedics"
msgstr[0] "Sanitäter"
msgstr[1] "Sanitäter"

#. ~ Description for Paramedics
#: lang/json/BOOK_from_json.py
msgid "An educational magazine for EMTs."
msgstr "Ein bildendes Magazin für Rettungssanitäter."

#: lang/json/BOOK_from_json.py
msgid "The Big Book of First Aid"
msgid_plural "Big Books of First Aid"
msgstr[0] "Das Große Buch der Ersten Hilfe"
msgstr[1] "Große Bücher der Ersten Hilfe"

