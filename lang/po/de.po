msgid "No container added. The sap will just spill on the ground."
msgstr ""
"Keinen Behälter hinzugefügt. Der Saft wird einfach auf den Boden laufen."

#: src/iexamine.cpp
msgid "Remove tap"
msgstr "Zapfhahn entfernen"

#: src/iexamine.cpp
#, c-format
msgid "Add a container to receive the %s"
msgstr "Einen Behälter hinzufügen, um %s zu erhalten"

#: src/iexamine.cpp
#, c-format
msgid "Harvest current %s (%d)"
msgstr "%s abernten (%d)"

#: src/iexamine.cpp
msgid "Remove container"
msgstr "Behälter entfernen"

