#: lang/json/MAGAZINE_from_json.py
msgid "H&K G3 drum magazine"
msgstr "H&K-G3-Trommelmagazin"

#. ~ Description for H&K G3 drum magazine
#: lang/json/MAGAZINE_from_json.py
