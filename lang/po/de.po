msgstr "Platinmitglied"

#: src/iexamine.cpp
msgid "Gold member"
msgstr "Goldmitglied"

#: src/iexamine.cpp
msgid "Silver member"
msgstr "Silbermitglied"

#: src/iexamine.cpp
