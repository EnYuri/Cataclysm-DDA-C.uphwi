#: lang/json/furniture_from_json.py
msgid "pinball machine"
msgstr "Flipperautomat"

#. ~ Description for pinball machine
#: lang/json/furniture_from_json.py
msgid ""
"Most underrated game of the 20th century.  Press buttons so it doesn't go in"
" the hole."
msgstr ""
"Das am meisten unterschätzte Spiel des 20. Jahrhunderts. Drücke Knöpfe, "
"damit es nicht ins Loch fällt."

#: lang/json/furniture_from_json.py
