#: lang/json/BOOK_from_json.py
msgid "Pocket Guide to Firearm Safety"
msgid_plural "Pocket Guides to Firearm Safety"
msgstr[0] "Feuerwaffensicherheitstaschenführer"
msgstr[1] "Feuerwaffensicherheitstaschenführer"

#. ~ Description for Pocket Guide to Firearm Safety
#: lang/json/BOOK_from_json.py
