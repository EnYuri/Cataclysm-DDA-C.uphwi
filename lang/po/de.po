#, c-format
msgid "It will finish brewing in about %d hour."
msgid_plural "It will finish brewing in about %d hours."
msgstr[0] "Der Brauprozess wird in ungefähr %d Stunde beendet sein."
msgstr[1] "Der Brauprozess wird in ungefähr %d Stunden beendet sein."

#: src/iexamine.cpp
