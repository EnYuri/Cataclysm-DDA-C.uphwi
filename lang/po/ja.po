#. ~ Description for metal wheel
#. ~ Description for roller drum
#: lang/json/vehicle_part_from_json.py
msgid "A strong metal wheel."
msgstr "頑丈な金属製ホイールです。"

#: lang/json/vehicle_part_from_json.py
msgid "roller drum"
msgstr "ドラムローラー"

#. ~ Description for wheel
#: lang/json/vehicle_part_from_json.py
msgid "A wheel."
msgstr "ホイールです。"

#: lang/json/vehicle_part_from_json.py
msgid "wheel (steerable)"
msgstr "ホイール(転舵輪)"

#: lang/json/vehicle_part_from_json.py
