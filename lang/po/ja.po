#: src/player.cpp
msgid "I can still fight, don't replace me!"
msgstr "まだ戦えるから、置いていかないで！"

#: src/player.cpp
msgid "They got me!"
msgstr "やられた！"

#: src/player.cpp
msgid "Go on without me..."
msgstr "置いて行ってくれ..."

#: src/player.cpp
msgid "Am I gonna die?"
msgstr "私は死ぬのか？"

#: src/player.cpp
msgid "Let me kill something already!"
msgstr "さっさと殺そう！"

#: src/player.cpp
msgid "I'm your best friend, right?"
msgstr "私たちは親友だよな？"

#: src/player.cpp
msgid "Do you think it will rain today?"
msgstr "今日は雨が降ると思う？"

#: src/player.cpp
msgid "Try not to drop me."
msgstr "置いて行かないで。"

#: src/player.cpp
msgid "How many do you think we've killed?"
