"Adds more craftable firearms, and gunpowder.  WARNING: Breaks intended "
"balance."
msgstr "製作可能な銃器と火薬を追加します。 警告: 導入するとゲームバランスが崩壊します。"

#: lang/json/MOD_INFO_from_json.py
msgid "Crazy Cataclysm"
msgstr "追加 - クレイジー・カタクリズム"

#. ~ Description for Crazy Cataclysm
#: lang/json/MOD_INFO_from_json.py
msgid "Want a little crazy in your Cataclysm?  Try this one."
msgstr "ちょっとクレイジーなCataclysmを楽しみたい？こちらをお試しあれ。"

#: lang/json/MOD_INFO_from_json.py
msgid "(DP_RP) Chesthole Indicators"
msgstr "変更 - Chestholeインターフェース"

#. ~ Description for (DP_RP) Chesthole Indicators
#: lang/json/MOD_INFO_from_json.py
msgid "Changes interface indicators to Chesthole version."
msgstr "インターフェースや記号のみをChestholeのタイルに差し替えます。"

#: lang/json/MOD_INFO_from_json.py
msgid "(DP_RP) REMIX Indicators"
msgstr "変更 - REMIXインターフェース"

#. ~ Description for (DP_RP) REMIX Indicators
#: lang/json/MOD_INFO_from_json.py
