msgid "\"Hello?\""
msgstr "「やぁ？」"

#: lang/json/speech_from_json.py
msgid "\"Who's there?\""
msgstr "「そこにいるのは誰？」"

#: lang/json/speech_from_json.py
msgid "\"Can you help me?\""
