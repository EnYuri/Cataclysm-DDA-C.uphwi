#: src/game.cpp
msgid "a survivor"
msgstr "生存者"

#: src/game.cpp
#, c-format
msgid " or %s to whitelist the monster"
msgstr "または、%sでモンスターをホワイトリストに登録"

#: src/game.cpp
#, c-format
