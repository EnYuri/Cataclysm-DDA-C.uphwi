#: lang/json/BOOK_from_json.py
msgid "Guide to Advanced Emergency Care"
msgid_plural "Guides to Advanced Emergency Care"
msgstr[0] "本(学習/高等緊急医療ガイド)"

#. ~ Description for Guide to Advanced Emergency Care
#: lang/json/BOOK_from_json.py
