#: lang/json/morale_type_from_json.py
msgid "Enjoyed honey"
msgstr "蜂蜜を堪能した"

#: lang/json/morale_type_from_json.py
msgid "Played Video Game"
msgstr "ゲームで遊んだ"

#: lang/json/morale_type_from_json.py
msgid "Marloss Bliss"
msgstr "マーロスの至福"

#: lang/json/morale_type_from_json.py
msgid "Mutagenic Anticipation"
msgstr "変異への期待感"

#: lang/json/morale_type_from_json.py
msgid "Good Feeling"
msgstr "気分が良い"

#: lang/json/morale_type_from_json.py
msgid "Supported"
msgstr "同胞の支援"

#: lang/json/morale_type_from_json.py
msgid "Looked at photos"
msgstr "写真を見た"

#: lang/json/morale_type_from_json.py
msgid "Nicotine Craving"
msgstr "ニコチン依存症"

#: lang/json/morale_type_from_json.py
msgid "Caffeine Craving"
msgstr "カフェイン依存症"

#: lang/json/morale_type_from_json.py
msgid "Alcohol Craving"
msgstr "アルコール依存症"

#: lang/json/morale_type_from_json.py
msgid "Opiate Craving"
msgstr "アヘン依存症"

#: lang/json/morale_type_from_json.py
msgid "Speed Craving"
msgstr "覚せい剤依存症"

#: lang/json/morale_type_from_json.py
msgid "Cocaine Craving"
msgstr "コカイン依存症"

#: lang/json/morale_type_from_json.py
msgid "Crack Cocaine Craving"
msgstr "高純度コカイン依存症"

#: lang/json/morale_type_from_json.py
msgid "Mutagen Craving"
msgstr "変異原物質依存症"

#: lang/json/morale_type_from_json.py
