#. ~ Use action holster_prompt for scabbard.
#: lang/json/ARMOR_from_json.py
msgid "Sheath sword"
msgstr "剣を納める"

#. ~ Description for baldric
#: lang/json/ARMOR_from_json.py
msgid ""
"A leather scabbard, big enough for anything up to a longsword, or even a bit"
" larger than that.  Designed to be worn at the waist, secured by a shoulder "
"belt.  Activate to sheath/draw a sword."
msgstr "肩掛け帯を使って腰に着用するように作られた大型の鞘です。剣やその他の大型の刃物を収められます。使用することで武器の納刀、抜刀が可能です。"

#: lang/json/ARMOR_from_json.py
msgid "bandana"
msgid_plural "bandanas"
msgstr[0] "バンダナ"

#. ~ Description for bandana
#: lang/json/ARMOR_from_json.py
msgid ""
"A cotton bandana, worn over the mouth for warmth and minor protection from "
"dust and other contaminants."
msgstr "綿製の口を覆う少し暖かいバンダナです。埃や汚染物質をわずかに防ぎます。"

#: lang/json/ARMOR_from_json.py
msgid "barrette"
msgid_plural "barrettes"
msgstr[0] "バレッタ"

#. ~ Description for barrette
#: lang/json/ARMOR_from_json.py
msgid "A barrette with lots of ornaments."
msgstr "多くの装飾が施されたバレッタです。"

#: lang/json/ARMOR_from_json.py
msgid "laundry basket"
msgid_plural "laundry baskets"
msgstr[0] "洗濯かご"

#. ~ Description for laundry basket
#: lang/json/ARMOR_from_json.py
msgid "A plastic basket meant for storing and hauling clothing."
msgstr "衣類を入れて運ぶための、プラスチック製のかごです。"

#: lang/json/ARMOR_from_json.py
msgid "pair of beekeeping gloves"
msgid_plural "pairs of beekeeping gloves"
msgstr[0] "手袋(養蜂用)"

#. ~ Description for pair of beekeeping gloves
#: lang/json/ARMOR_from_json.py
msgid "A pair of white beekeeping gloves made out of smooth leather."
msgstr "滑らかな革で作った養蜂用の白い手袋です。"

#: lang/json/ARMOR_from_json.py
msgid "beekeeping hood"
msgid_plural "beekeeping hoods"
msgstr[0] "フード(養蜂用)"

#. ~ Description for beekeeping hood
#: lang/json/ARMOR_from_json.py
msgid ""
"A beekeeping hood.  Keeps the bees out, but lets fresh air in.  Rather "
"cumbersome to wear, as it is rather bulky and hinders vision."
msgstr "養蜂用のフードです。蜂を防ぎつつも新鮮な空気を取り込めます。意外と快適な着心地ですが、体積が大きく視界が悪いのが難点です。"

#: lang/json/ARMOR_from_json.py
msgid "beekeeping suit"
msgid_plural "beekeeping suits"
msgstr[0] "作業着(養蜂用)"

#. ~ Description for beekeeping suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A white suit commonly worn by professional beekeepers with straps on your "
"ankles and wrists to prevent bees from flying in.  It's not a very tough "
"fabric, but it's lightweight and has plenty of storage thanks to a chest "
"pocket."
msgstr ""
"ハチが入ってこないように手首と足首に紐が付いている、養蜂家が作業時に着用する白い服です。十分に頑丈とは言えませんが、胸ポケットのおかげで収納容量が多く、軽量です。"

#: lang/json/ARMOR_from_json.py
msgid "beret"
msgid_plural "berets"
msgstr[0] "ベレー帽"

#. ~ Description for beret
#: lang/json/ARMOR_from_json.py
msgid "A soft cotton hat.  Commonly worn by armed forces and existentialists."
msgstr "綿製の柔らかな帽子です。軍人や実存主義者がよく被っています。"

#: lang/json/ARMOR_from_json.py
msgid "wool beret"
msgid_plural "wool berets"
msgstr[0] "ベレー帽(羊毛)"

#. ~ Description for wool beret
#: lang/json/ARMOR_from_json.py
msgid "A soft wool hat.  Commonly worn by armed forces and existentialists."
msgstr "羊毛製の柔らかな帽子です。軍人や実存主義者がよく被っています。"

#: lang/json/ARMOR_from_json.py
msgid "bikini bottom"
msgid_plural "bikini bottoms"
msgstr[0] "ビキニパンツ"

#. ~ Description for bikini bottom
#: lang/json/ARMOR_from_json.py
msgid "A simple bikini bottom."
msgstr "シンプルなビキニパンツです。"

#: lang/json/ARMOR_from_json.py
msgid "bikini top"
msgid_plural "bikini tops"
msgstr[0] "ビキニトップ"

#. ~ Description for bikini top
#: lang/json/ARMOR_from_json.py
msgid "A simple bikini top."
msgstr "シンプルなビキニトップです。"

#: lang/json/ARMOR_from_json.py
msgid "fur bikini top"
msgid_plural "fur bikini tops"
msgstr[0] "ビキニトップ(毛皮)"

#. ~ Description for fur bikini top
#: lang/json/ARMOR_from_json.py
msgid "A simple fur bikini top."
msgstr "毛皮製のシンプルなビキニトップです。"

#: lang/json/ARMOR_from_json.py
msgid "leather bikini top"
msgid_plural "leather bikini tops"
msgstr[0] "ビキニトップ(革)"

#. ~ Description for leather bikini top
#: lang/json/ARMOR_from_json.py
msgid "A simple leather bikini top."
msgstr "革製のシンプルなビキニトップです。"

#: lang/json/ARMOR_from_json.py
msgid "bindle"
msgid_plural "bindles"
msgstr[0] "放浪者の棒きれ"

#. ~ Description for bindle
#: lang/json/ARMOR_from_json.py
msgid ""
"You're ready for a trip down some train tracks.  Also known as a hobo stick."
msgstr "線路沿いを旅する準備は万端です。この棒きれは放浪者の証として知られています。"

#: lang/json/ARMOR_from_json.py
msgid "blanket"
msgid_plural "blankets"
msgstr[0] "ブランケット"

#. ~ Description for blanket
#: lang/json/ARMOR_from_json.py
msgid "Hiding under here will not protect you from the monsters."
msgstr "毛布に包まっていてもモンスターからは身を守れません。"

#: lang/json/ARMOR_from_json.py
msgid "blazer"
msgid_plural "blazers"
msgstr[0] "ブレザー"

#. ~ Description for blazer
#: lang/json/ARMOR_from_json.py
msgid "A professional-looking wool blazer.  Quite cumbersome."
msgstr "プロが仕立てた羊毛製のブレザーです。非常に嵩張ります。"

#: lang/json/ARMOR_from_json.py
msgid "blindfold"
msgid_plural "blindfolds"
msgstr[0] "目隠し布"

#. ~ Description for blindfold
#: lang/json/ARMOR_from_json.py
msgid ""
"A simple fabric covering tied over the eyes to block sight.  Useful for "
"sleeping in bright areas."
msgstr "シンプルな目隠し用の布です。目を覆って視界を遮ります。明るい場所で眠りたい時に便利です。"

#: lang/json/ARMOR_from_json.py
msgid "bondage mask"
msgid_plural "bondage masks"
msgstr[0] "ボンデージマスク"

#. ~ Use action menu_text for bondage mask.
#: lang/json/ARMOR_from_json.py
msgid "Zip up"
msgstr "ジッパーを閉じる"

#. ~ Use action msg for bondage mask.
#: lang/json/ARMOR_from_json.py
msgid "You zip the eyes and mouth of the bondage mask closed."
msgstr "ボンデージマスクのジッパーを閉じて目と口を塞ぎました。"

#. ~ Description for bondage mask
#: lang/json/ARMOR_from_json.py
msgid ""
"A tight mask made of black leather.  The eyes and mouth can be closed using "
"zippers."
msgstr "黒い革製のタイトマスクです。目と口のジッパーを閉じられます。"

#: lang/json/ARMOR_from_json.py
msgid "bondage mask (zipped)"
msgid_plural "bondage masks (zipped)"
msgstr[0] "ボンデージマスク(閉)"

#. ~ Use action menu_text for bondage mask (zipped).
#: lang/json/ARMOR_from_json.py
msgid "Unzip"
msgstr "ジッパーを開く"

#. ~ Use action msg for bondage mask (zipped).
#: lang/json/ARMOR_from_json.py
msgid "You unzip the eyes and mouth of the bondage mask."
msgstr "ボンデージマスクの目元と口元のジッパーを開きました。"

#. ~ Description for bondage mask (zipped)
#: lang/json/ARMOR_from_json.py
msgid ""
"A tight mask made of black leather.  The eyes and mouth have been zipped "
"closed."
msgstr "黒い革製のタイトマスクです。目元と口元のジッパーは閉まっています。"

#: lang/json/ARMOR_from_json.py
msgid "bondage suit"
msgid_plural "bondage suits"
msgstr[0] "ボンデージスーツ"

#. ~ Description for bondage suit
#: lang/json/ARMOR_from_json.py
msgid ""
"A suit of snug, black leather.  Has no pockets, but does feature an "
"abundance of unusually located zippers."
msgstr "黒い革製の肌に密着した服です。ポケットは付いていませんが、何故か不適切な場所にたくさんのジッパーが付いているのが特徴です。"

#: lang/json/ARMOR_from_json.py
msgid "bookplate"
msgid_plural "bookplates"
msgstr[0] "ブックプレート"

#. ~ Description for bookplate
#: lang/json/ARMOR_from_json.py
msgid ""
"A crude form of armor made from stacked paper and rolls of duct tape, this "
"breastplate offers a surprising amount of protection."
msgstr "何層にも重ねた紙とダクトテープから作られた鎧っぽいものです。この胸当ては驚くべき防御力を持っています。"

#: lang/json/ARMOR_from_json.py
msgid "ankle sheath"
msgid_plural "ankle sheaths"
msgstr[0] "鞘(足首)"

