msgstr "%1$sを発見しました-セーフモードを有効化します！(%2$sで無効、%3$sで対象から除外%4$s)"

#: src/game.cpp
#, c-format
msgid "Deactivate the %s?"
msgstr "%sを停止しますか？"

#: src/game.cpp
msgid "Engage targets."
msgstr "目標と交戦"

#: src/game.cpp
msgid "Reprogram the manhack?"
msgstr "マンハックを再プログラムしますか？"

#: src/game.cpp
msgid "Follow me."
msgstr "追従"

#: src/game.cpp
#, c-format
msgid "The %s hovers momentarily as it surveys the area."
msgstr "%sは空中に浮かぶと、すぐに周囲を監視し始めました。"

