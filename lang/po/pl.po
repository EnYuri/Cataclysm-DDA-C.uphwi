msgid_plural "pistol bandoliers"
msgstr[0] "bandolier pistoletowy"
msgstr[1] "bandolier pistoletowy"
msgstr[2] "bandolier pistoletowy"
msgstr[3] "bandolier pistoletowy"

#. ~ Description for pistol bandolier
#: lang/json/ARMOR_from_json.py
msgid ""
"An embroidered leather bandolier for keeping pistol cartridges close to "
"hand.  If this doesn't make you feel like a cowboy nothing will."
msgstr ""
"Wyszywany skórzany bandolier do trzymania naboi pistoletowych pod ręką. "
"Jeżeli to nie sprawi, że poczujesz się po kowbojsku to nic już nie pomoże."

#: lang/json/ARMOR_from_json.py
msgid "rifle bandolier"
msgid_plural "rifle bandoliers"
msgstr[0] "bandolier karabinowy"
msgstr[1] "bandolier karabinowy"
msgstr[2] "bandolier karabinowy"
msgstr[3] "bandolier karabinowy"

#. ~ Description for rifle bandolier
#: lang/json/ARMOR_from_json.py
msgid "A leather bandolier for keeping rifle cartridges close to hand."
msgstr "Skórzany bandolier do trzymania naboi karabinowych pod ręką."

#: lang/json/ARMOR_from_json.py
