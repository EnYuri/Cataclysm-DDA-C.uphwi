#: src/iuse_actor.cpp
#, c-format
msgid "You saw down the barrel of your %s."
msgstr "Obrzynasz lufę w swojej %s."

#: src/iuse_actor.cpp
msgid "It's not a gun."
msgstr "To nie jest spluwa."

#: src/iuse_actor.cpp
msgid "The barrel is too short."
msgstr "Lufa jest zbyt krótka."

#: src/iuse_actor.cpp
msgid "The barrel is already sawn-off."
msgstr "Lufa jest już obcięta."

#: src/iuse_actor.cpp
msgid "Can't saw off modified barrels."
