#: lang/json/GENERIC_from_json.py
msgid ""
"This is a solid wood 'training' katana, but feels far too light to make an "
"effective weapon."
msgstr ""
"Jest to katana do ćwiczeń wykonana z litego drewna, ale wydaje się zbyt "
"lekka, by być skuteczną bronią."

