msgstr[0] "uzupełnialna zapalniczka"
msgstr[1] "uzupełnialna zapalniczka"
msgstr[2] "uzupełnialna zapalniczka"
msgstr[3] "uzupełnialna zapalniczka"

#. ~ Use action menu_text for refillable lighter.
#: lang/json/TOOL_from_json.py lang/json/item_action_from_json.py
