#: lang/json/ARMOR_from_json.py
msgid ""
"Leather boots armored with reinforcements made from bone.  Light and strong."
msgstr ""
"Skórzane buty wzmocnione dla ochrony kościanymi wstawkami. Lekkie i twarde."

#: lang/json/ARMOR_from_json.py
msgid "pair of turnout boots"
msgid_plural "pairs of turnout boots"
msgstr[0] "buty strażackie"
msgstr[1] "buty strażackie"
msgstr[2] "buty strażackie"
msgstr[3] "buty strażackie"

#. ~ Description for pair of turnout boots
#: lang/json/ARMOR_from_json.py
msgid ""
"A pair of steel-toed rubber boots, the sort worn by firefighters.  Highly "
"resistant to heat and flame, they provide excellent protection from injury."
msgstr ""
"Ciężkie ochronne buty ze stalowym noskiem noszone przez strażaków. Wysoce "
"odporne na ogień i temperaturę, zapewniają dobrą ochronę przed obrażeniami."

#: lang/json/ARMOR_from_json.py
msgid "pair of chitinous boots"
