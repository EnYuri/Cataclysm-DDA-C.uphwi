msgstr ""
"Twoje mięśnie drżą poza twoją kontrolą, i masz problemy z zachowaniem "
"równowagi."

#: src/player.cpp
msgid "Your shaking legs make you stumble."
msgstr "Twoje drżące nogi plączą się i potykają."

#: src/player.cpp
msgid "You fall over!"
msgstr "Przewracasz się!"

