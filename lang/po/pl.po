msgstr[2] "katana"
msgstr[3] "katana"

#. ~ Description for katana
#: lang/json/GENERIC_from_json.py
msgid "This is a dull, cheaply made replica of a rare sword from Japan."
msgstr "Tępa, tania replika rzadkiego miecza z Japonii."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
#: lang/json/TOOL_from_json.py
msgid "zweihänder"
msgid_plural "zweihänders"
msgstr[0] "miecz dwuręczny"
msgstr[1] "miecz dwuręczny"
msgstr[2] "miecz dwuręczny"
msgstr[3] "miecz dwuręczny"

#. ~ Description for zweihänder
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a dull, cheaply made replica of a huge two-handed sword from "
"Germany.  It still packs a wallop."
msgstr ""
"Tępa, tania replika wielkiego miecza dwuręcznego z Niemiec. Nadal potrafi "
"przywalić."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
#: lang/json/TOOL_from_json.py
msgid "broadsword"
msgid_plural "broadswords"
msgstr[0] "miecz obosieczny"
msgstr[1] "miecz obosieczny"
msgstr[2] "miecz obosieczny"
msgstr[3] "miecz obosieczny"

#. ~ Description for broadsword
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a dull, cheaply made replica of an early modern sword seeing use in "
"the 16th, 17th, and 18th centuries.  Called 'broad' to contrast with the "
"slimmer rapiers."
msgstr ""
"Tępa, tania replika miecza używanego pomiędzy 16-tym a 18-tym wiekiem. "
"Szerokie ostrze odróżnia go od cieńszych rapierów."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
msgid "cavalry saber"
msgid_plural "cavalry sabers"
msgstr[0] "szabla kawaleryjska"
msgstr[1] "szabla kawaleryjska"
msgstr[2] "szabla kawaleryjska"
msgstr[3] "szabla kawaleryjska"

#. ~ Description for cavalry saber
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a dull, cheap replica of a curved sword associated with cavalry, "
"from the Early Modern period onwards."
msgstr ""
"Tępa, tania replika zakrzywionego miecza kojarzonego z kawalerią z okresu "
"nowożytności."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
msgid "rapier"
msgid_plural "rapiers"
msgstr[0] "rapier"
msgstr[1] "rapier"
msgstr[2] "rapier"
msgstr[3] "rapier"

#. ~ Description for rapier
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a blunted, cheap replica of a thin sword with an ornate hand guard."
"  It looks like the preferred weapon of gentlemen and swashbucklers.  Light "
"and quick, it makes any battle a stylish battle."
msgstr ""
"Tępa, tania replika cienkiego miecza z ornamentowym jelcem. Wygląda na broń "
"preferowaną przez gentlemanów i awanturników. Lekka i szybka, czyni każdą "
"bitwę stylową."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
#: lang/json/TOOL_from_json.py
msgid "wakizashi"
msgid_plural "wakizashis"
msgstr[0] "wakizashi"
msgstr[1] "wakizashi"
msgstr[2] "wakizashi"
msgstr[3] "wakizashi"

#. ~ Description for wakizashi
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a dull, cheap replica of the more common wakizashi.  Smaller and "
"lighter than a katana, but still effective in combat."
msgstr ""
"Tępa, tania replika popularnego wakizashi. Mniejszy i lżejszy od katany, ale"
" nadal efektywny w walce."

#: lang/json/GENERIC_from_json.py lang/json/TOOL_from_json.py
