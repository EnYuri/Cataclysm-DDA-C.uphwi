"siatki montażowej."

#: lang/json/ARMOR_from_json.py
msgid "large grenade pouch"
msgid_plural "large grenade pouches"
msgstr[0] "duża ładownica na granaty"
msgstr[1] "duża ładownica na granaty"
msgstr[2] "duża ładownica na granaty"
msgstr[3] "duże ładownice na granaty"

#. ~ Use action holster_prompt for large grenade pouch.
