msgstr[1] "garść wiśni"
msgstr[2] "garść wiśni"
msgstr[3] "garść wiśni"

#. ~ Description for handful of cherries
#: lang/json/COMESTIBLE_from_json.py
msgid "A red, sweet fruit that grows in trees."
msgstr "Czerwone słodkie owoce z pestką, które rosną na drzewach."

#: lang/json/COMESTIBLE_from_json.py
msgid "plum"
msgstr "śliwka"

#. ~ Description for plum
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"A handful of large, purple plums.  Healthy and good for your digestion."
msgstr "Garść dużych purpurowych śliwek. Zdrowe i poprawiają trawienie."

#: lang/json/COMESTIBLE_from_json.py
msgid "handful of grapes"
msgid_plural "handful of grapes"
