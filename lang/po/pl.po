msgstr[1] "śrutowiec .410"
msgstr[2] "śrutowiec .410"
msgstr[3] "śrutowiec .410"

#. ~ Description for .410 birdshot
#: lang/json/AMMO_from_json.py
msgid ""
".410 bore shotshells, filled with a light load of birdshot.  The smallest of"
" traditional shotgun sizes, frequently used for youth shotguns due to its "
"lower recoil."
msgstr ""
"Nabój do strzelb kalibru .410, napełniony drobnym śrutem. Najmniejszy z "
"tradycyjnych rozmiarów nabojów do strzelb, powszechnie stosowany w "
"strzelbach dla młodych z uwagi na niższy odrzut."

#: lang/json/AMMO_from_json.py
msgid ".410 slug"
msgstr ".410 breneka"

#. ~ Description for .410 slug
#: lang/json/AMMO_from_json.py
msgid ""
"A .410 bore shotshell loaded with a metal slug.  Quite damaging but rather "
"inaccurate."
msgstr ""
"Nabój do strzelb kalibru .410, z metalową breneką. Zadaje sporo obrażeń ale "
"jest raczej niecelny."

#: lang/json/AMMO_from_json.py
msgid "makeshift .410 shot"
msgid_plural "makeshift .410 shot"
msgstr[0] "improwizowana loftka .410"
msgstr[1] "improwizowana loftka .410"
msgstr[2] "improwizowana loftka .410"
msgstr[3] "improwizowana loftka .410"

#. ~ Description for makeshift .410 shot
#: lang/json/AMMO_from_json.py
msgid ""
"A .410 shotgun shell filled with whatever was lying around.  They are more "
"damaging than birdshot, but fairly inaccurate."
msgstr ""
"Nabój do strzelby .410 wypchany czymkolwiek co było pod ręką. Silniejszy od "
"śrutowca, lecz mniej celny."

