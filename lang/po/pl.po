msgid "Consumed mutagen."
msgstr "Skonsumowałaś mutagen."

#: src/iuse_actor.cpp
msgid "You suddenly feel dizzy, and collapse to the ground."
msgstr "Czujesz nagłe zawroty głowy, i upadasz na ziemię."

#: src/iuse_actor.cpp
msgid "<npcname> suddenly collapses to the ground!"
msgstr "<npcname> nagle upada na ziemię!"

#: src/iuse_actor.cpp
msgctxt "memorial_male"
msgid "Injected mutagen."
msgstr "Wstrzyknąłeś sobie mutagen."

#: src/iuse_actor.cpp
msgctxt "memorial_female"
msgid "Injected mutagen."
msgstr "Wstrzyknęłaś sobie mutagen."

