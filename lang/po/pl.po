msgstr[2] "proca"
msgstr[3] "proca"

#: lang/json/gun_from_json.py
msgid ""
"A leather sling, easy to use and accurate.  It uses pebbles as ammunition."
msgstr "Skórzana proca, łatwa w użyciu i celna. Używa kamyków jako amunicji."

