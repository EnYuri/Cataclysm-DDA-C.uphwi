msgstr "Rozkładasz z trzaskiem swoją pałkę PR-24."

#. ~ Description for PR-24 baton (retracted)
#: lang/json/GENERIC_from_json.py
msgid ""
"The Monadnock PR-24 baton is a collapsible, lightweight, side-handle baton "
"used by law enforcement all over the world.  The PR designation is rumored "
"to mean Public Relations.  Activate to extend."
msgstr ""
"Pałka Monadnock PR-24 to składana, lekka pałka policyjna z bocznym chwytem "
"używana przez siły porządkowe na całym świecie. PR podobno oznacza Public "
"Relations. Aktywuj by rozłożyć."

#: lang/json/GENERIC_from_json.py
msgid "PR-24 baton (extended)"
msgid_plural "PR-24 batons (extended)"
msgstr[0] "pałka policyjna PR-24 (rozłożona)"
msgstr[1] "pałka policyjna PR-24 (rozłożona)"
msgstr[2] "pałka policyjna PR-24 (rozłożona)"
msgstr[3] "pałka policyjna PR-24 (rozłożona)"

#. ~ Use action menu_text for PR-24 baton (extended).
#: lang/json/GENERIC_from_json.py
msgid "Retract"
msgstr "Złóż"

#. ~ Use action msg for PR-24 baton (extended).
#: lang/json/GENERIC_from_json.py
msgid "You collapse your PR-24 baton."
msgstr "Składasz pałkę PR-24."

#. ~ Description for PR-24 baton (extended)
#: lang/json/GENERIC_from_json.py
msgid ""
"The Monadnock PR-24 baton is a collapsible, lightweight, side-handle baton "
"used by law enforcement all over the world.  The PR designation is rumored "
"to mean Public Relations.  Activate to retract."
msgstr ""
"Pałka Monadnock PR-24 to składana, lekka pałka policyjna z bocznym chwytem "
"używana przez siły porządkowe na całym świecie. PR podobno oznacza Public "
"Relations. Aktywuj by złożyć."

#: lang/json/GENERIC_from_json.py
msgid "copper tubing"
