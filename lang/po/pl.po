msgstr[1] "prasa ręczna i matryce"
msgstr[2] "prasa ręczna i matryce"
msgstr[3] "prasa ręczna i matryce"

#. ~ Description for hand press & die set
#: lang/json/TOOL_from_json.py
msgid ""
"This is a small hand press for hand loading firearm ammunition.  It comes "
"with everything you need to start hand loading your own munitions."
msgstr ""
"Małą ręczna prasa do ręcznego ładowania amunicji. W zestawie ze wszystkim co"
" potrzeba do rozpoczęcia produkcji własnej amunicji."

#: lang/json/TOOL_from_json.py
