msgstr[1] "ładownica na gilzy papierowe"
msgstr[2] "ładownica na gilzy papierowe"
msgstr[3] "ładownica na gilzy papierowe"

#. ~ Description for paper cartridge pouch
#: lang/json/ARMOR_from_json.py
