msgstr[1] "miedziana rurka"
msgstr[2] "miedziana rurka"
msgstr[3] "miedziana rurka"

#. ~ Description for copper tubing
#: lang/json/GENERIC_from_json.py
msgid ""
"A copper tube, too thin to be much use as a melee weapon, but will do if "
"nothing else is available.  Useful in a few crafting recipes."
msgstr ""
"Miedziana rurka, zbyt cienka by była użyteczna jako broń, choć nada się "
"jeżeli nie ma niczego innego pod ręką. Użyteczna w produkcji kilku rzeczy."

#: lang/json/GENERIC_from_json.py
