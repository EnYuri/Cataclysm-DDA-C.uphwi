msgstr "%1$s jest niemal na górze %2$s!"

#: src/game.cpp
#, c-format
msgid "The %1$s is almost at the bottom of the %2$s!"
msgstr "%1$s jest niemal na dole %2$s!"

#: src/game.cpp
msgid "a sound nearby from the stairs!"
msgstr "pobliski dźwięk ze schodów!"

#: src/game.cpp
#, c-format
msgid "The %1$s comes down the %2$s!"
msgstr "%1$s schodzi w dół %2$s!"

#: src/game.cpp
#, c-format
msgid "The %1$s comes up the %2$s!"
msgstr "%1$s wchodzi w górę  %2$s!"

