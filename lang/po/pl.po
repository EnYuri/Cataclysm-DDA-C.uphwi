msgid_plural "M72 LAW"
msgstr[0] "M72 LAW"
msgstr[1] "M72 LAW"
msgstr[2] "M72 LAW"
msgstr[3] "M72 LAW"

#: lang/json/gun_from_json.py
msgid ""
"A disposable light anti-tank rocket launcher.  Once fired, it cannot be "
"reloaded and must be disposed of."
msgstr ""
"Jednorazowa przeciwczołgowa lekka wyrzutnia rakiet. Po wystrzelenie nie "
"można jej przeładować i nadaje się do wyrzucenia."

