msgstr[1] "improwizowany macuahuitl"
msgstr[2] "improwizowany macuahuitl"
msgstr[3] "improwizowany macuahuitl"

#. ~ Description for makeshift macuahuitl
#: lang/json/GENERIC_from_json.py
msgid ""
"A flat wooden club with sharpened pieces of stone sticking to both of its "
