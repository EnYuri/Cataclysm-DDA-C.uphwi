#, c-format
msgid "Ick, this %s doesn't taste so good..."
msgstr "Ick, to%s nie smakuje zbyt dobrze..."

#: src/consumption.cpp
#, c-format
msgid "Mmm, this %s tastes delicious..."
msgstr "Mmm, ten %s smakuje wybornie..."

