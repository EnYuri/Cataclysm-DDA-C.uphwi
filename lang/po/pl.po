msgstr[1] "rura"
msgstr[2] "rura"
msgstr[3] "rura"

#. ~ Description for pipe
#: lang/json/GENERIC_from_json.py
msgid ""
"A steel pipe, makes a good melee weapon.  Useful in a few crafting recipes."
msgstr "Stalowa rurka, dobra jako broń wręcz. Przydatna do produkcji rzeczy."

#: lang/json/GENERIC_from_json.py
msgid "baseball bat"
