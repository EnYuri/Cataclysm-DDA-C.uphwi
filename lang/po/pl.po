"wytwarzania zbroi. Wyposażony w ilustracje opisujące te procesy krok po "
"kroku."

#: lang/json/BOOK_from_json.py
msgid "DIY Compendium"
msgid_plural "DIY Compendiums"
msgstr[0] "Kompendium Zrób To Sam"
