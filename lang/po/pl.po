msgid_plural "Beretta M9s"
msgstr[0] "Beretta M9"
msgstr[1] "Beretta M9"
msgstr[2] "Beretta M9"
msgstr[3] "Beretta M9"

#: lang/json/gun_from_json.py
msgid ""
"A very popular 9x19mm pistol, the M9 has been the standard issue sidearm of "
"the US army since 1985."
msgstr ""
"Bardzo popularny pistolet kalibru 9x19mm. M9 była standardową bronią boczna "
"w armii USA od 1985 r."

#: lang/json/gun_from_json.py
