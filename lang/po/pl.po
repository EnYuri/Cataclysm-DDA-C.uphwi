msgstr[3] "rozwidlona włócznia"

#. ~ Description for forked spear
#: lang/json/GENERIC_from_json.py
msgid ""
"A wooden pole with three spikes tied to it and decent grip.  It's "
"specialized for catching weapons, and not intended for extended use in "
"combat."
msgstr ""
"Drewniany kij z trzema kolcami przywiązanymi u szpica, i porządnym uchwytem."
" Wyspecjalizowany do przechwytywania broni i nie nadaje się do walki na "
"dłuższą metę."

