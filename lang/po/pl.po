msgstr[3] "zdalne sterowanie pojazdu"

#. ~ Description for remote vehicle controller
#: lang/json/TOOL_from_json.py
msgid ""
"A remote controller for real cars.  Can turn onboard devices on and off.  "
"Some cars can be driven remotely."
msgstr ""
"Zdalne sterowanie do prawdziwego pojazdu. Potrafi włączać i wyłączać systemy"
" pokładowe. Niektórymi pojazdami można sterować zdalnie."

