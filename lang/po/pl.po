msgstr[1] "szklana kosa"
msgstr[2] "szklana kosa"
msgstr[3] "szklana kosa"

#. ~ Description for glass shiv
#: lang/json/GENERIC_from_json.py
msgid "A glass shard with wrapping at one end so it can be safely wielded."
msgstr ""
"Odłamek szkła owinięty na jednym końcu by mógł być bezpiecznie trzymany."

#: lang/json/GENERIC_from_json.py
