msgstr "<npcname> wygląda lepiej po zjedzeniu %s."

#: src/consumption.cpp
msgid "Your internal power storage is fully powered."
msgstr "Twój wewnętrzny magazyn mocy jest w pełni zasilony."

#: src/consumption.cpp
msgid "<npcname>'s internal power storage is fully powered."
msgstr "Wewnętrzny magazyn mocy <npcname> jest w pełni zasilony."

#: src/consumption.cpp
#, c-format
msgid "You recharge your battery system with the %s."
msgstr "Ładujesz swój system bateryjny z użyciem %s."

#: src/consumption.cpp
#, c-format
msgid "<npcname> recharges their battery system with the %s."
msgstr "<npcname> ładuje swój system bateryjny z użyciem %s."

#: src/consumption.cpp
msgid "That is a LOT of plutonium.  Are you sure you want that much?"
msgstr "To jest DUŻO plutonu. Czy jesteś pewien, że chcesz tak dużą ilość?"

#: src/consumption.cpp
#, c-format
msgid "You add your %s to your reactor's tank."
msgstr "Dodajesz %s do zbiornika swojego reaktora."

#: src/consumption.cpp
#, c-format
msgid "<npcname> pours %s into their reactor's tank."
msgstr "<npcname> wlewa %s do zbiornika jego reaktora."

