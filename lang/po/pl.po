#, c-format
msgid "Harvest the %s?"
msgstr "Zebrać %s?"

#: src/iexamine.cpp
msgid "You harvest: spider egg"
msgstr "Pozyskujesz: pajęcze jajo"

#: src/iexamine.cpp
msgid "You harvest and drop: spider egg"
msgstr "Pozyskujesz i upuszczasz: pajęcze jajo"

#: src/iexamine.cpp
#, c-format
msgid "A spiderling bursts from the %s!"
msgstr "Pajęczak wyskakuje z %s!"

