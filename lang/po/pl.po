msgstr[2] "kamienny szpadel"
msgstr[3] "kamienny szpadel"

#. ~ Description for stone shovel
#: lang/json/TOOL_from_json.py
msgid ""
"This is a flattened stone affixed to a stick.  It works passably well as a "
"shovel but really can't compare to a real shovel."
msgstr ""
"Spłaszczony kamień osadzony na kiju. Ujdzie jako toporny szpadel, którego "
"nie da się porównać do prawdziwego szpadla."

