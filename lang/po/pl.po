#: lang/json/construction_from_json.py
msgid "Deconstruct Furniture"
msgstr "Rozbierz Meble"

#: lang/json/construction_from_json.py
msgid "Deconstruct Simple Furniture"
msgstr "Rozbierz Proste Meble"

#: lang/json/construction_from_json.py
msgid "Certain terrain and furniture can be deconstructed without any tools."
msgstr ""
"Pewne rodzaje terenu lub mebli mogą być rozłożone bez użycia narzędzi."

