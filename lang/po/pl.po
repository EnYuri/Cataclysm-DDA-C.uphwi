msgstr "Startowi NPC"

#. ~ Description for Starting NPC
#: lang/json/mutation_from_json.py
msgid "Marker for starting NPCs"
msgstr "Marker dla startowych NPC"

#: lang/json/mutation_from_json.py
msgid "Static NPC"
msgstr "Statyczni NPC"

#. ~ Description for Static NPC
#: lang/json/mutation_from_json.py
msgid "Marker for static NPCs"
msgstr "Marker dla statycznych NPC"

#: lang/json/mutation_from_json.py
msgid "Debug Vision"
msgstr "Zdebugowana Wizję"

#. ~ Description for Debug Vision
#: lang/json/mutation_from_json.py
msgid "You can clearly see that this is for dev purposes only."
msgstr "Widzisz wyraźnie że to jest tylko na użytek deweloperów."

#: lang/json/mutation_from_json.py
msgid "Debug Invisibility"
msgstr "Zdebugowana Niewidzialność"

#. ~ Description for Debug Invisibility
#: lang/json/mutation_from_json.py
msgid "If you see this, you'd best be debugging something."
msgstr "Jeśli to widzisz to lepiej żebyś coś debugował."

#: lang/json/mutation_from_json.py
msgid "Debug Life Support"
msgstr "Zdebugowane Podtrzymanie Życia"

#. ~ Description for Debug Life Support
#: lang/json/mutation_from_json.py
msgid ""
"Holds hunger, thirst, and fatigue stable.  You can debug all year long with "
"this one!"
msgstr ""
"Wstrzymuje głód, pragnienie, i zmęczenie na stabilnym poziomie. Możesz w tym"
" stanie debugować cały rok!"

#: lang/json/mutation_from_json.py
msgid "Debug Deodorizer"
msgstr "Zdebugowany Dezodorant"

#. ~ Description for Debug Deodorizer
#: lang/json/mutation_from_json.py
msgid "Smell that bug?  Smell's certainly not coming from you!"
msgstr "Czujesz tego bug'a? Bo zapach nie pochodzi od ciebie?"

#: lang/json/mutation_from_json.py
msgid "Debug Silent Walk"
msgstr "Zdebugowany Cichy Krok"

#. ~ Description for Debug Silent Walk
#: lang/json/mutation_from_json.py
msgid "Be vewwy vewwy quiet.  We're hunting bugs."
msgstr "Bądź bałdzo bałdzo cicho. Polujemy na bugi."

#: lang/json/mutation_from_json.py
msgid "Debug HVAC"
msgstr "Zdebugowany HVAC"

#. ~ Description for Debug HVAC
#: lang/json/mutation_from_json.py
msgid "Temperature and weather won't bug you."
msgstr "Temperatura i pogoda nie oblezie cię jak bugi."

#: lang/json/mutation_from_json.py
msgid "Debug Invincibility"
msgstr "Zdebugowana Nietykalność"

#. ~ Description for Debug Invincibility
#: lang/json/mutation_from_json.py
msgid "Bug repellent forcefield."
msgstr "Odstraszające bugi pole mocy."

#: lang/json/mutation_from_json.py
msgid "Debug Hammerspace"
msgstr "Zdebugowane Młotkowanie"

#. ~ Description for Debug Hammerspace
#: lang/json/mutation_from_json.py
msgid ""
"Crafting and construction requirements bugger off with this one.  Apply with"
" care."
msgstr ""
"Wymogi do wytwarzania i konstruowania odbugowały się tym razem. Używaj z "
"wyczuciem."

#: lang/json/mutation_from_json.py
msgid "Debug Mind Control"
msgstr "Zdebugowana Kontrola Umysłów"

#. ~ Description for Debug Mind Control
#: lang/json/mutation_from_json.py
msgid "Mind the bugs, would you kindly?"
msgstr "Myśl o bugach, jeśli łaska?"

#: lang/json/mutation_from_json.py
msgid "Debug Carrying Capacity"
msgstr "Zdebugowana Pojemność Noszenia"

#. ~ Description for Debug Carrying Capacity
#: lang/json/mutation_from_json.py
msgid "Lets you carry 15 bugs worth of your body weight in your mandibles."
msgstr ""
"Pozwala na noszenie 15 bugów o wadze twojego ciała w twoich szczękoczułkach."

#: lang/json/mutation_from_json.py
msgid "Debug Bionic Installation"
msgstr "Debugowanie Instalacji Bionicznej"

#. ~ Description for Debug Bionic Installation
#: lang/json/mutation_from_json.py
msgid "Lets you instantly install torsion ratchets for your eight legs."
msgstr "Pozwala ci natychmiast zainstalować przekładnie zębate dla ośmiu nóg."

#: lang/json/mutation_from_json.py
msgid "Debug Bionic Power"
msgstr "Debugowanie Mocy Bionicznej"

#. ~ Description for Debug Bionic Power
#: lang/json/mutation_from_json.py
msgid ""
"For fueling your inner cybug.  Activate to increase power capacity by 100 "
"(can be repeated.)"
msgstr ""
"Do napędzania twojego wewnętrznego cybuga. Aktywuj, aby zwiększyć moc o 100 "
"(może być powtórzone)."

#: lang/json/mutation_from_json.py
msgid "Squeamish"
msgstr "Przeczulony"

#. ~ Description for Squeamish
#: lang/json/mutation_from_json.py
msgid ""
"You can't even think about putting filthy clothes on yourself, especially "
"from zombies' corpses."
msgstr ""
"Nawet nie możesz myśleć o noszeniu brudnych ubrań, w szczególności z ciał "
"zombie."

#: lang/json/mutation_from_json.py
msgid "Bee"
msgstr "Pszczoła"

#. ~ Description for Bee
#: lang/json/mutation_from_json.py
msgid ""
"NPC trait that makes monsters see it as a bee.  It is a bug (heh) if you "
"have it."
msgstr ""
"Cecha NPC która sprawia, że potwory widzą cię jako pszczołę. To bug (heh) "
"jeśli to masz."

#: lang/json/mutation_from_json.py
msgid "mute"
msgstr "niemy"

#. ~ Description for mute
#: lang/json/mutation_from_json.py
msgid ""
"NPC trait that makes it impossible to say anything.  It is a bug if you have"
" it."
msgstr "Cecha NPC która uniemożliwia mówienie. To bug jak to masz."

#: lang/json/mutation_from_json.py
msgid "Survivor Story"
msgstr "Historia Ocalonego"

#. ~ Description for Survivor Story
#. ~ Description for Survivor
#. ~ Description for Survivor Story
#. ~ Description for Survivor
#. ~ Description for Survivor Story
