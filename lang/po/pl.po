msgid "You harvest: dahlia root"
msgstr "Pozyskujesz: korzeń dalii"

#: src/iexamine.cpp
msgid "You harvest and drop: dahlia root"
msgstr "Pozyskujesz i upuszczasz: korzeń dalii"

