msgstr "W tej kolonii nie ma misji. Naciśnij Spację..."

#: src/mission_companion.cpp
msgid "joins the caravan team..."
msgstr "dołącza do karawany..."

#: src/mission_companion.cpp
msgid "departs on the scavenging patrol..."
msgstr "udaje się na patrol zbieracki..."

#: src/mission_companion.cpp
msgid "departs on the scavenging raid..."
msgstr "udaje się na wypad zbieracki..."

#: src/mission_companion.cpp
msgid "departs to work as a laborer..."
msgstr "udaje się do pracy jako robotnik..."

#: src/mission_companion.cpp
