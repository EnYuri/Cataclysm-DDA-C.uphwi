msgstr[2] "qiang"
msgstr[3] "qiang"

#. ~ Description for qiang
#: lang/json/GENERIC_from_json.py
msgid ""
"An ancient Chinese spear, typically with a tassel just below the spearhead."
"  One of the four major weapons in folklore, alongside the dao sabre, jian "
"sword, and gun staff."
msgstr ""
"Starożytna chińska włócznia, zwykle z frędzlem poniżej ostrza. Jedna z "
"czterech podstawowych broni w folklorze, razem z szablą dao, mieczem jian, i"
" laską gun."

#: lang/json/GENERIC_from_json.py
msgid "halberd"
msgid_plural "halberds"
msgstr[0] "halabarda"
msgstr[1] "halabarda"
msgstr[2] "halabarda"
msgstr[3] "halabarda"

#. ~ Description for halberd
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a versatile polearm with an axe blade, a spike, and other fun things"
" attached to a long stick."
msgstr ""
"Halabarda to wszechstronna broń drzewcowa z ostrzem siekiery, kolcem, i "
"innymi zabawnymi rzeczami przytwierdzonymi na końcu długiego kija."

#. ~ Description for halberd
#: lang/json/GENERIC_from_json.py
msgid ""
"This is a dull, cheaply made replica of a polearm with an axe blade, a "
"spike, and other fun things attached to a long stick."
msgstr ""
"To kiepska, tania replika broni drzewcowej z ostrzem, kolcem, i innymi "
"zabawnymi rzeczami przytwierdzonymi na końcu długiego kija."

#: lang/json/GENERIC_from_json.py
msgid "glaive"
msgid_plural "glaives"
msgstr[0] "glewia"
msgstr[1] "glewia"
msgstr[2] "glewia"
msgstr[3] "glewia"

#. ~ Description for glaive
#: lang/json/GENERIC_from_json.py
msgid "A sturdy polearm with a sizable, single-edged blade on the end."
msgstr ""
"Solidna broń drzewcowa ze znacznych rozmiarów ostrzem jednosiecznym "
"zamontowanym na końcu."

#: lang/json/GENERIC_from_json.py
msgid "naginata"
msgid_plural "naginata"
msgstr[0] "naginata"
msgstr[1] "naginata"
msgstr[2] "naginata"
msgstr[3] "naginata"

#. ~ Description for naginata
#: lang/json/GENERIC_from_json.py
msgid ""
"A sturdy polearm with a curved blade, made in the same manner as the katana "
"and other Japanese blades.  Occasionally used by samurai in early periods, "
"or by their wives in defense of the household."
msgstr ""
"Solidna broń drzewcowa z zakrzywionym ostrzem, wytwarzanym tym samym "
"sposobem co katany i inne japońskie ostrza. Czasami używane przez samurajów "
"we wczesnych erach, lub przez ich żony w obronie domu."

#: lang/json/GENERIC_from_json.py
msgid "survivor naginata"
msgid_plural "survivor naginata"
msgstr[0] "naginata ocalonych"
msgstr[1] "naginata ocalonych"
msgstr[2] "naginata ocalonych"
msgstr[3] "naginata ocalonych"

#. ~ Description for survivor naginata
#: lang/json/GENERIC_from_json.py
msgid ""
"This sturdy steel shaft with a sword blade at the end is good for both "
"slashing and stabbing."
msgstr ""
"Ten solidny stalowy pręt z ostrzem miecza na końcu jest równie dobry w "
"cięciu jak i w pchnięciach."

