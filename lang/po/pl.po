#. ~ Name for scenario 'Prison Break' for a male character
#: lang/json/scenario_from_json.py
msgctxt "scenario_male"
msgid "Prison Break"
msgstr "Ucieczka z Więzienia"

#. ~ Name for scenario 'Prison Break' for a female character
