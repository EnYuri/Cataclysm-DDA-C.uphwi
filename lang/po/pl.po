msgstr[1] "kij baseballowy"
msgstr[2] "kij baseballowy"
msgstr[3] "kij baseballowy"

#. ~ Description for baseball bat
#: lang/json/GENERIC_from_json.py
msgid "A sturdy wood bat.  Makes a great melee weapon."
msgstr "Twardy drewniany kij baseballowy. Świetna broń do walki wręcz."

#: lang/json/GENERIC_from_json.py
msgid "bowling pin"
msgid_plural "bowling pins"
