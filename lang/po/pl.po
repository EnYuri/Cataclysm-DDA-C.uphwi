msgid "Doesn't appear to be modded."
msgstr "Nie wygląda na zmodyfikowany."

#: src/iuse_actor.cpp
msgid "None of the mods can be removed."
msgstr "Żadnego z modów nie da się usunąć."

#: src/iuse_actor.cpp
msgid "Has to be taken off first."
msgstr "Trzeba najpierw zdemontować."

