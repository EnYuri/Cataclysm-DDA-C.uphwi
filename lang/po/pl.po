msgid_plural "chest rigs"
msgstr[0] "uprząż taktyczna"
msgstr[1] "uprząż taktyczna"
msgstr[2] "uprząż taktyczna"
msgstr[3] "uprząż taktyczna"

#. ~ Description for chest rig
#: lang/json/ARMOR_from_json.py
msgid ""
"A light vest covered in webbing, pockets and straps.  This variety is "
"favored by the military, as it is capable of holding four magazines close at"
" hand."
msgstr ""
"Lekka kamizelka pokryta siatką, paskami i kieszeniami. Typ wojskowy, zdolny "
"do przechowania czterech magazynków, które dzięki temu będą pod ręką."

#: lang/json/ARMOR_from_json.py
