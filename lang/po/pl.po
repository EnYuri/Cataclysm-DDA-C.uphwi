#, c-format
msgid "It will finish brewing in about %d hour."
msgid_plural "It will finish brewing in about %d hours."
msgstr[0] "Fermentacja skończy się w ciągu około %d godziny."
msgstr[1] "Fermentacja skończy się w ciągu około %d godzin."
msgstr[2] "Fermentacja skończy się w ciągu około %d godzin."
msgstr[3] "Fermentacja skończy się w ciągu około %d godzin."

