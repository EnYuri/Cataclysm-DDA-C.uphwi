#. ~ Description for scenario 'Burning Building' for a male character.
#: lang/json/scenario_from_json.py
msgctxt "scen_desc_male"
msgid ""
"The building you had chosen to reside in has suddenly caught fire!  You "
"might want to leave."
msgstr ""
"Budynek w którym zdecydowałeś się zamieszkać nagle zajął się ogniem! Możesz "
"zechcieć go opuścić."

