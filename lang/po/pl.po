msgstr "wytłoki z owoców"

#. ~ Description for juice pulp
#: lang/json/COMESTIBLE_from_json.py
msgid ""
"Left-over from juicing the fruit.  Not very tasty, but contains a lot of "
"healthy fiber."
msgstr ""
"Pozostałości z wytłaczania soku z owoców. Niezbyt smaczne, ale zawierają "
"dużo zdrowego błonnika."

#: lang/json/COMESTIBLE_from_json.py
msgid "pear"
msgstr "gruszka"

#. ~ Description for pear
#: lang/json/COMESTIBLE_from_json.py
msgid "A juicy, bell-shaped pear.  Yum!"
msgstr "Soczysta gruszka w kształcie dzwonu. Pyszna."

#: lang/json/COMESTIBLE_from_json.py
msgid "grapefruit"
msgstr "grejpfrut"

#. ~ Description for grapefruit
#: lang/json/COMESTIBLE_from_json.py
msgid "A citrus fruit, whose taste ranges from sour to semi-sweet."
msgstr "Owoc cytrusowy, którego smak oscyluje między kwaśnym a półsłodkim."

#: lang/json/COMESTIBLE_from_json.py
msgid "handful of cherries"
