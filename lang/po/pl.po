#: src/iexamine.cpp
#, c-format
msgid "The keg now contains %s (%d), %0.f%% full."
msgstr "Ten keg zawiera obecnie %s (%d), %0.f%% full."

#: src/iexamine.cpp
msgid "Start fermenting cycle?"
