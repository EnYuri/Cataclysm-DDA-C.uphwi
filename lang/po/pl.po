msgstr[1] "deska"
msgstr[2] "deska"
msgstr[3] "deska"

#. ~ Description for two by four
#: lang/json/GENERIC_from_json.py
msgid ""
"A plank of wood.  Makes a decent melee weapon, and can be used to board up "
"doors and windows if you have a hammer and nails."
msgstr ""
"Drewniana deska kantówka 2x4 cala. Przyzwoita broń do walki wręcz, i da się "
"nią zabić okna albo drzwi jeżeli masz młotek i gwoździe."

#: lang/json/GENERIC_from_json.py
msgid "pipe"
msgid_plural "pipes"
