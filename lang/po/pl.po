msgstr[1] "bandolier nadgarstkowy"
msgstr[2] "bandolier nadgarstkowy"
msgstr[3] "bandolier nadgarstkowy"

#. ~ Description for wrist bandolier
#: lang/json/ARMOR_from_json.py
msgid ""
"A small fabric bandolier for rifle cartridges designed to be worn around the"
" wrist."
msgstr ""
"Mały materiałowy bandolier do naboi karabinowych do noszenia na nadgarstku."

