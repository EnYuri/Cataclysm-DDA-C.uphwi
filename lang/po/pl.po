msgstr[1] "para butów"
msgstr[2] "para butów"
msgstr[3] "para butów"

#. ~ Description for pair of boots
#: lang/json/ARMOR_from_json.py
msgid "Tough leather boots.  Very durable."
msgstr "Wytrzymałe skórzane buty. Bardzo trwałe."

#: lang/json/ARMOR_from_json.py
