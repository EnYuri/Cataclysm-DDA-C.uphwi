#: src/iexamine.cpp
msgid "The vat is full, so you close the lid and start the fermenting cycle."
msgstr "Kadź jest pełna, więc zamykasz wieko i rozpoczynasz cykl fermentacji."

#: src/iexamine.cpp
msgid "You close the lid and start the fermenting cycle."
msgstr "Zamykasz wieko i rozpoczynasz cykl fermentacji."

#: src/iexamine.cpp
#, c-format
msgid "You remove %s from the vat."
msgstr "Usuwasz %s z kadzi."

#: src/iexamine.cpp
#, c-format
