#, c-format
msgid "The %s is in the way."
msgstr "%s stoi na drodze."

#: src/iuse_actor.cpp
#, c-format
msgid "The %s in that direction is not passable."
msgstr "Tego %s w tym kierunku nie da się przejść."

#: src/iuse_actor.cpp
#, c-format
msgid "There is already furniture (%s) there."
msgstr "Już tam jest mebel (%s)."

