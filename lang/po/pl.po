msgid_plural "golf clubs"
msgstr[0] "kij golfowy"
msgstr[1] "kij golfowy"
msgstr[2] "kij golfowy"
msgstr[3] "kij golfowy"

#. ~ Description for golf club
#: lang/json/GENERIC_from_json.py
msgid ""
"A long handle with a big metal head, flat on one side, for driving golf "
"balls.  Fore!"
msgstr ""
"Długi uchwyt z dużą metalową głowicą, płaską z jednej strony, do uderzania "
"piłeczek golfowych. Naprzód!"

#: lang/json/GENERIC_from_json.py
